---
import '../index.css';
import '../App.css';
import favicon from '../images/logo/short-white-logo.svg';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string | false;
  structuredData?: Record<string, unknown>;
  ogType?: 'website' | 'article';
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  author?: string;
  robots?: 'index, follow' | 'noindex, follow' | 'noindex, nofollow';
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  canonicalPath = '/',
  structuredData,
  ogType = 'website',
  ogTitle = title,
  ogDescription = description,
  ogImage,
  ogImageAlt,
  author,
  robots = 'index, follow',
  publishedTime,
  modifiedTime,
} = Astro.props;
const site = Astro.site ?? new URL('https://truetell-retail.ru');
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const canonicalUrl = canonicalPath === false
  ? undefined
  : new URL(`${base}${canonicalPath.replace(/^\//, '')}`, site);
const metrikaEnabled = import.meta.env.BASE_URL === '/';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {author && <meta name="author" content={author} />}
    <meta name="robots" content={robots} />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' data: *.yandex.cloud *.yandex.ru *.yandex-team.ru *.yandex.net *.yandex.com yastat.net yastatic.net https://api-maps.yandex.ru https://*.maps.yandex.net https://yandex.ru/clck/click https://mc.yandex.com https://mc.yandex.ru; style-src 'self' 'unsafe-inline'; img-src 'self' *.yandex.cloud *.yandex.ru *.yandex-team.ru *.yandex.net *.yandex.com yastat.net yastatic.net data: https://mc.yandex.com https://mc.yandex.ru; connect-src 'self' 'unsafe-inline' 'unsafe-eval' data: ws: wss: localhost:* *.yandex.cloud *.yandex.ru *.yandex-team.ru *.yandex.net *.yandex.com yastat.net yastatic.net https://api-maps.yandex.ru https://*.maps.yandex.net https://yandex.ru/clck/click https://mc.yandex.com https://mc.yandex.ru https://datalens.yandex.ru https://datalens.yandex.com https://datalens.yandex; frame-src 'self' https://forms.yandex.ru https://forms.yandex.cloud https://api-maps.yandex.ru blob: https://mc.yandex.ru https://mc.yandex.com https://*.truetell.ru https://datalens.yandex.ru https://datalens.yandex.com https://datalens.yandex https://yandex.ru"
    />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="TrueTell" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
    <link rel="icon" type="image/svg+xml" href={favicon.src} />
    <title>{title}</title>
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
  </head>
  <body>
    <slot />
    <script is:inline define:vars={{ metrikaEnabled }}>
      (() => {
        if (!metrikaEnabled) return;
        const localHosts = new Set(['localhost', '127.0.0.1', '::1']);
        if (localHosts.has(window.location.hostname)) return;

        const initializeMetrika = () => {
          (function(m,e,t,r,i,k,a){
            m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
            m[i].l=1*new Date();
            for (var j = 0; j < document.scripts.length; j++) { if (document.scripts[j].src === r) return; }
            k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a);
          })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js?id=103366745', 'ym');
          ym(103366745, 'init', { ssr:true, webvisor:true, clickmap:true, accurateTrackBounce:true, trackLinks:true });
        };

        const scheduleMetrika = () => {
          if ('requestIdleCallback' in window) {
            window.requestIdleCallback(initializeMetrika, { timeout: 4000 });
          } else {
            window.setTimeout(initializeMetrika, 2000);
          }
        };

        if (document.readyState === 'complete') scheduleMetrika();
        else window.addEventListener('load', scheduleMetrika, { once: true });
      })();
    </script>
    {metrikaEnabled && (
      <noscript>
        <div><img src="https://mc.yandex.ru/watch/103366745" style="position:absolute;left:-9999px" alt="" /></div>
      </noscript>
    )}
  </body>
</html>
