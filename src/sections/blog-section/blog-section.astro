---
import { blogArticles } from '../../config/articles';
import styles from './blog-section.module.scss';
import CarouselControls from '../../components/article-carousel/carousel-controls.astro';

interface Props {
  page?: boolean;
}

const { page = false } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const blogHref = `${base}blog/`;

const articles = blogArticles.map((article) => ({
  ...article,
  href: article.hrefPath ? `${base}${article.hrefPath}` : undefined,
}));
---

<section
  id="blog"
  class:list={[styles.section, page ? styles.pageSection : styles.homeSection]}
  aria-labelledby="blog-title"
  data-article-carousel={!page || undefined}
>
  <div class={styles.container}>
    <header class={styles.header}>
      {page ? (
        <h1 id="blog-title" class={styles.title}>Блог</h1>
      ) : (
        <h2 id="blog-title" class={styles.title}>Блог</h2>
      )}

      {!page && (
        <div class={styles.actions}>
          <a class={styles.blogLink} href={blogHref}>
            <span>Все статьи</span>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
              <path d="m9 6 6 6-6 6"></path>
            </svg>
          </a>
          <div class={styles.desktopControls}>
            <CarouselControls trackId="home-blog-track" />
          </div>
        </div>
      )}
    </header>

    <div
      id={!page ? 'home-blog-track' : undefined}
      class:list={[styles.grid, !page && styles.carousel]}
      data-carousel-track={!page || undefined}
      role={!page ? 'region' : undefined}
      aria-label={!page ? 'Статьи блога' : undefined}
      tabindex={!page ? 0 : undefined}
    >
      {articles.map((article) => (
        <article class={styles.card}>
          {article.href ? (
            <a class={styles.cardLink} href={article.href}>
              {article.category && <span class={styles.articleMeta}>{article.category}</span>}
              <h3 class={styles.articleTitle}>{article.title}</h3>
              <p class={styles.description}>{article.description}</p>
              <span class={styles.readMore}>Читать статью <span aria-hidden="true">→</span></span>
            </a>
          ) : (
            <>
              <h3 class={styles.articleTitle}>{article.title}</h3>
              <p class={styles.description}>{article.description}</p>
            </>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
