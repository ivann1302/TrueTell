---
import { blogArticles } from '../../config/articles';
import styles from './blog-section.module.scss';
import CarouselControls from '../../components/article-carousel/carousel-controls.astro';

interface Props {
  page?: boolean;
}

const { page = false } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const blogHref = `${base}blog/`;

const articles = blogArticles.map((article) => ({
  ...article,
  description: article.summaryDescription ?? article.description,
  href: article.hrefPath ? `${base}${article.hrefPath}` : undefined,
}));
const hasCarousel = !page && articles.length > 2;
---

<section
  id="blog"
  class:list={[styles.section, page ? styles.pageSection : styles.homeSection]}
  aria-labelledby="blog-title"
  data-article-carousel={hasCarousel || undefined}
>
  <div class={styles.container}>
    <header class={styles.header}>
      {page ? (
        <div>
          <h1 id="blog-title" class={styles.title}>Блог</h1>
          <p class={styles.pageIntro}>Разборы аналитики и автоматизации: как работать с данными и принимать решения. Пошаговые инструкции — в <a href={`${base}knowledge-base/`}>базе знаний</a>.</p>
        </div>
      ) : (
        <h2 id="blog-title" class={styles.title}>Блог</h2>
      )}

      {!page && (
        <div class={styles.actions}>
          <a class={styles.blogLink} href={blogHref}>
            <span>Все статьи</span>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
              <path d="m9 6 6 6-6 6"></path>
            </svg>
          </a>
          {hasCarousel && <div class={styles.desktopControls}><CarouselControls trackId="home-blog-track" /></div>}
        </div>
      )}
    </header>

    <div
      id={hasCarousel ? 'home-blog-track' : undefined}
      class:list={[styles.grid, articles.length < 3 && styles.compactGrid, articles.length === 1 && styles.singleArticleGrid, hasCarousel && styles.carousel]}
      data-carousel-track={hasCarousel || undefined}
      role={hasCarousel ? 'region' : undefined}
      aria-label={hasCarousel ? 'Статьи блога' : undefined}
      tabindex={hasCarousel ? 0 : undefined}
    >
      {articles.map((article) => (
        <article class={styles.card}>
          {article.href ? (
            <a class={styles.cardLink} href={article.href}>
              {article.category && <span class={styles.articleMeta}>{article.category}</span>}
              {page ? <h2 class={styles.articleTitle}>{article.title}</h2> : <h3 class={styles.articleTitle}>{article.title}</h3>}
              <p class={styles.description}>{article.description}</p>
              <span class={styles.readMore}>Читать статью <span aria-hidden="true">→</span></span>
            </a>
          ) : (
            <>
              {page ? <h2 class={styles.articleTitle}>{article.title}</h2> : <h3 class={styles.articleTitle}>{article.title}</h3>}
              <p class={styles.description}>{article.description}</p>
            </>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
