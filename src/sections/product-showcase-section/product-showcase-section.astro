---
import { productCatalog } from '../../config/product-catalog';
import ShowcaseProductCard from './showcase-product-card.astro';
import styles from './product-showcase-section.module.scss';

const featuredProducts = productCatalog.slice(0, 3);
const additionalProducts = productCatalog.slice(featuredProducts.length);
---

<section class={styles.section} aria-labelledby="product-showcase-title">
  <div class={styles.container}>
    <header class={styles.header} data-reveal>
      <h2 id="product-showcase-title" class={styles.title}>
        Продукты TrueTell
      </h2>
    </header>

    <div class={styles.appProducts} aria-label="Приложения TrueTell для бизнес-систем">
      {featuredProducts.map((product, index) => <ShowcaseProductCard {product} {index} />)}
    </div>

    {additionalProducts.length > 0 && (
      <details class={styles.additionalProducts} data-product-disclosure>
        <summary class={styles.listToggle}>
          <span class={styles.showProductsLabel}>Посмотреть все продукты</span>
          <span class={styles.hideProductsLabel}>Скрыть список</span>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </summary>
        <div class={styles.appProducts} data-additional-product-grid>
          {additionalProducts.map((product, index) => <ShowcaseProductCard {product} {index} />)}
        </div>
        <button class:list={[styles.listToggle, styles.bottomToggle]} data-hide-product-list type="button" hidden>
          Скрыть список
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="m6 15 6-6 6 6"></path>
          </svg>
        </button>
      </details>
    )}
  </div>
</section>

<script>
  for (const disclosure of document.querySelectorAll<HTMLDetailsElement>('[data-product-disclosure]')) {
    const summary = disclosure.querySelector('summary');
    const hideButton = disclosure.querySelector<HTMLButtonElement>('[data-hide-product-list]');
    if (!summary || !hideButton) continue;

    hideButton.addEventListener('click', () => {
      disclosure.open = false;
      summary.focus();
    });
    hideButton.hidden = false;
  }
</script>
