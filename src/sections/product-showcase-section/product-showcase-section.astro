---
import bitrix24Icon from '../../images/logo/bitrix24-app-icon.svg';
import moyskladIcon from '../../images/logo/moysklad-app-icon.svg';
import { cleanerProductPath, moyskladOperationsProductPath } from '../../config/products';
import styles from './product-showcase-section.module.scss';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const internalHref = (path: string) => `${base}${path.replace(/^\//, '')}`;
---

<section class={styles.section} aria-labelledby="product-showcase-title">
  <div class={styles.container}>
    <header class={styles.header}>
      <h2 id="product-showcase-title" class={styles.title}>
        Продукты TrueTell
      </h2>
      <a class:list={[styles.allProductsLink, styles.desktopAllProductsLink]} href={internalHref('/products/')}>
        <span>Посмотреть все продукты</span>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
          <path d="m9 6 6 6-6 6"></path>
        </svg>
      </a>
    </header>

    <div class={styles.appProducts} aria-label="Приложения TrueTell для бизнес-систем">
      <article class={styles.appProduct}>
        <div class={styles.appHeading}>
          <h3 class={styles.appTitle}>Очистка Битрикс24</h3>
          <img class={styles.appIcon} src={bitrix24Icon.src} alt="" width="512" height="512" loading="lazy" decoding="async" />
        </div>
        <p class={styles.appDescription}>Лиды и сделки — по фильтрам, с проверкой и отчётом.</p>
        <a class={styles.productButton} href={internalHref(cleanerProductPath)}>
          Посмотреть приложение<span aria-hidden="true">›</span>
        </a>
      </article>

      <article class={styles.appProduct}>
        <div class={styles.appHeading}>
          <h3 class={styles.appTitle}>Массовые операции в МойСклад</h3>
          <img class={styles.appIcon} src={moyskladIcon.src} alt="" width="120" height="120" loading="lazy" decoding="async" />
        </div>
        <p class={styles.appDescription}>Товары, цены и документы — массовые операции с проверкой.</p>
        <a class={styles.productButton} href={internalHref(moyskladOperationsProductPath)}>
          Посмотреть приложение<span aria-hidden="true">›</span>
        </a>
      </article>

      <article class:list={[styles.appProduct, styles.biProduct]}>
        <h3 class={styles.appTitle}>BI-аналитика для торговли</h3>
        <p class={styles.appDescription}>Продажи, остатки и маржинальность в одном управленческом контуре.</p>
        <a class={styles.productButton} href={internalHref('/bi-analitika/')}>
          Посмотреть BI-решение<span aria-hidden="true">›</span>
        </a>
      </article>
    </div>

    <a class:list={[styles.allProductsLink, styles.mobileAllProductsLink]} href={internalHref('/products/')}>
      <span>Посмотреть все продукты</span>
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
        <path d="m9 6 6 6-6 6"></path>
      </svg>
    </a>
  </div>
</section>
