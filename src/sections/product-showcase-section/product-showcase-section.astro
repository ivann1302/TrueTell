---
import { biProductPath, productCatalog } from '../../config/product-catalog';
import styles from './product-showcase-section.module.scss';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const internalHref = (path: string) => `${base}${path.replace(/^\//, '')}`;
---

<section class={styles.section} aria-labelledby="product-showcase-title">
  <div class={styles.container}>
    <header class={styles.header} data-reveal>
      <h2 id="product-showcase-title" class={styles.title}>
        Продукты TrueTell
      </h2>
      <a class:list={[styles.allProductsLink, styles.desktopAllProductsLink]} href={internalHref('/products/')}>
        <span>Посмотреть все продукты</span>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
          <path d="m9 6 6 6-6 6"></path>
        </svg>
      </a>
    </header>

    <div class={styles.appProducts} aria-label="Приложения TrueTell для бизнес-систем">
      {productCatalog.map((product, index) => {
        const icon = product.platformIcon;
        const href = product.showcaseHref ?? product.href;
        const external = href.startsWith('http');

        return (
          <a
            class:list={[styles.appProduct, { [styles.biProduct]: product.href === biProductPath }]}
            href={external ? href : internalHref(href)}
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener noreferrer' : undefined}
            aria-label={external ? `${product.title} — откроется в новой вкладке` : undefined}
            data-reveal={String(index % 3)}
          >
            <div class={icon ? styles.appHeading : undefined}>
              <h3 class={styles.appTitle}>{product.title}</h3>
              {icon && (
                <img class={styles.appIcon} src={icon.src} alt="" width={icon.width} height={icon.height} loading="lazy" decoding="async" />
              )}
            </div>
            <p class={styles.appDescription}>{product.description}</p>
            <span class={styles.productButton}>
              Подробнее<span aria-hidden="true">›</span>
            </span>
          </a>
        );
      })}
    </div>

    <a class:list={[styles.allProductsLink, styles.mobileAllProductsLink]} href={internalHref('/products/')}>
      <span>Посмотреть все продукты</span>
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
        <path d="m9 6 6 6-6 6"></path>
      </svg>
    </a>
  </div>
</section>
