---
import { cleanerProduct, cleanerProductPath, moyskladOperationsProduct, moyskladOperationsProductPath, productRating, productRatingPath } from '../../config/products';
import styles from './product-catalog-section.module.scss';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const resolveHref = (href: string) => href.startsWith('/')
  ? `${base}${href.replace(/^\//, '')}`
  : href;

const products = [
  {
    title: 'BI-аналитика для торговли',
    description: 'Продажи, остатки и маржинальность в одном управленческом контуре.',
    action: 'Посмотреть BI-решение',
    href: '/bi-analitika/',
  },
  {
    title: moyskladOperationsProduct.name,
    description: moyskladOperationsProduct.catalogDescription,
    action: 'Посмотреть приложение',
    href: moyskladOperationsProductPath,
  },
  {
    title: cleanerProduct.name,
    description: cleanerProduct.catalogDescription,
    action: cleanerProduct.articleActionLabel,
    href: cleanerProductPath,
  },
  {
    title: productRating.heading,
    description: productRating.catalogDescription,
    action: 'Посмотреть приложение',
    href: productRatingPath,
  },
];
---

<section class={styles.section} aria-labelledby="products-page-title">
  <div class={styles.container}>
    <header class={styles.header}>
      <h1 id="products-page-title" class={styles.title}>Продукты TrueTell</h1>
    </header>

    <ul class={styles.grid}>
      {products.map((product) => {
        const external = product.href.startsWith('http');

        return (
          <li>
            <a
              class={styles.card}
              href={resolveHref(product.href)}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
              aria-label={`${product.action}: ${product.title}${external ? ' — откроется в новой вкладке' : ''}`}
            >
              <h2 class={styles.productTitle}>{product.title}</h2>
              <p class={styles.description}>{product.description}</p>
              <span class={styles.action}>
                {product.action}
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                  <path d="m9 6 6 6-6 6"></path>
                </svg>
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>
