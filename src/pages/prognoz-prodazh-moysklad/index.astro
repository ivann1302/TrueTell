---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { createArticleStructuredData, DEFAULT_ARTICLE_AUTHOR } from '../../utils/functions/createArticleStructuredData';
import productsImage from '../../images/articles/moysklad-forecast-products-demo.png';
import tableImage from '../../images/articles/moysklad-forecast-table-demo.png';
import revenueImage from '../../images/articles/moysklad-forecast-revenue-demo.png';

const article = getArticle('prognoz-prodazh-moysklad/');
const title = article.title;
const description = article.description;
const canonicalPath = `/${article.hrefPath}`;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const imageAlt = 'Товары: период прогноза, поиск по названию и график фактических и ожидаемых продаж';
const ogImage = new URL(productsImage.src, siteRoot).toString();
const titleParts = [
  { text: 'Прогноз продаж в МоёмСкладе: ' },
  { text: 'как оценить спрос', accent: true },
  { text: ' и подготовиться к закупке' },
];
const columnRows = [
  ['Товар', 'Позиция, для которой показаны остаток, прошлые продажи и прогноз. Название оформлено как ссылка.'],
  ['Свободный остаток, шт.', 'Количество свободного товара. На показанном экране остаток относится ко всему бизнесу.'],
  ['Продано за 30 дней, шт.', 'Объём продаж за прошедшие 30 дней для сравнения с ожидаемым количеством.'],
  ['Прогноз, шт.', 'Ожидаемое количество за выбранный период. Под значением может быть предупреждение о возможном дефиците.'],
  ['Выручка по цене, ₽', 'Денежная оценка товарного прогноза по расчётной цене. Это не показатель прибыли.'],
  ['Возможные потери, ₽', 'Денежная оценка возможного дефицита. Она помогает выбрать позиции для проверки, но не доказывает будущий убыток.'],
];
const faqItems = [
  {
    question: 'Это штатный отчёт МоегоСклада или отдельное приложение?',
    answer: 'Здесь показан интерфейс отдельного приложения «Прогнозирование продаж». В МоёмСкладе также есть штатный отчёт «Управление закупками» со своей методикой. Эти инструменты нужно сравнивать по задаче и правилам расчёта.',
  },
  {
    question: 'Нужно ли закупать ровно столько, сколько составляет дефицит?',
    answer: 'Нет. Дефицит — ориентир для проверки. До заказа учтите подтверждённые поставки, сроки доставки, минимальную партию, резервы, акции и изменения спроса.',
  },
  {
    question: 'Возможные потери — это упущенная прибыль?',
    answer: 'Нет. В примере это стоимость недостающего количества по расчётной цене продажи. Себестоимость и расходы не вычтены; оценка не означает гарантированный убыток.',
  },
  {
    question: 'Почему прогноз количества бывает дробным?',
    answer: 'Прогноз — оценка ожидаемого объёма, поэтому в показанной таблице есть дробные значения. Для заказа штучного товара количество нужно отдельно привести к единице учёта и упаковке поставщика.',
  },
  {
    question: 'Можно ли сравнивать выручку по цене и прогноз выручки бизнеса?',
    answer: 'Сравнивать можно, но ожидать равенства без проверки методики нельзя. На демонстрационных экранах сумма «Выручки по цене» по восьми товарам — 1 480 213,10 ₽, а отдельный прогноз выручки бизнеса — 1 021 095,92 ₽. Это разные показатели.',
  },
  {
    question: 'Как уточнить доступность приложения и условия подключения?',
    answer: 'Обратитесь в TrueTell. Перед установкой проверьте доступность решения вашему аккаунту, условия и запрашиваемые права. Материалы этой статьи показывают демонстрационную версию интерфейса и не подтверждают установку в вашем аккаунте.',
  },
];
const sources = [
  { label: 'Каталог решений: подключение приложений — МойСклад', href: 'https://support.moysklad.ru/hc/ru/интеграции/каталог_решений' },
  { label: 'Штатный отчёт «Управление закупками» — МойСклад', href: 'https://support.moysklad.ru/hc/ru/отчеты/управление_закупками' },
];
const relatedArticles = getRelatedArticles(article.hrefPath).map((item) => ({
  ...item,
  description: item.summaryDescription ?? item.description,
  href: `${base}${item.hrefPath}`,
}));
const structuredData = createArticleStructuredData({
  articleType: 'Article', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), image: ogImage, author: DEFAULT_ARTICLE_AUTHOR,
  breadcrumbs: [
    { name: companyInfo.brandName, item: siteRoot.toString() },
    { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() },
    { name: title, item: articleUrl },
  ],
  faqItems,
});
---

<ArticleLayout
  {title} {titleParts} {description} {canonicalPath} {structuredData} {ogImage}
  ogTitle={article.seoTitle ?? title} ogDescription={description} ogImageAlt={imageAlt}
  category="МойСклад" author={DEFAULT_ARTICLE_AUTHOR}
  intro="На примере демонстрационного интерфейса «Прогнозирование продаж»: выбор периода, чтение товарного прогноза и проверка позиций перед закупкой."
>
  <Fragment slot="quick-answer">
    <p>На вкладке <strong>«Товары»</strong> выберите период, задайте отбор и нажмите «Применить». Сравните прогноз количества со свободным остатком и проверьте позиции с возможным дефицитом.</p>
    <p>Для денежного плана откройте <strong>«Выручку»</strong>. Её итог и «Выручка по цене» в товарной таблице — разные показатели. Прогноз помогает планировать, но не гарантирует продажи и не заменяет проверку поставок.</p>
  </Fragment>

  <p data-article-lead>История продаж показывает, что уже купили. Перед закупкой нужен ещё один ориентир: сколько товара может понадобиться в ближайшие недели и хватит ли текущего запаса. Отчёт помогает составить список позиций, которые стоит проверить перед заказом.</p>
  <aside data-article-note>
    <strong>Какой инструмент показан</strong>
    <p>Статья описывает отдельное приложение «Прогнозирование продаж» по демонстрационным материалам разработчика. На скриншотах — вымышленные данные. Это не инструкция к штатному отчёту «Управление закупками» МоегоСклада: у него своя методика. Доступность приложения и условия подключения уточняйте в TrueTell.</p>
  </aside>

  <section aria-labelledby="products">
    <h2 id="products">Товары: от общей динамики <span data-heading-accent>к конкретным позициям</span></h2>
    <p>На вкладке «Товары» показаны период прогноза, поиск по названию и отбор товаров. В демонстрационной версии есть быстрые периоды 7, 14 и 30 дней, поля начальной и конечной даты. Выберите нужный период и нажмите «Применить», чтобы читать отчёт по заданным условиям.</p>
    <p>Сплошная линия обозначает факт продаж, пунктирная — прогноз. Над графиком виден период истории, рядом — итог по текущему отбору и число товаров с прогнозом и без него. На примере прогноз для восьми товаров за 1–30 октября составляет 2 199,30 шт. График и итог относятся к товарам с прогнозом из выбранного отбора.</p>
    <ArticleFigure src={productsImage} alt={imageAlt} fullSize caption="Демонстрационный интерфейс из материалов разработчика: восемь товаров с прогнозом, история за сентябрь и прогноз на октябрь 2026 года. Все числа вымышлены; это пример чтения отчёта, а не результат клиентского бизнеса." />
    <p>После общего графика переходите к таблице. Она позволяет сопоставить ожидаемые продажи с запасом и увидеть, какие товары требуют внимания. Не путайте количество в штуках с денежными колонками.</p>
    <DataTable label="Как читать колонки товарного прогноза" columns={['Колонка', 'Что показывает']} rows={columnRows} rowHeaders />
    <p>На узком экране таблицу можно прокрутить по горизонтали. Детальный скриншот ниже открывается в полном размере — так удобнее сверять значения и подписи колонок.</p>
    <ArticleFigure src={tableImage} alt="Восемь товаров: свободный остаток, продажи за 30 дней, прогноз и возможный дефицит по двум сортам кофе" fullSize caption="Демонстрационная таблица от разработчика. У кофе «Бразилия» прогноз 471,29 шт. при свободном остатке 216 шт.; возможный дефицит — 255,29 шт. Учебные значения не доказывают точность прогноза." />
  </section>

  <section aria-labelledby="purchase">
    <h2 id="purchase">Как использовать прогноз <span data-heading-accent>перед закупкой</span></h2>
    <p>Начните с периода, на который планируете запас. Затем отберите нужные товары и посмотрите позиции с возможным дефицитом. Самый большой прогноз не обязательно означает самый срочный заказ: у товара может быть достаточный остаток, а у другой позиции — короткий запас и долгая доставка.</p>
    <p><strong>Условный пример.</strong> Свободный остаток — 100 штук, прогноз — 150 штук. Разница составляет 50 штук. При расчётной цене продажи 500 ₽ денежная оценка такого дефицита — 25 000 ₽: 50 × 500. Это ориентир по выручке, без вычета себестоимости и расходов.</p>
    <p>В показанной строке кофе «Бразилия» расчёт можно проверить так: 471,29 − 216 = 255,29 шт. Денежные значения согласуются с ценой 790 ₽ за единицу: 471,29 × 790 = 372 319,10 ₽, а 255,29 × 790 = 201 679,10 ₽ возможных потерь. Это проверка арифметики примера, а не подтверждение того, сколько товара будет продано.</p>
    <p>Перед заказом проверьте подтверждённые поставки, сроки доставки, минимальную партию и упаковку поставщика. Отдельно учтите акции, изменение цены и спроса. Не считайте, что товарный прогноз автоматически учитывает все ваши будущие планы или распределяет потребность по складам.</p>
    <p>Если запас кажется неверным, сначала <a href={`${base}ostatki-moysklad/`}>проверьте остатки и документы в МоёмСкладе</a>. Товар, закреплённый под заказы, требует отдельной сверки: в инструкции <a href={`${base}kak-snyat-rezervy-moysklad/`}>о резервах</a> разобрано, где искать причины и как их проверять.</p>
    <InlineConsultation title="Поможем разобрать данные перед закупкой" description="Если прогноз и учётные остатки дают разные ориентиры, обсудим вашу задачу и то, какие данные нужно сверить." />
  </section>

  <section aria-labelledby="revenue">
    <h2 id="revenue">Выручка: <span data-heading-accent>отдельный денежный показатель</span></h2>
    <p>На вкладке «Выручка» показаны список «Прогноз для», период, крупный денежный итог и график по дням. В демонстрационном примере выбран весь бизнес. Прогноз за 1–30 октября — 1 021 095,92 ₽, а факт за предыдущие 30 дней — 724 089,60 ₽. Это вымышленные данные, на которых видно, где искать итог и сравнение с историей.</p>
    <ArticleFigure src={revenueImage} alt="Выручка: выбран весь бизнес, прогноз 1 021 095,92 рубля и фактическая выручка за предыдущие 30 дней" fullSize caption="Демонстрационный экран из материалов разработчика. Сумма относится к выбранному бизнесу и периоду; график разделяет прошлые продажи и прогноз. Данные вымышлены." />
    <p>Не подменяйте этот итог суммой колонки «Выручка по цене». В показанной товарной таблице денежные оценки восьми позиций дают 1 480 213,10 ₽, что отличается от отдельного прогноза бизнеса. Перед сравнением проверяйте период, охват данных и правила расчёта: одинаковая валюта ещё не делает показатели одинаковыми.</p>
    <p>Для анализа уже состоявшихся продаж выбирайте исторический отчёт. Продажи, прибыль и остатки можно сопоставить по <a href={`${base}otchety-moysklad/`}>отчётам МоегоСклада</a>. Прогноз отвечает на другой вопрос — чего можно ожидать при имеющейся истории.</p>
  </section>

  <section aria-labelledby="excel">
    <h2 id="excel">Выгрузка <span data-heading-accent>для дальнейшего планирования</span></h2>
    <p>На обеих показанных вкладках есть кнопка «Скачать XLSX». Перед выгрузкой выберите период и отбор, нажмите «Применить» и проверьте итог на экране. После скачивания сверяйте период и показатели в файле с отчётом, который собирались сохранить.</p>
    <p>В рабочей таблице закупок держите прогноз отдельно от утверждённого заказа. Добавьте подтверждённые поставки, сроки, упаковку и принятое количество к заказу: так будет видно, почему решение отличается от расчётного дефицита. Состав листов и охват выгрузки проверяйте в вашей версии приложения.</p>
  </section>

  <section aria-labelledby="limits">
    <h2 id="limits">Что проверить <span data-heading-accent>перед решением</span></h2>
    <p>Прогноз по прошлым продажам не гарантирует будущий спрос. Если товара раньше не было в наличии, низкие продажи могли отражать отсутствие запаса. Если планируется акция, изменение ассортимента или цены, будущая ситуация может отличаться от истории.</p>
    <p>Дробное количество — оценка ожидаемого объёма. Для заказа штучного товара отдельно учитывайте единицу учёта и упаковку. Отсутствие оценки не следует автоматически считать нулевым спросом: сначала проверьте полноту истории и пояснения в приложении.</p>
    <p>Сверяйте даты отчёта и свободный остаток перед закупкой. Если с момента формирования данных поступила партия, изменился резерв или прошла крупная продажа, решение нужно принимать с учётом нового состояния. Возможные потери — ориентир для проверки, а не гарантированная сумма убытка.</p>
  </section>

  <section aria-labelledby="start">
    <h2 id="start">Как <span data-heading-accent>начать работу</span></h2>
    <p>Уточните в TrueTell доступность «Прогнозирования продаж» для вашего аккаунта и условия подключения. Если решение доступно в каталоге, установку выполняет администратор аккаунта МоегоСклада. До подключения проверьте запрашиваемые права и условия в карточке решения.</p>
    <p>Когда отчёт будет доступен, начните с одного периода и небольшой группы знакомых товаров. Сопоставьте историю с учётными данными, проверьте остатки и денежные колонки. Затем используйте прогноз для подготовки закупки и сравнивайте его с последующими фактическими продажами.</p>
    <p>Скриншоты и описание интерфейса предоставлены разработчиком для этой статьи. Они показывают демонстрационную версию; алгоритм, требования к истории и порядок обновления уточняйте для подключённой версии приложения.</p>
  </section>

  <FaqSection variant="article" items={faqItems} />
  <ArticleSources publishedIso={article.publishedAt} modifiedIso={article.updatedAt} {sources} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Обсудим ' }, { text: 'прогноз продаж', accent: true }, { text: ' для вашего бизнеса' }]} description="Уточните доступность приложения и расскажите, какие товары и периоды нужно анализировать. Поможем определить следующий шаг." href={companyInfo.contacts.telegram.url} actionLabel="Уточнить подключение" />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <Fragment slot="after-article"><ConsultationCtaSection /></Fragment>
</ArticleLayout>
