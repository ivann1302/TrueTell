---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import editorialImage from '../../images/articles/moysklad-retail-reports-editorial.png';
import profitabilityImage from '../../images/articles/moysklad-profitability-report-official.png';
import profitLossImage from '../../images/articles/moysklad-profit-loss-report-official.png';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';

const article = getArticle('otchety-moysklad/');
const { title, description } = article;
const canonicalPath = `/${article.hrefPath}`;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const ogImage = new URL(editorialImage.src, siteRoot).toString();
const imageAlt = 'Две модели магазинов, чеки и накладная: рука с карандашом сверяет данные продаж';
const titleParts = [{text:'Отчёты в МойСклад: '}, {text:'продажи, прибыль и магазины',accent:true}];
const support = 'https://support.moysklad.ru/hc/ru/';
const sourceLinks = [
  {label:'Отчёт «Прибыльность» — справка МоегоСклада',href:`${support}отчеты/отчет_прибыльность`},
  {label:'«Прибыли и убытки» — справка МоегоСклада',href:`${support}отчеты/прибыли_и_убытки`},
  {label:'Движение денежных средств — справка МоегоСклада',href:`${support}отчеты/движение_денежных_средств`},
  {label:'Розница: обзор возможностей — справка МоегоСклада',href:`${support}касса%20и%20розница/розница/розница_обзор_возможностеи`},
  {label:'Шаблон «Показатели продаж по точкам» — справка МоегоСклада',href:`${support}шаблоны/показатели_продаж_по_точкам`},
  {label:'Загрузка дополнительного шаблона Excel — справка МоегоСклада',href:`${support}шаблоны/общая%20информация%20о%20шаблонах%20печатных%20форм/загрузка_дополнительного_шаблона_excel`},
];
const reportRows = [
  ['Какие товары дают результат','Продажи → Прибыльность','Продажи, возвраты и себестоимость; выбор товара или точки'],
  ['Что осталось после расходов бизнеса','Деньги → Прибыли и убытки','Расходы и даты начисления; нужна опция «Финансы»'],
  ['Сколько денег поступило и ушло','Деньги → Движение денежных средств','Движение денег, отдельно от результата реализации'],
  ['Как работает розничная точка','Розница → Точки продаж; Смены','Показатели точки и операции конкретной смены'],
  ['Как сравнить суммы продаж точек','Розница → Продажи + дополнительный шаблон','Наличные, безналичные суммы, возвраты и итог'],
];
const exampleRows = [
  ['Продажи','10 единиц × 2 000 ₽','20 000 ₽'],
  ['Возврат','1 единица × 2 000 ₽','2 000 ₽'],
  ['Продажи после возврата','20 000 − 2 000','18 000 ₽'],
  ['Себестоимость проданного','10 единиц × 1 200 ₽','12 000 ₽'],
  ['Себестоимость возвращённого','1 единица × 1 200 ₽','1 200 ₽'],
  ['Результат реализации','18 000 − (12 000 − 1 200)','7 200 ₽'],
];
const diagnosticRows = [
  ['Выручка отчёта отличается от поступлений','Продажи и оплаты выбраны за один период, но относятся к разным событиям','Сверьте документы продажи отдельно от платежей'],
  ['Прибыль неожиданно высокая','Себестоимость отсутствует или занижена','Проверьте поступление товара и остаток на момент продажи'],
  ['Сравнение магазинов меняется после выгрузки','Разный период, точка, тип документа или состав строк','Повторите отбор на одинаковых условиях'],
  ['В отчёте бизнеса не видно аренды','Статья расхода, настройка учёта и дата начисления','Проверьте один расходный документ и его попадание в период'],
];
const faqItems = [
  {question:'Где посмотреть отчёт по продажам в МойСклад?',answer:'Начните с «Продажи → Прибыльность», если нужен результат реализации товаров. Для розничной точки и её смен используйте соответствующие списки в разделе «Розница». Выбирайте экран под вопрос, затем задавайте период и условия отбора.'},
  {question:'Почему прибыль по товарам не равна чистой прибыли?',answer:'Результат реализации ещё не показывает, сколько осталось после аренды, зарплаты и других расходов. Для этой задачи нужен отчёт «Деньги → Прибыли и убытки» с корректно внесёнными расходами. Он доступен с опцией «Финансы».'},
  {question:'Можно ли сравнить продажи нескольких магазинов?',answer:'Да. Для единого списка точек с наличными и безналичными суммами, возвратами и итогами подключите дополнительный шаблон «Показатели продаж по точкам» к списку «Розница → Продажи». Это отдельная печатная форма, а не встроенная вкладка отчёта.'},
  {question:'Почему оплаченная сумма не совпадает с выручкой?',answer:'Оплата и реализация могут произойти в разные периоды. Аванс уже увеличивает поступления, а продажа может быть ещё не оформлена. Сверяйте движение денег и документы продажи отдельно, учитывая даты и возвраты.'},
  {question:'Как проверить подозрительную прибыль товара?',answer:'Откройте детализацию строки товара и сверяйте исходные документы. Начните с цены, возвратов и себестоимости: продажи при отсутствии остатка могут сделать её нулевой или заниженной. Высокий итог сам по себе не доказывает хорошую доходность.'},
  {question:'Нужна ли BI-система для обычного отчёта МойСклад?',answer:'Для разовой проверки продаж и документов часто достаточно штатных отчётов. BI имеет смысл обсуждать, когда нужен регулярный общий отчёт по нескольким источникам, единые правила расчёта и сравнение продаж с запасами. Состав данных и подключение определяются для конкретной задачи.'},
];
const relatedArticles = getRelatedArticles(article.hrefPath).map(item=>({...item,description:item.summaryDescription ?? item.description,href:`${base}${item.hrefPath}`}));
const structuredData = createArticleStructuredData({articleType:'Article',title,description,articleUrl,publishedDate:article.publishedAt,modifiedDate:article.updatedAt,publisherUrl:siteRoot.toString(),image:ogImage,author:authorName,breadcrumbs:[{name:'Главная',item:siteRoot.toString()},{name:'База знаний',item:new URL('knowledge-base/',siteRoot).toString()},{name:title,item:articleUrl}],faqItems});
---

<ArticleLayout {title} {titleParts} {description} {canonicalPath} {structuredData}
  ogTitle={article.seoTitle} ogDescription={description} {ogImage} ogImageAlt={imageAlt}
  category={article.category} author={authorName}
  intro="Выбираем отчёт под вопрос бизнеса, проверяем продажи и возвраты, сравниваем магазины на одинаковых условиях.">
  <Fragment slot="quick-answer">
    <p>Результат продаж товаров смотрите в <strong>Продажи → Прибыльность</strong>, прибыль с расходами бизнеса — в <strong>Деньги → Прибыли и убытки</strong>, поступления и выплаты — в отчёте о движении денег.</p>
    <p>Перед сравнением магазинов согласуйте период и состав продаж. Проверяйте возвраты и себестоимость; сумма в кассе сама по себе не показывает прибыль точки.</p>
  </Fragment>

  <p data-article-lead>Один магазин продаёт больше другого, но это ещё не ответ на вопрос, какой работает выгоднее. Итог зависит от возвратов, закупочной стоимости и расходов. В МойСклад эти вопросы решаются разными отчётами: сначала выберите нужный, затем проверьте условия, на которых получена сумма.</p>
  <ArticleFigure src={editorialImage} alt={imageAlt} caption="Сравнение магазинов начинается с одинаковых условий и исходных документов. Редакционная иллюстрация, не интерфейс МоегоСклада." />

  <section aria-labelledby="choose-report">
    <h2 id="choose-report">Какой отчёт открыть для вашей задачи</h2>
    <p>Сформулируйте один вопрос: что продано, какой результат дали товары, сколько осталось после расходов или сколько денег пришло. Если начать с общей цифры «продажи», легко сравнить разные величины и сделать неверный вывод.</p>
    <DataTable label="Выбор отчёта МойСклад по вопросу бизнеса" columns={['Вопрос','Где смотреть','Что проверить']} rows={reportRows} rowHeaders compact />
    <p>Отчёт о запасе отвечает на другой вопрос — что находится на складе и доступно к продаже. Если проблема связана с резервами или залежавшимися товарами, перейдите к <a href={`${base}ostatki-moysklad/`}>разбору остатков и неликвидов в МойСклад</a>.</p>
  </section>

  <section aria-labelledby="profitability">
    <h2 id="profitability">Как проверить продажи в отчёте «Прибыльность»</h2>
    <ol>
      <li>Откройте <strong>Продажи → Прибыльность</strong> и разрез <strong>«По товарам»</strong>.</li>
      <li>В фильтре задайте период, затем при необходимости склад, точку продаж и тип документа. Выбор склада не заменяет выбор магазина.</li>
      <li>Сопоставьте продажи с возвратами и себестоимостью. В отчёт входят данные отгрузок и розничных продаж; заказ покупателя сам по себе не означает реализацию.</li>
      <li>Откройте строку товара и проверьте документы, если итог выглядит необычно.</li>
    </ol>
    <p>Названия разрезов и фильтров подтверждены <a href={sourceLinks[0].href} target="_blank" rel="noopener noreferrer">официальной справкой</a>. Для первого отчёта выбирайте небольшой период и знакомый товар: так проще объяснить каждую строку, прежде чем анализировать весь ассортимент.</p>
    <ArticleFigure src={profitabilityImage} fullSize alt="Отчёт Прибыльность МоегоСклада: продажи, возвраты, себестоимость и прибыль по товарам" caption="Официальный скриншот справки МоегоСклада. Группы колонок помогают сверить результат реализации; числа на экране — пример интерфейса, не данные клиента TrueTell." />
    <p>Если доходность кажется слишком высокой, начните с закупочных документов. Сервис рассчитывает товарную себестоимость по FIFO; продажи при отсутствии остатка могут занулить или занизить её. Также не смешивайте рентабельность товара и рентабельность продаж: у этих процентов разные основания расчёта.</p>
  </section>

  <section aria-labelledby="returns-example">
    <h2 id="returns-example">Как возврат меняет результат: учебный пример</h2>
    <p>Пусть за период продали 10 единиц по 2 000 ₽, а одну вернули. Себестоимость каждой единицы — 1 200 ₽. Рассмотрим простой пример без комиссии и других расходов; все суммы условные, это не результат работы магазина.</p>
    <DataTable label="Учебный расчёт результата реализации с возвратом" columns={['Величина','Расчёт','Сумма']} rows={exampleRows} rowHeaders compact />
    <p>После возврата остаются продажи на 18 000 ₽ и себестоимость на 10 800 ₽. Разница — 7 200 ₽. Если вычесть возврат только из продаж, сохранив стоимость всех десяти единиц, получится 6 000 ₽: себестоимость возвращённой единицы останется в расходах.</p>
    <p>Эти 7 200 ₽ ещё не чистая прибыль бизнеса. Расходы, которые не входят в товарную себестоимость, проверяются отдельно. Для комиссионных операций и сложных возвратов используйте правила соответствующего отчёта и его документы: упрощённый пример не описывает все варианты учёта.</p>
  </section>

  <section aria-labelledby="business-profit">
    <h2 id="business-profit">Где посмотреть прибыль с расходами бизнеса</h2>
    <p>В разделе <strong>Деньги → Прибыли и убытки</strong> результат последовательно раскрывается от выручки и себестоимости до расходов и чистой прибыли. Для отчёта нужна подключённая опция <strong>«Финансы»</strong>; доступность проверьте в подписке аккаунта.</p>
    <ArticleFigure src={profitLossImage} fullSize alt="Отчёт Прибыли и убытки МоегоСклада: выручка, себестоимость, валовая прибыль, расходы и чистая прибыль" caption="Официальный скриншот из справки МоегоСклада. На этом примере расходы нулевые; экран показывает структуру отчёта, а не подтверждает полноту учёта конкретной компании." />
    <p>Если аренда или зарплата не отразились, откройте расходный документ. Проверьте статью расхода и её настройку <strong>«Учитывать в прибыли»</strong>, затем дату начисления. Для исходящих платежей и расходных ордеров расходы относятся к периоду по этой дате. Покупка товара и перемещение денег не считаются обычными операционными расходами. Подробности — в <a href={sourceLinks[1].href} target="_blank" rel="noopener noreferrer">инструкции к отчёту</a>.</p>
    <p>Выручка возникает по продаже, а поступление — по оплате. Например, аванс получен сегодня, а отгрузка будет в следующем месяце; или продажа уже оформлена, но покупатель ещё не заплатил. Для сверки оплат откройте <strong>Деньги → Движение денежных средств</strong>. Расхождение с выручкой требует объяснения по документам, а не автоматического исправления одной суммы под другую.</p>
  </section>

  <section aria-labelledby="compare-stores">
    <h2 id="compare-stores">Как сравнить продажи магазинов</h2>
    <p>В <strong>Розница → Точки продаж</strong> доступны показатели точек, в том числе выручка, количество продаж и средний чек. В <strong>Розница → Смены</strong> можно разбирать операции отдельной смены. Наличные в кассе рассматривайте отдельно от выручки: на них влияют и другие кассовые операции.</p>
    <p>Для общего списка точек с наличными, безналичными суммами, возвратами и итогами есть дополнительный шаблон <a href={sourceLinks[4].href} target="_blank" rel="noopener noreferrer">«Показатели продаж по точкам»</a>. Он подключается к списку розничных продаж; это отдельная печатная форма.</p>
    <ol>
      <li>Скачайте Excel-шаблон со страницы официальной справки.</li>
      <li>Откройте <strong>Розница → Продажи → Печать → Настроить</strong>.</li>
      <li>Выберите <strong>«Добавить шаблон»</strong> в блоке для списка документов и загрузите скачанный файл.</li>
      <li>Отберите продажи нужного периода и точек, затем выберите добавленную форму в меню <strong>«Печать»</strong>.</li>
    </ol>
    <p>Условия отбора запишите рядом с выгрузкой: даты, точки, тип операций и правила учёта возвратов. Сначала сравните итог с документами одного магазина. Затем повторите проверку для остальных на тех же условиях. Если товар отгружается с общего склада нескольким точкам, фильтр склада не разделит их результаты.</p>
    <p>Для сравнения доходности используйте одинаковые условия в «Прибыльности» с отбором по точке, а расходы магазина рассматривайте отдельно. Более высокая сумма продаж может объясняться размером точки, ассортиментом или числом рабочих дней. Без этих условий таблица показывает различие сумм, но не объясняет его причину.</p>
  </section>

  <section aria-labelledby="diagnostics">
    <h2 id="diagnostics">Что проверить, если цифры не сходятся</h2>
    <p>Не меняйте несколько фильтров одновременно. Выберите один товар, продажу или расход и проследите его путь до итога. Такая проверка показывает, связано ли расхождение с датой, условиями отбора или исходным документом.</p>
    <DataTable label="Проверка расхождений в отчётах МойСклад" columns={['Проблема','Возможная причина','Первое действие']} rows={diagnosticRows} rowHeaders compact />
    <p>После исправления повторите исходную выборку и сохраните условия проверки. Не сравнивайте старую выгрузку с текущим отчётом без учёта изменённых документов: результат мог измениться по обоснованной причине.</p>
    <InlineConsultation title="Нужен общий отчёт по магазинам и товарам" description="Обсудим источники, возвраты, расходы и условия сравнения. Начать можно с одного вопроса и примера расхождения." />
  </section>

  <section aria-labelledby="next">
    <h2 id="next">Когда переходить от штатных отчётов к BI</h2>
    <p>Для разового ответа о продаже или товаре начните со штатного отчёта. Отдельная модель анализа полезна, когда требуется регулярно сопоставлять несколько систем, продажи, запасы и расходы по единым правилам. Сначала определите недостающий ответ, затем состав данных и способ сверки.</p>
    <p>В <a href={`${base}bi-analitika-chto-eto-prostymi-slovami/`}>статье о BI-аналитике</a> разобрано, как исходные записи превращаются в показатели. На странице <a href={`${base}bi-analitika/`}>TrueTell BI для торговли</a> можно посмотреть демонстрацию; нужные источники и объём подключения обсуждаются для конкретной задачи.</p>
  </section>

  <p>Если продажи ведут в CRM, а товарный учёт — здесь, используйте <a href={`${base}bitrix24-moysklad-integraciya/`}>разбор интеграции Битрикс24 и МойСклад</a>. Он помогает согласовать заказы, отгрузки, оплаты и значения остатков до объединения отчётов.</p>

  <p>Загрузка заказов с площадки и расчёт прибыли решают разные задачи. Для операционной части используйте <a href={`${base}moysklad-dlya-marketpleysov/`}>проверку обмена МоегоСклада с маркетплейсами</a>: товары, склады, свободное количество, цены и возвраты.</p>

  <FaqSection id="faq" variant="article" title="Частые вопросы" items={faqItems} />
  <ArticleSources publishedIso={article.publishedAt} modifiedIso={article.updatedAt} sources={sourceLinks} />
  <Fragment slot="article-end">
