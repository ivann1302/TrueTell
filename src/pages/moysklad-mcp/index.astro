---
import { Image } from 'astro:assets';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import SiteFooter from '../../components/footer/site-footer.astro';
import AppHeader from '../../components/header/header.astro';
import ProductScenario from '../../components/product-scenario/product-scenario.astro';
import ProductSummary from '../../components/product-summary/product-summary.astro';
import LineWave from '../../components/ui/line-wave.astro';
import { companyInfo } from '../../config/company';
import { moyskladMcpProduct as product, moyskladMcpProductPath } from '../../config/products';
import chatDemo from '../../images/products/moysklad-mcp-chatgpt-demo.png';
import connectionScreenshot from '../../images/products/moysklad-mcp-connection.png';
import productIcon from '../../images/products/moysklad-mcp-icon.webp';
import clientDiagramMobile from '../../images/products/moysklad-mcp/ai-connection-mobile.webp';
import clientDiagramWide from '../../images/products/moysklad-mcp/ai-connection-wide.webp';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import closing from '../../styles/product-closing.module.scss';
import hero from '../../styles/product-hero.module.scss';
import panels from '../../styles/product-panels.module.scss';
import styles from './page.module.scss';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site ?? new URL('https://truetell-retail.ru');
const pageUrl = new URL(`${base}${moyskladMcpProductPath}`, site).href;
const ogImage = new URL(chatDemo.src, site).href;
const title = 'МойСклад MCP от TrueTell — подключение ИИ к МоемуСкладу';
const { email } = companyInfo.contacts.moyskladMcpSupport;
const trial = `${product.trialDays} дней бесплатно с первой установки`;
const primaryHref = product.marketplaceUrl ?? '#marketplace';
const primaryLabel = `Попробовать ${product.trialDays} дней бесплатно`;
const marketplaceLabel = 'Открыть в каталоге МоегоСклада';
const diagramAlt = 'Схема подключения ИИ к МоемуСкладу через MCP TrueTell. Слева ChatGPT, Claude, Cursor, Qwen Code и DeepSeek, в центре коннектор, справа МойСклад.';
const chatAlt = 'Демонстрационный ответ на вопрос об остатках термокружек: 24 штуки на основном складе и 8 на розничном';

const scenarioSteps = [
  { icon: 'filter', title: 'Найдите товар по артикулу', text: 'Попросите ассистента найти карточку и проверьте название товара в МоемСкладе.' },
  { icon: 'report', title: 'Уточните наличие', text: 'Спросите, сколько единиц доступно на каждом складе.' },
  { icon: 'review', title: 'Сверьте ответ с отчётом', text: 'В отчёте «Остатки» выберите тот же склад и сравните показатель, о котором спрашивали.' },
] as const;

const questions = [
  { topic: 'Товары и наличие', prompt: 'Найди товар по артикулу и покажи, сколько единиц доступно на основном складе.' },
  { topic: 'Заказы покупателей', prompt: 'Какие заказы поступили за последние семь дней? Покажи номера и статусы.' },
  { topic: 'Продажи и прибыль', prompt: 'Какие товары сильнее всего повлияли на изменение валовой прибыли по сравнению с прошлым месяцем?' },
  { topic: 'Оплата счетов', prompt: 'У каких неоплаченных счетов покупателей прошёл срок оплаты? Покажи суммы и даты.' },
];

const faqItems = [
  { question: 'Можно ли использовать DeepSeek или другую модель?', answer: 'Выберите приложение, которое одновременно поддерживает нужную модель и удалённые MCP-серверы по URL. В таком приложении модель сможет обращаться к данным через инструменты MCP, если клиент передаёт ей эти инструменты.' },
  { question: 'Может ли ИИ изменить данные в МоемСкладе?', answer: 'Профиль «Чтение и аналитика» позволяет получать данные и строить отчёты. В этом профиле ассистент не может менять товары, заказы и остатки.' },
  { question: 'Кто получает данные и как отозвать доступ?', answer: 'Запрошенные сведения получает выбранный ИИ-сервис и обрабатывает по своим условиям. Сервер коннектора обрабатывает служебные сведения об установке, подключениях и правах. Храните персональную ссылку как пароль и вставляйте её только в настройки доверенного ассистента. Администратор может отключить или перевыпустить ссылку в разделе «Доступ».' },
  { question: 'Почему в отчёте могут отсутствовать отдельные данные?', answer: 'Ответ зависит от прав ссылки, возможностей аккаунта и заполненности документов. Например, чтобы определить просрочку по неоплаченному счёту, нужен срок оплаты. Попросите ассистента указать, каких данных не хватает, и сверьте итог с отчётом в МоемСкладе.' },
  { question: 'Что произойдёт после окончания пробного или оплаченного периода?', answer: 'Новые запросы по персональной ссылке будут недоступны. Если подписка была приостановлена, после возобновления администратор перевыпускает ссылку и обновляет её в настройках ассистента.' },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage', '@id': `${pageUrl}#webpage`, url: pageUrl, name: title,
      description: product.description, inLanguage: 'ru-RU',
      mainEntity: { '@id': `${pageUrl}#software` },
    },
    {
      '@type': 'SoftwareApplication', '@id': `${pageUrl}#software`, url: pageUrl,
      name: product.name, description: product.description, applicationCategory: 'BusinessApplication',
      image: new URL(productIcon.src, site).href, screenshot: new URL(connectionScreenshot.src, site).href,
      provider: { '@type': 'Organization', name: companyInfo.brandName, url: new URL(`${base}/`, site).href },
    },
  ],
};
---

<BaseLayout {title} description={product.description} canonicalPath={moyskladMcpProductPath} {structuredData}
  {ogImage} ogImageAlt={chatAlt} ogTitle={product.name}
  robots={product.published ? 'index, follow' : 'noindex, nofollow'}
  contentType="commercial" contentCategory="Приложения для МоегоСклада"
  contentStatus={product.published ? 'published' : 'draft'}>
  <AppHeader />
  <main class:list={[styles.page, hero.productPage]}>
    <div class={styles.container}>
      <header class:list={[hero.hero, hero.heroWave]}>
        <LineWave centerOnMobile />
        <div class={hero.heroCopy}>
          <h1>{product.heading}</h1>
          <p class={hero.heroDescription}>Найдите товар по артикулу, проверьте остатки по складам или сравните продажи за два периода. Задавайте вопросы в ChatGPT, Claude, Cursor или другом клиенте с поддержкой удалённого MCP.</p>
        </div>
        <div class={hero.heroActions}>
          <a class={styles.button} href={primaryHref}>{primaryLabel}</a>
        </div>
      </header>

      <ProductSummary description="Коннектор TrueTell даёт выбранному ИИ-ассистенту доступ к данным вашего МоегоСклада. Ассистент получает только те сведения, которые разрешены настройками подключения.">
        <span slot="title">Данные МоегоСклада <strong>прямо в чате</strong></span>
      </ProductSummary>

      <section class={styles.section} aria-labelledby="moysklad-mcp-clients">
        <h2 id="moysklad-mcp-clients">Какой ИИ можно подключить</h2>
        <p class={styles.clientNote}>ChatGPT, Claude, Cursor и Qwen Code поддерживают удалённый MCP. Для DeepSeek и других моделей выберите клиент с поддержкой нужной модели и удалённого MCP по ссылке. Поиск товара через коннектор проверен в ChatGPT.</p>
        <figure class={styles.clientDiagram}>
          <picture>
            <source media="(max-width: 768px)" srcset={clientDiagramMobile.src}
              width={clientDiagramMobile.width} height={clientDiagramMobile.height} />
            <img src={clientDiagramWide.src} alt={diagramAlt} width={clientDiagramWide.width}
              height={clientDiagramWide.height} loading="lazy" decoding="async" />
          </picture>
        </figure>
      </section>

      <ProductScenario id="moysklad-mcp-scenario" title="От артикула до остатков по складам"
        description="Начните с товара, который уже знаете. Так проще проверить первый ответ и понять, какие данные видит ассистент."
        steps={[...scenarioSteps]}>
        <ArticleFigure src={chatDemo} fullSize hideExpandHint alt={chatAlt} caption="Пример диалога в ChatGPT на демонстрационных данных." />
        <a class:list={[styles.button, styles.setupLink]} href="#connection">Посмотреть инструкцию по подключению</a>
      </ProductScenario>

      <section class={styles.section} aria-labelledby="moysklad-mcp-questions">
        <h2 id="moysklad-mcp-questions">Что можно спросить у ИИ</h2>
        <dl class={styles.questions}>
          {questions.map(({ topic, prompt }) => (
            <div><dt>{topic}</dt><dd>«{prompt}»</dd></div>
          ))}
        </dl>
        <p class={styles.note}>Для отчёта по прибыли укажите сравниваемые периоды и проверьте, заполнена ли себестоимость. <a href={`${base}/ii-voprosy-moysklad/`}>Как задавать вопросы и сверять ответы</a></p>
      </section>

      <section id="connection" class:list={[styles.section, styles.split, styles.connection]} aria-labelledby="moysklad-mcp-setup">
        <div>
          <h2 id="moysklad-mcp-setup">Как подключить ИИ к МоемуСкладу</h2>
          <ol class={styles.setup}>
            <li><strong>Установите решение в МоемСкладе.</strong> Администратор открывает вкладку «Подключение» и копирует персональную ссылку.</li>
            <li><strong>Добавьте удалённый MCP-сервер.</strong> Вставьте персональную ссылку в настройки MCP выбранного клиента. Если клиент запрашивает способ входа, выберите подключение без OAuth.</li>
            <li><strong>Задайте первый вопрос.</strong> Включите подключение в чате или агенте, попросите найти товар по артикулу и сверьте ответ с карточкой в МоемСкладе.</li>
          </ol>
          <ul class={styles.clientDocs} aria-label="Справка по установке MCP">
            <li><a href="https://developers.openai.com/api/docs/guides/custom-mcp-server">ChatGPT</a></li>
            <li><a href="https://support.claude.com/en/articles/11175166-get-started-with-custom-connectors-using-remote-mcp">Claude</a></li>
            <li><a href="https://cursor.com/docs/mcp">Cursor</a></li>
            <li><a href="https://github.com/QwenLM/qwen-code/blob/main/docs/users/features/mcp.md">Qwen Code</a></li>
          </ul>
        </div>
        <ArticleFigure src={connectionScreenshot} fullSize hideExpandHint
          alt="Вкладка «Подключение» приложения в МоемСкладе с кнопкой «Скопировать» рядом со скрытой персональной ссылкой"
          caption="Экран приложения TrueTell в МоемСкладе. Персональная ссылка скрыта." />
      </section>

      <section class:list={[styles.section, styles.split, panels.textPanel, styles.trialPanel]} aria-labelledby="moysklad-mcp-trial">
        <div>
          <h2 id="moysklad-mcp-trial">Пробный период</h2>
          <p>{trial}.</p>
        </div>
        <div>
          <p>Подписку на коннектор оформляют и оплачивают в МоемСкладе. Подписка на ИИ-сервис может оплачиваться отдельно.</p>
          <p><a href="https://support.moysklad.ru/hc/ru/интеграции/каталог_решений">Как оплатить решение в МоемСкладе</a></p>
        </div>
      </section>

      <section id="marketplace" class:list={[styles.section, styles.split, panels.textPanel, styles.marketplace]}
        aria-labelledby="moysklad-mcp-marketplace">
        <h2 id="moysklad-mcp-marketplace">Решение в МоемСкладе</h2>
        <div>
          <p>Откройте карточку «МойСклад MCP от TrueTell», чтобы установить коннектор.</p>
          {product.marketplaceUrl ? (
            <a class={styles.button} href={product.marketplaceUrl}>{marketplaceLabel}</a>
          ) : (
            <button class={styles.button} type="button" disabled>{marketplaceLabel}</button>
          )}
        </div>
      </section>

      <div class={styles.section}>
        <FaqSection items={faqItems} title="Вопросы о доступе и данных" id="moysklad-mcp-faq" variant="article" />
      </div>
    </div>
  </main>

  <div class={closing.closingSurface}>
    <LineWave />
    <div class={styles.container}>
      <section class:list={[styles.contact, closing.connectionDark]} aria-labelledby="moysklad-mcp-contact">
        <Image src={productIcon} alt="" width={72} height={72} loading="lazy" />
        <h2 id="moysklad-mcp-contact">Подключите МойСклад к своему ИИ</h2>
        <div>
          <p>Начните с одного вопроса. Найдите товар по артикулу и сверьте ответ с карточкой в МоемСкладе.</p>
          <a class={styles.button} href={primaryHref}>{primaryLabel}</a>
          <p class={styles.support}>Поддержка <a href={`mailto:${email}`}>{email}</a></p>
          <p class={styles.support}>{companyInfo.brandName}, {companyInfo.legal.name}</p>
        </div>
      </section>
    </div>
    <SiteFooter transparent hideDivider />
  </div>
</BaseLayout>
