---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { mcpProduct } from '../../config/products';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import dismissedFilterImage from '../../images/articles/bitrix24-dismissed-filter-official-141.jpg';
import activitiesFilterImage from '../../images/articles/bitrix24-activities-filter-official-141.jpg';
import integrationsImage from '../../images/articles/bitrix24-integrations-list-official-139.jpg';

const article = getArticle('uvolilsya-menedzher-bitrix24-crm/');
const { title, description } = article;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const ogImage = new URL(dismissedFilterImage.src, siteRoot).toString();
const imageAlt = 'Официальный экран Битрикс24: в фильтре сделок «Ответственный» открыта вкладка «Уволенные»';
const faqItems = [
  { question: 'Если сменить ответственного в сделке, её дела перейдут новому менеджеру?', answer: 'Нет. Ответственный меняется только у выбранной карточки CRM. Дела, задачи и связанные элементы нужно проверить и переназначить отдельно.' },
  { question: 'Нужно ли передавать завершённые сделки?', answer: 'Справка Битрикс24 рекомендует сменить ответственного и у завершённых сделок и лидов: если работа возобновится, звонки и уведомления получит новый сотрудник. В рабочем порядке сначала разберите активные карточки и ближайшие дела, затем весь остаток.' },
  { question: 'Что делать, если сотрудника уже уволили, а дела остались за ним?', answer: 'Для переназначения дел справка Битрикс24 описывает временный возврат сотрудника на портал, смену ответственных и повторное увольнение. Проводите этот шаг только администратором с контролем доступа и завершите его повторным увольнением; по возможности передавайте дела до блокировки доступа.' },
  { question: 'Станет ли вебхук безопасным после увольнения его владельца?', answer: 'Само увольнение не меняет URL вебхука. Если выбрать сохранение интеграций, входящий вебхук продолжит работать от системного пользователя с прежними правами. Любой, кто знает старый URL, сможет его вызвать. Проверьте назначение вебхука и удалите ненужный; для нужного согласуйте смену секрета и повторный тест обмена.' },
  { question: 'Может ли MCP TrueTell выполнить передачу автоматически?', answer: 'Готовую автоматическую передачу мы не заявляем. MCP TrueTell для настройки и диагностики CRM находится в разработке. Зафиксированный список карточек, дел и интеграций поможет обсудить безопасный диагностический сценарий и его права.' },
];
const sourceLinks = [
  { label: 'Битрикс24: как передать элементы CRM уволенного сотрудника', href: 'https://helpdesk.bitrix24.ru/open/18001440/' },
  { label: 'Битрикс24: как сменить ответственного в элементе CRM', href: 'https://helpdesk.bitrix24.ru/open/27682504/' },
  { label: 'Битрикс24: увольнение сотрудника и сохранение вебхуков', href: 'https://helpdesk.bitrix24.ru/open/26213326/' },
  { label: 'Битрикс24 REST API: системный пользователь и перенос вебхуков', href: 'https://apidocs.bitrix24.ru/settings/system-user.html' },
  { label: 'Битрикс24: как передать задачи уволенного сотрудника', href: 'https://helpdesk.bitrix24.ru/open/28659766/' },
  { label: 'Битрикс24: список интеграций в разделе «Разработчикам»', href: 'https://helpdesk.bitrix24.ru/open/20886106/' },
];
const auditRows = [
  ['Карточки CRM', 'Сделки, лиды, контакты, компании и другие используемые элементы', 'Список ID с прежним и новым ответственным; выборочная проверка под новой ролью'],
  ['Дела CRM', 'Ближайшие звонки, встречи и другие запланированные действия', 'Новый ответственный, срок и связанная карточка; фильтр по прежнему сотруднику пуст'],
  ['Задачи', 'Незавершённые задачи с участием уходящего менеджера', 'Исполнитель, постановщик и срок проверены по отдельной процедуре задач'],
  ['Интеграции', 'Входящие вебхуки и подключённые приложения', 'Назначение, владелец, решение по доступу и повторный тест обмена'],
];
const acceptanceRows = [
  ['Активная сделка', 'Новый менеджер видит карточку и знает следующий шаг', 'ID, новый ответственный, дата проверки'],
  ['Запланированное дело', 'Исполнитель и срок верны; дело видно в нужной карточке', 'ID дела и карточки, срок, проверяющий'],
  ['Нужный вебхук', 'Согласован владелец и объём прав; контрольный обмен успешен', 'Название интеграции, результат теста без URL и токена'],
];
const structuredData = createArticleStructuredData({
  articleType: 'Article', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  breadcrumbs: [{ name: 'Главная', item: siteRoot.toString() }, { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() }, { name: title, item: articleUrl }],
  faqItems,
});
---
<ArticleLayout {title} titleParts={[{ text: 'Уволился менеджер: ' }, { text: 'как передать CRM Битрикс24', accent: true }]} {description}
  canonicalPath={`/${article.hrefPath}`} {structuredData} ogTitle={article.seoTitle} ogDescription={description}
  {ogImage} ogImageAlt={imageAlt} category={article.category} author={authorName}
  intro="Передать сделки коллеге недостаточно: запланированные звонки могут остаться за прежним сотрудником, а интеграции — работать по его вебхукам. Проверьте каждую часть отдельно и зафиксируйте результат до закрытия доступа.">
  <Fragment slot="quick-answer">
    <p><strong>Проверьте четыре списка: карточки CRM, дела, задачи и интеграции.</strong> Назначьте нового ответственного в каждом рабочем объекте, проверьте ближайшие действия и решите судьбу вебхуков до увольнения сотрудника. После смены доступа откройте контрольную сделку под новой ролью и выполните безопасный тест нужной интеграции.</p>
  </Fragment>

  <p data-article-lead>После смены ответственного за сделки ближайшие звонки могут остаться в списке дел прежнего сотрудника. Этот разрыв легко пропустить: ответственный в карточке и исполнитель дела — разные поля.</p>

  <section aria-labelledby="inventory">
    <h2 id="inventory">Составьте список <span data-heading-accent>до увольнения</span></h2>
    <p>Начните с открытых сделок и лидов, где уходящий сотрудник указан ответственным. Для каждой активной карточки запишите нового владельца и следующий шаг: звонок, встречу, счёт или решение клиента. Отдельно найдите связанные контакты, компании и другие элементы, если сотрудник отвечает за них. Битрикс24 меняет ответственного только у выбранного элемента; связанные карточки сами не перейдут.</p>
    <p>Справка Битрикс24 рекомендует передать и завершённые сделки и лиды, чтобы при возобновлении работы уведомления получил новый ответственный. Для оперативной передачи сначала закройте риск по активным карточкам и ближайшим делам, затем проверьте полный список. Сводку удобно вести без клиентских данных: ID карточки, стадия, новый ответственный, ближайшее действие и статус проверки.</p>
    <DataTable label="Четыре списка для передачи CRM после увольнения менеджера" columns={['Где искать', 'Что проверить', 'Что оставить в журнале']} rows={auditRows} rowHeaders />
  </section>

  <section aria-labelledby="cards">
    <h2 id="cards">Передайте карточки CRM <span data-heading-accent>и проверьте доступ</span></h2>
    <p>Откройте нужный раздел CRM в режиме «Список» и задайте фильтр «Ответственный». Пока человек работает в компании, выберите его в общем списке; после увольнения — на вкладке «Уволенные». Отметьте нужные карточки и выберите «Изменить ответственного». Кнопка «Для всех» применяет действие ко всем найденным элементам, включая другие страницы списка. Перед массовым изменением проверьте фильтр и распределение по новым менеджерам.</p>
    <ArticleFigure src={dismissedFilterImage} fullSize alt={imageAlt} caption="Подлинный экран из справки Битрикс24 «Как передать элементы CRM уволенного сотрудника», обновлённой 29.06.2026. Вкладка «Уволенные» показана на демонстрационных данных Битрикс24; это не клиентский портал TrueTell." />
    <p>После переназначения откройте несколько карточек под ролью нового ответственного: видит ли он сделку, связанные контакты и нужную воронку? Если нет, проверьте <a href={`${base}matrica-prav-crm-bitrix24/`}>матрицу прав CRM</a>. Если новая заявка снова попадает прежнему сотруднику, разбирайте правило назначения отдельно — в материале <a href={`${base}ne-tot-otvetstvennyy-bitrix24/`}>о неверном ответственном</a>.</p>
  </section>

  <section aria-labelledby="activities">
    <h2 id="activities">Переназначьте дела <span data-heading-accent>отдельно от сделок</span></h2>
    <p>В разделе «Ещё» → «Мои дела» найдите дела по ответственному сотруднику. Сначала проверьте ближайшие звонки и встречи: у нового менеджера должны совпасть исполнитель, срок и связанная карточка. Затем переназначьте остальные дела и повторите фильтр по прежнему ответственному. Задачи Битрикс24 находятся в другом контуре: по отдельной процедуре проверьте исполнителя, постановщика и срок.</p>
    <ArticleFigure src={activitiesFilterImage} fullSize alt="Официальный экран Битрикс24 «Мои дела» с фильтром по ответственному сотруднику" caption="Подлинный экран фильтра дел из справки Битрикс24, обновлённой 29.06.2026. Имена и звонки относятся к демонстрационному примеру. Проверяйте в своём портале актуальные и просроченные дела." />
    <p>Если сотрудника уже уволили, справка для передачи дел и счетов описывает временный возврат его учётной записи, переназначение и повторное увольнение. Это административный исключительный шаг: на время возврата доступ снова появляется. Назначьте ответственного за процедуру, контролируйте доступ и сразу завершите повторное увольнение. Если увольнение ещё впереди, передайте дела заранее.</p>
  </section>

  <section aria-labelledby="integrations">
    <h2 id="integrations">Проверьте вебхуки <span data-heading-accent>до закрытия учётной записи</span></h2>
    <p>Попросите администратора открыть «Разработчикам» → «Интеграции» и найти вебхуки и приложения, связанные с уходящим сотрудником. Администратор видит все подключения, обычный сотрудник — только свои. Для каждого подключения запишите назначение, внешнюю систему, необходимые права, владельца процесса и способ контрольного теста. Полный URL входящего вебхука и токены в общий журнал не переносите.</p>
    <ArticleFigure src={integrationsImage} fullSize alt="Официальный экран Битрикс24 «Разработчикам» — список интеграций с пользователем и доступами" caption="Подлинный экран раздела «Интеграции» из официальной справки Битрикс24. Подключения на изображении — демонстрационные; это не интеграции TrueTell или клиента." />
    <p>При увольнении владельца входящих вебхуков Битрикс24 предлагает отключить интеграции или сохранить их. В первом случае вебхуки перестают работать. Во втором они переходят системному пользователю с прежними правами; URL не меняется и остаётся рабочим для любого, кто его знает. Для ненужного подключения удалите вебхук. Для нужного согласуйте новое владение и замену секрета по плану, чтобы не прервать обмен, затем повторите тест. Не считайте системного пользователя заменой ревизии доступа.</p>
    <p>Этот механизм касается входящих вебхуков. У приложений есть отдельная модель системного пользователя и авторизации; не записывайте в реестр, что приложение «перенеслось» вместе с вебхуком. Если интеграция критична для продаж, включите её настройки и результат теста в <a href={`${base}peredacha-crm-bitrix24-posle-vnedreniya/`}>передаточный пакет CRM</a>.</p>
  </section>

  <section aria-labelledby="acceptance">
    <h2 id="acceptance">Закройте передачу <span data-heading-accent>контрольными случаями</span></h2>
    <p>Проверка завершена, когда новый ответственный видит карточку, ближайшее дело стоит у него, а нужная интеграция работает с согласованными правами. Запишите ID, дату, проверяющего и ожидаемый результат. Если один пункт не прошёл, оставьте конкретного владельца исправления и повторный тест.</p>
    <DataTable label="Минимальная проверка передачи CRM" columns={['Случай', 'Ожидаемый результат', 'Что записать']} rows={acceptanceRows} rowHeaders />
    <p>MCP TrueTell для настройки и диагностики CRM находится в разработке. Сейчас полезно составить список проверяемых сигналов и минимальных прав для будущего сценария. Готовую автоматическую передачу сделок, дел или вебхуков мы не заявляем.</p>
    <InlineConsultation variant="product" title="Нужно проверить CRM после ухода менеджера?" description="Опишите, какие карточки, дела и подключения требуют проверки, без клиентских данных и секретов. Поможем составить порядок передачи и обсудим будущий диагностический сценарий MCP TrueTell." href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
  </section>

  <FaqSection title="Частые вопросы о передаче CRM после увольнения" items={faqItems} variant="article" />
  <p>Справка Битрикс24 и документация REST API проверены 31 октября 2026 года. Скриншоты взяты из официальной справки. Действия с учётной записью, вебхуками и правами на конкретном клиентском портале здесь не выполнялись.</p>
  <ArticleSources publishedIso={article.publishedAt} modifiedIso={article.updatedAt} sources={sourceLinks} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Обсудим ' }, { text: 'диагностику CRM с MCP TrueTell', accent: true }]} description={mcpProduct.articleDescription} href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <ConsultationCtaSection slot="after-article" />
</ArticleLayout>
