---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import DataTable from '../../components/editorial/data-table.astro';
import Checklist from '../../components/editorial/checklist.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { mcpProduct } from '../../config/products';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import statusImage from '../../images/articles/truetell-mcp-client-status-085.png';
import directionsImage from '../../images/articles/truetell-mcp-query-check-085.png';
const article = getArticle('podklyuchit-ii-bitrix24/');
const { title, description } = article;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const canonicalPath = `/${article.hrefPath}`;
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const sourceLinks = [
  { label: 'Архитектура MCP: клиент, сервер и инструменты — документация протокола', href: 'https://modelcontextprotocol.io/docs/2026-07-28/learn/architecture' },
  { label: 'MCP Hub: подключение внешних сервисов к агенту внутри Битрикс24 — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/28719662/' },
  { label: 'Подключение собственного MCP в ChatGPT — документация OpenAI', href: 'https://developers.openai.com/plugins/deploy/connect-chatgpt' },
  { label: 'Внешние AI-системы: отдельное официальное решение Битрикс24 — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/26952788/' },
  { label: 'Developer MCP предоставляет документацию, а не данные портала — REST API Битрикс24', href: 'https://apidocs.bitrix24.ru/ai-tools/mcp.html' },
];
const imageAlt = 'Проверка ответа ИИ: для сделки сверяют ID и поля, для списка — условия и полноту, для отчёта — период, состав и формулы';
const ogImage = new URL(directionsImage.src, siteRoot).toString();
const titleParts = [{ text: 'Как подключить ИИ к Битрикс24: ' }, { text: 'выбрать сценарий и подготовить MCP', accent: true }];
const choiceRows = [
  ['Помочь сотруднику с текстом или разговором внутри портала', 'Сначала проверить возможности встроенного помощника в своей версии Битрикс24.', 'Внешнее подключение может не потребоваться.'],
  ['Отвечать клиентам в канале общения', 'Нужен бот с правилами диалога, передачей оператору и согласованными источниками.', 'Наличие MCP само по себе не создаёт клиентский сервис.'],
  ['Задать вопрос о CRM в привычном AI-клиенте', 'Нужно подключение к данным портала. Для такого сценария мы разрабатываем MCP TrueTell.', 'Проверить конкретный клиент, пользователя, инструмент и результат чтения.'],
];
const serverRows = [
  ['MCP TrueTell', 'Внешний AI-клиент обращается к доступным инструментам нашего сервера.', 'Ограниченный результат по данным портала; текущая проверка проведена в Codex.'],
  ['Developer MCP Битрикс24', 'AI получает справку о REST API для разработки.', 'Документация методов; доступа к карточкам портала у этого сервера нет.'],
  ['MCP Hub Битрикс24', 'AI-агент внутри Битрикс24 обращается к внешнему сервису.', 'Результат из выбранного сервиса; направление подключения отличается.'],
];
const faqItems = [
  { question: 'Можно ли просто попросить нейросеть прочитать мой Битрикс24?', answer: 'Обычный текстовый запрос не предоставляет доступ к CRM. Нужны подключение к порталу, авторизация и инструмент, который действительно читает нужные данные. Для этого сценария мы разрабатываем MCP TrueTell.' },
  { question: 'Для чего нужен MCP TrueTell?', answer: 'Цель нашего приложения — дать внешнему AI-клиенту доступ к согласованным инструментам Битрикс24. При подготовке подключения сначала определяют задачу, минимальные данные и проверяемый результат. Конкретные возможности зависят от принятого клиента и инструментов.' },
  { question: 'MCP TrueTell уже работает с ChatGPT и Claude?', answer: 'На 23 октября 2026 года эти клиенты ещё не приняты. В Codex проверены вход и ограниченные вызовы всех 13 инструментов чтения. Полный цикл подключения ещё не принят; эта проверка не доказывает готовность ChatGPT, Claude или публичной установки.' },
  { question: 'MCP заменит чат-бота для клиентов?', answer: 'Сам по себе MCP описывает взаимодействие AI-клиента с инструментами. Бот для клиентов дополнительно требует канала общения, правил диалога, источников ответов и передачи оператору. Такой сценарий нужно проектировать отдельно.' },
  { question: 'Чем сервер для документации отличается от подключения CRM?', answer: 'Developer MCP Битрикс24 помогает получать REST-документацию. Он не читает карточки вашего портала. Ответ с описанием метода API и ответ по реальной сделке решают разные задачи.' },
  { question: 'Можно ли начинать с отчёта по всем продажам?', answer: 'Лучше сначала проверить известную запись. Для полного отчёта дополнительно нужны период, правила отбора, состав полей, обработка ограничений выборки и сверка итогов. Первое успешное чтение не подтверждает корректность всего отчёта.' },
  { question: 'Почему короткий список нельзя считать всеми сделками?', answer: 'Инструмент может вернуть ограниченную выборку. Если результат помечен truncated=true, нужно сузить поддерживаемые условия или открыть уже найденную запись по ID. Нельзя предполагать скрытое продолжение списка и считать по этой части общий итог.' },
  { question: 'Может ли ИИ сам менять стадии и запускать роботов?', answer: 'Рассмотренные здесь проверки относятся к чтению. Из них нельзя вывести готовность изменения записей, роботов или работы по расписанию. Такие действия требуют отдельных инструментов, прав и приёмки; MCP сам по себе не задаёт сценарий автоматизации.' },
  { question: 'Как обсудить подключение MCP TrueTell?', answer: 'Используйте форму на этой странице. Укажите AI-клиент, одну рабочую задачу и способ проверки ответа. Это обсуждение сценария будущего подключения; открытая установка, цена и срок запуска здесь не обещаются.' },
];
const structuredData = createArticleStructuredData({
  articleType: 'BlogPosting', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  articleSection: 'Подключение ИИ к CRM',
  breadcrumbs: [{ name: 'Главная', item: siteRoot.toString() }, { name: 'Блог', item: new URL('blog/', siteRoot).toString() }, { name: title, item: articleUrl }],
  faqItems,
});
---
<ArticleLayout {title} {titleParts} {description} {canonicalPath} {structuredData}
  ogTitle={article.seoTitle} ogDescription={description} {ogImage} ogImageAlt={imageAlt}
  category={article.category} author={authorName}
  intro="Разбираем задачи для MCP TrueTell: найти сделку, понять её стадию, проверить просроченные задачи и оценить границы сводки продаж. Показываем, как сверять ответы ИИ с CRM."
>
  <Fragment slot="quick-answer">
    <p><strong>MCP-сервер связывает внешний AI-клиент с инструментами работы с данными. Мы разрабатываем MCP TrueTell для Битрикс24: начинать стоит с поиска конкретной записи и сверки ответа с CRM.</strong></p>
    <p>На 23 октября 2026 года в Codex проверены вход и ограниченные вызовы 13 инструментов чтения. Полный цикл подключения ещё не принят; ChatGPT и Claude требуют отдельной проверки. Сейчас можно обсудить сценарий MCP TrueTell.</p>
  </Fragment>
  <p data-article-lead>«Подключить ИИ к Битрикс24» может означать помощь менеджеру с текстом, бота в клиентском чате или ответ по CRM в привычной нейросети. Для третьего варианта важно получить реальные данные из портала и понять границы результата. Именно на эту задачу мы ориентируем MCP TrueTell.</p>
  <section aria-labelledby="choose-task">
    <h2 id="choose-task">Начните с <span data-heading-accent>рабочей задачи</span></h2>
    <p>Сформулируйте, что сотрудник должен узнать или сделать. Например: «Найти согласованную тестовую сделку и показать её стадию». Такую задачу можно проверить по карточке. Просьба «проанализируй всё» не задаёт ни состав данных, ни критерий готового ответа.</p>
    <DataTable label="Как выбрать направление подключения ИИ к Битрикс24" columns={['Задача', 'С чего начать', 'Что учесть']} rows={choiceRows} rowHeaders />
    <ArticleFigure src={directionsImage} fullSize alt={imageAlt} caption="Как подготовить сценарий для MCP TrueTell: от одной записи к списку и итогам меняется способ проверки. Это критерии будущей работы, а не обещание доступности всех сценариев. Редакционная инфографика, не экран продукта." />
  </section>
  <section aria-labelledby="our-mcp">
    <h2 id="our-mcp">Где нужен <span data-heading-accent>MCP TrueTell</span></h2>
    <p>Сотрудник задаёт вопрос в AI-клиенте. Клиент запрашивает доступный инструмент MCP TrueTell, сервер получает результат из Битрикс24, а модель использует его в ответе. Для пользователя важны три вещи: найден ли нужный объект, совпадают ли поля с CRM и сохранены ли ограничения выборки.</p>
    <p>Например, чтобы ответить «кто отвечает за эту сделку», нужны сама сделка и достоверная расшифровка ответственного. Описание метода API не заменяет найденную карточку. Если поле не вернулось, модель должна сообщить об этом, а не дополнить ответ правдоподобным именем.</p>
    <InlineConsultation variant="product" title="Какую задачу вы хотите передать ИИ?" description="Опишите одну задачу и ваш AI-клиент. Обсудим её применимость к MCP TrueTell и необходимые проверки до подключения." href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
  </section>
  <section aria-labelledby="mcp-server-bitrix24">
    <h2 id="mcp-server-bitrix24">Как работает <span data-heading-accent>MCP-сервер для Битрикс24</span></h2>
    <p>MCP — протокол обмена между AI-приложением и сервером, который предоставляет инструменты и контекст. Сам протокол не определяет, какие сведения доступны: это зависит от сервера, авторизации и конкретного инструмента. Поэтому запрос «MCP Битрикс24» может приводить к решениям с разным назначением.</p>
    <DataTable label="Чем отличаются MCP TrueTell, developer MCP и MCP Hub" columns={['Решение', 'Направление работы', 'Какой результат ожидать']} rows={serverRows} rowHeaders />
    <p>Наш сценарий — работа из внешнего AI-клиента с данными CRM через MCP TrueTell. Подключение к серверу документации не даёт этот доступ. А подключение внешнего сервиса к агенту внутри Битрикс24 решает задачу с другой точкой входа.</p>
    <p>Наличие MCP также не означает работу по расписанию или реакцию на смену стадии. Если требуется автоматическое действие без запроса сотрудника, отдельно определяют событие, условия запуска и допустимые последствия. Такой процесс не следует обещать по результатам проверки чтения.</p>
  </section>
  <section aria-labelledby="status">
    <h2 id="status">Что проверено <span data-heading-accent>в нашем приложении</span></h2>
    <p>На 23 октября 2026 года в Codex подтверждены персональная OAuth-авторизация и ограниченные реальные вызовы всех 13 инструментов чтения. Среди них — поиск и просмотр сделок, контактов и компаний, чтение воронок, стадий, пользователей и просроченных задач. Найденные сделка, контакт и компания дополнительно прочитаны по ID; результаты совпали.</p>
    <ArticleFigure src={statusImage} fullSize
      alt="Статус проверки MCP TrueTell: в Codex подтверждены вход и первые чтения; ChatGPT и Claude ещё не подтверждены"
      caption="Статус на 23 октября 2026 года по отчёту разработки MCP TrueTell. В Codex проверены вход и ограниченные вызовы 13 инструментов чтения. Полный цикл подключения, другие клиенты и публичный выпуск ещё не приняты. Редакционная инфографика, не экран приложения." />
    <p>Первый доступ к данным ещё не означает устойчивое подключение. При проверке автоматического продления доступа обнаружена ошибка; исправление прошло локальные проверки, но на момент этого снимка ещё не опубликовано. Повторный вход, отзыв доступа и разграничение двух пользователей требуют отдельной приёмки. Для ChatGPT и Claude полный путь от входа до ответа по CRM также не принят. Публичная установка и окончательные условия пока не заявлены.</p>
  </section>
  <section aria-labelledby="first-scope">
    <h2 id="first-scope">Практические сценарии <span data-heading-accent>MCP TrueTell</span></h2>
    <p>Ниже — примеры постановки задач по направлениям проверенного чтения в Codex. Это шаблоны для обсуждения и будущей проверки, не расшифровки реальных диалогов и не обещание поддержки в ChatGPT или Claude. ID и условия заменяют на согласованные тестовые значения.</p>
    <h3>Найти известную сделку, контакт или компанию</h3>
    <blockquote><p>Покажи сделку с ID [ID тестовой сделки]. Верни её ID, название и доступные поля. Ничего не изменяй; если поля нет в результате, не придумывай значение.</p></blockquote>
    <p>Начните с точного ID. Совпадение названия недостаточно: у разных записей оно может быть одинаковым. Отдельно можно проверить известный контакт или компанию по их собственному ID. В проверке Codex найденные записи каждого типа были прочитаны обратно; это подтверждает отдельные чтения, но не автоматическое определение связей между ними.</p>
    <p>Такой сценарий помогает быстро получить доступные сведения о выбранном объекте. Он не подтверждает доступ ко всей истории общения, письмам, файлам или звонкам: эти источники в рассмотренную проверку не входили.</p>
    <h3>Понять, к какой воронке и стадии относится сделка</h3>
    <blockquote><p>Покажи доступные воронки и стадии выбранной воронки [ID]. Сопоставь их с данными тестовой сделки [ID]. Если справочника или нужного поля нет, оставь код и объясни, чего не хватает для расшифровки.</p></blockquote>
    <p>Стадии проверяют в контексте нужной воронки. Достоверное название берут из её справочника, а не подбирают по похожему коду. Если справочник вернулся частично, это ограничение сохраняют в ответе. Смысл показателей и расчёт конверсии разбираем отдельно в статье о <a href={`${base}voronka-prodazh-bitrix24/`}>воронке продаж Битрикс24</a>.</p>
    <h3>Проверить просроченные задачи</h3>
    <blockquote><p>Покажи не больше пяти просроченных задач, доступных подключению. Сохрани возвращённые ID и доступные сроки. Укажи условия отбора и сообщи, ограничена ли выборка. Ничего не изменяй.</p></blockquote>
    <p>Сравните полученные ID и сроки с задачами в портале под тем же пользователем. Первые пять строк — удобная проверка чтения, но не доказательство полного списка просрочек. По такой части нельзя делать вывод о нагрузке всего отдела или назначать виновных.</p>
    <h3>Подготовить сводку продаж</h3>
    <p>Для запроса о продажах сначала согласуют период, дату отбора, валюту и состав сделок. Ответ должен объяснять, какие записи вошли в расчёт. В нашей проверке инструмент сводки был вызван успешно, но в выбранном диапазоне не было проанализированных сделок. Этот результат не подтверждает корректность сумм на непустой выборке.</p>
    <p>Поэтому перед регулярным использованием нужен отдельный тест на согласованном наборе продаж с известными итогами. Формулы, возвраты и полноту данных проверяют по <a href={`${base}otchety-po-prodazham-bitrix24/`}>отчёту по продажам Битрикс24</a>. Первый успешный поиск сделки не заменяет эту работу.</p>
  </section>
  <section aria-labelledby="partial-result">
    <h2 id="partial-result">Если ответ содержит <span data-heading-accent>только часть данных</span></h2>
    <p>У результатов чтения MCP TrueTell может быть признак <code>truncated=true</code>: выборка ограничена. В таком случае нейросеть должна сообщить об ограничении. Нельзя назвать возвращённую часть всеми сделками, контактами или задачами и посчитать по ней общий итог.</p>
    <p>Следующий шаг — сузить условия, которые поддерживает конкретный инструмент, или прочитать уже найденную запись по её ID. Не следует предполагать скрытый способ продолжения списка. Если данных всё равно недостаточно, запрос нужно уточнить или проверить результат другим согласованным способом.</p>
    <p>Пустой ответ также требует проверки: доступна ли запись тому же пользователю в CRM, верен ли ID и подходят ли условия. Он сам по себе не доказывает ни отсутствие объекта во всём портале, ни ошибку подключения.</p>
  </section>
  <section aria-labelledby="brief">
    <h2 id="brief">Что подготовить <span data-heading-accent>для обсуждения подключения</span></h2>
    <Checklist label="Короткий бриф для MCP TrueTell" items={[
      { title: 'AI-клиент и пользователь', description: 'Где сотрудник хочет работать и кто будет проверять результат в CRM.' },
      { title: 'Одна задача', description: 'Какой вопрос нужно закрыть: найти запись, показать доступные воронки или проверить небольшой список.' },
      { title: 'Минимальные данные', description: 'Какие сущности и поля нужны. Для первого обращения достаточно описания, без содержимого клиентских карточек.' },
      { title: 'Критерий результата', description: 'С какой карточкой или отчётом сравнить ответ и кто подтвердит совпадение.' },
    ]} />
    <p>При проверке отдельно согласуют права пользователя и доступные инструменты. Фраза в чате «ничего не меняй» не меняет технические разрешения. Проверку чтения проводят инструментом чтения; сценарии записи требуют отдельной оценки и приёмки.</p>
    <p>Если проблема начинается с непонятных или повторяющихся полей, сначала полезен <a href={`${base}audit-poley-crm-bitrix24/`}>аудит полей CRM</a>. Он помогает понять, где хранятся нужные сведения, прежде чем просить модель интерпретировать их.</p>
  </section>
  <section aria-labelledby="next">
    <h2 id="next">Следующий шаг — <span data-heading-accent>сценарий для MCP TrueTell</span></h2>
