---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import invoiceImage from '../../images/articles/bitrix24-invoice-deadlines-official.jpg';
import financialImage from '../../images/articles/one-c-payment-calendar-official.png';
import balanceImage from '../../images/articles/payment-calendar-daily-balance.png';

const article = getArticle('platezhnyy-kalendar-bitrix24/');
const { title, description } = article;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const canonicalPath = `/${article.hrefPath}`;
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const imageAlt = 'Официальный экран Битрикс24: счета в режиме Сроки, сгруппированные по датам оплаты';
const ogImage = new URL(invoiceImage.src, siteRoot).toString();
const titleParts = [
  { text: 'Платёжный календарь в CRM и финансовый календарь компании: ' },
  { text: 'в чём разница', accent: true },
];
const sourceLinks = [
  { label: 'Режим просмотра «Сроки» в CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/25376268/' },
  { label: 'Настройки календаря и опция «Календарь CRM» — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/24853428/' },
  { label: 'Платёжный календарь в 1С:УНФ и 1С:Рознице — материал разработчика', href: 'https://v8.1c.ru/metod/article/platezhnyy-kalendar-chtoby-izbezhat-kassovogo-razryva-i-sokhranit-platezhesposobnost.htm' },
  { label: 'Планирование поступлений и выплат — разработчик 1С', href: 'https://v8.1c.ru/news/planiruyte-dengi-biznesa-s-platezhnym-kalendarem.htm' },
  { label: 'Платёжный календарь в подсистеме казначейства — 1С:ERP', href: 'https://v8.1c.ru/erp/treasury/' },
  { label: 'Описание приложения «Платежный календарь» Gorillas — Маркет Битрикс24', href: 'https://www.bitrix24.ru/apps/app/gorillas.app5/' },
];
const comparisonRows = [
  ['Действия сотрудников', 'Встречи, звонки, поручения и их сроки', 'Когда сотруднику связаться с клиентом?'],
  ['Поступления по сделкам', 'Клиент, обязательство, плановая дата и сумма; подтверждённый факт отдельно', 'Сколько и когда ожидаем от клиентов?'],
  ['Денежный план компании', 'Доступные деньги на начало, все выбранные поступления и выплаты по датам', 'Хватит ли денег на нужную дату и на нужном счёте?'],
];
const forecastRows = [
  ['День 1', '30 000 ₽', '20 000 ₽', '60 000 ₽', '−10 000 ₽'],
  ['День 2', '−10 000 ₽', '50 000 ₽', '10 000 ₽', '30 000 ₽'],
];
const updateRows = [
  ['До поступления · начало Дня 1', '30 000 ₽', '20 000 ₽', '60 000 ₽', '−10 000 ₽'],
  ['После получения 12 000 ₽ · верно', '42 000 ₽', '8 000 ₽', '60 000 ₽', '−10 000 ₽'],
  ['После получения 12 000 ₽ · ошибка', '42 000 ₽', '20 000 ₽', '60 000 ₽', '2 000 ₽ · завышено'],
];
const faqItems = [
  { question: 'Есть ли в Битрикс24 штатный платёжный календарь?', answer: 'В штатных инструментах, разобранных в статье, есть календарь событий и режим «Сроки» для счетов CRM. Настройка «Календарь CRM» относится к звонкам и встречам из карточек. Эти инструменты сами по себе не подтверждают полный прогноз денег компании. Если выбираете отдельное приложение, проверьте его поступления, выплаты, остатки и источники данных по актуальной документации.' },
  { question: 'Может ли платёжный календарь внутри CRM учитывать расходы?', answer: 'Да, конкретное CRM-приложение может поддерживать входящие и исходящие платежи. Место установки не определяет охват. Для финансового планирования важнее наличие доступных остатков, всех нужных выплат, дат, валют и проверяемого обновления, чем название программы или раздела.' },
  { question: 'Можно ли рассчитать кассовый разрыв только по сделкам?', answer: 'Список ожидаемых поступлений от клиентов недостаточен: нужны доступные деньги на начало и выплаты по соответствующим датам. Сумма успешных сделок не заменяет подтверждённые деньги на счёте. Важно также знать, какие счета и валюты включены в прогноз.' },
  { question: 'Почему положительный итог месяца не гарантирует, что денег хватит?', answer: 'Выплата может наступить раньше поступления. В учебном примере итоговый остаток двух дней равен 30 000 ₽, но после первого дня в плане не хватает 10 000 ₽. Проверяйте последовательные остатки по датам, а при необходимости — порядок операций внутри дня.' },
  { question: 'Обязательно ли вести финансовый календарь в отдельной программе?', answer: 'Для небольшого проверяемого плана может хватить таблицы. При выборе инструмента оцените объём операций, число счетов и валют, права сотрудников, историю изменений и способ сверки. Если выбранное CRM-приложение покрывает эти требования, сам факт работы внутри CRM не мешает использовать его для денежного плана.' },
  { question: 'Какой календарь планируется в «Графике платежей» TrueTell?', answer: 'В тестовой установке на 25 октября 2026 года проверен календарь плановых поступлений клиентов по CRM-сделкам и ручных записей факта. На двух порталах проверено сохранение графиков, на первом — поступления, исправление и отмена, отчёт и CSV. Приложение ещё не выпущено в Маркете. Полный календарь выплат и банковских остатков этой проверкой не подтверждён.' },
  { question: 'Как учесть частичную оплату в платёжном календаре?', answer: 'Свяжите подтверждённое поступление с соответствующей частью плана и пересчитайте оставшуюся ожидаемую сумму. Если из плановых 20 000 ₽ получено 12 000 ₽, остаётся ожидать 8 000 ₽. При использовании фактического остатка денег после поступления в прогноз добавляют только эти 8 000 ₽. Сохраните исходный план и историю факта, чтобы не посчитать полученные деньги повторно.' },
  { question: 'Подойдёт ли Excel-шаблон графика для финансового календаря компании?', answer: 'Шаблон TrueTell по ссылке в статье рассчитан на одну сделку в RUB: до 20 этапов и 50 записей журнала. Он помогает подготовить клиентские суммы и сроки, но не собирает выплаты компании и остатки банковских счетов. Для полного денежного плана понадобятся дополнительные данные и их сверка. Автоматической связи с CRM и банком у файла нет.' },
];
const relatedArticles = getRelatedArticles(article.hrefPath)
  .map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const structuredData = createArticleStructuredData({
  articleType: 'BlogPosting', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  articleSection: 'Планирование оплат',
  breadcrumbs: [
    { name: 'Главная', item: siteRoot.toString() },
    { name: 'Блог', item: new URL('blog/', siteRoot).toString() },
    { name: title, item: articleUrl },
  ],
  faqItems,
});
---

<ArticleLayout {title} {titleParts} {description} {canonicalPath} {structuredData}
  ogTitle={article.seoTitle} ogDescription={description} {ogImage} ogImageAlt={imageAlt}
  category={article.category} author={authorName}
  intro="Как выбрать календарь по задаче: организовать работу менеджера, увидеть ожидаемые оплаты клиентов или проверить, хватит ли денег компании на будущие выплаты."
>
  <Fragment slot="quick-answer">
    <p><strong>Календарь поступлений по сделкам отвечает, сколько и когда ожидаем от клиентов. Финансовый календарь сопоставляет эти поступления с выплатами и доступными деньгами на каждую дату.</strong> Календарь встреч и поручений организует действия сотрудников.</p>
    <p>Сравнивайте состав данных и расчёты конкретного инструмента. Приложение внутри CRM тоже может учитывать расходы; название раздела и календарная сетка ещё не говорят, какую задачу он решает.</p>
  </Fragment>

  <p data-article-lead>Клиент обещал оплатить заказ в конце недели, а платёж поставщику нужен раньше. Менеджер видит будущую оплату в сделке, руководитель — хороший итог продаж. Чтобы понять, хватает ли денег на ближайшую выплату, понадобится ещё начальный остаток и остальные движения по датам.</p>

  <section aria-labelledby="calendar-purpose">
    <h2 id="calendar-purpose">Сначала определите, <span data-heading-accent>что должно попасть в календарь</span></h2>
    <p>В запросе «платёжный календарь в Битрикс24» могут скрываться разные задачи. Одному сотруднику нужно позвонить перед сроком оплаты, другому — видеть ожидаемые поступления по всем сделкам, третьему — сопоставлять эти деньги с зарплатой, поставщиками и другими выплатами.</p>
    <p>Для сравнения используем три рабочих сценария. На телефоне таблица прокручивается вправо.</p>
    <DataTable label="Назначение календаря действий, календаря поступлений и финансового календаря"
      columns={['Сценарий', 'Что собираем', 'На какой вопрос отвечаем']} rows={comparisonRows} rowHeaders />
    <p>Один продукт может совмещать несколько сценариев. Например, в описании приложения «Платежный календарь» Gorillas в Маркете Битрикс24 указаны входящие и исходящие платежи. Это заявление разработчика о конкретном приложении, а не результат нашего тестирования. <a href={sourceLinks[5].href} target="_blank" rel="noopener noreferrer">Описание приложения в Маркете</a>.</p>
    <p>Поэтому сравнение «CRM или финансовая система» лучше начинать с вопроса: какие деньги, обязательства и действия охватывает выбранный инструмент? Затем проверять источники, права и обновление.</p>
  </section>

  <section aria-labelledby="bitrix-native-calendars">
    <h2 id="bitrix-native-calendars">Что показывают <span data-heading-accent>штатные инструменты Битрикс24</span></h2>
    <p>Календарь сотрудников помогает планировать события, задачи и встречи. В его настройках «Календарь CRM» означает календарь для звонков и встреч, запланированных в карточках CRM. «Календарь компании» в этом разделе тоже относится к организации событий. Эти названия не обозначают расчёт денежных остатков. <a href={sourceLinks[1].href} target="_blank" rel="noopener noreferrer">Как устроены настройки календаря</a>.</p>
    <p>Для счетов откройте CRM → Продажи → Счета → Сроки. Карточки распределены по полю «Срок оплаты», но общих денежных итогов колонок нет. Такой экран помогает найти нужные счета и спланировать действия по ним. <a href={sourceLinks[0].href} target="_blank" rel="noopener noreferrer">Официальное описание режима «Сроки»</a>.</p>
    <ArticleFigure src={invoiceImage} fullSize alt={imageAlt}
      caption="Оригинальный экран Поддержки24: выбор режима «Сроки» для счетов. Даты и клиенты относятся к примеру документации. Карточки счетов помогают ориентироваться в сроках; это не расчёт доступных денег компании." />
    <p>Перетаскивание карточки здесь меняет срок оплаты счёта. Для просмотра используйте фильтры; новую дату ставьте по согласованному изменению условий. Срок поручения менеджеру, срок оплаты и дата подтверждённого поступления должны оставаться отдельными данными.</p>
    <p>Если задача — видеть оплаты клиента по этапам, сначала определите плановую дату и сумму каждого обязательства. Это разобрано в <a href={`${base}grafik-platezhey-bitrix24/`}>инструкции по составлению графика платежей</a>. Факт сверяйте отдельно — по <a href={`${base}chastichnaya-oplata-bitrix24/`}>порядку учёта частичной оплаты</a>.</p>
  </section>

  <section aria-labelledby="company-cash-calendar">
    <h2 id="company-cash-calendar">Что добавляет <span data-heading-accent>финансовый календарь компании</span></h2>
    <p>Его отправная точка — доступные деньги на выбранных счетах и в кассах. К ним по датам добавляются ожидаемые поступления и вычитаются выплаты. Так можно оценить обеспеченность плана на конкретный день, а не только общую сумму будущих оплат клиентов.</p>
    <p>Пример такого инструмента описан разработчиком 1С для 1С:УНФ и 1С:Розницы: календарь собирает поступления и выплаты, показывает денежные остатки. В статье разработчика приведён следующий экран. <a href={sourceLinks[2].href} target="_blank" rel="noopener noreferrer">Материал 1С о платёжном календаре</a>.</p>
    <ArticleFigure src={financialImage} fullSize
      alt="Официальный пример платёжного календаря 1С: строки счетов и кассы, поступления покупателей, выплаты поставщикам и денежные остатки по периодам"
      caption="Неизменённый пример из материала разработчика 1С. В нём сохранены исходные даты и суммы, включая данные 2019 года. Экран иллюстрирует состав финансового календаря; это не интерфейс TrueTell и не данные нашей компании." />
    <p>В описании казначейства 1С:ERP также разделены доступные остатки, поступления клиентов, выплаты поставщикам и прочие движения. Это пример финансового охвата, а не подтверждение таких функций в штатном календаре Битрикс24. <a href={sourceLinks[4].href} target="_blank" rel="noopener noreferrer">Платёжный календарь 1С:ERP</a>.</p>
    <p>Укажите границы своего плана: организацию, счета, кассы, валюты и дату среза. Деньги на другом счёте нельзя считать доступными для нужной выплаты без проверки возможности и срока их использования. Разные валюты ведите отдельно или применяйте заранее согласованное правило пересчёта.</p>
  </section>

  <section aria-labelledby="daily-balance-example">
    <h2 id="daily-balance-example">Почему <span data-heading-accent>30 000 ₽ в конце периода</span> могут скрывать нехватку раньше</h2>
    <p>Возьмём учебный план в RUB для одного условного счёта. На начало доступны 30 000 ₽. В первый день ожидается поступление 20 000 ₽ и выплата 60 000 ₽; во второй — поступление 50 000 ₽ и выплата 10 000 ₽. Это условные числа для объяснения расчёта, не результат клиента.</p>
    <p>Расчётный остаток на конец дня = остаток на начало + ожидаемые поступления − запланированные выплаты. Остаток предыдущего дня переходит в следующий. Таблицу на телефоне можно прокрутить вправо.</p>
    <DataTable label="Учебный двухдневный денежный план, все суммы в RUB"
      columns={['День', 'На начало', 'Поступления', 'Выплаты', 'На конец']} rows={forecastRows} rowHeaders />
    <p>За два дня поступления и выплаты равны — по 70 000 ₽. Итоговый остаток снова 30 000 ₽. Но в конце первого дня расчёт даёт −10 000 ₽: при этих допущениях для выполнения всего плана не хватает 10 000 ₽. Поступление второго дня приходит позже.</p>
    <ArticleFigure src={balanceImage} fullSize
      alt="Учебный прогноз: начальный остаток 30 тысяч рублей, после первого дня минус 10 тысяч, после второго снова 30 тысяч; отрицательный участок выделен красным"
      caption="Учебная инфографика TrueTell по таблице выше. Показан расчётный остаток при выполнении всех плановых движений. Отрицательное значение обозначает нехватку для плана, а не фактически разрешённый минус на банковском счёте." />
    <p>Этот пример не предполагает, что банк проведёт необеспечённую выплату. Отрицательный остаток — сигнал проверить сроки, полноту данных и выполнимость плана. Решение о конкретных платежах принимает ответственный сотрудник по условиям и порядку компании.</p>
    <p>Даже детализации по дням иногда мало: если утром нужна выплата, а поступление ожидается вечером, положительный остаток на конец дня не решает вопрос времени. Для таких операций уточняйте очередность. Обещанная дата клиента остаётся предположением прогноза, пока факт не подтверждён.</p>
  </section>

  <section aria-labelledby="partial-payment-forecast">
    <h2 id="partial-payment-forecast">Как обновить календарь <span data-heading-accent>после частичной оплаты</span></h2>
    <p>Продолжим тот же учебный День 1, но возьмём новый момент: клиент уже перечислил 12 000 ₽ из ожидаемых 20 000 ₽, поступление подтверждено, а выплата 60 000 ₽ ещё не выполнена. На начало дня было 30 000 ₽; теперь фактически доступно 42 000 ₽. Осталось ожидать 8 000 ₽, если клиент оплатит остаток в запланированный срок.</p>
    <p>Для прогноза от этого момента используйте текущие доступные деньги и только оставшиеся движения: <strong>42 000 + 8 000 − 60 000 = −10 000 ₽.</strong> Начальный остаток самого дня остаётся 30 000 ₽. Первоначальный план и подтверждённое поступление сохраняются отдельно; менять исходные 20 000 ₽ на 8 000 ₽ без истории не нужно.</p>
    <DataTable label="Пересчёт учебного Дня 1 после частичного поступления, все суммы в RUB"
      columns={['Момент и вариант', 'Доступно на этот момент', 'Ещё ожидается', 'Ещё предстоит выплатить', 'Прогноз на конец дня']} rows={updateRows} rowHeaders />
    <p>Если к текущим 42 000 ₽ добавить прежние 20 000 ₽ целиком, получится ложный положительный итог 2 000 ₽. Уже полученные 12 000 ₽ попадут в расчёт дважды — в фактический остаток и в будущие поступления. При правильном обновлении нехватка для исходного плана остаётся 10 000 ₽; график выше показывает первоначальный двухдневный план.</p>
    <p>Свяжите поступление с ID обязательства и источником, укажите погашенную часть, оставшуюся сумму и дату следующей проверки. Практический порядок распределения есть в <a href={`${base}chastichnaya-oplata-bitrix24/#allocate-receipt`}>примере частичной оплаты по этапам</a>. Если оставшиеся 8 000 ₽ пока не подтверждены фактом, они остаются предположением прогноза, а не доступными деньгами.</p>
  </section>

  <section aria-labelledby="calendar-data-quality">
    <h2 id="calendar-data-quality">Что проверить <span data-heading-accent>до выбора программы</span></h2>
    <p>Начните с источника начальных денег и времени последней сверки. Затем проверьте состав поступлений и выплат: нет ли пропущенных операций, дублей и сумм без дат. План с неопределённой датой показывайте отдельно; перенос всей суммы в конец недели без объяснения сделает прогноз удобнее на экране, но слабее для решения.</p>
    <p>В финансовом плане нужны и повторяющиеся движения, которые могут отсутствовать в отделе продаж. Материал разработчика 1С разбирает планирование поступлений и выплат. В своей компании согласуйте, кто поддерживает эти записи и как учитываются изменения. <a href={sourceLinks[3].href} target="_blank" rel="noopener noreferrer">Планирование денег бизнеса</a>.</p>
    <p>Когда плановая оплата подтверждена, свяжите факт с соответствующей записью. Не оставляйте ту же сумму одновременно в будущих поступлениях и в уже полученных деньгах. Сумма сделки, закрытая задача и сообщение клиента «перевели» сами по себе не подтверждают банковскую операцию.</p>
    <p>Для руководителя полезны дата среза, источник расчёта и возможность перейти от итоговой суммы к конкретным движениям. Общие принципы выбора показателей есть в <a href={`${base}dashbord-rukovoditelya-bitrix24/`}>статье о дашборде руководителя</a>. Работа с уже непогашенными обязательствами и просрочкой — отдельный сценарий, рассмотренный в <a href={`${base}debitorskaya-zadolzhennost-bitrix24/`}>материале о задолженности</a>.</p>
    <InlineConsultation title="Нужно определить состав календаря?"
      description="Разберём, какие поступления и выплаты нужны в вашем плане, где подтверждаются деньги и какие действия должны выполнять сотрудники."
      href={companyInfo.contacts.consultationUrl} actionLabel="Обсудить задачу" />
  </section>

  <section aria-labelledby="calendar-choice">
    <h2 id="calendar-choice">Как выбрать <span data-heading-accent>подходящий охват</span></h2>
    <p>Если нужно организовать звонки и проверки, начинайте с дел, задач и календаря сотрудников. Если вопрос в датах и суммах будущих оплат клиентов, нужен график обязательств по сделкам с отдельным подтверждённым фактом. Если вопрос «хватит ли денег на выплаты», соберите поступления и выплаты по нужным счетам и кассам и проверьте остатки на каждую дату.</p>
    <p>Для небольшого плана можно начать с проверяемой таблицы. Когда записей, счетов и изменений становится много, оцените детализацию, доступы, историю правок и способ обновления. Выбранное приложение в CRM может подходить, если оно действительно покрывает эти требования; расположение внутри CRM само по себе не является ограничением.</p>
    <p>Если сначала нужно собрать этапы оплаты одного клиента, используйте <a href={`${base}grafik-platezhey-bitrix24/#download-payment-template`}>ручной Excel-шаблон графика и журнала поступлений</a>. Он рассчитан на одну сделку в RUB, до 20 этапов и 50 записей, без связи с CRM и банком. Файл помогает подготовить клиентскую часть плана; выплат компании и банковских остатков в нём нет, поэтому он не заменяет полный финансовый календарь.</p>
    <p>TrueTell разрабатывает «График платежей» для Битрикс24. На 25 октября 2026 года в тестовых установках на двух порталах проверено сохранение графиков. На первом также проверены ручное поступление с исправлением и отменой, общий отчёт, календарь поступлений и обе CSV; на втором — разграничение прав. <strong>Приложение ещё не выпущено в Маркете</strong>. Проверка на тестовых порталах не подтверждает готовность к тиражному внедрению или сверку с банком.</p>
    <p>Календарь приложения показывает поступления клиентов по сделкам. Полный календарь выплат, банковских остатков и расчёта кассового разрыва этими проверками не подтверждён. При обсуждении внедрения сначала согласуйте требуемый охват и источники; это поможет отделить задачи приложения от отдельной финансовой интеграции.</p>
  </section>

