---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import DataTable from '../../components/editorial/data-table.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import marginMarkupImage from '../../images/articles/margin-markup-denominator-071.png';
import discountImage from '../../images/articles/margin-discount-effect-071.png';

const article = getArticle('marzhinalnost-tovara/');
const { title, description } = article;
const canonicalPath = `/${article.hrefPath}`;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const imageAlt = 'Сравнение двух расчётов по одному товару: валовая прибыль 500 рублей делится на выручку 1500 рублей для маржинальности 33,3% и на себестоимость 1000 рублей для наценки 50%';
const ogImage = new URL(marginMarkupImage.src, siteRoot).toString();
const titleParts = [{ text: 'Маржа и наценка: ' }, { text: 'как рассчитать маржинальность товара', accent: true }];

const sources = [
  { label: 'ФСБУ 4/2023, пункт 27 — валовая прибыль как разность выручки и себестоимости продаж', href: 'https://www.consultant.ru/document/cons_doc_LAW_472684/' },
  { label: 'AQA — формулы валовой маржи и наценки', href: 'https://www.aqa.org.uk/subjects/accounting/a-level/accounting-7127/specification/appendix-accounting-ratios' },
  { label: 'OpenStax — выручка, себестоимость и валовая прибыль', href: 'https://openstax.org/books/principles-financial-accounting/pages/6-key-terms' },
];

const faqItems = [
  { question: 'Как рассчитать маржинальность товара?', answer: 'Сначала найдите валовую прибыль: выручка от продажи без НДС минус та себестоимость продаж, которую вы включаете в расчёт. Затем разделите валовую прибыль на выручку и умножьте на 100%. Для цены 1 500 ₽ и себестоимости 1 000 ₽ маржинальность равна 33,3%. Это упрощённый расчёт до расходов, не включённых в себестоимость.' },
  { question: 'Чем маржа отличается от наценки?', answer: 'Маржа в рублях в этом примере — разница цены и себестоимости, 500 ₽. Маржинальность делит эту разницу на выручку: 500 / 1 500 = 33,3%. Наценка делит её на себестоимость: 500 / 1 000 = 50%. Процент зависит от знаменателя.' },
  { question: 'Наценка 50% означает маржинальность 50%?', answer: 'Нет. Если себестоимость равна 1 000 ₽, наценка 50% даёт цену 1 500 ₽. Валовая прибыль составит 500 ₽, а маржинальность от цены продажи — 500 / 1 500 = 33,3%.' },
  { question: 'Можно ли по маржинальности понять чистую прибыль?', answer: 'Нет. Показатель в статье рассчитан до расходов, которые не включены в себестоимость товара: например, аренды, зарплат, рекламы и части комиссий. Чистый финансовый результат требует учесть все относящиеся к периоду доходы, расходы, скидки, возвраты и налоги.' },
  { question: 'Что делать, если товар продали со скидкой?', answer: 'Используйте фактическую выручку после скидки, а не прежнюю цену из прайс-листа. При себестоимости 1 000 ₽ снижение цены с 1 500 до 1 350 ₽ уменьшает валовую прибыль с 500 до 350 ₽, а маржинальность — с 33,3% до 25,9%.' },
];

const comparisonRows = [
  ['Валовая прибыль (маржа в рублях)', 'Выручка − себестоимость продаж', '500 ₽'],
  ['Маржинальность', 'Валовая прибыль ÷ выручка × 100%', '33,3%'],
  ['Наценка', 'Валовая прибыль ÷ себестоимость × 100%', '50%'],
];
const relatedArticles = getRelatedArticles(article.hrefPath)
  .map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const structuredData = createArticleStructuredData({
  articleType: 'BlogPosting', title, description, articleUrl, publishedDate: article.publishedAt, modifiedDate: article.updatedAt, publisherUrl: siteRoot.toString(),
  image: ogImage, author: authorName, articleSection: article.topic,
  breadcrumbs: [
    { name: 'Главная', item: siteRoot.toString() },
    { name: 'Блог', item: new URL('blog/', siteRoot).toString() },
    { name: title, item: articleUrl },
  ],
  faqItems,
});
---

<ArticleLayout {title} {titleParts} {description} {canonicalPath} {structuredData}
  ogTitle={article.seoTitle} ogDescription={description} {ogImage} ogImageAlt={imageAlt}
  category={article.category} author={authorName}
  intro="На одном и том же товаре маржинальность может быть 33,3%, а наценка — 50%. Разница не в прибыли, а в базе, от которой считается процент.">
  <Fragment slot="quick-answer">
    <p>Допустим, товар без НДС продан за <strong>1 500 ₽</strong>, а его себестоимость продаж для примера — <strong>1 000 ₽</strong>. Валовая прибыль составляет <strong>500 ₽</strong>.</p>
    <p>Маржинальность: 500 ÷ 1 500 × 100% = <strong>33,3%</strong>. Наценка: 500 ÷ 1 000 × 100% = <strong>50%</strong>. Пример не включает расходы, не вошедшие в заданную себестоимость, и не показывает чистую прибыль.</p>
  </Fragment>

  <p data-article-lead>В расчётах товара часто смешивают три выражения: маржу в рублях, маржинальность в процентах и наценку. Чтобы не получить разные цены и выводы из одного набора данных, сначала зафиксируйте, что именно входит в себестоимость, а затем смотрите на знаменатель формулы.</p>

  <section aria-labelledby="one-example">
    <h2 id="one-example">Один товар: откуда берутся 500 рублей прибыли</h2>
    <p>Возьмём условную продажу: цена и выручка без НДС — 1 500 ₽ за единицу; себестоимость проданного товара в нашем упрощённом расчёте — 1 000 ₽. Для наглядности считаем, что скидок и возвратов нет, а доставка, комиссия, упаковка и прочие расходы в эти 1 000 ₽ не включены.</p>
    <p>Разность между выручкой и себестоимостью — <strong>500 ₽ валовой прибыли</strong>. В разговорной речи её часто называют маржой в рублях, но слово «маржа» используют по-разному. В управленческих расчётах маржинальный доход могут считать после переменных затрат. Поэтому в отчёте или таблице лучше явно указывать формулу и состав затрат.</p>
    <ArticleFigure src={marginMarkupImage} fullSize eager alt={imageAlt} caption="Учебный пример на условных цифрах. Синяя часть — себестоимость 1 000 ₽, светлая — валовая прибыль 500 ₽; проценты используют разные знаменатели." />
    <DataTable label="Три показателя по одному товару" columns={['Показатель', 'Расчёт', 'Результат']} rows={comparisonRows} rowHeaders compact />
  </section>

  <section aria-labelledby="formula">
    <h2 id="formula">Маржинальность и наценка: две формулы</h2>
    <p><strong>Маржинальность</strong> показывает, какая доля выручки осталась после вычета выбранной себестоимости продаж. Здесь знаменатель — выручка:</p>
    <p><strong>(Выручка − себестоимость продаж) ÷ выручка × 100%</strong></p>
    <p><strong>Наценка</strong> показывает, на сколько процентов цена превышает себестоимость. Здесь знаменатель — себестоимость:</p>
    <p><strong>(Выручка − себестоимость продаж) ÷ себестоимость × 100%</strong></p>
    <p>Подставим числа. Для маржинальности: 500 ÷ 1 500 × 100% = 33,3%. Для наценки: 500 ÷ 1 000 × 100% = 50%. Процент наценки выше, потому что одна и та же разница делится на меньшую сумму. Подмена одной формулы другой и есть причина частой ошибки.</p>
    <p>Если вы задаёте желаемую маржинальность, цену можно оценить обратной формулой: <strong>цена = себестоимость ÷ (1 − целевая маржинальность)</strong>. Например, чтобы получить 35% до прочих расходов при себестоимости 1 000 ₽, цена без НДС должна быть около 1 538 ₽. Это ориентир при тех же допущениях, а не рекомендация по цене.</p>
  </section>

  <section aria-labelledby="discount">
    <h2 id="discount">Как скидка меняет показатель и прибыль на товар</h2>
    <p>Скидка 10% от 1 500 ₽ снижает фактическую выручку до 1 350 ₽. Если себестоимость остаётся 1 000 ₽, валовая прибыль уже 350 ₽, а маржинальность — 350 ÷ 1 350 × 100% = 25,9%. Выручка уменьшилась на 10%, но валовая прибыль в этом примере сократилась на 30%: скидка вычитается из суммы, из которой покрывалась прибыль.</p>
    <ArticleFigure src={discountImage} fullSize alt="Условный пример влияния скидки: при себестоимости 1 000 рублей цена снижается с 1 500 до 1 350 рублей, валовая прибыль — с 500 до 350 рублей, маржинальность — с 33,3 до 25,9 процента" caption="Редакционная инфографика, не данные магазина и не интерфейс учётной системы. Расчёт сохраняет себестоимость 1 000 ₽ и не добавляет комиссии или другие переменные расходы." />
    <p>При оценке скидки проверяйте итоговую цену после всех скидок и бонусов, а также расходы на продажу, которые не включены в себестоимость. Сравнение плановой цены с фактической выручкой помогает заметить, когда объём продаж растёт, а прибыль на единицу заметно падает.</p>
  </section>

  <section aria-labelledby="limits">
    <h2 id="limits">Что важно определить до расчёта</h2>
    <ul>
      <li><strong>Состав себестоимости.</strong> Закупочная цена не всегда равна себестоимости продаж. Если в выбранный показатель не входят доставка до склада, упаковка, комиссия площадки или другие прямые затраты, расчёт их не учитывает.</li>
      <li><strong>НДС и выручка.</strong> Сопоставляйте цену и затраты на одинаковой налоговой основе. В нашем примере обе суммы указаны без НДС; для конкретного бизнеса условия могут отличаться.</li>
      <li><strong>Скидки и возвраты.</strong> Для фактической маржинальности берите выручку после скидок и возвратов за тот же период, к которому относится себестоимость проданных единиц.</li>
      <li><strong>Масштаб расчёта.</strong> Показатель по одной штуке не заменяет результат по партии, группе товаров или месяцу. При сравнении разных товаров учитывайте их фактическую выручку и себестоимость, а не усредняйте проценты без весов.</li>
      <li><strong>Расходы бизнеса.</strong> Валовая прибыль и маржинальность в этом упрощённом примере рассчитаны до расходов, которые не включены в себестоимость. Это не операционная и не чистая прибыль.</li>
    </ul>
    <p>Если себестоимость равна нулю, процент наценки по этой формуле не определяется. Если выручка равна нулю, нельзя делить на неё для расчёта маржинальности. При убытке маржинальность может быть отрицательной; единого «хорошего» процента для всех товарных категорий нет.</p>
  </section>

  <section aria-labelledby="which-metric">
    <h2 id="which-metric">Какой показатель использовать</h2>
    <p>Для быстрого ответа на вопрос «сколько рублей осталось после заданной себестоимости?» смотрите валовую прибыль в рублях. Для сравнения доли выручки, оставшейся после этой себестоимости, используйте маржинальность. Для оценки процента, добавленного к себестоимости при формировании цены, — наценку.</p>
    <p>Перед сравнением ассортимента подпишите показатель и период: например, «маржинальность от выручки без НДС, после закупочной себестоимости, до комиссии и логистики». Тогда цифра не создаёт впечатление, будто в неё уже вошли все расходы. Когда нужен не расчёт одного товара, а фактические продажи и себестоимость в МойСклад, начните с <a href={`${base}otchety-moysklad/`}>обзора отчётов МойСклад</a>. Экономику конкретных продаж на маркетплейсах и состав удержаний разбирает отдельный материал о <a href={`${base}pribyl-marketpleysov-moysklad/`}>прибыли Ozon и Wildberries</a>.</p>
  </section>

  <FaqSection items={faqItems} id="faq" variant="article" />
  <ArticleSources publishedIso={article.publishedAt} modifiedIso={article.updatedAt} sources={sources} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Нужен отчёт по ' }, { text: 'продажам в МойСклад?', accent: true }]} description="Посмотрите, какие отчёты помогают анализировать продажи и себестоимость, и проверьте, какой отвечает на вашу задачу. Состав расходов в показателе всё равно нужно уточнить отдельно." href={`${base}otchety-moysklad/`} actionLabel="Смотреть обзор отчётов" />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <Fragment slot="after-article"><ConsultationCtaSection /></Fragment>
</ArticleLayout>
