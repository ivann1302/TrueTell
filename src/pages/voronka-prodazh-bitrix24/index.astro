---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import editorialImage from '../../images/articles/bitrix24-sales-followup-editorial.png';
import classicImage from '../../images/articles/bitrix24-classic-funnel-official.jpg';
import conversionImage from '../../images/articles/bitrix24-conversion-funnel-official.jpg';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';

const article = getArticle('voronka-prodazh-bitrix24/');
const { title, description } = article;
const canonicalPath = `/${article.hrefPath}`;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const ogImage = new URL(editorialImage.src, siteRoot).toString();
const imageAlt = 'Сотрудник звонит клиенту и проверяет неподписанный документ в папке сделки';
const titleParts = [{text:'Воронка продаж в Битрикс24: '},{text:'как найти проблемные этапы',accent:true}];
const sourceLinks = [
  {label:'Классическая и конверсионная воронки — Поддержка24',href:'https://helpdesk.bitrix24.ru/open/23203898/'},
  {label:'Отчётный период в CRM — Поддержка24',href:'https://helpdesk.bitrix24.ru/open/11162430/'},
  {label:'Исторические стадии, права и ограничения аналитики — Поддержка24',href:'https://helpdesk.bitrix24.ru/open/27273254/'},
  {label:'CRM-аналитика и детализация показателей — Поддержка24',href:'https://helpdesk.bitrix24.ru/open/9673603/'},
  {label:'Фильтры CRM: текущие стадии и история — Поддержка24',href:'https://helpdesk.bitrix24.ru/open/24206616/'},
  {label:'Как работать в режиме «Список» — Поддержка24',href:'https://helpdesk.bitrix24.ru/open/27405366/'},
  {label:'Таймлайн карточки CRM — Поддержка24',href:'https://helpdesk.bitrix24.ru/open/23960160/'},
  {label:'Отчёт по сделкам и забытые сделки — Поддержка24',href:'https://helpdesk.bitrix24.ru/open/10519434/'},
];
const exampleRows = [
  ['КП отправлено','40','Исходная группа для проверки'],
  ['Условия согласованы','25','25 / 40 × 100% = 62,5%'],
  ['Успешно завершено','10','10 / 25 × 100% = 40%'],
];
const actionRows = [
  ['Этап редко фиксируют','Пропуск в истории, действие с клиентом могло состояться','Проверить документы и договориться, когда менять стадию'],
  ['Отказы после предложения','Причины отказов и записи общения','Проверить условия, ожидания клиента и качество предложения'],
  ['Открытые сделки на согласовании','Давность входа, последнее общение, следующее дело','Назначить конкретный контакт с клиентом и срок'],
  ['Слишком мало данных у руководителя','Права CRM и фильтр ответственных','Сравнить выборку с сотрудником, видящим нужные сделки'],
];
const faqItems = [
  {question:'Как открыть воронку продаж в Битрикс24?',answer:'Перейдите в «CRM → Аналитика → Оперативная аналитика → Воронка продаж». В разделе «Продажи» выберите обычную или конверсионную воронку. Затем проверьте период, направление сделок и состав сотрудников в фильтре.'},
  {question:'Почему классическая и конверсионная воронки отличаются?',answer:'Классическая показывает фактически пройденные стадии. Конверсионная может учитывать пропущенные промежуточные стадии для успешно завершённого элемента. Поэтому расхождение само по себе не означает ошибку; сначала выберите отчёт под вопрос и проверьте историю конкретных сделок.'},
  {question:'Почему в отчёт попала старая сделка?',answer:'Отчётный период не ограничивается датой создания. В него могут попадать старые незавершённые сделки, сделки с изменениями или завершением в периоде, а также ранее закрытые сделки с делами в этом интервале. Скрытый отчётный период продолжает влиять на выборку.'},
  {question:'Почему канбан и график воронки показывают разные числа?',answer:'Канбан и фильтр текущей стадии показывают, где карточки находятся сейчас. График воронки использует историю прохождения стадий. Например, исторический успех может остаться на графике после возврата сделки в работу. Сравнивать такие числа можно только после согласования вопроса и выборки.'},
  {question:'Среднее время сделки показывает срок на текущей стадии?',answer:'Не следует так трактовать этот показатель. Для задержки конкретной открытой сделки проверьте дату входа в текущую стадию, последнюю коммуникацию и запланированное действие. Среднее по отчёту не заменяет проверку карточки и не является нормативом вашего процесса.'},
  {question:'Что делать, если воронка не строится или данных мало?',answer:'Проверьте период, дополнительные фильтры и права CRM. Если сервис сообщает об ограничении, проверьте лимит элементов для вашего тарифа. Небольшое число видимых сделок и блокировка отчёта по лимиту — разные ситуации; исправление должно соответствовать причине.'},
];
const relatedArticles = getRelatedArticles(article.hrefPath).map(item=>({...item,description:item.summaryDescription ?? item.description,href:`${base}${item.hrefPath}`}));
const structuredData = createArticleStructuredData({articleType:'Article',title,description,articleUrl,publishedDate:article.publishedAt,modifiedDate:article.updatedAt,publisherUrl:siteRoot.toString(),image:ogImage,author:authorName,breadcrumbs:[{name:'Главная',item:siteRoot.toString()},{name:'База знаний',item:new URL('knowledge-base/',siteRoot).toString()},{name:title,item:articleUrl}],faqItems});
---

<ArticleLayout {title} {titleParts} {description} {canonicalPath} {structuredData}
  ogTitle={article.seoTitle} ogDescription={description} {ogImage} ogImageAlt={imageAlt}
  category={article.category} author={authorName}
  intro="Находим сигналы пропусков, потерь и задержек, проверяем конкретные сделки и выбираем следующее действие.">
  <Fragment slot="quick-answer">
    <p>Для поиска пропущенных этапов используйте <strong>классическую воронку</strong>, для проверки участков перед отказами — <strong>конверсионную</strong>. Начните с одного направления продаж и согласованного периода.</p>
    <p>Не объявляйте низкий столбец доказанной потерей. Проверьте историю сделок, их текущий результат и действия с клиентами. Для задержек отдельно изучите открытые карточки выбранной стадии.</p>
  </Fragment>

  <p data-article-lead>На согласовании много сделок, а после отправки предложения график заметно меняется. Руководителю нужно понять, где клиентам мешает процесс, где не обновляют CRM и где просто длинный цикл покупки. Эти ситуации требуют разных действий. Воронка помогает выбрать участок проверки; причину устанавливают по сделкам и общению с клиентами.</p>
  <ArticleFigure src={editorialImage} alt={imageAlt} caption="Проверка этапа заканчивается конкретным действием по сделке: уточнить условия, связаться с клиентом или согласовать срок. Редакционная иллюстрация, не интерфейс Битрикс24." />

  <section aria-labelledby="open-funnel">
    <h2 id="open-funnel">Как открыть отчёт и задать область проверки</h2>
    <ol>
      <li>Откройте <strong>CRM → Аналитика → Оперативная аналитика → Воронка продаж</strong>.</li>
      <li>В разделе <strong>«Продажи»</strong> выберите нужный вид воронки.</li>
      <li>Проверьте направление сделок, сотрудников и дополнительные условия в доступном фильтре. Начните с одного процесса.</li>
      <li>Установите период и запишите условия отбора перед сравнением.</li>
    </ol>
    <p>Лиды и сделки — разные единицы анализа: не делите число успешных сделок на удобное число лидов без согласованного правила связи. Здесь проверяем этапы сделок. Для общей оценки отдела — рейтинга сотрудников, динамики и плана — используйте <a href={`${base}otchety-po-prodazham-bitrix24/`}>разбор отчётов по продажам Битрикс24</a>.</p>
    <p>Видимые данные зависят от прав CRM. Руководитель с доступом только к своим сделкам не получит полную картину отдела. Если отчёт не строится и показывает ограничение, проверьте тарифный лимит: он учитывается отдельно по типам элементов, а превышение одного типа может блокировать аналитические отчёты.</p>
  </section>

  <section aria-labelledby="classic-funnel">
    <h2 id="classic-funnel">Классическая воронка: где пропускают этапы</h2>
    <p>Классическая воронка учитывает фактически пройденные стадии. Если сделку перевели из начальной сразу в успешную, промежуточные этапы не становятся фактическими прохождениями. Этот отчёт полезен для проверки того, как сотрудники ведут процесс в CRM.</p>
    <ArticleFigure src={classicImage} fullSize alt="Классическая воронка продаж Битрикс24: выбор отчёта в разделе Продажи, фильтр периода и график" caption="Официальный скриншот Поддержки24: пункт «Воронка продаж» и график классической воронки. Значения демонстрационные; низкий столбец требует проверки истории, а не готового вывода о причине." />
    <p>Допустим, предложение редко отмечают как отправленное, хотя сделки доходят до договора. Проверьте несколько карточек: есть ли документ, письмо и запись перехода. Возможно, этап действительно обходят; возможно, работу выполняют, но не меняют стадию. Во втором случае график обнаружил проблему учёта, а не доказанное отсутствие предложения.</p>
    <p>Правила обоих видов отчёта описаны в <a href={sourceLinks[0].href} target="_blank" rel="noopener noreferrer">справке по воронкам</a>. Для проверки фактического пути используйте историю без предполагаемых переходов.</p>
  </section>

  <section aria-labelledby="conversion-funnel">
    <h2 id="conversion-funnel">Конверсионная воронка: где искать причины отказов</h2>
    <p>Конверсионная воронка может достраивать пропущенные промежуточные этапы для успешного элемента. Для проигранного это правило не применяется. Поэтому она отвечает на другой вопрос: после каких участков сделки чаще заканчиваются отказом.</p>
    <ArticleFigure src={conversionImage} fullSize alt="Конверсионная воронка продаж Битрикс24: выбранный вид отчёта, период и график этапов" caption="Официальный скриншот Поддержки24: «Воронка продаж (конверсионная)». Способ учёта стадий отличается от классического отчёта. Демонстрационные числа не являются показателями клиента TrueTell." />
    <p>Выберите заметное изменение на графике. Нажмите значение количества или суммы, чтобы открыть список соответствующих элементов, и проверьте конкретные сделки. Сопоставьте отказ с предшествующим этапом, условиями предложения и записями общения. Низкое значение может подсказать, где искать, но не доказывает, что виноваты цена или конкретный сотрудник.</p>
    <p>Особое внимание уделяйте сделкам, которые возвращали в работу или переводили между финальными результатами. График использует историю; факт прохождения «Успеха» не равен текущей выигранной сделке. Не подгоняйте карточки под диаграмму: сначала объясните расхождение по истории.</p>
  </section>

  <section aria-labelledby="period">
    <h2 id="period">Как период влияет на вывод о проблемном этапе</h2>
    <p><strong>«Отчётный период» не означает «созданы в этом месяце».</strong> Он охватывает работу со сделками: создание, изменения и завершение, дела по ранее закрытым карточкам, а также незавершённые сделки. Поэтому в отчёте могут находиться старые записи.</p>
    <p>Если нужны именно созданные за интервал сделки, используйте отдельное условие даты. Проверьте названия доступных полей: в сделках <strong>«Дата начала»</strong> относится к созданию, <strong>«Дата завершения»</strong> — к завершению. Выбирайте условия под вопрос; два фильтра вместе сужают выборку одновременно.</p>
    <p>Скрытый отчётный период продолжает действовать. Перед точным отбором по отдельной дате задайте достаточно широкий период, затем примените нужное условие и проверьте знакомые карточки. Такое поведение описано в <a href={sourceLinks[1].href} target="_blank" rel="noopener noreferrer">официальной инструкции</a>.</p>
    <p>Свежие сделки могут ещё не успеть пройти длинный цикл покупки. Сравнение их результата с давно завершёнными продажами даст разницу, которую легко принять за ухудшение работы. Для проверки изменения процесса подберите группы с сопоставимым временем наблюдения, продуктом и направлением продаж.</p>
  </section>

  <section aria-labelledby="example">
    <h2 id="example">Как считать переходы в проверенной группе: пример</h2>
    <p>Возьмём учебную группу из 40 сделок, которым отправили КП. Все сделки уже завершены; в этом примере нет пропусков этапов и повторных переходов. Условия согласовали по 25 сделкам, успешно завершили 10. Числа условные; это ручной расчёт по проверенной истории, а не формула встроенного графика.</p>
    <DataTable label="Учебный расчёт переходов для одной завершённой группы сделок" columns={['Этап','Уникальные сделки','Переход из предыдущего этапа']} rows={exampleRows} rowHeaders compact />
    <p>На втором переходе доля ниже: 40% против 62,5%. Этот участок стоит проверить первым, но итоговая доля успеха для всей группы — 10 / 40 = 25%. Три процента отвечают на разные вопросы; смешивать их при сравнении сотрудников нельзя.</p>
    <p>В реальной выборке фиксируйте уникальные сделки и подтверждённые переходы. Если часть записей ещё в работе, повторно проходит этапы или попадает в расчёт условно, сначала определите правило подсчёта. Деление соседних столбцов штатного отчёта без такой проверки не гарантирует конверсию перехода.</p>
  </section>

  <section aria-labelledby="stalled">
    <h2 id="stalled">Как проверить сделки, которые задержались на стадии</h2>
    <p>Потеря и задержка — разные ситуации. Для текущего зависания откройте <strong>CRM → Сделки</strong>, выберите направление и режим <strong>«Список»</strong>. В <strong>«Фильтр + поиск»</strong> задайте нужную текущую <strong>«Стадию»</strong> и при необходимости ответственного.</p>
    <p>Фильтр <strong>«Стадия по истории»</strong> покажет сделки, проходившие этап раньше. Вариант <strong>«с предполагаемыми переходами»</strong> может включать пропуски. Он не подходит для доказательства, что сотрудник фактически выполнил конкретный этап. Различия подтверждены <a href={sourceLinks[4].href} target="_blank" rel="noopener noreferrer">справкой по фильтрам</a>; доступность отдельных условий зависит от тарифа.</p>
    <p>Откройте карточку и найдите в таймлайне последний переход в текущую стадию. Сверьте последнюю коммуникацию и следующее запланированное действие. Обычная дата изменения карточки не заменяет дату входа в этап: запись могли обновить по другой причине.</p>
    <p>Срок внимания согласуйте под процесс. Например, команда может проверять согласования без ответа дольше пяти дней — это учебное правило, а не норматив Битрикс24. Для каждой выбранной сделки укажите причину ожидания и следующее действие. Среднее время сделки в отчёте не заменяет возраст конкретной открытой карточки.</p>
    <p>Если нужна проверка отсутствия активности, откройте другой отчёт: <strong>CRM → Аналитика → Оперативная аналитика → Сквозная аналитика → Отчёты → Мои отчёты → Сделки</strong>. В нём есть блок <strong>«Забытые сделки»</strong>; путь описан в <a href={sourceLinks[7].href} target="_blank" rel="noopener noreferrer">официальной инструкции</a>. Блок ищет отсутствие работы за отчётный период, а не автоматически доказывает просрочку текущей стадии.</p>
  </section>

  <section aria-labelledby="action">
    <h2 id="action">Как превратить проверку в действие</h2>
    <p>Для выбранного участка заведите короткий рабочий список: ID сделки, текущая стадия, подтверждённая причина, ответственный, следующее действие и срок. Несколько проверенных карточек объясняют процесс лучше, чем вывод по одному проценту.</p>
    <DataTable label="Действия после проверки проблемного участка воронки" columns={['Сигнал','Что проверить','Возможное действие']} rows={actionRows} rowHeaders compact />
    <p>Меняйте одно понятное условие, затем сравнивайте результат на тех же правилах. Например, сначала договоритесь фиксировать отправку КП и назначать контакт после него. При повторной проверке оцените полноту записей и исходы сопоставимых сделок. Если одновременно изменить стадии, выборку и регламент, причину разницы будет сложно установить.</p>
    <InlineConsultation title="Нужно объяснить расхождение воронки и карточек" description="Поможем согласовать выборку, правила переходов и проверку по конкретным сделкам. Начать можно с одного спорного этапа." />
  </section>

  <section aria-labelledby="next">
    <h2 id="next">Когда нужен отдельный отчёт по этапам</h2>
    <p>Штатной воронки и проверки карточек достаточно, чтобы начать диагностику. Отдельная модель нужна, если требуется регулярно считать время на этапах, повторные входы или сравнивать исторические группы. Для этого нужна подходящая история переходов и согласованные правила расчёта.</p>
    <p>Список текущих сделок сам по себе не восстановит прошлый путь. В <a href={`${base}bi-analitika-bitrix24-pervyy-otchet/`}>первом BI-отчёте Битрикс24</a> разобран другой показатель — количество созданных сделок; он не превращается автоматически в длительность этапов. Для набора управленческих показателей используйте <a href={`${base}dashbord-rukovoditelya-bitrix24/`}>разбор дашборда руководителя</a>.</p>
    <p>Если задача выходит за штатный отчёт, обсудим состав данных и способ сверки. Наличие нужной истории и возможность подключения проверяются для вашего портала; готовый отчёт с подтверждённым расчётом появляется после этой проверки.</p>
