---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import { fieldDirectoryProduct } from '../../config/products';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import Checklist from '../../components/editorial/checklist.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import directoryImage from '../../images/articles/truetell-field-directory-list-live.jpg';
import mappingImage from '../../images/articles/bitrix24-field-audit-evidence.png';
const article = getArticle('audit-poley-crm-bitrix24/');
const { title, description } = article;
const canonicalPath = `/${article.hrefPath}`;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const ogImage = new URL(directoryImage.src, siteRoot).toString();
const imageAlt = 'Подлинный каталог полей сделки в справочнике CRM: названия, технические коды, типы и свойства; счётчик показывает 1–20 из 61';
const titleParts = [{ text: 'Аудит полей CRM Битрикс24: ' }, { text: 'что проверить до изменений', accent: true }];
const sourceLinks = [
  { label: 'Пользовательские поля: изменение и удаление — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/22048980/' },
  { label: 'Карточка CRM: поля и виды карточки — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/22804914/' },
  { label: 'Обязательность полей по стадиям — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/27744544/' },
  { label: 'Описания полей crm.item.fields — REST API Битрикс24', href: 'https://apidocs.bitrix24.ru/api-reference/crm/universal/crm-item-fields.html' },
  { label: 'Роботы CRM: управление элементом — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/22381314/' },
];
const decisions = [
  ['«Плановая дата доставки» и «Фактическая дата доставки»', 'Похожие названия, но разные события. Уточнить определения и сохранить оба значения, если процессу нужны план и факт.'],
  ['Поле старого направления', 'Не заполняется в новых сделках, но содержит историю. Проверить исторические отчёты; отдельно обсудить его место в текущем виде карточки.'],
  ['«Комментарий доставки» с неясным назначением', 'Владелец и порядок заполнения неизвестны. Назначить ответственного за разбор, а изменение отложить.'],
  ['«Номер заказа ERP», которого менеджер не видит', 'Проверить связь с обменом. Если это ключ интеграции, сохранить его назначение независимо от видимости в карточке.'],
];
const faqItems = [
  { question: 'Что входит в аудит полей CRM Битрикс24?', answer: 'Каталог полей выбранных сущностей, проверка назначения и владельцев, значений в согласованной области, зависимостей и настроек ввода. Результат — решения по конкретным полям с основаниями, ответственными и планом проверки изменений.' },
  { question: 'Можно ли считать поле лишним, если оно пустое?', answer: 'Пустая запись или небольшая выборка не доказывает ненужность поля. Оно может заполняться на поздней стадии, в другой воронке, внешней системой или хранить значения только в исторических записях. Область проверки нужно зафиксировать.' },
  { question: 'Скрыть поле и удалить его — одно и то же?', answer: 'Нет. Скрытие из вида карточки меняет отображение и сохраняет данные; поле можно вернуть. При удалении пользовательского поля удаляются и его значения. Системные поля удалить нельзя. Настройки доступа к информации проверяют отдельно от вида карточки.' },
  { question: `Справочник ${companyInfo.brandName} автоматически находит неиспользуемые поля?`, answer: 'Нет. Он показывает названия, коды и технические свойства полей сделок, лидов, контактов и компаний. Заполненность, зависимости и необходимость поля для процесса проверяют отдельно.' },
  { question: 'CSV справочника подходит для резервного копирования?', answer: 'Нет. Он содержит описания полей выбранной сущности с текущими фильтрами, а не значения CRM-записей. Каталог не заменяет отдельный план сохранения и восстановления данных.' },
  { question: 'Можно ли заменить тип или множественность существующего поля?', answer: 'По штатной инструкции Битрикс24 после создания эти параметры не меняются. Для другой модели нужен отдельный план нового поля, переноса и сверки значений, а также переключения зависимостей. Удаление старого поля не заменяет этот процесс.' },
  { question: 'Как понять, что аудит завершён?', answer: 'По согласованной области собран каталог, для проверяемых полей записаны основания решений и ответственные, а открытые вопросы явно отмечены. Изменения и их приёмка ведутся отдельно: завершённый аудит сам по себе не означает, что CRM уже изменена.' },
];
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const structuredData = createArticleStructuredData({
  articleType: 'BlogPosting', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  articleSection: article.category,
  breadcrumbs: [{ name: 'Главная', item: siteRoot.toString() }, { name: 'Блог', item: new URL('blog/', siteRoot).toString() }, { name: title, item: articleUrl }], faqItems,
});
---
<ArticleLayout {title} {titleParts} {description} {canonicalPath} category={article.category}
  intro="Как разобраться в накопившихся полях, проверить их назначение и зависимости и составить обоснованный план изменений."
  {structuredData} ogTitle={article.seoTitle ?? title} ogDescription={description} {ogImage} ogImageAlt={imageAlt} author={authorName}>
  <Fragment slot="quick-answer">
    <p><strong>Аудит полей CRM начинается с инвентаризации, а заканчивается решением по каждому проверенному полю.</strong> Между ними нужно выяснить, кто использует данные, где они заполнены и какие процессы от них зависят.</p>
    <p>Отсутствие поля на экране, пустая карточка и похожее название — поводы для проверки. Они не доказывают, что поле лишнее. Справочник помогает собрать техническую основу; значения и зависимости исследуют отдельно.</p>
  </Fragment>
  <p data-article-lead>После нескольких доработок в CRM остаются старые подписи, поля для отдельных направлений и похожие даты. Менеджеру трудно найти нужное, а интегратор не всегда понимает, какое значение считать основным. Навести порядок — значит договориться о модели данных и виде карточки, а не просто сократить число полей.</p>
  <section aria-labelledby="audit-purpose">
    <h2 id="audit-purpose">Определите, <span data-heading-accent>какую проблему решает аудит</span></h2>
    <p>Начните с конкретной жалобы: сотрудникам мешает длинная карточка, отчёт использует непонятную дату, обмен пишет в старое поле или одинаковую информацию вводят несколько раз. У этих проблем разные решения. Если задача только в удобстве экрана, изменение структуры хранения может вообще не понадобиться.</p>
    <p>Согласуйте область: портал, сущности, воронки, подразделения и период данных. Например, разбор полей текущих сделок одного отдела не охватывает автоматически контакты, старые закрытые сделки и все интеграции компании. Запишите эти границы до выводов.</p>
    <p>Руководитель процесса и администратор могут использовать эту рабочую методику для проверки полей. Справочник полей не проводит аудит автоматически.</p>
  </section>
  <section aria-labelledby="field-inventory">
    <h2 id="field-inventory">Соберите <span data-heading-accent>каталог с точными кодами</span></h2>
    <p>Для каждой выбранной сущности нужен исходный перечень: название, полный технический код, тип и свойства. Подпись «Дата доставки» сама по себе не идентифицирует поле. Рядом должны быть сущность и код, чтобы участники обсуждали один и тот же объект.</p>
    <p>Если справочник полей CRM от {companyInfo.brandName} подключён к порталу, используйте его для начальной инвентаризации сделок, лидов, контактов и компаний. Начните без ограничивающих фильтров, а затем уточняйте поиск. Не переносите охват этих четырёх сущностей на счета и смарт-процессы.</p>
    <ArticleFigure src={directoryImage} fullSize alt={imageAlt}
      caption="Подлинный скриншот справочника 1.0.2 на тестовом портале, 14.10.2026; использован из ранее проверенного материала. Счётчик показывает 1–20 из 61 описания полей сделки. Это объём конкретного каталога, а не лимит приложения; значения CRM-записей здесь не показаны." />
    <p>Зафиксируйте дату, сущность и фильтры каталога. Порядок получения файла — в <a href={`${base}spisok-poley-bitrix24/`}>инструкции по списку полей и CSV</a>. Его результат — отправная точка рабочего документа. Сведения о владельцах, использовании и решениях добавляются отдельно.</p>
    <p>Метод <a href={sourceLinks[3].href} target="_blank" rel="noopener noreferrer">crm.item.fields</a> описывает поля и их конфигурацию. Каталог описаний не подтверждает заполненность карточек, участие в роботах или возможность восстановления данных. CSV справочника не является резервной копией значений.</p>
  </section>
  <section aria-labelledby="evidence">
    <h2 id="evidence">Разделите <span data-heading-accent>три вида сведений</span></h2>
    <p>Каталог отвечает, что за поле существует. Проверка записей — какие значения есть в согласованной области. Разбор процессов — кто и зачем их записывает или читает. Эти сведения дополняют друг друга: наличие технического кода ничего не говорит о пользе поля, а пустое значение в одной сделке не описывает весь процесс.</p>
    <ArticleFigure src={mappingImage} fullSize
      alt="Три части аудита: каталог с кодом и свойствами; значения в текущих и исторических записях; зависимости форм, роботов, отчётов и обмена. Справочник помогает только с первой частью"
      caption="Редакционная инфографика: источники сведений для принятия решения. Это план аудита, а не три функции приложения. Значения записей и зависимости проверяются отдельно от справочника." />
    <p>Если используете выборку, укажите её условия и ограничения. Включите подходящие текущие и исторические записи, разные рабочие состояния и направления. Поле может заполняться только после доставки или использоваться в отчётах по завершённому периоду. Вывод «в изученной выборке значений не найдено» точнее, чем «поле нигде не используется».</p>
    <p>Неясный или недоступный участок пометьте как непроверенный. Отсутствие доступа к части данных не превращает её в пустую. Согласуйте проверку с сотрудником, который имеет необходимые права и понимает процесс.</p>
  </section>
  <section aria-labelledby="dependencies">
    <h2 id="dependencies">Проверьте, <span data-heading-accent>кто пишет и кто читает поле</span></h2>
    <p>У каждого кандидата на изменение найдите владельца смысла: кто объяснит, что означает значение и когда оно становится достоверным. Затем отдельно выясните источник записи и потребителей. Менеджер может не видеть поле, которое внешняя система использует как ключ обмена.</p>
    <p>С владельцами систем пройдите применимые места: CRM-формы, роботы и бизнес-процессы, интеграции, отчёты и вычисления BI, фильтры и шаблоны документов. Это направления ручного исследования, а не перечень зависимостей, который автоматически выдаёт справочник. Например, <a href={sourceLinks[4].href} target="_blank" rel="noopener noreferrer">робот «Изменить элемент»</a> умеет обращаться к полям элемента — одного просмотра карточки недостаточно, чтобы исключить такую связь.</p>
    <p>В рабочем документе сохраняйте конкретные ссылки или названия настроек, а не только ответ «проверено». Для интеграции полезно указать, какая система управляет значением и в какую сторону оно передаётся. Структуру такого описания разбираем в <a href={`${base}karta-sootvetstviya-poley-bitrix24/`}>карте соответствия полей</a>.</p>
    <p>Если зависимость не удалось проследить до владельца, оставьте открытый вопрос и ответственного за уточнение. Отсутствие найденной ссылки при неполной проверке ещё не доказывает отсутствие связи.</p>
    <InlineConsultation title="Нужно разобраться в накопившихся полях?" description="Согласуем область аудита, соберём назначения и зависимости и отделим улучшение карточки от изменений данных." href={companyInfo.contacts.consultationUrl} actionLabel="Обсудить аудит CRM" />
  </section>
  <section aria-labelledby="card-or-data">
    <h2 id="card-or-data">Отделите вид карточки <span data-heading-accent>от структуры данных</span></h2>
    <p>По <a href={sourceLinks[1].href} target="_blank" rel="noopener noreferrer">инструкции Битрикс24</a>, поле можно скрыть из карточки и позднее вернуть: данные сохраняются. Системные поля удалить нельзя. Удаление пользовательского поля, напротив, удаляет его значения. Это разные решения с разными последствиями.</p>
    <p>Если сотруднику мешает перегруженный экран, сначала оцените порядок разделов, положение полей и подходящий вид карточки. При этом скрытие из вида не заменяет настройку доступа и не прекращает использование поля другими процессами. Проверяйте, какой вид и для каких сотрудников меняется.</p>
    <p>Обязательность тоже исследуют отдельно. <a href={sourceLinks[2].href} target="_blank" rel="noopener noreferrer">Настройка по стадиям</a> зависит от тарифа; в сделках её проверяют для нужных воронок. Техническое «Обязательное: Нет» в каталоге не описывает все требования интерфейса. Подробности свойств оставляем в <a href={`${base}tipy-poley-crm-bitrix24/`}>статье о типах и обязательности</a>.</p>
  </section>
  <section aria-labelledby="decision-examples">
    <h2 id="decision-examples">Похожая ситуация — <span data-heading-accent>разные решения</span></h2>
    <p>Ниже вымышленные примеры, показывающие ход разбора. Названия не относятся к проверке конкретного портала; готовых технических кодов и подтверждённых выводов об использовании здесь нет.</p>
    <DataTable label="Учебные примеры решений по полям после проверки назначения" columns={['Наблюдение', 'Что проверить и какое решение рассмотреть']} rows={decisions} rowHeaders />
    <p>У возможных дублей сравнивайте смысл, источник, единицы и момент заполнения. «Плановая дата» и «Фактическая дата» могут выглядеть почти одинаково, но отвечать на разные вопросы. Если два поля действительно хранят одно и то же, всё равно нужен согласованный источник истины и порядок работы с расхождениями.</p>
    <p>Запишите итог в одной строке решения: точное поле, его назначение, владелец, основания, выбранное действие и критерий проверки. Варианты могут быть простыми: оставить; упорядочить вид; уточнить подпись и инструкцию; подготовить отдельный переход на другую модель. Нерешённый вопрос тоже допустимый итог — с ответственным и сроком уточнения.</p>
  </section>
  <section aria-labelledby="change-plan">
    <h2 id="change-plan">Изменение модели — <span data-heading-accent>отдельный план</span></h2>
    <p>По штатной <a href={sourceLinks[0].href} target="_blank" rel="noopener noreferrer">инструкции по пользовательским полям</a>, тип и множественность после создания не меняются. Если нужна другая модель, планируют новое поле, преобразование и сверку значений и переключение зависимостей. Создание поля с похожей подписью само по себе ничего не переносит.</p>
    <p>До выполнения такого плана определите, как сохраняются исходные значения и связи с записями, как проверяется полнота переноса и что делать при ошибке. Способ сохранения и возможность восстановления зависят от конкретных данных и инструментов; выгрузка одних описаний этого не обеспечивает.</p>
    <p>Не смешивайте аудит с запуском изменений. Сначала согласуйте решение и его последствия, затем выполняйте предусмотренные действия в отдельной задаче. Методика не гарантирует сохранность данных при удалении полей или записей CRM.</p>
  </section>
  <section aria-labelledby="audit-result">
    <h2 id="audit-result">Что передать <span data-heading-accent>по результатам аудита</span></h2>
    <p>Полезный результат — документ, по которому другой сотрудник поймёт решение и сможет проверить основания. Число «убранных полей» не заменяет этого результата: иногда правильный итог — сохранить все поля и сделать карточку понятнее.</p>
    <Checklist label="Проверка результата аудита полей CRM" items={[
      { title: 'Область и каталог зафиксированы.', description: 'Указаны портал, сущности, дата, фильтры и границы проверки; поля различаются по точным кодам.' },
      { title: 'Назначение и зависимости подтверждены.', description: 'Понятны владелец смысла, источники и потребители значений; у непроверенных участков есть ответственный.' },
      { title: 'Решения имеют основания.', description: 'Для каждого проверенного кандидата записаны действие и причина; наблюдения по выборке не выданы за вывод обо всей CRM.' },
      { title: 'Изменения проверяются отдельно.', description: 'Согласованы исполнители и критерии: рабочий ввод, обмен, отчёты и нужная история после предполагаемого изменения. Аудит не отмечен как выполненный перенос данных.' },
    ]} />
    <p>После разрешённых изменений сверяйте именно затронутые процессы: сохраняется ли нужная карточка, приходит ли ожидаемое значение, продолжает ли отчёт использовать правильный источник. Отметьте результат и оставшиеся вопросы в том же документе, чтобы следующий аудит не начинался с догадок.</p>
  </section>
  <FaqSection variant="article" items={faqItems} />
  <ArticleSources sources={sourceLinks} publishedIso={article.publishedAt} modifiedIso={article.updatedAt} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Начните с ' }, { text: 'каталога полей CRM', accent: true }]}
