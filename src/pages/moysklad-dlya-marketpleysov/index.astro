---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import stockInfographic from '../../images/articles/moysklad-marketplace-stock-infographic.png';
import warehouseImage from '../../images/articles/moysklad-wb-warehouse-official.png';
import priceImage from '../../images/articles/moysklad-wb-prices-official.png';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';

const article = getArticle('moysklad-dlya-marketpleysov/');
const { title, description } = article;
const canonicalPath = `/${article.hrefPath}`;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const ogImage = new URL(stockInfographic.src, siteRoot).toString();
const imageAlt = 'Учебное сравнение: при остатке 10, резерве 3 и ожидании 5 в FBS передают 7, а показатель «Доступно» равен 12';
const titleParts = [{text:'МойСклад для маркетплейсов: '},{text:'заказы, остатки и цены',accent:true}];
const support = 'https://support.moysklad.ru/hc/ru/';
const sourceLinks = [
  {label:'Интеграции с маркетплейсами — справка МоегоСклада',href:`${support}онлаин%20торговля/маркетплеисы/интеграции%20с%20маркетплеисами/интеграции_с_маркетплеисами`},
  {label:'Сравнение возможностей интеграций — справка МоегоСклада',href:`${support}онлаин%20торговля/маркетплеисы/сравнение_возможностеи_интеграции_моегосклада_для_маркетплеисов`},
  {label:'Обмен с Ozon — справка МоегоСклада',href:`${support}онлаин%20торговля/маркетплеисы/ozon`},
  {label:'Обмен с Wildberries — справка МоегоСклада',href:`${support}онлаин%20торговля/маркетплеисы/wildberries`},
  {label:'Заказы покупателей — справка МоегоСклада',href:`${support}продажи/заказы_покупателеи`},
  {label:'Обработка заказов и резервов — справка МоегоСклада',href:`${support}продажи/обработка_заказов`},
  {label:'Остатки, резервы и ожидания — справка МоегоСклада',href:`${support}товары%20и%20склады/остатки%20и%20себестоимость/складскои_учет_остатки_резервы_ожидания`},
  {label:'Торговля на маркетплейсах: быстрый старт — справка МоегоСклада',href:`${support}онлаин%20торговля/маркетплеисы/торговля_на_маркетплеисах_быстрыи_старт`},
  {label:'Как управлять остатками — Яндекс Маркет для продавцов',href:'https://yandex.ru/support/marketplace/ru/assortment/operations/stocks'},
  {label:'Цены, акции и карантин — Яндекс Маркет для продавцов',href:'https://yandex.ru/support/marketplace/ru/assortment/operations/prices'},
];
const directionRows = [
  ['Товары','С площадки в МойСклад','Привязаны нужные товары и модификации; карточки на площадке уже существуют'],
  ['Заказы','С площадки в МойСклад','Поддерживается ваша схема продаж; позиции, склад и резерв обработаны верно'],
  ['Остатки','Из МоегоСклада на площадку','Выбраны склады и свободное количество, которое можно продать сейчас'],
  ['Цены','Из МоегоСклада на площадку','Выбраны отдельные типы цен; проверены скидки и результат на витрине'],
];
const pilotRows = [
  ['Первый заказ','Один заказ покупателя, верный вариант товара, количество и склад; резерв соответствует настройке'],
  ['Изменение остатка','После обработки обмена на площадке видно ожидаемое свободное количество'],
  ['Правка цены','Получены нужная цена и скидка; итог на витрине объясняется правилами площадки'],
  ['Повторная обработка','Связанный заказ обновлён или пропущен; копия не создана'],
  ['Отмена и возврат','Состояние заказа, резерв и место хранения товара соответствуют фактическому событию'],
  ['Ошибка обмена','Есть запись об ошибке, ответственный сотрудник и понятный порядок повторной проверки'],
];
const faqItems = [
  {question:'Какие данные МойСклад передаёт на маркетплейсы?',answer:'Это зависит от приложения и схемы продаж. В базовых интеграциях Ozon и Wildberries товары и поддерживаемые заказы загружают с площадки в МойСклад, а цены и остатки выгружают на площадку. Проверяйте направления и ограничения конкретного коннектора.'},
  {question:'Можно ли создать карточки Ozon и Wildberries из МоегоСклада?',answer:'Базовые интеграции из официального сравнения не выгружают карточки товаров из МоегоСклада на площадку. Они загружают существующие товары с маркетплейса. Если нужна публикация карточек, отдельно проверьте такую возможность у выбранного партнёрского приложения.'},
  {question:'Почему в МойСклад доступно 12 единиц, а в FBS передаётся 7?',answer:'В учебном примере на складе 10, в резерве 3, ожидаются 5. Показатель «Доступно» учитывает ожидание: 10 + 5 − 3 = 12. Базовый обмен FBS Ozon и Wildberries использует остаток минус резерв: 10 − 3 = 7. Будущая поставка ещё не стала товаром на складе.'},
  {question:'Какие заказы загружают базовые интеграции Ozon и Wildberries?',answer:'В справке Ozon описана загрузка заказов FBS и realFBS, в справке Wildberries — FBS. Учёт FBO имеет отдельные правила. Не считайте настройки одной схемы подтверждением поддержки заказов другой схемы.'},
  {question:'Почему цена на витрине отличается от переданной?',answer:'Проверьте выбранный тип цены, скидку, акции и обработку обновления. Например, Wildberries использует отдельные соответствия розничной цены и цены со скидкой, а на Яндекс Маркете на витрину могут влиять акции, скидки Маркета и ценовая стратегия.'},
  {question:'Возврат на склад маркетплейса увеличивает мой остаток FBS?',answer:'Сам по себе такой возврат не подтверждает поступление на ваш склад. Сначала установите, где находится товар и пригоден ли он к продаже, затем оформите соответствующее движение и проверьте свободное количество. Не прибавляйте товар к собственному остатку только по статусу возврата.'},
  {question:'TrueTell заменяет коннектор маркетплейса?',answer:'Массовые операции TrueTell предназначены для работы с товарами, ценами и документами внутри МоегоСклада. Передачу данных на маркетплейс выполняет отдельно настроенная интеграция. Её возможности и результат обмена нужно проверять отдельно.'},
];
const relatedArticles = getRelatedArticles(article.hrefPath).map(item=>({...item,description:item.summaryDescription ?? item.description,href:`${base}${item.hrefPath}`}));
const structuredData = createArticleStructuredData({title,description,articleUrl,publisherUrl:siteRoot.toString(),image:ogImage,
  publishedDate:article.publishedAt,modifiedDate:article.updatedAt,articleType:'BlogPosting',author:authorName,
  breadcrumbs:[{name:'Главная',item:siteRoot.toString()},{name:'Блог',item:new URL('blog/',siteRoot).toString()},{name:title,item:articleUrl}],faqItems});
---

<ArticleLayout {title} {titleParts} {description} {canonicalPath} {structuredData}
  ogTitle={article.seoTitle} ogDescription={description} {ogImage} ogImageAlt={imageAlt}
  category={article.category} author={authorName}
  intro="Что проверить при обмене с Ozon, Wildberries и Яндекс Маркетом, чтобы не продать занятый товар и не отправить неверную цену.">
  <Fragment slot="quick-answer">
    <p>Для работы МоегоСклада с маркетплейсом сначала выберите интеграцию под вашу площадку и схему продаж. Затем сопоставьте товары, склады и типы цен и проверьте один заказ: что загрузилось, какой резерв появился и какое количество ушло обратно на витрину.</p>
    <p>В базовом обмене FBS с Ozon и Wildberries выгружают <strong>остаток минус резерв</strong>. Показатель «Доступно» в МойСклад включает ещё и ожидание, поэтому передавать его как наличие для немедленной отгрузки нельзя без проверки смысла расчёта.</p>
  </Fragment>

  <p data-article-lead>Товар есть в каталоге, заказ появился в учётной системе, но на витрине продаётся занятое количество или старая цена. У каждого расхождения свой источник: сопоставление товаров, обработка заказов, расчёт остатка или выгрузка цены. Проверьте один товар и заказ до подключения всего ассортимента.</p>
  <ArticleFigure src={stockInfographic} fullSize eager alt={imageAlt} caption="Учебный пример для одного товара и склада на один момент: базовые интеграции Ozon/WB, FBS. На складе 10, в резерве 3, в ожидании 5. Синий участок — свободный товар, серый в нижней строке — ещё не поступившие 5 единиц. Числа условные; это сравнение формул, а не экран приложения." />

  <section aria-labelledby="directions">
    <h2 id="directions">Что умеет выбранная интеграция</h2>
    <p>Название площадки в списке приложений ещё не описывает весь обмен. Уточните разработчика, поддерживаемую схему и направления передачи. FBS обычно предполагает хранение и сборку у продавца, FBO — хранение на стороне площадки; на Яндекс Маркете работа со склада Маркета называется FBY. Для других схем и конкретных условий используйте документацию площадки.</p>
    <p>В <a href={sourceLinks[1].href} target="_blank" rel="noopener noreferrer">официальном сравнении МоегоСклада</a> базовые интеграции Ozon и Wildberries загружают товары с площадки, но не создают на ней карточки из МоегоСклада. Загрузка каталога также не означает поступление товара на ваш склад: карточка и физическое количество учитываются отдельно.</p>
    <DataTable label="Основные направления базового обмена Ozon и Wildberries с МойСклад" columns={['Данные','Направление','Что проверить']} rows={directionRows} rowHeaders />
    <p>Для Ozon справка описывает загрузку заказов <strong>FBS и realFBS</strong>, для Wildberries — <strong>FBS</strong>. Возможности FBO и партнёрских приложений проверяйте отдельно. Для Яндекс Маркета выберите подходящий модуль и сверяйте его возможности с документацией Маркета: настройки базовой интеграции WB не являются инструкцией для него.</p>
  </section>

  <section aria-labelledby="matching">
    <h2 id="matching">Сопоставьте конкретный товар и склад</h2>
    <p>Начните с товара, который уже продаётся на площадке. Проверьте не только название, но и вариант: размер, цвет, фасовку, штрихкод и единицу. Сохраните идентификатор позиции на маркетплейсе и связь с товаром или модификацией в МойСклад. Правило первичного сопоставления берите из инструкции выбранного приложения.</p>
    <p>Затем свяжите склад площадки со складом учётной системы. Для базового FBS-обмена Ozon и Wildberries такое соответствие необходимо. У Ozon без сопоставления складов остатки FBS не передаются. Проверьте, что в выгрузку не попал общий запас, когда продавать нужно только с определённого склада.</p>
    <ArticleFigure src={warehouseImage} fullSize alt="Официальный экран интеграции Wildberries в МойСклад: соответствие складов FBS, обнуление и отдельные настройки FBO" caption="Скриншот из справки МоегоСклада по Wildberries: слева — сопоставление складов FBS и параметры выгрузки, справа — отдельный учёт FBO. Данные демонстрационные. Это интерфейс базовой интеграции WB, а не универсальная настройка всех площадок." />
    <p>До запуска сравните одну позицию в отчёте <a href={`${base}ostatki-moysklad/`}>«Остатки» МойСклад</a> и в кабинете площадки. Запишите склад, резерв, время проверки и результат обмена. Если количества различаются, сначала выясните, какие именно записи и склады участвуют в расчёте.</p>
  </section>

  <section aria-labelledby="orders">
    <h2 id="orders">Как заказ влияет на резерв и свободное количество</h2>
    <p>В МойСклад <strong>заказ покупателя сам не меняет фактический остаток</strong>. Он фиксирует договорённость и может резервировать позиции. Движение товара отражает отгрузка; у связанного заказа резерв снимается при соответствующей отгрузке или розничной продаже. Эти правила описаны в справке по <a href={sourceLinks[4].href} target="_blank" rel="noopener noreferrer">заказам</a> и <a href={sourceLinks[5].href} target="_blank" rel="noopener noreferrer">их обработке</a>.</p>
    <p>Проверьте, ставит ли выбранная интеграция резерв при загрузке заказа и когда снимает его. При продажах с одного склада на нескольких площадках важно учитывать уже занятый товар в общей выборке. Иначе новый заказ одного канала ещё не отражён в свободном количестве другого.</p>
    <p>Базовые интеграции FBS Ozon и Wildberries используют <strong>Остаток − Резерв</strong>. Общий показатель МоегоСклада <strong>«Доступно» = Остаток + Ожидание − Резерв</strong> решает другую задачу: он включает будущие поступления. В примере выше выгружаются 7 единиц, хотя «Доступно» равно 12. Ожидаемые пять нельзя считать уже полученными.</p>
    <p>Яндекс Маркет просит передавать свободные для новых заказов товары, которые фактически есть и готовы к продаже; для FBY остатки на своём складе считает сам Маркет. Обновление не мгновенное. При сверке смотрите время последней успешной передачи и её результат, а не только текущее число в двух открытых вкладках.</p>
  </section>

  <section aria-labelledby="prices">
    <h2 id="prices">Отделите цену для площадки от остальных цен</h2>
    <p>Назначьте, где сотрудник меняет цену и какой её тип передаётся на конкретную площадку. Если одновременно править её в двух кабинетах, следующая выгрузка может вернуть прежнее значение. Перед массовым изменением сохраните исходные цены и проверьте одно соответствие.</p>
    <p>В базовой интеграции Wildberries задают соответствия <strong>розничной цены</strong> и <strong>цены со скидкой</strong>. Справка рекомендует отдельные типы цен WB. Проверьте оба поля: неверное соответствие или пересчёт скидки может дать на площадке другой результат, чем одна цена в карточке МоегоСклада.</p>
    <ArticleFigure src={priceImage} fullSize alt="Официальный экран МоегоСклада для Wildberries: выбор типов розничной цены и цены со скидкой перед настройкой выгрузки" caption="Скриншот из справки МоегоСклада по Wildberries: отдельные поля «Розничная цена WB» и «Цена со скидкой WB». Экран показывает настройку соответствий; успешную передачу и итоговую цену проверяют отдельно в кабинете площадки." />
    <p>Отдельно проверьте цену, которую видит покупатель. Например, Яндекс Маркет объясняет различие с каталогом акциями, скидками за свой счёт и ценовой стратегией. Сильное снижение переданной цены может попасть в карантин. Статус приёма данных и цена на витрине — две необходимые части проверки.</p>
    <p><a href={`${base}moysklad-mass-operations/`}>Массовые операции TrueTell</a> относятся к изменению данных внутри МоегоСклада. Передачу новых цен на маркетплейс выполняет отдельно настроенный коннектор. После правки проверьте выгрузку и результат на площадке, прежде чем расширять изменение на ассортимент.</p>
  </section>

  <section aria-labelledby="returns">
    <h2 id="returns">Различайте отмену, отгрузку и возврат</h2>
    <p>При отмене до отгрузки проверьте состояние связанного заказа и его резерв. Если товар уже отгружен, одной смены статуса недостаточно, чтобы вернуть физическое количество. Нужно установить фактическое движение и обработать его по вашей схеме учёта.</p>
    <p>Возврат на склад маркетплейса не подтверждает поступление на ваш склад FBS. Уточните, где находится товар и можно ли снова его продавать. Не увеличивайте собственный свободный остаток только по слову «возврат». Правила складов площадки и возврата продавцу сверяйте отдельно.</p>
    <p>У Яндекс Маркета есть конкретный случай: если FBS-заказ отменён после упаковки, товар нужно распаковать и передать актуальный остаток, чтобы освободившееся количество вернулось на витрину. Поэтому в контрольном сценарии важен момент отмены, а не только итоговый статус.</p>
  </section>

  <section aria-labelledby="pilot">
    <h2 id="pilot">Проверьте обмен на небольшой выборке</h2>
    <p>Выберите несколько существующих товаров и согласованный тестовый заказ. Ограничьте направления и ассортимент в пределах возможностей приложения. До проверки запишите ожидаемые товар, склад, количество, резерв и цену; после неё сохраните идентификаторы записей и время обработки.</p>
    <DataTable label="Контрольные сценарии перед расширением обмена с маркетплейсом" columns={['Сценарий','Что считать результатом']} rows={pilotRows} rowHeaders />
    <p>Эта таблица — план приёмки, а не обещание функций любого приложения. Если коннектор не поддерживает нужное событие, заранее определите ручное действие или другой способ обмена. Повтор после ошибки проверяйте по исходному заказу: уведомление об успехе само по себе не доказывает отсутствие дубля.</p>
    <InlineConsultation title="Нужно разобраться в расхождении остатков или цен" description="Начнём с одного товара и заказа: уточним источник данных, склад, резерв и результат обмена. Так можно определить, где возникает расхождение и какой объём доработки нужен." />
  </section>

    <p>После проверки обмена переходите к <a href={`${base}pribyl-marketpleysov-moysklad/`}>сверке прибыли Ozon и Wildberries в МойСклад</a>: определите, где учтены комиссии, логистика и другие расходы.</p>

  <section aria-labelledby="analytics">
    <h2 id="analytics">Проверяйте продажи и прибыль отдельно от обмена</h2>
    <p>Загруженные заказы показывают спрос, но сами по себе не подтверждают исполненные продажи и итоговую прибыль. Сверяйте отгрузки, возвраты, себестоимость, комиссии и другие расходы по правилам выбранной площадки. Для исходных показателей используйте <a href={`${base}otchety-moysklad/`}>разбор отчётов МойСклад</a>.</p>
    <p>Если кроме маркетплейсов у вас есть продажи через CRM, в <a href={`${base}bitrix24-moysklad-integraciya/`}>статье про Битрикс24 и МойСклад</a> разобрано согласование сделок и складских документов. Это отдельный процесс: подключение CRM не подтверждает работу обмена с площадкой.</p>
  </section>

  <FaqSection title="Частые вопросы" items={faqItems} variant="article" />
  <ArticleSources publishedIso={article.publishedAt} modifiedIso={article.updatedAt} sources={sourceLinks} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{text:'Меняйте товары и цены '},{text:'в МойСклад',accent:true}]}
      description="Посмотрите массовые операции TrueTell для товаров, цен и документов. Обмен с маркетплейсом подключается и проверяется отдельно."
      actionLabel="Посмотреть массовые операции" href={`${base}moysklad-mass-operations/`} />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <Fragment slot="after-article"><ConsultationCtaSection /></Fragment>
</ArticleLayout>
