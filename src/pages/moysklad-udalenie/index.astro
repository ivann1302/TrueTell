---
import ScenarioPage from '../../components/moysklad-scenario-page/moysklad-scenario-page.astro';
import Screenshot from '../../components/moysklad-scenario-page/scenario-screenshot.astro';
import ProductScenario from '../../components/product-scenario/product-scenario.astro';
import Checklist from '../../components/editorial/checklist.astro';
import { companyInfo } from '../../config/company';
import deletePlan from '../../images/products/moysklad/delete-plan.jpeg';
import styles from '../bitrix24-cleaner/page.module.scss';
import productStyles from '../moysklad-mass-operations/page.module.scss';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const title = `Массовое удаление данных в МойСклад — приложение ${companyInfo.brandName}`;
const description = 'Удаляйте выбранные данные в МойСклад по условиям или списку ID. Проверяйте план, учитывайте связанные документы и сохраняйте отчёт о результате операции.';
const faqItems = [
  { question: 'Полная очистка сделает аккаунт совершенно пустым?', answer: 'Нет. Сохраняются обязательные системные данные, административный доступ и данные, которые нельзя удалить через API. После выполнения нужно проверить оставшиеся объекты.' },
  { question: 'Можно ли отменить удаление?', answer: 'Общего отката и восстановления удалённых объектов в приложении нет. Остановка прекращает дальнейшую обработку с учётом уже начатых запросов, но не возвращает удалённые данные.' },
  { question: 'Достаточно закрыть окно, чтобы остановить операцию?', answer: 'Нет, закрытие окна не останавливает выполнение. Используйте кнопку остановки в карточке операции и проверьте её итоговый результат.' },
  { question: 'Сколько хранится отчёт?', answer: 'История завершённых подтверждённых операций и подробные результаты хранятся 90 дней. Нужные отчёты стоит скачать заранее; наличие отчёта не даёт возможности восстановить объекты.' },
];
const steps = [
  { title: 'Выберите тип объектов и действие', description: 'Удаление карточки и очистка её содержимого приводят к разным результатам. Проверьте доступный режим для выбранного типа объектов.' },
  { title: 'Настройте состав выборки', description: 'Укажите условия отбора либо загрузите XLSX со списком ID нужных объектов.' },
  { title: 'Изучите план и предупреждения', description: 'Проверьте состав операции и последствия для связанных данных.' },
  { title: 'Подтвердите запуск и проверьте результат', description: 'Сверьте выполненные действия, ошибки и оставшиеся объекты по отчёту и данным МойСклад.' },
];
---

<ScenarioPage slug="udalenie" label="Удаление данных" draft {title} {description} {faqItems}
  heroTitle="Массовое удаление данных в МойСклад"
  heroDescription="Отберите ненужные объекты по условиям или загрузите XLSX со списком ID. Проверьте план и последствия для связанных данных, затем подтвердите удаление."
  summaryDescription="Приложение помогает убрать выбранные ненужные объекты после проверки интеграции или работы с тестовым каталогом. Вы задаёте состав выборки, изучаете план и проверяете результат по отчёту."
  mentions={['Удаление данных', 'Связанные документы', 'XLSX', 'Отчёт об операции']}
  connectionTitle="Обсудите ваш сценарий очистки"
  connectionDescription="Укажите, какие данные требуется удалить и что должно сохраниться. Поможем уточнить, какие возможности приложения подходят для этой задачи."
  ogImage={deletePlan} ogImageAlt="План удаления демонстрационных контрагентов в МойСклад">
  <Fragment slot="summary-title">Очищайте выбранные данные <strong>под конкретную задачу</strong></Fragment>

  <ProductScenario id="delete-example-title" title="Убрать ненужные записи после проверки интеграции"
    description="Если список уже согласован, передайте его через XLSX с ID. Если объекты нужно найти по условиям, используйте отбор и внимательно проверьте состав будущей операции."
    steps={[
      { icon: 'filter', title: 'Определите объекты', text: 'Укажите, какие записи нужно удалить и что должно остаться.' },
      { icon: 'review', title: 'Проверьте план', text: 'Сверьте выборку и предупреждения перед подтверждением.' },
      { icon: 'remove', title: 'Подтвердите удаление', text: 'Запускайте только после проверки последствий для данных.' },
    ]}>
    <Screenshot filename="delete-plan.jpeg" title="План удаления" alt="План удаления трёх демонстрационных контрагентов с подтверждением количества операций"
      caption="Реальный план на демонстрационных данных. Перед запуском нужно подтвердить количество операций." />
  </ProductScenario>

  <section class={styles.darkWorkflow} aria-labelledby="delete-dependencies-title">
    <div>
      <h2 id="delete-dependencies-title">Учитывайте связанные документы</h2>
      <p class={styles.workflowIntro}>Удаление товара может затронуть документы, в которых он используется. Доступные действия зависят от типа объекта.</p>
    </div>
    <ol>
      <li><h3>Сохранить документ — не значит сохранить содержимое</h3><p>Даже в режиме с сохранением документов выбранные товарные позиции могут быть удалены из них, а суммы изменены.</p></li>
      <li><h3>Связи могут обнаружиться во время выполнения</h3><p>При удалении с зависимостями окончательный охват способен расшириться после подтверждения. Если связанные документы должны остаться без изменений, такой режим не подходит.</p></li>
      <li><h3>Удаление и очистка — разные действия</h3><p>В приложении есть очистка файлов, изображений, позиций и сумм. Выбирайте доступный режим под свою задачу.</p></li>
    </ol>
  </section>

  <section class={productStyles.outcome} aria-labelledby="delete-result-title">
    <h2 id="delete-result-title">Проверьте, что удалено и что осталось</h2>
    <Screenshot filename="delete-result.png" title="Результат удаления" alt="Отчёт удаления: выполненные действия, ошибки и оставшиеся объекты"
      caption="Результат удаления демонстрационных объектов. Ошибки и пропуски нужно проверить до повторного запуска." />
    <div class={productStyles.copy}>
      <h3>Результат по объектам</h3>
      <p>После выполнения проверьте обработанные записи и ошибки. Факт запуска ещё не означает, что удалены все выбранные объекты.</p>
      <h3>Отчёт для последующей сверки</h3>
      <p>Скачайте нужный отчёт заранее: история завершённых подтверждённых операций и подробные результаты хранятся 90 дней.</p>
    </div>
  </section>

  <Fragment slot="editorial">
    <section aria-labelledby="delete-workflow-title">
      <h2 id="delete-workflow-title">От выбора объектов до отчёта</h2>
      <Checklist items={steps} label="Порядок массового удаления" />
      <aside data-article-note><p>До запуска сохраните необходимые данные подходящим для вашей задачи способом. План и отчёт не являются резервной копией; приложение не восстанавливает удалённые объекты.</p></aside>
      <p class={styles.support}><a href={`${base}moysklad-mass-operations/`}>Все возможности очистки в приложении →</a></p>
    </section>
  </Fragment>
</ScenarioPage>
