---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import { fieldDirectoryProduct } from '../../config/products';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import Checklist from '../../components/editorial/checklist.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import directoryImage from '../../images/articles/truetell-field-directory-list-live.jpg';
import filteredImage from '../../images/articles/truetell-field-directory-filtered-live.jpg';
const article = getArticle('spisok-poley-bitrix24/');
const { title, description } = article;
const canonicalPath = `/${article.hrefPath}`;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const ogImage = new URL(directoryImage.src, siteRoot).toString();
const imageAlt = 'Справочник полей CRM: выбран каталог сделок, видны коды и свойства, показано 1–20 из 61 поля';
const titleParts = [{ text: 'Как получить ' }, { text: 'список полей', accent: true }, { text: ' Битрикс24 и выгрузить его в CSV' }];
const sourceLinks = [
  { label: 'Описания полей crm.item.fields — REST API Битрикс24', href: 'https://apidocs.bitrix24.ru/api-reference/crm/universal/crm-item-fields.html' },
  { label: 'Пользовательские поля в CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/22048980/' },
  { label: 'Экспорт данных CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/20966844/' },
  { label: 'Типы объектов CRM — REST API Битрикс24', href: 'https://apidocs.bitrix24.ru/api-reference/crm/data-types.html' },
];
const csvColumns = [
  ['Сущность', 'Сделки, лиды, контакты или компании', 'Одинаковое название в разных сущностях может обозначать разные поля'],
  ['Название', 'Подпись, которую передал API', 'Не заменяет технический код'],
  ['Код универсального API', 'Точный ключ описания поля', 'Используйте формат, который ожидает целевой REST-метод'],
  ['Дополнительный код API', 'upperName, если он передан', 'Не считайте взаимозаменяемым с основным ключом'],
  ['Тип', 'Технический тип, например string или double', 'Специальные типы могут требовать отдельной обработки'],
  ['Обязательное', 'Технический признак isRequired', 'Не описывает обязательность на стадии CRM'],
  ['Множественное', 'Признак isMultiple', 'Учитывайте возможность нескольких значений'],
  ['Категория', 'Системное, пользовательское или не определено', 'Это классификация описания поля, а не оценка его использования'],
];
const faqItems = [
  { question: 'Где посмотреть список пользовательских полей сделки в Битрикс24?', answer: 'В настройках CRM откройте пользовательские поля и выберите сделки. Названия пунктов меню могут отличаться. Для каталога системных и пользовательских описаний можно использовать установленный справочник полей или crm.item.fields для нужной сущности.' },
  { question: 'В CSV попадут только 20 полей с первой страницы?', answer: 'В текущем справочнике таблица показывает по 20 строк на странице, а CSV формируется по всем совпадениям выбранной сущности и действующих фильтров. При экспорте каталог запрашивается заново, поэтому после изменений CRM количество может отличаться от прежнего экрана.' },
  { question: 'Как выгрузить все поля без фильтров?', answer: 'Выберите нужную сущность, сбросьте поиск, тип и категорию, проверьте список и нажмите «Экспорт CSV». Для другой сущности повторите действие отдельно. Один файл не объединяет все четыре каталога.' },
  { question: 'Справочник выгружает значения полей из сделок?', answer: 'Нет. CSV содержит описания полей: названия, коды, типы и технические свойства. Для строк со сделками и их значениями нужен отдельный экспорт данных CRM.' },
  { question: 'Можно ли открыть CSV в Excel?', answer: 'Файл имеет кодировку UTF-8 и разделитель «точка с запятой». Если текст нечитаем или вся строка оказалась в одной колонке, используйте импорт текстового файла и явно выберите эти параметры. После открытия проверьте названия и точность кодов.' },
  { question: 'Почему найдено меньше полей, чем ожидалось?', answer: 'Проверьте портал, сущность, строку поиска, тип и категорию. Справочник показывает описания, возвращённые API с текущими правами; он не объединяет поля разных сущностей. Ошибку загрузки не принимайте за отсутствие полей.' },
  { question: 'Можно ли восстановить настройки CRM из этого CSV?', answer: 'Нет. Это каталог описаний для проверки и согласования. В нём нет значений карточек и полного набора настроек CRM, а справочник не создаёт и не изменяет поля.' },
];
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const structuredData = createArticleStructuredData({
  articleType: 'Article', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  articleSection: article.category,
  breadcrumbs: [{ name: 'Главная', item: siteRoot.toString() }, { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() }, { name: title, item: articleUrl }], faqItems,
});
---
<ArticleLayout {title} {titleParts} {description} {canonicalPath} category={article.category}
  intro="Соберите названия, технические коды и свойства полей для интегратора: выберите сущность, задайте область экспорта и проверьте скачанный CSV."
  {structuredData} ogTitle={article.seoTitle ?? title} ogDescription={description} {ogImage} ogImageAlt={imageAlt} author={authorName}>
  <Fragment slot="quick-answer">
    <p>Если «Справочник полей CRM» уже подключён к порталу, выберите <strong>сделки, лиды, контакты или компании</strong>, настройте поиск и фильтры и нажмите «Экспорт CSV». Для полного каталога выбранной сущности сначала сбросьте фильтры.</p>
    <p>CSV содержит <strong>описания полей</strong>, а не значения из карточек. В текущей версии выгружаются все совпадения с фильтрами, даже если на экране видны только первые 20 строк.</p>
  </Fragment>
  <p data-article-lead>Перед обменом данными разработчику нужен перечень полей: как они называются, какой у них тип и по какому коду к ним обращаться. Выгрузка сделок для этой задачи избыточна: она содержит записи CRM, а не отдельный каталог их структуры. Сначала определите, что именно предстоит передать.</p>
  <section aria-labelledby="choose-list">
    <h2 id="choose-list">Какой <span data-heading-accent>список нужен</span></h2>
    <p>Для просмотра пользовательских полей откройте CRM → Ещё → Настройки → Настройки CRM → Настройки форм и отчётов → Пользовательские поля и выберите тип элемента. Расположение меню зависит от интерфейса портала. Этот раздел подходит для проверки существующих пользовательских настроек; менять их ради получения списка не требуется.</p>
    <p>Для перечня технических описаний системных и пользовательских полей выбранной сущности можно использовать справочник или REST-метод <a href={sourceLinks[0].href} target="_blank" rel="noopener noreferrer">crm.item.fields</a>. Если нужен один код по известному названию, достаточно <a href={`${base}kod-polya-bitrix24/`}>инструкции по поиску кода поля</a>.</p>
    <p>Для таблицы «одна строка — одна сделка» используйте <a href={sourceLinks[2].href} target="_blank" rel="noopener noreferrer">штатный экспорт данных CRM</a>. Он решает другую задачу: передаёт значения записей. Не отправляйте клиентскую базу, если интегратору нужны только названия и коды полей.</p>
  </section>
  <section aria-labelledby="open-directory">
    <h2 id="open-directory">Как открыть <span data-heading-accent>каталог полей</span></h2>
    <p>В установленном справочнике {companyInfo.brandName} выберите нужную сущность. Начните со сделок, если обмен будет записывать сведения в сделку; поля контакта или компании выгружайте отдельно. Похожая подпись в двух каталогах не подтверждает одинаковое назначение.</p>
    <ArticleFigure src={directoryImage} fullSize alt={imageAlt}
      caption="Реальный экран справочника на тестовом портале, 14.10.2026, версия 1.0.2. Выбраны сделки, на первой странице показаны 20 из 61 описания поля. Это количество на конкретном портале, не универсальный состав CRM. Значений карточек здесь нет." />
    <p>Таблица позволяет сравнить название, код, тип, техническую обязательность и множественность. Переключение страниц нужно для просмотра. Чтобы подготовить CSV, не требуется по очереди открывать каждую страницу.</p>
    <p>В примере используются четыре основные сущности: сделки, лиды, контакты и компании. Если приложение ещё не установлено, откройте <a href={fieldDirectoryProduct.marketplaceUrl} target="_blank" rel="noopener noreferrer">«Поля CRM — поиск кодов и экспорт» в Маркете Битрикс24</a>. Для доступа нужна подписка Битрикс24 Маркетплейс.</p>
  </section>
  <section aria-labelledby="filter-and-export">
    <h2 id="filter-and-export">Как выгрузить <span data-heading-accent>нужные поля в CSV</span></h2>
    <p>Поиск, тип и категория действуют одновременно. Например, если в строке поиска осталось название одного поля, категория «Пользовательские» не покажет все пользовательские поля: останутся только совпадения с этим названием. Для полного списка используйте «Сбросить фильтры» и проверьте выбранную сущность.</p>
    <ArticleFigure src={filteredImage} fullSize
      alt="Поиск CALC_COMP в справочнике полей сделки: три демонстрационных поля из 61 и кнопка Экспорт CSV"
      caption="Тот же тестовый портал: запрос CALC_COMP оставил три демонстрационных поля. При этих фильтрах область экспорта — совпадения с запросом, а не весь каталог. Экран показывает результат поиска; содержимое скачанного файла следует проверить отдельно." />
    <Checklist label="Порядок выгрузки каталога полей" items={[
      { title: 'Выберите сущность и область списка.', description: 'Сбросьте фильтры для полного каталога или оставьте согласованный поиск, тип и категорию для выборки.' },
      { title: 'Нажмите «Экспорт CSV».', description: 'Приложение заново запросит описания полей и применит выбранные фильтры ко всему каталогу. Текущая страница таблицы не ограничивает выгрузку.' },
      { title: 'Дождитесь начала загрузки.', description: 'Не блокируйте и не закрывайте вспомогательное окно до начала скачивания. Если браузер сообщает о блокировке окна, разрешите его для этого действия и повторите экспорт.' },
      { title: 'Проверьте файл в загрузках.', description: 'Убедитесь, что скачался CSV для нужной сущности. При нулевом результате фильтра файл не формируется: сначала измените выборку.' },
    ]} />
    <p>Сохраните рядом с файлом дату, название портала и применённые фильтры. Если каталог изменился между просмотром и экспортом, заново полученный список может отличаться от прежнего количества на экране. Для четырёх сущностей подготовьте четыре отдельных файла и подпишите их.</p>
    <InlineConsultation title="Нужно подготовить поля для обмена?" description="Поможем определить сущности, проверить форматы кодов и согласовать состав данных перед настройкой интеграции." href={companyInfo.contacts.consultationUrl} actionLabel="Обсудить задачу" />
  </section>
  <section aria-labelledby="csv-content">
    <h2 id="csv-content">Какие <span data-heading-accent>колонки будут в файле</span></h2>
    <p>Текущий CSV содержит восемь колонок. Он удобен как исходник для согласования структуры: интегратор видит код рядом с понятным названием и типом. Указанные ниже свойства относятся к описанию поля, а не к конкретной сделке.</p>
    <DataTable label="Колонки CSV справочника полей CRM" columns={['Колонка', 'Содержание', 'Что учитывать']} rows={csvColumns} rowHeaders />
    <p>Если свойство отсутствует в ответе, в файле может быть «Не передано API»; если API вернул null — «Не указано». Это не то же самое, что «Нет». Не заменяйте такие состояния автоматически логическим значением.</p>
    <p>В текущем справочнике используется <code>crm.item.fields</code> с <code>useOriginalUfNames=Y</code>: пользовательские ключи сохраняют исходный формат <code>UF_CRM_…</code>. У системного поля основное имя может выглядеть как <code>title</code>, а дополнительное — <code>TITLE</code>. Выбирайте имя по документации конкретного метода; самостоятельно менять регистр нельзя.</p>
  </section>
  <section aria-labelledby="open-and-check">
    <h2 id="open-and-check">Как открыть CSV <span data-heading-accent>и проверить результат</span></h2>
    <p>Файл формируется в UTF-8 с BOM, разделителем «точка с запятой» и строкой заголовков. Если табличный редактор показывает нечитаемый текст или одну длинную колонку, откройте файл через импорт текста и явно задайте UTF-8 и разделитель <code>;</code>. Сохраните исходный CSV до редактирования.</p>
    <p>Проверьте восемь колонок, сущность, несколько известных названий и точность кодов. Коды лучше импортировать как текст. Число строк данных считайте без строки заголовков и сравнивайте с ожидаемой выборкой, учитывая возможные изменения каталога.</p>
    <p>В текстовые ячейки с потенциально формульным началом приложение добавляет защитный апостроф. Его отображение зависит от редактора. Поэтому файл предназначен для просмотра и согласования; не считайте его готовым входом для обратного импорта без проверки правил обработки.</p>
    <p>Если поле не найдено, сначала сбросьте фильтры и проверьте сущность и портал. При сообщении об ошибке загрузки выполните предложенный в интерфейсе шаг восстановления. Отказ чтения API и отсутствие совпадений — разные состояния; пустая выборка сама по себе не доказывает удаление поля.</p>
  </section>
  <section aria-labelledby="handoff">
    <h2 id="handoff">Что передать <span data-heading-accent>интегратору вместе со списком</span></h2>
    <p>Одних кодов недостаточно для обмена. В рабочей копии таблицы добавьте назначение поля, источник значения, правила преобразования, допустимые пустые значения и ответственного за проверку. Совпадение названий в двух системах не заменяет согласование смысла данных. Этот шаг особенно важен при <a href={`${base}bitrix24-moysklad-integraciya/`}>интеграции Битрикс24 и МоегоСклада</a>.</p>
    <p>Каталог не показывает заполненность карточек, использование поля роботами, настройки видимости или обязательность на конкретной стадии. Он также не содержит полной конфигурации, значений вариантов списков и данных для восстановления CRM. Эти сведения собирают отдельно под задачу; справочник не создаёт и не изменяет поля.</p>
    <p>Для BI список помогает уточнить, что означает технический код, но сам не подключает наборы данных и не меняет подписи отчёта. Следующий шаг разобран в инструкции <a href={`${base}bi-analitika-bitrix24-pervyy-otchet/`}>о первом BI-отчёте в Битрикс24</a>.</p>
  </section>
  <p>Если CSV нужен для REST-запроса, сверьте его коды с <a href={`${base}uf-crm-ufcrm-bitrix24-api/`}>форматом имён выбранного метода</a>: два варианта имени не всегда взаимозаменяемы.</p>

  <p>Если задача — навести порядок в CRM, дополните каталог <a href={`${base}audit-poley-crm-bitrix24/`}>проверкой значений и зависимостей полей</a>. По одним названиям и кодам решение об удалении принимать нельзя.</p>

  <FaqSection variant="article" items={faqItems} />
  <ArticleSources sources={sourceLinks} publishedIso={article.publishedAt} modifiedIso={article.updatedAt} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Согласуйте ' }, { text: 'структуру полей CRM', accent: true }]}
      description={`Справочник полей CRM от ${companyInfo.brandName} помогает искать описания полей и выгружать выбранный каталог. Установите приложение из Маркета Битрикс24, чтобы подготовить список для вашей интеграции.`}
      href={fieldDirectoryProduct.marketplaceUrl} actionLabel={fieldDirectoryProduct.connectionActionLabel} />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <ConsultationCtaSection slot="after-article" />
</ArticleLayout>
