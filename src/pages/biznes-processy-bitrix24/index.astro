---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { mcpProduct } from '../../config/products';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import templateImage from '../../images/articles/bitrix24-bp-autostart-official-107.jpg';
import protocolImage from '../../images/articles/bitrix24-bp-protocol-official-106.jpg';

const article = getArticle('biznes-processy-bitrix24/');
const { title, description } = article;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const ogImage = new URL(templateImage.src, siteRoot).toString();
const imageAlt = 'Официальный пример параметров шаблона бизнес-процесса Битрикс24: название, автозапуск, журнал и события в таймлайне';
const faqItems = [
  { question: 'Когда для сделки нужен бизнес-процесс, а когда робот?', answer: 'Робот удобен для одного повторяемого действия при событии в CRM, например для постановки задачи при входе сделки на стадию. Бизнес-процесс подходит, когда сотрудник должен принять решение, а после утверждения и отказа нужны разные действия и история выполнения.' },
  { question: 'Как запустить согласование сделки вручную?', answer: 'Создайте шаблон для сделок, уберите в его параметрах автоматический запуск и проверьте право сотрудника на запуск. В карточке тестовой сделки откройте «Бизнес-процессы», выберите шаблон, заполните обязательные параметры и нажмите «Запустить процесс».' },
  { question: 'Где увидеть решение утверждающего?', answer: 'Откройте запущенный процесс из карточки сделки или раздела «Автоматизация → Бизнес-процессы → Процессы» и проверьте его статус и Протокол. События в таймлайне сделки видны, если соответствующая опция включена в шаблоне.' },
  { question: 'Почему шаблон не виден в нужной воронке?', answer: 'Проверьте отображение шаблона в воронках и права на запуск. В списке процессов карточки сделки по умолчанию показаны шаблоны текущей воронки; фильтр «Показывать процессы → Все» помогает проверить доступные варианты.' },
  { question: 'Настраивает ли MCP TrueTell бизнес-процессы автоматически?', answer: 'Автоматическое создание и изменение бизнес-процессов через MCP TrueTell пока не заявлено. Продукт для настройки и диагностики CRM разрабатывается; обсудить можно конкретный маршрут и нужные контрольные сигналы.' },
];
const sourceLinks = [
  { label: 'Битрикс24: параметры шаблона бизнес-процесса в CRM', href: 'https://helpdesk.bitrix24.ru/open/23709036/' },
  { label: 'Битрикс24: последовательный бизнес-процесс и действия', href: 'https://helpdesk.bitrix24.ru/open/21918154/' },
  { label: 'Битрикс24: действие «Утверждение документа»', href: 'https://helpdesk.bitrix24.ru/open/7451037/' },
  { label: 'Битрикс24: запуск бизнес-процесса в карточке CRM', href: 'https://helpdesk.bitrix24.ru/open/23509402/' },
  { label: 'Битрикс24: список процессов и Протокол', href: 'https://helpdesk.bitrix24.ru/open/21290220/' },
  { label: 'Битрикс24: новый конструктор бизнес-процессов', href: 'https://helpdesk.bitrix24.ru/open/27455366/' },
  { label: 'Битрикс24: уведомление пользователя в бизнес-процессе', href: 'https://helpdesk.bitrix24.ru/open/7471547/' },
];
const acceptanceRows = [
  ['Ручной запуск', 'Тестовая сделка, шаблон виден в нужной воронке', 'Процесс появился в списке и у утверждающего'],
  ['Утверждено', 'Руководитель принимает решение', 'Сработала ветка утверждения, инициатор получил нужное уведомление'],
  ['Отклонено', 'Новая тестовая сделка, руководитель указывает отказ', 'Сработала ветка отказа, причина и следующий шаг понятны менеджеру'],
  ['История', 'Оба запуска завершены', 'Статус, участники и действия видны в Протоколе'],
];
const structuredData = createArticleStructuredData({
  articleType: 'Article', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  breadcrumbs: [{ name: 'Главная', item: siteRoot.toString() }, { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() }, { name: title, item: articleUrl }],
  faqItems,
});
---
<ArticleLayout {title} titleParts={[{ text: 'Бизнес-процессы Битрикс24: ' }, { text: 'согласование сделки в CRM', accent: true }]} {description}
  canonicalPath={`/${article.hrefPath}`} {structuredData} ogTitle={article.seoTitle} ogDescription={description}
  {ogImage} ogImageAlt={imageAlt} category={article.category} author={authorName}
  intro="В примере менеджер вручную отправляет сделку руководителю. Тот утверждает или отклоняет предложение, а команда проверяет решение в истории процесса. Маршрут рассчитан на один уровень согласования и тестовые сделки.">
  <Fragment slot="quick-answer">
    <p><strong>Создайте для сделок последовательный бизнес-процесс с действием «Утверждение документа».</strong> Оставьте ручной запуск, назначьте одного утверждающего и задайте понятные действия для веток «Утвержден» и «Не утвержден». Запустите шаблон из тестовой сделки дважды: отдельно проверьте утверждение и отказ, затем сверьте Протокол.</p>
    <p>Бизнес-процессы CRM и дизайнер доступны не на всех тарифах; для изменения шаблона нужны права. Новый конструктор внедряется постепенно, поэтому названия разделов редактора могут отличаться от показанного ниже классического интерфейса.</p>
  </Fragment>

  <p data-article-lead>Менеджер подготовил коммерческое предложение, но отправить его клиенту можно только после решения руководителя. В процессе нужно зафиксировать, кто принял решение и что делать после отказа. В качестве объекта возьмём сделку; название клиента и файл предложения в тесте заменим учебными данными.</p>

  <section aria-labelledby="plan">
    <h2 id="plan">Опишите решение <span data-heading-accent>до настройки шаблона</span></h2>
    <p>Запишите, кто запускает согласование, какую сделку видит утверждающий и что должен проверить. Для первого шаблона достаточно одного руководителя. После его решения менеджер должен получить уведомление: при утверждении можно готовить отправку клиенту, при отказе — исправить предложение и запустить новый процесс после доработки. Не включайте автозапуск при каждом изменении сделки, пока такой маршрут не проверен: это может создавать повторные экземпляры.</p>
    <p>Действие Битрикс24 «Утверждение документа» относится к элементу, который запустил бизнес-процесс, и имеет две ветки продолжения. Оно само не доказывает, что руководитель открыл именно последний приложенный файл КП. Перед рабочим запуском проверьте, где хранится актуальная версия предложения, видна ли она утверждающему и что он должен указать при отказе. Для этого в параметрах задания можно включить комментарий.</p>
    <p>Если нужен только однотипный шаг при смене стадии — например, поставить задачу проверить КП, — используйте <a href={`${base}roboty-bitrix24/`}>сценарий с роботом</a>. Здесь сотрудник принимает решение, от которого зависит дальнейшая ветка.</p>
  </section>

  <section aria-labelledby="template">
    <h2 id="template">Создайте шаблон для сделок <span data-heading-accent>с ручным запуском</span></h2>
    <p>В классическом интерфейсе откройте <strong>Автоматизация → Бизнес-процессы → Процессы в CRM</strong>, выберите «Сделки» и нажмите «Добавить шаблон». Добавлять и менять шаблоны могут администраторы Битрикс24 и сотрудники с правом «Разрешать изменять настройки CRM». В параметрах укажите название «Согласование КП», коротко опишите назначение и снимите отметки автоматического запуска «При добавлении» и «При изменении». Проверьте отображение в нужной воронке и права сотрудников на запуск.</p>
    <p>Для теста полезно включить показ событий процесса в таймлайне сделки. Если нужен подробный разбор ошибки, включите запись событий в журнал на семь дней, затем отключите её после проверки. Сохраните параметры шаблона. На официальном примере ниже автозапуск включён; для описанного здесь ручного запуска обе отметки следует снять.</p>
    <ArticleFigure src={templateImage} fullSize alt={imageAlt} caption="Подлинный демонстрационный экран параметров шаблона из справки Битрикс24. На нём включён автозапуск; в нашем учебном сценарии его нужно выключить. Интерфейс относится к классическому дизайнеру и может отличаться в новом конструкторе." />
    <p>В последовательном дизайнере добавьте действие <strong>Задания → Утверждение документа</strong>. Укажите одного утверждающего, название «Согласовать КП» и описание того, что нужно проверить. Включите поле комментария и, если нужно, сделайте его обязательным; при отказе проверьте, что руководитель оставил причину. После действия настройте ветки «Утвержден» и «Не утвержден», например добавьте в каждую «Уведомление пользователя» менеджеру с разным текстом и следующим шагом. Проверьте получателя уведомления, сохраните действие и весь шаблон.</p>
  </section>

  <section aria-labelledby="test">
    <h2 id="test">Проверьте оба решения <span data-heading-accent>на тестовых сделках</span></h2>
    <p>Откройте тестовую сделку в выбранной воронке, нажмите «Бизнес-процессы», найдите «Согласование КП» и выберите «Запустить процесс». Если шаблон не виден, проверьте фильтр «Показывать процессы», выбранные в параметрах воронки и права запуска. Заполните обязательные параметры, если они есть. Утверждающий должен увидеть задание и понять, какую версию КП проверяет.</p>
    <p>В первом тесте руководитель утверждает предложение. Откройте карточку процесса и Протокол: там должны быть решение, участник и выполненная ветка; менеджеру должно прийти предусмотренное уведомление. Во втором тесте возьмите новую сделку и отклоните предложение. Проверьте ветку отказа и текст, с которым менеджер вернётся к доработке. Уведомления и прочие действия шаблона могут сработать реально, поэтому используйте учебные контакты и заранее проверьте получателей.</p>
    <ArticleFigure src={protocolImage} fullSize alt="Официальный пример Протокола Битрикс24 с участником и результатом завершённого бизнес-процесса" caption="Подлинный демонстрационный Протокол из справки Битрикс24. Показанный счёт и участник не относятся к TrueTell или клиентскому порталу; для своего согласования проверьте две отдельные записи: утверждение и отказ." />
    <DataTable label="Проверка согласования сделки после настройки" columns={['Контроль', 'Действие на тесте', 'Ожидаемый результат']} rows={acceptanceRows} rowHeaders />
    <p>Если задача утверждающему не появилась или процесс остался в работе, проверьте статус экземпляра, права, обязательные параметры и Протокол. Для поиска пересечений с роботами и другими шаблонами используйте <a href={`${base}audit-avtomatizacii-bitrix24/`}>карту аудита автоматизации</a>. Уже запущенный процесс после правки шаблона продолжает работать по прежней версии; исправление проверяйте на новом экземпляре.</p>
  </section>

  <section aria-labelledby="interface">
    <h2 id="interface">Если открылся <span data-heading-accent>новый конструктор</span></h2>
    <p>Битрикс24 объявил новый конструктор бизнес-процессов 28 октября 2026 года и сообщает, что обновление приходит пользователям постепенно. В нём шаблон открывают через <strong>Автоматизация → Бизнес-процессы → Шаблоны процессов</strong>, а действия представлены нодами. По официальной справке работать в этом конструкторе могут только администраторы. Не переносите названия кнопок классического дизайнера на новый экран буквально: соберите тот же маршрут решения и проверьте права, запуск и обе ветки в вашем интерфейсе.</p>
    <p>MCP TrueTell для настройки и диагностики CRM находится в разработке. Мы пока не заявляем, что он создаёт или меняет шаблоны бизнес-процессов. Для обсуждения будущей диагностики полезно подготовить обезличенную карту: тип сделки, способ запуска, утверждающий, ожидаемые ветки и фактические записи в Протоколе.</p>
    <InlineConsultation variant="product" title="Нужно проверить маршрут согласования?" description="Опишите одну сделку и результат без данных клиента: кто запускает процесс, кто утверждает и что происходит после отказа. Поможем спланировать проверку и обсудить возможности диагностики." href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
  </section>

  <FaqSection title="Частые вопросы о бизнес-процессах Битрикс24" items={faqItems} variant="article" />
  <p>Официальная справка Битрикс24 проверена 31 октября 2026 года. Иллюстрации — демонстрационные скриншоты классического интерфейса. Маршрут не запускался на рабочем клиентском портале; тариф, права и вид конструктора проверьте в своём Битрикс24.</p>
  <ArticleSources publishedIso={article.publishedAt} modifiedIso={article.updatedAt} sources={sourceLinks} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Обсудим ' }, { text: 'диагностику CRM с MCP TrueTell', accent: true }]} description={mcpProduct.articleDescription} href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <ConsultationCtaSection slot="after-article" />
</ArticleLayout>
