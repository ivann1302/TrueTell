---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import choiceImage from '../../images/articles/moysklad-export-methods-089.png';
import profitabilityImage from '../../images/articles/moysklad-profitability-report-official.png';

const article = getArticle('vygruzka-dannyh-moysklad-dlya-analitiki/');
const { title, description } = article;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const canonicalPath = `/${article.hrefPath}`;
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const imageAlt = 'Четыре способа получать данные МойСклад: Excel, рассылка, JSON API и аналитическая база';
const ogImage = new URL(choiceImage.src, siteRoot).toString();
const titleParts = [
  { text: 'Как выгрузить данные из МойСклад для аналитики: ' },
  { text: 'Excel, API или своя база', accent: true },
];
const comparisonRows = [
  ['Штатный отчёт и Excel', 'Снимок на момент выгрузки', 'Выбранный период или дата среза; старые файлы храните сами', 'Каждый новый файл получают и сверяют вручную'],
  ['Автоматическая отправка отчёта', 'Новый файл приходит по расписанию', 'Копии накапливаются с момента настройки, если их сохранять', 'Меньше работы с получением файла; разные отчёты нужно сводить'],
  ['JSON API', 'Частота зависит от вашей интеграции', 'Интеграция получает и сохраняет нужные доступные данные', 'Нужны настройка, обработка изменений и контроль ошибок'],
  ['API и аналитическая база', 'Частота зависит от загрузки данных', 'Глубину истории проектируют и поддерживают отдельно', 'Настройка сложнее; повторяемые отчёты не требуют ручного сведения файлов'],
];
const faqItems = [
  { question: 'Можно ли выгружать данные из МойСклад без программиста?', answer: 'Да. Штатные отчёты, печатные формы и экспорт справочника товаров доступны через интерфейс. Для ряда отчётов можно настроить отправку по почте. Собственная регулярная интеграция через API требует настройки и поддержки.' },
  { question: 'Можно ли получить историю остатков по дням одним Excel-файлом?', answer: 'Штатный отчёт «Остатки» позволяет выбрать дату среза, а ежедневная рассылка помогает сохранять будущие снимки. Для единой таблицы по множеству дней файлы понадобится свести или построить отдельный процесс получения и хранения данных.' },
  { question: 'Заменяет ли аналитическая база резервное копирование?', answer: 'Нет гарантии. База может хранить выбранные записи для отчётов, но восстановление удалённого документа вместе с его связями — отдельная задача.' },
  { question: 'Подключится ли к такой базе Power BI или DataLens?', answer: 'Это зависит от типа базы, сетевого доступа, прав и проверенной связки с конкретным инструментом. Способ подключения стоит подтвердить на тестовых данных до обещания пошаговой инструкции.' },
];
const sourceLinks = [
  { label: 'Отчёт «Остатки» — справка МойСклад', href: 'https://support.moysklad.ru/hc/ru/товары%20и%20склады/остатки%20и%20себестоимость/отчет_остатки' },
  { label: 'Автоформирование отчётов — справка МойСклад', href: 'https://support.moysklad.ru/hc/ru/знакомство%20с%20сервисом/инструменты/автоформирование_отчетов' },
  { label: 'Экспорт товаров в Excel — справка МойСклад', href: 'https://support.moysklad.ru/hc/ru/товары%20и%20склады/импорт%20и%20экспорт/экспорт_товаров_в_excel' },
  { label: 'Отчёт «Прибыльность» — справка МойСклад', href: 'https://support.moysklad.ru/hc/ru/отчеты/отчет_прибыльность' },
  { label: 'JSON API 1.2 — документация МойСклад', href: 'https://dev.moysklad.ru/doc/api/remap/1.2/' },
  { label: 'Ограничения JSON API — официальный репозиторий МойСклад', href: 'https://github.com/moysklad/api-remap-1.2-doc/blob/master/md/_restrictions.md' },
];
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({
  ...item,
  description: item.summaryDescription ?? item.description,
  href: `${base}${item.hrefPath}`,
}));
const structuredData = createArticleStructuredData({
  articleType: 'BlogPosting',
  title,
  description,
  articleUrl,
  publishedDate: article.publishedAt,
  modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(),
  image: ogImage,
  author: authorName,
  breadcrumbs: [
    { name: 'Главная', item: siteRoot.toString() },
    { name: 'Блог', item: new URL('blog/', siteRoot).toString() },
    { name: title, item: articleUrl },
  ],
  faqItems,
});
---

<ArticleLayout {title} {titleParts} {description} {canonicalPath} {structuredData}
  ogTitle={article.seoTitle} ogDescription={description} {ogImage} ogImageAlt={imageAlt}
  category={article.category} author={authorName}
  intro="Сравниваем Excel, автоматическую рассылку, API и аналитическую базу по свежести данных, истории и объёму ручной работы.">
  <Fragment slot="quick-answer">
    <p>Для разовой проверки продаж или остатков начните со штатного отчёта и Excel. Если тот же файл нужен ежедневно, проверьте автоматическую отправку отчёта на почту.</p>
    <p>Для собственного дашборда с продажами, возвратами и остатками нескольких магазинов обычно требуются регулярное получение данных, например через API, и место для их хранения и расчёта показателей.</p>
  </Fragment>

  <p data-article-lead>API передаёт данные из МойСклад, а аналитическая база хранит выбранные записи и готовит их для отчётов. Эти способы часто работают вместе. Выбор зависит от вопроса, на который должен отвечать отчёт, и от того, как часто ответ требуется обновлять.</p>

  <section aria-labelledby="question">
    <h2 id="question">Сначала определите, <span data-heading-accent>что хотите увидеть</span></h2>
    <p>Фраза «выгрузить всё из МойСклад» редко помогает выбрать инструмент. Запишите один проверяемый вопрос. Например: «Какие товары продавались в каждом магазине за прошлую неделю?», «Сколько товара оставалось на конец каждого дня?» или «Почему сумма продаж не совпала с поступлением денег?» Это разные наборы документов и правила расчёта.</p>
    <p>Укажите период, магазины, товары и частоту обновления. Затем решите, нужна ли только итоговая сумма или возможность открыть строки, из которых она получилась. Без этих условий можно собрать таблицу и всё равно не понять, почему она расходится с МойСклад.</p>
    <DataTable label="Способы выгрузки данных МойСклад по свежести, истории и объёму ручной работы" columns={['Способ', 'Свежесть данных', 'История', 'Ручная работа']} rows={comparisonRows} rowHeaders />
    <ArticleFigure src={choiceImage} fullSize portrait alt={imageAlt} caption="Схема помогает выбрать первый способ под задачу. Отдельная аналитическая база нужна не каждому магазину." />
  </section>

  <section aria-labelledby="excel">
    <h2 id="excel">Разовая выгрузка: <span data-heading-accent>отчёт и Excel</span></h2>
    <p>Для продаж, возвратов и прибыли начните с <a href={`${base}otchety-moysklad/`}>разбора штатных отчётов МойСклад</a>. Например, отчёт <strong>Продажи → Прибыльность</strong> показывает продажи, возвраты и себестоимость за выбранный период. Для запаса откройте <strong>Склад → Остатки</strong>: там можно выбрать склад и дату среза. Отчёт об остатках поддерживает печатные формы в Excel, PDF и OpenOffice Calc. Отдельный экспорт справочника товаров запускается из <strong>Товары → Товары и услуги</strong>; это другая операция и другой состав данных.</p>
    <ArticleFigure src={profitabilityImage} fullSize alt="Официальный экран отчёта Прибыльность МойСклад с фильтром и меню Печать" caption="Экран из официальной справки МойСклад. Фильтр задаёт условия отчёта, меню «Печать» открывает доступные формы. Суммы в строках — пример интерфейса, не данные клиента TrueTell." />
    <p>Перед выгрузкой сохраните условия: период, склад или точку, фильтры, дату формирования и назначение файла. Если через месяц открыть новый отчёт с тем же названием, но с другим периодом или набором документов, сравнение ничего не объяснит. Для проверки спорной суммы найдите несколько исходных строк в МойСклад и сравните их с файлом.</p>
    <p>Excel удобен, когда ответ нужен сейчас и объём ручной работы невелик. Сохранённый файл остаётся снимком на момент выгрузки: последующие исправления документов не изменят его ячейки. Для повторяемого отчёта потребуется снова получить данные и свести файлы по одинаковым правилам.</p>
  </section>

  <section aria-labelledby="email">
    <h2 id="email">Регулярный файл: <span data-heading-accent>рассылка отчёта</span></h2>
    <p>В МойСклад можно настроить автоматическое формирование ряда отчётов и списков документов с отправкой на email. Для отчёта «Остатки» официальная справка отдельно описывает ежедневную отправку. Это полезно, когда руководителю достаточно знакомого отчёта в одинаковое время и не нужен новый набор показателей.</p>
    <p>Настройка выполняется через меню <strong>Печать → Настроить</strong> и параметр <strong>Авто</strong> у доступного шаблона. Состав и доступность шаблонов проверьте в своём аккаунте. Если файлы нужны для истории, сохраняйте их с датой формирования и настройками фильтра. Рассылка начинает накапливать ваши копии с момента настройки; старые письма и файлы она не создаст задним числом.</p>
    <p>Почта не избавляет от ручного сведения разных отчётов. Например, чтобы рядом с остатком по товару показать продажи по нему же, данные придётся сопоставить по товару, складу и дате. Если в файлах есть устойчивые идентификаторы, используйте их. Совпадения названия недостаточно: карточку могут переименовать, а модификации одного товара нужно учитывать отдельно.</p>
  </section>

  <section aria-labelledby="api">
    <h2 id="api">JSON API: <span data-heading-accent>данные для собственного процесса</span></h2>
    <p>JSON API МойСклад позволяет получать справочники, документы и некоторые отчёты программно. Этот путь подходит, если данные должны попадать в другое приложение или расчёт по расписанию. У интеграции появляется работа, которой нет у разовой выгрузки: выбрать необходимые сущности, пройти все страницы ответа, соблюдать лимиты, хранить точку продолжения, повторять неудачные запросы и сверять результат с источником.</p>
    <p>API сам по себе не даёт готовый дашборд. Программа должна определить, как связаны документы, позиции, товары, склады и даты. Ей также нужны правила для исправлений и удалений: выгрузка только «нового с прошлого запуска» может не объяснить изменение старой суммы. Доступная функциональность зависит в том числе от тарифа; набор полей и права проверяйте для способа подключения и настроек своего аккаунта. Доступ к себестоимости и финансовым данным проверяйте отдельно.</p>
    <p>В <a href={sourceLinks[4].href} target="_blank" rel="noopener noreferrer">документации JSON API 1.2</a> перечислены сущности и способы их получения. Ограничения запросов МойСклад <a href={sourceLinks[5].href} target="_blank" rel="noopener noreferrer">публикует отдельно</a>. <a href={`${base}api-moysklad/`}>В отдельном разборе API</a> показано, где получить токен, какие права и лимиты проверить. Для решения о разработке сначала определите состав данных и допустимую задержку.</p>
  </section>

  <section aria-labelledby="database">
    <h2 id="database">Аналитическая база: <span data-heading-accent>когда нужно связывать данные</span></h2>
    <p>Если директор сети хочет открыть дашборд «магазин × товар × день», одной выгрузки обычно мало. Нужна модель, в которой документы и справочники приведены к согласованным ключам и определениям показателей. В неё можно добавить историю рассчитанных остатков, продажи, возвраты и другие необходимые данные. Источником такой базы остаётся МойСклад; получение данных обычно строится через API или другую подтверждённую интеграцию.</p>
    <p>Сама база не делает цифры верными. До подключения BI нужно решить, какая дата относится к продаже и возврату, что считать итогом дня, как показывать нулевой остаток и когда перечитывать старые периоды после исправлений. Настройте сверку хотя бы на одном магазине и небольшом интервале: сравните несколько документов, товарных строк и итогов с МойСклад при одинаковых фильтрах.</p>
    <p>Уточняйте у поставщика решения четыре вещи: какие данные копируются, как часто они обновляются, сколько хранится история и что происходит после исправления или удаления документа. Аналитическая копия также не становится автоматически резервной копией: возможность восстановить исходные объекты и связи нужно проверять отдельно.</p>
    <InlineConsultation title="Нужен отчёт по нескольким магазинам?" description="Опишите показатели, период и пример расхождения. Поможем определить состав данных и проверку результата." />
  </section>

  <section aria-labelledby="choice">
    <h2 id="choice">Что выбрать <span data-heading-accent>для своей задачи</span></h2>
    <p>Если вам нужен ответ на один вопрос за прошлую неделю, штатный отчёт с выгрузкой в Excel будет самым коротким путём. Ежедневная рассылка подходит, когда тот же отчёт нужен регулярно и его не приходится вручную соединять с другими таблицами. API нужен, когда данные входят в ваш собственный процесс. Для общего дашборда нескольких магазинов к получению данных добавляются хранение, правила расчёта и сверка.</p>
    <p>Перед выбором сложной схемы попробуйте собрать один показатель на одном магазине. Запишите, из каких документов получилась сумма, и посмотрите, можно ли повторить расчёт в следующем месяце без ручной работы. Этот опыт покажет, где заканчиваются возможности текущего способа выгрузки.</p>
  </section>

  <FaqSection id="faq" title="Частые вопросы о выгрузке данных" items={faqItems} variant="article" />
  <p>Официальные материалы МойСклад проверены 25 октября 2026 года. Возможности конкретного аккаунта и тарифа при подготовке статьи не тестировались.</p>
  <ArticleSources publishedIso={article.publishedAt} modifiedIso={article.updatedAt} sources={sourceLinks} />

  <Fragment slot="article-end">
    <ArticleProductCta
      titleParts={[{ text: 'Готовите данные МойСклад ' }, { text: 'для аналитики?', accent: true }]}
      description="TrueTell разрабатывает инструмент для подготовки данных МойСклад к аналитике. Расскажите, какие показатели нужны и где сейчас расходятся цифры: обсудим состав данных и способ проверки."
      href={companyInfo.contacts.consultationUrl}
      actionLabel="Обсудить задачу"
    />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <ConsultationCtaSection slot="after-article" />
</ArticleLayout>
