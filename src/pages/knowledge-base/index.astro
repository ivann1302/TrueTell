---
import AppHeader from '../../components/header/header.astro';
import SiteFooter from '../../components/footer/site-footer.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { knowledgeBaseArticles } from '../../config/articles';
import bitrix24Icon from '../../images/logo/bitrix24-app-icon.svg';
import moyskladIcon from '../../images/logo/moysklad-app-icon.svg';
import styles from './knowledge-base.module.scss';

const article = (path: string) => {
  const item = knowledgeBaseArticles.find(({ hrefPath }) => hrefPath === path);
  if (!item) throw new Error(`Knowledge base article not found: ${path}`);
  return { href: `/${path}`, title: item.title };
};

const sections = [
  {
    id: 'bitrix24',
    title: 'Битрикс24',
    icon: bitrix24Icon,
    topics: [
      {
        title: 'Лиды',
        items: [
          article('udalennye-lidy-bitrix24/'),
          article('ne-udalyaetsya-lid-bitrix24/'),
          article('bitrix24-udalenie-lidov-za-period/'),
        ],
      },
      {
        title: 'Сделки',
        items: [article('udalenie-proigrannyh-sdelok-bitrix24/')],
      },
    ],
  },
  {
    id: 'moysklad',
    title: 'МойСклад',
    icon: moyskladIcon,
    topics: [
      {
        title: 'Товары и цены',
        items: [
          { href: '/moysklad-izmenenie-cen/', title: 'Массовое изменение цен' },
          { href: '/moysklad-izmenenie-tovarov/', title: 'Массовое изменение товаров', draft: true },
          { href: '/moysklad-arhivirovanie/', title: 'Архивирование товаров', draft: true },
        ],
      },
      {
        title: 'Импорт и документы',
        items: [
          { href: '/moysklad-import/', title: 'Импорт товаров' },
          { href: '/moysklad-izmenenie-dokumentov/', title: 'Массовое изменение документов', draft: true },
        ],
      },
      {
        title: 'Удаление и восстановление',
        items: [
          { href: '/moysklad-udalenie/', title: 'Массовое удаление товаров', draft: true },
          article('kak-vosstanovit-udalennye-zakazy-tovary-moysklad/'),
        ],
      },
    ],
  },
];

const title = 'База знаний TrueTell — инструкции по Битрикс24 и МоемуСкладу';
const description = 'Практические инструкции по Битрикс24 и МоемуСкладу: лиды, сделки, товары, импорт, удаление и восстановление данных.';
---

<BaseLayout {title} {description} canonicalPath="/knowledge-base/">
  <AppHeader />
  <main class={styles.page}>
    <header class={styles.intro}>
      <div class={styles.container}>
        <h1>База знаний</h1>
        <p>Практические инструкции по Битрикс24 и МоемуСкладу — по системам и темам.</p>
        <nav class={styles.categoryNav} aria-label="Разделы базы знаний">
          {sections.map((section) => (
            <a href={`#${section.id}`}>
              <span>{section.title}</span>
              <span aria-hidden="true">→</span>
            </a>
          ))}
        </nav>
      </div>
    </header>

    <div class={styles.catalog}>
      {sections.map((section) => (
        <section id={section.id} class={styles.section} aria-labelledby={`${section.id}-title`}>
          <div class={styles.container}>
            <div class={styles.sectionHeading}>
              <h2 id={`${section.id}-title`}>
                {section.title}
                {'icon' in section && section.icon && (
                  <img class={styles.sectionIcon} src={section.icon.src} alt="" width="56" height="56" loading="lazy" decoding="async" />
                )}
              </h2>
            </div>
            <div class={styles.topics}>
              {section.topics.map((topic) => (
                <div class={styles.topic}>
                  <h3>{topic.title}</h3>
                  <ul class={styles.links}>
                    {topic.items.map((item) => (
                      <li>
                        <a href={item.href}>
                          <span class={styles.itemCopy}>
                            <span class={styles.itemTitle}>{item.title}</span>
                            {'draft' in item && item.draft && <span class={styles.itemStatus}>Скриншоты готовятся</span>}
                          </span>
                          <span class={styles.arrow} aria-hidden="true">→</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </section>
      ))}
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
