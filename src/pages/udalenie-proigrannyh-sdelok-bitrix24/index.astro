---
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import Checklist from '../../components/editorial/checklist.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import { blogArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { cleanerProductPath } from '../../config/products';
import dealCleanupImage from '../../images/articles/bitrix24-lost-deals.png';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';

const title = "Как удалить проигранные сделки в Битрикс24 и сохранить нужные";
const description = "Как удалить проигранные сделки в Битрикс24 по стадии и периоду: настроить фильтры, проверить выборку и сохранить записи, нужные для работы и аналитики.";
const canonicalPath = '/udalenie-proigrannyh-sdelok-bitrix24/';
const publishedDate = '2026-09-23T00:00:00+03:00';
const authorName = companyInfo.editorial.defaultAuthor;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const cleanerHref = `${base}${cleanerProductPath.slice(1)}`;
const siteRoot = new URL(base, import.meta.env.SITE);
const homeUrl = siteRoot.toString();
const blogUrl = new URL('blog/', siteRoot).toString();
const articleUrl = new URL('udalenie-proigrannyh-sdelok-bitrix24/', siteRoot).toString();
const imageAlt = 'Схема отбора проигранных сделок: сохранение истории для повторного контакта и удаление ненужных записей';
const ogImage = new URL(dealCleanupImage.src, siteRoot).toString();
const ogDescription = 'Отбор по стадии, проверка исключений и удаление ненужных сделок: как очистить CRM и сохранить полезную историю.';
const titleParts = [
  { text: 'Как удалить ' },
  { text: 'проигранные сделки в Битрикс24', accent: true },
  { text: ' и сохранить нужные' },
];
const breadcrumbs = [
  { label: 'Главная', href: base },
  { label: 'Блог', href: `${base}blog/` },
  { label: title },
];
const sourceLinks = [
  {
    "label": "Как работают фильтры в CRM — Поддержка24",
    "href": "https://helpdesk.bitrix24.ru/open/24206616/"
  },
  {
    "label": "Групповые действия в CRM — Поддержка24",
    "href": "https://helpdesk.bitrix24.ru/open/21064250/"
  },
  {
    "label": "Как удалить элементы CRM — Поддержка24",
    "href": "https://helpdesk.bitrix24.ru/open/23238660/"
  },
  {
    "label": "Как освободить место в CRM — Поддержка24",
    "href": "https://helpdesk.bitrix24.ru/open/26995556/"
  },
  {
    "label": "Что такое Корзина в CRM — Поддержка24",
    "href": "https://helpdesk.bitrix24.ru/open/24668648/"
  }
];
const preservationRows = [
  [
    "Тестовое обращение после настройки сайта",
    "Проверить, что запись действительно тестовая и не используется для проверки интеграций"
  ],
  [
    "Окончательно нецелевой запрос",
    "Уточнить, нужна ли запись для анализа качества обращений"
  ],
  [
    "Отказ «вернёмся позже»",
    "Сохранить историю и договорённость о следующем контакте"
  ],
  [
    "Реальная продажа, проигранная конкуренту",
    "Согласовать сохранение данных для анализа причин отказа"
  ],
  [
    "Оплата, документы или спорная ситуация",
    "Отложить удаление до проверки связанных данных и обязательств"
  ]
];
const faqItems = [
  {
    "question": "Можно ли удалить только одну проигранную стадию?",
    "answer": "Да. В отборе укажите конкретную текущую стадию вместо всей группы проигранных сделок. Перед удалением проверьте несколько найденных карточек, чтобы убедиться, что выбрана нужная причина отказа."
  },
  {
    "question": "Почему в выборке оказались сделки, которые снова находятся в работе?",
    "answer": "Проверьте, не выбран ли отбор по истории стадий. Он может найти сделку, которая раньше была проиграна, а затем вернулась в работу. Для очистки по текущему состоянию используйте обычную стадию или группу стадий."
  },
  {
    "question": "Можно ли просто скрыть проигранные сделки?",
    "answer": "Если задача — убрать завершённые обращения из рабочего списка, используйте фильтр по текущим рабочим стадиям. Карточки сохранятся, и к ним можно будет вернуться. Это подходящий вариант, когда история отказов ещё нужна компании."
  },
  {
    "question": "Что делать, если кнопки удаления нет?",
    "answer": "Попросите администратора проверить ваши права на удаление сделок. Само наличие доступа к карточкам не означает, что разрешено их удалять. После изменения прав заново проверьте выборку перед запуском операции."
  },
  {
    "question": "Можно ли восстановить случайно удалённую сделку?",
    "answer": "Проверьте корзину CRM и доступность восстановления на вашем тарифе. Если для сделок корзина отключена или запись уже окончательно удалена, рассчитывать на обычное восстановление из корзины нельзя. Поэтому проверка отбора нужна до очистки, а не после неё."
  }
];
const deletionSteps = [
  {
    "title": "Откройте нужную воронку",
    "description": "Откройте CRM → Сделки, выберите нужную воронку и представление списком."
  },
  {
    "title": "Задайте условия отбора",
    "description": "В фильтре задайте текущую проигранную стадию или группу неуспешных стадий. Добавьте период и остальные условия вашего правила очистки."
  },
  {
    "title": "Проверьте найденные карточки",
    "description": "Просмотрите результат. Проверьте несколько карточек, особенно записи на границах периода, сделки с большой суммой и те, по которым недавно общались с клиентом."
  },
  {
    "title": "Выделите согласованные записи",
    "description": "Выделите только согласованные записи. Если удаляется вся выборка, ещё раз проверьте условия перед применением операции ко всем страницам."
  },
  {
    "title": "Удалите и сверьте результат",
    "description": "Выполните удаление и проверьте результат по тем же условиям поиска."
  }
];
const relatedArticles = blogArticles
  .filter((article) => article.hrefPath && article.hrefPath !== canonicalPath.slice(1))
  .slice(0, 3)
  .map((article) => ({ ...article, href: `${base}${article.hrefPath}` }));
const structuredData = createArticleStructuredData({
  title,
  description,
  articleUrl,
  publishedDate,
  publisherUrl: homeUrl,
  author: authorName,
  image: ogImage,
  articleSection: 'Работа с CRM',
  breadcrumbs: [
    { name: 'Главная', item: homeUrl },
    { name: 'Блог', item: blogUrl },
    { name: title, item: articleUrl },
  ],
  faqItems,
});
---

<ArticleLayout
  {title} {titleParts} {description} {canonicalPath} {structuredData}
  ogTitle={title} {ogDescription} {ogImage} ogImageAlt={imageAlt}
  category="Битрикс24"
  intro="Как отобрать сделки по текущей стадии, проверить исключения и очистить CRM, сохранив историю для повторных продаж и аналитики."
  {breadcrumbs} author={authorName} publishedTime={publishedDate} modifiedTime={publishedDate}
>
  <Fragment slot="quick-answer">
    <p>Откройте список сделок, отберите записи по <strong>текущей проигранной стадии</strong>, проверьте выборку и выполните групповое удаление. Если чистите только часть базы, ограничьте отбор воронкой и периодом.</p>
    <p>Сохраните сделки, по которым возможен повторный контакт или нужна история переговоров. <strong>Неуспешная продажа ещё не означает, что карточка бесполезна.</strong></p>
  </Fragment>

  <p data-article-lead>Самая сложная часть очистки — определить, какие отказы действительно можно убрать. Под одной проигранной стадией могут оказаться тестовая заявка, окончательный отказ и клиент, который попросил вернуться через полгода. Удалить их вместе легко; восстановить смысл переговоров после такой уборки гораздо труднее.</p>

  <section aria-labelledby="keep-deals">

    <h2 id="keep-deals">Какие проигранные сделки <span data-heading-accent>стоит оставить</span></h2>

    <p>Начните с причины очистки. Если завершённые сделки просто мешают в ежедневной работе, достаточно изменить рабочий фильтр. Удаление имеет смысл, когда записи действительно больше не нужны: например, это проверочные обращения после настройки формы или заведомо нецелевые заявки, которые компания решила не хранить.</p>

    <p>С реальными отказами осторожнее. Клиент мог отказаться из-за временного отсутствия бюджета, переноса проекта или неподходящих сроков. В карточке остаются условия предложения и договорённости, которые помогут при следующем обращении. Прежде чем убирать такую сделку, согласуйте с ответственным, нужна ли ему эта история.</p>

    <p>Отдельный вопрос — аналитика. Битрикс24 исключает удалённые элементы CRM из аналитических отчётов. Если убрать реальные проигранные сделки, изменится база для оценки продаж. Поэтому сначала сохраните необходимые показатели и согласуйте очистку с тем, кто отвечает за отчётность. <a href="https://helpdesk.bitrix24.ru/open/23238660/" target="_blank" rel="noopener noreferrer">Документация Битрикс24 об удалении элементов.</a></p>

    <DataTable label="Какие проигранные сделки сохранить перед очисткой" columns={["Что находится в проигранной сделке", "Как поступить перед очисткой"]} rows={preservationRows} rowHeaders compact />

    <p>Полезно сформулировать правило очистки одной фразой. Например: «Удаляем проверочные сделки из основной воронки, созданные в первом квартале 2025 года и находящиеся на стадии “Тестовая заявка”». Это условный пример: названия воронок и стадий у вашей компании будут другими. Такое правило можно проверить по каждой карточке, тогда как формулировка «убрать всё старое» оставляет слишком много места для ошибки.</p>

  </section>

  <section aria-labelledby="current-stage">

    <h2 id="current-stage">Как отобрать сделки <span data-heading-accent>по стадии</span> и не захватить лишние</h2>

    <p>Для очистки выбирайте текущую стадию. В Битрикс24 есть и фильтры по истории: они находят сделки, которые проходили через выбранную стадию раньше. Для удаления проигранных записей это принципиальное различие: сделку могли вернуть в работу после отказа.</p>

    <p>Если нужны все неуспешно завершённые сделки, используйте группу стадий «Сделка провалена». Если удалять можно только конкретную причину отказа, выбирайте соответствующую стадию. Разницу между текущими и историческими значениями описывает <a href="https://helpdesk.bitrix24.ru/open/24206616/" target="_blank" rel="noopener noreferrer">официальная инструкция по фильтрам CRM</a>.</p>

    <p>Представим, что в компании настроены отдельные стадии «Не наш профиль» и «Вернуться позже». Широкий отбор всех проигранных сделок объединит обе категории. Если договорились очищать только нецелевые обращения, нужно ограничиться первой стадией. Одного признака «закрыта» для такой задачи тоже недостаточно: закрытая сделка может быть успешной.</p>

    <p>Начинать удобнее с одной воронки. Так проще сопоставить стадии с принятыми в отделе правилами и обсудить исключения с менеджерами. Перед поиском проверьте уже установленные условия: оставшийся фильтр по ответственному или периоду может сделать выборку неожиданно маленькой.</p>

    <ArticleFigure src={dealCleanupImage} alt={imageAlt} caption="Схема принципа отбора: история для повторного контакта остаётся в CRM, удаляются только согласованные ненужные записи. Это иллюстрация, а не экран Битрикс24." />

  </section>

  <section aria-labelledby="date-range">

    <h2 id="date-range">Какой <span data-heading-accent>период</span> задать</h2>

    <p>Сначала уточните, что именно означает «старые сделки»: созданные давно или завершённые давно. Например, карточку могли создать в феврале 2025 года, а окончательный отказ получить только в августе 2026 года. По дате создания она старая, хотя переговоры закончились недавно.</p>

    <p>Не подменяйте одно событие другим только потому, что нужный фильтр проще найти. Для очистки записей, созданных за квартал, используйте дату создания. Для отбора по завершению проверьте соответствующее поле и его заполнение в вашей CRM; несколько карточек сопоставьте с историей работы. Неправильно заполненная дата делает даже аккуратно настроенный фильтр ненадёжным.</p>

  </section>

  <section aria-labelledby="delete-from-list">

    <h2 id="delete-from-list">Как удалить проигранные сделки <span data-heading-accent>через список Битрикс24</span></h2>

    <p>Штатный список позволяет удалить сразу несколько выбранных записей. Общий порядок — отфильтровать сделки, выделить нужные строки и нажать «Удалить». Для выбора записей на всех страницах предусмотрен флажок «Для всех». Операция требует прав на удаление. <a href="https://helpdesk.bitrix24.ru/open/21064250/" target="_blank" rel="noopener noreferrer">Инструкция Битрикс24.</a></p>

    <InlineConsultation
      variant="product"
      title="Отбор согласован — переходите к очистке"
      description="В CRM Cleaner можно познакомиться со сценарием отбора сделок по воронке, стадии, ответственному и датам. Перед очисткой важно согласовать исключения и сохранить нужную историю. На странице приложения доступно демо; удаление настоящих записей пока не включено."
      href={cleanerHref}
      actionLabel="Посмотреть CRM Cleaner"
    />


    <p>Применим этот порядок к очистке по стадии:</p>

    <Checklist items={deletionSteps} label="Порядок удаления проигранных сделок через список" />

    <p>Не используйте «Для всех», если нужные исключения существуют только в вашей голове. Когда часть карточек нужно сохранить, безопаснее сузить условия до полностью подходящей группы либо вручную выбрать небольшую партию. Не рассчитывайте, что массовая операция сама распознает сделки, которые вы решили оставить.</p>

    <p>Перед большой очисткой сохраните перечень согласованных записей с ID и ключевыми полями — например, отдельной выгрузкой, если она доступна на вашем портале. Такой перечень поможет сверить результат и разобраться в расхождениях. Однако таблицу с полями нельзя считать полной резервной копией переписки, файлов и всех связей CRM.</p>

    <p>Если очистку выполняете впервые, начните с небольшой проверенной группы. После удаления посмотрите, остались ли на месте контрольные сделки, которые вы специально исключили. Такой подход проверяет не только исчезновение ненужных карточек, но и сохранность нужных.</p>

  </section>

  <section aria-labelledby="crm-cleanup">

    <h2 id="crm-cleanup">Когда подходит <span data-heading-accent>встроенная очистка CRM</span></h2>

    <p>В Битрикс24 есть отдельный инструмент для освобождения места. Он находится в разделе CRM → Ещё → Настройки → Настройки CRM → Другое → Чем занято место. После сканирования можно выбрать очистку сделок и ограничить её датой создания и группой стадий. Этот сценарий описан в <a href="https://helpdesk.bitrix24.ru/open/26995556/" target="_blank" rel="noopener noreferrer">инструкции «Как освободить место в CRM»</a>.</p>

    <p>Встроенная очистка подходит, когда её условия точно совпадают с вашей задачей. Например, компания согласовала удаление всех неуспешных сделок, созданных за определённый период. Но если среди них есть исключения по конкретной причине отказа или отдельным клиентам, сначала убедитесь, что выбранный инструмент позволяет выразить эти ограничения. Иначе переходите к более точному отбору через список.</p>

    <p>Удаление самой сделки и очистка её дел и истории — разные операции. Выбирайте действие по цели: сохранение карточки без нужной истории может оказаться столь же нежелательным результатом, как удаление карточки целиком. Также учтите, что записи в корзине продолжают занимать место до окончательного удаления. <a href="https://helpdesk.bitrix24.ru/open/26995556/" target="_blank" rel="noopener noreferrer">Описание вариантов очистки.</a></p>

  </section>

  <section aria-labelledby="check-result">

    <h2 id="check-result">Что проверить <span data-heading-accent>после удаления</span></h2>

    <p>Повторите исходный поиск и сопоставьте результат со своим перечнем. Если часть записей осталась, сначала выясните причину: возможно, выбрали только одну страницу, не хватило прав или данные изменились во время работы. Не расширяйте фильтр только ради того, чтобы получить пустой список.</p>

    <p>Проверьте отдельно несколько сделок, которые требовалось сохранить: например, отказы с обещанием вернуться и записи из другой воронки. При наличии интеграций проверьте также результат в связанных системах. Исчезновение карточки из Битрикс24 само по себе не подтверждает, что внешняя система обработала изменение так, как вы ожидали.</p>

    <p>Если обнаружили ошибку, откройте CRM → Ещё → Корзина. Возможность восстановления зависит от тарифа, а попадание элементов в корзину — от настроек. Официальная справка указывает срок хранения до 30 дней с последующим постепенным удалением; использовать задержку как гарантированный запас времени не стоит. У восстановленного элемента меняется ID, поэтому прежняя ссылка на карточку перестанет работать. <a href="https://helpdesk.bitrix24.ru/open/24668648/" target="_blank" rel="noopener noreferrer">Что такое корзина в CRM.</a></p>

  </section>

  <section aria-labelledby="filter-workflow">

    <h2 id="filter-workflow">Удаление <span data-heading-accent>по фильтрам</span> как отдельная рабочая задача</h2>

    <p>Для разовой очистки проверенной группы может хватить штатного списка. Если к удалению приходится возвращаться регулярно, полезно закрепить единый порядок: определить условия, проверить отбор, согласовать исключения и только после этого запускать операцию. Тогда каждый сотрудник понимает, что именно считается ненужной записью.</p>

    <p>Наше ПО для удаления по фильтрам в Битрикс24 предназначено для такой задачи — очистки выбранной части CRM. Перед использованием сопоставьте доступные условия отбора с вашим сценарием: какие сделки нужно удалить и какие обязательно сохранить. Приложение помогает выполнить операцию, а решение о ценности истории остаётся за командой.</p>

    <p>Если вы уже определили, какие проигранные сделки можно убрать, следующий шаг — подобрать для них условия удаления. Обсудим ваш сценарий и сопоставим его с доступными возможностями ПО до начала очистки.</p>

    <p>Для очистки другой части CRM пригодится отдельная инструкция: <a href={`${base}bitrix24-udalenie-lidov-za-period/`}>как удалить старые лиды за выбранный период</a>. У лидов и сделок различаются стадии и контекст работы, поэтому проверяйте их отдельными выборками.</p>

