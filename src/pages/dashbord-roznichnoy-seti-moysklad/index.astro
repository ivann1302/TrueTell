---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import matrixImage from '../../images/articles/moysklad-network-matrix-093.png';
import drilldownImage from '../../images/articles/moysklad-network-drilldown-093.png';

const article = getArticle('dashbord-roznichnoy-seti-moysklad/');
const { title, description } = article;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const canonicalPath = `/${article.hrefPath}`;
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const imageAlt = 'Учебная матрица для сети: два магазина, один товар, продажи за день и остаток на конец дня';
const ogImage = new URL(matrixImage.src, siteRoot).toString();
const titleParts = [{ text: 'Дашборд розничной сети: ' }, { text: 'магазин × товар × день', accent: true }];
const metricRows = [
  ['Продажи и возвраты', 'Розничные документы и позиции', 'День операции × точка × товар; возврат показывать отдельно'],
  ['Остаток на конец дня', 'Проведённые движения и срез на дату', 'Склад × товар × день, одна согласованная граница суток'],
  ['Чеки и средний чек', 'Розничные продажи', 'Точка × день; не суммировать средние по магазинам'],
  ['Дни с нулевым остатком', 'Проверенная история ежедневных срезов', 'Считать подтверждённые нули; пустую строку не считать нулём'],
];
const faqItems = [
  { question: 'Какие показатели нужны директору розничной сети?', answer: 'Для первого экрана достаточно продаж и возвратов по точкам, числа чеков и среднего чека, остатка на конец дня и списка товаров с нулевым остатком. Каждый показатель должен иметь определение и время обновления; детали открываются по магазину, товару и дню.' },
  { question: 'Можно ли собрать всё одним отчётом МойСклад?', answer: 'МойСклад уже показывает продажи, смены и остатки в своих разделах. Для одной таблицы с продажами и остатком по каждому магазину, товару и дню обычно готовят отдельный слой данных и согласуют соответствие точки продаж складу. Сначала проверьте, что нужного разреза нет в ваших штатных отчётах.' },
  { question: 'Как связать продажи с остатками и не удвоить сумму?', answer: 'Сначала агрегируйте товарные позиции продаж и возвратов до ключа «магазин × товар × день». Отдельно получите один остаток по тому же товару и складу на конец дня. Проверьте соответствие точки складу на эту дату: если две точки используют общий склад, запас нельзя приписать каждой и сложить. Показывайте такой запас отдельно либо по подтверждённому правилу распределения.' },
  { question: 'Нулевой остаток означает упущенные продажи?', answer: 'Нет. Подтверждённый нуль на конец дня показывает состояние на выбранный момент. Отсутствующая строка в истории не равна нулю. Даже доказанный нуль не говорит, сколько покупателей хотели купить товар и когда запас закончился; для оценки спроса нужна отдельная методика.' },
  { question: 'Почему вчерашний график может измениться?', answer: 'Розничную продажу, возврат или складской документ могли изменить задним числом, а выгрузка могла обновиться позже штатного отчёта. Сравните время снимка, фильтры и ID документов, затем пересчитайте затронутые даты.' },
];
const sourceLinks = [
  { label: 'Розница: точки, смены и отчёты — справка МойСклад', href: 'https://support.moysklad.ru/hc/ru/касса%20и%20розница/розница/розница_обзор_возможностеи' },
  { label: 'Контроль продаж по точке и периоду — справка МойСклад', href: 'https://support.moysklad.ru/hc/ru/касса%20и%20розница/работа%20в%20кассе/контроль_работы_кассиров' },
  { label: 'Отчёт «Остатки» — справка МойСклад', href: 'https://support.moysklad.ru/hc/ru/товары%20и%20склады/остатки%20и%20себестоимость/отчет_остатки' },
  { label: 'Шаблоны списка розничных продаж — справка МойСклад', href: 'https://support.moysklad.ru/hc/ru/шаблоны/шаблоны%20по%20категориям/список_розничных_продаж' },
];
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const structuredData = createArticleStructuredData({
  articleType: 'BlogPosting', title, description, articleUrl, publishedDate: article.publishedAt,
  modifiedDate: article.updatedAt, publisherUrl: siteRoot.toString(), image: ogImage, author: authorName,
  breadcrumbs: [
    { name: 'Главная', item: siteRoot.toString() },
    { name: 'Блог', item: new URL('blog/', siteRoot).toString() },
    { name: title, item: articleUrl },
  ], faqItems,
});
---

<ArticleLayout {title} {titleParts} {description} {canonicalPath} {structuredData}
  ogTitle={article.seoTitle} ogDescription={description} {ogImage} ogImageAlt={imageAlt}
  category={article.category} author={authorName}
  intro="Показываем, какие вопросы должен закрывать дашборд сети и как свести продажи и остатки к одной строке без ложных выводов.">
  <Fragment slot="quick-answer">
    <p>Для дашборда сети полезна строка <strong>«магазин × товар × день»</strong>: продажи и возвраты за день рядом с остатком на его конец. Начните с фильтров по точке, периоду и товару, а из итогов дайте переход к исходным документам.</p>
    <p>Перед соединением данных агрегируйте продажи и остатки отдельно до одного ключа и согласуйте связь точки продаж со складом. Нулевой остаток на конец дня отмечает возможный риск, но сам по себе не доказывает упущенные продажи.</p>
  </Fragment>

  <p data-article-lead>У сети два магазина. Оба продают один товар, но в первом вечером остаток ноль, а во втором — восемь штук. Руководителю нужен ответ: где проверить пополнение и чем объясняется разница продаж. Такой вопрос теряется в отдельном отчёте по чекам и отдельном отчёте по остаткам. Дашборд соединяет показатели, сохраняя возможность открыть документы, из которых они получены.</p>
  <ArticleFigure src={matrixImage} fullSize portrait alt={imageAlt} caption="Учебный макет, не снимок готового продукта: у каждого магазина свой склад. Магазин А продал 4 штуки и закончил день с нулём; магазин Б продал 2 и закончил с 8. Нуль требует проверки движения и спроса, но не означает четыре или любое другое число упущенных продаж." />

  <section aria-labelledby="questions">
    <h2 id="questions">Какие вопросы вынести на первый экран</h2>
    <p>Покажите продажи и возвраты сети за выбранный период, динамику по дням и сравнение магазинов. Рядом — число чеков и средний чек с одинаковой формулой для всех точек. Для товарного ряда добавьте продажи в штуках, остаток на конец дня и дни, когда он был нулевым. Обязательно укажите момент обновления каждого источника: быстрый график с устаревшим остатком может вести к неверному решению.</p>
    <DataTable label="Источники показателей дашборда розничной сети" columns={['Показатель', 'Исходные данные', 'Уровень и правило']} rows={metricRows} rowHeaders compact />
    <p>Средний чек сети считайте как общую сумму чеков продаж, делённую на общее число таких чеков. Складывать средние чеки магазинов нельзя: магазин с десятью и магазин со ста чеками имели бы одинаковый вес. Формулы для чеков и смешанных оплат разобраны <a href={`${base}analiz-chekov-moysklad/`}>отдельно</a>.</p>
  </section>

  <section aria-labelledby="grain">
    <h2 id="grain">Как получить строку «магазин × товар × день»</h2>
    <p>Начните с таблицы позиций розничных продаж: один товар в одном документе. Определите дату операции в одном часовом поясе, точку продаж и идентификатор товара или модификации. Возвраты соберите отдельно по дате возврата; не теряйте ссылку на исходную продажу. Сгруппируйте продажи и возвраты по ключу «точка × товар × день», получив количества и суммы.</p>
    <p>Остаток на конец дня рассчитывается по проведённым складским движениям для конкретного склада и товара. Сверяйте один уровень номенклатуры: если продажи разделены по модификациям, остаток тоже нужен по модификациям, а не только итог по базовому товару. Проверьте связь точки со складом на дату операции. Если две точки используют общий склад, показывайте запас отдельно на уровне склада: приписывать его каждой точке и суммировать нельзя. Распределять запас между точками можно лишь по подтверждённому правилу учёта. Историю ежедневных срезов и влияние документов задним числом мы разбираем в статье <a href={`${base}ostatki-moysklad/`}>об остатках МойСклад</a>.</p>
    <p>Теперь соедините два набора на согласованном ключе. Если к одной строке остатков напрямую присоединить несколько позиций чеков, остаток повторится и сумма по сети станет неверной. Сначала убедитесь, что в каждом наборе на ключ приходится не больше одной строки. Сформируйте полную сетку нужных дат и товаров: товары без продаж сохраняйте, а отсутствие строки остатка не превращайте автоматически в ноль. Нулевой день засчитывайте после проверки исходных движений и правил отчёта.</p>
  </section>

  <section aria-labelledby="zero">
    <h2 id="zero">Что означает нулевой остаток</h2>
    <p>Подтверждённый нуль на конец дня — факт о выбранном моменте, если исходные движения полны и корректны. Он не показывает, в котором часу товар закончился и сколько покупателей ушло без покупки. Отсутствие продаж при нулевом остатке тоже не доказывает спрос. Пометьте день как повод открыть складские движения, продажи соседних точек, заказы и правила пополнения.</p>
    <ArticleFigure src={drilldownImage} fullSize portrait alt="Учебный путь проверки: нулевой остаток в магазине, документы движения, сравнение соседней точки и решение о пополнении" caption="Редакционная схема проверки, не готовый интерфейс TrueTell. От нулевого остатка переходят к документам и сопоставляют дату, товар и склад; оценка упущенного спроса требует дополнительной модели." />
    <p>Если захотите оценить риск дефицита, сначала задайте наблюдаемые признаки: сколько дней товар был недоступен, были ли заказы без выполнения, продавался ли он в похожей точке. Упущенную выручку можно оценивать только с оговорками к модели и качеству данных. Не добавляйте в дашборд точную цифру «потеряли X ₽» из одного нулевого среза.</p>
  </section>

  <section aria-labelledby="verify">
    <h2 id="verify">Как проверить дашборд до запуска</h2>
    <p>Возьмите один день, один магазин и два товара. Сумму продаж сверьте со списком розничных продаж по точке и периоду, возвраты — с их документами. Остаток на конец дня сравните с отчётом «Остатки» на ту же дату, при том же складе и определении «остаток» или «доступно». Затем пересчитайте итог сети из строк и убедитесь, что число чеков не выросло из-за соединения с товарными позициями.</p>
    <p>Зафиксируйте, когда были обновлены продажи и история остатков. Если вчерашний день изменился после исправления документа, сохраните причину и <a href={`${base}proverka-dannyh-moysklad-posle-vygruzki/`}>проверьте расхождение по ID</a>. Только после такой сверки имеет смысл расширять первый экран на всю сеть.</p>
    <InlineConsultation title="Нужен один экран для магазинов?" description="Определим показатели директора, сверим связь точек со складами и проверим один день до построения общей таблицы." />
  </section>

  <FaqSection id="faq" variant="article" title="Частые вопросы" items={faqItems} />
  <ArticleSources publishedIso={article.publishedAt} modifiedIso={article.updatedAt} sources={sourceLinks} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Начните дашборд ' }, { text: 'с проверяемых строк', accent: true }]}
      description="TrueTell разрабатывает подготовку данных МойСклад для аналитики. Обсудим ключ «магазин × товар × день», источники и сверку показателей; готовый экран не обещаем до проверки данных и интеграции."
      href={companyInfo.contacts.consultationUrl} actionLabel="Обсудить задачу" />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <Fragment slot="after-article"><ConsultationCtaSection /></Fragment>
</ArticleLayout>
