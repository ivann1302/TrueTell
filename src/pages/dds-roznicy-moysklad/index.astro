---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import eventsImage from '../../images/articles/moysklad-dds-events-093.png';
import reconcileImage from '../../images/articles/moysklad-dds-reconcile-093.png';

const article = getArticle('dds-roznicy-moysklad/');
const { title, description } = article;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const canonicalPath = `/${article.hrefPath}`;
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const imageAlt = 'Условный пример: чек на 10 000 рублей, наличные 2 000, оплата картой 8 000, комиссия 160 и внутренний перевод';
const ogImage = new URL(eventsImage.src, siteRoot).toString();
const titleParts = [
  { text: 'ДДС для розницы в МойСклад: ' },
  { text: 'как не посчитать выручку дважды', accent: true },
];
const documentRows = [
  ['Чек или розничная продажа', 'Факт реализации и сумма продажи', 'Не прибавлять к платежам как ещё одно поступление денег'],
  ['Приходный ордер, входящий платёж', 'Денежное поступление в кассу или на счёт', 'Проверить основание, закрытие смены и повтор из банковской выписки'],
  ['Расходный ордер, исходящий платёж', 'Выплата или перемещение из кассы и счёта', 'Отделить внешний расход от перевода между своими счетами'],
  ['Корректировка остатка', 'Изменение учётного баланса денег', 'Проверить причину; не называть автоматически продажей'],
];
const faqItems = [
  { question: 'Почему ДДС в МойСклад не равен выручке?', answer: 'ДДС строится по денежным документам и корректировкам за период, а выручка связана с продажей. Карточная оплата может поступить за вычетом комиссии и в другой день; авансы и возвраты денег тоже меняют поток. Сначала сверяйте определения и даты, затем отдельные документы.' },
  { question: 'Нужно ли складывать чек и входящий платёж по закрытию смены?', answer: 'Нет, если входящий платёж отражает оплату того же чека. Чек показывает продажу, платёж — поступление. Для ДДС берите денежное событие и сверяйте его с чеком; для выручки используйте продажу с правилами возвратов.' },
  { question: 'Как учитывать перевод между своими счетами?', answer: 'Внутренний перевод создаёт списание и зачисление. Для потока денег компании извне и вовне эти две стороны дают ноль; для остатков отдельных касс и счетов обе стороны важны. Свяжите документы перевода, прежде чем группировать поступления и расходы.' },
  { question: 'Почему эквайринг даёт сумму меньше карточных продаж?', answer: 'При настройке автоматического входящего платежа на закрытии смены МойСклад может создать учётный платёж на сумму оплат по эквайрингу за вычетом комиссии. Например, 8 000 ₽ карточных оплат и 160 ₽ комиссии дают 7 840 ₽ в таком документе. Фактическое зачисление проверьте по банковской выписке.' },
  { question: 'Можно ли использовать ДДС по дням для контроля касс?', answer: 'Да: откройте «Деньги → Движение денежных средств → По дням», задайте период и проверьте приход, расход и баланс по банку и кассе. При расхождении откройте детализацию конкретного дня и найдите денежный документ или корректировку.' },
];
const sourceLinks = [
  { label: 'Движение денежных средств — справка МойСклад', href: 'https://support.moysklad.ru/hc/ru/отчеты/движение_денежных_средств' },
  { label: 'Как перемещать деньги внутри компании — справка МойСклад', href: 'https://support.moysklad.ru/hc/ru/деньги/как_перемещать_деньги_внутри_компании' },
  { label: 'Автоматическое вычисление комиссии банка-эквайера — справка МойСклад', href: 'https://support.moysklad.ru/hc/ru/касса%20и%20розница/работа%20в%20кассе/настроика_автоматического_вычисления_комиссии_банка_экваиера' },
  { label: 'Открытие и закрытие смены в кассе — справка МойСклад', href: 'https://support.moysklad.ru/hc/ru/касса%20и%20розница/работа%20в%20кассе/открытие_и_закрытие_смены_в_кассе' },
  { label: 'Создание и настройка точки продаж — справка МойСклад', href: 'https://support.moysklad.ru/hc/ru/касса%20и%20розница/розница/создание_и_настроика_точки_продаж' },
];
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const structuredData = createArticleStructuredData({
  articleType: 'BlogPosting', title, description, articleUrl, publishedDate: article.publishedAt,
  modifiedDate: article.updatedAt, publisherUrl: siteRoot.toString(), image: ogImage, author: authorName,
  breadcrumbs: [
    { name: 'Главная', item: siteRoot.toString() },
    { name: 'Блог', item: new URL('blog/', siteRoot).toString() },
    { name: title, item: articleUrl },
  ], faqItems,
});
---

<ArticleLayout {title} {titleParts} {description} {canonicalPath} {structuredData}
  ogTitle={article.seoTitle} ogDescription={description} {ogImage} ogImageAlt={imageAlt}
  category={article.category} author={authorName}
  intro="Разделяем продажу и движение денег, проверяем эквайринг, закрытие смены и переводы между своими счетами на условном примере.">
  <Fragment slot="quick-answer">
    <p>В МойСклад отчёт <strong>Деньги → Движение денежных средств</strong> собирает платежи и корректировки, а чек фиксирует продажу. При построении собственного ДДС не складывайте чек с входящим платежом, который отражает его оплату.</p>
    <p>Переводы между своими кассами и счетами показывайте в остатках каждого места хранения денег, но исключайте из притока извне. Эквайринг проверяйте по настройкам точки: поступление может быть меньше карточной оплаты на комиссию.</p>
  </Fragment>

  <p data-article-lead>В конце дня магазин видит 10 000 ₽ продаж, 2 000 ₽ наличных и учётный входящий платёж в МойСклад на 7 840 ₽. Если сложить все три числа, получится 19 840 ₽, хотя покупатели заплатили 10 000 ₽. Дублирование появляется потому, что чек и платёж описывают разные стороны одной операции. В ДДС нужно выбрать денежные события и объяснить разницу с продажами.</p>
  <ArticleFigure src={eventsImage} fullSize portrait alt={imageAlt} caption="Учебный пример с включённым созданием ПКО и входящего платежа при закрытии смены. 10 000 ₽ — продажа; 9 840 ₽ — учётный приток извне после комиссии. Внутренний перевод не меняет общий остаток компании." />

  <section aria-labelledby="difference">
    <h2 id="difference">Что показывает отчёт ДДС в МойСклад</h2>
    <p>Откройте <strong>Деньги → Движение денежных средств</strong>. Вариант <strong>«По дням»</strong> показывает приход, расход и баланс отдельно по банку и кассе, а также общий итог. Нажатие на день открывает детали. По <a href={sourceLinks[0].href} target="_blank" rel="noopener noreferrer">официальной справке</a>, в отчёт попадают приходные и расходные ордера, входящие и исходящие платежи, а также корректировки за выбранный период.</p>
    <DataTable label="Роль документов в отчёте продаж и ДДС" columns={['Запись', 'Что показывает', 'Риск при объединении']} rows={documentRows} rowHeaders compact />
    <p>Сравнивайте денежный отчёт с отчётом о продажах по одному дню или одной смене, но не требуйте совпадения без проверки оснований. Выручка, кассовый остаток и сумма, дошедшая до банка, отвечают на разные вопросы. Для прибыли с себестоимостью и расходами используйте <a href={`${base}otchety-moysklad/`}>разбор штатных отчётов</a>.</p>
  </section>

  <section aria-labelledby="example">
    <h2 id="example">Пример: чек, комиссия и перевод</h2>
    <p>В условном примере включены настройки создания приходного кассового ордера и входящего платежа при закрытии смены. Один чек на 10 000 ₽ оплачен 2 000 ₽ наличными и 8 000 ₽ картой. Комиссия эквайринга — 160 ₽, поэтому учётный входящий платёж на счёт равен 7 840 ₽. Наличные 2 000 ₽ остаются в кассе. Затем 1 000 ₽ из кассы перевели на свой банковский счёт. Начальные остатки и другие операции здесь равны нулю.</p>
    <p>Внутренний перевод создаёт два документа: списание и внесение. В инструкции МойСклад это <a href={sourceLinks[1].href} target="_blank" rel="noopener noreferrer">расходный ордер и входящий платёж</a>. В отчёте по конкретной кассе и счёту обе стороны нужны. В управленческом ДДС компании отфильтруйте их как внутреннее движение, чтобы не раздуть общий приход и расход.</p>
    <p>После операций учётный остаток кассы в модели равен 1 000 ₽, учётный остаток счёта — 8 840 ₽. Вместе это 9 840 ₽: 10 000 ₽ оплаты покупателей минус 160 ₽ комиссии. Фактическое поступление по банковской выписке сверяйте отдельно: у него может быть другая дата. Не подгоняйте даты документов ради равенства одного дня.</p>
  </section>

  <section aria-labelledby="closing">
    <h2 id="closing">Как закрытие смены связано с платежом</h2>
    <p>В настройках точки продаж можно включить создание входящего платежа при закрытии смены. Для Кассы МойСклад описана также настройка автоматического расчёта комиссии: платёж создаётся на сумму оплат по эквайрингу за вычетом комиссии. Это зависит от конфигурации точки; проверьте фактически созданный документ и его основание.</p>
    <p>Закрытие смены не является вторым покупателем. Если в выгрузке есть продажа, смена и созданный на её основании платёж, связывайте их, а не суммируйте как три независимых поступления. При импорте банковской выписки проверьте, не появился ли второй документ на то же зачисление. Номер, сумма, дата и счёт помогают найти пару; при несовпадении откройте исходный документ.</p>
  </section>

  <section aria-labelledby="reconcile">
    <h2 id="reconcile">Как сверить один день без двойного счёта</h2>
    <p>Начните с одной точки и одной закрытой смены. Запишите продажи и возвраты отдельно, затем найдите связанные приходные ордера и входящие платежи. Разложите денежные документы по основаниям: оплата покупателя, возврат покупателю, комиссия, внешний расход, внутренний перевод, корректировка. Не присваивайте основание только по знаку суммы.</p>
    <ArticleFigure src={reconcileImage} fullSize portrait alt="Сверка чека 10 000 рублей с приходным ордером 2 000 рублей, входящим платежом 7 840 рублей и внутренним переводом" caption="Условная сверка без начального остатка. Платёжные документы отражают учётное поступление 9 840 ₽ после комиссии; чек на 10 000 ₽ остаётся отдельным показателем продаж. Фактическое зачисление сверяют с банком." />
    <p>Для контрольного расчёта посмотрите общий учётный остаток денег до и после дня. Он меняется на внешние поступления минус внешние выплаты с учётом всех проведённых корректировок, влияющих на остаток. Для управленческого внешнего потока покажите корректировки отдельной строкой по согласованному правилу. Если баланс не сходится, откройте детализацию дня в ДДС и проверьте источник каждой записи: платёж другой даты, возврат или корректировка требуют разного объяснения.</p>
    <InlineConsultation title="ДДС расходится с продажами магазина?" description="Разберём одну смену и её денежные документы: основание платежа, комиссию эквайринга, внутренние переводы и дату банка." />
  </section>

  <FaqSection id="faq" variant="article" title="Частые вопросы" items={faqItems} />
  <ArticleSources publishedIso={article.publishedAt} modifiedIso={article.updatedAt} sources={sourceLinks} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Сверьте продажи ' }, { text: 'и движение денег', accent: true }]}
      description="TrueTell разрабатывает подготовку данных МойСклад для аналитики. Начните с одной смены и списка документов, которые сейчас дают расхождение; правила ДДС согласуем по источникам."
      href={companyInfo.contacts.consultationUrl} actionLabel="Обсудить задачу" />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <Fragment slot="after-article"><ConsultationCtaSection /></Fragment>
</ArticleLayout>
