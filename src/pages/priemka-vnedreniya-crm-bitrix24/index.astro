---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { fieldDirectoryProduct, fieldDirectoryProductPath, mcpProduct } from '../../config/products';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import formListImage from '../../images/articles/bitrix24-crm-form-list-native-137.png';
import reportImage from '../../images/articles/bitrix24-sales-report-native.png';

const article = getArticle('priemka-vnedreniya-crm-bitrix24/');
const { title, description } = article;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const ogImage = new URL(reportImage.src, siteRoot).toString();
const imageAlt = 'Подлинный экран отчёта Битрикс24 «Вклад в продажи» с фильтром отчётного периода и обезличенными показателями';
const formImageAlt = 'Подлинный экран CRM-форм Битрикс24 тестового портала: активная форма обратной связи и тип создаваемого элемента «Сделка»';
const faqItems = [
  { question: 'Сколько заявок нужно для приёмки CRM?', answer: 'Одна заявка показывает путь одного сценария, но не доказывает работу всех каналов. Составьте отдельные контрольные случаи для каждого важного канала и ветки маршрутизации. В каждом сохраняйте ID карточки, время, ожидаемый и фактический результат.' },
  { question: 'Если форма отправилась, значит интеграция с CRM работает?', answer: 'Нет. После сообщения об успешной отправке найдите созданный элемент в CRM и проверьте тип, воронку, поля, ответственного и доступ сотрудника. Форма может быть настроена на лид, сделку, контакт, компанию или элемент смарт-процесса.' },
  { question: 'Можно ли проверить робота отладчиком на той же заявке?', answer: 'Отладчик Битрикс24 создаёт отдельную тестовую сделку и ведёт её лог. Он полезен для проверки условий робота, но не заменяет осмотр результата на карточке, появившейся после отправки формы.' },
  { question: 'Почему тестовая сделка не появилась в отчёте?', answer: 'Сначала уточните название отчёта и показатель, период, фильтры, воронку и права роли. В CRM-аналитике и сквозной аналитике логика «Отчётного периода» различается. Отсутствие в одном графике само по себе не доказывает потерю заявки.' },
  { question: 'Где здесь поможет MCP TrueTell?', answer: 'MCP TrueTell для настройки и диагностики CRM находится в разработке. После ручной приёмки можно обсудить, какие проверки стоит подготовить для дальнейшей диагностики и какие права для этого потребуются. Автоматическую приёмку проекта или готовую подписку мы пока не заявляем.' },
];
const sourceLinks = [
  { label: 'Битрикс24: CRM-формы — начало работы', href: 'https://helpdesk.bitrix24.ru/open/28809760/' },
  { label: 'Битрикс24: отладчик роботов на тестовой сделке', href: 'https://helpdesk.bitrix24.ru/open/19361194/' },
  { label: 'Битрикс24: отчётный период в CRM', href: 'https://helpdesk.bitrix24.ru/open/11162430/' },
  { label: 'Битрикс24: вопросы CRM-аналитики и сквозной аналитики', href: 'https://helpdesk.bitrix24.ru/open/27273254/' },
];
const acceptanceRows = [
  ['Вход', 'Внешняя форма отправлена; записаны время и контрольная метка', 'Сообщение формы и время отправки'],
  ['Карточка', 'Найден ID элемента нужного типа, в нужной воронке и с согласованными полями', 'Ссылка на карточку и проверенные поля'],
  ['Работа команды', 'Ответственный назначен по правилу; сотрудник видит карточку и следующий шаг', 'Имя роли, ответственный, дело или иное действие'],
  ['Автоматизация', 'Условие сработало на этой карточке и виден ожидаемый результат', 'Фактическое изменение, дело или запись в истории'],
  ['Отчёт', 'Контрольный показатель проверен с записанными фильтрами и правами', 'Название отчёта, метрика, период, фильтры, снимок результата'],
];
const structuredData = createArticleStructuredData({
  articleType: 'Article', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  breadcrumbs: [{ name: 'Главная', item: siteRoot.toString() }, { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() }, { name: title, item: articleUrl }],
  faqItems,
});
---
<ArticleLayout {title} titleParts={[{ text: 'Как принять настройку CRM Битрикс24: ' }, { text: 'от тестовой заявки до отчёта', accent: true }]} {description}
  canonicalPath={`/${article.hrefPath}`} {structuredData} ogTitle={article.seoTitle} ogDescription={description}
  {ogImage} ogImageAlt={imageAlt} category={article.category} author={authorName}
  intro="Интегратор показал работающую воронку, а менеджеры готовы принимать заявки. До запуска проследите путь одного обращения: от формы на сайте до карточки, действий сотрудника и выбранного показателя отчёта.">
  <Fragment slot="quick-answer">
    <p><strong>Отправьте тестовую заявку с внешней стороны и пройдите по её ID через CRM.</strong> Сверьте тип элемента, воронку, поля, ответственного, доступ менеджера и результат нужного робота. Затем откройте конкретный отчёт и запишите его показатель, период и фильтры. Каждый шаг отмечайте как «совпало» или «нужна правка».</p>
    <p>Так принимают один маршрут. Для других каналов и условий назначения нужны свои контрольные случаи.</p>
  </Fragment>

  <p data-article-lead>Фраза «CRM настроена» мало помогает в день запуска. Нужен ответ на простой вопрос: что произойдёт с обращением клиента после отправки? Запишите ожидаемый результат каждого шага и проверьте его на контрольной заявке. После исправления этот же сценарий можно повторить.</p>

  <section aria-labelledby="scenario">
    <h2 id="scenario">Сначала опишите <span data-heading-accent>ожидаемый маршрут</span></h2>
    <p>Выберите один важный канал — например, форму обратной связи. До теста запишите, какой элемент она должна создать: лид, сделку или другой тип; в какую воронку и стадию он попадёт; кто получит карточку; что должен сделать робот; какой показатель руководитель проверит в отчёте. Битрикс24 позволяет форме создавать разные элементы CRM, а для сделки указывать воронку. Поэтому название «лид» в акте приёмки без проверки настройки может сбить команду с толку.</p>
    <p>Используйте уникальную контрольную метку в названии или поле, если это допускает ваша форма. Проводите тест с согласованными демо-данными, без контактов реального клиента. Зафиксируйте время отправки, ссылку на форму и ожидаемый результат. Если маршрут зависит от источника, региона или выбранной услуги, добавьте по отдельному случаю для каждой важной ветки.</p>
    <ArticleFigure src={formListImage} fullSize alt={formImageAlt} caption="Снимок тестового портала сделан 31.10.2026; дата 06.08.2026 внутри строки относится к активности формы. В списке видно, что «Форма обратной связи» создаёт сделку. Поступление самой заявки проверяют по карточке." />
  </section>

  <section aria-labelledby="trace">
    <h2 id="trace">Отправьте форму и <span data-heading-accent>найдите ту же карточку</span></h2>
    <p>Отправьте форму так, как её заполнит посетитель сайта. После сообщения об успехе найдите в CRM именно контрольную метку, запишите ID элемента и откройте карточку. Сравните тип, воронку, стадию и критичные поля с ожидаемым маршрутом. Если карточки нет, не переходите сразу к отчёту: разберите путь формы по инструкции <a href={`${base}crm-forma-ne-sozdaet-zayavku-bitrix24/`}>«CRM-форма не создаёт заявку»</a>.</p>
    <p>Попросите будущего ответственного открыть эту карточку под своей учётной записью. Так проверяется не только назначение, но и возможность реально работать с обращением. Если карточка видна администратору, а менеджеру нет, используйте <a href={`${base}ne-vidno-sdelku-bitrix24-prava/`}>проверку прав на сделку</a>. Если назначен другой человек, сверяйте правило формы и очередь из статьи <a href={`${base}ne-tot-otvetstvennyy-bitrix24/`}>о неверном ответственном</a>.</p>
    <DataTable label="Критерии приёмки одного маршрута заявки" columns={['Контрольная точка', 'Что должно совпасть', 'Что сохранить']} rows={acceptanceRows} rowHeaders />
    <p>Сохраните в акте только нужные доказательства: ID, время, роль проверяющего, ожидание и факт. Для исправления достаточно ссылки на карточку в закрытом рабочем журнале; не переносите в общий документ телефон или переписку клиента.</p>
  </section>

  <section aria-labelledby="automation">
    <h2 id="automation">Проверьте действие робота <span data-heading-accent>на этой заявке</span></h2>
    <p>Если по сценарию робот должен поставить дело, изменить поле или передать сделку, смотрите фактический результат на найденной карточке и время его появления. Учитывайте условия и задержку, заданные в настройке. Если результата нет, передайте интегратору ID, стадию, ожидаемое действие и время проверки. Подробный разбор есть в статье <a href={`${base}robot-ne-srabatyvaet-bitrix24/`}>«Робот не срабатывает»</a>.</p>
    <p>Отладчик Битрикс24 полезен для отдельной проверки логики: он создаёт собственную тестовую сделку и показывает журнал действий роботов. Его успешный лог нельзя выдавать за доказательство того, что робот выполнился на заявке из формы. В акте помечайте эти два теста отдельно.</p>
    <p>Если маршрут зависит от пользовательских полей, сверьте видимое название и технический код нужного поля с заданием интеграции. Для поиска кодов и экспорта списка полей можно использовать наше приложение <a href={`${base}${fieldDirectoryProductPath.replace(/^\//, '')}`}>{fieldDirectoryProduct.name}</a>. Оно помогает проверить структуру полей; прохождение заявки по маршруту подтверждается самой карточкой и результатами действий.</p>
  </section>

  <section aria-labelledby="report">
    <h2 id="report">В отчёте проверьте <span data-heading-accent>один согласованный показатель</span></h2>
    <p>Заранее выберите название отчёта и метрику. Например, руководитель хочет убедиться, что проверенная сделка учитывается в определённом срезе CRM-аналитики. Откройте этот отчёт под согласованной ролью, запишите период, воронку и остальные фильтры. Сверьте ID карточки с тем, что измеряет показатель. Если показатель агрегированный, не выводите из одного графика судьбу отдельной заявки без перехода к списку элементов.</p>
    <ArticleFigure src={reportImage} fullSize alt="Подлинный экран отчёта Битрикс24 «Вклад в продажи» с фильтром отчётного периода и показателями менеджера; персональные данные закрыты" caption="Подлинный экран отчёта Битрикс24 из редакционного архива TrueTell. Данные на нём обезличены; он показывает расположение фильтра и показателей, а не результат теста заявки из этой статьи." />
    <p>У «Отчётного периода» нет единой логики для всех инструментов: в CRM-аналитике Битрикс24 он учитывает работу со сделкой в периоде, а в сквозной аналитике отбирает по дате создания. Права роли тоже влияют на видимость данных. Поэтому сначала уточните, что именно показывает выбранный отчёт, и только потом называйте расхождение ошибкой. Порядок сверки описан в статье <a href={`${base}otchet-crm-ne-sovpadaet-bitrix24/`}>«Отчёт CRM не совпадает»</a>.</p>
  </section>

  <section aria-labelledby="accept">
    <h2 id="accept">Закройте приёмку <span data-heading-accent>повторным тестом</span></h2>
    <p>Для каждого отклонения запишите владельца исправления и конкретный шаг, который не прошёл. После правки отправьте новую контрольную заявку по тому же маршруту: старая карточка не докажет, что новое правило теперь работает. Если тест пройден, сохраните дату, ID и ссылку на результат. Если не пройден — оставьте пункт открытым с новым фактом. Перед запуском передайте журнал менеджеру и владельцу CRM.</p>
    <p>После запуска этот маршрут становится исходной точкой для <a href={`${base}pervye-30-dney-crm-bitrix24/`}>контроля первого месяца</a> и <a href={`${base}ezhenedelnaya-diagnostika-crm-bitrix24/`}>еженедельной диагностики</a>. MCP TrueTell для настройки и диагностики CRM находится в разработке. Мы можем обсудить, какие проверки стоит подготовить для вашего процесса и какие права им понадобятся. Готовую автоматическую приёмку или условия подписки пока не заявляем.</p>
    <InlineConsultation variant="product" title="Нужен сценарий приёмки и дальнейшей диагностики CRM?" description="Опишите каналы, воронки и контрольные точки без клиентских данных. Обсудим ручную приёмку и возможную роль MCP TrueTell после запуска." href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
  </section>

  <FaqSection title="Частые вопросы о приёмке CRM Битрикс24" items={faqItems} variant="article" />
  <p>Справка Битрикс24 и интерфейс тестового портала проверены 31 октября 2026 года. Снимки показывают элементы интерфейса, а не приёмку клиентского проекта. Работа MCP TrueTell в таком сценарии и конкретные права клиентского портала здесь не проверялись.</p>
  <ArticleSources publishedIso={article.publishedAt} modifiedIso={article.updatedAt} sources={sourceLinks} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Обсудим ' }, { text: 'диагностику CRM с MCP TrueTell', accent: true }]} description={mcpProduct.articleDescription} href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <ConsultationCtaSection slot="after-article" />
</ArticleLayout>
