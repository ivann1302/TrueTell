---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { mcpProduct } from '../../config/products';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import scopeImage from '../../images/articles/crm-ai-access-scope.png';
import pilotImage from '../../images/articles/crm-ai-access-pilot.png';

const article = getArticle('bezopasnyy-dostup-ii-k-crm/');
const { title, description } = article;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const canonicalPath = `/${article.hrefPath}`;
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const ogImage = new URL(scopeImage.src, siteRoot).toString();
const imageAlt = 'Пример минимального доступа: вопрос о стадии одной сделки, нужные поля, право чтения и сверка с карточкой CRM';
const faqItems = [
  { question: 'Можно ли дать ИИ доступ к CRM через учётную запись администратора?', answer: 'Для первого теста лучше выбрать сотрудника с правами только на нужные записи и операции. Администраторский доступ расширяет последствия ошибки. В Битрикс24 внешний MCP учитывает права подключённого сотрудника; доступность тонких настроек прав зависит от тарифа и конфигурации CRM.' },
  { question: 'Достаточно написать агенту «ничего не меняй»?', answer: 'Нет. Это полезное пожелание к поведению агента, но не ограничение прав. Проверьте разрешённые инструменты и права пользователя. Если выбранное подключение не позволяет технически исключить запись, не используйте для первого опыта важные рабочие данные.' },
  { question: 'Куда вводить токен подключения?', answer: 'Только в предусмотренное поле авторизации выбранного подключения. Не отправляйте токен, пароль, API-ключ или cookie сообщением в чат и не вставляйте их в общедоступные документы и скриншоты.' },
  { question: 'Всегда ли ИИ просит подтвердить изменение в CRM?', answer: 'Нет общего правила для всех клиентов и MCP-серверов. В официальном примере Битрикс24 с ChatGPT подтверждение показано, но поведение другого клиента нужно проверить отдельно. Право на изменение ограничивают технически, а результат каждого разрешённого действия сверяют в CRM.' },
  { question: 'Как отозвать доступ внешнего ИИ в Битрикс24?', answer: 'Для отдельного подключения откройте «Приложения» → «MCP-подключения» → «Получить токен подключения» → «Мои токены» → Битрикс24 Паспорт → «MCP-подключения» и закройте доступ. Администратор может также выключить внешние AI-системы в настройках MCP. Глобальное выключение не удаляет созданные записи и сохраняет сами подключения.' },
  { question: 'Официальный Developer MCP Битрикс24 читает наши сделки?', answer: 'Нет. Он предоставляет агенту документацию REST API для разработки, но не читает данные портала и не выполняет методы CRM. Для работы с реальными сделками нужно отдельное подключение с авторизацией и правами.' },
  { question: 'Можно уже установить MCP TrueTell для Битрикс24?', answer: 'Публичную установку мы пока не заявляем: продукт в разработке. Сейчас можно описать задачу, нужные данные и желаемые ограничения доступа, чтобы обсудить сценарий и проверки до подключения.' },
];
const sourceLinks = [
  { label: 'Битрикс24: управление внешними AI-системами, права, включение и отзыв доступа', href: 'https://helpdesk.bitrix24.ru/open/26952788/' },
  { label: 'Битрикс24: настройка прав доступа к CRM', href: 'https://helpdesk.bitrix24.ru/open/23240636/' },
  { label: 'Битрикс24: рекомендации по работе с AI-агентом и секретами', href: 'https://helpdesk.bitrix24.ru/open/29122946/' },
  { label: 'Битрикс24: предупреждение о передаче данных сторонним MCP-серверам', href: 'https://www.bitrix24.ru/about/mcpdisclaimer.php' },
  { label: 'MCP: безопасность и принцип минимальных полномочий', href: 'https://modelcontextprotocol.io/docs/2026-07-28/tutorials/security/security_best_practices' },
  { label: 'MCP: подтверждение вызова инструментов зависит от клиента', href: 'https://modelcontextprotocol.io/specification/2026-07-28/server/tools' },
  { label: 'Developer MCP Битрикс24: только документация REST API', href: 'https://apidocs.bitrix24.ru/ai-tools/mcp.html' },
];
const structuredData = createArticleStructuredData({
  articleType: 'BlogPosting', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  articleSection: 'ИИ и интеграции',
  breadcrumbs: [{ name: 'Главная', item: siteRoot.toString() }, { name: 'Блог', item: new URL('blog/', siteRoot).toString() }, { name: title, item: articleUrl }],
  faqItems,
});
---
<ArticleLayout {title} titleParts={[{ text: 'Как безопасно дать ИИ ' }, { text: 'доступ к CRM', accent: true }]} {description} {canonicalPath} {structuredData}
  ogTitle={article.seoTitle} ogDescription={description} {ogImage} ogImageAlt={imageAlt}
  category={article.category} author={authorName}
  intro="Руководителю нужен ответ по сделкам, но открывать агенту всю CRM страшно. Разбираем, какой доступ нужен для первого вопроса, что проверить перед подключением и как его отключить."
>
  <Fragment slot="quick-answer">
    <p><strong>Начните с одного вопроса и минимального доступа: известная запись, нужные поля, чтение без изменений и человек, который сверит ответ с CRM.</strong></p>
    <p>Проверьте, кто разрешает подключение, какие инструменты видит агент, от чьего имени он работает и как закрыть доступ. Фраза «ничего не меняй» не заменяет техническое ограничение прав.</p>
  </Fragment>
  <p data-article-lead>Первый запрос к ИИ может звучать так: «Покажи, на какой стадии сделка № 123». Для ответа агенту нужны конкретная карточка и поле стадии. Ему не нужны экспорт всей базы, удаление лидов или права администратора. Поэтому до подключения стоит выписать нужные данные и проверить реальные права выбранного способа доступа.</p>

  <section aria-labelledby="scope">
    <h2 id="scope">Определите границу <span data-heading-accent>одного запроса</span></h2>
    <p>Запишите вопрос, источник правильного ответа и способ проверки. Для примера со стадией это ID сделки, название и стадия в карточке Битрикс24. Если ответ должен охватывать все сделки за месяц, отдельно понадобятся период, воронка, права на записи и правило подсчёта. Такой запрос не стоит выдавать за простой тест одной карточки.</p>
    <ArticleFigure src={scopeImage} fullSize portrait alt={imageAlt} caption="Редакционный пример минимального доступа для пилота: ID 123 здесь условный. Схема показывает критерий выбора прав, а не экран Битрикс24 или текущие возможности MCP TrueTell." />
    <p>Посмотрите на права конкретного сотрудника, через которого подключается агент. Официальный внешний MCP Битрикс24 работает с учётом его прав. В CRM права на чтение и изменение можно настраивать раздельно, но состав доступных настроек зависит от тарифа. Если на вашем тарифе или в выбранном подключении нельзя обеспечить нужную границу, тестируйте на безопасных данных или отложите подключение к рабочей базе.</p>
  </section>

  <section aria-labelledby="connection">
    <h2 id="connection">Проверьте <span data-heading-accent>само подключение</span></h2>
    <p>В Битрикс24 внешний доступ AI-систем через MCP по умолчанию выключен. Администратор включает его в настройках MCP; затем сотрудники могут настраивать свои подключения. Способ авторизации зависит от клиента: в официальных примерах есть OAuth и токен. Перед выдачей доступа проверьте название системы, запрошенные разрешения и сотрудника, от имени которого будут доступны данные.</p>
    <p>Инструменты подключения определяют доступные агенту действия. В одном из примеров Битрикс24 их можно выбрать по отдельности или добавить все. Для ответа о стадии сделки выбирайте только нужные инструменты чтения, если ваш клиент и сервер позволяют это сделать. Если выбор инструментов недоступен, одних слов в запросе агенту недостаточно. Пароль, токен, API-ключ и cookie не передавайте в чат: вводите секрет только в предназначенную для авторизации форму.</p>
    <p>Официальный Developer MCP Битрикс24 решает другую задачу: даёт агенту документацию REST API для разработки. Он не читает сделки и не вызывает методы клиентского портала. Если нужно сначала разобраться с самим протоколом, читайте <a href={`${base}chto-takoe-mcp/`}>простое объяснение MCP</a>.</p>
    <p>До подключения узнайте, кто управляет AI-сервисом и MCP-сервером, какие сведения из CRM к ним уходят и сохраняются ли запросы или ответы. Битрикс24 предупреждает, что сторонние MCP-серверы видят передаваемые данные и могут хранить конфиденциальную информацию. Сверьте условия обработки данных с правилами своей компании. Если они неясны, используйте контролируемую тестовую карточку без клиентских секретов и не открывайте рабочую базу.</p>
  </section>

  <section aria-labelledby="pilot">
    <h2 id="pilot">Проведите пилот <span data-heading-accent>на известной записи</span></h2>
    <p>Откройте карточку сделки сами и запишите её ID и стадию. Попросите агента показать эти значения и источник ответа. Сравните результат с карточкой. Если агент не видит запись, показывает другую сделку или уверенно заполняет отсутствующее поле, остановите пилот и разберите права и запрос. Не расширяйте доступ, пока не понятна причина расхождения.</p>
    <ArticleFigure src={pilotImage} fullSize portrait alt="Четыре этапа безопасного пилота: выбрать одну запись, проверить права, сверить ответ, закрыть или пересмотреть доступ" caption="Редакционная схема проверки, не снимок реального портала. Под «закрыть доступ» понимается отзыв конкретного подключения или отключение внешнего MCP администратором; последствия уже совершённых действий проверяют отдельно." />
    <p>В карточках CRM встречается свободный текст: комментарии, письма и заметки клиентов. Агент должен использовать их как данные, а не как команды к действию. Поэтому не просите его автоматически выполнять изменения на основании текста из записи и проверяйте источник и смысл ответа. Если позже понадобится запись в CRM, определите допустимую операцию, тестовую карточку, того, кто подтверждает действие, и способ сверки результата. В официальном примере Битрикс24 с ChatGPT подтверждение показано, но одинаковое поведение всех клиентов протокол MCP не гарантирует.</p>
  </section>

  <section aria-labelledby="revoke">
    <h2 id="revoke">Как закрыть доступ <span data-heading-accent>после теста</span></h2>
    <p>Для отдельного внешнего подключения Битрикс24 описывает путь: «Приложения» → «MCP-подключения» → «Получить токен подключения» → «Мои токены» → Битрикс24 Паспорт → «MCP-подключения» → «Закрыть доступ». После этого проверьте, что подключение больше не выполняет запросы. Отзыв доступа сам по себе не гарантирует удаления ранее переданных данных. Порядок их хранения и удаления проверьте в условиях внешнего сервиса. Названия пунктов могут отличаться при обновлении интерфейса; сверяйтесь с текущей справкой вашего портала.</p>
    <p>Администратор может выключить внешний MCP для всего портала. Это останавливает использование внешних AI-систем, но не удаляет сохранённые подключения и уже созданные элементы. Если агент что-то изменил, отдельно откройте связанные карточки и проверьте результат. Для аудита полей и качества данных пригодится наша <a href={`${base}audit-poley-crm-bitrix24/`}>инструкция по аудиту CRM</a>.</p>
    <InlineConsultation variant="product" title="Хотите обсудить безопасный первый сценарий?" description="Опишите один вопрос к вашей CRM, роль сотрудника и то, как вы сверите ответ. Мы обсудим требования к доступу для разрабатываемого MCP TrueTell." href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
  </section>

  <section aria-labelledby="before-scale">
    <h2 id="before-scale">Когда можно <span data-heading-accent>расширять сценарий</span></h2>
    <p>После удачного теста одной записи зафиксируйте, какие данные агент действительно видел, какие инструменты использовал и совпал ли ответ с CRM. Затем отдельно оцените следующую задачу: сводку по воронке, просроченные дела или изменение карточки. Для каждой нужны свои права и проверка результата. Для сложных отчётов по продажам заранее согласуйте период и показатель. Подробности есть в материале <a href={`${base}otchety-po-prodazham-bitrix24/`}>о проверке отчётов Битрикс24</a>.</p>
    <p>MCP TrueTell для Битрикс24 находится в разработке. Публичную установку, поддержку конкретного AI-клиента и готовый набор ограничений мы пока не заявляем. Пока вы можете подготовить требования к данным, правам и проверке ответа для будущего пилота.</p>
  </section>

  <FaqSection title="Частые вопросы о доступе ИИ к CRM" items={faqItems} variant="article" />
  <p>Материал сверили с документацией Битрикс24 и MCP 29 октября 2026 года. Доступ к клиентскому порталу и поведение конкретного AI-клиента для этой статьи не тестировали. Перед подключением проверьте актуальные права и интерфейс в вашей системе.</p>
  <ArticleSources publishedIso={article.publishedAt} modifiedIso={article.updatedAt} sources={sourceLinks} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Обсудим ' }, { text: 'MCP TrueTell для Битрикс24', accent: true }]} description={mcpProduct.articleDescription} href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <ConsultationCtaSection slot="after-article" />
</ArticleLayout>
