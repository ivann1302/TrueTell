---
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import Checklist from '../../components/editorial/checklist.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { cleanerProduct } from '../../config/products';
import selectionImage from '../../images/articles/bitrix24-multiple-delete-official.jpg';
import recycleImage from '../../images/articles/bitrix24-recycle-entry-official.jpg';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';

const article = getArticle('massovoe-udalenie-lidov-bitrix24/');
const { title, description } = article;
const canonicalPath = `/${article.hrefPath}`;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const cleanerHref = `${base}${article.relatedProduct!.slice(1)}`;
const imageAlt = 'Официальный пример группового удаления в CRM Битрикс24: фильтр, выбор строк, Для всех и Удалить';
const ogImage = new URL(selectionImage.src, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const titleParts = [
  { text: 'Как ' },
  { text: 'массово удалить лиды', accent: true },
  { text: ' в Битрикс24: все сразу или по фильтру' },
];
const sourceLinks = [
  { label: 'Как удалить элементы CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/23238660/' },
  { label: 'Групповые действия в CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/21064250/' },
  { label: 'Как работают фильтры в CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/24206616/' },
  { label: 'Что такое Корзина в CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/24668648/' },
  { label: 'Ролевая модель прав в CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/23240636/' },
  { label: 'Как экспортировать данные из CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/20966844/' },
  { label: 'Как освободить место в CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/26995556/' },
  { label: 'Лиды: что это и как с ними работать — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/23172742/' },
  { label: 'Место в облаке: что входит в объём базы данных — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/18354376/' },
];
const selectedSteps = [
  { title: 'Откройте CRM → Лиды', description: 'Если раздела нет, проверьте режим CRM, тариф и права на лиды. Для работы с лидами нужен классический режим; простой режим работает без них.' },
  { title: 'Переключитесь в «Список»', description: 'В этом представлении доступны групповые действия с отмеченными строками.' },
  { title: 'Отметьте нужные записи', description: 'Выделите галочками только лиды, которые собираетесь удалить.' },
  { title: 'Выберите «Удалить»', description: 'Подтвердите операцию, если Битрикс24 запросит подтверждение.' },
  { title: 'Проверьте результат', description: 'Обновите список и при необходимости откройте CRM → Ещё → Корзина.' },
];
const filterSteps = [
  { title: 'Откройте CRM → Лиды → Список', description: 'Проверьте, не остались ли условия отбора от предыдущей работы.' },
  { title: 'Настройте «Фильтр + поиск»', description: 'Задайте текущую стадию, ответственного, дату создания или другой нужный критерий. Набор полей и расширенных фильтров зависит от настроек и тарифа.' },
  { title: 'Примените фильтр и проверьте строки', description: 'Сверьте количество и несколько конкретных карточек, особенно на границе периода. Исключите лиды, которые нужно сохранить.' },
  { title: 'Выделите записи', description: 'Если нужно удалить весь отфильтрованный список, включая другие страницы, включите «Для всех». Для отдельных строк оставьте ручное выделение.' },
  { title: 'Нажмите «Удалить»', description: 'Перед запуском ещё раз сверьте состав и объём операции. Если выборка шире запланированной, остановитесь и исправьте фильтр.' },
];
const filterRows = [
  ['Убрать забракованные лиды', 'Текущее «Состояние» или стадия некачественного лида', 'Не спутать текущую стадию с историей переходов'],
  ['Удалить старые обращения', 'Дата создания и дополнительное условие по состоянию', 'Не захватить лиды, по которым продолжается работа'],
  ['Разобрать данные бывшего сотрудника', 'Ответственный и дополнительные критерии', 'Возможно, правильнее передать лиды новому менеджеру'],
  ['Убрать тестовые лиды', 'Подтверждённый признак: источник, название или специальное поле', 'Совпадение в названии не гарантирует, что запись тестовая'],
  ['Разобрать подозрительные дубли', 'Проверка совпадений и связанных данных', 'Повторяющиеся телефон или имя не доказывают, что лид лишний'],
];
const faqItems = [
  {
    question: 'Можно ли удалить сразу 100 или 1000 лидов в Битрикс24?',
    answer: 'Штатные групповые действия позволяют выбирать весь список, включая другие страницы, через «Для всех». Перед большой операцией проверьте выборку, права и возможности вашего портала. Официальные инструкции не задают здесь фиксированного предела количества удаляемых лидов и не обещают скорость обработки.',
  },
  {
    question: 'Как удалить все лиды только определённого статуса?',
    answer: 'Откройте «Список», задайте фильтр по текущей стадии или состоянию, проверьте найденные лиды, затем используйте «Для всех» и «Удалить». Не выбирайте «Состояние по истории», если нужны только лиды, которые находятся на стадии сейчас.',
  },
  {
    question: 'Можно ли удалить лиды только одного сотрудника?',
    answer: 'Используйте доступный фильтр по ответственному, проверьте результаты и удалите выбранные записи. Если сотрудник уволился, рассмотрите передачу лидов другому ответственному вместо удаления.',
  },
  {
    question: 'Можно ли массово удалить старые лиды за месяц или год?',
    answer: 'Да, сначала отберите записи по дате создания и при необходимости по текущему статусу. Проверьте границы периода и сохраните действующие обращения. Подробный сценарий разобран в статье «Как удалить старые лиды в Битрикс24 за выбранный период».',
  },
  {
    question: 'Что делать, если раздела «Лиды» нет?',
    answer: 'Проверьте режим CRM, тариф и права сотрудника. Простой режим работает без лидов, классический — с лидами. Доступность лидов также зависит от тарифа и разрешений на раздел.',
  },
  {
    question: 'Можно ли восстановить массово удалённые лиды?',
    answer: 'Проверьте корзину CRM, тариф и настройки хранения. Если записи ещё в корзине и восстановление доступно, их можно вернуть до окончательного удаления. После восстановления ID изменяется, поэтому прежние ссылки на карточки не сохранятся.',
  },
  {
    question: 'Удаление лидов освободит место в CRM?',
    answer: 'Удаление из списка исключает записи из активной CRM, но они могут оставаться в корзине и продолжать занимать место. Проверяйте объём через инструмент «Чем занято место» и учитывайте правила окончательного удаления из корзины.',
  },
];
const relatedArticles = getRelatedArticles(article.hrefPath)
  .map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const structuredData = createArticleStructuredData({
  articleType: 'Article',
  title,
  description,
  articleUrl,
  publishedDate: article.publishedAt,
  modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(),
  author: authorName,
  image: ogImage,
  articleSection: 'Работа с лидами в Битрикс24',
  breadcrumbs: [
    { name: 'Главная', item: siteRoot.toString() },
    { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() },
    { name: title, item: articleUrl },
  ],
  faqItems,
});
---

<ArticleLayout
  {title} {titleParts} {description} {canonicalPath} {structuredData}
  ogTitle={article.seoTitle} ogDescription={description} {ogImage} ogImageAlt={imageAlt}
  category={article.category}
  intro="Как выбрать отдельные лиды или весь список по фильтру, проверить права и сохранить нужные данные перед массовой очисткой."
  author={authorName}
>
  <Fragment slot="quick-answer">
    <p>Откройте <strong>CRM → Лиды → Список</strong>, при необходимости установите фильтр, выделите записи и нажмите «Удалить». Для удаления нужны соответствующие права в CRM.</p>
    <p>Чтобы выбрать все результаты фильтра, включая другие страницы списка, включите <strong>«Для всех»</strong>. Перед этим проверьте выборку и сохраните необходимые данные.</p>
  </Fragment>

  <p data-article-lead>Так можно удалить несколько выбранных лидов, все найденные по фильтру или весь доступный список без ограничивающих условий. Последний вариант требует особой осторожности: удалённые записи перестают учитываться в аналитических отчётах. Сначала определите, какие обращения действительно можно убрать.</p>
  <p>Контакты очищают отдельно от лидов. Если задача касается карточек клиентов, используйте <a href={`${base}udalenie-kontaktov-bitrix24/`}>инструкцию по удалению контактов</a> с проверкой связанных элементов CRM.</p>

  <p>Если задача касается сделок, используйте <a href={`${base}massovoe-udalenie-sdelok-bitrix24/`}>инструкцию по массовому удалению сделок</a>: в ней разобраны все страницы списка, воронки и проверка результата по ID.</p>

  <section aria-labelledby="delete-selected">
    <h2 id="delete-selected">Как удалить <span data-heading-accent>несколько лидов</span> в Битрикс24</h2>
    <p>Штатный способ подходит, если нужно убрать определённые записи без установки дополнительного приложения.</p>
    <Checklist items={selectedSteps} label="Порядок удаления выбранных лидов" />
    <p>Этот вариант удобен, когда нужные записи можно выбрать вручную. Если лидов много, сначала ограничьте список фильтром. <a href={sourceLinks[0].href} target="_blank" rel="noopener noreferrer">Официальная инструкция по удалению из списка</a>.</p>
  </section>

  <section aria-labelledby="delete-filtered">
    <h2 id="delete-filtered">Как массово удалить лиды <span data-heading-accent>по фильтру</span></h2>
    <p>Допустим, в CRM накопились тестовые лиды после внедрения, старые обращения без дальнейшей работы или заявки определённого ответственного. Не обязательно искать каждую карточку отдельно.</p>
    <Checklist items={filterSteps} label="Порядок массового удаления лидов по фильтру" />
    <p><strong>«Для всех» относится ко всей текущей выборке, включая другие страницы,</strong> а не только к строкам на экране. Именно поэтому фильтр проверяют до включения этой опции. Если вы вручную сняли выделение с важных карточек, не переходите к «Для всех» без проверки: лучше исключить эти записи самим фильтром. <a href={sourceLinks[1].href} target="_blank" rel="noopener noreferrer">Как работают групповые действия</a>.</p>
    <ArticleFigure src={selectionImage} alt={imageAlt} fullSize caption="Официальный скриншот Поддержки24 на примере сделок: фильтр, выбор строк и действие «Для всех». В справке этот порядок относится к элементам CRM, включая лиды. Значения демонстрационные; это не интерфейс приложения TrueTell." />
    <h3 id="filter-scenarios">Какие фильтры использовать для разных задач</h3>
    <DataTable label="Выбор фильтра для массового удаления лидов" columns={['Задача', 'С чего начать отбор', 'На что обратить внимание']} rows={filterRows} rowHeaders compact />
    <p>В Битрикс24 различаются <strong>«Состояние»</strong> и <strong>«Состояние по истории»</strong>. Первый фильтр учитывает текущее положение лида, второй — группы стадий, через которые он проходил. Для удаления по текущему статусу обычно нужен текущий признак. Так же различаются «Стадия» и «Стадия по истории». <a href={sourceLinks[2].href} target="_blank" rel="noopener noreferrer">Пояснение фильтров в CRM</a>.</p>
    <p>Если задача — удалить лиды за месяц, год или до конкретной даты, смотрите <a href={`${base}bitrix24-udalenie-lidov-za-period/`}>инструкцию по удалению старых лидов за выбранный период</a>. В ней подробнее разобраны границы дат и сохранение действующих обращений.</p>
  </section>

  <section aria-labelledby="delete-all">
    <h2 id="delete-all">Как удалить <span data-heading-accent>все лиды</span> в Битрикс24</h2>
    <p>Технически можно открыть список лидов без ограничивающего фильтра, выбрать записи и применить «Для всех» → «Удалить». Это затронет весь доступный для операции список, а не только первую страницу. Проверьте, действительно ли убраны все условия отбора: сохранённый фильтр может ограничивать выборку.</p>
    <p>Перед удалением всей базы выясните, остаются ли полезные обращения, документы, история работы менеджеров или данные для отчётности. Иногда достаточно закрыть или перераспределить лиды, сохранив записи.</p>
    <p>Для полной очистки тестового портала сначала сохраните нужные данные и уточните, не продолжают ли CRM-формы, телефония и интеграции создавать лиды. Иначе после удаления могут появиться новые обращения.</p>
  </section>

  <section aria-labelledby="before-deletion">
    <h2 id="before-deletion">Что проверить <span data-heading-accent>перед массовым удалением</span></h2>
    <p>Ошибка в фильтре может повлиять на работу менеджеров и отчёты. Битрикс24 указывает, что удалённые элементы CRM не участвуют в аналитических отчётах. Поэтому до запуска проверьте четыре вещи.</p>
    <h3 id="important-leads">Нужны ли эти лиды бизнесу?</h3>
    <p>Откройте несколько найденных карточек, проверьте текущую стадию, ответственного и незавершённые дела. Лид с устаревшей датой создания может всё ещё быть в работе. Нужные обращения должны быть исключены из выборки.</p>
    <h3 id="export">Сохранены ли необходимые сведения?</h3>
    <p>В режиме «Список» можно выгрузить отфильтрованные лиды в Excel или CSV через настройки экспорта. Выберите нужные поля, скачайте и откройте файл до удаления. <a href={sourceLinks[5].href} target="_blank" rel="noopener noreferrer">Как экспортировать данные из CRM</a>.</p>
    <p>Табличная выгрузка не гарантирует полное восстановление всех связей, файлов и истории CRM. Проверьте, какие данные действительно попали в файл, и сохраните условия отбора и количество записей.</p>
    <p>Порядок выгрузки лидов и сделок, выбор полей и сверка уникальных ID разобраны в инструкции <a href={`${base}eksport-lidov-sdelok-bitrix24-pered-udaleniem/`}>«Как экспортировать данные из Битрикс24 перед удалением»</a>.</p>
    <h3 id="permissions">Правильно ли настроены права?</h3>
    <p>Права «Удаление» и «Экспорт» настраиваются отдельно. Доступ к просмотру лидов не означает, что их можно удалить или выгрузить. Уточните оба разрешения до начала операции. <a href={sourceLinks[4].href} target="_blank" rel="noopener noreferrer">Ролевая модель прав в CRM</a>.</p>
    <h3 id="selection-scope">Не выбран ли лишний диапазон?</h3>
    <p>Для фильтра по дате проверьте границы периода; для фильтра по статусу — текущее состояние, а не состояние по истории. Сверьте количество и конкретные карточки. Не включайте «Для всех» до этой проверки.</p>
  </section>

  <section aria-labelledby="after-deletion">
    <h2 id="after-deletion">Что происходит с лидами <span data-heading-accent>после удаления</span></h2>
    <p>Если корзина включена для лидов, при обычном удалении записи попадают в корзину CRM. Битрикс24 описывает хранение до 30 дней и последующее автоматическое удаление порциями. При большом объёме очередь может увеличить фактический срок, но рассчитывать на это как на гарантию сохранности не стоит.</p>
    <ul>
      <li>Восстановление из корзины доступно не на всех тарифах.</li>
      <li>Корзину для отдельных видов элементов можно отключить в настройках CRM.</li>
      <li>Вручную окончательно удалять записи из корзины может администратор Битрикс24.</li>
      <li>При восстановлении ID изменяется, поэтому прежняя прямая ссылка не подойдёт.</li>
    </ul>
    <ArticleFigure src={recycleImage} alt="Официальный скриншот Битрикс24: вход в корзину через меню CRM, Ещё, Корзина" fullSize caption="Официальный пример Поддержки24: вход в корзину CRM из меню «Ещё». Для поиска удалённых лидов в самой корзине выберите нужный тип элементов. Этот экран не подтверждает восстановление конкретной записи." />
    <p>Администратор видит все удалённые элементы, сотрудник — только удалённые им самим. Условия лучше проверить заранее по <a href={sourceLinks[3].href} target="_blank" rel="noopener noreferrer">справке о корзине CRM</a>. Если ошибка уже произошла, смотрите <a href={`${base}udalennye-lidy-bitrix24/`}>где найти удалённые лиды и как их восстановить</a>.</p>
  </section>

  <section aria-labelledby="missing-delete">
    <h2 id="missing-delete">Если кнопки «Удалить» нет или <span data-heading-accent>операция не выполняется</span></h2>
    <p>Начните с прав в CRM. Администратор может проверить «CRM → Ещё → Настройки → Права доступа к CRM» и разрешения для лидов: своих, отдела или всех доступных элементов.</p>
    <p>Убедитесь, что открыт нужный раздел и режим «Список», а ваша роль позволяет удалять выбранные элементы. Интерфейс и доступность фильтров зависят от тарифа и конфигурации портала. Если проблема остаётся, смотрите <a href={`${base}ne-udalyaetsya-lid-bitrix24/`}>почему не удаляется лид в Битрикс24 и что проверить</a>.</p>
  </section>

    <p>Если нужно убрать организацию-контрагента, используйте отдельную <a href={`${base}udalenie-kompaniy-bitrix24/`}>инструкцию по удалению компаний в Битрикс24</a>: перед очисткой проверьте её контакты, сделки и реквизиты.</p>

  <p>Если задача шире удаления лидов, начните с <a href={`${base}ochistka-crm-bitrix24/`}>общего порядка очистки CRM</a>: дубли, передача работы, исправление полей и занимаемое место требуют разных действий.</p>

  <section aria-labelledby="crm-cleanup">
    <h2 id="crm-cleanup">Чем удаление из списка отличается от <span data-heading-accent>«Очистки CRM»</span></h2>
    <p>В Битрикс24 есть отдельный инструмент «Очистка CRM» для анализа занимаемого места и удаления ненужных данных. Его можно открыть через «CRM → Ещё → Настройки → Настройки CRM → Другое → Чем занято место».</p>
    <p>После сканирования доступны операции с определёнными типами элементов и фильтры по дате создания и группе стадий. Удалённые записи, пока они остаются в корзине, продолжают занимать место в базе данных. Это прямо указано в <a href={sourceLinks[8].href} target="_blank" rel="noopener noreferrer">справке о месте в облаке</a>. Для полного освобождения может потребоваться отдельная очистка корзины. <a href={sourceLinks[6].href} target="_blank" rel="noopener noreferrer">Как освободить место в CRM</a>.</p>
    <p>Если нужно исключить конкретную группу лидов, начните с обычного списка и фильтра. В обоих сценариях необходимо проверить состав удаляемых данных: инструмент очистки места сам по себе не определяет, какие обращения нужны бизнесу.</p>
  </section>

  <section aria-labelledby="application">
    <h2 id="application">Когда пригодится <span data-heading-accent>отдельное приложение</span></h2>
    <p>Штатных функций достаточно для многих случаев: выбрать несколько лидов, отфильтровать список или удалить все найденные элементы. Приложение имеет смысл рассматривать, когда нужен управляемый сценарий очистки: заранее определить выборку, оценить объём и явно подтвердить действие.</p>
    <p>В нашем приложении для массового удаления лидов и сделок доступны проверка списка и исключение важных карточек. Перед использованием сверяйте нужные фильтры и ограничения с текущим описанием продукта. Приложение не заменяет проверку прав, данных и резервной копии.</p>
    <InlineConsultation variant="product" title="Нужна управляемая очистка CRM?" description={cleanerProduct.articleDescription} href={cleanerHref} actionLabel={cleanerProduct.articleActionLabel} />
  </section>

