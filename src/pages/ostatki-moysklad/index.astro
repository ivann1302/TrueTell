---
import ArticleFigure from '../../components/editorial/article-figure.astro';
import articleIllustration from '../../images/articles/inventory-check-editorial.png';
import stockDetailImage from '../../images/articles/moysklad-stock-detail-official.png';
import stockBiImage from '../../images/bi-dashboard/stock.png';
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import Checklist from '../../components/editorial/checklist.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';

const article = getArticle('ostatki-moysklad/');
const { title, description } = article;
const canonicalPath = `/${article.hrefPath}`;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const productHref = `${base}${article.relatedProduct!.slice(1)}`;
const authorName = companyInfo.editorial.defaultAuthor;
const imageAlt = "Сотрудник сверяет товары на складской полке с листом учёта";
const ogImage = new URL(articleIllustration.src, siteRoot).toString();
const titleParts = [{ text: 'Остатки ' }, { text: 'в МойСклад', accent: true }, { text: ': контроль запасов и поиск неликвида' }];
const sourceLinks = [
  {
    "label": "Отчёт «Остатки» — Служба поддержки МоегоСклада",
    "href": "https://support.moysklad.ru/hc/ru/товары%20и%20склады/остатки%20и%20себестоимость/отчет_остатки"
  },
  {
    "label": "Складской учёт: остатки, резервы, ожидания — Служба поддержки МоегоСклада",
    "href": "https://support.moysklad.ru/hc/ru/товары%20и%20склады/остатки%20и%20себестоимость/складскои_учет_остатки_резервы_ожидания"
  },
  {
    "label": "Если остатки считаются неверно — Служба поддержки МоегоСклада",
    "href": "https://support.moysklad.ru/hc/ru/товары%20и%20склады/остатки%20и%20себестоимость/если_остатки_считаются_неверно"
  },
  {
    "label": "Обороты — Служба поддержки МоегоСклада",
    "href": "https://support.moysklad.ru/hc/ru/товары%20и%20склады/остатки%20и%20себестоимость/обороты"
  },
  {
    "label": "Инвентаризация товаров — Служба поддержки МоегоСклада",
    "href": "https://support.moysklad.ru/hc/ru/товары%20и%20склады/операции/инвентаризация_товаров"
  },
  {
    "label": "Управление закупками — Служба поддержки МоегоСклада",
    "href": "https://support.moysklad.ru/hc/ru/отчеты/управление_закупками"
  },
  {
    "label": "Пополнение до неснижаемого остатка — Служба поддержки МоегоСклада",
    "href": "https://support.moysklad.ru/hc/ru/закупки/пополнение_до_неснижаемого_остатка"
  }
];
const tableData = [
  {
    "columns": [
      "Показатель",
      "Что он означает",
      "Как использовать"
    ],
    "rows": [
      [
        "Остаток",
        "Количество по проведённым складским документам",
        "Проверять учётное наличие и сопоставлять с пересчётом"
      ],
      [
        "Резерв",
        "Количество под обязательства покупателям или производству",
        "Выяснять, какую часть запаса уже обещали"
      ],
      [
        "Ожидание",
        "Количество, которое ещё должно поступить",
        "Проверять будущие поставки и их сроки"
      ],
      [
        "Доступно",
        "Остаток плюс ожидание минус резерв",
        "Планировать с учётом обязательств и поступлений"
      ]
    ]
  },
  {
    "columns": [
      "Ситуация после проверки",
      "Возможное действие",
      "Что проверить перед действием"
    ],
    "rows": [
      [
        "В одной точке товар стоит, в другой продаётся",
        "Переместить часть запаса",
        "Спрос в принимающей точке и стоимость перемещения"
      ],
      [
        "Спрос есть, но цена мешает продаже",
        "Проверить уценку или акцию на части запаса",
        "Минимальную приемлемую цену и результат пробной продажи"
      ],
      [
        "Поставщик принимает возврат",
        "Согласовать возврат",
        "Условия поставщика, сроки и состояние товара"
      ],
      [
        "Товар сезонный или только поступил",
        "Пересмотреть закупку и срок следующей проверки",
        "Сезон, ожидаемый спрос и уже заказанные партии"
      ],
      [
        "Товар отсутствует физически или повреждён",
        "Разобрать расхождение или основание списания",
        "Пересчёт, состояние и подтверждающие документы"
      ]
    ]
  }
];
const stockSteps = [
  {
    "title": "Нажмите «Фильтр», выберите склад и нужную группу товаров."
  },
  {
    "title": "Задайте дату среза и нажмите «Найти»."
  },
  {
    "title": "Сопоставьте остаток, резерв, ожидание и сумму себестоимости."
  },
  {
    "title": "Для разбора позиции нажмите на её строку вне названия."
  }
];
const faqItems = [
  {
    "question": "Как посмотреть остатки на конкретном складе?",
    "answer": "Откройте «Склад → Остатки» и выберите склад в фильтре. Для проверки размера или цвета используйте вариант по товарам, где модификации показаны отдельно. Зафиксируйте дату среза перед сравнением."
  },
  {
    "question": "Почему «Доступно» больше, чем «Остаток»?",
    "answer": "«Доступно» включает ожидание и уменьшено на резерв. Если ожидаемое количество больше резерва, результат окажется выше фактического остатка. Перед отгрузкой сегодня проверьте товар на складе и сроки ожидаемых поступлений."
  },
  {
    "question": "Товар без продаж за месяц — это неликвид?",
    "answer": "Это кандидат для разбора. Проверьте сезонность, дату поступления, наличие в течение месяца и доступность покупателю. Период оценки должен подходить категории; единого срока для всего ассортимента нет."
  },
  {
    "question": "«Дней на складе» показывает дату последней продажи?",
    "answer": "Нет. Это средний возраст оставшихся поступлений. Для оценки скорости реализации сопоставьте текущий запас с продажами за подходящий период, а историю продаж проверьте отдельно."
  },
  {
    "question": "Как исправить остаток после инвентаризации?",
    "answer": "По выявленной недостаче создают списание, по излишку — оприходование. Одна инвентаризация фиксирует расхождение, но сама количество на складе не изменяет. Сначала исключите ошибки исходных документов."
  },
  {
    "question": "Можно ли просто удалить или архивировать неликвидный товар?",
    "answer": "Удаление или архивирование карточки не является способом продать, вернуть или физически убрать запас. Сначала определите хозяйственное действие и оформите его документами. Очистку каталога рассматривайте отдельно после разбора товара и его истории."
  }
];
const relatedArticles = getRelatedArticles(article.hrefPath)
  .map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const structuredData = createArticleStructuredData({
  articleType: article.type === 'knowledge' ? 'Article' : 'BlogPosting',
  title, description, articleUrl, publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), image: ogImage, author: authorName,
  breadcrumbs: [{ name: 'Главная', item: siteRoot.toString() }, { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() }, { name: title, item: articleUrl }],
  faqItems,
});
---

<ArticleLayout {title} {titleParts} {description} {canonicalPath} {structuredData}
  ogTitle={article.seoTitle} ogDescription={description} {ogImage} ogImageAlt={imageAlt}
  category={article.category} author={authorName}
  intro="Как проверить наличие по складам, сопоставить запасы с продажами и выбрать действие для залежавшихся товаров.">
  <Fragment slot="quick-answer">
    <p>Для контроля остатков в МойСклад начните с отчёта <strong>«Остатки»</strong>: проверьте наличие по складам, резервы и ожидаемые поступления.</p>
    <p>Для поиска неликвида сопоставьте товары с положительным остатком с продажами за выбранный период. Позиции без продаж сначала проверьте на сезонность, недавнее поступление и ошибки учёта, затем решайте, что переместить, уценить или вернуть поставщику.</p>
  </Fragment>

  <p data-article-lead>Большой запас сам по себе не означает проблему. Одни товары нужны для ближайшего сезона, другие поступили вчера, третьи лежат в магазине, где на них нет спроса. Задача анализа — разделить эти ситуации и выбрать действие для конкретной позиции.</p>
  <ArticleFigure src={articleIllustration} alt="Сотрудник сверяет товары на складской полке с листом учёта" caption="Проверку запаса начинайте с конкретного товара: сопоставьте наличие, документы и действующие обязательства. Иллюстрация складской сверки." />
  <section aria-labelledby="stock-report">
    <h2 id="stock-report">Где посмотреть остатки товаров в МойСклад</h2>
    <p>Откройте <strong>Склад → Остатки</strong>. Начните с варианта <strong>«Остатки по товарам»</strong>, затем:</p>
    <Checklist items={stockSteps} label="Порядок проверки отчёта об остатках" />
    <p>Вариант «По товарам» показывает модификации отдельно, а «По складам» объединяет их в количестве родительского товара. Для проверки конкретного размера или цвета используйте детализацию по товарам. Возможности фильтрации и состав отчёта описаны в <a href="https://support.moysklad.ru/hc/ru/товары%20и%20склады/остатки%20и%20себестоимость/отчет_остатки" target="_blank" rel="noopener noreferrer">официальной инструкции МоегоСклада</a>.</p>
    <p>Перед сравнением сохраните условия: дату остатка, склад, группу и период продаж. Если один сотрудник смотрит весь ассортимент компании, а другой — одну розничную точку, одинаковое название товара ещё не делает их цифры сопоставимыми.</p>
  </section>

  <section aria-labelledby="stock-metrics">
    <h2 id="stock-metrics">Остаток, резерв, ожидание и доступно: в чём разница</h2>
    <p>Эти показатели отвечают на разные вопросы.</p>
    <DataTable label="Складские показатели и их применение" columns={tableData[0].columns} rows={tableData[0].rows} rowHeaders compact />
    <p>В МойСклад применяется формула:</p>
    <p><strong>Доступно = Остаток + Ожидание − Резерв.</strong></p>
    <p>Поэтому положительное «Доступно» не подтверждает, что весь этот товар уже можно взять с полки. Например, в условной ситуации остаток — 10 штук, ожидание — 20, резерв — 8. Доступно получится 22, хотя учётный остаток на складе равен 10. Перед обещанием отгрузки сегодня проверьте наличие, обязательства и дату поступления ожидаемой партии. Определения и формула приведены в <a href="https://support.moysklad.ru/hc/ru/товары%20и%20склады/остатки%20и%20себестоимость/складскои_учет_остатки_резервы_ожидания" target="_blank" rel="noopener noreferrer">документации складского учёта</a>.</p>

    <p>Если запас есть, а распоряжаться им мешают старые заказы, разберите причину резерва. Для этой задачи пригодится отдельная инструкция <a href={`${base}kak-snyat-rezervy-moysklad/`}>«Как снять резервы в МойСклад и почему они зависают»</a>. Снимать все резервы только ради красивого показателя доступности не следует: среди них могут быть действующие обязательства.</p>
    <ArticleFigure src={stockDetailImage} fullSize alt="Детализация товара в отчёте Остатки МоегоСклада: количество, резерв, ожидание и документы" caption="Фрагмент отчёта из официальной справки МоегоСклада. Показатели выбранного товара можно сопоставить с документами; значения на кадре приведены как пример интерфейса." />
  </section>

  <section aria-labelledby="incorrect-stock">
    <h2 id="incorrect-stock">Что проверить, если остатки не сходятся</h2>
    <p>Сначала найдите документ или условие, из-за которого возникло расхождение. Проверьте склад в приёмке и отгрузке, проведение документов, а также их дату и время. Черновик приёмки не увеличивает остаток. Отгрузка, оформленная раньше поступления, может показать отсутствие товара на момент операции. Эти причины разобраны в <a href="https://support.moysklad.ru/hc/ru/товары%20и%20склады/остатки%20и%20себестоимость/если_остатки_считаются_неверно" target="_blank" rel="noopener noreferrer">инструкции о неверных остатках</a>.</p>
    <p>Для проверки движения откройте <strong>Склад → Обороты</strong>, задайте период и склад в фильтре, нажмите <strong>«Найти»</strong>, затем откройте строку товара. Отчёт покажет документы, повлиявшие на приход и расход. Такой порядок описан в <a href="https://support.moysklad.ru/hc/ru/товары%20и%20склады/остатки%20и%20себестоимость/обороты" target="_blank" rel="noopener noreferrer">справке по отчёту «Обороты»</a>.</p>
    <p>Расход товара не всегда означает продажу: посмотрите, за счёт каких операций он образовался. Иначе перемещение или списание можно принять за покупательский спрос, а позицию с движением ошибочно исключить из проверки неликвида.</p>
    <p>Если документы не объясняют разницу с полкой, проведите пересчёт. В <strong>Склад → Инвентаризации</strong> создайте документ по нужному складу и внесите фактические количества. На время пересчёта приостановите приёмку и продажи проверяемых товаров. Сам документ инвентаризации остаток не меняет: для недостачи создают списание, для излишка — оприходование. Порядок действий и проверка расхождений разобраны в нашей <a href={`${base}inventarizaciya-moysklad/`}>инструкции по инвентаризации в МойСклад</a>; подробности интерфейса есть в <a href="https://support.moysklad.ru/hc/ru/товары%20и%20склады/операции/инвентаризация_товаров" target="_blank" rel="noopener noreferrer">справке МоегоСклада</a>.</p>
    <p>Исправление учётной ошибки и решение о судьбе медленно продающегося товара — разные действия. Сначала получите достоверное количество, затем оценивайте спрос.</p>
  </section>

  <section aria-labelledby="find-deadstock">
    <h2 id="find-deadstock">Как найти кандидатов в неликвид</h2>
    <p>Неликвидом обычно называют запас, который не удаётся продать на приемлемых для бизнеса условиях. Для первого отбора удобнее использовать проверяемый признак: <strong>товар есть в остатке, но за выбранный период нет продаж либо их слишком мало для имеющегося запаса</strong>. Это список кандидатов для проверки, а не готовое распоряжение о списании.</p>
    <h3 id="analysis-period">1. Выберите период с учётом категории</h3>
    <p>Период должен покрывать обычный цикл спроса на товар. Повседневные расходники и сезонные украшения нельзя оценивать по одному правилу. Короткий период помогает заметить изменения, но способен записать в неликвид товар с редкими покупками. Длинный период может скрыть недавнее падение спроса.</p>
    <p>Начните с одной группы, для которой понятны сезон, срок поставки и привычная частота продаж. Отдельно отмечайте новинки: товар, поступивший в конце периода, не имел столько же времени для продажи, сколько позиции, лежавшие весь период.</p>
    <h3 id="match-stock-sales">2. Сопоставьте полный список остатков с продажами</h3>
    <p>Основой проверки сделайте перечень товаров с положительным остатком. К нему добавьте продажи за выбранный период по тому же складу и каждой конкретной модификации.</p>
    <p>В МойСклад для анализа продаж и текущего запаса предусмотрен отчёт <strong>Закупки → Управление закупками → По продажам</strong>. В фильтре задаётся период анализа; в отчёте есть количество продаж, текущие складские показатели и прогноз запаса. Возможности описаны в <a href="https://support.moysklad.ru/hc/ru/отчеты/управление_закупками" target="_blank" rel="noopener noreferrer">официальной справке «Управление закупками»</a>.</p>
    <p>В этом отчёте продажи относятся к выбранному периоду, а складские показатели — к моменту формирования. Если анализируете прошлую дату, сопоставляйте продажи с остатком на эту же дату отдельно. Не выдавайте сегодняшний запас за запас на конец прошлого месяца.</p>
    <p>При этом проверьте, попали ли в выбранный отчёт все позиции из положительного остатка. Если начать только со списка проданных товаров, позиции без единой продажи могут остаться за пределами проверки. При сопоставлении выгрузок используйте устойчивый идентификатор товара и модификации; совпадение названий недостаточно. Если подходящих выгрузок нет, проверьте небольшую группу вручную по исходным документам.</p>
    <p>Отсутствие строки с продажей трактуйте как ноль только после проверки периода, охвата данных и сопоставления товаров. Не найденный размер, другое название или пропущенный канал продаж — это пробел данных. Также отделяйте отсутствие продаж от нулевого итогового количества после возвратов: во втором случае спрос мог быть, но товар вернули.</p>
    <h3 id="stock-age-cover">3. Разделите возраст остатка и запас в днях</h3>
    <p>Показатель <strong>«Дней на складе»</strong> в отчёте остатков отражает средний возраст оставшихся поступлений. Он не равен числу дней с последней продажи. Это различие следует из <a href="https://support.moysklad.ru/hc/ru/товары%20и%20склады/остатки%20и%20себестоимость/отчет_остатки" target="_blank" rel="noopener noreferrer">формулы показателя в документации</a>.</p>
    <p><strong>Запас в днях</strong> отвечает на другой вопрос: на сколько времени хватит количества при прежней средней скорости продаж. Для отдельной оценки физического запаса можно использовать собственный расчёт:</p>
    <p><strong>Средние продажи в день = количество продаж за период ÷ число дней периода.</strong></p>
    <p><strong>Покрытие физическим запасом = текущий положительный остаток ÷ средние продажи в день.</strong></p>
    <p>Например, если условный товар продавался по 2 штуки в день, а сейчас осталось 40, покрытие составляет 20 дней. Это расчётный ориентир при прежнем спросе, без учёта резервов, будущих поставок и сезонных изменений. Он помогает сравнивать позиции внутри сопоставимой группы.</p>
    <p>Штатный показатель «Дней запаса» в «Управлении закупками» использует <strong>«Доступно»</strong>, поэтому его основание отличается от приведённого расчёта физического запаса. При нулевых продажах делить на среднюю скорость нельзя: вынесите такие позиции в отдельный список. Не подставляйте вместо результата произвольное большое число, которое будет выглядеть как точный прогноз.</p>
    <p>Чтобы оценить скорость продаж относительно среднего запаса за период, используйте <a href={`${base}oborachivaemost-zapasov-formula/`}>формулу оборачиваемости запасов с примером расчёта в днях</a>.</p>
    <h3 id="no-sales-causes">4. Проверьте причины отсутствия продаж</h3>
    <p>Для каждой подозрительной позиции выясните:</p>
    <ul>
      <li>Был ли товар в наличии в течение анализируемого периода, а не только на дату среза?</li>
      <li>Был ли он выставлен на продажу и доступен покупателю?</li>
      <li>Не относится ли он к будущему сезону, новинкам или ассортименту под заказ?</li>
      <li>Не продавалась ли нужная модификация под другой записью?</li>
      <li>Есть ли спрос на эту позицию в другой точке?</li>
      <li>Нет ли ошибки в документах, цене, карточке или передаче данных из канала продаж?</li>
    </ul>
    <p>Позиция могла долго отсутствовать и поступить перед отчётом. Тогда нулевые продажи за прошлый период ничего не говорят о способности продать текущую партию. Для другой позиции причиной окажется неверная выкладка или отсутствие фотографии в интернет-магазине. Уценка до проверки причины не обязательно решит проблему.</p>

    <h3 id="stock-value">5. Оцените деньги в запасе</h3>
    <p>Для определения очереди разбора используйте стоимость текущего запаса по себестоимости. Она помогает увидеть, какие позиции удерживают больше оборотных средств. Начните с дорогих кандидатов без продаж, затем переходите к менее значимым по сумме.</p>
    <p>Цена продажи показывает другую величину — возможную выручку при реализации по этой цене. Её нельзя представлять как уже вложенные деньги или гарантированную сумму возврата. Если себестоимость отсутствует либо выглядит неверной, сначала проверьте исходные поступления: ранжирование по недостоверной стоимости даст неверный приоритет.</p>
    <ArticleFigure src={stockBiImage} fullSize alt="Демонстрационный отчёт TrueTell BI: количество и себестоимость запасов по товарным категориям" caption="Пример отчёта TrueTell BI о стоимости запаса по категориям. Для поиска неликвида отдельно сопоставьте остатки с продажами: этот экран сам по себе не доказывает отсутствие спроса." />
  </section>

  <section aria-labelledby="stock-actions">
    <h2 id="stock-actions">Что делать с медленно продающимися товарами</h2>
    <p>Решение зависит от причины и условий бизнеса.</p>
    <DataTable label="Действия с медленно продающимися товарами" columns={tableData[1].columns} rows={tableData[1].rows} rowHeaders compact />
    <p>Назначьте ответственного и дату повторной проверки. Для акции заранее определите, по какому результату её оцените: сколько единиц продано, какой запас остался, что произошло с доходностью. Без этого временная скидка может остаться в каталоге надолго, а исходная проблема сохранится.</p>
    <p>Если решение об уценке уже принято и нужно изменить цены группы позиций, посмотрите <a href={`${base}moysklad-izmenenie-cen/`}>массовое изменение цен в МойСклад с TrueTell</a>. Выбор товаров и допустимых цен должен предшествовать массовой операции.</p>
  </section>

  <section aria-labelledby="replenishment">
    <h2 id="replenishment">Как поддерживать запас и не закупать лишнее</h2>
    <p>Для регулярного контроля разделите две очереди: что заканчивается и что залежалось. У них разные причины и действия.</p>
    <p>В карточке товара можно задать <strong>«Неснижаемый остаток»</strong>; для модификаций предусмотрены собственные настройки. В отчёте «Остатки» команда <strong>«Пополнить резервы»</strong> создаёт внутренний заказ по позициям ниже этого уровня. На данном этапе расчёт основан на фактическом остатке без резервов и ожиданий. При последующем создании заказа поставщику можно выбрать вариант с учётом «Доступно». Эти особенности описаны в <a href="https://support.moysklad.ru/hc/ru/закупки/пополнение_до_неснижаемого_остатка" target="_blank" rel="noopener noreferrer">инструкции по пополнению до неснижаемого остатка</a>.</p>
    <p>Сам размер минимального запаса выбирайте с учётом скорости продаж, срока поставки и необходимого резерва на колебания спроса. Не переносите одну величину на весь ассортимент. Перед новым заказом проверьте уже ожидаемые партии и возможность перемещения между точками, особенно если в одной из них обнаружен излишек.</p>
    <p>Сохраните простой рабочий список: товар и модификация, склад, дата остатка, количество, себестоимость запаса, продажи за период, причина отклонения, действие, ответственный и срок. После выполнения действия сравните результат на тех же условиях. Регулярность проверки подбирайте по скорости изменения ассортимента: быстро продающиеся товары требуют внимания чаще, чем медленный сезонный запас.</p>
  </section>

  <p>Для проверки результата реализации перейдите к <a href={`${base}otchety-moysklad/`}>отчётам МойСклад о продажах, прибыли и магазинах</a>: там разобраны возвраты, себестоимость и сравнение точек на одинаковых условиях.</p>

  <section aria-labelledby="stock-bi">
    <h2 id="stock-bi">Когда полезна BI-аналитика остатков</h2>
    <p>Штатные отчёты подходят для проверки конкретного склада и документов. Когда нужно регулярно сравнивать несколько точек, категории, продажи и стоимость запасов, удобнее согласовать единую модель анализа.</p>
    <p>В такой модели полезно связать остатки и продажи по идентификаторам товаров и модификаций, показывать дату обновления данных и сохранять позиции с нулевыми продажами. Руководитель должен иметь возможность перейти от общей суммы запаса к товару, складу и причине попадания в список проверки.</p>
    <p>Как получать такие данные регулярно, разбираем в <a href={`${base}vygruzka-dannyh-moysklad-dlya-analitiki/`}>сравнении Excel, рассылки, API и аналитической базы</a>.</p>
    <p>У TrueTell есть <a href={`${base}bi-analitika/`}>BI-аналитика для товарного бизнеса</a> с демонстрацией отчётов по остаткам, продажам и магазинам. <strong>Обсудить анализ запасов с TrueTell</strong> стоит, если ручное сопоставление уже занимает много времени: начните с перечня источников, правил отбора кандидатов и нужных разрезов. Состав отчёта и порядок обновления данных согласуются под задачу компании.</p>
    <InlineConsultation title="Нужно сопоставить остатки и продажи нескольких точек?" description="Обсудим источники данных, правила отбора кандидатов в неликвид и нужные разрезы отчёта." />
  </section>

  <p>Если товар продаётся на площадках, проверьте не только общий запас, но и количество, которое уходит на витрину. В <a href={`${base}moysklad-dlya-marketpleysov/`}>разборе МоегоСклада для маркетплейсов</a> показано, как согласовать склады, резерв и обмен ценами.</p>

