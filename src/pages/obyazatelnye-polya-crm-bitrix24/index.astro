---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { mcpProduct } from '../../config/products';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import timingImage from '../../images/articles/bitrix24-required-field-timing-135.png';
import scopeImage from '../../images/articles/bitrix24-required-field-pipeline-scope-135.png';

const article = getArticle('obyazatelnye-polya-crm-bitrix24/');
const { title, description } = article;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const ogImage = new URL(timingImage.src, siteRoot).toString();
const imageAlt = 'Учебная шкала сделки: источник обращения нужен к стадии «В работе», номер договора — к стадии «Договор подписан», а при создании сделки они ещё могут быть неизвестны';
const faqItems = [
  { question: 'Какие поля сделать обязательными в сделке Битрикс24?', answer: 'Выбирайте поля, без которых сотрудник не может выполнить действие на конкретной стадии. Для каждого запишите, кто узнаёт значение и когда. Например, источник обращения может понадобиться к началу работы, а номер договора — после его подписания. Это пример правила компании, а не обязательный набор Битрикс24.' },
  { question: 'Можно ли сделать поле обязательным только на одной стадии?', answer: 'Да, для элементов со стадиями Битрикс24 позволяет выбрать стадии. В сделках и смарт-процессах выбор конкретных стадий настраивают отдельно в каждой воронке. Опция зависимости от стадии доступна не на всех тарифах; проверьте её на своём портале.' },
  { question: 'Где включить обязательность поля в карточке сделки?', answer: 'Администратор или сотрудник с правом изменения настроек CRM открывает нужную сделку, наводит курсор на поле и выбирает «Настройки» → «Настроить». Затем включает «Обязательное на стадии» и, если нужна выбранная стадия, раскрывает область «Для всех стадий и воронок» и отмечает нужные стадии.' },
  { question: 'Распространится ли правило на другие воронки?', answer: 'В официальной инструкции Битрикс24 режим «Для всех стадий и воронок» действует глобально. Если выбрать отдельные стадии, настройка действует только в той воронке, где открыта карточка. Поэтому вторую воронку проверяют отдельно.' },
  { question: 'Почему обязательное поле не видно сотруднику?', answer: 'Видимость пользовательского поля может быть ограничена. По справке Битрикс24 обязательное поле с ограниченной видимостью заполняют сотрудники, которым оно доступно. Администратор должен проверить и область обязательности, и видимость поля под нужной ролью.' },
  { question: 'Проверяет ли MCP TrueTell обязательные поля автоматически?', answer: 'Автоматическую проверку или изменение правил мы пока не заявляем. MCP TrueTell для настройки и диагностики CRM находится в разработке. Можно обсудить матрицу стадий и полей без передачи данных клиентов.' },
];
const sourceLinks = [
  { label: 'Битрикс24: как сделать поле обязательным в карточке CRM', href: 'https://helpdesk.bitrix24.ru/open/27744544/' },
  { label: 'Битрикс24: ограниченная видимость пользовательских полей', href: 'https://helpdesk.bitrix24.ru/open/23204032/' },
  { label: 'Битрикс24: ролевая модель прав в CRM', href: 'https://helpdesk.bitrix24.ru/open/23240636/' },
  { label: 'Битрикс24: пользовательские поля в CRM', href: 'https://helpdesk.bitrix24.ru/open/22048980/' },
  { label: 'Битрикс24: прочие настройки CRM для внешних приложений', href: 'https://helpdesk.bitrix24.ru/open/28033006/' },
];
const matrixRows = [
  ['Источник обращения', 'В работе', 'Менеджер узнал источник до начала обработки', 'Продажи'],
  ['Номер договора', 'Договор подписан', 'Менеджер получил подписанный документ', 'Продажи'],
  ['Дата продления', 'Подготовка продления', 'Аккаунт-менеджер согласовал дату', 'Продления'],
];
const structuredData = createArticleStructuredData({
  articleType: 'Article', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  breadcrumbs: [{ name: 'Главная', item: siteRoot.toString() }, { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() }, { name: title, item: articleUrl }],
  faqItems,
});
---
<ArticleLayout {title} titleParts={[{ text: 'Обязательные поля CRM Битрикс24: ' }, { text: 'на какой стадии запрашивать', accent: true }]} {description}
  canonicalPath={`/${article.hrefPath}`} {structuredData} ogTitle={article.seoTitle} ogDescription={description}
  {ogImage} ogImageAlt={imageAlt} category={article.category} author={authorName}
  intro="Если запрашивать номер договора при создании сделки, менеджер ещё не знает, что вводить. Обязательность полезна в тот момент, когда значение уже должно быть получено и без него нельзя продолжать работу.">
  <Fragment slot="quick-answer">
    <p><strong>Для каждого поля укажите стадию, на которой значение уже известно и требуется для следующего действия.</strong> Составьте матрицу «поле × стадия × воронка × ответственный». Затем включите обязательность для выбранных стадий нужной воронки и проверьте создание и переход на контрольной сделке.</p>
    <p>В сделках и смарт-процессах выбор отдельных стадий настраивается по воронкам. Режим «Для всех стадий и воронок» действует шире. Доступность обязательности по стадиям зависит от тарифа.</p>
  </Fragment>

  <p data-article-lead>Начните с реального маршрута сделки. В начале менеджер знает, откуда пришло обращение, но может ещё не знать номер будущего договора. Когда договор подписан, номер уже должен быть в карточке. Если включить оба требования с первой стадии, часть команды начнёт вводить временные значения ради сохранения сделки. Такая карточка проходит проверку, но хуже помогает работе и отчётам.</p>

  <section aria-labelledby="choose-moment">
    <h2 id="choose-moment">Выберите момент, <span data-heading-accent>когда поле становится нужным</span></h2>
    <p>Обязательность привязывайте к действию, ради которого требуется значение. Спросите у владельца процесса, кто получает данные и что произойдёт, если поле пустое. Если ответ «пока ничего», требование на ранней стадии преждевременно. Если без значения нельзя передать заказ или подготовить документ, найдите ближайшую стадию перед этим действием.</p>
    <ArticleFigure src={timingImage} fullSize alt={imageAlt} caption="Учебный пример. Источник и номер договора появляются в разные моменты; это предлагаемые правила процесса, а не стандартные обязательные поля Битрикс24." />
    <p>Матрица ниже показывает способ записать решение. Названия стадий и полей условные; не включайте их на своём портале без проверки бизнес-процесса. Для контактов и компаний стадий нет: обязательность действует на карточки выбранного типа, поэтому критерий для сделки нельзя автоматически переносить на контакт.</p>
    <DataTable label="Учебная матрица обязательных полей CRM" columns={['Поле', 'Когда требовать', 'Кто и когда получает значение', 'Воронка']} rows={matrixRows} rowHeaders />
    <p>Если нужно выбрать тип значения или понять техническое свойство поля, откройте материал <a href={`${base}tipy-poley-crm-bitrix24/`}>о типах полей CRM</a>. Если в базе уже накопились похожие поля, сначала проведите <a href={`${base}audit-poley-crm-bitrix24/`}>аудит полей</a>, чтобы не закрепить обязательность за дублем.</p>
  </section>

  <section aria-labelledby="scope">
    <h2 id="scope">Проверьте область действия <span data-heading-accent>в каждой воронке</span></h2>
    <p>В карточке сделки наведите курсор на поле и откройте «Настройки» → «Настроить». Администратор или сотрудник с правом изменения настроек CRM включает «Обязательное на стадии». По официальной справке Битрикс24 исходный выбор «Для всех стадий и воронок» делает поле обязательным во всех направлениях. Если раскрыть этот выбор и отметить отдельные стадии, правило относится к воронке, в которой открыта карточка. Для другой воронки настройку нужно проверить отдельно.</p>
    <ArticleFigure src={scopeImage} fullSize alt="Редакционная схема области обязательности: все стадии и воронки или выбранные стадии одной воронки; для второй воронки нужна отдельная проверка" caption="Схема по справке Битрикс24, без снимка интерфейса. Выбор конкретных стадий ограничен текущей воронкой; режим для всех стадий и воронок действует шире." />
    <p>Если пункта зависимости от стадии нет, проверьте тариф и права сотрудника, прежде чем менять процесс. Не все системные поля поддерживают изменение обязательности: Битрикс24 указывает пользовательские и некоторые системные. В разных типах карточек состав доступных полей отличается.</p>
    <p>У пользовательского поля может быть ограничена видимость. Если оно обязательно, по справке Битрикс24 его должны заполнять только сотрудники, которым оно доступно. Поэтому проверяйте правило под ролью того, кто вводит значение. Для внешних приложений у CRM есть отдельная настройка «Проверять наличие обязательных пользовательских полей»; её состояние также учитывайте, если сделки создаёт интеграция. Не переносите результат ручной проверки на работу приложения без отдельного опыта.</p>
  </section>

  <section aria-labelledby="verify">
    <h2 id="verify">Проверьте правило <span data-heading-accent>до работы с реальными сделками</span></h2>
    <p>Создайте контрольную сделку без данных клиента в нужной воронке. Проверьте, сохраняется ли она на первой стадии без поздних полей. Затем перейдите к стадии, где поле становится обязательным: Битрикс24 должен попросить достоверное значение. Заполните его и убедитесь, что сделка дошла до целевой стадии. Повторите проверку в другом направлении, если там действует своя матрица.</p>
    <p>Для каждого результата запишите воронку, исходную и целевую стадии, поле, роль сотрудника и сообщение CRM. Если переход блокируется там, где он должен работать, проверьте область действия поля и видимость; отдельный маршрут диагностики описан в статье <a href={`${base}sdelka-ne-perehodit-stadiyu-bitrix24/`}>о сделке, которая не переходит на стадию</a>. Не отменяйте все ограничения по одному сбою.</p>
    <p>После проверки согласуйте матрицу с руководителем отдела. Если поле стало обязательным слишком рано, перенесите требование на стадию, где информация появляется по процессу, и повторите контрольную проверку. Сохраните в матрице название воронки, ответственного и причину требования: это поможет позже оценить изменения стадий и интеграций.</p>
    <p>MCP TrueTell для настройки и диагностики CRM находится в разработке. Автоматическое построение матрицы и изменение обязательности пока не заявлены. Можно обсудить, какие поля и стадии стоит проверять в будущем сценарии диагностики без передачи данных клиентов.</p>
    <InlineConsultation variant="product" title="Обязательные поля мешают работе отдела?" description="Опишите стадии, воронки и поля без клиентских данных. Поможем составить проверяемую матрицу требований и обсудим сценарий диагностики CRM." href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
  </section>

  <FaqSection title="Частые вопросы об обязательных полях CRM" items={faqItems} variant="article" />
  <p>Официальная справка Битрикс24 проверена 31 октября 2026 года. Конкретный портал, тариф и интеграции клиента не проверялись.</p>
  <ArticleSources publishedIso={article.publishedAt} modifiedIso={article.updatedAt} sources={sourceLinks} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Обсудим ' }, { text: 'диагностику полей с MCP TrueTell', accent: true }]} description={mcpProduct.articleDescription} href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <ConsultationCtaSection slot="after-article" />
</ArticleLayout>
