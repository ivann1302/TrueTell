---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import workflowImage from '../../images/articles/akt-sverki-workflow-070.png';
import comparisonImage from '../../images/articles/akt-sverki-comparison-070.png';

const article = getArticle('akt-sverki-moysklad/');
const { title, description } = article;
const canonicalPath = `/${article.hrefPath}`;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const imageAlt = 'Два пути печати акта сверки в МойСклад: из детализации отчёта «Взаиморасчёты» или из карточки контрагента с опцией CRM';
const ogImage = new URL(workflowImage.src, siteRoot).toString();
const titleParts = [{ text: 'Акт сверки в МойСклад: ' }, { text: 'как сформировать и найти расхождения', accent: true }];

const actUrl = 'https://support.moysklad.ru/hc/ru/%D0%BF%D0%BE%D0%BA%D1%83%D0%BF%D0%B0%D1%82%D0%B5%D0%BB%D0%B8%20%D0%B8%20%D0%BF%D0%BE%D1%81%D1%82%D0%B0%D0%B2%D1%89%D0%B8%D0%BA%D0%B8/%D0%B0%D0%BA%D1%82_%D1%81%D0%B2%D0%B5%D1%80%D0%BA%D0%B8_%D0%B2%D0%B7%D0%B0%D0%B8%D0%BC%D0%BE%D1%80%D0%B0%D1%81%D1%87%D0%B5%D1%82%D0%BE%D0%B2';
const settlementsUrl = 'https://support.moysklad.ru/hc/ru/%D0%BE%D1%82%D1%87%D0%B5%D1%82%D1%8B/%D0%B2%D0%B7%D0%B0%D0%B8%D0%BC%D0%BE%D1%80%D0%B0%D1%81%D1%87%D0%B5%D1%82%D1%8B';
const sources = [
  { label: 'Акт сверки взаиморасчётов — Служба поддержки МоегоСклада', href: actUrl },
  { label: 'Отчёт «Взаиморасчёты» — Служба поддержки МоегоСклада', href: settlementsUrl },
];
const faqItems = [
  { question: 'Где в МойСклад сформировать акт сверки?', answer: 'Из отчёта: Деньги → Взаиморасчёты, выберите организацию и контрагента, откройте строку контрагента с детализацией и нажмите Печать → Акт сверки. Второй путь — карточка контрагента в разделе CRM; для него нужна опция CRM.' },
  { question: 'Можно ли сформировать акт без опции CRM?', answer: 'Да. Официальная инструкция описывает печать из отчёта «Взаиморасчёты» отдельно от карточки контрагента. Опция CRM требуется именно для создания акта прямо из карточки.' },
  { question: 'Что проверить, если суммы в актах не совпадают?', answer: 'Сопоставьте одну организацию, контрагента, договор и одинаковый период. Затем сравните начальное сальдо и документы по датам, номерам, типам, суммам и валюте; расхождение проверьте по исходному документу или платежу.' },
  { question: 'Что означает положительное сальдо в отчёте «Взаиморасчёты»?', answer: 'По справке МоегоСклада положительный конечный остаток означает задолженность вашей компании, отрицательный — задолженность контрагента. Проверяйте знак именно в контексте этого отчёта.' },
  { question: 'МойСклад сам находит расхождения с актом контрагента?', answer: 'В официальной справке описаны печать акта и детализация документов. Автоматическое сравнение с актом, полученным от контрагента, там не описано: документы нужно сопоставить и выяснить причину каждого отличия.' },
];
const balanceRows = [
  ['Начальное сальдо', 'Проверьте, с какого остатка начинается период у обеих сторон'],
  ['Документы внутри периода', 'Сопоставьте дату, номер, тип, сумму и валюту каждой операции'],
  ['Конечное сальдо', 'Сначала разберите отличия в строках, затем сравните итог'],
];
const relatedArticles = getRelatedArticles(article.hrefPath)
  .map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const structuredData = createArticleStructuredData({
  articleType: 'Article', title, description, articleUrl, publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), image: ogImage, author: authorName,
  breadcrumbs: [{ name: 'Главная', item: siteRoot.toString() }, { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() }, { name: title, item: articleUrl }],
  faqItems,
});
---

<ArticleLayout {title} {titleParts} {description} {canonicalPath} {structuredData}
  ogTitle={article.seoTitle} ogDescription={description} {ogImage} ogImageAlt={imageAlt}
  category={article.category} author={authorName}
  intro="Как сформировать акт сверки в МойСклад двумя способами, проверить период и найти документ или платёж, из-за которого не сходятся суммы.">
  <Fragment slot="quick-answer">
    <p>Откройте <strong>Деньги → Взаиморасчёты</strong>, задайте организацию и контрагента, перейдите в детализацию по документам и выберите <strong>Печать → Акт сверки</strong>. Укажите формат печати.</p>
    <p>Сверьте начальное сальдо, документы за одинаковый период и конечный остаток. Сравнение с актом контрагента выполняйте по строкам: МойСклад формирует акт по своим данным, а не подтверждает автоматически, что расхождений нет.</p>
  </Fragment>

  <p data-article-lead>Акт сверки помогает увидеть, как менялись взаиморасчёты с покупателем или поставщиком: начальное сальдо, документы за выбранный период и итоговую задолженность. Если итог отличается от данных контрагента, полезнее сначала найти конкретную операцию, чем пытаться объяснить разницу одной общей суммой.</p>
  <ArticleFigure src={workflowImage} fullSize eager alt={imageAlt} caption="Редакционная схема по официальной справке МоегоСклада. Это не снимок интерфейса: названия разделов и последовательность действий сверяйте с актуальной справкой и доступными опциями аккаунта." />

  <section aria-labelledby="before-act">
    <h2 id="before-act">Перед формированием: зафиксируйте одинаковый охват</h2>
    <p>Для сравнения двух актов важны одинаковые условия. Выберите ту же организацию и того же контрагента, согласуйте начало и конец периода и проверьте, требуется ли учитывать отдельный договор. Если у вас несколько юридических лиц или договоров, общий итог по контрагенту может не совпасть с документом, сформированным только по одному из них.</p>
    <p>В акте показываются состояние расчётов на начало периода, документы, изменявшие баланс, и итоговая задолженность. Поэтому начальное сальдо — не второстепенная строка: если периоды у сторон начинаются по-разному, последующие суммы могут быть верными, а итог всё равно будет различаться.</p>
  </section>

  <section aria-labelledby="create-act">
    <h2 id="create-act">Как сформировать акт сверки в МойСклад</h2>
    <p>Официальная справка описывает два маршрута. Первый ведёт через отчёт «Взаиморасчёты»; второй — из карточки контрагента, если в аккаунте доступна опция CRM.</p>
    <ol>
      <li><strong>Из отчёта:</strong> откройте <strong>Деньги → Взаиморасчёты</strong>. В фильтре укажите организацию и контрагента, затем нажмите «Найти».</li>
      <li>Откройте строку контрагента нажатием правее его названия — появится детализация по документам. Проверьте нужный период и перечень операций.</li>
      <li>В детализации выберите <strong>Печать → Акт сверки</strong>, укажите формат и подтвердите печать.</li>
    </ol>
    <p>Если удобнее работать из карточки, откройте <strong>CRM → Контрагенты</strong>, выберите контрагента и нажмите «Создать акт сверки». Укажите период и организацию, при необходимости — договор. Затем выберите «Печать → Акт сверки» и формат. По справке этот способ из карточки доступен только с опцией CRM; маршрут через отчёт описан отдельно.</p>
  </section>

  <section aria-labelledby="read-act">
    <h2 id="read-act">Как читать акт и в каком порядке сравнивать строки</h2>
    <p>Не начинайте с последнего числа. Сначала сопоставьте входящий остаток, затем пройдите документы за период и только после этого сравните конечное сальдо. В отчёте «Взаиморасчёты» детализация содержит суммы прихода и расхода, баланс на начало и конец, а для документов — сумму, валюту, время проведения, тип, номер, статус и комментарий. Это помогает перейти от общей разницы к конкретной записи.</p>
    <ArticleFigure src={comparisonImage} fullSize alt="Учебная таблица для построчной сверки двух актов: сравнить начальный остаток, документы за период и конечное сальдо, затем проверить отличающуюся операцию по первичному документу" caption="Условный пример разбора, не данные клиента и не экран МойСклад. Сравнивайте строки и их исходные документы; одинаковый итог сам по себе не доказывает, что все операции совпадают." />
    <DataTable label="Порядок сравнения акта сверки" columns={['Часть акта', 'Что проверить']} rows={balanceRows} rowHeaders compact />
    <p>Отдельно следите за направлением сальдо. В отчёте МоегоСклада положительный конечный остаток означает, что задолжала ваша компания; отрицательный — что задолжал контрагент. Не переносите знак на другой отчёт или шаблон без проверки его обозначений.</p>
  </section>

  <section aria-labelledby="find-differences">
    <h2 id="find-differences">Где искать расхождение с данными контрагента</h2>
    <p>Сравнивайте одинаковые строки по дате, номеру и виду документа, сумме и валюте. Если строка есть только у одной стороны, найдите документ или платёж в исходной системе и проверьте, относится ли он к выбранному контрагенту, организации, договору и периоду. Если запись есть в обоих актах, но суммы разные, сверяйте состав операции и её проведение, а не только печатную форму.</p>
    <ul>
      <li><strong>Разные периоды или начальный остаток.</strong> Уточните даты среза и остаток на начало; иначе вы сравниваете разные наборы операций.</li>
      <li><strong>Платёж отнесён не к тому контрагенту или договору.</strong> Проверьте назначение платежа и его привязку в учёте.</li>
      <li><strong>Документ пропущен, отменён или проведён не в ожидаемом периоде.</strong> Найдите первичный документ и сопоставьте его дату и статус в детализации.</li>
      <li><strong>Сумма или валюта отличается.</strong> Сравните исходную операцию и способ отражения платежа; не корректируйте остаток только ради совпадения итоговой строки.</li>
    </ul>
    <p>Справка описывает формирование и печать акта, а также просмотр детализации. Автоматическое сопоставление с файлом контрагента в этих инструкциях не заявлено. Поэтому результат сверки — это найденная и объяснённая причина каждой разницы, а не просто совпавшие итоговые суммы.</p>
    <InlineConsultation title="Нужна сводная аналитика по операциям МойСклад?" description="Если задача шире одного акта — например, регулярно сопоставлять продажи, платежи и остатки — обсудите состав показателей и источники данных. Сама сверка контрагента и проверка первичных документов остаются отдельной задачей." href={`${base}otchety-moysklad/`} actionLabel="Посмотреть отчёты МойСклад" variant="product" />
  </section>

  <section aria-labelledby="finish-reconciliation">
    <h2 id="finish-reconciliation">Что сделать после сравнения</h2>
    <p>Соберите список различий с указанием даты, номера документа, суммы и стороны, у которой операция отсутствует или отражена иначе. Для каждой строки приложите найденный первичный документ или платёж и договоритесь с коллегой либо контрагентом, какое событие объясняет разницу. Если после такой проверки нужна управленческая сводка по платежам или продажам, смотрите соответствующий отчёт отдельно: акт сверки и аналитический отчёт отвечают на разные вопросы.</p>
  </section>

  <FaqSection items={faqItems} id="faq" variant="article" />
  <ArticleSources publishedIso={article.publishedAt} modifiedIso={article.updatedAt} sources={sources} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Другие отчёты ' }, { text: 'МойСклад', accent: true }]} description="Если кроме сверки нужно оценить продажи, остатки и показатели за период, посмотрите обзор отчётов и проверьте, какой из них отвечает на вашу задачу." href={`${base}otchety-moysklad/`} actionLabel="Смотреть отчёты" />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <Fragment slot="after-article"><ConsultationCtaSection /></Fragment>
</ArticleLayout>
