---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { mcpProduct } from '../../config/products';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import historyImage from '../../images/articles/bitrix24-crm-history-list-official-097.jpg';
import columnsImage from '../../images/articles/bitrix24-crm-history-columns-official-097.jpg';

const article = getArticle('istoriya-izmeneniy-crm-bitrix24/');
const { title, description } = article;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const imageAlt = 'Официальный демонстрационный экран истории CRM Битрикс24: столбцы Сущность, Автор, Дата, Тип события и Описание';
const ogImage = new URL(historyImage.src, siteRoot).toString();
const sourceLinks = [
  { label: 'Битрикс24: что такое История в CRM', href: 'https://helpdesk.bitrix24.ru/open/24296386/' },
  { label: 'Битрикс24: ролевая модель прав в CRM', href: 'https://helpdesk.bitrix24.ru/open/23240636/' },
  { label: 'Битрикс24: прочие настройки CRM', href: 'https://helpdesk.bitrix24.ru/open/28033006/' },
  { label: 'Битрикс24: робот «Записать в историю»', href: 'https://helpdesk.bitrix24.ru/open/19427102/' },
  { label: 'Битрикс24: почему робот или бизнес-процесс не указан автором', href: 'https://helpdesk.bitrix24.ru/open/23046316/' },
];
const checkRows = [
  ['Сменился ответственный', 'Изменение поля «Ответственный» по ID карточки и времени', 'Сопоставьте запись с правилом очереди и роботами; имя автора не доказывает ручное действие'],
  ['Сделка перешла на другую стадию', 'Изменение стадии и соседние события в истории той же сделки', 'Проверьте условие робота и действия сотрудника в этот промежуток'],
  ['Нужно понять, кто смотрел или экспортировал данные', 'События просмотра или экспорта в общем журнале', 'Уточните, включена ли запись этих событий и доступна ли функция на вашем тарифе'],
];
const faqItems = [
  { question: 'Где посмотреть, кто изменил сделку в Битрикс24?', answer: 'Откройте сделку и вкладку «История» либо раздел CRM → Ещё → История. В общем списке отфильтруйте записи по ID сделки и дате, затем смотрите столбцы «Автор», «Тип события» и «Описание». Если вкладка не видна, проверьте право «Чтение» для истории CRM и доступ к сделке.' },
  { question: 'История CRM показывает старое и новое значение каждого поля?', answer: 'Справка Битрикс24 перечисляет основные изменения, в том числе ответственного и стадию, но не обещает полный неизменяемый журнал для каждого поля и каждой интеграции. Откройте конкретную запись: её описание покажет доступные детали. Для критичных полей заранее проверьте, достаточно ли этого вашей процедуре контроля.' },
  { question: 'Почему в истории нет нужного события?', answer: 'Проверьте ID элемента, диапазон дат, фильтр, права на карточку и право «Чтение» истории. В настройках CRM запись некоторых типов событий можно отключить. Отсутствие строки само по себе не доказывает, что действия не было; для спорного случая попросите администратора проверить настройки и воспроизведите действие на тестовой карточке.' },
  { question: 'Если автором указан сотрудник, он точно поменял карточку вручную?', answer: 'Не обязательно. Робот «Записать в историю» может создавать запись от имени выбранного пользователя. Для других роботов и бизнес-процессов автор также зависит от настройки «Изменять от имени». Сверьте время изменения с автоматизацией и её настройками, прежде чем делать вывод.' },
  { question: 'Можно ли отменить изменение, удалив запись из истории?', answer: 'Нет. Администратор может удалить строку истории CRM, но это не возвращает прежнее значение поля. Исправление делают в самой карточке после проверки причины и связанных процессов.' },
];
const structuredData = createArticleStructuredData({
  articleType: 'Article', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  breadcrumbs: [{ name: 'Главная', item: siteRoot.toString() }, { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() }, { name: title, item: articleUrl }],
  faqItems,
});
---
<ArticleLayout {title} titleParts={[{ text: 'История изменений в CRM Битрикс24: ' }, { text: 'кто и что поменял', accent: true }]} {description}
  canonicalPath={`/${article.hrefPath}`} {structuredData} ogTitle={article.seoTitle} ogDescription={description}
  {ogImage} ogImageAlt={imageAlt} category={article.category} author={authorName}
  intro="Ответственный у сделки сменился, а команда не помнит почему. В Битрикс24 можно проверить историю конкретной карточки и общий журнал CRM. Найдём событие и проверим, можно ли считать его ручным действием.">
  <Fragment slot="quick-answer">
    <p><strong>Откройте нужную карточку CRM → вкладка «История» или CRM → Ещё → История.</strong> В общем журнале найдите запись по ID элемента и дате, проверьте автора, тип события и описание. Так можно увидеть основные изменения: например, смену стадии или ответственного.</p>
    <p>Если записи нет, проверьте фильтр, права и настройки сохранения истории. Робот может работать от имени сотрудника, поэтому для выяснения причины сопоставляйте журнал с автоматизацией.</p>
  </Fragment>

  <p data-article-lead>История полезна, когда нужно восстановить цепочку событий: кто поменял стадию, когда сменился ответственный, что произошло рядом с отправкой письма или добавлением товара. Она помогает начать разбор конкретной карточки. Для вывода «этот сотрудник сделал это вручную» одной строки журнала бывает недостаточно.</p>

  <section aria-labelledby="open-history">
    <h2 id="open-history">Откройте историю <span data-heading-accent>карточки или всей CRM</span></h2>
    <p>Если известна сделка, лид, контакт или компания, откройте карточку и перейдите на вкладку <strong>«История»</strong>. Для поиска по нескольким элементам откройте <strong>CRM → Ещё → История</strong>. Администратор видит изменения по всей CRM; сотрудник — только по элементам, доступным ему по правам. Отдельное право роли <strong>«Чтение» в блоке «История»</strong> определяет, будут ли показаны раздел журнала и вкладка карточки.</p>
    <ArticleFigure src={historyImage} fullSize alt={imageAlt} caption="Официальный демонстрационный экран из справки Битрикс24. Видны столбцы «Сущность», «Автор», «Дата», «Тип события» и «Описание»; имена и записи относятся к примеру в документации, а не к клиентскому порталу TrueTell. Откройте изображение для чтения деталей." />
    <p>Не путайте вкладку «История» с таймлайном карточки. Таймлайн удобен для переписки, звонков и текущей работы с клиентом; журнал истории помогает искать зарегистрированные изменения и события по типу, автору и дате. Если проверяете конкретный спорный случай, запишите ID карточки и примерный интервал времени до настройки фильтра.</p>
  </section>

  <section aria-labelledby="find-event">
    <h2 id="find-event">Найдите событие <span data-heading-accent>по ID и времени</span></h2>
    <p>ID нужной карточки можно взять из её адреса в браузере. В общем журнале настройте фильтр по этому ID, типу CRM-элемента, дате и, если это уместно, типу события. Затем прочитайте строки до и после нужного времени. Фильтр только по имени сотрудника может пропустить запись робота или, наоборот, принять автоматическое действие за ручное. Для сравнения двух карточек сначала проверьте каждую отдельно, чтобы не смешать события.</p>
    <ArticleFigure src={columnsImage} fullSize alt="Официальный экран настройки столбцов истории CRM: в списке доступны ID, Сущность, Автор, Дата и тип события" caption="Официальный демонстрационный экран настройки столбцов истории Битрикс24. Включите ID, автора и дату, если их нет в вашем представлении. Это пример интерфейса справки, не результат проверки портала TrueTell." />
    <DataTable label="Что искать в истории CRM" columns={['Задача', 'Искомая запись', 'Следующая проверка']} rows={checkRows} rowHeaders />
    <p>Справка Битрикс24 относит к истории изменения названия, стадии, ответственного, части контактных данных и связей между элементами; также в журнале бывают события таймлайна и товаров. Состав данных внутри строки смотрите в её описании. Не стройте процесс контроля на предположении, что история хранит прежнее и новое значение любого поля в одинаковом виде.</p>
  </section>

  <section aria-labelledby="read-author">
    <h2 id="read-author">Разберите автора <span data-heading-accent>и причину изменения</span></h2>
    <p>Автор записи показывает, от чьего имени она появилась в истории. Он не всегда совпадает с человеком, который руками открыл карточку. Робот <strong>«Записать в историю»</strong> позволяет выбрать автора записи. У роботов и бизнес-процессов также есть настройка <strong>«Изменять от имени»</strong>; если её не заполнить, сотрудник может не отображаться автором изменения. Поэтому сопоставьте время строки со стадией сделки, активными роботами, условиями и действиями сотрудников.</p>
    <p>Например, смена ответственного сразу после создания сделки может следовать из настройки CRM-формы, а более поздняя смена — из робота. Начните с <a href={`${base}ne-tot-otvetstvennyy-bitrix24/`}>разбора неверного ответственного</a>. Если спор касается перехода стадии, используйте <a href={`${base}sdelka-ne-perehodit-stadiyu-bitrix24/`}>проверку обязательных полей, прав и автоматизации</a>. История показывает событие, а источник ошибки устанавливают по цепочке настроек.</p>
  </section>

  <section aria-labelledby="missing">
    <h2 id="missing">Если записи нет <span data-heading-accent>или журнал не открывается</span></h2>
    <p>Сначала сбросьте фильтр и проверьте правильный ID, тип элемента и дату. Затем попросите администратора сверить доступ к карточке и право «Чтение» для истории. Если вкладки вообще нет, это может быть следствием прав роли. Отдельные события просмотра, экспорта и удаления зависят от настроек истории в <strong>Настройки CRM → Другое → Прочие настройки → История</strong>; сохранение некоторых из них можно отключить. Журнал доступа к данным CRM также доступен не на всех тарифах.</p>
    <p>Отсутствие события не равно доказательству, что ничего не происходило. Для важного случая зафиксируйте текущее значение поля, ID и время, затем на согласованной тестовой карточке повторите действие под нужной ролью и проверьте результат. Не меняйте настройки сохранения событий задним числом в расчёте восстановить отсутствующие строки. И учитывайте, что администратор может удалить запись истории: удаление строки не отменяет изменение в карточке.</p>
    <InlineConsultation variant="product" title="Нужно разобраться в спорном изменении CRM?" description="Пришлите тип элемента, тестовый ID, время и описание расхождения без клиентских данных. Поможем составить ручной маршрут проверки истории, прав и автоматизации." href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
  </section>

  <section aria-labelledby="regular">
    <h2 id="regular">Как использовать историю <span data-heading-accent>в диагностике CRM</span></h2>
    <p>Для повторяющейся проблемы сохраняйте короткую карточку проверки: ID элемента, ожидаемое и текущее значение, время события, автора записи, возможное правило автоматизации и результат теста. Это помогает отличить единичную ручную правку от настройки, которая меняет следующие сделки. Права на чтение истории давайте только тем, кому они нужны для работы, учитывая доступ к самим элементам CRM.</p>
    <p>MCP TrueTell для диагностики Битрикс24 находится в разработке. Автоматическое чтение истории CRM и готовую подписку сейчас не заявляем. Если хотите обсудить будущий контроль, сначала определим, какие события доступны в вашем портале и какие выводы должен подтверждать человек. О границах доступа ИИ к CRM — в <a href={`${base}bezopasnyy-dostup-ii-k-crm/`}>отдельной статье</a>.</p>
  </section>

  <FaqSection title="Частые вопросы об истории CRM Битрикс24" items={faqItems} variant="article" />
  <p>Официальная справка Битрикс24 проверена 1 ноября 2026 года. Скриншоты взяты из её демонстрационного портала; доступные события, интерфейс и тариф своего Битрикс24 проверяйте отдельно. Реальные изменения клиентской CRM для статьи не выполнялись.</p>
  <ArticleSources publishedIso={article.publishedAt} modifiedIso={article.updatedAt} sources={sourceLinks} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Обсудить диагностику CRM с ' }, { text: 'MCP TrueTell', accent: true }]} description={mcpProduct.articleDescription} href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <ConsultationCtaSection slot="after-article" />
</ArticleLayout>
