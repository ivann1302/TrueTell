---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { mcpProduct } from '../../config/products';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import routeImage from '../../images/articles/bitrix24-application-route-126.png';
import evidenceImage from '../../images/articles/bitrix24-application-evidence-126.png';

const article = getArticle('poteryannye-zayavki-bitrix24/');
const { title, description } = article;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const ogImage = new URL(routeImage.src, siteRoot).toString();
const imageAlt = 'Четыре контрольные точки заявки: отправка, запись в CRM, назначенный ответственный и первое действие менеджера';
const faqItems = [
  { question: 'После отправки формы нет лида. Значит, заявка потерялась?', answer: 'Не обязательно. В простом режиме CRM обращения становятся сделками; форма может быть настроена на другой тип элемента или добавить данные в последнюю активную сделку клиента. Проверьте настройки формы, затем ищите новую запись либо событие в таймлайне существующей сделки с учётом фильтров и прав.' },
  { question: 'Форма показала сообщение об успехе. Этого достаточно?', answer: 'Нет. Это подтверждает шаг на стороне формы, но для проверки маршрута нужно найти созданную или обновлённую запись в CRM, открыть её и сверить данные контрольного обращения.' },
  { question: 'Почему заявку получил не тот менеджер?', answer: 'Правило зависит от канала. У CRM-формы своя очередь ответственных, у почты, телефонии и открытой линии — свои настройки распределения. Зафиксируйте канал, время и ответственного в карточке, затем проверьте правило именно этого канала.' },
  { question: 'Если в карточке нет дела, менеджер не ответил?', answer: 'Отсутствие запланированного дела само по себе не доказывает, что ответа не было. Сверьте таймлайн карточки с письмом, звонком или диалогом и отдельно проверьте, какое первое действие требует ваш процесс. Автоматическое создание дела зависит от сценария и настроек.' },
  { question: 'Можно ли проверить все каналы одной тестовой заявкой?', answer: 'Нет. Сначала пройдите один конкретный маршрут. Форму, почту, телефон и открытую линию проверяйте отдельными контрольными обращениями: правила создания и распределения у них различаются.' },
  { question: 'MCP TrueTell уже находит потерянные заявки автоматически?', answer: 'Такую готовую функцию мы пока не заявляем. MCP TrueTell для Битрикс24 находится в разработке. Можно обсудить, какие контрольные точки и права нужны для будущего сценария регулярной диагностики на вашем портале.' },
];
const sourceLinks = [
  { label: 'Битрикс24: CRM-формы, публикация и создаваемые элементы', href: 'https://helpdesk.bitrix24.ru/open/28809760/' },
  { label: 'Битрикс24: настройка CRM-формы и использование активной сделки', href: 'https://helpdesk.bitrix24.ru/open/24730032' },
  { label: 'Битрикс24: события в таймлайне карточки CRM', href: 'https://helpdesk.bitrix24.ru/open/23960160/' },
  { label: 'Битрикс24: распределение обращений из форм, почты, телефонии и открытых линий', href: 'https://helpdesk.bitrix24.ru/open/27516124/' },
  { label: 'Битрикс24: простой и классический режимы CRM', href: 'https://helpdesk.bitrix24.ru/open/23440468/' },
  { label: 'Битрикс24: фильтры в CRM и тарифные ограничения', href: 'https://helpdesk.bitrix24.ru/open/24206616/' },
  { label: 'Битрикс24: права доступа к элементам CRM', href: 'https://helpdesk.bitrix24.ru/open/23240636/' },
  { label: 'Битрикс24: дела и фильтр «Нет дел»', href: 'https://helpdesk.bitrix24.ru/open/18388076/' },
];
const symptomRows = [
  ['Форма отправлена, новой записи не видно', 'Тип элемента и опция активной сделки в форме; таймлайн клиента; фильтр и права просмотра', 'Появилась ли новая карточка или данные добавились в существующую'],
  ['Запись есть, ответственный неожиданный', 'Ответственный в карточке и правило распределения выбранного канала', 'Кто получил обращение и почему его выбрало правило'],
  ['Ответственный верный, реакции не видно', 'Таймлайн, связанные письма, звонки и диалоги; запланированные дела', 'Было ли первое действие и кто должен его выполнить'],
];
const structuredData = createArticleStructuredData({
  articleType: 'Article', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  breadcrumbs: [{ name: 'Главная', item: siteRoot.toString() }, { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() }, { name: title, item: articleUrl }],
  faqItems,
});
---
<ArticleLayout {title} titleParts={[{ text: 'Где теряются заявки ' }, { text: 'в Битрикс24', accent: true }, { text: ': от формы до ответственного' }]} {description}
  canonicalPath={`/${article.hrefPath}`} {structuredData} ogTitle={article.seoTitle} ogDescription={description}
  {ogImage} ogImageAlt={imageAlt} category={article.category} author={authorName}
  intro="Отправили заявку с сайта, а менеджер её не увидел? Пройдите путь одного контрольного обращения: форма, запись в CRM, ответственный и первое действие. Так можно найти место сбоя до изменения настроек.">
  <Fragment slot="quick-answer">
    <p><strong>Отправьте одну тестовую заявку с узнаваемой меткой и запишите время. Затем найдите соответствующую запись в CRM, проверьте ответственного и первое действие в карточке.</strong></p>
    <p>Если запись не находится, проверьте тип элемента, фильтры и права просмотра. Если она есть, разбирайте правило распределения именно того канала, через который пришло обращение.</p>
  </Fragment>

  <p data-article-lead>Фраза «заявка потерялась» описывает несколько разных событий. Форма могла не передать данные, карточка могла оказаться в другом разделе CRM, запись мог получить другой сотрудник, а менеджер мог пропустить обращение уже после назначения. Для каждой причины нужен свой след. Ниже — способ собрать его на одном обращении, не меняя сразу всю CRM.</p>

  <section aria-labelledby="prepare">
    <h2 id="prepare">Подготовьте <span data-heading-accent>контрольную заявку</span></h2>
    <p>Выберите один канал и одну опубликованную форму. Договоритесь с ответственным сотрудником о тесте, чтобы он не принял обращение за реального клиента. Укажите свои тестовые контакты и узнаваемую метку, например «Проверка 30 октября, 14:20». Сохраните точное время отправки, адрес страницы формы и то, что показал браузер после отправки. Реальные клиентские данные для такой проверки не нужны.</p>
    <p>Для письма, звонка или открытой линии повторите опыт отдельно. У этих каналов другие правила создания и назначения записей. Один удачный тест формы ничего не доказывает о маршруте звонка.</p>
    <ArticleFigure src={routeImage} fullSize portrait alt={imageAlt} caption="Редакционная карта проверки одного обращения. Пример метки и времени учебный; схема не показывает экран Битрикс24 и не утверждает, что каждое обращение автоматически создаёт дело." />
  </section>

  <section aria-labelledby="find">
    <h2 id="find">Найдите запись <span data-heading-accent>в CRM</span></h2>
    <p>В настройках CRM-формы проверьте, какой элемент она создаёт или заполняет. Ищите контрольные данные в соответствующем разделе. В классическом режиме входящее обращение может стать лидом; в простом режиме лидов нет, а обращения проходят через сделки. Форма также может быть настроена на другой тип элемента. Поэтому пустой список лидов сам по себе не означает потерю заявки.</p>
    <p>Проверьте опцию «Использовать активную сделку, не создавать новую». Если она включена и клиент уже есть в CRM, отправка формы может попасть в таймлайн его последней активной сделки. Тогда новая карточка и новое время создания не появятся. Ищите тестовую метку и время события в существующей сделке по тестовому контакту.</p>
    <p>Снимите сохранённый фильтр и проверьте период, воронку и ответственного. Фильтры CRM доступны с учётом тарифа. Если запись видит администратор, но не видит менеджер, проверьте его права на чтение соответствующего элемента. Не расширяйте права на весь отдел только ради поиска одной карточки: сначала выясните, какая роль и какая запись не совпали с ожиданием.</p>
    <p>Когда новая или существующая карточка найдена, запишите её тип, ID и источник. Отдельно отметьте время события формы в таймлайне: оно не обязано совпадать со временем создания самой карточки. Сверьте тестовые поля с отправленной формой. Если данные отличаются, проверьте, действительно ли открыта запись этого обращения, а не похожая карточка от прежнего теста.</p>
  </section>

  <section aria-labelledby="assignee">
    <h2 id="assignee">Сверьте <span data-heading-accent>ответственного</span></h2>
    <p>Откройте найденную карточку и сравните поле «Ответственный» с тем, кто должен получить заявку по вашему правилу. У CRM-формы, почты, телефонии и открытой линии очереди и условия распределения настраиваются отдельно. Поэтому запишите канал и фактически назначенного человека, а затем откройте настройки именно этого канала. Изменение общей очереди наугад может затронуть другие обращения.</p>
    <p>Если карточка назначена правильно, проверьте, видел ли сотрудник её в своём рабочем списке и разрешают ли его права открыть запись. Если назначен другой человек, сохраните это как отдельный результат диагностики вместе с названием канала и временем обращения.</p>
    <DataTable label="Как отличить отсутствие записи от сбоя назначения и обработки" columns={['Что видно', 'Где проверить', 'Какой вывод нужен']} rows={symptomRows} rowHeaders />
  </section>

  <section aria-labelledby="first-action">
    <h2 id="first-action">Проверьте <span data-heading-accent>первое действие</span></h2>
    <p>Назначение ещё не означает, что клиент получил ответ. Посмотрите таймлайн карточки и связанные с ней письмо, звонок или диалог. Зафиксируйте время первого реального действия и сравните его с вашим внутренним сроком реакции. Отдельно проверьте, запланировано ли следующее дело, если этого требует ваш процесс. Битрикс24 позволяет находить элементы без дел через фильтр «Дела → Нет дел», но отсутствие дела не доказывает отсутствие ответа: события разных каналов и автоматизации устроены по-разному.</p>
    <ArticleFigure src={evidenceImage} fullSize portrait alt="Матрица результатов проверки: нет новой карточки, карточка скрыта, назначен другой сотрудник или нет первого действия" caption="Редакционная матрица результатов контрольного теста. Она разделяет наблюдение и следующий шаг; причины устанавливаются по настройкам и данным конкретного портала." />
    <p>Запишите итог в одной строке: канал, время отправки, ID новой или существующей карточки, фактический ответственный, первое действие и участок расхождения. Если после проверки типа элемента, опции активной сделки, фильтров и прав событие не найдено даже у администратора, передайте ему форму, время и тестовую метку для проверки настроек подключения. Если запись есть, ищите проблему дальше по маршруту — в назначении или обработке.</p>
  </section>

  <section aria-labelledby="repeat">
    <h2 id="repeat">Как превратить разовую проверку <span data-heading-accent>в контроль</span></h2>
    <p>Повторяйте контроль после изменения формы, очереди или прав: одна тестовая заявка до изменения и одна после него покажут, что изменилось на самом деле. Для регулярного контроля полезно отдельно фиксировать обращения без назначенного исполнителя, карточки без следующего дела и задержку первого ответа. Но состав такой проверки зависит от вашего процесса и доступных данных; универсального признака «потерянной заявки» для всех каналов нет.</p>
    <p>Мы разрабатываем MCP TrueTell для работы внешнего ИИ с данными Битрикс24. Сейчас не заявляем готовую автоматическую диагностику или открытую подписку. Если хотите обсудить будущий сценарий, пришлите схему ваших каналов, пример контрольного обращения и перечень полей, которые можно безопасно читать. О том, <a href={`${base}bezopasnyy-dostup-ii-k-crm/`}>как ограничить доступ ИИ к CRM</a>, мы рассказали отдельно.</p>
    <InlineConsultation variant="product" title="Нужна карта проверки вашей CRM?" description="Опишите, из какого канала приходят заявки, где должна появляться карточка и кто отвечает первым. Обсудим ручную диагностику и требования к будущему сценарию MCP TrueTell." href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
  </section>

  <FaqSection title="Частые вопросы о потерянных заявках" items={faqItems} variant="article" />
  <p>Справка Битрикс24 проверена 30 октября 2026 года. Тесты на клиентском портале для этого материала не выполнялись; названия пунктов и права сверяйте в своей конфигурации.</p>
  <ArticleSources publishedIso={article.publishedAt} modifiedIso={article.updatedAt} sources={sourceLinks} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Обсудим ' }, { text: 'MCP TrueTell для Битрикс24', accent: true }]} description={mcpProduct.articleDescription} href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <ConsultationCtaSection slot="after-article" />
</ArticleLayout>
