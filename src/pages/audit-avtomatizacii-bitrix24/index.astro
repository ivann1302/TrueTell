---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { mcpProduct } from '../../config/products';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import robotOrderImage from '../../images/articles/bitrix24-robot-order-official-106.jpg';
import bpProtocolImage from '../../images/articles/bitrix24-bp-protocol-official-106.jpg';

const article = getArticle('audit-avtomatizacii-bitrix24/');
const { title, description } = article;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const ogImage = new URL(robotOrderImage.src, siteRoot).toString();
const imageAlt = 'Официальный экран Битрикс24: выбор запуска робота после предыдущего или независимо от других роботов';
const faqItems = [
  { question: 'С чего начать аудит автоматизации CRM Битрикс24?', answer: 'Выберите один важный маршрут сделки и запишите для каждой его стадии действующие роботы, условия, время, очередь и ожидаемое действие. Добавьте бизнес-процессы, которые запускаются для того же элемента. Затем сравните карту с контрольной сделкой и протоколом исполнения.' },
  { question: 'Как понять, что два робота конфликтуют?', answer: 'Совпадение названия действия ещё не доказывает конфликт. Проверьте, работают ли они на одной стадии и для одной сделки, какие у них условия и очередь, и что произошло в карточке. Ищите повторные письма или задачи, конкурирующие изменения одного поля и переход стадии до отложенного действия.' },
  { question: 'Где смотреть историю робота и бизнес-процесса?', answer: 'Для робота проверьте статус во вкладке «Роботы» карточки, а последовательность срабатываний — в отладчике на тестовой сделке. Для бизнес-процесса смотрите его статус и Протокол. Журнал отладки БП включают отдельно для каждого шаблона на семь дней; он не заменяет отладчик роботов.' },
  { question: 'Почему старый робот продолжает работать после правки или удаления?', answer: 'По справке Битрикс24 экземпляры автоматизации, запущенные до изменения или удаления, продолжают сценарий в прежнем виде. Проверьте активный экземпляр в конкретной карточке и решите отдельно, нужно ли его завершить и запустить новый.' },
  { question: 'Проверит ли MCP TrueTell всю автоматизацию автоматически?', answer: 'Готовую полную проверку роботов и бизнес-процессов мы не заявляем. MCP TrueTell для настройки и диагностики CRM находится в разработке. Карта маршрутов и контрольные случаи помогут определить, какие сигналы и права нужны будущему сценарию.' },
];
const sourceLinks = [
  { label: 'Битрикс24: очередь, время и условия роботов', href: 'https://helpdesk.bitrix24.ru/open/21491832/' },
  { label: 'Битрикс24: причины сбоев роботов и бизнес-процессов', href: 'https://helpdesk.bitrix24.ru/open/23046316/' },
  { label: 'Битрикс24: бизнес-процессы, список и протокол', href: 'https://helpdesk.bitrix24.ru/open/21290220/' },
  { label: 'Битрикс24: журнал отладки бизнес-процессов', href: 'https://helpdesk.bitrix24.ru/open/21994508/' },
  { label: 'Битрикс24: отладка роботов на тестовой сделке', href: 'https://helpdesk.bitrix24.ru/open/19361194/' },
  { label: 'Битрикс24: остановка роботов на стадии', href: 'https://helpdesk.bitrix24.ru/open/23435880/' },
  { label: 'Битрикс24: ограничение на запуск бизнес-процессов в CRM', href: 'https://helpdesk.bitrix24.ru/open/22314594/' },
];
const mapRows = [
  ['Вход в стадию', 'Тип сделки, воронка, стадия, заполненные к этому моменту поля', 'ID контрольной сделки и время входа'],
  ['Роботы', 'Название, условие, время, очередь, действие и целевое поле или получатель', 'Что произошло в карточке и в логе отладчика'],
  ['Бизнес-процессы', 'Шаблон, условие запуска, активный экземпляр, ожидаемый участник и результат', 'Статус, шаг в Протоколе и ссылка на экземпляр'],
  ['Внешние подключения', 'Приложение или вебхук, которое меняет то же поле либо стадию', 'Время изменения и владелец подключения; без токена в журнале'],
];
const riskRows = [
  ['Ответственный меняется повторно', 'Два действия или подключение пишут в одно поле', 'Сравнить время изменений, условия и того, от чьего имени они выполнены'],
  ['Клиент получил два письма', 'На одном маршруте есть два действия отправки', 'Сверить стадии, условия и фактическую историю отправки'],
  ['Отложенное действие не выполнилось', 'Сделка ушла со стадии до времени запуска', 'Проверить переход стадии и статус ожидавшего робота'],
  ['Сценарий после правки выглядит старым', 'Экземпляр стартовал до изменения шаблона', 'Сопоставить время запуска и версию настройки; новый тест проводить на новой сделке'],
];
const structuredData = createArticleStructuredData({
  articleType: 'BlogPosting', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  breadcrumbs: [{ name: 'Главная', item: siteRoot.toString() }, { name: 'Блог', item: new URL('blog/', siteRoot).toString() }, { name: title, item: articleUrl }],
  faqItems,
});
---
<ArticleLayout {title} titleParts={[{ text: 'Аудит автоматизации Битрикс24: ' }, { text: 'где конфликтуют роботы и процессы', accent: true }]} {description}
  canonicalPath={`/${article.hrefPath}`} {structuredData} ogTitle={article.seoTitle} ogDescription={description}
  {ogImage} ogImageAlt={imageAlt} category={article.category} author={authorName}
  intro="Два правила меняют ответственного, письмо приходит дважды или согласование зависает после перехода сделки. Чтобы найти причину, нужно увидеть всю цепочку действий на одном маршруте: от входа в стадию до результата в карточке.">
  <Fragment slot="quick-answer">
    <p><strong>Составьте карту автоматизации для одного маршрута сделки.</strong> Запишите роботов и бизнес-процессы на каждой стадии, их условия, время и действие. Затем проведите контрольную сделку и сравните настройку с тем, что реально произошло: полями, делами, сообщениями, статусами роботов и Протоколом БП. Совпадение двух действий — повод проверить исполнение, а не доказательство ошибки.</p>
  </Fragment>

  <p data-article-lead>Когда менеджер говорит «автоматизация мешает», причина может лежать не в последнем роботе, который виден в карточке. Поле могло измениться раньше, бизнес-процесс ждать согласования, а интеграция заполнить данные после проверки условия. Начните с конкретной сделки и воспроизводимого результата: кто должен был получить задачу, какое поле должно было измениться и когда.</p>

  <section aria-labelledby="scope">
    <h2 id="scope">Ограничьте аудит <span data-heading-accent>одним маршрутом</span></h2>
    <p>Выберите воронку и путь, на котором есть жалоба: например, новая сделка → согласование → счёт. Для каждой стадии выпишите роботов и триггеры, а также шаблоны бизнес-процессов, которые запускаются для этого элемента. У робота важны условие, время, очередь и действие. У процесса — условие старта, участники, ожидаемое завершение и активные экземпляры. Если приложение или вебхук меняет те же поля, добавьте его в карту как отдельного участника.</p>
    <p>Это рабочая таблица аудита, а не выгрузка всей конфигурации Битрикс24 одной кнопкой. Укажите ID контрольной сделки и время перехода между стадиями; клиентские данные и секреты подключения в таблицу не копируйте. Для первой проверки достаточно одного проблемного маршрута и одного похожего, который работает правильно.</p>
    <DataTable label="Что записать для аудита цепочки автоматизации" columns={['Участок', 'Настройка', 'Наблюдаемое доказательство']} rows={mapRows} rowHeaders />
  </section>

  <section aria-labelledby="overlap">
    <h2 id="overlap">Найдите действия, <span data-heading-accent>которые пересекаются</span></h2>
    <p>Отметьте все действия, которые пишут в одно поле, двигают стадию, создают задачу или отправляют сообщение на одном пути. Сравните их условия и момент запуска. Робот может ждать предыдущего действия на стадии или работать независимо; даже одинаковая настройка «сразу» у робота и бизнес-процесса не гарантирует одинаковое время завершения. Официальная справка описывает порядок их старта, но фактический результат зависит и от длительности действий.</p>
    <ArticleFigure src={robotOrderImage} fullSize alt={imageAlt} caption="Подлинный экран выбора очереди робота из справки Битрикс24 «Как работают условия в роботах», обновлённой 23.07.2026. Это демонстрационная настройка, не конфигурация TrueTell или клиента." />
    <p>Таблица ниже — примеры для проверки, не утверждение, что такие сбои есть на вашем портале. Два робота с похожими названиями могут работать для разных сегментов. Конфликт подтверждается только после сравнения условий и результата на конкретной карточке. Если проблема касается одного действия, используйте <a href={`${base}robot-ne-srabatyvaet-bitrix24/`}>инструкцию по отладке робота</a>; здесь задача шире — найти пересечение всей цепочки.</p>
    <DataTable label="Типовые сигналы для проверки пересечений" columns={['Наблюдение', 'Возможная причина', 'Что сравнить']} rows={riskRows} rowHeaders />
  </section>

  <section aria-labelledby="evidence">
    <h2 id="evidence">Сверьте настройку <span data-heading-accent>с исполнением</span></h2>
    <p>Откройте карточку контрольной сделки: проверьте историю полей, дела и вкладку «Роботы». Для последовательности действий робота запустите отладчик на новой тестовой сделке с теми же значениями полей. Справка Битрикс24 описывает этот отладчик для сделок; сотруднику требуется право «Разрешить изменять настройки CRM». Тестовая сделка может создать реальные задачи или отправить сообщения, если в ней указаны рабочие адреса, поэтому используйте согласованные учебные данные и проверьте побочные действия.</p>
    <p>Для бизнес-процесса откройте раздел «Автоматизация» → «Бизнес-процессы» → «Процессы», найдите нужный экземпляр и посмотрите статус и Протокол. Протокол показывает действия и участников процесса. Для технической отладки журнал БП включают отдельно в каждом шаблоне: запись действует семь дней. Журнал не служит полной историей всех повторных срабатываний робота — для этого у Битрикс24 есть отдельный отладчик.</p>
    <ArticleFigure src={bpProtocolImage} fullSize alt="Официальный экран Битрикс24 «Протокол» с этапами и участниками бизнес-процесса" caption="Подлинный экран Протокола из справки Битрикс24 «Бизнес-процессы: интерфейс и возможности», обновлённой 23.07.2026. Имена, документ и время выполнения принадлежат демонстрационному примеру." />
    <p>Если в облачном портале на одном элементе CRM накопилось много незавершённых процессов, учитывайте ограничение Битрикс24: одновременно допускается не более десяти таких экземпляров. Оно не распространяется на роботов, созданных в дизайнере бизнес-процессов. Автоматически запускаемые при создании или изменении элемента процессы выполняются по очереди; без долгих ожиданий они могут завершаться последовательно и не занимать все десять мест. Лимит — отдельная возможная причина задержки, а не универсальное объяснение сбоя. В коробочной версии он настраивается отдельно.</p>
  </section>

  <section aria-labelledby="change">
    <h2 id="change">Исправляйте цепочку <span data-heading-accent>по одному изменению</span></h2>
    <p>Сохраните исходную карту и результат контрольной сделки. Затем измените одно условие, порядок или действие и повторите тест на новой сделке. Уже запущенные роботы и бизнес-процессы продолжают прежний сценарий даже после правки или удаления настройки. Если старый экземпляр мешает рабочей карточке, найдите и завершите его отдельно по согласованному плану; удаление шаблона не является проверкой остановки активных экземпляров.</p>
    <p>После теста проверьте не только лог, но и конечный результат: одно назначение ответственного, одно письмо, нужная стадия, задача с верным сроком. Запишите ID, ожидаемый и фактический результат, настройку, которую изменили, и владельца следующей проверки. Для регулярного контроля добавьте повторяющиеся отклонения в <a href={`${base}ezhenedelnaya-diagnostika-crm-bitrix24/`}>еженедельную диагностику CRM</a>.</p>
    <p>MCP TrueTell для настройки и диагностики CRM находится в разработке. Мы можем обсудить, какие контрольные сигналы из этой карты имеет смысл проверять в будущем и какие права для этого нужны. Готовый автоматический аудит всех роботов, чтение всех журналов и исправление процессов сейчас не заявляем.</p>
    <InlineConsultation variant="product" title="Нужно разобраться с цепочкой автоматизации?" description="Опишите один маршрут сделки, ожидаемый и фактический результат без данных клиентов и токенов. Поможем наметить проверку и обсудим будущий диагностический сценарий MCP TrueTell." href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
  </section>

  <FaqSection title="Частые вопросы об аудите автоматизации Битрикс24" items={faqItems} variant="article" />
  <p>Официальная справка Битрикс24 проверена 31 октября 2026 года. Скриншоты взяты из её демонстрационных примеров. Конфигурация клиентского портала и работа MCP TrueTell в описанном сценарии не проверялись.</p>
  <ArticleSources publishedIso={article.publishedAt} modifiedIso={article.updatedAt} sources={sourceLinks} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Обсудим ' }, { text: 'диагностику CRM с MCP TrueTell', accent: true }]} description={mcpProduct.articleDescription} href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <ConsultationCtaSection slot="after-article" />
</ArticleLayout>
