---
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import importRowsImage from '../../images/articles/bitrix24-deal-import-rows-107.png';
import dealFilterImage from '../../images/articles/bitrix24-deal-filter-native.png';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';

const article = getArticle('import-sdelok-bitrix24/');
const title = article.title;
const seoTitle = article.seoTitle ?? title;
const description = article.description;
const canonicalPath = '/' + article.hrefPath;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const ogImage = new URL(importRowsImage.src, siteRoot).toString();
const ogImageAlt = 'Памятка TrueTell по строкам CSV при импорте сделок Битрикс24';
const titleParts = [
  { text: 'Импорт сделок в Битрикс24 из Excel: ' },
  { text: 'стадии, клиенты и суммы', accent: true },
];
const sourceLinks = [
  { label: 'Как импортировать элементы CRM без реквизитов — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/25999954/' },
  { label: 'Как импортировать связанные компании, контакты и сделки — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/27844102/' },
  { label: 'Сделки: что это и как с ними работать — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/26161116/' },
  { label: 'Воронки продаж и стадии — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/20732764/' },
  { label: 'Как работать с режимами расчёта суммы сделки — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/27634104/' },
  { label: 'Частые вопросы о CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/25817644/' },
  { label: 'Ролевая модель прав в CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/23240636/' },
];
const checkRows = [
  ['Воронка и стадия', 'Карточка находится в нужном направлении и этапе', 'Сверить значения файла с действующими стадиями портала и сопоставлением полей'],
  ['Компания и контакт', 'В сделке открываются нужные клиентские карточки', 'Проверить точное написание названия компании, имени и фамилии контакта'],
  ['Ответственный', 'Сделка видна сотруднику, который должен с ней работать', 'Сверить значение и доступ сотрудника в портале, затем повторить тест'],
  ['Сумма и товары', 'Сумма соответствует источнику, товарные строки собраны в одной сделке', 'Проверить режим расчёта суммы и ID строк файла'],
];
const faqItems = [
  {
    question: 'Можно ли импортировать сделки в Битрикс24 прямо из Excel?',
    answer: 'Штатный мастер загружает CSV. Подготовьте таблицу в Excel, сохраните отдельную копию в CSV, затем в CRM → Сделки → Настройки → Импорт сделок скачайте шаблон своего портала и сопоставьте столбцы.',
  },
  {
    question: 'Можно ли импортом обновить уже существующие сделки?',
    answer: 'Нет. Штатный CSV-импорт сделок создаёт новые карточки. Сделка с тем же названием загрузится повторно, поэтому перед повторным запуском проверьте, какие строки уже попали в CRM.',
  },
  {
    question: 'Как привязать импортируемую сделку к компании и контакту?',
    answer: 'Сначала загрузите компании и контакты. В CSV сделок заполните поля «Компания» и «Контакт» названиями и именем с фамилией точно как в CRM. При сопоставлении свяжите столбцы с одноимёнными полями, а после теста откройте карточки и проверьте связи.',
  },
  {
    question: 'Почему сделка оказалась не в той стадии?',
    answer: 'Сверьте воронку и набор стадий в своём портале, значение стадии в CSV и сопоставление этого столбца в мастере. После пробной загрузки проверяйте результат в карточке и фильтре списка сделок.',
  },
  {
    question: 'Как импортировать сделку с несколькими товарами?',
    answer: 'В шаблоне используйте отдельную строку для каждого товара и одинаковый ID сделки в этих строках. Проверьте товарные позиции и итоговую сумму в созданной карточке; сумма может рассчитываться вручную или автоматически по товарам.',
  },
  {
    question: 'Сохранится ли исходная дата закрытия завершённой сделки?',
    answer: 'При импорте завершённых сделок системная дата закрытия заменяется датой загрузки файла. Если историческая дата важна, проверьте специальную процедуру из справки Битрикс24: импорт в пользовательское поле и перенос роботом. Сначала испытайте её на пробной сделке.',
  },
  {
    question: 'Что делать, если часть строк уже загружена?',
    answer: 'Не запускайте прежний файл целиком ещё раз: штатный импорт не обновит созданные сделки и может добавить дубли. Сравните список сделок с исходной таблицей, выделите незагруженные строки и проверьте их отдельной пробной партией.',
  },
];
const relatedArticles = getRelatedArticles(article.hrefPath)
  .map((item) => ({ ...item, description: item.summaryDescription ?? item.description, href: base + item.hrefPath }));
const structuredData = createArticleStructuredData({
  articleType: 'Article',
  title,
  description,
  articleUrl,
  publishedDate: article.publishedAt,
  modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(),
  author: authorName,
  image: ogImage,
  articleSection: 'Импорт сделок Битрикс24',
  breadcrumbs: [
    { name: 'Главная', item: siteRoot.toString() },
    { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() },
    { name: title, item: articleUrl },
  ],
  faqItems,
});
---

<ArticleLayout
  title={seoTitle} {titleParts} {description} {canonicalPath} {structuredData}
  ogTitle={seoTitle} ogDescription={description} {ogImage} {ogImageAlt}
  category={article.category} author={authorName}
  publishedTime={article.publishedAt} modifiedTime={article.updatedAt}
  intro="Для штатного импорта сделок подготовьте CSV по шаблону своего Битрикс24. Сначала проверьте клиентские карточки и стадии воронки, затем загрузите несколько сделок и сверьте результат. Повторный импорт не обновляет существующие сделки."
>
  <Fragment slot="quick-answer">
    <p>Откройте <strong>CRM → Сделки → Настройки (⚙️) → Импорт сделок</strong>, скачайте шаблон и сохраните подготовленную в Excel таблицу как CSV. Сопоставьте столбцы файла с полями сделки, загрузите небольшую партию и откройте созданные карточки.</p>
    <p>Проверьте воронку, стадию, ответственного, сумму и связи с компанией и контактом. <strong>Импорт добавляет только новые сделки:</strong> при повторной загрузке строки с тем же названием могут создать дубль.</p>
  </Fragment>

  <p data-article-lead>В таблице продажи часто стоят рядом с клиентами и товарными позициями. При переносе в Битрикс24 ошибка может проявиться уже после успешной загрузки файла: сделка окажется не на той стадии или без клиента. Поэтому пробную партию оценивайте по карточкам CRM, а не только по сообщению мастера об окончании импорта.</p>

  <section aria-labelledby="prepare">
    <h2 id="prepare">Что подготовить <span data-heading-accent>до загрузки CSV</span></h2>
    <p>Штатный мастер принимает CSV. Сохраните исходный Excel-файл и сделайте отдельную копию для загрузки. Шаблон скачивайте из своего портала: он показывает поля сделки, с которыми работает текущая настройка CRM. Убедитесь, что сотруднику дано право на импорт элементов.</p>
    <p>Если данные переносятся из другой системы, сначала заведите в CRM нужные компании и контакты. Сделку можно автоматически связать только с уже существующими клиентскими карточками. Порядок их загрузки разобран в <a href={base + 'import-kontaktov-kompaniy-bitrix24/'}>отдельной инструкции по импорту клиентов</a>.</p>
    <p>До редактирования CSV откройте в портале нужные воронки и стадии. Название этапа из старой CRM может обозначать другой шаг продажи в новой. Составьте для своей команды соответствие: исходный этап, целевая воронка, целевая стадия. Для настройки самих воронок используйте <a href={sourceLinks[3].href} target="_blank" rel="noopener noreferrer">справку Битрикс24</a>; названия и доступность стадий проверяйте в своём портале.</p>
  </section>

  <section aria-labelledby="file">
    <h2 id="file">Как заполнить <span data-heading-accent>строки сделки</span></h2>
    <p>В столбце ID файла пронумеруйте сделки по порядку: один номер для одной сделки. Если в сделке несколько товаров, запишите каждый товар отдельной строкой с тем же ID. Этот номер помогает мастеру собрать строки файла в одну сделку; он не означает обновление карточки с таким ID в CRM.</p>
    <ArticleFigure src={importRowsImage} fullSize portrait alt="Учебный CSV: две строки товаров с ID 1 относятся к одной сделке, строка с ID 2 — к другой" caption="Учебный пример TrueTell по правилу из справки Битрикс24. Названия и цены условные; схему столбцов и работу с товарами сверяйте с шаблоном своего портала." />
    <p>В столбцах «Компания» и «Контакт» используйте данные уже существующих карточек. Битрикс24 связывает элементы по названию компании и имени с фамилией контакта; отличие хотя бы в одном символе может помешать связи. Если есть однофамильцы или похожие организации, вручную проверьте созданные связи перед основной загрузкой.</p>
    <p>Для стадии, ответственного и суммы не подставляйте значения наугад. Возьмите их из согласованной карты переноса и сопоставьте с полями мастера. Отдельно проверьте валюту, если в источнике сделки в разных валютах. В карточке Битрикс24 сумма может быть указана вручную или рассчитана по товарам, поэтому итог после импорта надо сравнить с исходным документом.</p>
  </section>

  <section aria-labelledby="wizard">
    <h2 id="wizard">Как пройти <span data-heading-accent>мастер импорта</span></h2>
    <p>Перейдите в CRM → Сделки, откройте меню настроек и выберите «Импорт сделок». Скачайте шаблон, подготовьте CSV и загрузите файл. На шаге соответствия полей слева показаны поля CRM, справа — столбцы файла. Если мастер не узнал колонку или сопоставил её неверно, нажмите «Выбрать» или «Изменить» и задайте нужный столбец вручную.</p>
    <p>Начните с нескольких разных сделок: одной без товаров, одной с несколькими товарами и одной со связанной компанией или контактом. Эти примеры нужны для проверки вашего файла, а не являются требованием Битрикс24 к минимальному размеру партии. После завершения мастер предложит «Завершить» либо «Начать заново» для другого файла.</p>
    <p><strong>Одноимённые сделки не считаются обновлением.</strong> По <a href={sourceLinks[1].href} target="_blank" rel="noopener noreferrer">официальной инструкции</a>, существующую сделку штатным импортом обновить нельзя; совпавшее название загрузится повторно. Перед следующим запуском уберите уже созданные записи из файла и сверяйте их по карточкам и исходной таблице.</p>
  </section>

  <section aria-labelledby="verify">
    <h2 id="verify">Что проверить <span data-heading-accent>после пробной партии</span></h2>
    <p>Откройте созданные сделки в CRM, проверьте поля карточки и перейдите к связанным клиентам. Затем в режиме списка отберите пробные сделки по известным признакам: названию, ответственному, воронке или стадии. Фильтр показывает выбранные карточки; он не доказывает правильность каждой строки без открытия сделки.</p>
    <ArticleFigure src={dealFilterImage} fullSize alt="Реальный фильтр списка сделок Битрикс24 с полями группы стадий, стадии и даты создания" caption="Скриншот фильтра из статьи TrueTell об удалении проигранных сделок. Даты 01.10.2026–31.10.2026 относятся к исходному экрану; условия на нём ещё не применены. Для своей пробной партии задайте собственный период и стадию." />
    <DataTable label="Контроль пробной загрузки сделок" columns={['Поле', 'Ожидаемый результат', 'Если не совпало']} rows={checkRows} rowHeaders compact />
    <p>Если сумма не совпала, откройте вкладку товаров и проверьте режим расчёта. При автоматическом режиме итог меняется по товарным позициям, их количеству, ценам и скидкам; при ручном сумма задаётся отдельно. По окончании проверки сохраните перечень уже созданных сделок и исправьте исходный CSV перед основным запуском.</p>
  </section>

  <section aria-labelledby="closed-deals">
    <h2 id="closed-deals">Особенность <span data-heading-accent>завершённых сделок</span></h2>
    <p>Для исторических сделок отдельно проверьте дату закрытия. <a href={sourceLinks[0].href} target="_blank" rel="noopener noreferrer">Поддержка24 предупреждает</a>: при импорте завершённой сделки системная дата закрытия заменяется датой загрузки файла. Если важна старая дата, Битрикс24 описывает отдельный сценарий с пользовательским полем и роботом. Он включает настройку автоматизации и перемещение карточек по стадиям; испытывайте его на нескольких записях до массового переноса.</p>
    <p>Если вам нужно перенести историю стадий, дела или документы, не предполагайте, что CSV-шаблон сделки восстановит их автоматически. Сначала перечислите требуемые данные и проверьте для каждого способ переноса. При сложной миграции пригодится <a href={base + 'karta-sootvetstviya-poley-bitrix24/'}>карта соответствия полей</a>; для анализа результата по этапам — <a href={base + 'voronka-prodazh-bitrix24/'}>разбор воронки продаж</a>.</p>
    <InlineConsultation title="Переносите сделки из другой CRM?" description="Поможем разобрать поля, стадии и клиентские связи на пробной выборке, прежде чем загружать всю историю." actionLabel="Обсудить перенос" />
  </section>

  <FaqSection items={faqItems} id="faq" variant="article" />
  <ArticleSources publishedIso={article.publishedAt} sources={sourceLinks} />
  <Fragment slot="article-end"><RelatedArticles items={relatedArticles} /></Fragment>
  <Fragment slot="after-article"><ConsultationCtaSection title="Нужно проверить перенос сделок?" description="Сверим CSV, соответствие стадий и результат пробной загрузки в CRM." actionLabel="Обсудить задачу" /></Fragment>
</ArticleLayout>
