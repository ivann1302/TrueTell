---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import DataTable from '../../components/editorial/data-table.astro';
import Checklist from '../../components/editorial/checklist.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { productRating, productRatingPath } from '../../config/products';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import paretoImage from '../../images/articles/abc-pareto-example-087.png';
import matrixImage from '../../images/articles/abc-xyz-matrix-example-087.png';
import productImage from '../../images/products/product-rating/rating-products-2026-10-renamed.jpg';
import example from '../../data/articles/abc-xyz-example-087.json';

const article = getArticle('abc-xyz-analiz-tovarov/');
const { title, description } = article;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const canonicalPath = `/${article.hrefPath}`;
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const imageAlt = 'Учебный ABC-анализ восьми товаров: сумма продаж по SKU и накопленная доля, границы 80 и 95 процентов';
const ogImage = new URL(paretoImage.src, siteRoot).toString();
const titleParts = [{ text: 'ABC/XYZ-анализ товаров: ' }, { text: 'расчёт, матрица и решения', accent: true }];
const fmt = (value: number, digits = 2) => value.toLocaleString('ru-RU', { minimumFractionDigits: digits, maximumFractionDigits: digits });
const rawRows = example.items.map(item => [item.sku, ...item.months.map(String), fmt(item.price, 0)]);
const abcRows = example.items.map(item => [item.sku, fmt(item.amount, 0), `${fmt(item.share)}%`, `${fmt(item.cumulativeAfter)}%`, item.abc]);
const xyzRows = example.items.map(item => [item.sku, fmt(item.mean), fmt(item.stdPopulation), `${fmt(item.cvPercent)}%`, item.cell]);
const decisions = [
  ['AX', 'Большой вклад, небольшой разброс', 'Проверить доступность товара и причины возможных перебоев.'],
  ['AY', 'Большой вклад, умеренный разброс', 'Разобрать тренд, сезон и акции до изменения плана.'],
  ['AZ', 'Большой вклад, сильный разброс', 'Проверить разовые заказы и зависимость от отдельных покупателей.'],
  ['BX', 'Средний вклад, небольшой разброс', 'Сравнить условия поставки и расходы на поддержание позиции.'],
  ['BY', 'Средний вклад, умеренный разброс', 'Выделить повторяющиеся факторы и проверить следующий период.'],
  ['BZ', 'Средний вклад, сильный разброс', 'Проверить, нужен ли запас или возможна работа под заказ.'],
  ['CX', 'Небольшой вклад, небольшой разброс', 'Проверить роль товара в ассортименте и сопутствующих продажах.'],
  ['CY', 'Небольшой вклад, умеренный разброс', 'Проверить сезонность и достаточность истории.'],
  ['CZ', 'Небольшой вклад, сильный разброс', 'Разобрать каждую позицию: новинка, редкий заказ, дефицит или кандидат на вывод.'],
];
const faqItems = [
  { question: 'В чём разница между ABC- и XYZ-анализом?', answer: 'ABC ранжирует товары по вкладу в выбранный показатель: например, сумму продаж. XYZ описывает относительный разброс продаж или потребления по одинаковым интервалам. Совместная группа показывает обе характеристики, но не заменяет проверку причин и условий поставки.' },
  { question: 'Пороги 80/95% и 10/25% обязательны?', answer: 'Нет. Здесь 80 и 95% выбраны для ABC, а 10 и 25% — для XYZ в учебном примере. Настройки и способ обработки товара на границе нужно записывать. В других системах и категориях могут использоваться другие пороги.' },
  { question: 'Почему товар T03 попал в A, хотя накопленная доля уже 80,55%?', answer: 'В примере класс определяется по накопленной доле до добавления товара. Перед T03 она равна 61,73%, поэтому он остаётся в A и завершает эту группу. Следующий товар уже относится к B. При другом правиле границы состав групп может отличаться.' },
  { question: 'Как учитывать месяцы без продаж?', answer: 'Подтверждённый месяц без продаж записывают числом 0. Пустая ячейка означает отсутствие данных и требует проверки: Excel может пропустить её при расчёте. Если весь ряд равен нулю, среднее равно нулю и CV не определён; такую позицию рассматривают отдельно от XYZ.' },
  { question: 'Сколько месяцев нужно для XYZ?', answer: 'Единого срока для всех товаров нет. Интервалы и длина истории должны соответствовать циклу продаж. Шесть месяцев в статье нужны для учебного расчёта; они не позволяют сами по себе оценить годовую сезонность. Новинки и товары с неполной историей разбирают отдельно.' },
  { question: 'Товар CZ нужно убрать из ассортимента?', answer: 'Класс CZ — повод для проверки. Малый вклад и сильный разброс могут объясняться редкими заказами, дефицитом, недавним запуском или ролью сопутствующего товара. До решения нужны данные о наличии, марже, поставках и назначении позиции.' },
  { question: 'Можно ли считать ABC по количеству, а XYZ по деньгам?', answer: 'Это возможно как отдельно заданная методика, но смысл матрицы изменится. В статье ABC считается по условной сумме продаж, XYZ — по количеству в штуках. Нельзя незаметно менять показатель или складывать разные валюты и единицы измерения.' },
  { question: 'Строит ли «ABC анализ товаров и клиентов» XYZ-матрицу?', answer: 'В приложении есть ABC-анализ товаров и клиентов по данным CRM, динамика и экспорт. XYZ, складские остатки, закупки, маржа и прогнозирование в подтверждённый набор не входят. Расчёт XYZ в статье — самостоятельная методика на учебных данных.' },
];
const sourceLinks = [
  { label: 'ABC/XYZ: вклад и динамика потребления — SAP Help', href: 'https://help.sap.com/docs/SAP_SUPPLY_CHAIN_MANAGEMENT/5632d7cbffa04b21be22106e9a212038/4d33d92edb9e00d3e10000000a42189b.html' },
  { label: 'XYZ: настраиваемые пороги и повторная классификация — SAP Help', href: 'https://help.sap.com/docs/SAP_S4HANA_CLOUD/2bba750d1e124e1ea2a039bb1cd9b6c5/715c9c1479234351a27c9c01fce32cec.html' },
  { label: 'Коэффициент вариации и ограничения при малом среднем — NIST', href: 'https://www.itl.nist.gov/div898/software/dataplot/refman2/auxillar/coefvari.htm' },
  { label: 'STDEV.P: стандартное отклонение с делителем n — Microsoft', href: 'https://support.microsoft.com/en-us/excel/functions/stdev-p-function' },
  { label: 'STDEV.S: выборочное отклонение с делителем n − 1 — Microsoft', href: 'https://support.microsoft.com/en-us/excel/functions/stdev-s-function' },
];
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const structuredData = createArticleStructuredData({ articleType: 'BlogPosting', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt, publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  articleSection: article.topic,
  breadcrumbs: [{ name: 'Главная', item: siteRoot.toString() }, { name: 'Блог', item: new URL('blog/', siteRoot).toString() }, { name: title, item: articleUrl }], faqItems,
});
---
<ArticleLayout {title} {titleParts} {description} {canonicalPath} {structuredData}
  ogTitle={article.seoTitle} ogDescription={description} {ogImage} ogImageAlt={imageAlt}
  category={article.category} author={authorName}
  intro="Считаем вклад восьми товаров в продажи и разброс их количества по месяцам. Показываем, как получить группы AX–CZ и какие проверки нужны перед решением по ассортименту."
>
  <Fragment slot="quick-answer">
    <p><strong>ABC показывает вклад товара в выбранный результат, XYZ — насколько меняются продажи по интервалам. Совместная матрица помогает определить, какие позиции и причины стоит проверить в первую очередь.</strong></p>
    <p>В учебном примере ABC считаем по сумме продаж с порогами 80/95%, XYZ — по месячному количеству с порогами CV 10/25%. Данные и расчёт можно скачать. Группа не задаёт автоматически объём закупки и не является прогнозом.</p>
  </Fragment>
  <p data-article-lead>Два товара могут давать большую сумму продаж по разным причинам. Один покупают каждый месяц, другой попал в крупный разовый заказ. ABC выделит оба по вкладу, а XYZ поможет увидеть различие в разбросе. После этого можно проверить причину и выбрать действие, не принимая буквы в таблице за готовое решение.</p>
  <section aria-labelledby="metrics">
    <h2 id="metrics">Сначала выберите <span data-heading-accent>смысл показателей</span></h2>
    <p>Для ABC подходит один заранее выбранный показатель: сумма продаж, количество или иной измеримый вклад. ABC по сумме и ABC по валовой прибыли отвечают на разные вопросы. Если лидер по обороту почти не приносит прибыли, его группа по другому показателю может измениться.</p>
    <p>В этой статье ABC строится по условной сумме продаж в рублях: количество умножается на постоянную цену. XYZ — по количеству в штуках за одинаковые месячные интервалы. Поэтому первая буква описывает денежный вклад, вторая — разброс количества. Все значения вымышлены; цены заданы без налогов и возвратов для простоты арифметики.</p>
    <p>Один SKU или вариант товара должен иметь стабильный идентификатор. Не объединяйте разные позиции по похожему названию. Разные валюты сначала приводят к согласованной базе, а количество в штуках не складывают с килограммами как один показатель.</p>
  </section>
  <section aria-labelledby="example-data">
    <h2 id="example-data">Учебные данные: <span data-heading-accent>8 товаров и 6 месяцев</span></h2>
    <p>М1–М6 — шесть завершённых условных месяцев, а не реальная статистика TrueTell или клиента. В каждом месяце есть подтверждённое количество, включая нули. Восемь товаров дают суммарно <strong>159 400 ₽</strong>.</p>
    <DataTable label="Исходные количества восьми товаров по шести месяцам" columns={['SKU', 'М1', 'М2', 'М3', 'М4', 'М5', 'М6', 'Цена, ₽']} rows={rawRows} rowHeaders />
    <p><a href={`${base}media/articles/abc-xyz-087/abc-xyz-example-087.csv`} download>Скачать исходные данные CSV</a> · <a href={`${base}media/articles/abc-xyz-087/abc-xyz-results-087.csv`} download>Скачать результаты расчёта CSV</a>. Это файлы учебного примера, не выгрузки из приложения. Кодировка UTF-8, разделитель — точка с запятой; при импорте проверьте типы столбцов.</p>
    <p>Для своих данных сохраните период, шаг времени, состав SKU, валюту и правила учёта возвратов. Неполный месяц, смена единицы измерения или пропавшие строки могут изменить классы сильнее, чем выбранный порог. Шесть месяцев здесь показывают арифметику, но не задают универсальную длину истории для бизнеса.</p>
  </section>
  <section aria-labelledby="abc-calculation">
    <h2 id="abc-calculation">ABC-анализ: <span data-heading-accent>ранжирование по вкладу</span></h2>
    <p>Для каждого товара сложите количество за шесть месяцев и умножьте на цену. Доля товара равна его сумме, делённой на 159 400 ₽ и умноженной на 100%. Затем отсортируйте строки по убыванию суммы; при равенстве используйте стабильный SKU.</p>
    <p>В нашем варианте класс определяется по накопленной доле <strong>до добавления строки</strong>: меньше 80% — A; от 80% до значения меньше 95% — B; с 95% — C. Товар, который пересекает порог, завершает прежний класс. Это правило нужно записать: классификация по доле после добавления может дать другой результат.</p>
    <ArticleFigure src={paretoImage} fullSize alt={imageAlt} caption="Учебный расчёт на тех же восьми SKU: столбцы показывают сумму, линия — накопленную долю. Буквы над столбцами показывают ABC по доле до добавления строки; фактический итог группы может пересечь выбранную границу." />
    <DataTable label="Результат ABC по условной сумме продаж" columns={['SKU', 'Сумма, ₽', 'Доля', 'Накоплено после', 'ABC']} rows={abcRows} rowHeaders />
    <p>Перед T03 накоплено 61,73%, поэтому он получает A и доводит группу до 80,55%. Следующий T04 уже относится к B. Аналогично T06 завершает B на 97,49%, после него начинаются товары C. Пороги 80/95% здесь не означают, что группы обязаны закончиться ровно на этих значениях.</p>
    <p>Классы назначают по неокруглённым значениям. В таблице проценты показаны с двумя знаками для чтения. Если выбранная денежная база содержит нулевые или отрицательные результаты, разберите их отдельно: отрицательная доля ломает обычную интерпретацию положительного вклада.</p>
  </section>
  <section aria-labelledby="xyz-calculation">
    <h2 id="xyz-calculation">XYZ-анализ: <span data-heading-accent>коэффициент вариации</span></h2>
    <p>Для количества по месяцам найдите среднее и стандартное отклонение. В примере используем все шесть значений как завершённое описываемое окно: стандартное отклонение считается с делителем n = 6. Коэффициент вариации в процентах: <strong>CV = стандартное отклонение / среднее × 100%</strong>.</p>
    <p>Для T02 среднее равно 80 шт., стандартное отклонение — примерно 12,91 шт., CV — 16,14%. По выбранным границам X: CV ≤ 10%; Y: 10% &lt; CV ≤ 25%; Z: CV &gt; 25%. Значит, T02 получает Y. Это настройки нашего примера, не универсальный стандарт.</p>
    <p>В Excel для количества в B2:G2 формула <code>=STDEV.P(B2:G2)/AVERAGE(B2:G2)*100</code> вернёт CV числом в процентах. Не применяйте к этому результату ещё и процентный формат: множитель 100 уже учтён. Для суммы при цене в H2 используйте <code>=SUM(B2:G2)*H2</code>. Названия функций приведены для английской версии Excel; локализация может отличаться.</p>
    <DataTable label="Среднее, стандартное отклонение и совместная группа каждого товара" columns={['SKU', 'Среднее, шт.', 'Отклонение, шт.', 'CV', 'Группа']} rows={xyzRows} rowHeaders />
    <p>Нулевой месяц учитывается как 0, если отсутствие продаж подтверждено. Пустая ячейка — это неизвестное значение: Excel может исключить её из расчёта. Если все шесть месяцев равны нулю, CV не определён из-за деления на ноль; такую позицию оставляют вне XYZ и разбирают отдельно. При очень малом среднем CV чувствителен к небольшим изменениям.</p>
    <p>Не подменяйте в соседнем отчёте STDEV.P на STDEV.S без оговорки: выборочное отклонение с делителем n − 1 даст другую величину. Здесь рассчитывается разброс наблюдённых шести месяцев, а не точность прогноза будущего спроса.</p>
  </section>
  <section aria-labelledby="matrix">
    <h2 id="matrix">Совместите классы <span data-heading-accent>в матрицу ABC/XYZ</span></h2>
    <p>Для каждого SKU соедините две буквы. T01 — AX: высокий вклад и ровный ряд. T03 — AZ: высокий вклад, но вся продажа пришлась на один месяц. Одинаковая группа A сама по себе не объясняет, стоит ли поддерживать для них одинаковый запас.</p>
    <ArticleFigure src={matrixImage} fullSize alt="Учебная матрица ABC/XYZ: T01 AX, T02 AY, T03 AZ, T04 BX, T05 BY, T06 BZ, T07 CX, T08 CZ; ячейка CY пуста" caption="Матрица построена по рассчитанным данным. В CY нет товаров из примера; прочерк не означает нулевые продажи отдельного SKU. Суммы и классы доступны в CSV выше." />
    <DataTable label="Какие вопросы проверить по каждой группе ABC/XYZ" columns={['Группа', 'Что видим в выбранном окне', 'Что проверить перед действием']} rows={decisions} rowHeaders />
    <p>Срок поставки, минимальная партия, маржа, доступность замены и роль товара в комплекте в буквах не зашифрованы. Матрица задаёт вопросы для разбора; параметры закупки или решение о выводе позиции требуют дополнительных данных.</p>
  </section>
  <section aria-labelledby="limits">
    <h2 id="limits">Когда высокий разброс <span data-heading-accent>требует объяснения</span></h2>
    <p>T03 мог попасть в Z из-за разового крупного заказа, сезонного пика или акции. По шести числам эти причины не различить. Для сезонных товаров сравнивайте сопоставимые фазы сезона и проверяйте более длинную историю, прежде чем называть спрос непредсказуемым.</p>
    <p>Отгрузки показывают реализованные продажи. Если товар отсутствовал на складе, ноль может отражать дефицит, а не отсутствие спроса. Проверьте <a href={`${base}ostatki-moysklad/`}>остатки и доступность товара</a>, дату появления новинки и ограничения канала. Не заполняйте недоступную историю новинки нулями как подтверждённое отсутствие спроса.</p>
    <p>Вклад в сумму также не равен доходности. Для МойСклад правила анализа продаж и прибыльности разбираем в <a href={`${base}otchety-moysklad/`}>статье об отчётах</a>. Сначала согласуйте исходный показатель, затем сравнивайте классы между периодами на тех же условиях.</p>
  </section>
  <section aria-labelledby="rating-product">
    <h2 id="rating-product">Что можно сделать <span data-heading-accent>в приложении «{productRating.name}»</span></h2>
    <p>Если продажи ведутся в Битрикс24, приложение TrueTell «{productRating.name}» помогает получить рейтинги товаров и клиентов, ABC-классы, динамику и экспорт с детализацией до сделок. Для ABC товаров используется сумма допустимых товарных строк. Успешная CRM-сделка при этом не подтверждает оплату и не становится бухгалтерской выручкой.</p>
    <ArticleFigure src={productImage} fullSize alt={`Интерфейс приложения «${productRating.name}» TrueTell на тестовых данных: суммы товаров, доли, ABC-классы и месячная динамика`} caption="Скриншот приложения на тестовых данных из продуктовых материалов TrueTell. Это отдельная выборка, не восемь SKU учебного примера. Показаны ABC и динамика; XYZ-матрицу этот экран не рассчитывает." />
