---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import editorialImage from '../../images/articles/bitrix24-moysklad-order-check-editorial.png';
import stockImage from '../../images/articles/moysklad-stock-detail-official.png';
import quantityImage from '../../images/articles/bitrix24-stock-quantity-official.jpg';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';

const article = getArticle('bitrix24-moysklad-integraciya/');
const { title, description } = article;
const canonicalPath = `/${article.hrefPath}`;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const ogImage = new URL(editorialImage.src, siteRoot).toString();
const imageAlt = 'Сотрудник склада сверяет коробку со списком заказа с помощью сканера штрихкода';
const titleParts = [{text:'Битрикс24 и МойСклад: '},{text:'как связать данные CRM и склада',accent:true}];
const support = 'https://support.moysklad.ru/hc/ru/';
const sourceLinks = [
  {label:'Остатки, резервы и ожидания — справка МоегоСклада',href:`${support}товары%20и%20склады/остатки%20и%20себестоимость/складскои_учет_остатки_резервы_ожидания`},
  {label:'Количество, резерв и доступный остаток в CRM — Поддержка24',href:'https://helpdesk.bitrix24.ru/open/27911992/'},
  {label:'Заказы покупателей — справка МоегоСклада',href:`${support}продажи/заказы_покупателеи`},
  {label:'Интеграция с сайтом 1С-Битрикс — справка МоегоСклада',href:`${support}онлаин%20торговля/интернет%20магазины/1с_битрикс`},
  {label:'Синхронизация с Битрикс24 от HTMLStudio — каталог МоегоСклада',href:'https://www.moysklad.ru/integratsii/apps/bitrix24/'},
  {label:'МСКоннект от МСМодуль — каталог МоегоСклада',href:'https://www.moysklad.ru/integratsii/apps/msbitrix-dmitriiavdeev/'},
  {label:'Условия подписки Маркетплейс — Поддержка24',href:'https://helpdesk.bitrix24.ru/open/24577700/'},
  {label:'JSON API и условия доступа — МойСклад для разработчиков',href:'https://dev.moysklad.ru/'},
  {label:'Лимиты REST API — документация Битрикс24',href:'https://apidocs.bitrix24.ru/limits.html'},
  {label:'Отчёт «Остатки» и детализация — справка МоегоСклада',href:`${support}товары%20и%20склады/остатки%20и%20себестоимость/отчет_остатки`},
];
const ownershipRows = [
  ['Товары и модификации','МойСклад','В каталог CRM','Как связаны конкретные варианты, единицы и цены'],
  ['Наличие и резерв','МойСклад','Для просмотра в CRM','Какие склады, показатель и время обновления'],
  ['Согласование продажи','Битрикс24','В заказ покупателя','Какое событие создаёт заказ и кто меняет позиции'],
  ['Отгрузка и возврат','МойСклад','В связанную сделку','Какие документы и количества подтверждают результат'],
  ['Оплата','Выбранный источник платежей','В связанную запись','Сумма, валюта, дата и связь с документом'],
];
const quantityRows = [
  ['Доступно в МойСклад','10 + 5 − 3','12'],
  ['Количество на складе минус резерв','10 − 3','7'],
];
const pilotRows = [
  ['Новый согласованный заказ','Создан один связанный документ, позиции и суммы совпадают'],
  ['Повтор того же события','Обновлён тот же документ, второй заказ или платёж не появился'],
  ['Правка позиции после создания','Применено согласованное правило: обновление, запрет или ручная проверка'],
  ['Отмена до отгрузки','Статус и собственный резерв обработаны по правилам, чужие заказы не затронуты'],
  ['Частичная оплата и отгрузка','Сохранены фактические суммы и количества, заказ не выглядит полностью исполненным'],
  ['Возврат и сбой обмена','Возврат связан с исходной продажей; ошибка видна, повтор не создаёт копию'],
];
const faqItems = [
  {question:'Есть ли один штатный обмен Битрикс24 и МойСклад?',answer:'В каталоге МоегоСклада есть приложения сторонних разработчиков для Битрикс24. У них различаются объекты, направления и условия обмена. Выбирайте конкретное решение по вашему сценарию и проверяйте его актуальную документацию; инструкция для сайта 1С-Битрикс относится к другому продукту.'},
  {question:'Можно ли передавать «Доступно» как товар в наличии?',answer:'Сначала согласуйте смысл показателя: в МойСклад «Доступно» включает ожидание, а в штатном складском учёте Битрикс24 доступный остаток — количество минус резерв. Для обещания отгрузки сейчас отдельно проверяйте фактический склад, резерв и время обновления. Название поля не подтверждает одинаковый расчёт.'},
  {question:'Успешная сделка должна автоматически стать отгрузкой?',answer:'Такое действие требует отдельного правила, а не совпадения названий статусов. Заказ покупателя в МойСклад сам по себе не меняет фактический остаток; складской результат отражают соответствующие документы. Проверьте, какой документ создаёт выбранный коннектор и в каком состоянии.'},
  {question:'Как избежать дублей товаров и заказов?',answer:'Храните связи записей двух систем по устойчивым идентификаторам. Названия и артикулы используйте для проверки первичного сопоставления, учитывая модификации и единицы. В пилоте отправьте одно событие повторно: оно должно обновить связанную запись или быть корректно пропущено.'},
  {question:'Индивидуальная интеграция через API будет бесплатной?',answer:'Наличие API не делает разработку и сопровождение бесплатными. Проверьте условия аккаунта МоегоСклада, ограничения API и подписку Маркетплейс для вашего варианта Битрикс24. Для облачной версии в зоне ru у локальных приложений и вебхуков есть отдельные условия.'},
  {question:'Можно ли ограничиться общим BI-отчётом?',answer:'Да, если задача — анализировать продажи и склад без создания или изменения документов в другой системе. Сначала согласуйте связи, даты и определения показателей. Отчёт не заменяет операционный обмен заказами и резервами, если менеджерам нужен именно этот процесс.'},
];
const relatedArticles = getRelatedArticles(article.hrefPath).map(item=>({...item,description:item.summaryDescription ?? item.description,href:`${base}${item.hrefPath}`}));
const structuredData = createArticleStructuredData({title,description,articleUrl,publisherUrl:siteRoot.toString(),image:ogImage,
  publishedDate:article.publishedAt,modifiedDate:article.updatedAt,articleType:'BlogPosting',author:authorName,
  breadcrumbs:[{name:'Главная',item:siteRoot.toString()},{name:'Блог',item:new URL('blog/',siteRoot).toString()},{name:title,item:articleUrl}],faqItems});
---

<ArticleLayout {title} {titleParts} {description} {canonicalPath} {structuredData}
  ogTitle={article.seoTitle} ogDescription={description} {ogImage} ogImageAlt={imageAlt}
  category={article.category} author={authorName}
  intro="Выбираем схему обмена, согласуем значения остатков и проверяем путь от сделки до складских документов.">
  <Fragment slot="quick-answer">
    <p>Начните интеграцию Битрикс24 и МойСклад с правил данных: где ведут товары, кто создаёт заказ, какой остаток видит менеджер и откуда приходит факт оплаты или отгрузки.</p>
    <p>Затем выберите коннектор или индивидуальный обмен и проверьте один полный сценарий. Одинаковое название поля не гарантирует одинаковый расчёт, а передача сделки в заказ ещё не означает передачу всех складских документов.</p>
  </Fragment>

  <p data-article-lead>Менеджер согласовал продажу в CRM, а на складе ждут заказ с другими позициями. Или товар выглядит доступным, хотя часть количества только ожидают от поставщика. В таких ситуациях полезнее проверить правила связи данных, чем начинать с установки приложения. Начните с объёма обмена и проверьте его на конкретных записях.</p>
  <ArticleFigure src={editorialImage} alt={imageAlt} caption="Сверка заказа с фактическим товаром — один из результатов согласованного обмена. Редакционная иллюстрация, не интерфейс приложения и не кейс внедрения." />

  <section aria-labelledby="scope">
    <h2 id="scope">Что нужно связать: работу менеджера или отчёт</h2>
    <p>Если менеджер должен видеть наличие, передавать согласованный заказ и получать результат его исполнения, нужен операционный обмен. Если руководителю требуется сравнить CRM с продажами и запасами, задача может ограничиться сбором данных для отчёта. Эти сценарии можно сочетать, но принимать их стоит отдельно.</p>
    <p>Сформулируйте результат через действие сотрудника: «после согласования позиции попадают в один заказ покупателя» или «на панели видно, что продано и что ещё ждёт отгрузки». Так проще отделить обязательные функции от приятных дополнений. Общие принципы отчётов разобраны в <a href={`${base}bi-analitika-chto-eto-prostymi-slovami/`}>статье о BI-аналитике</a>.</p>
    <p>Не путайте <strong>CRM Битрикс24</strong> с <strong>«1С-Битрикс: Управление сайтом»</strong>. Официальная <a href={sourceLinks[3].href} target="_blank" rel="noopener noreferrer">инструкция МоегоСклада по 1С-Битрикс</a> описывает обмен с интернет-магазином. Она не подтверждает, что тот же способ подключает сделки облачной CRM.</p>
  </section>

  <section aria-labelledby="ownership">
    <h2 id="ownership">Кто ведёт каждый вид данных</h2>
    <p>Для каждого поля назначьте систему, в которой его изменяют, и правило передачи. Двусторонний обмен не означает, что обе стороны могут независимо переписывать цену, резерв и состояние документа. Если одно изменение возвращается обратно без проверки источника, легко получить цикл или потерять более свежую правку.</p>
    <p>Ниже — <strong>пример распределения ответственности</strong> для компании, которая ведёт товарный учёт в МойСклад, а продажи согласует в Битрикс24. Это проектное решение, а не настройка любого коннектора по умолчанию.</p>
    <DataTable label="Пример распределения ответственности между CRM и товарным учётом" columns={['Данные','Где ведём','Куда передаём','Что согласовать']} rows={ownershipRows} rowHeaders />
    <ArticleFigure src={stockImage} fullSize alt="Детализация остатков МоегоСклада: доступно, резерв, ожидание, остаток и документы себестоимости" caption="Официальный скриншот справки МоегоСклада: складские показатели и исходные документы показаны отдельно. Это экран учёта, а не свидетельство передачи всех этих полей в CRM. Значения демонстрационные." />
    <p>Укажите конкретные организации, склады и типы цен. Если приложение передаёт только общий остаток, а менеджеру нужен определённый склад или размер, общее число не решает задачу. Подробная проверка складской выборки есть в <a href={`${base}ostatki-moysklad/`}>инструкции по остаткам МойСклад</a>.</p>
  </section>

  <section aria-labelledby="available">
    <h2 id="available">Почему «Доступно» может означать разные количества</h2>
    <p>В МойСклад действует формула <strong>Доступно = Остаток + Ожидание − Резерв</strong>. Ожидание относится к ещё не полученному товару. В штатном складском учёте Битрикс24 <strong>доступный остаток = количество на складе − резерв</strong>. Обе формулы подтверждены официальными материалами, но описывают разные показатели.</p>
    <p>Учебный пример: на выбранном складе 10 единиц, 3 зарезервированы, 5 ожидаются. Числа условные; это сравнение определений, а не результат подключения.</p>
    <DataTable label="Учебное сравнение показателей при одинаковых исходных количествах" columns={['Показатель','Расчёт','Количество']} rows={quantityRows} rowHeaders compact />
    <p>Для обещания немедленной отгрузки нельзя считать ожидаемые пять единиц уже поступившими. Договоритесь, какой показатель нужен в CRM, как он подписан и на какой момент рассчитан. Возможность выбрать способ расчёта зависит от решения; проверяйте её в настройках и документации.</p>
    <ArticleFigure src={quantityImage} fullSize alt="Битрикс24: вкладка Товары и окно с количеством на складе, резервом и доступным остатком" caption="Официальный скриншот Поддержки24: в сделке открыта детализация доступного остатка. Здесь 64 − 3 = 61. Это собственный складской учёт Битрикс24, он сам по себе не подтверждает связь с МойСклад." />
    <p>Для проверки этого штатного экрана откройте <strong>CRM → Сделки</strong>, нужную карточку и вкладку <strong>«Товары»</strong>; нажмите значение в колонке <strong>«Доступный остаток»</strong>. Перед сравнением убедитесь, что проверяете один товар, один склад и сопоставимое время обновления. Метод описан в <a href={sourceLinks[1].href} target="_blank" rel="noopener noreferrer">справке по резервам в CRM</a>.</p>
  </section>

  <section aria-labelledby="matching">
    <h2 id="matching">Как сопоставлять товары и клиентов без дублей</h2>
    <p>При первом подключении проверьте соответствия существующих записей. Одинаковое название не доказывает, что это один товар: у него могут различаться размер, цвет, фасовка или единица измерения. Артикул помогает найти кандидата, но правило его уникальности нужно проверить в вашем каталоге.</p>
    <p>Храните связь по идентификаторам записей двух систем, а названия и артикулы используйте для сверки. У клиента также нужна связь карточек: согласуйте, как обрабатываются компания и контакт, несколько телефонов и уже существующие записи. Не полагайтесь на создание нового контрагента при каждом событии.</p>
    <p>Отдельно проверьте товарные позиции: нужную модификацию, количество и единицу, цену, скидку, налог и валюту. Стоимость строки и итог заказа должны объясняться одним правилом округления. Если обязательное соответствие не найдено, лучше направить запись на проверку, чем молча подставить похожий товар.</p>
    <p>Для пользовательских полей согласуйте сущность CRM, точный технический код и назначение данных. <a href="/kod-polya-bitrix24/">Как найти код поля в Битрикс24</a> — отдельная инструкция для подготовки такого сопоставления.</p>
  </section>

  <section aria-labelledby="documents">
    <h2 id="documents">Сделка, заказ, отгрузка и оплата — разные события</h2>
    <p>В МойСклад <strong>заказ покупателя фиксирует договорённость</strong> и может резервировать товары, но сам не меняет фактический складской остаток. Отгрузка и другие складские документы отражают движение товара; оплата учитывается отдельным связанным документом. Поэтому сумма заказа не доказывает, что всё оплачено и отгружено.</p>
    <p>Выберите событие создания заказа: например, подтверждение состава покупки на согласованной стадии CRM. Это условие вашего процесса. Затем решите, кто вправе менять позиции после создания и что делать при возврате сделки на предыдущую стадию. Не превращайте любое изменение CRM в безусловное создание нового документа.</p>
    <p>Пример для проверки: заказано 8 единиц, сначала отгружено 3, позже ещё 5. В связанной записи должно быть понятно, что исполнено сейчас, а что осталось. Так же отдельно проверьте частичную оплату. Это сценарий приёмки; поддержка таких событий должна быть подтверждена у выбранного коннектора.</p>
    <p>Согласуйте отмену до отгрузки, возврат после неё и снятие резерва именно у связанного заказа. Если складской учёт используется одновременно в обеих системах, определите, где формируется каждый документ движения. Два независимых счётчика одной продажи нужно согласовать до запуска.</p>
  </section>

  <section aria-labelledby="connector">
    <h2 id="connector">Готовый коннектор или индивидуальный обмен</h2>
    <p>Готовое приложение удобно, когда его правила совпадают с вашим процессом. В официальном каталоге МоегоСклада есть, например, <a href={sourceLinks[4].href} target="_blank" rel="noopener noreferrer">решение HTMLStudio</a> и <a href={sourceLinks[5].href} target="_blank" rel="noopener noreferrer">МСКоннект от МСМодуль</a>. Карточки описывают разные наборы возможностей. Это сведения разработчиков, а не универсальный стандарт обмена или результаты нашего тестирования.</p>
    <p>Перед выбором проверьте нужные объекты и направления, правила запуска, выбранные склады, модификации, отмены и частичное исполнение. Попросите показать повторную обработку и журнал ошибок. Уточните условия для облачной или коробочной версии Битрикс24, стоимость приложения и сопровождения.</p>
    <p>Индивидуальная интеграция через API подходит, если обязательный сценарий не покрыт готовым решением. Она требует собственного хранения связей, обработки ошибок и повторов. У API есть ограничения; доступ и условия аккаунтов проверяйте по <a href={sourceLinks[7].href} target="_blank" rel="noopener noreferrer">документации МоегоСклада</a> и <a href={sourceLinks[8].href} target="_blank" rel="noopener noreferrer">лимитам Битрикс24</a>. Само наличие API не означает бесплатную разработку или мгновенную синхронизацию.</p>
    <p>Для облачного Битрикс24 в зоне ru подписка Маркетплейс требуется и для локальных приложений и вебхуков, кроме описанного в справке узкого исключения для CRM-триггера. Для коробочной версии условия входящих вебхуков отличаются. Сверьте <a href={sourceLinks[6].href} target="_blank" rel="noopener noreferrer">актуальные условия подписки</a> под ваш способ подключения.</p>
    <InlineConsultation title="Нужно выбрать схему обмена CRM и склада" description="Разберём объекты, направления и правила обработки. Начать можно с одного заказа и списка расхождений, которые нужно устранить." />
  </section>

  <section aria-labelledby="pilot">
    <h2 id="pilot">Как принять обмен на небольшом пилоте</h2>
    <p>Подготовьте отдельный контрольный набор и заранее запишите ожидаемый результат. Используйте тестовую среду или согласованные тестовые записи; ограничьте направления, чтобы проверка не обработала всю историю. Начните с нескольких товаров и одного полного пути заказа.</p>
    <DataTable label="Сценарии приёмки обмена между Битрикс24 и МойСклад" columns={['Проверка','Критерий результата']} rows={pilotRows} rowHeaders />
    <p>Для каждого случая сохраняйте ID обеих записей, событие, время обработки, исходные и полученные позиции. Проверяйте фактический документ, а не только зелёное уведомление коннектора. Если сценарий не поддерживается, зафиксируйте ручной процесс или выберите другой способ обмена до расширения пилота.</p>
    <p>Настройте, кто увидит ошибку и кто её разберёт. Повтор после сбоя должен сохранять связь с прежним документом; иначе временная недоступность станет причиной дублей. Договоритесь о порядке исправления и контрольной сверке после восстановления.</p>
  </section>

  <section aria-labelledby="analytics">
    <h2 id="analytics">Что согласовать для общего BI-отчёта</h2>
    <p>Свяжите сделку с заказом и связанными документами, затем определите вопрос отчёта. Дата создания сделки, дата отгрузки и дата оплаты отражают разные события. В таблице данных сохраните их отдельно; для каждого показателя явно выберите нужную дату.</p>
    <p>Не складывайте сумму сделки и сумму её отгрузки как две продажи. При нескольких отгрузках один заказ появляется в детализации несколько раз; расчёт должен учитывать эту связь. Текущий остаток также не заменяет снимок запаса на прошлую дату.</p>
    <p>Сначала сверяйте несколько исходных заказов, затем расширяйте отчёт. Для складской части используйте <a href={`${base}otchety-moysklad/`}>разбор отчётов МойСклад</a>, для первого отчёта по CRM — <a href={`${base}bi-analitika-bitrix24-pervyy-otchet/`}>инструкцию по BI Конструктору Битрикс24</a>. Ни один из этих отчётов сам по себе не запускает обмен складскими документами.</p>
  </section>

  <p>Если склад обслуживает ещё и Ozon, Wildberries или Яндекс Маркет, проверяйте эти каналы отдельно. В <a href={`${base}moysklad-dlya-marketpleysov/`}>статье про МойСклад для маркетплейсов</a> разобраны направления обмена и расчёт количества, которое можно продать на площадке.</p>

  <p>Перед согласованием обмена подготовьте <a href={`${base}spisok-poley-bitrix24/`}>список полей CRM с кодами и типами</a>. Каталог помогает составить карту соответствия; правила передачи значений согласуют отдельно.</p>

  <p>До разработки обмена согласуйте <a href={`${base}karta-sootvetstviya-poley-bitrix24/`}>карту соответствия полей Битрикс24</a>: смысл каждого значения, владельца данных, связь записей, обработку ошибок и правила приёмки.</p>

