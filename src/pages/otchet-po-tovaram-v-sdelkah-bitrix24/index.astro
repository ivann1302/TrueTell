---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { productRatingPath } from '../../config/products';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import ratingImage from '../../images/products/product-rating/rating-products-2026-10-renamed.jpg';
import detailImage from '../../images/products/product-rating/rating-deal-contribution-2026-10.png';

const article = getArticle('otchet-po-tovaram-v-sdelkah-bitrix24/');
const { title, description } = article;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const imageAlt = 'Настоящий экран приложения TrueTell: рейтинг товаров по успешным сделкам, количество, число сделок и сумма товарных строк';
const ogImage = new URL(ratingImage.src, siteRoot).toString();
const sourceLinks = [
  { label: 'Битрикс24: наборы данных BI Конструктора по сделкам и товарным позициям', href: 'https://helpdesk.bitrix24.ru/open/22848752/' },
  { label: 'Битрикс24: как начать работать с BI Конструктором', href: 'https://helpdesk.bitrix24.ru/open/19123608/' },
  { label: 'Битрикс24: как создавать отчёты в BI Конструкторе', href: 'https://helpdesk.bitrix24.ru/open/19498394/' },
  { label: 'Битрикс24: настройка обновления даты завершения при переходе в финальную стадию', href: 'https://helpdesk.bitrix24.ru/open/28033006/' },
  { label: 'Битрикс24: как добавить товары в карточку CRM', href: 'https://helpdesk.bitrix24.ru/open/27964692/' },
];
const metricRows = [
  ['Продано единиц', 'Сумма количества строк одного товара', 'Складывайте только одинаковые единицы измерения'],
  ['Сделок с товаром', 'Число разных ID сделок, где есть товар', 'Если товар внесён двумя строками в одну сделку, сделка одна'],
  ['Сумма товара', 'Сумма товарных строк после скидки и налога', 'Не прибавляйте полную сумму сделки к каждому товару'],
  ['Полная сумма сделок', 'Сумма карточек, в которых встречался товар', 'Это отдельный показатель; товары в одной сделке разделяют её общую сумму'],
];
const faqItems = [
  { question: 'Как получить отчёт по товарам из всех сделок Битрикс24?', answer: 'Стандартная «Товарная аналитика сделок» в BI Конструкторе даёт обзор категорий и чеков. Для сводки по каждому товару с количеством и числом уникальных сделок создайте отдельный отчёт на товарных строках и сделках или откройте приложение TrueTell. В обоих случаях сначала задайте период, воронки, валюту и правило отбора.' },
  { question: 'Какие сделки включать в отчёт о продажах товаров?', answer: 'Если цель — итог по завершённым продажам CRM, выберите успешные сделки и зафиксируйте правило даты. Сделки в работе и проигранные исключите. Для отчёта по заявкам или потенциальному спросу нужна другая выборка; не смешивайте её с продажами.' },
  { question: 'Почему сумма товаров не совпадает с суммой сделок?', answer: 'Товарные строки и поле суммы сделки могут рассчитываться по-разному, в том числе при ручной сумме. Сравните состав строк, скидки, налоги и режим расчёта в конкретных карточках. Полную сумму сделки нельзя целиком приписывать каждому товару в ней.' },
  { question: 'Можно ли считать поле CLOSEDATE датой фактической продажи?', answer: 'По умолчанию так считать нельзя: в описании наборов данных CLOSEDATE и DEAL_CLOSEDATE названы планируемой датой закрытия. При включённой настройке обновления даты завершения поле меняется при переходе в финальную стадию. Проверьте настройку и историю конкретных сделок, прежде чем использовать это поле как дату события; оплата требует отдельной сверки.' },
  { question: 'Показывает ли такой отчёт оплаченную выручку и возвраты?', answer: 'Успешная сделка и её товарные строки показывают данные CRM, а не факт поступления денег. Для оплаченной выручки и возвратов сопоставьте результат с платёжными и учётными документами по принятому в компании правилу.' },
];
const structuredData = createArticleStructuredData({
  articleType: 'Article', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  breadcrumbs: [{ name: 'Главная', item: siteRoot.toString() }, { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() }, { name: title, item: articleUrl }],
  faqItems,
});
---
<ArticleLayout {title} titleParts={[{ text: 'Отчёт по товарам в сделках Битрикс24: ' }, { text: 'количество и продажи', accent: true }]} {description}
  canonicalPath={`/${article.hrefPath}`} {structuredData} ogTitle={article.seoTitle} ogDescription={description}
  {ogImage} ogImageAlt={imageAlt} category={article.category} author={authorName}
  intro="Чтобы узнать, какие товары продавались за месяц, соберите строки товаров из нескольких сделок. Заранее определите, какие сделки попадут в выборку, по какой дате и в какой валюте вы их сравните. Тогда количество и сумма в отчёте будут проверяемыми.">
  <Fragment slot="quick-answer">
    <p><strong>Для отчёта по завершённым продажам CRM</strong> отберите успешные сделки, задайте период, воронки и валюту. Суммируйте количество и итоговую сумму товарных строк по каждому товару; число сделок считайте по уникальным ID.</p>
    <p>Стандартная товарная аналитика BI Конструктора показывает обзор категорий и чеков. Для списка отдельных товаров с количеством и числом сделок настройте свой отчёт на наборах BI или используйте <a href={productRatingPath}>«ABC анализ товаров и клиентов» TrueTell</a>. Успешная сделка не равна полученной оплате.</p>
  </Fragment>

  <p data-article-lead>В одной сделке легко увидеть купленные позиции. Для ответа на вопрос «сколько насосов мы продали за месяц?» нужны строки из всех подходящих сделок. Если просто сложить суммы карточек, товару достанется стоимость других позиций из того же заказа. Если взять все стадии подряд, в итог попадут ещё не состоявшиеся продажи.</p>

  <section aria-labelledby="scope">
    <h2 id="scope">Сначала определите <span data-heading-accent>выборку сделок</span></h2>
    <p>Запишите четыре условия: период и его тип даты, успешная стадия, нужные направления продаж и валюта. Если вы сравниваете менеджеров, добавьте фильтр по ответственному. Сохраните эти условия рядом с результатом: без них одинаково названные отчёты могут показывать разные числа.</p>
    <p>В приложении TrueTell по умолчанию учитываются успешные сделки по полю «Дата завершения»; можно переключить отчёт на дату создания. Поле «Дата завершения» не всегда равно дате фактического закрытия: Битрикс24 обновляет его при переходе в финальную стадию, только если включена соответствующая настройка CRM. На демонстрационном экране ниже видны период, условия отбора, отдельно полная сумма сделок и сумма товарных строк.</p>
    <ArticleFigure src={ratingImage} fullSize alt={imageAlt} caption="Настоящий интерфейс приложения TrueTell на синтетических данных за январь 2026 года: 4 успешные сделки, товарные строки на 14 500 ₽ и полная сумма сделок 15 000 ₽. Это учебный пример, не результаты клиента. Откройте экран в полном размере для чтения колонок." />
    <p>Отчёт по поступившим заявкам может включать сделки в работе; отчёт по завершённым продажам CRM — нет. Выберите правило под свой вопрос и не меняйте его между сравниваемыми периодами.</p>
  </section>

  <section aria-labelledby="metrics">
    <h2 id="metrics">Какие <span data-heading-accent>показатели считать</span></h2>
    <p>Единица отчёта — строка товара в сделке. Несколько строк одного товара дают суммарное количество и сумму, но число сделок считается по разным карточкам. Денежная сумма строки после скидки и налога отвечает на вопрос о вкладе товара в выбранные сделки. Полная сумма карточки нужна для другой задачи и может включать другие товары или быть введена вручную.</p>
    <DataTable label="Показатели отчёта по товарам в сделках" columns={['Показатель', 'Правило расчёта', 'Что проверить']} rows={metricRows} rowHeaders />
    <p>Например, в одной учебной сделке есть насос на 2 000 ₽ и фильтр на 8 000 ₽. Для насоса вклад составляет 2 000 ₽, а полная сумма карточки — 10 000 ₽. Если добавить к насосу все 10 000 ₽, товарный рейтинг окажется завышен. Скидка, налог, валюта и единица измерения должны соответствовать выбранному показателю.</p>
  </section>

  <section aria-labelledby="ways">
    <h2 id="ways">Где построить <span data-heading-accent>сводку по товарам</span></h2>
    <p>В BI Конструкторе Битрикс24 есть готовая «Товарная аналитика сделок»: официальный обзор описывает продажи по категориям и динамику чеков. Если нужно количество по каждому товару и число уникальных сделок с ним, создайте собственный отчёт. Для товарных строк используйте набор <code>crm_deal_product_row</code>: в нём описаны ID сделки и товара, название, количество, валюта, скидка, налог и итоговая сумма строки <code>SUM_TOTAL</code>. Условия по стадии берутся из данных сделки <code>crm_deal</code>; код <code>STAGE_SEMANTIC_ID = S</code> означает успешную стадию. Сопоставляйте наборы по ID сделки и проверяйте, не размножило ли объединение строки.</p>
    <p>В документации поле <code>CLOSEDATE</code> сделки и <code>DEAL_CLOSEDATE</code> товарной строки обозначают <strong>планируемую</strong> дату закрытия. Без проверки настройки обновления даты завершения фильтр по этому полю нельзя считать фильтром по фактическому закрытию. Если нужен отчёт именно по дате перехода в успешную стадию, проверьте настройку и историю нескольких карточек; при необходимости определите отдельный источник события. Доступность BI Конструктора зависит от тарифа и настроек портала.</p>
    <p>Для готового рейтинга откройте наше приложение <a href={productRatingPath}>«ABC анализ товаров и клиентов»</a>. Оно показывает количество, число сделок, сумму товарных строк и долю товара, позволяет выбрать период, менеджеров и валюту. По товару можно открыть сделки, из которых сложился показатель. Страница продукта описывает условия доступа и ограничения объёма данных.</p>
  </section>

  <section aria-labelledby="check">
    <h2 id="check">Как <span data-heading-accent>сверить результат</span></h2>
    <p>Выберите товар с понятным числом сделок. Откройте его детализацию и проверьте два-три ID в CRM: успешную стадию, дату по принятому правилу, количество и итог строки после скидки и налога. Затем сравните сумму этих строк с отчётом. Если позиции в одной карточке две, сделку в счётчике товара учитывайте один раз.</p>
    <ArticleFigure src={detailImage} fullSize alt="Детализация настоящего приложения TrueTell: для товара Насос видны две сделки и отдельно вклад товара и полная сумма сделки" caption="Детализация настоящего приложения TrueTell на синтетических данных. В сделке 101 вклад насоса — 2 000 ₽ при полной сумме сделки 10 000 ₽; обе величины показаны отдельно. По строке можно перейти к исходной карточке CRM." />
    <p>При расхождении сначала проверьте фильтры, валюту и права пользователя на сделки. Затем посмотрите, есть ли товары в карточках, не задублированы ли строки, одинаковы ли единицы измерения и не изменялась ли сумма сделки вручную. Если вопрос относится к конкретной карточке, откройте вкладку «Товары» самой сделки и проверьте сохранённые строки. Это быстрее покажет причину расхождения, чем общая сводка.</p>
    <p>Возврат товара и фактическую оплату сверяйте с документами и учётной системой. Успешный статус CRM не доказывает, что деньги поступили и не было возврата. Результат по разным валютам без принятого курса также нельзя складывать в одну денежную сумму.</p>
    <InlineConsultation variant="product" title="Нужен отчёт, цифры которого можно проверить?" description="Расскажите, какие стадии и даты у вас означают продажу и с чем надо сверять результат. Поможем определить правила выборки и контрольные сделки." href={companyInfo.contacts.consultationUrl} actionLabel="Обсудить отчёт" />
  </section>

  <FaqSection title="Частые вопросы об отчёте по товарам в Битрикс24" items={faqItems} variant="article" />
  <p>Справка Битрикс24 и текущая продуктовая страница TrueTell проверены 1 ноября 2026 года. Скриншоты показывают интерфейс нашего приложения на синтетических данных; клиентский портал для этой статьи не проверялся.</p>
  <ArticleSources publishedIso={article.publishedAt} modifiedIso={article.updatedAt} sources={sourceLinks} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Проверить продажи товаров с ' }, { text: 'TrueTell', accent: true }]} description="Смотрите количество, число сделок и вклад товара, затем открывайте исходные карточки CRM для сверки. Условия доступа и пределы выборки указаны на странице приложения." href={productRatingPath} actionLabel="Посмотреть приложение" />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <ConsultationCtaSection slot="after-article" />
</ArticleLayout>
