---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { mcpProduct } from '../../config/products';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import statesImage from '../../images/articles/bitrix24-deals-activity-states-129.png';
import timingImage from '../../images/articles/bitrix24-overdue-activity-timing-129.png';

const article = getArticle('sdelki-bez-del-bitrix24/');
const { title, description } = article;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const ogImage = new URL(statesImage.src, siteRoot).toString();
const imageAlt = 'Три отдельных сигнала для проверки сделки: нет дела, просрочено дело, есть необработанное входящее обращение';
const faqItems = [
  { question: 'Как найти сделки без дел в Битрикс24?', answer: 'Откройте CRM → Сделки, в поиске добавьте поле «Дела» и выберите «Нет дел». Ограничьте выборку текущими сделками нужного направления. Другой путь — режим просмотра «Дела», колонка «Без дел». Доступность фильтров зависит от тарифа; отдельные карточки проверьте вручную.' },
  { question: 'Почему срок дела прошёл, но фильтр «Просрочены» не показывает сделку?', answer: 'Фильтр «Дела → Просрочены» в справке Битрикс24 описан для дел, срок которых прошёл более суток назад. В день истечения срока проверьте «Пора выполнять» и колонку «На сегодня» режима «Дела», затем откройте само дело и сверьте его время.' },
  { question: 'Сделка без дела означает, что клиенту не ответили?', answer: 'Нет. Ответ мог быть зафиксирован в письме, звонке или чате, а следующее дело не запланировали. Проверяйте таймлайн и факт ответа отдельно от наличия будущего дела.' },
  { question: 'Кто отвечает за просроченное дело — владелец сделки или дела?', answer: 'Это могут быть разные сотрудники. Откройте дело и проверьте его ответственного. Счётчики CRM могут работать по ответственному за элемент либо по ответственному за дело; руководителю стоит сверить выбранный режим перед разбором нагрузки.' },
  { question: 'Как руководителю проверять такие сделки каждый день?', answer: 'В начале смены посмотрите открытые сделки без дел, затем просроченные дела в режиме «Дела» и список незакрытых дел подчинённых в CRM → Ещё → Мои дела. По каждой найденной карточке зафиксируйте ID, причину, ответственного и следующий шаг. Сохранённый фильтр помогает повторять одну и ту же выборку.' },
  { question: 'MCP TrueTell уже отправляет уведомления о сделках без дел?', answer: 'Готовые уведомления и подписку на такой контроль мы пока не заявляем. MCP TrueTell для Битрикс24 находится в разработке. Сейчас можно согласовать критерии проверки, доступ к данным и порядок подтверждения результата человеком.' },
];
const sourceLinks = [
  { label: 'Битрикс24: счётчики и фильтр «Дела»', href: 'https://helpdesk.bitrix24.ru/open/18388076/' },
  { label: 'Битрикс24: счётчики и распределение дел по колонкам', href: 'https://helpdesk.bitrix24.ru/open/18388046/' },
  { label: 'Битрикс24: режим просмотра «Дела»', href: 'https://helpdesk.bitrix24.ru/open/18500870/' },
  { label: 'Битрикс24: контроль сделок в работе', href: 'https://helpdesk.bitrix24.ru/open/25552664/' },
  { label: 'Битрикс24: поиск сделок с определёнными делами', href: 'https://helpdesk.bitrix24.ru/open/25580992/' },
  { label: 'Битрикс24: фильтры CRM и условия тарифов', href: 'https://helpdesk.bitrix24.ru/open/24206616/' },
  { label: 'Битрикс24: «Мои дела» и права доступа', href: 'https://helpdesk.bitrix24.ru/open/21623188/' },
  { label: 'Битрикс24: режим счётчиков по ответственному', href: 'https://helpdesk.bitrix24.ru/open/17944572/' },
];
const signalRows = [
  ['Нет следующего дела', '«Дела → Нет дел» или колонка «Без дел»', 'Открыть карточку и назначить следующий шаг, если работа ещё идёт'],
  ['Срок дела прошёл сегодня', 'Фильтр «Пора выполнять» и колонка «На сегодня»', 'Проверить конкретное дело, срок и ответственного'],
  ['Просрочка более суток', 'Фильтр «Дела → Просрочены»', 'Разобрать накопившиеся дела и причину задержки'],
  ['Входящее без ответа', 'Входящий счётчик и таймлайн карточки', 'Сверить время обращения с фактическим ответом по правилу компании'],
];
const structuredData = createArticleStructuredData({
  articleType: 'Article', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  breadcrumbs: [{ name: 'Главная', item: siteRoot.toString() }, { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() }, { name: title, item: articleUrl }],
  faqItems,
});
---
<ArticleLayout {title} titleParts={[{ text: 'Сделки без дел и ' }, { text: 'просроченные дела в Битрикс24', accent: true }]} {description}
  canonicalPath={`/${article.hrefPath}`} {structuredData} ogTitle={article.seoTitle} ogDescription={description}
  {ogImage} ogImageAlt={imageAlt} category={article.category} author={authorName}
  intro="В открытой сделке нет следующего действия или срок звонка уже прошёл? В Битрикс24 это две разные выборки. Для каждой есть свой способ поиска и проверки карточки.">
  <Fragment slot="quick-answer">
    <p><strong>Откройте CRM → Сделки. Для первого списка выберите фильтр «Дела → Нет дел» или колонку «Без дел» в режиме «Дела». Для просроченного сегодня дела используйте фильтр «Пора выполнять» и проверьте колонку «На сегодня».</strong></p>
    <p>Фильтр «Дела → Просрочены» отбирает дела с просрочкой более суток. Входящее обращение без ответа проверяйте отдельно по таймлайну и вашему сроку реакции.</p>
  </Fragment>

  <p data-article-lead>Счётчик в CRM помогает заметить ближайшее дело. Он не отвечает за вас на вопрос, что обещано клиенту и кто должен сделать следующий шаг. Для рабочего контроля разделите открытые сделки без дела, сделки с просроченным делом и необработанные входящие. Такое разделение позволяет найти конкретные карточки и исправить процесс, а не спорить об одном общем числе «забытых заявок».</p>

  <section aria-labelledby="three-signals">
    <h2 id="three-signals">Какие сделки <span data-heading-accent>попадают в проверку</span></h2>
    <p>Начните с одного направления и текущих стадий. Закрытые сделки и архивные обращения не должны смешиваться с работой на сегодня. Дальше определите, что именно ищете: отсутствие следующего дела, истёкший срок дела или входящий контакт, на который команда ещё не ответила.</p>
    <ArticleFigure src={statesImage} fullSize portrait alt={imageAlt} caption="Редакционная схема по справке Битрикс24. Отсутствие следующего дела, просрочка и необработанное входящее — разные сигналы; это не снимок интерфейса." />
    <DataTable label="Какой список открыть для каждой проблемы" columns={['Сигнал', 'Где искать', 'Что решить по карточке']} rows={signalRows} rowHeaders />
    <p>Завершённые действия остаются в истории. Поэтому фильтр «Нет дел» используйте как список для проверки следующего шага, а не как доказательство, что с клиентом вообще не работали. Сверьте таймлайн, стадию и договорённость: иногда сделку пора закрыть, а иногда нужен звонок с конкретным сроком.</p>
  </section>

  <section aria-labelledby="find-empty">
    <h2 id="find-empty">Найдите сделки <span data-heading-accent>без дела</span></h2>
    <p>В CRM → Сделки откройте «Фильтр + поиск», добавьте поле «Дела» и выберите «Нет дел». Ограничьте список группой стадий «Сделка в работе», нужным направлением и ответственным, если разбираете одного сотрудника. Сохраните фильтр под понятным именем для повторной проверки. Поиск с фильтрами доступен не на всех тарифах; если нужной опции нет, откройте режим просмотра «Дела» и колонку «Без дел».</p>
    <p>Откройте одну найденную карточку. Проверьте, было ли последнее общение с клиентом, есть ли результат и кто отвечает за сделку. Если работа продолжается, создайте дело с описанием конкретного действия и крайним сроком. Битрикс24 может предложить создать умное дело при выходе из карточки; проверьте его текст и срок перед сохранением. Если сделка фактически завершена, уточните стадию вместо формального дела «для галочки».</p>
  </section>

  <section aria-labelledby="find-overdue">
    <h2 id="find-overdue">Проверьте <span data-heading-accent>просроченные дела</span></h2>
    <p>Для дела со сроком сегодня используйте фильтр «Пора выполнять»: он включает дела с близким сроком и просроченные сегодня. В режиме просмотра «Дела» проверьте колонку «На сегодня». Для старых просрочек выберите «Дела → Просрочены»; по справке Битрикс24 фильтр показывает дела, просроченные более чем на сутки. Две статьи справки описывают попадание в колонку «Просрочены» по-разному, поэтому при спорном случае откройте карточку и сверьте время самого дела.</p>
    <ArticleFigure src={timingImage} fullSize alt="Учебная шкала: дело со сроком сегодня попадает в проверку «Пора выполнять», а фильтр «Просрочены» отбирает просрочку более суток" caption="Учебный пример: в 11:20 сегодняшнюю просрочку показывает «Пора выполнять». Фильтр «Дела → Просрочены» отберёт её после просрочки более суток. Для конкретной сделки сверяйте срок в самом деле." />
    <p>В карточке откройте само дело: проверьте срок, описание, статус и ответственного. Ответственный за сделку и за дело может быть разным человеком. Если дело выполнено, зафиксируйте результат и проверьте, назначен ли следующий шаг. Если договорённость перенесена, поставьте новый обоснованный срок; не переносите просрочку массово, пока не понятно, что произошло с клиентом.</p>
  </section>

  <section aria-labelledby="inbound">
    <h2 id="inbound">Отдельно разберите <span data-heading-accent>входящие без ответа</span></h2>
    <p>Входящее письмо, звонок или чат может зажечь счётчик, но у такого дела нет крайнего срока. Оно не становится «просроченным делом» по тому же правилу, что запланированный звонок. Если команда обещает отвечать, например, за определённое время, это уже ваше правило реакции: запишите начало обращения, первый ответ и допустимый интервал. Проверяйте эти события в таймлайне, а не выводите просрочку ответа только из цвета счётчика.</p>
    <p>Если обращение вообще не найдено в CRM, начните с <a href={`${base}poteryannye-zayavki-bitrix24/`}>проверки пути заявки</a>. Если карточка есть, но её получил другой менеджер, отдельно проверьте правило распределения входящего канала и историю смены ответственного.</p>
  </section>

  <section aria-labelledby="daily">
    <h2 id="daily">Соберите <span data-heading-accent>ежедневный контроль</span></h2>
    <p>В начале смены менеджер проверяет свои дела на сегодня и сделки без следующего действия. Руководитель отдельно просматривает просроченные дела и, при наличии доступа, «CRM → Ещё → Мои дела» с фильтром «Все текущие дела» для незакрытых дел подчинённых. Для повторяемости сохраните условия отбора: направление, стадии, ответственные и дату проверки. Обсуждайте несколько карточек по ID и причине, а не только суммарное число.</p>
    <p>Если счётчик у руководителя и менеджера различается, проверьте выбранный режим: Битрикс24 может считать уведомления по ответственному за сделку либо по ответственному за дело. Права на просмотр и изменение карточек тоже влияют на то, какие записи сотрудник видит. Для конкретной сделки достаточно проверить её владельца, владельца дела и настройки счётчика; менять права всей команды ради диагностики не нужно.</p>
    <p>Мы разрабатываем MCP TrueTell для работы внешнего ИИ с данными Битрикс24. Готовую подписку и автоматические уведомления о сделках без дел сейчас не заявляем. При обсуждении будущего контроля можно заранее определить направления, стадии, допустимые сроки и права чтения, а также кто подтверждает результат проверки.</p>
    <InlineConsultation variant="product" title="Нужно разобраться со сделками без следующего шага?" description="Опишите направление и один пример без данных клиента. Поможем составить ручную проверку и требования к регулярному контролю." href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
  </section>

  <FaqSection title="Частые вопросы о делах в Битрикс24" items={faqItems} variant="article" />
  <p>Официальная справка Битрикс24 проверена 30 октября 2026 года. Конкретный клиентский портал не тестировался: состав меню, права и тариф сверяйте в своей CRM.</p>
  <ArticleSources publishedIso={article.publishedAt} modifiedIso={article.updatedAt} sources={sourceLinks} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Обсудим ' }, { text: 'MCP TrueTell для Битрикс24', accent: true }]} description={mcpProduct.articleDescription} href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <ConsultationCtaSection slot="after-article" />
</ArticleLayout>
