---
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import { blogArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { cleanerProductPath } from '../../config/products';
import leadCleanupImage from '../../images/articles/bitrix24-lead-cleanup.png';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';

const title = "Как удалить старые лиды в Битрикс24 за выбранный период";
const description = "Как удалить старые лиды в Битрикс24 по дате создания: настроить период и стадии, проверить выборку, выполнить массовое удаление и разобраться с корзиной CRM.";
const canonicalPath = '/bitrix24-udalenie-lidov-za-period/';
const publishedDate = '2026-09-22T00:00:00+03:00';
const authorName = companyInfo.editorial.defaultAuthor;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const cleanerHref = `${base}${cleanerProductPath.slice(1)}`;
const siteRoot = new URL(base, import.meta.env.SITE);
const homeUrl = siteRoot.toString();
const blogUrl = new URL('blog/', siteRoot).toString();
const articleUrl = new URL('bitrix24-udalenie-lidov-za-period/', siteRoot).toString();
const imageAlt = 'Схема отбора лидов по периоду, проверки карточек и разделения действующих обращений и записей для удаления';
const ogImage = new URL(leadCleanupImage.src, siteRoot).toString();
const ogDescription = 'Отбор по датам и текущей стадии, проверка карточек, массовое удаление и восстановление из корзины. Разбираем на примере одного квартала.';
const titleParts = [
  { text: 'Как удалить ' },
  { text: 'старые лиды в Битрикс24', accent: true },
  { text: ' за выбранный период' },
];
const breadcrumbs = [
  { label: 'Главная', href: base },
  { label: 'Блог', href: `${base}blog/` },
  { label: title },
];
const sourceLinks = [
  {
    "label": "Групповые действия в CRM — Поддержка24",
    "href": "https://helpdesk.bitrix24.ru/open/21064250/"
  },
  {
    "label": "Как работают фильтры в CRM — Поддержка24",
    "href": "https://helpdesk.bitrix24.ru/open/24206616/"
  },
  {
    "label": "Как экспортировать данные из CRM — Поддержка24",
    "href": "https://helpdesk.bitrix24.ru/open/20966844/"
  },
  {
    "label": "Что такое Корзина в CRM — Поддержка24",
    "href": "https://helpdesk.bitrix24.ru/open/24668648/"
  },
  {
    "label": "Как освободить место в CRM — Поддержка24",
    "href": "https://helpdesk.bitrix24.ru/open/26995556/"
  },
  {
    "label": "Ролевая модель прав в CRM — Поддержка24",
    "href": "https://helpdesk.bitrix24.ru/open/23240636/"
  },
  {
    "label": "Как удалить элементы CRM — Поддержка24",
    "href": "https://helpdesk.bitrix24.ru/open/23238660/"
  },
  {
    "label": "Частые вопросы о CRM — Поддержка24",
    "href": "https://helpdesk.bitrix24.ru/open/25817644/"
  }
];
const periodRows = [
  [
    "Лиды, поступившие с января по март",
    "Дата создания: 01.01.2025–31.03.2025"
  ],
  [
    "Лиды, созданные до начала 2025 года",
    "Дата создания до 01.01.2025; проверьте включение граничного дня"
  ],
  [
    "Лиды, переведённые на определённую стадию в первом квартале",
    "История стадий и дата изменения стадии; дополнительно проверьте текущее состояние"
  ],
  [
    "Старые обращения, с которыми никто не работает",
    "Дата — только первый критерий; нужны проверка карточек и согласование с ответственными"
  ]
];
const faqItems = [
  {
    "question": "Можно ли удалить все лиды старше определённой даты?",
    "answer": "Можно сформировать выборку по дате создания до выбранной границы. Но перед удалением проверьте актуальность этих обращений: возраст карточки не показывает, завершена ли работа с клиентом."
  },
  {
    "question": "Почему после фильтрации не находятся ожидаемые лиды?",
    "answer": "Проверьте оставшиеся условия, выбранное поле даты и права просмотра. Также учитывайте ограничения поиска на вашем тарифе. Начните с поиска одной известной карточки, чтобы понять, на каком условии она исчезает из результатов."
  },
  {
    "question": "Почему нет возможности удалить лид?",
    "answer": "Попросите администратора проверить права удаления именно для лидов и нужной группы записей. Доступ к просмотру карточки сам по себе не означает разрешение её удалять."
  },
  {
    "question": "Можно ли просто закрыть лиды и оставить их в базе?",
    "answer": "Если нужно убрать завершённые обращения из рабочего списка, настройте отображение по текущему состоянию. Сначала убедитесь, что работа действительно закончена, и согласуйте финальную стадию с менеджерами. Такой подход подходит, когда сведения нужны для дальнейшего анализа."
  },
  {
    "question": "Чем удаление старых лидов отличается от удаления дублей?",
    "answer": "Отбор по дате отвечает на вопрос, когда создали записи. Он не устанавливает, относятся ли две карточки к одному обращению. Если проблема в дублях, сначала выясните, какая информация хранится в каждой карточке: удаление более старой записи может убрать полезные сведения."
  }
];
const relatedArticles = blogArticles
  .filter((article) => article.hrefPath && article.hrefPath !== canonicalPath.slice(1))
  .slice(0, 3)
  .map((article) => ({ ...article, href: `${base}${article.hrefPath}` }));
const structuredData = createArticleStructuredData({
  title,
  description,
  articleUrl,
  publishedDate,
  publisherUrl: homeUrl,
  author: authorName,
  image: ogImage,
  articleSection: 'Работа с лидами в Битрикс24',
  breadcrumbs: [
    { name: 'Главная', item: homeUrl },
    { name: 'Блог', item: blogUrl },
    { name: title, item: articleUrl },
  ],
  faqItems,
});
---

<ArticleLayout
  {title}
  {titleParts}
  {description}
  {canonicalPath}
  {structuredData}
  ogTitle={title}
  {ogDescription}
  {ogImage}
  ogImageAlt={imageAlt}
  category="Битрикс24"
  intro="Разбираем очистку на примере одного квартала: как отобрать ненужные обращения, сохранить важные данные и проверить результат удаления."
  {breadcrumbs}
  author={authorName}
  publishedTime={publishedDate}
  modifiedTime={publishedDate}
>
  <Fragment slot="quick-answer">
    <p>Откройте список лидов, задайте фильтр по <strong>дате создания и текущей стадии</strong>. Проверьте найденные карточки, отметьте нужные записи и выберите групповое действие «Удалить».</p>
    <p>Опция <strong>«Для всех»</strong> распространяет действие на всю выборку, включая другие страницы. Для удаления нужны соответствующие права; возраст лида сам по себе не означает, что работа с ним завершена.</p>
  </Fragment>

  <p data-article-lead>Главная сложность начинается раньше нажатия кнопки. Лид, созданный год назад, может оставаться действующим: клиент вернулся к обсуждению, менеджер договорился о звонке, закупку перенесли на следующий квартал. Поэтому сначала определите, какие обращения действительно можно убрать, и только потом задавайте даты.</p>

  <section aria-labelledby="which-leads">
    <h2 id="which-leads">Какие старые лиды <span data-heading-accent>стоит удалять</span></h2>
    <p>Начните с причины очистки. Ошибочно загруженные записи и тестовые обращения — понятные кандидаты. С реальными заявками, даже неудачными, решение сложнее: они могут понадобиться для разбора рекламы, отказов и работы отдела продаж.</p>
    <p>Битрикс24 предупреждает, что удалённые элементы не участвуют в аналитических отчётах. Если убрать нецелевые обращения за прошлый квартал, отчёт может перестать отражать исходный поток заявок. Когда задача — убрать завершённую работу из повседневного списка, разумнее настроить его отображение, сохранив данные. <a href={sourceLinks[6].href} target="_blank" rel="noopener noreferrer">Пояснение Битрикс24 об удалении и отчётах</a>.</p>
    <p>Дальше разберём условный пример: компания решила удалить проверенные ненужные лиды, созданные с 1 января по 31 марта 2025 года. Работа с ними завершена, а потребность сохранять их для анализа предварительно обсудили с ответственными сотрудниками. Это учебный сценарий, а не клиентский кейс.</p>
  </section>

  <section aria-labelledby="date-range">
    <h2 id="date-range">Как выбрать период и <span data-heading-accent>сохранить действующие обращения</span></h2>
    <p>Для задачи «убрать лиды, поступившие в первом квартале» ориентируйтесь на дату создания. Задача «убрать лиды, которые забраковали в первом квартале» требует другого отбора: обращение могло поступить раньше, а перейти на финальную стадию позже.</p>
    <DataTable label="Как выбрать критерии отбора лидов" columns={['Что требуется найти', 'На что ориентироваться']} rows={periodRows} rowHeaders compact />
    <p>В фильтрах Битрикс24 различаются текущая стадия и стадия по истории. Исторический фильтр может найти лид, который раньше был забракован, а затем вернулся в работу. Для нашего сценария используйте текущее состояние «Лид забракован» или конкретную текущую стадию, принятую в вашей CRM. <a href={sourceLinks[1].href} target="_blank" rel="noopener noreferrer">Как работают фильтры в CRM</a>.</p>
    <p>Сами границы периода тоже лучше сформулировать заранее: например, «весь первый квартал, включая 31 марта». После настройки посмотрите несколько карточек на границах диапазона. Если ваш интерфейс позволяет задавать время, убедитесь, что конечная граница охватывает последний день целиком. Это особенно полезно при последующем переносе того же условия в приложение или интеграцию.</p>
    <ArticleFigure
      src={leadCleanupImage}
      alt={imageAlt}
      caption="Схема процесса, не скриншот Битрикс24: отбор по периоду → проверка карточек → сохранение нужных данных → удаление согласованной выборки. Действующие обращения остаются в CRM."
    />
  </section>

  <section aria-labelledby="delete-by-date">
    <h2 id="delete-by-date">Как удалить старые лиды <span data-heading-accent>по дате создания</span></h2>
    <h3>1. Откройте список и настройте фильтр</h3>
    <p>Перейдите в CRM, откройте лиды и выберите представление «Список». Нажмите <strong>«Фильтр + поиск»</strong>, проверьте уже заданные условия и добавьте нужные поля через <strong>«Добавить поле»</strong>. Для учебного примера задайте дату создания с 01.01.2025 по 31.03.2025 и текущее состояние забракованных лидов, затем выполните поиск. Если очистка касается одного менеджера, дополнительно ограничьте выборку ответственным. <a href={sourceLinks[1].href} target="_blank" rel="noopener noreferrer">Поиск элементов CRM, фильтры CRM</a>.</p>
    <p>Не оставляйте незамеченными условия от предыдущей работы. Например, ограничение по одному сотруднику может сделать выборку неполной. Перед продолжением прочитайте фильтр как предложение: «Созданы в первом квартале 2025 года, сейчас забракованы, относятся к выбранному ответственному». Оно должно совпадать с вашей задачей.</p>
    <h3>2. Проверьте карточки, которые попали в выборку</h3>
    <p>Откройте несколько записей с разными датами и ответственными. Посмотрите причину отказа, последние сообщения и договорённости. Если среди кандидатов встретилась карточка с обещанным повторным звонком, остановитесь и уточните отбор. Несколько проверок не доказывают безопасность всей выборки, но помогают обнаружить ошибку в самом правиле.</p>
    <p>Дополнительный фильтр <strong>«Дела → Нет дел»</strong> означает отсутствие запланированных дел. Он не доказывает, что лид бесполезен: сотрудник мог просто не поставить следующее напоминание. Используйте этот признак как повод для проверки, а не как самостоятельное основание для удаления. <a href={sourceLinks[1].href} target="_blank" rel="noopener noreferrer">Значения фильтра «Дела»</a>.</p>
    <h3>3. Сохраните данные и состав выборки</h3>
    <p>Если сведения могут понадобиться позже, выгрузите отобранные лиды. В режиме «Список» откройте настройки и выберите экспорт в CSV или Excel. Проверьте набор полей; при необходимости используйте экспорт всех полей. Для выгрузки требуются отдельные права. <a href={sourceLinks[2].href} target="_blank" rel="noopener noreferrer">Как экспортировать данные из CRM</a>.</p>
    <p>Скачанный файл откройте до удаления: убедитесь, что он читается и содержит ожидаемые записи. Полезно сохранить дату выгрузки, условия отбора и количество уникальных ID. Не считайте табличную выгрузку гарантией полного восстановления карточек со всей перепиской, файлами и связями: проверьте, какие сведения действительно попали в файл.</p>
    <InlineConsultation
      variant="product"
      title="Чистите старые лиды регулярно?"
      description="Посмотрите, как в CRM Cleaner выбрать период, проверить найденные лиды и исключить нужные карточки. На странице приложения — возможности, ограничения и демонстрация. Удаление пока доступно только на демонстрационных данных."
      href={cleanerHref}
      actionLabel="Посмотреть CRM Cleaner"
    />
    <h3>4. Выберите записи и выполните удаление</h3>
    <p>Отметьте проверенные лиды и выберите «Удалить» в групповых действиях. Если требуется обработать всю отфильтрованную выборку, включите <strong>«Для всех»</strong>: эта опция распространяет действие на другие страницы списка. Перед подтверждением ещё раз проверьте условия отбора. <a href={sourceLinks[0].href} target="_blank" rel="noopener noreferrer">Инструкция по групповым действиям</a>.</p>
    <p>Для первой очистки полезно начать с небольшой заведомо ненужной группы. Это позволит проверить результат на вашем портале. Если вы вручную исключали отдельные карточки, не переходите автоматически к удалению всей выборки: сначала убедитесь, что исключения будут сохранены, либо измените фильтр так, чтобы спорные лиды в него вообще не попадали.</p>
    <h3>5. Проверьте результат по тем же условиям</h3>
    <p>После завершения обновите список и повторите исходный фильтр. Если удаляли только часть записей, проверьте, что исчезли именно они. Если обрабатывали всю выборку, выясните причину оставшихся карточек, прежде чем повторять операцию.</p>
    <p>Сравнивать одни только числа недостаточно: пока шла очистка, другой сотрудник мог поменять стадию или ответственного. При расхождении сверяйте конкретные ID из сохранённого списка и сообщения об ошибках. Не расширяйте период, чтобы добиться пустого экрана: пустой экран сам по себе не подтверждает правильность удаления.</p>
  </section>

  <section aria-labelledby="crm-cleanup">
    <h2 id="crm-cleanup">Когда использовать <span data-heading-accent>очистку CRM</span></h2>
    <p>В Битрикс24 есть инструмент очистки CRM. Он находится по пути «CRM → Ещё → Настройки → Настройки CRM → Другое → Чем занято место». После сканирования можно оценить объём данных и задать фильтры по дате создания и группе стадий. Во время сканирования страницу следует оставить открытой. <a href={sourceLinks[4].href} target="_blank" rel="noopener noreferrer">Как освободить место в CRM</a>.</p>
    <p>Этот вариант стоит рассмотреть, если главная задача — разобраться, чем занято хранилище. Для первого удаления конкретной группы лидов удобнее начать со списка: так проще прочитать карточки и проверить, почему каждая из них оказалась среди кандидатов.</p>
    <p>У инструмента есть разные операции: удаление самих элементов и удаление их дел и истории. Выбирайте действие осознанно: очистка истории не равнозначна удалению лидов. <a href={sourceLinks[4].href} target="_blank" rel="noopener noreferrer">Варианты очистки CRM</a>.</p>
  </section>

  <section aria-labelledby="recycle-bin">
    <h2 id="recycle-bin">Куда попадают удалённые лиды и <span data-heading-accent>как их вернуть</span></h2>
    <p>Если корзина включена для лидов, удалённые записи можно найти в разделе <strong>«CRM → Ещё → Корзина»</strong>. Возможность восстановления зависит от тарифа. Администратор видит все удалённые элементы, сотрудник — удалённые им самим. Поэтому условия восстановления лучше проверить до очистки. <a href={sourceLinks[3].href} target="_blank" rel="noopener noreferrer">Корзина CRM</a>.</p>
    <p>Документация описывает хранение в течение 30 дней с последующим автоматическим удалением по 100 элементов в день; при большой очереди фактический срок может увеличиться. Не рассчитывайте на эту очередь как на дополнительную гарантию. При восстановлении у элемента меняется ID, поэтому прежняя ссылка на карточку не сохранится. <a href={sourceLinks[3].href} target="_blank" rel="noopener noreferrer">Сроки и восстановление</a>.</p>
    <p>Если цель — освободить хранилище, учитывайте ещё одно различие: данные в корзине продолжают занимать место. Окончательная очистка — отдельный шаг, к которому стоит переходить после проверки результата. <a href={sourceLinks[4].href} target="_blank" rel="noopener noreferrer">Удаление и занятое место</a>.</p>
  </section>

  <section aria-labelledby="application">
    <h2 id="application">Когда имеет смысл <span data-heading-accent>приложение для удаления</span></h2>
    <p>Штатное групповое удаление уже решает базовую задачу. Приложение стоит оценивать по тому, насколько оно помогает контролировать вашу конкретную очистку: показывает ли состав и количество найденных записей, позволяет ли задать необходимые условия, сообщает ли о результате и ошибках.</p>
    <p>Перед выбором составьте одно точное правило, например: «Удалить проверенные ненужные лиды первого квартала 2025 года, сохранив действующие обращения». Сравните, как это правило выполняется штатными средствами и выбранным приложением. Отдельно выясните, куда попадают удалённые записи и что произойдёт при прерывании операции.</p>
    <p>Если вы планируете регулярно очищать CRM, начните с описания сценария и небольшого теста. До подключения приложения проверьте его актуальную документацию: доступные фильтры, порядок подтверждения и условия восстановления должны соответствовать вашей задаче.</p>
