---
import ScenarioPage from '../../components/moysklad-scenario-page/moysklad-scenario-page.astro';
import Screenshot from '../../components/moysklad-scenario-page/scenario-screenshot.astro';
import ProductScenario from '../../components/product-scenario/product-scenario.astro';
import Checklist from '../../components/editorial/checklist.astro';
import { companyInfo } from '../../config/company';
import styles from '../bitrix24-cleaner/page.module.scss';
import productStyles from '../moysklad-mass-operations/page.module.scss';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const title = `Массовое изменение товаров в МойСклад — ${companyInfo.brandName}`;
const description = 'Меняйте несколько доступных полей товаров в МойСклад одной операцией. Отбирайте нужные карточки, проверяйте план изменений и сохраняйте отчёт о результате.';
const faqItems = [
  { question: 'Поддерживаются все поля карточки товара?', answer: 'Нет основания обещать изменение любого поля. Ориентируйтесь на поля, доступные в форме приложения, и заранее уточните нужный вам набор.' },
  { question: 'Можно ли вместе с этим пересчитать цены?', answer: 'В приложении есть отдельный сценарий пересчёта цен товаров по формуле с округлением. Для переоценки используйте соответствующую форму и проверяйте старые и новые значения.' },
  { question: 'Что делать, если часть товаров не изменилась?', answer: 'Посмотрите ошибки и пропуски в итоговом отчёте. Проверьте состояние конкретных объектов до повторного запуска, чтобы не применить изменения повторно к уже обработанным карточкам.' },
  { question: 'Есть ли возврат к прежним значениям одной кнопкой?', answer: 'Общего отката операций нет. Если прежние значения нужны для последующей сверки, сохраните их до изменения подходящим способом.' },
];
const steps = [
  { title: 'Настройте выборку товаров', description: 'Соберите карточки, к которым нужно применить одинаковые изменения.' },
  { title: 'Укажите изменения в доступных полях', description: 'Проверьте, что нужные поля поддерживаются выбранной формой приложения.' },
  { title: 'Проверьте план и количество объектов', description: 'Сопоставьте новые значения и состав выборки со своей задачей.' },
  { title: 'Подтвердите запуск и сверьте результат', description: 'Посмотрите отчёт и проверьте карточки товаров в МойСклад.' },
];
---

<ScenarioPage slug="izmenenie-tovarov" label="Изменение товаров" draft {title} {description} {faqItems}
  heroTitle="Массовое изменение товаров в МойСклад"
  heroDescription="Обновляйте несколько доступных полей сразу у выбранной группы товаров. Задайте изменения, проверьте план и подтвердите обработку карточек одной операцией."
  summaryDescription="Приложение помогает применить одинаковые изменения к группе товаров без открытия каждой карточки. Вы выбираете доступные поля, проверяете будущие значения и сверяете результат по отчёту."
  mentions={['Каталог товаров', 'Поля карточек', 'План изменений']}
  connectionTitle="Уточните возможности для вашего каталога"
  connectionDescription="Расскажите, какие поля нужно изменить и для каких товаров. Поможем сопоставить задачу с доступными действиями приложения и уточнить подключение.">
  <Fragment slot="summary-title">Приведите карточки товаров <strong>к нужным значениям</strong></Fragment>

  <ProductScenario id="product-fields-title" title="Обновить группу карточек по одному правилу"
    description="Например, при обновлении каталога нужно одинаково скорректировать доступные поля у нескольких товаров. Сначала соберите подходящие карточки в выборку."
    steps={[
      { icon: 'filter', title: 'Выберите нужные товары', text: 'Похожие названия не всегда означают одинаковые условия обработки.' },
      { icon: 'review', title: 'Задайте общий набор изменений', text: 'Укажите новые значения для нескольких доступных полей.' },
      { icon: 'report', title: 'Сверьте результат', text: 'Отчёт покажет выполненные изменения, ошибки и пропуски.' },
    ]}>
    <Screenshot filename="product-fields.png" title="Поля товаров для изменения" alt="Форма массового изменения товаров с доступными полями и демонстрационной выборкой"
      caption="Реальная форма приложения: доступные поля и новые значения для демонстрационных товаров." />
  </ProductScenario>

  <section class={productStyles.darkPanel} aria-labelledby="product-plan-title">
    <div class={productStyles.copy}>
      <h2 id="product-plan-title">Несколько полей в одной операции</h2>
      <p>Перед подтверждением сопоставьте объекты и новые значения с вашей задачей.</p>
      <h3>Общий набор изменений</h3>
      <p>Примените выбранные настройки к подготовленной группе товаров.</p>
      <h3>Проверка состава</h3>
      <p>Просмотрите план до запуска: в выборке должны остаться только нужные карточки.</p>
      <h3>Поддерживаемые поля</h3>
      <p>Перечень доступных полей нужно сверить в приложении перед подключением под конкретный процесс. Массовое изменение не означает поддержку любого поля карточки.</p>
    </div>
    <Screenshot filename="product-fields-plan.png" title="План изменения товаров" dark alt="План массового изменения: выбранные товары и подготовленные изменения полей"
      caption="Проверьте состав выборки и новые значения до подтверждения операции." />
  </section>

  <Fragment slot="editorial">
    <section aria-labelledby="product-workflow-title">
      <h2 id="product-workflow-title">Как обновить выбранную группу</h2>
      <Checklist items={steps} label="Порядок массового изменения товаров" />
      <aside data-article-note><p>При отборе по условиям форма по умолчанию выбирает первые 1000 подходящих объектов. Для более крупной выборки включите выбор всех найденных объектов. Без условий отбора в выборку попадут все объекты выбранного типа.</p></aside>
      <p>Если часть товаров осталась без изменений, сначала посмотрите ошибки и пропуски в отчёте. Проверьте конкретные карточки до повторного запуска.</p>
      <p class={styles.support}><a href={`${base}moysklad-izmenenie-cen/`}>Пересчёт цен товаров по формуле →</a></p>
      <p class={styles.support}><a href={`${base}moysklad-mass-operations/`}>Все массовые операции в приложении →</a></p>
    </section>
  </Fragment>
</ScenarioPage>
