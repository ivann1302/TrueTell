---
import AppHeader from '../../components/header/header.astro';
import SiteFooter from '../../components/footer/site-footer.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCatalogSection from '../../sections/product-catalog-section/product-catalog-section.astro';

const title = 'Продукты TrueTell — BI-аналитика, MCP и интеграции';
const description =
