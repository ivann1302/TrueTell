---
import AppHeader from '../../components/header/header.astro';
import SiteFooter from '../../components/footer/site-footer.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCatalogSection from '../../sections/product-catalog-section/product-catalog-section.astro';

const title = 'Продукты TrueTell — приложения для CRM и BI-аналитика';
const description =
  'Приложения TrueTell для CRM и бизнес-систем, BI-аналитика и решения для автоматизации торговли и продаж.';
---

<BaseLayout {title} {description} canonicalPath="/products/">
  <AppHeader />
  <main class="site-content">
    <ProductCatalogSection />
  </main>
  <SiteFooter />
</BaseLayout>
