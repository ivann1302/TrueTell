---
import ProductDevelopmentPage from '../../../components/product-development-page/product-development-page.astro';
import { cleanerProductPath } from '../../../config/products';

const heading = [
  { text: 'Клинер ' },
  { text: 'для Битрикс24', accent: true },
];
---

<ProductDevelopmentPage
  title="Клинер для Битрикс24 — TrueTell"
  description="Клинер TrueTell для удаления ненужных лидов и сделок по фильтрам в Битрикс24. Подробная страница продукта готовится."
  canonicalPath={cleanerProductPath}
  breadcrumbLabel="Клинер для Битрикс24"
  {heading}
