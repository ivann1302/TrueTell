---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { mcpProduct } from '../../config/products';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import settingsImage from '../../images/articles/bitrix24-robot-task-settings-072.png';
import verificationImage from '../../images/articles/bitrix24-robot-task-verification-072.png';

const article = getArticle('roboty-bitrix24/');
const { title, description } = article;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const ogImage = new URL(settingsImage.src, siteRoot).toString();
const imageAlt = 'Учебная карта настройки робота «Поставить задачу»: стадия сделки, название, исполнитель, крайний срок и момент запуска';
const faqItems = [
  { question: 'Когда запускается робот в сделке Битрикс24?', answer: 'Робот запускается, когда сделка попадает на стадию, где он настроен. В поле «Когда» можно выбрать «Текущее время» для запуска сразу после попадания на стадию или другое время. Дополнительное условие может ограничить запуск отдельными сделками.' },
  { question: 'Как поставить задачу при смене стадии сделки?', answer: 'В нужной воронке откройте CRM → Сделки → Роботы, выберите стадию и добавьте робота «Поставить задачу». Укажите название, описание, исполнителя и крайний срок. Сохраните настройки робота и страницу автоматизации, затем проверьте его на тестовой сделке.' },
  { question: 'Можно ли назначить задачу ответственному за сделку?', answer: 'Битрикс24 описывает выбор исполнителя из значения поля CRM, включая «Ответственный за сделку». Проверьте выбранное значение в настройке своего робота и фактического исполнителя в созданной задаче.' },
  { question: 'Почему задача не появилась после перехода сделки?', answer: 'Сначала проверьте, достигла ли сделка нужной стадии, затем статус робота в карточке, его время, условие и очередь запуска. Для подробной диагностики используйте отладчик и отдельную инструкцию о роботе, который не срабатывает.' },
  { question: 'Настроит ли MCP TrueTell такого робота автоматически?', answer: 'Автоматическую настройку и изменение роботов через MCP TrueTell мы пока не заявляем. Продукт для настройки и диагностики CRM находится в разработке; один сценарий можно описать для обсуждения требований.' },
];
const sourceLinks = [
  { label: 'Битрикс24: роботы в CRM — добавление, общие настройки и проверка', href: 'https://helpdesk.bitrix24.ru/open/24367166/' },
  { label: 'Битрикс24: робот «Поставить задачу»', href: 'https://helpdesk.bitrix24.ru/open/22892250/' },
  { label: 'Битрикс24: задачи в потоках и исполнитель из поля CRM', href: 'https://helpdesk.bitrix24.ru/open/21272066/' },
  { label: 'Битрикс24: очередь, время и условия роботов', href: 'https://helpdesk.bitrix24.ru/open/21491832/' },
  { label: 'Битрикс24: отладка на тестовой сделке', href: 'https://helpdesk.bitrix24.ru/open/19361194/' },
  { label: 'Битрикс24: права на настройку роботов в CRM', href: 'https://helpdesk.bitrix24.ru/open/23240636/' },
];
const settingsRows = [
  ['Где', 'Воронка «Продажи», стадия «КП готово»', 'Только сделки, попавшие на эту стадию'],
  ['Действие', 'Поставить задачу: «Проверить КП»', 'В задаче понятно, что проверить'],
  ['Исполнитель', 'Руководитель отдела продаж', 'Не остался исполнитель по умолчанию'],
  ['Срок', 'Через один день после создания задачи', 'Срок виден в открытой задаче'],
  ['Запуск', '«Текущее время», без дополнительного условия', 'Задача появляется после перехода'],
];
const structuredData = createArticleStructuredData({
  articleType: 'Article', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  breadcrumbs: [{ name: 'Главная', item: siteRoot.toString() }, { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() }, { name: title, item: articleUrl }],
  faqItems,
});
---
<ArticleLayout {title} titleParts={[{ text: 'Роботы Битрикс24: ' }, { text: 'задача при смене стадии сделки', accent: true }]} {description}
  canonicalPath={`/${article.hrefPath}`} {structuredData} ogTitle={article.seoTitle} ogDescription={description}
  {ogImage} ogImageAlt={imageAlt} category={article.category} author={authorName}
  intro="Робот может поставить задачу сотруднику, когда сделка дойдёт до нужной стадии. В примере руководитель проверяет коммерческое предложение после перехода сделки на этап «КП готово». Названия стадии и сотрудников условные.">
  <Fragment slot="quick-answer">
    <p><strong>Откройте роботов нужной воронки и добавьте «Поставить задачу» на целевую стадию.</strong> Заполните название, описание, исполнителя и срок; для немедленного запуска выберите «Текущее время». Сохраните робота и страницу автоматизации, затем переведите тестовую сделку на эту стадию и проверьте задачу в таймлайне.</p>
    <p>Роботы доступны не на всех тарифах. Для настройки нужны соответствующие права CRM. Если задача уже настроена, но не создаётся, перейдите к <a href={`${base}robot-ne-srabatyvaet-bitrix24/`}>диагностике срабатывания</a>.</p>
  </Fragment>

  <p data-article-lead>Коммерческое предложение готово, но перед отправкой клиенту его должен проверить руководитель. Если каждый раз ставить задачу вручную, легко пропустить одну карточку или забыть срок. После настройки робота проверьте, что задача действительно связана со сделкой.</p>

  <section aria-labelledby="prepare">
    <h2 id="prepare">Подготовьте стадию, <span data-heading-accent>задачу и права</span></h2>
    <p>Выберите конкретную воронку сделок и стадию, на которую менеджер переводит карточку после подготовки КП. В учебном примере это воронка «Продажи» и стадия «КП готово»; в вашем портале названия могут быть другими. Определите, кто проверяет документ и к какому сроку. Для первого теста достаточно одного исполнителя и одной задачи.</p>
    <p>Роботы CRM есть не на всех тарифах. Если вкладка или нужное действие недоступны, проверьте тариф. В правах CRM для роли есть отдельное действие «Роботы» — оно определяет возможность просматривать, настраивать или изменять роботов. Администратор может проверить право для сотрудника, который будет выполнять настройку. Для запуска отладчика требуется право «Разрешить изменять настройки CRM».</p>
    <ArticleFigure src={settingsImage} fullSize alt={imageAlt} caption="Редакционная карта настройки по справке Битрикс24. Стадия «КП готово» и исполнитель — учебный пример, а не снимок интерфейса или шаблон портала." />
  </section>

  <section aria-labelledby="configure">
    <h2 id="configure">Добавьте одного робота <span data-heading-accent>на нужную стадию</span></h2>
    <p>Перейдите в <strong>CRM → Сделки → Роботы</strong>. Если в CRM несколько воронок, выберите ту, где находится рабочая стадия. Нажмите «Создать», выберите стадию «КП готово» и найдите в группе управления задачами робота «Поставить задачу». Названия ваших стадий могут отличаться; робот должен стоять на этапе, при входе в который нужна проверка КП.</p>
    <p>Заполните название «Проверить КП» и добавьте название сделки из полей CRM, если хотите различать задачи в общем списке. В описании напишите, что именно проверять: состав предложения, цену и условия отправки. Выберите исполнителя — в нашем примере руководителя отдела продаж — и задайте крайний срок через один день после создания задачи. Поля робота «Название задачи», «Описание задачи», «Исполнитель» и «Крайний срок» описаны в справке Битрикс24.</p>
    <p>В общих настройках для этого примера оставьте запуск независимо от других роботов, в поле «Когда» выберите «Текущее время». Дополнительное условие пока не задавайте: для первого теста нужно увидеть, создаётся ли задача при каждом попадании сделки на эту стадию. Если в рабочем процессе задача нужна лишь части сделок, после успешного теста добавьте условие по конкретному полю и проверьте обе ветки — когда оно выполняется и когда нет.</p>
    <p>Сохраните настройки робота, затем сохраните всю страницу автоматизации. Если на стадии уже есть другие роботы, сначала посмотрите их время и очередь: новый робот не должен повторять уже существующую задачу. Настройку на рабочей воронке согласуйте с владельцем процесса до перевода реальных сделок.</p>
    <DataTable label="Учебная карта настройки робота Поставить задачу" columns={['Параметр', 'Что поставить в примере', 'Что проверить']} rows={settingsRows} rowHeaders />
  </section>

  <section aria-labelledby="test">
    <h2 id="test">Проверьте на тестовой сделке <span data-heading-accent>и сравните результат</span></h2>
    <p>Откройте отладчик через <strong>CRM → Сделки → Роботы → Отладчик роботов</strong> и выберите «Отладка на тестовой сделке». Битрикс24 создаст тестовую карточку на первой стадии. Заполните только данные, нужные для сценария. В отладчике выберите стадию и нажмите «Запустить отладку», затем последовательно переведите тестовую сделку на «КП готово». Отладчик покажет выполнение и ошибки в логе. Для задачи дополнительно откройте её из таймлайна сделки и проверьте название, исполнителя и крайний срок.</p>
    <p>Если в отладчике уже настроены другие роботы, их действия тоже могут запускаться на тестовой сделке. Перед тестом посмотрите состав автоматизации на стадиях и не используйте реальные контакты клиента. После проверки закройте отладчик; Битрикс24 позволяет удалить созданные тестовые сделки при завершении.</p>
    <ArticleFigure src={verificationImage} fullSize alt="Учебный лист приёмки робота: вход сделки на стадию, статус в логе, задача в таймлайне, исполнитель и срок" caption="Лист проверки на условной сделке. Отметки «ожидалось» и «проверить» не являются результатом теста клиентского портала; фактические значения записывайте после своего запуска." />
    <p>Отметка о выполнении робота не заменяет проверки задачи: откройте её и сверьте поля. Если задача не появилась, проверьте статус робота на вкладке «Роботы», время, условие и очередь. Пошаговый разбор такого сбоя есть в статье <a href={`${base}robot-ne-srabatyvaet-bitrix24/`}>«Робот Битрикс24 не срабатывает»</a>. Если сделка вообще не дошла до целевой стадии, сначала проверьте <a href={`${base}sdelka-ne-perehodit-stadiyu-bitrix24/`}>почему она не переходит</a>: причиной могут быть обязательные поля или права.</p>
  </section>

  <section aria-labelledby="next">
    <h2 id="next">Когда расширять сценарий <span data-heading-accent>и что оставить под контролем</span></h2>
    <p>После успешной проверки на тестовой сделке договоритесь, кто отвечает за изменение робота и как команда узнаёт о новой версии настройки. Для более сложного процесса можно заменить фиксированного исполнителя значением поля «Ответственный за сделку» — Битрикс24 допускает такой выбор в автоматизации задач. Проверьте его отдельно на двух сделках с разными ответственными, прежде чем применять к рабочей воронке.</p>
    <p>Если понадобится последовательность действий на нескольких стадиях, сначала составьте её карту. Отдельная статья <a href={`${base}audit-avtomatizacii-bitrix24/`}>об аудите автоматизации</a> поможет проверить, не конфликтуют ли роботы с бизнес-процессами. Для одного понятного поручения достаточно робота «Поставить задачу»; не добавляйте параллельную логику без необходимости.</p>
    <p>MCP TrueTell для настройки и диагностики CRM находится в разработке. Мы пока не заявляем автоматическое создание или изменение роботов через него. Если нужно обсудить диагностику конкретного процесса, подготовьте обезличенный маршрут: воронка, стадия, ожидаемая задача, фактический результат и статус в логе.</p>
    <InlineConsultation variant="product" title="Нужно проверить логику роботов в CRM?" description="Опишите один сценарий без данных клиентов: стадию, задачу, исполнителя и фактический результат. Поможем составить проверку и обсудить возможности диагностики." href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
  </section>

  <FaqSection title="Частые вопросы о роботах Битрикс24" items={faqItems} variant="article" />
  <p>Официальная справка Битрикс24 проверена 31 октября 2026 года. Учебный сценарий не тестировался в рабочем клиентском портале; тариф, интерфейс и права проверьте в своём Битрикс24.</p>
  <ArticleSources publishedIso={article.publishedAt} modifiedIso={article.updatedAt} sources={sourceLinks} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Обсудим ' }, { text: 'диагностику CRM с MCP TrueTell', accent: true }]} description={mcpProduct.articleDescription} href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <ConsultationCtaSection slot="after-article" />
</ArticleLayout>
