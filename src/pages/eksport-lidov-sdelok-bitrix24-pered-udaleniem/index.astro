---
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import Checklist from '../../components/editorial/checklist.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { cleanerProduct } from '../../config/products';
import exportFlowImage from '../../images/articles/bitrix24-export-columns-official.jpg';
import exportScopeImage from '../../images/articles/bitrix24-export-rows-official.jpg';
import uniqueIdsImage from '../../images/articles/bitrix24-export-unique-ids-infographic.png';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';

const article = getArticle('eksport-lidov-sdelok-bitrix24-pered-udaleniem/');
const { title, description } = article;
const canonicalPath = `/${article.hrefPath}`;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const cleanerHref = `${base}${article.relatedProduct!.slice(1)}`;
const authorName = companyInfo.editorial.defaultAuthor;
const imageAlt = 'Официальный пример выгрузки лидов Битрикс24 в Excel: составные поля в отдельных колонках и ID записей';
const ogImage = new URL(exportFlowImage.src, siteRoot).toString();
const titleParts = [
  { text: 'Как ' },
  { text: 'экспортировать лиды и сделки', accent: true },
  { text: ' из Битрикс24 перед массовым удалением' },
];
const sourceLinks = [
  { label: 'Как экспортировать данные из CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/20966844/' },
  { label: 'Ролевая модель прав в CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/23240636/' },
  { label: 'Как восстановить данные в Битрикс24 — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/24955644/' },
  { label: 'Импорт в CRM: ответы на частые вопросы — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/25817644/' },
];
const preparationSteps = [
  { title: 'Определите, какие записи должны уйти', description: 'Например, проверенные ненужные лиды или сделки в выбранной стадии. Отсутствие активности само по себе не доказывает, что запись больше не нужна.' },
  { title: 'Настройте и проверьте фильтр', description: 'Убедитесь, что найденный список соответствует задаче и не включает действующие обращения.' },
  { title: 'Экспортируйте записи в Excel или CSV', description: 'Выберите важные поля и дополнительные параметры выгрузки.' },
  { title: 'Проверьте файл', description: 'Сверьте ID, количество уникальных записей и значения полей с несколькими карточками CRM.' },
  { title: 'Сохраните оригинал', description: 'Ограничьте доступ к файлу по правилам компании и только после проверки переходите к удалению.' },
];
const leadSteps = [
  { title: 'Откройте CRM → Лиды → Список', description: 'Найдите лиды в меню CRM и переключитесь из канбана в «Список»: штатный экспорт выполняется из этого представления.' },
  { title: 'Задайте фильтр', description: 'Выберите период создания, текущее состояние и ответственного — в зависимости от того, какие лиды готовите к очистке.' },
  { title: 'Проверьте найденные карточки', description: 'Откройте несколько лидов и убедитесь, что фильтр не захватил действующие обращения. Одного количества записей недостаточно.' },
  { title: 'Выберите колонки списка', description: 'Через значок шестерёнки в таблице включите название, состояние, даты, ответственного и другие важные поля. ID попадёт в выгрузку автоматически.' },
  { title: 'Запустите экспорт', description: 'Откройте «Настройки» → «Экспорт в CSV» или «Экспорт в Excel». При необходимости включите «Экспортировать все поля», нажмите «Выполнить» и скачайте готовый файл.' },
];
const dealSteps = [
  { title: 'Откройте CRM → Сделки → Список', description: 'Если направлений продаж несколько, проверьте выбранную воронку. При необходимости выгрузите разные воронки отдельно и подпишите файлы.' },
  { title: 'Настройте фильтр', description: 'Используйте стадию, дату, ответственного или другой признак, по которому будет проводиться очистка.' },
  { title: 'Выберите важные колонки', description: 'Название, стадия, сумма, валюта, ответственный, даты создания и закрытия, контакты и компании — в пределах доступных полей. ID экспортируется автоматически.' },
  { title: 'Скачайте Excel или CSV', description: 'Выберите формат, укажите дополнительные параметры и дождитесь готовности файла.' },
];
const fieldRows = [
  ['ID записи', 'Сопоставить строку с исходным лидом или сделкой и исключить путаницу'],
  ['Название и тип записи', 'Проверить, что отобраны нужные объекты'],
  ['Состояние лида или стадия сделки', 'Не удалить активные обращения и незавершённые продажи'],
  ['Дата создания и другие используемые даты', 'Проверить условие «старше заданного срока»'],
  ['Ответственный', 'Согласовать очистку с владельцами записей'],
  ['Источник обращения, сумма, валюта', 'Сохранить полезный контекст для анализа'],
  ['Контакт, компания и пользовательские поля', 'Проверить сведения, необходимые бизнесу'],
];
const faqItems = [
  {
    question: 'Можно ли выгрузить лиды и сделки одним файлом?',
    answer: 'Штатный экспорт запускается из списка соответствующей сущности. Практичнее сохранить лиды и сделки в отдельные файлы с понятными именами и датой выгрузки.',
  },
  {
    question: 'Как экспортировать все сделки в Excel?',
    answer: 'Откройте список сделок, проверьте фильтры, выбранную воронку и доступные пользователю записи, затем выберите экспорт в Excel. Если нужны дополнительные поля, включите соответствующую настройку перед выгрузкой.',
  },
  {
    question: 'Можно ли экспортировать сделки только за месяц или год?',
    answer: 'Да. Перед экспортом установите фильтр по подходящему полю даты и нужному периоду. После скачивания файла проверьте даты по нескольким карточкам.',
  },
  {
    question: 'Как выгрузить сделки вместе с товарами?',
    answer: 'В параметрах экспорта включите детализацию по товарным позициям. Одна сделка с несколькими товарами может занять несколько строк файла, поэтому количество сделок сверяйте по уникальным ID.',
  },
  {
    question: 'Что делать, если сотруднику недоступен экспорт CRM?',
    answer: 'Попросите администратора проверить права на экспорт именно той сущности, с которой сотрудник работает. Наличие права на чтение ещё не означает право на выгрузку.',
  },
  {
    question: 'Можно ли восстановить удалённые лиды из CSV?',
    answer: 'CSV может помочь повторно создать или импортировать часть данных, но это не восстановление прежней карточки со всей историей и связями. Сначала проверьте корзину CRM и доступные способы восстановления удалённых лидов.',
  },
  {
    question: 'Достаточно ли одного Excel-файла перед очисткой CRM?',
    answer: 'Не всегда. Если важны документы, звонки, комментарии, история изменений или связанные записи, нужен дополнительный план сохранения этих данных. Экспорт таблицы нельзя считать полной резервной копией портала.',
  },
];
const relatedArticles = getRelatedArticles(article.hrefPath)
  .map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const structuredData = createArticleStructuredData({
  articleType: 'Article',
  title,
  description,
  articleUrl,
  publishedDate: article.publishedAt,
  modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(),
  author: authorName,
  image: ogImage,
  articleSection: 'Экспорт и сохранение данных Битрикс24',
  breadcrumbs: [
    { name: 'Главная', item: siteRoot.toString() },
    { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() },
    { name: title, item: articleUrl },
  ],
  faqItems,
});
---

<ArticleLayout
  {title} {titleParts} {description} {canonicalPath} {structuredData}
  ogTitle={article.seoTitle} ogDescription={description} {ogImage} ogImageAlt={imageAlt}
  category={article.category}
  intro="Последовательность выгрузки лидов и сделок, поля для сверки и типичные ошибки перед удалением большого числа записей."
  author={authorName}
>
  <Fragment slot="quick-answer">
    <p>Перед очисткой CRM выгрузите нужные лиды и сделки в <strong>Excel или CSV</strong>, затем проверьте файл. Откройте CRM → Лиды или Сделки → Список, настройте фильтр и колонки, выберите экспорт в меню «Настройки».</p>
    <p>Файл помогает сверить записи перед удалением. Он <strong>не является полной резервной копией портала</strong> и не гарантирует восстановления всей истории работы с клиентами.</p>
  </Fragment>

  <p data-article-lead>Перед массовым удалением зафиксируйте состав операции: какие записи отобраны, по каким условиям и какие сведения сохранены в файле. Подготовьте выгрузку и сверьте её с выборкой, учитывая ограничения штатного экспорта.</p>

  <p>После проверки выгрузки переходите к <a href={`${base}massovoe-udalenie-sdelok-bitrix24/`}>массовому удалению сделок</a>: отдельно проверьте воронку, состав выборки и действие «Для всех».</p>

  <section aria-labelledby="preparation">
    <h2 id="preparation">Короткий план <span data-heading-accent>перед очисткой CRM</span></h2>
    <Checklist items={preparationSteps} label="Подготовка экспорта перед удалением" />
    <ArticleFigure src={exportFlowImage} alt={imageAlt} fullSize caption="Официальный пример Поддержки24: результат экспорта лидов в Excel. Составные поля распределены по колонкам, ID находится справа. Данные демонстрационные; полноту своей выгрузки проверяйте отдельно." />
  </section>

  <section aria-labelledby="export-leads">
    <h2 id="export-leads">Как экспортировать <span data-heading-accent>лиды из Битрикс24</span></h2>
    <p>В Битрикс24 предусмотрен штатный экспорт записей CRM. Для лидов используйте следующий порядок; названия и расположение кнопок могут немного отличаться в разных интерфейсах.</p>
    <Checklist items={leadSteps} label="Порядок экспорта лидов из Битрикс24" />
    <p>В файл попадает текущий список по фильтру: ручное выделение нескольких строк не заменяет настройку выборки для экспорта. Поле <strong>ID выгружается всегда</strong>, даже если оно не выбрано среди колонок. По ID удобно сопоставлять строки с карточками CRM. <a href={sourceLinks[0].href} target="_blank" rel="noopener noreferrer">Официальная инструкция по экспорту</a>.</p>
    <h3 id="export-period">Как сохранить только лиды за определённый период</h3>
    <p>Примените фильтр по нужной дате до экспорта. Убедитесь, что поле относится к нужному событию: созданию записи, её изменению или другому действию, доступному в вашем портале.</p>
    <p>Подробный сценарий очистки за месяц, год или до заданной даты есть в инструкции <a href={`${base}bitrix24-udalenie-lidov-za-period/`}>«Как удалить старые лиды в Битрикс24 за выбранный период»</a>.</p>
  </section>

  <section aria-labelledby="export-deals">
    <h2 id="export-deals">Как экспортировать <span data-heading-accent>сделки из Битрикс24</span></h2>
    <p>Порядок похож на экспорт лидов, но дополнительно нужно проверить воронку и стадии сделок.</p>
    <Checklist items={dealSteps} label="Порядок экспорта сделок из Битрикс24" />
    <p>Если включена опция <strong>«Экспортировать с детализацией по товарным позициям»</strong>, одна сделка с несколькими товарами может попасть в файл несколькими строками. Количество строк Excel тогда не совпадает с количеством сделок: для сверки считайте <strong>уникальные ID</strong>. Это описано в <a href={sourceLinks[0].href} target="_blank" rel="noopener noreferrer">справке Битрикс24</a>.</p>
    <p>Если задача — очистить неуспешные продажи, сначала смотрите <a href={`${base}udalenie-proigrannyh-sdelok-bitrix24/`}>как удалить проигранные сделки и сохранить нужные</a>.</p>
  </section>

  <section aria-labelledby="export-fields">
    <h2 id="export-fields">Какие поля <span data-heading-accent>проверить в выгрузке</span></h2>
    <p>Один набор не подходит всем компаниям. Перед удалением проверьте как минимум идентификаторы, условия отбора и сведения, необходимые вашему бизнесу.</p>
    <DataTable label="Поля выгрузки для проверки перед удалением" columns={['Что проверить', 'Зачем это нужно']} rows={fieldRows} rowHeaders compact />
    <p>Чтобы сохранить все экспортируемые поля сущности, используйте «Экспортировать все поля». Для сделок есть отдельная опция выгрузки полей связанных контактов и компаний. Но даже такой файл не заменяет резервную копию всей CRM.</p>
    <h3 id="export-format">Excel или CSV?</h3>
    <p>Excel удобен для ручной проверки и анализа в таблице. CSV часто выбирают для переноса данных в другую систему или Битрикс24. Для штатного импорта элементов CRM в Битрикс24 подготовьте CSV: наличие файла Excel не означает, что XLSX можно напрямую загрузить в тот же инструмент. Перед импортом проверьте значения, кодировку и формат колонок по <a href={sourceLinks[3].href} target="_blank" rel="noopener noreferrer">официальным ответам об импорте CRM</a>.</p>
  </section>

  <section aria-labelledby="verify-file">
    <h2 id="verify-file">Как проверить файл <span data-heading-accent>перед массовым удалением</span></h2>
    <p>После скачивания не переходите сразу к очистке. Сверка помогает обнаружить ошибку до того, как записи исчезнут из CRM.</p>
    <h3 id="verify-filter">1. Сверьте фильтр и дату</h3>
    <p>Запишите условия выгрузки, например: «лиды в текущем состоянии X, созданные до даты Y». Если потом изменить фильтр, экспорт и удаляемый набор перестанут совпадать. Во время подготовки другой сотрудник также может изменить карточки, поэтому перед удалением сверку стоит повторить.</p>
    <h3 id="verify-count">2. Сравните количество записей</h3>
    <p>Сопоставьте число подходящих элементов в CRM и количество уникальных ID в файле. При детализации по товарам считайте каждую сделку один раз, независимо от числа строк с её ID.</p>
    <h3 id="verify-cards">3. Откройте несколько карточек по ID</h3>
    <p>Возьмите записи из начала, середины и конца списка. Проверьте текущее состояние, ответственного, даты и другие важные поля. Выборочная проверка помогает найти ошибку в фильтре, но не доказывает, что каждый элемент можно удалить.</p>
    <h3 id="verify-readability">4. Убедитесь, что файл читается</h3>
    <p>Откройте его в табличном редакторе. Названия колонок должны быть понятными, телефоны и идентификаторы — не искажёнными, важные ячейки — заполненными. При необходимости задайте для идентификаторов и телефонов текстовый формат при импорте файла в редактор.</p>
    <h3 id="save-original">5. Сохраните оригинал</h3>
    <p>Назовите файл так, чтобы было понятно его содержимое, например <code>leads-before-cleanup-2026-10-09.xlsx</code>. Выгрузка может содержать персональные данные клиентов: ограничьте доступ и храните её по правилам компании. Для правок и анализа используйте отдельную копию.</p>
    <ArticleFigure src={exportScopeImage} alt="Официальный пример экспорта сделок с товарами: ID 995 занимает две строки файла" fullSize caption="Скриншот из справки Поддержки24: сделка с ID 995 содержит два товара и занимает две строки. Пять товарных строк здесь относятся к четырём сделкам. Это демонстрационная выгрузка, а не показатели TrueTell." />
    <ArticleFigure src={uniqueIdsImage} alt="Инфографика сверки экспорта: пять строк товаров, четыре уникальных ID сделки, ID 995 встречается дважды" fullSize caption="Инфографика по тому же официальному примеру: перед удалением сверяйте количество уникальных ID. Две строки с ID 995 не означают две разные сделки. Это объяснение данных, не интерфейс Битрикс24." />
  </section>

  <section aria-labelledby="export-backup">
    <h2 id="export-backup">Почему Excel или CSV — <span data-heading-accent>не полная резервная копия</span></h2>
    <p>Экспорт сохраняет поля выбранных элементов и предусмотренные настройками дополнительные данные. Обычный файл не следует воспринимать как точную копию всего портала, которую можно восстановить одной кнопкой.</p>
    <p>Строка сделки в таблице сама по себе не подтверждает, что сохранены вся история коммуникаций, файлы, записи звонков, комментарии, автоматизации, настройки воронок и связанные сущности. Для критически важных данных нужен отдельный план сохранения и восстановления.</p>
    <p>Если требуется восстановить состояние облачного портала, заранее изучите варианты резервного копирования и условия тарифа. По справке Битрикс24, полное восстановление выполняется через поддержку и возвращает портал к состоянию на выбранную дату. Данные, добавленные позже, будут удалены. Это другой процесс, чем повторный импорт CSV. <a href={sourceLinks[2].href} target="_blank" rel="noopener noreferrer">Как восстановить данные в Битрикс24</a>.</p>
    <p>В <a href={`${base}rezervnaya-kopiya-bitrix24/`}>статье о резервной копии Битрикс24</a> сравниваем облачный откат, архив коробочной версии и выгрузку CRM перед очисткой.</p>
    <p>Экспорт полезен для сверки и дополнительного сохранения сведений, но не отменяет риски удаления. Если лиды уже удалены, сначала проверьте <a href={`${base}udalennye-lidy-bitrix24/`}>корзину CRM и способы восстановления</a>.</p>
  </section>

  <section aria-labelledby="export-errors">
    <h2 id="export-errors">Почему <span data-heading-accent>не получается экспортировать</span> лиды или сделки</h2>
    <h3 id="missing-export">В меню нет кнопки экспорта</h3>
    <p>Проверьте представление: штатный экспорт доступен в режиме «Список». Затем уточните права пользователя. «Экспорт» настраивается отдельно для сущностей CRM; доступ к чтению сделок не означает, что их можно выгрузить. <a href={sourceLinks[1].href} target="_blank" rel="noopener noreferrer">Как настроить права доступа</a>.</p>
    <h3 id="wrong-records">Выгрузились не те записи</h3>
    <p>Перепроверьте фильтр, выбранное направление сделок и права просмотра. Перед повторным экспортом уберите лишние условия и задайте отбор заново. Не удаляйте данные, пока выгруженный набор не совпадёт с согласованной выборкой.</p>
    <h3 id="missing-field">В файле нет нужного поля</h3>
    <p>Проверьте колонки списка или включите «Экспортировать все поля». Для связанных контактов и компаний используйте соответствующую отдельную опцию и проверьте результат в готовом файле.</p>
    <h3 id="extra-rows">В Excel больше строк, чем сделок</h3>
    <p>Проверьте детализацию по товарным позициям. Если у сделки несколько товаров, её ID повторяется в нескольких строках. Сверяйте количество уникальных ID, а не общее число строк.</p>
  </section>

  <section aria-labelledby="after-export">
    <h2 id="after-export">Как перейти от экспорта к <span data-heading-accent>проверенной выборке для удаления</span></h2>
    <p>После проверки у вас есть состав будущей операции и файл с доступными для экспорта сведениями. Перед удалением снова сверьте фильтр и ожидаемое количество, согласуйте исключения для важных записей и подготовьте действия на случай ошибки.</p>
    <p>В <a href={`${base}massovoe-udalenie-lidov-bitrix24/`}>инструкции по массовому удалению лидов</a> разобраны выбор отдельных строк и действие «Для всех». Для очистки по фильтрам с предварительной проверкой списка можно использовать наше приложение. Выгрузку и проверку данных выполняйте отдельно: приложение предназначено для удаления лидов и сделок и не заменяет резервное копирование.</p>
    <InlineConsultation variant="product" title="Готовите массовую очистку CRM?" description={cleanerProduct.articleDescription} href={cleanerHref} actionLabel={cleanerProduct.articleActionLabel} />
  </section>

  <FaqSection items={faqItems} id="faq" variant="article" />
  <ArticleSources publishedIso={article.publishedAt} sources={sourceLinks} />

  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Удаление ' }, { text: 'после проверки данных', accent: true }]} description={cleanerProduct.marketplaceArticleDescription} href={cleanerProduct.marketplaceUrl} actionLabel={cleanerProduct.connectionActionLabel} />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <Fragment slot="after-article">
    <ConsultationCtaSection />
  </Fragment>
</ArticleLayout>
