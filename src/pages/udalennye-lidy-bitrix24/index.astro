---
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import { blogArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { cleanerProductPath } from '../../config/products';
import leadRecoveryImage from '../../images/articles/bitrix24-lead-recovery.png';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';

const title = "Удалённые лиды в Битрикс24: где искать и как восстановить";
const seoTitle = "Удалённые лиды в Битрикс24: где найти и как восстановить";
const description = "Как найти удалённые лиды в Битрикс24 и восстановить их из корзины. Что делать, если записи нет, как проверить результат и избежать ошибок при очистке CRM.";
const canonicalPath = '/udalennye-lidy-bitrix24/';
const publishedDate = '2026-09-23T00:00:00+03:00';
const authorName = companyInfo.editorial.defaultAuthor;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const cleanerHref = `${base}${cleanerProductPath.slice(1)}`;
const siteRoot = new URL(base, import.meta.env.SITE);
const homeUrl = siteRoot.toString();
const blogUrl = new URL('blog/', siteRoot).toString();
const articleUrl = new URL('udalennye-lidy-bitrix24/', siteRoot).toString();
const imageAlt = "Схема восстановления лида из корзины CRM с последующей проверкой контактов и связей";
const ogImage = new URL(leadRecoveryImage.src, siteRoot).toString();
const ogDescription = "Где искать пропавшие лиды, как проверить восстановленную карточку и что учесть перед следующей очисткой CRM.";
const titleParts = [
  { text: 'Удалённые лиды в Битрикс24', accent: true },
  { text: ': где искать и как восстановить' },
];
const breadcrumbs = [
  { label: 'Главная', href: base },
  { label: 'Блог', href: `${base}blog/` },
  { label: title },
];
const sourceLinks = [
  {
    "label": "Что такое Корзина в CRM — Поддержка24",
    "href": "https://helpdesk.bitrix24.ru/open/24668648/"
  },
  {
    "label": "Как восстановить данные в Битрикс24 — Поддержка24",
    "href": "https://helpdesk.bitrix24.ru/open/24955644/"
  }
];
const recoveryRows = [
  [
    "Не хватает одного обращения, сохранилось письмо или заявка",
    "Собрать доступные сведения и оценить ручное создание карточки"
  ],
  [
    "После очистки исчезла большая группа нужных лидов",
    "Передать администратору период удаления, примеры записей и условия отбора"
  ],
  [
    "Неясно, что именно произошло",
    "Сначала установить масштаб проблемы, затем выбирать способ восстановления"
  ]
];
const faqItems = [
  {
    "question": "Нужно ли сразу создавать лид заново, если он пропал?",
    "answer": "Сначала выполните поиск и попросите администратора проверить карточку. Повторное создание до выяснения причины может привести к появлению двух записей об одном обращении."
  },
  {
    "question": "Что передать администратору для поиска удалённого лида?",
    "answer": "Контакты клиента, примерное время удаления и старую ссылку, если она сохранилась. Если пропало несколько обращений, добавьте примеры и описание операции, после которой заметили проблему."
  },
  {
    "question": "Можно ли восстановить работу с клиентом по письму с сайта?",
    "answer": "Письмо может помочь заново заполнить контакты и содержание заявки. Но отдельно придётся собрать результаты переговоров и текущие договорённости: исходная заявка не описывает всю последующую работу."
  },
  {
    "question": "Что проверить перед следующей массовой очисткой?",
    "answer": "Соответствуют ли условия отбора вашей задаче и выглядит ли количество найденных записей ожидаемым. Дополнительно просмотрите несколько карточек, чтобы убедиться, что в выборку не попали нужные обращения."
  }
];
const relatedArticles = blogArticles
  .filter((article) => article.hrefPath && article.hrefPath !== canonicalPath.slice(1))
  .slice(0, 3)
  .map((article) => ({ ...article, href: `${base}${article.hrefPath}` }));
const structuredData = createArticleStructuredData({
  title,
  description,
  articleUrl,
  publishedDate,
  publisherUrl: homeUrl,
  author: authorName,
  image: ogImage,
  articleSection: 'Работа с лидами в Битрикс24',
  breadcrumbs: [
    { name: 'Главная', item: homeUrl },
    { name: 'Блог', item: blogUrl },
    { name: title, item: articleUrl },
  ],
  faqItems,
});
---


<ArticleLayout
  title={seoTitle} {titleParts} {description} {canonicalPath} {structuredData}
  ogTitle={title} {ogDescription} {ogImage} ogImageAlt={imageAlt}
  category="Битрикс24"
  intro="Где искать пропавшую карточку, как вернуть её из корзины и что проверить перед продолжением работы с клиентом."
  {breadcrumbs} author={authorName} publishedTime={publishedDate} modifiedTime={publishedDate}
>
  <Fragment slot="quick-answer">
    <p>Ищите удалённый лид в разделе <strong>CRM → Ещё → Корзина</strong>. Найдите запись и выберите в её меню «Восстановить».</p>
    <p>Возможность восстановления зависит от тарифа, а стандартный срок хранения — <strong>до 30 дней</strong>. Если записи нет, попросите администратора проверить её наличие и настройки корзины.</p>
  </Fragment>

  <p data-article-lead>Отсутствие карточки в привычном списке ещё не доказывает удаление. Прежде чем заново создавать лид или обсуждать откат CRM, стоит понять, что произошло: запись исчезла из вашей выборки, стала недоступна или действительно удалена.</p>

  <section aria-labelledby="check-deletion">

    <h2 id="check-deletion">Сначала проверьте, <span data-heading-accent>действительно ли лид удалён</span></h2>

    <p>Откройте список лидов и проверьте условия поиска. Уберите ограничения по ответственному, дате и статусу, затем попробуйте найти клиента по телефону или электронной почте. Для диагностики полезнее точный контакт, чем название вроде «Заявка с сайта»: одинаковых названий может быть много.</p>

    <p>Если карточка не находится, передайте администратору всё, что о ней известно: имя клиента, контактные данные, приблизительную дату обращения, старую ссылку. Попросите выполнить поиск со своей учётной записи и проверить права доступа. Это поможет отделить проблему видимости от потери данных.</p>

    <p>Представим, что менеджер вчера работал с обращением, а сегодня не видит его среди своих лидов. Перед созданием новой карточки стоит выяснить, не передали ли обращение коллеге и не продолжилась ли работа с клиентом в другой записи. Иначе к первоначальной проблеме добавится дубль.</p>

  </section>

  <section aria-labelledby="find-trash">

    <h2 id="find-trash"><span data-heading-accent>Где найти</span> удалённые лиды в Битрикс24</h2>

    <p>В корзине задайте тип «Лид» и период удаления. При необходимости уточните пользователя, удалившего запись, или её ID. Администратор видит все удалённые элементы, сотрудник — только удалённые им самим. <a href={sourceLinks[0].href} target="_blank" rel="noopener noreferrer">Справка о корзине CRM</a>.</p>

    <p>Не путайте дату обращения с датой удаления. Если клиент оставил заявку весной, а базу чистили вчера, искать нужно среди вчерашних удалений. Начните с предполагаемого периода очистки и расширяйте его, если результат пустой.</p>

    <p>Если известно о массовой ошибке, временно остановите последующие очистки и сохраните условия, по которым отбирали записи. Для разбора ситуации полезно знать не только имя пропавшего клиента, но и границы всей затронутой выборки.</p>

    <ArticleFigure src={leadRecoveryImage} alt={imageAlt} caption="Схема возврата лида: найти запись в корзине, восстановить её и проверить данные в CRM. Это иллюстрация, а не экран Битрикс24." />

  </section>

  <section aria-labelledby="restore-lead">

    <h2 id="restore-lead">Как <span data-heading-accent>восстановить удалённый лид</span> и проверить результат</h2>

    <p>В меню найденной записи нажмите «Восстановить» и дождитесь уведомления. Учтите два нюанса: восстановленный элемент получает новый ID, а удалённые связанные дела нужно возвращать после самого элемента. <a href={sourceLinks[0].href} target="_blank" rel="noopener noreferrer">Справка о корзине CRM</a>.</p>

    <p>После этого найдите карточку в CRM и проверьте, можно ли продолжать работу с клиентом: указаны ли нужные контакты, верный ответственный и актуальный статус. Отдельно просмотрите предстоящие договорённости — кому и когда нужно позвонить, какое предложение отправить. Цель проверки — убедиться, что обращение снова можно обрабатывать.</p>

    <p>Если ссылку на лид сохраняли в рабочем документе или внешней системе, обновите её. Когда интеграция использует идентификатор карточки, передайте новый ID её администратору и попросите проверить связь. Не стоит считать восстановление завершённым только потому, что запись появилась в списке.</p>

    <InlineConsultation
      variant="product"
      title="Лид восстановлен — пересмотрите следующую очистку"
      description="Когда нужные обращения возвращены и проверены, для последующего удаления ненужных лидов по фильтрам можно рассмотреть наш клинер для Битрикс24. Он предназначен для очистки CRM, а восстановление выполняется средствами самого Битрикс24. Подробная страница приложения готовится."
      href={cleanerHref} actionLabel="Посмотреть клинер"
    />

  </section>

  <section aria-labelledby="missing-from-trash">

    <h2 id="missing-from-trash">Почему лида <span data-heading-accent>нет в корзине</span></h2>

    <p>Попросите администратора проверить настройки: для отдельных типов элементов CRM корзину можно отключить. Также запись могли окончательно удалить. После стандартного срока хранения автоматическая очистка идёт по 100 элементов в день, поэтому отдельные записи остаются дольше; рассчитывать на это как на дополнительный срок восстановления не стоит. <a href={sourceLinks[0].href} target="_blank" rel="noopener noreferrer">Справка о корзине CRM</a>.</p>

    <p>Дальнейший путь зависит от масштаба потери и от того, какие сведения удалось сохранить.</p>

    <DataTable label="Что делать, если удалённого лида нет в корзине" columns={["Ситуация", "Что делать дальше"]} rows={recoveryRows} rowHeaders compact />

    <p>Создать карточку повторно и восстановить прежнюю запись — разные задачи. Телефон и имя позволяют связаться с клиентом, но сами по себе не возвращают контекст переговоров. Если восстанавливаете сведения вручную, отделяйте подтверждённые договорённости от предположений.</p>

  </section>

  <section aria-labelledby="portal-backup">

    <h2 id="portal-backup">Можно ли вернуть лиды, если <span data-heading-accent>корзина уже очищена</span></h2>

    <p>Для облачного Битрикс24 можно обсудить с поддержкой восстановление из резервной копии. По официальной справке, копии создаются ежедневно и хранятся семь дней; наличие подходящей копии и доступность операции на тарифе проверяет поддержка. Запрос отправляет администратор. <a href={sourceLinks[1].href} target="_blank" rel="noopener noreferrer">Справка о восстановлении данных</a>.</p>

    <p><strong>Откат возвращает весь портал к выбранной дате, а изменения после неё удаляются.</strong> Это затронет работу всех сотрудников, поэтому для одного потерянного обращения последствия могут оказаться серьёзнее самой потери. <a href={sourceLinks[1].href} target="_blank" rel="noopener noreferrer">Справка о восстановлении данных</a>.</p>

    <p>Допустим, лид удалили утром, а за день команда получила новые заявки и внесла результаты переговоров. Прежде чем соглашаться на откат, нужно оценить и эти изменения. В обращении в поддержку опишите объём потери и нужный период; решение принимайте после уточнения последствий и порядка сохранения актуальных сведений.</p>

    <p>Для коробочной версии обсудите доступные резервные копии и процедуру восстановления с администратором вашей установки. Не переносите на неё условия облачного сервиса автоматически.</p>

  </section>

  <section aria-labelledby="cleanup-rules">

    <h2 id="cleanup-rules">Как чистить CRM, чтобы <span data-heading-accent>реже приходилось восстанавливать</span> лиды</h2>

    <p>После возврата нужных обращений стоит пересмотреть критерии очистки. Формулировка «удалим всё старое» слишком широкая: дата создания ничего не говорит о том, завершена ли работа с клиентом. Старое обращение может оставаться актуальным, а вчерашняя тестовая заявка уже не нужна.</p>

    <p>Перед удалением сформулируйте правило словами: какие обращения больше не представляют ценности и почему. Затем переведите его в условия отбора и проверьте несколько карточек из результата, особенно записи на границе выбранного периода. Если среди них есть клиент с незавершённой договорённостью, критерии нужно уточнить.</p>

    <p>Полезно сверять и объём выборки. Если вы ожидали несколько десятков записей, а получили несколько тысяч, остановитесь и проверьте фильтр. Такое расхождение — повод разобраться до запуска операции.</p>

    <p>Для регулярной очистки мы разрабатываем клинер — приложение для удаления ненужных лидов и сделок в Битрикс24 по фильтрам. Перед использованием нужно согласовать правила отбора и проверить доступные возможности. Восстановление уже удалённых данных зависит от механизмов самого Битрикс24.</p>

    <p>Порядок отбора разобран в инструкции <a href={`${base}bitrix24-udalenie-lidov-za-period/`}>как удалить старые лиды в Битрикс24 за выбранный период</a>. Если сама операция завершается ошибкой, начните с диагностики: <a href={`${base}ne-udalyaetsya-lid-bitrix24/`}>почему не удаляется лид в Битрикс24</a>.</p>

  </section>

  <FaqSection items={faqItems} id="faq" variant="article" />
  <ArticleSources publishedIso="2026-09-23" publishedLabel="23 сентября 2026" sources={sourceLinks} />
  <Fragment slot="article-end">
    <ArticleProductCta
      titleParts={[{ text: 'Следующая очистка — ' }, { text: 'по понятным правилам', accent: true }]}
      description="После восстановления нужных данных согласуйте условия отбора. Наш клинер для Битрикс24 предназначен для удаления ненужных лидов и сделок по фильтрам."
      href={cleanerHref} actionLabel="Перейти к клинеру"
    />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <Fragment slot="after-article">
    <ConsultationCtaSection
      title="Клинер для Битрикс24"
      description="Удаление ненужных лидов и сделок по фильтрам. Подробная страница продукта готовится."
      href={cleanerHref} actionLabel="Перейти к клинеру"
    />
  </Fragment>
</ArticleLayout>
