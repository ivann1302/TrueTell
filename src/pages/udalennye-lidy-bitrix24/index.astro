---
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import Checklist from '../../components/editorial/checklist.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import LineWave from '../../components/ui/line-wave.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { cleanerProduct } from '../../config/products';
import leadRecoveryImage from '../../images/articles/bitrix24-lead-recovery.png';
import safeCleanupImage from '../../images/articles/bitrix24-safe-cleanup.png';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';

const article = getArticle('udalennye-lidy-bitrix24/');
const title = article.title;
const seoTitle = article.seoTitle ?? article.title;
const description = article.description;
const canonicalPath = `/${article.hrefPath}`;
const publishedDate = article.publishedAt;
const modifiedDate = article.updatedAt;
const authorName = companyInfo.editorial.defaultAuthor;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const cleanerHref = `${base}${article.relatedProduct!.slice(1)}`;
const siteRoot = new URL(base, import.meta.env.SITE);
const homeUrl = siteRoot.toString();
const knowledgeBaseUrl = new URL('knowledge-base/', siteRoot).toString();
const articleUrl = new URL('udalennye-lidy-bitrix24/', siteRoot).toString();
const imageAlt = "Схема восстановления лида из корзины CRM с последующей проверкой контактов и связей";
const ogImage = new URL(leadRecoveryImage.src, siteRoot).toString();
const ogDescription = description;
const titleParts = [
  { text: 'Удалённые лиды в Битрикс24', accent: true },
  { text: ': где найти и как восстановить' },
];
const breadcrumbs = [
  { label: 'Главная', href: base },
  { label: 'База знаний', href: `${base}knowledge-base/` },
  { label: title },
];
const sourceLinks = [
  {
    "label": "Что такое Корзина в CRM — Поддержка24",
    "href": "https://helpdesk.bitrix24.ru/open/24668648/"
  },
  {
    "label": "Как восстановить данные в Битрикс24 — Поддержка24",
    "href": "https://helpdesk.bitrix24.ru/open/24955644/"
  },
  {
    label: 'Групповые действия в CRM — Поддержка24',
    href: 'https://helpdesk.bitrix24.ru/open/21064250/',
  },
  {
    label: 'Как удалить элементы CRM — Поддержка24',
    href: 'https://helpdesk.bitrix24.ru/open/23238660/',
  },
  {
    label: 'Как освободить место в CRM — Поддержка24',
    href: 'https://helpdesk.bitrix24.ru/open/26995556/',
  },
];
const recoveryRows = [
  [
    "Не хватает одного обращения, сохранилось письмо или заявка",
    "Собрать доступные сведения и оценить ручное создание карточки"
  ],
  [
    "После очистки исчезла большая группа нужных лидов",
    "Передать администратору период удаления, примеры записей и условия отбора"
  ],
  [
    "Неясно, что именно произошло",
    "Сначала установить масштаб проблемы, затем выбирать способ восстановления"
  ]
];
const faqItems = [
  {
    question: 'Где посмотреть удалённые лиды в Битрикс24?',
    answer: 'Откройте CRM → Ещё → Корзина и выберите тип «Лид» в фильтре. Администратор видит все удалённые элементы, сотрудник — только удалённые им самим.',
  },
  {
    question: 'Сколько хранятся удалённые лиды?',
    answer: 'Стандартный срок хранения в Корзине CRM — до 30 дней. Важные записи лучше восстанавливать сразу, не рассчитывая на задержку автоматической очистки.',
  },
  {
    question: 'Можно ли восстановить удалённый лид?',
    answer: 'Да, пока запись находится в корзине и восстановление доступно на вашем тарифе. Выберите «Восстановить» в меню нужного элемента.',
  },
  {
    question: 'Сохранится ли ID лида после восстановления?',
    answer: 'Нет, восстановленный элемент получает новый ID. Найдите его в CRM и обновите сохранённую ссылку на карточку.',
  },
  {
    question: 'Почему я не вижу удалённый лид?',
    answer: 'Его мог удалить другой сотрудник, срок хранения мог закончиться или корзина для этого типа элементов была отключена. Попросите администратора проверить запись и настройки.',
  },
  {
    question: 'Что делать, если прошло больше 30 дней?',
    answer: 'Проверьте корзину с администратором. Если запись уже удалена окончательно, оцените сохранённые экспорты и другие источники данных. Облачные бэкапы хранятся семь дней и не позволяют откатиться на месяц назад.',
  },
  {
    question: 'Где находится корзина CRM в Битрикс24?',
    answer: 'В разделе CRM → Ещё → Корзина. Это отдельная корзина для элементов CRM; корзина на Диске предназначена для файлов.',
  },
  {
    question: 'Может ли сотрудник увидеть лид, удалённый другим сотрудником?',
    answer: 'Обычный сотрудник видит только элементы, которые удалил сам. Все удалённые элементы CRM доступны администратору Битрикс24.',
  },
];
const relatedArticles = getRelatedArticles(article.hrefPath)
  .map((item) => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const recoverySteps = [
  { name: 'Найдите лид в корзине', text: 'Откройте CRM → Ещё → Корзина, выберите тип «Лид» и найдите нужную запись.', anchor: 'restore-lead' },
  { name: 'Восстановите запись', text: 'В меню рядом с элементом выберите «Восстановить» и дождитесь уведомления.', anchor: 'restore-lead' },
  { name: 'Проверьте карточку', text: 'Найдите восстановленный лид в CRM и проверьте контакты, ответственного, статус и договорённости с клиентом.', anchor: 'restore-lead' },
  { name: 'Обновите ссылки', text: 'Сохраните новую ссылку на карточку и передайте новый ID администратору интеграции, если она использует идентификатор лида.', anchor: 'restore-lead' },
];
const howTos = [{ id: 'howto-restore-lead', name: 'Как восстановить удалённый лид из корзины Битрикс24', steps: recoverySteps }];

const structuredData = createArticleStructuredData({
  articleType: article.type === 'knowledge' ? 'Article' : 'BlogPosting',
  howTos,
  title,
  description,
  articleUrl,
  publishedDate,
  modifiedDate,
  publisherUrl: homeUrl,
  author: authorName,
  image: ogImage,
  articleSection: 'Работа с лидами в Битрикс24',
  breadcrumbs: [
    { name: 'Главная', item: homeUrl },
    { name: 'База знаний', item: knowledgeBaseUrl },
    { name: title, item: articleUrl },
  ],
  faqItems,
});
---


<ArticleLayout
  title={seoTitle} {titleParts} {description} {canonicalPath} {structuredData}
  ogTitle={seoTitle} {ogDescription} {ogImage} ogImageAlt={imageAlt}
  category="Битрикс24"
  heroVariant="dark"
  heroAction={{
    href: cleanerHref,
    label: 'Посмотреть приложение',
    description: 'Для плановой очистки лидов и сделок по фильтрам.',
  }}
  intro="Удалённые лиды сначала попадают в Корзину CRM: откройте CRM → Ещё → Корзина. Если запись ещё там и восстановление доступно на вашем тарифе, её можно вернуть."
  {breadcrumbs} author={authorName} publishedTime={publishedDate} modifiedTime={modifiedDate}
>
  <LineWave slot="hero-background" centerOnMobile />
  <Fragment slot="quick-answer">
    <p>Администратор Битрикс24 видит <strong>все удалённые элементы CRM</strong>. Обычный сотрудник видит только те элементы, которые удалил сам.</p>
    <p>Стандартный срок хранения — <strong>до 30 дней</strong>. После восстановления у записи меняется ID. Если лида нет, сначала проверьте фильтр, права и настройки корзины.</p>
  </Fragment>

  <section aria-labelledby="find-trash">
    <h2 id="find-trash">Где находятся <span data-heading-accent>удалённые лиды в Битрикс24</span></h2>
    <p>Корзина CRM — первое место для поиска удалённой карточки. Не открывайте вместо неё корзину на Диске: там находятся файлы. Чтобы перейти к списку удалённых обращений:</p>
    <ol>
      <li>Откройте раздел CRM.</li>
      <li>Перейдите в меню «Ещё».</li>
      <li>Откройте «Корзина».</li>
      <li>При необходимости настройте фильтр.</li>
      <li>В поле «Тип» выберите «Лид».</li>
    </ol>
    <!-- Будущий реальный снимок 1: импортировать asset и вставить ArticleFigure здесь.
         Сюжет: CRM → Ещё → Корзина. Пустое изображение не выводится. -->
    <p>Используйте параметры поиска, доступные в вашем интерфейсе: время удаления, пользователя и ID. Не путайте дату создания обращения с датой удаления. Если заявку получили весной, а базу чистили вчера, начните с периода вчерашней очистки.</p>
    <!-- Будущий реальный снимок 2 через ArticleFigure: фильтр корзины с типом «Лид». -->
    <p>Пустой результат ещё не доказывает потерю данных. Уберите лишние ограничения и расширьте период. Если лид исчез только из рабочего списка, проверьте поиск по телефону или электронной почте, ответственного и статус. Возможно, карточка доступна администратору или работа продолжилась в другой записи. Создавать дубль до проверки не стоит.</p>
    <p>Для поиска подготовьте контакт клиента, старую ссылку и приблизительное время удаления. Если пропало несколько обращений, сохраните примеры карточек и условия последней очистки: это поможет администратору определить затронутую выборку.</p>
    <ArticleFigure src={leadRecoveryImage} alt={imageAlt} caption="Схема возврата лида: найти запись в корзине, восстановить её и проверить данные в CRM. Это иллюстрация, а не экран Битрикс24." />
  </section>

  <section aria-labelledby="retention-period">
    <h2 id="retention-period">Сколько хранятся <span data-heading-accent>удалённые лиды</span></h2>
    <p>Элементы CRM хранятся в корзине <strong>до 30 дней</strong>. Затем начинается автоматическая очистка по 100 элементов в день. Поэтому отдельная запись может оставаться дольше, но считать это гарантированным продлением срока нельзя.</p>
    <p>Корзина помогает исправить недавнюю ошибку, но не заменяет резервную копию. Важные обращения восстанавливайте сразу: не откладывайте поиск до конца месяца и не рассчитывайте, что нужная карточка обязательно переживёт очередную очистку.</p>
    <p>Если ошибку заметили после массового удаления, временно остановите следующие операции. Сохраните условия фильтра и список известных пропавших записей. Это полезнее, чем продолжать очистку и пытаться вспомнить её настройки позже.</p>
  </section>

  <section aria-labelledby="restore-lead">
    <h2 id="restore-lead">Как <span data-heading-accent>восстановить удалённый лид</span></h2>
    <p>Сначала убедитесь, что нашли нужное обращение: сравните название, время удаления и другие доступные сведения. Затем выполните следующие действия:</p>
    <ol>{recoverySteps.map((step) => <li>{step.text}</li>)}</ol>
    <!-- Будущий реальный снимок 3 через ArticleFigure: действие «Восстановить» в меню записи. -->
    <aside data-article-note aria-label="Новый ID после восстановления">
      <strong>Важно: ID изменится</strong>
      <p>После восстановления CRM-элемент получает <strong>новый ID</strong>, поэтому старая ссылка на карточку перестаёт работать. Открывайте запись из списка CRM, а не из старой закладки.</p>
    </aside>
    <p>Если вместе с лидом удалили связанные дела, сначала восстановите сам элемент, затем дела. После возврата проверьте, можно ли продолжить работу с клиентом: есть ли нужный телефон, кому поручено обращение, когда нужно позвонить и какое предложение отправить.</p>
    <p>Появление записи в списке — повод проверить результат, а не пропускать проверку. Если внешняя система хранит ID лида, попросите её администратора проверить связь. Сохранённые ссылки в рабочих документах тоже нужно обновить.</p>
    <p>Восстановление из корзины доступно не на всех тарифах. Если нужного действия нет, уточните доступность у администратора, прежде чем пытаться вручную создавать карточку заново.</p>
  </section>

  <section aria-labelledby="missing-from-trash">
    <h2 id="missing-from-trash">Почему <span data-heading-accent>удалённого лида нет в корзине</span></h2>
    <h3>Лид удалял другой сотрудник</h3>
    <p>Обычный сотрудник видит в корзине свои удаления; администратор Битрикс24 — все удалённые элементы CRM. Если очистку выполнял коллега, попросите администратора найти запись. Передайте ему контакт клиента, предполагаемый период и старый ID, если он сохранился.</p>
    <h3>Прошёл срок хранения</h3>
    <p>После окончания срока карточка могла быть окончательно удалена. Она также могла исчезнуть после ручной очистки корзины администратором. Сначала проверьте диапазон дат и фильтры, затем обсуждайте другие способы вернуть сведения.</p>
    <h3>Настройки корзины</h3>
    <p>Для отдельных типов элементов CRM корзину можно отключить. Попросите администратора проверить настройки CRM и сохранение лидов в корзине. Изменение настройки на будущее само по себе не возвращает ранее потерянную запись.</p>
    <p>Если проблема возникла ещё на этапе удаления, пригодится отдельная инструкция: <a href={`${base}ne-udalyaetsya-lid-bitrix24/`}>что проверить, если лид не удаляется в Битрикс24</a>. Она поможет отделить ошибку операции от ситуации, когда запись действительно удалена.</p>
  </section>

  <section aria-labelledby="portal-backup">
    <h2 id="portal-backup">Что делать, если <span data-heading-accent>лида уже нет в корзине</span></h2>
    <p>Для облачного Битрикс24 крайний вариант — восстановление портала из резервной копии через поддержку. Копии создаются автоматически каждый день; стандартный срок хранения — <strong>7 дней</strong>. Администратор отправляет запрос, а поддержка проверяет наличие нужной копии и доступность операции на тарифе.</p>
    <aside data-article-note aria-label="Последствия восстановления резервной копии">
      <strong>Откатывается весь портал</strong>
      <p>Это <strong>не восстановление одного конкретного лида</strong>. Поддержка возвращает весь Битрикс24 к выбранной точке. Изменения после неё будут потеряны, и это затронет всех сотрудников.</p>
    </aside>
    <p>Перед запросом оцените, сколько новых заявок, результатов переговоров и других важных изменений появилось после нужной даты. Для одного обращения полный откат может привести к большей потере данных. Согласуйте последствия с командой и уточните порядок сохранения актуальных сведений у поддержки.</p>
    <p>Семидневный бэкап не позволяет вернуться к состоянию месячной давности. Если с удаления прошло больше 30 дней и элемента уже нет, копия последней недели обычно не решает эту задачу. Не обещайте клиенту возврат прежней карточки до проверки доступных вариантов.</p>
    <DataTable label="Что делать, если удалённого лида нет в корзине" columns={["Ситуация", "Что делать дальше"]} rows={recoveryRows} rowHeaders compact />
    <p>Письмо с сайта или экспорт могут помочь заново собрать контакты и содержание заявки, но не гарантируют возврат истории переговоров. При ручном заполнении отделяйте подтверждённые сведения от предположений. Создать новую карточку и восстановить прежнюю запись — разные результаты.</p>
    <p>Для коробочной версии обсудите доступные копии и процедуру с администратором вашей установки: условия облачного сервиса не следует переносить на неё автоматически.</p>
  </section>

  <section aria-labelledby="restore-multiple">
    <h2 id="restore-multiple">Можно ли восстановить <span data-heading-accent>сразу несколько удалённых лидов</span></h2>
    <p>Начните со списка корзины: отберите тип «Лид» и нужный период удаления. Перед массовыми действиями проверьте несколько записей и всю выборку. При ошибке одной очистки удобно сначала выделить именно затронутую группу, а не возвращать всё подряд.</p>
    <p>Если в вашем интерфейсе для отмеченных строк доступно групповое действие «Восстановить», применяйте его только после проверки. Если такого действия нет, восстанавливайте записи через меню каждой строки. Официальная инструкция описывает восстановление отдельного элемента; наличие общей кнопки не стоит считать гарантированным.</p>
    <p>После возврата группы проверьте несколько карточек и сохраните новые ссылки. Для важных обращений отдельно убедитесь, что команда понимает, кто продолжает работу с клиентом.</p>
  </section>

  <section aria-labelledby="deleted-by">
    <h2 id="deleted-by">Можно ли посмотреть, <span data-heading-accent>кто удалил лид</span></h2>
    <p>В корзине есть фильтр «Пользователь» — он помогает найти элементы, удалённые конкретным сотрудником. Проверьте доступные столбцы списка: если сведения об удалившем пользователе отображаются, по ним можно уточнить, кто выполнил операцию.</p>
    <p>Не путайте ответственного за лид с пользователем, удалившим его: это могут быть разные люди. Для разбора общей очистки лучше привлечь администратора, поскольку сотрудник видит только собственные удаления. Уточняйте также дату и условия операции, чтобы исправить причину ошибки.</p>
  </section>

  <section aria-labelledby="deleted-in-reports">
    <h2 id="deleted-in-reports">Что происходит с <span data-heading-accent>удалёнными лидами в отчётах</span></h2>
    <p>Удалённые элементы CRM не учитываются в аналитических отчётах. Поэтому удаление реальных обращений может изменить показатели и затруднить сравнение периодов. Закрытый или неуспешный лид не обязательно лишний: он может быть нужен для анализа причин отказа.</p>
    <p>Перед очисткой согласуйте, какие записи команда использует в аналитике. После восстановления проверьте нужные отчёты отдельно; для внешних выгрузок и BI-систем результат зависит от их источников и порядка обновления.</p>
  </section>

  <section aria-labelledby="cleanup-rules">
    <h2 id="cleanup-rules">Как безопаснее удалять <span data-heading-accent>большое количество лидов</span></h2>
    <p>В самом Битрикс24 можно использовать фильтры, групповые действия в списке и стандартный инструмент «Очистка CRM». Выбор способа зависит от задачи: убрать тестовые обращения, отобрать старые записи или освободить место. В любом случае сначала определите критерии, затем проверяйте результат отбора.</p>
    <p>Дата создания сама по себе не означает, что обращение больше не нужно. Старый лид может содержать незавершённую договорённость. Чтобы удалить записи определённой категории, опишите её через доступные поля, например текущую стадию и ответственного, и проверьте пограничные случаи.</p>
    <ArticleFigure
      src={safeCleanupImage}
      alt="Порядок удаления лидов: фильтр, проверка выборки, удаление"
      compact
    />
    <p>Если нужно регулярно очищать большое количество лидов и сделок по более точным условиям, можно использовать {companyInfo.brandName} Cleaner для Битрикс24. Приложение позволяет настроить фильтр, проверить найденные элементы и их количество, исключить важные карточки и затем подтвердить массовое удаление.</p>
    <p>Подходящие сценарии — удалить старые лиды, записи за выбранный период или большую группу по согласованным условиям. Главное — сначала проверить выборку. Порядок отбора разобран в материале про <a href={`${base}bitrix24-udalenie-lidov-za-period/`}>удаление старых лидов за выбранный период</a>. Для сделок есть отдельная инструкция: <a href={`${base}udalenie-proigrannyh-sdelok-bitrix24/`}>как удалить проигранные сделки и сохранить нужные</a>.</p>
    <InlineConsultation
      variant="product"
      title="Проверьте выборку перед очисткой"
      description={`В ${companyInfo.brandName} Cleaner можно отобрать лиды и сделки по фильтрам, проверить список и исключить важные карточки перед подтверждением. Восстановление удалённых записей зависит от механизмов Битрикс24.`}
      href={cleanerHref} actionLabel="Массовое удаление лидов и сделок в Bitrix24"
    />
  </section>

  <section aria-labelledby="prevent-loss">
    <h2 id="prevent-loss">Как снизить риск <span data-heading-accent>случайной потери лидов</span></h2>
    <Checklist label="Проверка перед массовым удалением" items={[
      { title: 'Сначала настройте фильтр.', description: 'Укажите период, стадию и другие условия, соответствующие задаче.' },
      { title: 'Проверьте несколько элементов вручную.', description: 'Просмотрите карточки, особенно на границах периода; исключите обращения с текущими договорённостями.' },
      { title: 'Проверьте общее количество выбранных элементов.', description: 'Если объём неожиданно большой, остановитесь и уточните условия.' },
      { title: 'Для критичных данных предварительно сделайте экспорт.', description: 'Сохраните доступные сведения и проверьте файл. Экспорт не заменяет полную резервную копию.' },
      { title: 'Только после этого запускайте массовое удаление.', description: 'Подтверждайте операцию для проверенной выборки и сохраните её условия.' },
    ]} />
    <p>Такой порядок полезен и при стандартных групповых действиях, и при работе с Cleaner. Проверка списка и количества помогает заметить ошибку до удаления; корзина остаётся средством исправить недавнюю ошибку, а не основанием пропускать проверку.</p>
  </section>

  <section aria-labelledby="in-brief">
    <h2 id="in-brief">Коротко</h2>
    <p>Удалённые лиды ищите в <strong>CRM → Ещё → Корзина</strong>. Если запись ещё там и тариф допускает восстановление, её можно вернуть.</p>
    <p>Стандартный срок хранения — до 30 дней. Администратор видит все удаления, обычный сотрудник — свои.</p>
    <p>После восстановления меняется ID: найдите карточку в CRM и обновите старую ссылку.</p>
    <p>Если записи уже нет, восстановление всего портала из резервной копии — крайний вариант. Облачные копии хранятся семь дней; откат удаляет изменения после выбранной точки.</p>
  </section>

  <FaqSection items={faqItems} id="faq" variant="article" />
  <ArticleSources publishedIso={article.publishedAt} sources={sourceLinks} />
  <Fragment slot="article-end">
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <Fragment slot="after-article">
    <ConsultationCtaSection
      title={cleanerProduct.name}
      description={cleanerProduct.articleDescription}
      href={cleanerHref} actionLabel={cleanerProduct.articleActionLabel}
    />
  </Fragment>
</ArticleLayout>
