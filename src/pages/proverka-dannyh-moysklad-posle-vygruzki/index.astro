---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import timelineImage from '../../images/articles/moysklad-data-check-timeline-093.png';
import stepsImage from '../../images/articles/moysklad-data-check-steps-093.png';

const article = getArticle('proverka-dannyh-moysklad-posle-vygruzki/');
const { title, description } = article;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const canonicalPath = `/${article.hrefPath}`;
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const imageAlt = 'Учебный пример: отчёт за один день изменился после удаления документа';
const ogImage = new URL(timelineImage.src, siteRoot).toString();
const titleParts = [{ text: 'Как проверить цифры ' }, { text: 'после выгрузки МойСклад', accent: true }];
const checks = [
  ['Период и время', 'Один и тот же интервал, часовой пояс и момент последней выгрузки', 'Сравните параметры двух запусков и дату документа'],
  ['Набор документов', 'Одинаковые типы, статусы, проведение, магазины и организации', 'Сравните список ID, а не только итоговую сумму'],
  ['Изменения', 'Исправления сумм, позиций, дат и проведение', 'Откройте историю нужного документа и аудит'],
  ['Удаления', 'Запись была удалена или восстановлена между выгрузками', 'Проверьте корзину, аудит и повторный сбор типа документа'],
  ['Расчёт', 'Формула, возвраты, дедупликация и группировка не менялись', 'Пересчитайте показатель из одинакового списка исходных ID'],
];
const faqItems = [
  { question: 'Почему вчера и сегодня в BI разные цифры за одну дату?', answer: 'Причина может быть в правке или удалении документа задним числом, разной дате завершения выгрузки, фильтрах, часовом поясе или формуле. Возьмите один день и один магазин, сравните ID документов и только затем итоговую сумму.' },
  { question: 'Где посмотреть, кто изменил документ в МойСклад?', answer: 'Откройте документ и ссылку «Изменения» в правой верхней части карточки. Общие события доступны в «Моя компания → Аудит» при соответствующих правах. Доступ к конкретной истории зависит от прав сотрудника.' },
  { question: 'Как найти удалённый документ в API МойСклад?', answer: 'Для поддерживаемой выборки документов фильтр isDeleted=true возвращает документы в корзине. Он не является полной историей удалений: корзина должна быть включена, а документы хранятся в ней семь дней. Для разбора причины дополнительно проверьте аудит.' },
  { question: 'Нужно ли каждый раз перечитывать всю историю?', answer: 'Способ зависит от объёма данных и того, насколько далеко назад сотрудники могут исправлять документы. Надёжная схема хранит ID, время изменения и контрольные суммы, перечитывает согласованный период, отдельно обрабатывает удаления и регулярно сверяет старые даты. Конкретное окно выбирают после проверки процессов компании.' },
  { question: 'Как проверить остаток на прошлую дату после исправления приёмки?', answer: 'Сравните отчёт об остатках на нужную дату в МойСклад с локальным результатом при тех же товарах и складах. Найдите приёмку и её историю изменений. Исправление даты или количества влияет на расчёт прошлых остатков; после изменения локальную историю нужно пересчитать.' },
];
const sourceLinks = [
  { label: 'Аудит — справка МойСклад', href: 'https://support.moysklad.ru/hc/ru/знакомство%20с%20сервисом/инструменты/аудит' },
  { label: 'История изменений документов — справка МойСклад', href: 'https://support.moysklad.ru/hc/ru/частые%20вопросы/как_посмотреть_историю_изменении_документов_и_справочников' },
  { label: 'Удаление и восстановление документов — справка МойСклад', href: 'https://support.moysklad.ru/hc/ru/articles/203055266' },
  { label: 'Корзина и срок хранения — справка МойСклад', href: 'https://support.moysklad.ru/hc/ru/знакомство%20с%20сервисом/интерфеис/корзина' },
  { label: 'JSON API: даты и фильтр isDeleted — документация МойСклад', href: 'https://dev.moysklad.ru/doc/api/remap/1.2/' },
];
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const structuredData = createArticleStructuredData({
  articleType: 'Article', title, description, articleUrl, publishedDate: article.publishedAt,
  modifiedDate: article.updatedAt, publisherUrl: siteRoot.toString(), image: ogImage, author: authorName,
  breadcrumbs: [
    { name: 'Главная', item: siteRoot.toString() },
    { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() },
    { name: title, item: articleUrl },
  ], faqItems,
});
---

<ArticleLayout {title} {titleParts} {description} {canonicalPath} {structuredData}
  ogTitle={article.seoTitle} ogDescription={description} {ogImage} ogImageAlt={imageAlt}
  category={article.category} author={authorName}
  intro="Берём один расходящийся день и ищем причину по документам: фильтры, даты, правки, удаления и правила пересчёта.">
  <Fragment slot="quick-answer">
    <p>Если сумма за прошлый день изменилась после очередной выгрузки МойСклад, сначала сравните <strong>одинаковые период, магазин, часовой пояс и правило расчёта</strong>. Затем выгрузите список исходных документов с ID и найдите добавленные, изменённые и исчезнувшие записи.</p>
    <p>В МойСклад историю конкретного документа видно по ссылке «Изменения», общие события — в аудите при наличии прав. Документы в корзине можно проверить через API с фильтром <code>isDeleted=true</code>, пока они доступны там.</p>
  </Fragment>

  <p data-article-lead>В понедельник в таблице продаж за пятницу было 12 000 ₽, во вторник — 10 000 ₽. Это не обязательно сбой BI: продажу на 2 000 ₽ могли изменить или удалить после первого снимка. Но та же разница возникает и при изменении фильтра или формулы. Проверка начинается с одного дня и списка документов, а не с попытки подогнать два итоговых числа.</p>
  <ArticleFigure src={timelineImage} fullSize portrait alt={imageAlt} caption="Условные суммы: в понедельник снимок содержал продажи на 12 000 ₽, затем один документ на 2 000 ₽ удалили; после пересчёта вторничный итог за ту же пятницу — 10 000 ₽. Причину нужно подтвердить ID и аудитом." />

  <section aria-labelledby="same-basis">
    <h2 id="same-basis">Сначала проверьте, что сравниваете одно и то же</h2>
    <p>Запишите дату и время обоих снимков, период отчёта, часовой пояс, организацию, магазин или склад, типы документов и их статус. В API МойСклад дата документа и время его изменения — разные поля: операция за пятницу может быть исправлена во вторник. Для времени создания и обновления документация JSON API указывает MSK; для даты самого документа и локального отчёта отдельно зафиксируйте правило интерпретации времени и границы дня.</p>
    <DataTable label="Проверка причины расхождения выгрузки МойСклад" columns={['Слой', 'Что должно совпасть', 'Следующий шаг']} rows={checks} rowHeaders compact />
    <p>Не начинайте со сравнения готовых графиков, если один показывает сумму чеков, а другой — оплаты или выручку за вычетом возвратов. Разбор этих определений есть в статье <a href={`${base}otchety-moysklad/`}>об отчётах продаж</a>.</p>
  </section>

  <section aria-labelledby="document-diff">
    <h2 id="document-diff">Найдите документ, из-за которого изменился итог</h2>
    <p>Сохраните для двух выгрузок строки с ID документа, типом, датой операции, временем изменения, магазином, суммой и статусом. Сравните множества ID: что появилось, исчезло и изменилось при одинаковом ID. Для позиции товара дополнительно сравнивайте ID строки, количество и цену. Так вы отделите новый документ от исправления прежнего.</p>
    <p>Откройте найденный документ в МойСклад и нажмите <strong>«Изменения»</strong> справа вверху. Если нужно понять действие пользователя или импорт, смотрите <strong>«Моя компания → Аудит»</strong>. Официальная справка описывает создание, изменение и удаление документов в общем аудите; права на просмотр задаются отдельно. Отсутствие доступа к истории не означает, что правки не было.</p>
    <p>Проверьте проведение и связанные документы. Например, удаление приёмки меняет остаток товара, хотя созданные на её основе документы остаются. Восстановленная приёмка вернёт влияние на остатки после проведения. Поэтому для <a href={`${base}ostatki-moysklad/`}>истории остатков по дням</a> одной проверки существования документа мало.</p>
  </section>

  <section aria-labelledby="deletions">
    <h2 id="deletions">Что делать с удалением и правкой задним числом</h2>
    <p>Если документ исчез из обычной выборки, проверьте корзину и аудит. JSON API МойСклад поддерживает фильтр <code>isDeleted=true</code> для документов, находящихся в корзине, и <code>isDeleted=false</code> для неудалённых. Восстановление из корзины через API не предусмотрено. Корзину нужно включить в настройках; по справке МойСклад документы хранятся там семь дней. Этот фильтр нельзя считать вечным журналом удалений.</p>
    <p>Для собственной базы полезно сохранять ID и время изменения записей, а при каждом запуске сверять удалённые документы и перечитывать период, который сотрудники могут менять задним числом. После изменения приёмки или продажи пересчитывают затронутые дни, а для накопительных остатков — и последующие даты. Размер такого окна нельзя обещать одинаковым всем компаниям: он зависит от их правил редактирования и от того, какие контрольные сверки построены.</p>
    <ArticleFigure src={stepsImage} fullSize portrait alt="Схема сверки: одинаковые параметры, сравнение ID документов, аудит и повторный расчёт затронутого периода" caption="Диагностика одного расхождения. Сначала исключите разницу фильтров и формул, затем найдите изменившийся ID, подтвердите действие в МойСклад и пересчитайте затронутый период." />
  </section>

  <section aria-labelledby="acceptance">
    <h2 id="acceptance">Как принять исправленный отчёт</h2>
    <p>Повторите расчёт для той же даты и тех же условий. Итог в своей базе должен сходиться с выбранным отчётом МойСклад настолько, насколько совпадают определения метрики. Если остаётся разница, запишите её по документам: продажа, возврат, удаление, изменение даты, проведение или особое правило расчёта. Для большого объёма начните с одного магазина и короткого периода, затем расширяйте проверку.</p>
    <p>Храните время последней успешной выгрузки и дату расчёта каждой витрины. Это позволяет отличить устаревший снимок от реальной ошибки. Если данные используются для зарплаты, закупок или финансового отчёта, согласуйте допустимую задержку и процедуру пересчёта до того, как команда начнёт принимать решения по графику.</p>
    <InlineConsultation title="За прошлую дату получились разные цифры?" description="Возьмём один день, одинаковые фильтры и список документов, найдём изменившиеся записи и определим правило пересчёта для вашей аналитики." />
  </section>

  <FaqSection id="faq" variant="article" title="Частые вопросы" items={faqItems} />
  <ArticleSources publishedIso={article.publishedAt} modifiedIso={article.updatedAt} sources={sourceLinks} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Проверьте данные ' }, { text: 'до решения по отчёту', accent: true }]}
      description="TrueTell разрабатывает подготовку данных МойСклад для аналитики. Обсудим ваши расхождения, источники и правила сверки на конкретном дне без обещания готового автоматического пересчёта."
      href={companyInfo.contacts.consultationUrl} actionLabel="Обсудить задачу" />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <Fragment slot="after-article"><ConsultationCtaSection /></Fragment>
</ArticleLayout>
