---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import Checklist from '../../components/editorial/checklist.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import processImage from '../../images/articles/inventarizaciya-process-069.png';
import differenceImage from '../../images/articles/inventarizaciya-difference-069.png';

const article = getArticle('inventarizaciya-moysklad/');
const { title, description } = article;
const canonicalPath = `/${article.hrefPath}`;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const imageAlt = 'Пять этапов инвентаризации в МойСклад: определить охват, ограничить движение товаров, пересчитать, сверить и оформить корректировку';
const ogImage = new URL(processImage.src, siteRoot).toString();
const titleParts = [{ text: 'Инвентаризация в МойСклад: ' }, { text: 'пересчёт и расхождения', accent: true }];

const inventoryUrl = 'https://support.moysklad.ru/hc/ru/articles/203309933-%D0%98%D0%BD%D0%B2%D0%B5%D0%BD%D1%82%D0%B0%D1%80%D0%B8%D0%B7%D0%B0%D1%86%D0%B8%D1%8F-%D1%82%D0%BE%D0%B2%D0%B0%D1%80%D0%BE%D0%B2';
const turnoversUrl = 'https://support.moysklad.ru/hc/ru/%D1%82%D0%BE%D0%B2%D0%B0%D1%80%D1%8B%20%D0%B8%20%D1%81%D0%BA%D0%BB%D0%B0%D0%B4%D1%8B/%D0%BE%D1%81%D1%82%D0%B0%D1%82%D0%BA%D0%B8%20%D0%B8%20%D1%81%D0%B5%D0%B1%D0%B5%D1%81%D1%82%D0%BE%D0%B8%D0%BC%D0%BE%D1%81%D1%82%D1%8C/%D0%BE%D0%B1%D0%BE%D1%80%D0%BE%D1%82%D1%8B';
const sources = [
  { label: 'Инвентаризация товаров — Служба поддержки МоегоСклада', href: inventoryUrl },
  { label: 'Если остатки считаются неверно — Служба поддержки МоегоСклада', href: 'https://support.moysklad.ru/hc/ru/%D1%82%D0%BE%D0%B2%D0%B0%D1%80%D1%8B%20%D0%B8%20%D1%81%D0%BA%D0%BB%D0%B0%D0%B4%D1%8B/%D0%BE%D1%81%D1%82%D0%B0%D1%82%D0%BA%D0%B8%20%D0%B8%20%D1%81%D0%B5%D0%B1%D0%B5%D1%81%D1%82%D0%BE%D0%B8%D0%BC%D0%BE%D1%81%D1%82%D1%8C/%D0%B5%D1%81%D0%BB%D0%B8_%D0%BE%D1%81%D1%82%D0%B0%D1%82%D0%BA%D0%B8_%D1%81%D1%87%D0%B8%D1%82%D0%B0%D1%8E%D1%82%D1%81%D1%8F_%D0%BD%D0%B5%D0%B2%D0%B5%D1%80%D0%BD%D0%BE' },
  { label: 'Отчёт «Обороты» — Служба поддержки МоегоСклада', href: turnoversUrl },
  { label: 'Складской учёт: остатки, резервы и ожидания — Служба поддержки МоегоСклада', href: 'https://support.moysklad.ru/hc/ru/%D1%82%D0%BE%D0%B2%D0%B0%D1%80%D1%8B%20%D0%B8%20%D1%81%D0%BA%D0%BB%D0%B0%D0%B4%D1%8B/%D0%BE%D1%81%D1%82%D0%B0%D1%82%D0%BA%D0%B8%20%D0%B8%20%D1%81%D0%B5%D0%B1%D0%B5%D1%81%D1%82%D0%BE%D0%B8%D0%BC%D0%BE%D1%81%D1%82%D1%8C/%D1%81%D0%BA%D0%BB%D0%B0%D0%B4%D1%81%D0%BA%D0%BE%D0%B8_%D1%83%D1%87%D0%B5%D1%82_%D0%BE%D1%81%D1%82%D0%B0%D1%82%D0%BA%D0%B8_%D1%80%D0%B5%D0%B7%D0%B5%D1%80%D0%B2%D1%8B_%D0%BE%D0%B6%D0%B8%D0%B4%D0%B0%D0%BD%D0%B8%D1%8F' },
];
const faqItems = [
  { question: 'Инвентаризация в МойСклад сама исправляет остаток?', answer: 'Нет. Она фиксирует фактическое количество и расхождение с расчётным. Для изменения складского остатка создают отдельное списание при недостаче или оприходование при излишке.' },
  { question: 'Нужно ли останавливать продажи на время пересчёта?', answer: 'Официальная инструкция рекомендует приостановить продажу и приёмку товаров на время инвентаризации. Если небольшое количество уже продали, справка описывает способ актуализировать документ; при большом движении может понадобиться повторный пересчёт.' },
  { question: 'Почему товары с нулевым остатком не попали в документ?', answer: 'При добавлении из остатков нулевые позиции не включаются. Для полного пересчёта проверьте охват списка и добавление из номенклатуры: при отсутствии выбранных товаров можно добавить всю номенклатуру.' },
  { question: 'Можно ли загрузить пересчёт из файла?', answer: 'Импорт файла с результатами доступен для инвентаризации по складу — то есть без адресного хранения. Для инвентаризации по ячейкам фактические количества вводятся по ячейкам.' },
  { question: 'Как оформить недостачу и излишек?', answer: 'Сначала проверьте перечень и причины расхождений. Если расчётный остаток больше фактического, создайте списание; если фактический больше расчётного — оприходование. Перед сохранением проверьте склад, позиции и количество.' },
  { question: 'Что делать, если остаток в МойСклад всё равно неверный?', answer: 'Проверьте склад и время документов, проведение приёмок, отгрузок и перемещений. Для конкретной позиции можно посмотреть операции в отчёте «Обороты» и сверить документы за нужный период.' },
];
const correctionRows = [
  ['Расчётный остаток больше фактического', 'Недостача', 'После проверки создать списание'],
  ['Фактический остаток больше расчётного', 'Излишек', 'После проверки создать оприходование'],
  ['Количество расходится, но пересчёт ещё не подтверждён', 'Не завершённая проверка', 'Пересчитать позицию и проверить склад, модификацию и документы'],
];
const preparationSteps = [
  { title: 'Уточните склад, зону или ячейки и состав товаров. Делите большой охват на понятные участки и назначайте, кто считает и кто сверяет.' },
  { title: 'Согласуйте время пересчёта и остановите продажи и приёмку товаров на этот период. Иначе движения усложнят сравнение учётного и физического количества.' },
  { title: 'Подготовьте способ фиксации результата: ручной ввод, сканирование или импорт — в зависимости от типа склада и доступного способа в МойСклад.' },
  { title: 'Заранее решите, как идентифицировать позиции: артикул, штрихкод и модификацию. Не объединяйте разные размеры или цвета в одну строку.' },
];
const relatedArticles = getRelatedArticles(article.hrefPath)
  .map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const structuredData = createArticleStructuredData({
  articleType: 'Article', title, description, articleUrl, publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), image: ogImage, author: authorName,
  breadcrumbs: [{ name: 'Главная', item: siteRoot.toString() }, { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() }, { name: title, item: articleUrl }],
  faqItems,
});
---

<ArticleLayout {title} {titleParts} {description} {canonicalPath} {structuredData}
  ogTitle={article.seoTitle} ogDescription={description} {ogImage} ogImageAlt={imageAlt}
  category={article.category} author={authorName}
  intro="Пошаговый порядок пересчёта в МойСклад: как выбрать охват, внести факт, разобрать расхождения и изменить остатки документами.">
  <Fragment slot="quick-answer">
    <p>Откройте <strong>Склад → Инвентаризации</strong>, выберите склад, добавьте позиции и внесите фактическое количество. Сопоставьте его с расчётным остатком и проверьте расхождения.</p>
    <p>Инвентаризация сама не меняет остаток: после проверки недостачу оформляют списанием, излишек — оприходованием. Перед созданием документа сверьте позиции, склад и движения товара во время пересчёта.</p>
  </Fragment>

  <p data-article-lead>Если в учёте не сходится количество товара, пересчитайте нужный склад и выясните, где возникло расхождение. Ошибка в составе списка или продажа во время проверки может исказить результат так же, как пропущенный документ.</p>
  <ArticleFigure src={processImage} fullSize eager alt={imageAlt} caption="Порядок работ от определения охвата до корректирующего складского документа. Схема не является экраном интерфейса МойСклад." />

  <section aria-labelledby="before-count">
    <h2 id="before-count">Подготовка: что согласовать до пересчёта</h2>
    <p>Инвентаризацию проводят по каждому складу отдельно. Если используется адресное хранение, пересчёт ведут по ячейкам. До создания документа согласуйте границы проверки, иначе список МойСклад и физически пересчитанная зона могут не совпасть.</p>
    <Checklist items={preparationSteps} label="Подготовка к инвентаризации в МойСклад" />
    <p>На время работ справка МоегоСклада рекомендует приостановить продажи и приёмку товаров. Это снижает риск движения товара между подсчётом и сравнением. Если остановить процесс невозможно, фиксируйте каждую операцию и будьте готовы актуализировать документ или повторить пересчёт.</p>
  </section>

  <section aria-labelledby="create-inventory">
    <h2 id="create-inventory">Как создать инвентаризацию и выбрать позиции</h2>
    <ol>
      <li>Откройте <strong>Склад → Инвентаризации</strong> и создайте новую инвентаризацию.</li>
      <li>Выберите склад. Для склада с ячейками МойСклад создаст инвентаризацию по ячейкам; для обычного склада — по складу.</li>
      <li>Проверьте дату и организацию. Дата документа влияет на расчётный остаток, поэтому при пересчёте за прошлое время не оставляйте текущую дату автоматически.</li>
      <li>Добавьте позиции, которые действительно будут пересчитаны, затем сохраните документ.</li>
    </ol>
    <p>Есть несколько способов сформировать список. Можно выбрать позиции из справочника, добавить товары из остатков или дополнить документ номенклатурой. Если добавить «из остатков», МойСклад не включит позиции с нулевым количеством. Чтобы проверить всю номенклатуру, нажмите «Дополнить из номенклатуры» и выберите нужные товары или группу. Если флажок «Устанавливать фактические остатки» не выбран, после добавления нажмите «Расчётный остаток» и выберите «Пересчитать». В одном документе допускается до 10&nbsp;000 позиций; большой пересчёт удобнее разбить по участкам, датам или типам товаров.</p>
    <p>Флажок «Устанавливать фактические остатки» задаёт начальные фактические значения для добавляемых позиций. Не используйте его вслепую: если команда будет вносить фактическое количество вручную после пересчёта, проверьте значение до массового добавления и сохранения.</p>
  </section>

  <section aria-labelledby="count-fact">
    <h2 id="count-fact">Внесите фактические остатки</h2>
    <p>Физический подсчёт выполняйте по выбранному участку, позиции и модификации. Сверяйте не только название: у похожих товаров могут отличаться артикул, размер, цвет или штрихкод. После подсчёта внесите именно фактическое количество, а не число из старого списка.</p>
    <DataTable label="Способы внести фактическое количество" columns={['Способ', 'Когда доступен', 'Что проверить']} rows={[
      ['Вручную', 'Для позиции в документе', 'Выбрана правильная номенклатура и склад'],
      ['Сканирование штрихкодов', 'Инвентаризация по складу', 'При каждом сканировании количество увеличивается на единицу'],
      ['Импорт файла', 'Инвентаризация по складу без адресного хранения', 'Файл соответствует инструкциям на экране и содержит нужные идентификаторы'],
      ['Ввод по ячейкам', 'Инвентаризация по ячейкам', 'Выбрана ячейка, а количество внесено для неё'],
    ]} rowHeaders />
    <p>В справке МоегоСклада сканирование и импорт указаны как способы для инвентаризации по складу. Для склада с адресным хранением фактическое количество указывают по ячейкам. Если в форме нужный способ недоступен, сначала проверьте тип созданной инвентаризации.</p>
  </section>

  <section aria-labelledby="moving-stock">
    <h2 id="moving-stock">Если товар продали во время инвентаризации</h2>
    <p>Если несколько единиц продали в ходе подсчёта, а пересчёт остальных позиций завершён, официальная инструкция предлагает актуализировать документ: найти проданную позицию, внести её фактический остаток, изменить дату и время на текущие, пересчитать расчётный остаток и сохранить.</p>
    <p>Если между замером и фиксацией прошло много операций, ручная поправка может быть ненадёжной. Сверьте движение и временные отметки; если нельзя уверенно восстановить состояние склада на момент пересчёта, назначьте повторную проверку. Не оформляйте списание или оприходование, пока не ясно, объясняется ли разница движением товара.</p>
    <p>Если остаток выглядит неверно и после инвентаризации, проверьте склад, время и проведение исходных приёмок, отгрузок и перемещений. Отчёт <strong>Склад → Обороты</strong> помогает посмотреть операции по выбранному товару за указанный период. Порядок проверки описан в <a href={turnoversUrl} target="_blank" rel="noopener noreferrer">официальной инструкции МоегоСклада по отчёту «Обороты»</a>.</p>
  </section>

  <section aria-labelledby="read-difference">
    <h2 id="read-difference">Как понять расхождение и что исправлять</h2>
    <p>В инвентаризации сравните «Расчётный остаток» и «Фактический остаток». Колонка «Разница» показывает количественное расхождение, а «Избыток/Недостача» — соответствующее денежное выражение. Не считайте денежную колонку количеством товара.</p>
    <ArticleFigure src={differenceImage} fullSize alt="Два учебных примера сравнения расчётного и фактического остатка: недостача двух штук ведёт к проверке списания, излишек двух штук — к проверке оприходования" caption="Условные примеры показывают направление корректировки. Документ инвентаризации сам складской остаток не меняет." />
    <DataTable label="Действия после сверки фактического и расчётного остатка" columns={['Результат сравнения', 'Что это означает', 'Документ после проверки']} rows={correctionRows} rowHeaders />
    <p>Если расчётный остаток выше фактического, создают списание; если он ниже фактического — оприходование. В МойСклад эти документы можно создать из инвентаризации: в них попадают позиции с соответствующим видом расхождения. Сначала проверьте состав списка, склад и количество в сформированном документе, затем завершайте его оформление по правилам учёта вашей компании.</p>
    <p>Если недостач больше 500 позиций, МойСклад создаст несколько документов списания — по 500 позиций в каждом. Если больше 500 позиций с излишком, несколько документов по 500 позиций в каждом создаются отдельно для оприходования. Проверьте все созданные документы, а после оформления повторно сверьте остатки в отчёте «Остатки».</p>
  </section>

  <section aria-labelledby="close-inventory">
    <h2 id="close-inventory">Контрольный список перед завершением</h2>
    <Checklist label="Проверка результата инвентаризации" items={[
      { title: 'Охват соответствует задаче: нужный склад, зона, товары и модификации.' },
      { title: 'Фактические количества внесены для всех пересчитанных позиций; нулевые остатки не потерялись из-за неполного списка.' },
      { title: 'Продажи, приёмка и другие движения за время пересчёта учтены или проверка повторена.' },
      { title: 'Недостачи и излишки сверены по количеству и причинам; денежное выражение не перепутано с количеством.' },
      { title: 'В списании или оприходовании проверены склад, позиции и количество; после оформления остатки перепроверены.' },
    ]} />
    <p>Если нужно видеть остатки и продажи по нескольким складам или точкам в общей аналитике, посмотрите <a href={`${base}ostatki-moysklad/`}>обзор контроля остатков в МойСклад</a>. Он посвящён запасам, резервам и поиску неликвида; эта инструкция — конкретно пересчёту и разбору расхождений.</p>
    <InlineConsultation variant="product" title="Нужно регулярно сопоставлять продажи и запасы?" description="Посмотрите BI-аналитику TrueTell для торговли. Набор показателей и правила расчёта нужно согласовать под ваши данные; инвентаризацию и корректирующие документы оформляют в МойСклад." href={`${base}bi-analitika/`} actionLabel="Посмотреть BI-аналитику" />
  </section>

  <FaqSection items={faqItems} id="faq" variant="article" />
  <ArticleSources sources={sources} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Сверяйте продажи и ' }, { text: 'запасы по точкам', accent: true }]} description="BI-аналитика TrueTell помогает обсуждать общую отчётность по торговым данным. Она не заменяет пересчёт и складские документы в МойСклад." href={`${base}bi-analitika/`} actionLabel="Посмотреть BI-аналитику" />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <Fragment slot="after-article"><ConsultationCtaSection /></Fragment>
</ArticleLayout>
