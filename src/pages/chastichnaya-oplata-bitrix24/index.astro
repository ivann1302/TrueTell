---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import Checklist from '../../components/editorial/checklist.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import paymentImage from '../../images/articles/bitrix24-payment-link-official.jpg';
import fieldImage from '../../images/articles/bitrix24-money-field-type-official.jpg';
import balanceImage from '../../images/articles/bitrix24-partial-payment-balance.png';
import allocationImage from '../../images/articles/payment-allocation-journal-077.png';

const article = getArticle('chastichnaya-oplata-bitrix24/');
const { title, description } = article;
const canonicalPath = `/${article.hrefPath}`;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const imageAlt = 'Карточка сделки Битрикс24 с кнопкой Принять оплату — оригинальный пример Поддержки24';
const ogImage = new URL(paymentImage.src, siteRoot).toString();
const titleParts = [
  { text: 'Частичная оплата в Битрикс24: ' },
  { text: 'поступления и остаток к оплате', accent: true },
];
const sourceLinks = [
  { label: 'Оплата по ссылке в карточке сделки — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/28102982/' },
  { label: 'Статусы оплаты, доставки и СМС — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/18291172/' },
  { label: 'Пользовательские поля в CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/22048980/' },
  { label: 'Карточка CRM: возможности и настройки — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/22804914/' },
  { label: 'Таймлайн в CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/23960160/' },
];
const receiptSteps = [
  { title: 'Определите сумму и валюту сделки', description: 'Сверьте их с действующими условиями клиента. В примере ниже стоимость — 120 000 ₽, валюта всех поступлений — RUB.' },
  { title: 'Соберите подтверждённые поступления', description: 'Возьмите фактические даты, суммы и идентификаторы операций из согласованного источника: например, банковской выписки или данных платёжного сервиса. Выставленный счёт и отправленная ссылка сюда не входят.' },
  { title: 'Свяжите каждую запись с ID сделки', description: 'Укажите также валюту, источник и его идентификатор операции, тип записи и фактическую дату. Для одинакового имени клиента используйте разные ID сделок, если это разные обязательства.' },
  { title: 'Проверьте повторы и рассчитайте итог', description: 'Повторная загрузка той же операции не должна увеличивать полученную сумму. Реальные возвраты учитывайте отдельно; строки графика будущих платежей в факт не включайте.' },
  { title: 'Обновите итоги в CRM и сверьте результат', description: 'Перенесите проверенные значения в созданные для этого поля сделки. Откройте карточку повторно и сравните её с журналом; при ручном учёте это действие нужно после каждого изменения.' },
];
const fieldSteps = [
  { title: 'Проверьте доступ к настройкам CRM', description: 'Создавать поля может администратор или сотрудник с разрешением изменять настройки CRM. Заполнение полей доступной сделки зависит от прав на её изменение.' },
  { title: 'Откройте сделку и нажмите «Создать поле»', description: 'Для итогов выберите тип «Деньги». Если поле уже настроено, найдите его через «Выбрать поле», а не создавайте ещё одно с похожим названием.' },
  { title: 'Задайте названия и сохраните поля', description: 'Предлагаем «Получено по сделке» и «Остаток к оплате». Это ваши пользовательские названия, а не стандартные поля Битрикс24. При необходимости добавьте «Дата сверки» типа «Дата».' },
  { title: 'Заполните проверенные итоги', description: 'Выберите валюту сделки, сохраните значения и проверьте их после повторного открытия карточки. Поля не вычисляют суммы журнала автоматически: в этом способе их обновляет ответственный сотрудник.' },
];
const receiptRows = [
  ['01.10.2026', 'Поступление', 'Банк / счёт A / операция 101', '30 000 ₽'],
  ['08.10.2026', 'Поступление', 'Банк / счёт A / операция 102', '42 000 ₽'],
];
const summaryRows = [
  ['Сумма сделки', '120 000 ₽', 'Действующая стоимость обязательства клиента'],
  ['Получено по сделке', '72 000 ₽', '30 000 + 42 000; после сверки обоих поступлений'],
  ['Остаток к оплате', '48 000 ₽', '120 000 − 72 000; срок оставшейся оплаты — 20.10.2026'],
];
const allocationRows = [
  ['Э1 · 14.10.2026', '36 000 ₽', '36 000 ₽', '0 ₽'],
  ['Э2 · 21.10.2026', '48 000 ₽', '12 000 ₽', '36 000 ₽ · просрочено'],
  ['Э3 · 28.10.2026', '36 000 ₽', '0 ₽', '36 000 ₽ · будущий срок'],
];
const faqItems = [
  { question: 'Как отметить частичную оплату в Битрикс24?', answer: 'Сначала проверьте фактическое поступление и его связь со сделкой. Если деньги приняты через подключённую платёжную систему, проверьте статус оплаты в таймлайне. Для отдельного ручного учёта можно вести журнал поступлений по ID сделки и обновлять пользовательские денежные поля с полученной суммой и остатком. Этот способ требует сверки и не синхронизируется с банком сам по себе.' },
  { question: 'Где посмотреть остаток к оплате по сделке?', answer: 'В описанном способе — в созданном поле «Остаток к оплате», после сверки с журналом. Название предложено для вашей настройки CRM. Остаток считают по действующей стоимости сделки и подтверждённым поступлениям с учётом возвратов; сумма самой сделки не показывает, сколько денег уже получено.' },
  { question: 'Клиент посмотрел ссылку на оплату. Можно считать деньги полученными?', answer: 'Нет. Просмотр страницы и успешная оплата — разные события. Проверяйте статус оплаты заказа и её источник. Отправка ссылки, выставленный счёт или сообщение клиента не заменяют подтверждение поступления.' },
  { question: 'Можно ли хранить несколько поступлений в одном поле сделки?', answer: 'Одно поле с общей суммой подходит для итогов, но не заменяет историю отдельных поступлений. Сохраняйте записи с датами, суммами, валютой и идентификаторами источника в журнале. После новой оплаты пересчитайте общий итог, сохранив предыдущие записи.' },
  { question: 'Чем остаток к оплате отличается от просрочки?', answer: 'Остаток — ещё не полученная сумма по действующему обязательству. Просрочкой является неоплаченная часть, срок которой уже наступил и прошёл по согласованным условиям. Не считайте просроченным весь остаток, если часть платежей запланирована на будущее.' },
  { question: 'Нужно ли менять сумму сделки после каждого платежа?', answer: 'Нет, если стоимость обязательства не изменилась. Полученные деньги и остаток учитывайте отдельно. Когда стороны изменили состав заказа или стоимость, обновите сумму сделки по действующим условиям, затем пересчитайте остаток. Изменение цены и поступление денег — разные события.' },
  { question: 'Как распределить один платёж между несколькими этапами?', answer: 'Сохраните единое основание поступления, а в журнале распределений укажите отдельную строку для каждой его части. Например, 42 000 ₽ можно отнести как 36 000 ₽ на первый этап и 6 000 ₽ на второй. Сумма частей должна совпасть с подтверждённым поступлением; полные 42 000 ₽ нельзя повторно прибавлять к этим строкам. Согласуйте назначение с условиями оплаты.' },
  { question: 'Чем исправление распределения отличается от возврата денег?', answer: 'При переносе суммы между этапами деньги остаются у компании: снимите ошибочно отнесённую часть и добавьте её к верному этапу, сохранив исходную запись и причину. Общий факт поступлений не изменится. Реальный возврат клиенту подтверждают отдельно; он уменьшает полученную сумму. В Excel-шаблоне для этих случаев предусмотрены разные типы записи, но основание и правильность распределения проверяет сотрудник.' },
];
const relatedArticles = getRelatedArticles(article.hrefPath)
  .map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const structuredData = createArticleStructuredData({
  articleType: 'Article', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  articleSection: 'Учёт оплат в Битрикс24',
  breadcrumbs: [
    { name: 'Главная', item: siteRoot.toString() },
    { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() },
    { name: title, item: articleUrl },
  ],
  faqItems,
});
---

<ArticleLayout {title} {titleParts} {description} {canonicalPath} {structuredData}
  ogTitle={article.seoTitle} ogDescription={description} {ogImage} ogImageAlt={imageAlt}
  category={article.category} author={authorName}
  intro="Как проверить частичные поступления по одной сделке, распределить их по этапам и показать остаток в CRM. Примеры расчёта, исправления записей и ручной Excel-шаблон."
>
  <Fragment slot="quick-answer">
    <p>Сохраняйте каждое подтверждённое поступление отдельно: ID сделки, фактическая дата, сумма, валюта и идентификатор источника. <strong>Остаток к оплате = действующая сумма сделки − полученные деньги с учётом возвратов.</strong></p>
    <p>Если оплата идёт по этапам, распределите каждое поступление по конкретным срокам: общий итог не показывает, какой этап погашен. В Битрикс24 проверяйте штатные оплаты в таймлайне; для отдельного ручного учёта используйте журнал и денежные поля. Автоматической банковской сверки у этого способа нет.</p>
  </Fragment>

  <p data-article-lead>Клиент внёс аванс, потом оплатил часть работ, а менеджер видит в CRM только сумму сделки. Чтобы назвать оставшуюся сумму, приходится искать платёжные документы и сообщения. Помогает простой порядок: у каждого поступления есть своя запись, а в карточке сделки хранится проверенный итог.</p>
  <p>Если сначала нужно определить будущие суммы и сроки, начните с <a href={`${base}grafik-platezhey-bitrix24/`}>составления графика платежей клиента</a>.</p>

  <section aria-labelledby="native-payment">
    <h2 id="native-payment">Что показывает <span data-heading-accent>штатная оплата</span> в Битрикс24</h2>
    <p>Для приёма денег по ссылке откройте CRM → Сделки → нужную карточку и нажмите «Принять оплату». В настройках проверьте товары, количество, цену и подключённый способ оплаты. Если кнопка скрыта, в настройках поля «Сумма и валюта» доступна команда «Показать кнопку принятия оплаты». Нужны права просмотра и изменения сделки. <a href={sourceLinks[0].href} target="_blank" rel="noopener noreferrer">Порядок приёма оплаты по ссылке</a>.</p>
    <ArticleFigure src={paymentImage} fullSize alt={imageAlt} caption="Кнопка «Принять оплату» в официальном примере Поддержки24. Экран иллюстрирует приём оплаты, а не ручной журнал частичных поступлений; сумма и карточка относятся к примеру документации." />
    <p>Информация о штатной оплате появляется в таймлайне. Различайте отправку сообщения, просмотр страницы и успешную оплату заказа: открытая ссылка ещё не означает, что клиент рассчитался. В официальном описании указаны статусы оплаты «оплачено», «не оплачено» и «ошибка». <a href={sourceLinks[1].href} target="_blank" rel="noopener noreferrer">Как проверить статусы</a>.</p>
    <p>Настройка заказа для оплаты по ссылке не описывает полный журнал произвольных поступлений по договору. Если деньги приходят отдельными переводами или нужной связи с источником нет, ведите их историю отдельно и сверяйте итоги. Не меняйте цену товара только ради того, чтобы изобразить уже полученный аванс.</p>
  </section>

  <section aria-labelledby="balance-definition">
    <h2 id="balance-definition">Как посчитать <span data-heading-accent>получено и остаток</span></h2>
    <p>Возьмём учебную сделку D-1042 на 120 000 ₽. В журнале подтверждены два поступления: 30 000 ₽ и 42 000 ₽. Получено 72 000 ₽, остаток — 48 000 ₽. Все суммы примера выражены в рублях, возвратов пока нет.</p>
    <ArticleFigure src={balanceImage} fullSize alt="Учебный расчёт: сделка на 120 тысяч рублей, два поступления на 72 тысячи и остаток к оплате 48 тысяч" caption="Учебный пример TrueTell, не скриншот приложения и не результат клиента. Синяя часть полосы — полученные 60% суммы сделки; серый участок — оставшиеся 40%." />
    <p>Оставшиеся 48 000 ₽ ещё не обязательно просрочены. Если их согласованный срок — 20 октября, до этой даты это будущий платёж. Для определения просрочки нужны сроки конкретных обязательств; одной общей суммы недостаточно.</p>
    <p>Сумма выигранных сделок тоже не заменяет поступления. Продажа могла завершиться, а клиент продолжает платить по этапам. Эту разницу разбираем в материале <a href={`${base}otchety-po-prodazham-bitrix24/`}>об отчётах по продажам в Битрикс24</a>.</p>
  </section>

  <section aria-labelledby="receipt-journal">
    <h2 id="receipt-journal">Как вести <span data-heading-accent>журнал поступлений</span> по сделке</h2>
    <p>Для начала подойдёт согласованная рабочая таблица. Выберите одного владельца итогов и ограничьте доступ по правилам вашей компании. Журнал — источник отдельных операций; поля в CRM будут его краткой сводкой.</p>
    <Checklist items={receiptSteps} label="Порядок ручного учёта частичных поступлений" />
    <p>Ниже — две записи для учебной сделки D-1042, обе в RUB. В общем журнале нескольких сделок указывайте ID сделки и валюту в каждой строке. Если ведёте отдельный файл для одной сделки, закрепите их в шапке и сохраняйте связь при переносе строк в общий реестр. На телефоне прокрутите таблицу вправо, чтобы увидеть все колонки.</p>
    <DataTable label="Учебный фрагмент журнала поступлений по сделке D-1042 в RUB" columns={['Дата факта', 'Тип операции', 'Источник и ID', 'Сумма']} rows={receiptRows} rowHeaders />
    <p>Идентификатор вместе с источником помогает отличить повторную запись от нового платежа. Под источником здесь понимаем устойчивое обозначение банковского счёта или платёжного сервиса. Имя файла выписки храните отдельно: одна операция может повториться в нескольких выгрузках. Одинаковая сумма или фамилия клиента не доказывают дубль. Если источник не даёт устойчивого ID, заранее согласуйте правило сопоставления и разбирайте неоднозначные записи вручную.</p>
    <p>Сохраните в карточке ссылку на журнал, чтобы следующий менеджер нашёл основание итогов. Комментарий может служить пояснением, но не заменяет историю: <a href={sourceLinks[4].href} target="_blank" rel="noopener noreferrer">комментарии таймлайна можно редактировать и удалять</a>.</p>
  </section>

  <section aria-labelledby="allocate-receipt">
    <h2 id="allocate-receipt">Как распределить <span data-heading-accent>частичную оплату по этапам</span></h2>
    <p>Рассмотрим другую учебную сделку — DEMO-001 из <a href={`${base}grafik-platezhey-bitrix24/#download-payment-template`}>готового Excel-шаблона графика и журнала</a>. Она не связана с D-1042 выше. Стоимость тоже 120 000 ₽, но здесь согласованы три этапа: 36 000 ₽ до 14 октября, 48 000 ₽ до 21 октября и 36 000 ₽ до 28 октября 2026 года. Дата проверки — 22 октября.</p>
    <p>14 октября поступило 42 000 ₽. По согласованному назначению отнесём 36 000 ₽ к Э1 и 6 000 ₽ к Э2: это две строки распределения одного платежа P1, с разными ID записей J001 и J002. 20 октября поступило ещё 6 000 ₽ — запись J003 относится к Э2 и отдельному платежу P2. В итоге по сделке получено 48 000 ₽, из них на второй этап отнесено 12 000 ₽.</p>
    <ArticleFigure src={allocationImage} fullSize alt="Лист Журнал шаблона TrueTell: платёж P1 разделён на 36 000 и 6 000 рублей, платёж P2 на 6 000 рублей отнесён ко второму этапу" caption="Рендер листа «Журнал» реального файла TrueTell №076 с учебными данными. J001 и J002 — части одного поступления P1; J003 — другое поступление P2. Это самостоятельная таблица, не экран приложения Битрикс24. Откройте полный размер, чтобы прочитать записи." />
    <DataTable label="Учебная сделка DEMO-001: распределение поступлений на 22.10.2026 в RUB" columns={['Этап и срок', 'План', 'Отнесено из поступлений', 'Осталось']} rows={allocationRows} rowHeaders />
    <p><strong>Общий остаток — 72 000 ₽, из них просрочено 36 000 ₽.</strong> Срок Э2 уже прошёл, а Э3 ещё не наступил. Полученные 48 000 ₽ не означают, что второй этап погашен: к нему отнесены только 12 000 ₽. В этом примере просроченной считаем непогашенную часть этапа со сроком раньше даты проверки.</p>
    <p>Сверяйте сумму частей с исходным платежом. Нельзя учесть 42 000 ₽ целиком, а затем ещё раз прибавить его распределения 36 000 ₽ и 6 000 ₽. Способ распределения закрепите по условиям договора или согласованному назначению; не переносите деньги между этапами только ради исчезновения просрочки. Первоначальные суммы и сроки плана сохраните, а изменения условий оформляйте отдельной версией с основанием.</p>
    <p>В шаблоне одна строка журнала относится к одному этапу. Файл рассчитан на одну сделку в RUB, до 20 этапов и 50 записей: связи с CRM и банком нет. Проверки ячеек не устанавливают, существовал ли платёж в банке и верно ли вы указали его назначение. <a href={`${base}grafik-platezhey-bitrix24/#download-payment-template`}>Скачайте шаблон и прочитайте порядок заполнения</a>; перед работой замените учебные данные.</p>
  </section>

  <section aria-labelledby="crm-fields">
    <h2 id="crm-fields">Как показать итоги <span data-heading-accent>в карточке CRM</span></h2>
    <p>Настройте два пользовательских поля типа «Деньги»: «Получено по сделке» и «Остаток к оплате». Тип хранит сумму и валюту. Наши названия — предложение для вашего процесса, не обязательные системные поля. При создании полей согласуйте, кто отвечает за заполнение и сверку. <a href={sourceLinks[2].href} target="_blank" rel="noopener noreferrer">Типы и права создания полей</a>.</p>
    <Checklist items={fieldSteps} label="Создание ручных итоговых полей в сделке" />
    <ArticleFigure src={fieldImage} fullSize alt="Официальный список типов пользовательских полей Битрикс24, включая тип Деньги" caption="Оригинал из Поддержки24: в списке типов есть «Деньги». На скриншоте ещё выбран тип «Строка»; для предложенных итогов выберите «Деньги». Это настройки поля, не готовый финансовый отчёт." />
    <p>Если нужные поля созданы, но скрыты, используйте «Выбрать поле» в карточке и сохраните настройку отображения. <a href={sourceLinks[3].href} target="_blank" rel="noopener noreferrer">Как показать существующее поле</a>. Не создавайте параллельные итоги, которые разные сотрудники обновляют по разным правилам.</p>
    <p>Вернёмся к первой учебной сделке D-1042: после поступлений 30 000 ₽ и 42 000 ₽ в её карточке должны быть следующие итоги.</p>
    <DataTable label="Учебная сделка D-1042: ручные значения карточки после двух поступлений" columns={['Показатель', 'Значение', 'Основание']} rows={summaryRows} rowHeaders />
    <p>После следующего поступления сначала добавьте его в журнал, затем пересчитайте и сохраните итоги в CRM. В этом варианте <strong>поля не суммируют записи и не синхронизируются с банком автоматически</strong>. Если обновление откладывается, указывайте дату последней сверки: коллеги должны понимать, насколько свежая сумма перед ними.</p>
    <InlineConsultation title="Нужен единый порядок учёта оплат?" description="Разберём, откуда приходят платежи, как они связаны со сделками и какие итоги нужны менеджеру." href={companyInfo.contacts.consultationUrl} actionLabel="Обсудить задачу" />
  </section>

  <section aria-labelledby="returns-and-corrections">
    <h2 id="returns-and-corrections">Как учитывать <span data-heading-accent>возвраты и исправления</span></h2>
    <p>Реальный возврат денег клиенту — отдельная операция с датой и подтверждением. Если по сделке D-1042 вернули 15 000 ₽, чисто получено 57 000 ₽: 72 000 − 15 000. При неизменной стоимости сделки 120 000 ₽ остаток станет 63 000 ₽. Если одновременно изменились условия или стоимость заказа, сначала уточните действующее обязательство, затем считайте остаток.</p>
    <p>Ошибка записи — другой случай. Если 42 000 ₽ внесли дважды, второго поступления в источнике нет. Сохраните ошибочную строку и сделайте связанную корректировку по правилам своего журнала: например, отдельную запись −42 000 ₽ типа «Исправление» со ссылкой на ID дубля и объяснением. Не оформляйте вымышленный возврат, чтобы скрыть повтор.</p>
    <h3>Если деньги отнесли не к тому этапу</h3>
    <p>Вернёмся к отдельной сделке DEMO-001. Допустим, поступление P2 на 6 000 ₽ по ошибке отнесли к Э3 вместо Э2. Сохраните исходную строку J003, затем внесите две новые записи типа «Исправление»: −6 000 ₽ по Э3 и +6 000 ₽ по Э2. У каждой записи должен быть свой ID; в основании укажите J003, P2 и причину переноса. Этап Э3 после снятия ошибочной суммы снова имеет нулевой факт, а к Э2 отнесено 12 000 ₽.</p>
    <p>Это альтернативный пример с ошибкой. В скачиваемом файле J003 уже правильно отнесена к Э2: добавлять к нему эти две корректировки не нужно, иначе получится новая ошибка.</p>
    <p>Эти две корректировки в сумме дают ноль: всего получено прежние 48 000 ₽, остаток — 72 000 ₽. Меняется распределение по срокам, поэтому просроченный остаток Э2 уменьшается с 42 000 ₽ до 36 000 ₽. Отрицательная строка здесь не означает возврат клиенту.</p>
    <p>Для сравнения возьмём независимый вариант после правильного распределения: клиенту действительно вернули 6 000 ₽ из суммы, отнесённой к Э2. При неизменном обязательстве запишите −6 000 ₽ типа «Возврат», с фактической датой 22 октября и подтверждением операции. Тогда получено 42 000 ₽, общий остаток — 78 000 ₽, просрочено по Э2 — 42 000 ₽. Примеры исправления и возврата здесь поясняют разные ситуации; в скачиваемом файле они заранее не заполнены.</p>
    <p>Когда подтверждённо полученная сумма больше действующей стоимости сделки, проверьте распределение по сделкам, повторы и изменение цены. Отрицательный расчётный остаток показывает расхождение или переплату; не заменяйте его нулём без объяснения. Суммы разных валют ведите отдельно либо используйте заранее определённое правило пересчёта.</p>
  </section>

  <section aria-labelledby="final-check">
    <h2 id="final-check">Что проверить <span data-heading-accent>перед ответом клиенту</span></h2>
    <p>Откройте одну сделку и проследите каждую включённую в итог запись до источника. Сверьте ID сделки, валюту, фактические даты и суммы, возвраты и изменения стоимости. После этого сравните журнал с сохранёнными полями CRM.</p>
    <p>Не переводите всю сделку в успешную стадию только ради отметки одного платежа. Стадия описывает ваш процесс продаж, а поступления имеют свою историю. Для списка сделок используйте одинаковое правило итогов; будущий общий отчёт должен читать те же проверенные данные. Основы BI Конструктора разобраны в <a href={`${base}bi-analitika-bitrix24-pervyy-otchet/`}>инструкции по первому BI-отчёту Битрикс24</a>: в ней считают сделки. Для отчёта по оплатам отдельно понадобятся записи поступлений и их связь с CRM.</p>
  </section>

  <p>Для контроля нескольких клиентов используйте <a href={`${base}debitorskaya-zadolzhennost-bitrix24/`}>разбор задолженности в Битрикс24 для руководителя</a>: выделите непогашенные сроки и назначьте проверяемые поручения по выбранным обязательствам.</p>

  <section aria-labelledby="payment-schedule-product">
    <h2 id="payment-schedule-product">Когда нужен <span data-heading-accent>«График платежей»</span></h2>
    <p>Ручной способ требует дисциплины: несколько поступлений по одной сделке нужно связать, проверить и отразить в итогах. Когда таких сделок много, полезен отдельный инструмент с планом, историей факта и понятными остатками.</p>
    <p>Мы разрабатываем «График платежей» для Битрикс24. На 25 октября 2026 года в тестовых установках на двух порталах проверено сохранение графиков. На первом также проверены ручное поступление с исправлением и отменой, отчёт и обе CSV; на втором — разграничение доступа. <strong>Приложение ещё не выпущено в Маркете</strong>, а запись поступления в нём сама по себе не подтверждает банковский платёж. Примеры выше относятся к самостоятельному Excel-шаблону и не описывают экран приложения.</p>
    <p>Если следующий вопрос — какие цифры вывести руководителю по нескольким сделкам, начните с <a href={`${base}dashbord-rukovoditelya-bitrix24/`}>выбора показателей для дашборда</a>. Чётко отделяйте сумму продаж от фактически полученных денег.</p>
  </section>

