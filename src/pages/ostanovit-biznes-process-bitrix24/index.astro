---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { mcpProduct } from '../../config/products';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import autostartImage from '../../images/articles/bitrix24-bp-autostart-official-107.jpg';
import cancelImage from '../../images/articles/bitrix24-bp-cancel-official-107.jpg';

const article = getArticle('ostanovit-biznes-process-bitrix24/');
const { title, description } = article;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const ogImage = new URL(autostartImage.src, siteRoot).toString();
const imageAlt = 'Параметры шаблона Битрикс24: флажки автоматического запуска при добавлении и изменении элемента CRM';
const faqItems = [
  { question: 'Как отключить бизнес-процесс Битрикс24, не удаляя шаблон?', answer: 'В параметрах шаблона CRM снимите флажки «Автоматически запускать» при добавлении и изменении элемента и сохраните. Это прекращает новые автоматические запуски по этим событиям, но шаблон остаётся доступен для ручного запуска тем, у кого есть права.' },
  { question: 'Остановятся ли уже запущенные процессы после отключения автозапуска или удаления шаблона?', answer: 'Нет. По справке Битрикс24 экземпляры, запущенные до изменения или удаления настройки, продолжают прежний сценарий. Каждый ненужный активный экземпляр нужно найти и остановить отдельно.' },
  { question: 'Где остановить один бизнес-процесс в карточке CRM?', answer: 'Если события процесса показаны в таймлайне карточки, откройте меню с тремя точками у нужного процесса и выберите «Отменить процесс». Если событий в таймлайне нет, найдите экземпляр в «Автоматизация» → «Все активные» по фильтру «Элемент CRM» и проверьте доступное действие в его меню.' },
  { question: 'Скрытие из меню ручного запуска полностью отключает процесс?', answer: 'Нет. Параметр «Скрыть из меню ручного запуска» ограничивает видимость шаблона: его по-прежнему видят создатель и пользователи с правами на запуск. Для прекращения новых автоматических стартов снимите оба флажка автозапуска.' },
  { question: 'Может ли MCP TrueTell автоматически остановить все процессы?', answer: 'Такую возможность мы не заявляем. MCP TrueTell для настройки и диагностики CRM находится в разработке. До массовых действий нужно определить тип процесса, права и последствия для активных карточек.' },
];
const sourceLinks = [
  { label: 'Битрикс24: параметры шаблона бизнес-процесса в CRM', href: 'https://helpdesk.bitrix24.ru/open/23709036/' },
  { label: 'Битрикс24: процесс в карточке CRM и список активных', href: 'https://helpdesk.bitrix24.ru/open/23509402/' },
  { label: 'Битрикс24: почему после удаления работает старый экземпляр', href: 'https://helpdesk.bitrix24.ru/open/23046316/' },
  { label: 'Битрикс24: отключение отдельного действия процесса', href: 'https://helpdesk.bitrix24.ru/open/18182802/' },
  { label: 'Битрикс24: экспорт и импорт шаблона бизнес-процесса', href: 'https://helpdesk.bitrix24.ru/open/5435897/' },
];
const choiceRows = [
  ['Один процесс мешает в конкретной сделке', 'Найти этот запущенный экземпляр и отменить его', 'Проверить его статус и последствия для участников'],
  ['Новые сделки запускают ненужный сценарий', 'Снять флажки автозапуска в параметрах шаблона', 'Создать контрольный элемент и проверить отсутствие нового старта'],
  ['Лишний шаг внутри полезного процесса', 'Выключить конкретное действие в дизайнере', 'Проверить связанные последующие действия и новый запуск'],
  ['Шаблон больше не нужен', 'Сначала сохранить его экспорт и проверить активные экземпляры; затем решать вопрос удаления', 'Не считать удаление шаблона остановкой старых экземпляров'],
];
const structuredData = createArticleStructuredData({
  articleType: 'Article', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  breadcrumbs: [{ name: 'Главная', item: siteRoot.toString() }, { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() }, { name: title, item: articleUrl }],
  faqItems,
});
---
<ArticleLayout {title} titleParts={[{ text: 'Как остановить бизнес-процесс Битрикс24 ' }, { text: 'и отключить автозапуск', accent: true }]} {description}
  canonicalPath={`/${article.hrefPath}`} {structuredData} ogTitle={article.seoTitle} ogDescription={description}
  {ogImage} ogImageAlt={imageAlt} category={article.category} author={authorName}
  intro="Процесс продолжает создавать задания или отправлять уведомления, хотя его уже изменили? Сначала определите, что именно надо остановить: один запущенный экземпляр в карточке или новые запуски шаблона для всех карточек CRM.">
  <Fragment slot="quick-answer">
    <p><strong>Для новых запусков снимите флажки «Автоматически запускать» в параметрах шаблона.</strong> Для уже запущенного процесса откройте его меню в таймлайне карточки и выберите «Отменить процесс» либо найдите экземпляр в разделе «Все активные». Изменение или удаление шаблона само по себе не завершает старые экземпляры.</p>
  </Fragment>

  <p data-article-lead>В Битрикс24 слово «процесс» может означать шаблон, конкретный запущенный экземпляр или одно действие внутри сценария. Из-за этой путаницы администратор удаляет шаблон, а согласование по старой сделке всё ещё идёт. Выберите действие по тому, что вы хотите изменить, и запишите ID карточки, на которой заметили проблему.</p>

  <section aria-labelledby="choose">
    <h2 id="choose">Выберите, <span data-heading-accent>что останавливать</span></h2>
    <p>Шаблон определяет будущие запуски. Экземпляр — работа этого шаблона для определённого элемента CRM. Отдельное действие может быть выключено в редакторе, пока остальной сценарий нужен. Не меняйте всё сразу: сначала проверьте один проблемный элемент и выясните, через что процесс стартует — автоматически, вручную или из другой автоматизации.</p>
    <DataTable label="Какое действие выбрать для бизнес-процесса" columns={['Ситуация', 'Действие', 'Контроль']} rows={choiceRows} rowHeaders />
    <p>Если причина сбоя пока неясна, начните с <a href={`${base}audit-avtomatizacii-bitrix24/`}>аудита цепочки автоматизации</a>. Это позволит увидеть, не запускает ли тот же сценарий робот или другая настройка.</p>
  </section>

  <section aria-labelledby="autostart">
    <h2 id="autostart">Отключите <span data-heading-accent>новые автоматические запуски</span></h2>
    <p>Администратор или сотрудник с правом «Разрешать изменять настройки CRM» открывает «Автоматизация» → «Бизнес-процессы» → «Процессы в CRM», выбирает тип элемента и «Список шаблонов». В нужном шаблоне откройте «Параметры шаблона» → «Основное». Снимите флажки «При добавлении» и «При изменении» у параметра «Автоматически запускать», затем сохраните. Проверьте оба флажка: оставленный вариант запуска сохранит соответствующий сценарий.</p>
    <ArticleFigure src={autostartImage} fullSize alt={imageAlt} caption="Подлинный экран параметров шаблона из справки Битрикс24, обновлённой 23.07.2026. На демонстрационном примере отмечен запуск «При добавлении»; для отключения автозапуска нужно снять флажки. Это не данные клиента TrueTell." />
    <p>Шаблон после этого остаётся в системе и может запускаться вручную. Параметр «Скрыть из меню ручного запуска» не равен полному отключению: создатель шаблона и пользователи с правами на запуск всё ещё могут его видеть и использовать. Если процесс запускает робот или внешнее подключение, проверьте этот путь отдельно по конкретной карточке.</p>
  </section>

  <section aria-labelledby="active">
    <h2 id="active">Остановите <span data-heading-accent>уже запущенный экземпляр</span></h2>
    <p>В карточке CRM найдите событие нужного бизнес-процесса в таймлайне. В его меню с тремя точками есть действие «Отменить процесс». Если события не видны, это может быть связано с параметром шаблона «Показывать события этого процесса в таймлайне». Тогда откройте «Автоматизация» → «Все активные», примените фильтр «Элемент CRM», найдите экземпляр по карточке и проверьте действие в его меню. Не останавливайте одноимённый процесс на другой сделке.</p>
    <ArticleFigure src={cancelImage} fullSize alt="Меню запущенного бизнес-процесса в таймлайне CRM Битрикс24 с пунктом «Отменить процесс»" caption="Подлинный экран из справки Битрикс24 «Как запустить бизнес-процесс в карточке CRM», обновлённой 23.07.2026. Имена и пример сделки принадлежат демонстрационному порталу Битрикс24." />
    <p>Перед отменой посмотрите, на каком задании стоит процесс и кто его ждёт. Отмена прекращает этот экземпляр; уже созданные им задачи, письма или изменения карточки проверяйте отдельно. Если таких экземпляров много, сначала составьте список карточек и согласуйте последствия с владельцем процесса, а потом останавливайте по одной группе.</p>
  </section>

  <section aria-labelledby="delete">
    <h2 id="delete">Когда можно <span data-heading-accent>удалять шаблон</span></h2>
    <p>Если задача — остановить поток новых запусков, удаления не требуется: достаточно убрать автозапуск. Удаление имеет смысл, когда шаблон действительно больше не нужен для ручного запуска и нет связанных сценариев. До удаления выгрузите шаблон командой «Экспорт» в редакторе Битрикс24: справка описывает файл <code>.bpt</code> и импорт для шаблонов одного типа. Такой файл сохраняет схему для последующего разбора, но не возвращает запущенные экземпляры.</p>
    <p>Затем проверьте активные процессы, роботов, которые могут запускать этот шаблон, и сотрудников, у которых есть ручной запуск. В разных разделах Битрикс24 удаление устроено по-разному, поэтому не используйте инструкцию для процесса в ленте как пошаговую инструкцию для CRM. Удаляйте именно проверенный CRM-шаблон в его списке, следуя подтверждению интерфейса вашего портала.</p>
    <p>Если нужно выключить лишь один шаг, откройте это действие в дизайнере, выберите «Выключить» в меню действия и сохраните шаблон. Битрикс24 предупреждает: выключение родительского действия отключает и следующие связанные действия. На новых элементах проверьте результат после правки; ранее запущенные экземпляры продолжают прежний сценарий.</p>
  </section>

  <section aria-labelledby="verify">
    <h2 id="verify">Проверьте <span data-heading-accent>результат отдельно для старых и новых карточек</span></h2>
    <p>Зафиксируйте одну старую карточку с активным экземпляром и одну новую контрольную карточку. На старой проверьте статус именно того экземпляра, который собирались остановить. На новой воспроизведите событие запуска с согласованными учебными данными и убедитесь, что новый процесс не стартовал. Не используйте настоящие адреса клиентов для теста: оставшиеся роботы и действия могут отправить сообщения.</p>
    <p>Запишите время изменения шаблона, ID обеих карточек, ожидаемый результат и фактический статус. Если поведение расходится с планом, проверьте другой путь запуска. Когда процесс вызывает робот, отдельно пройдите <a href={`${base}robot-ne-srabatyvaet-bitrix24/`}>проверку его условия и исполнения</a>. MCP TrueTell для настройки и диагностики CRM находится в разработке; вопросы по такому контрольному сценарию можно обсудить с нами, но готовую массовую остановку процессов мы не обещаем.</p>
    <InlineConsultation variant="product" title="Нужно разобраться с лишними запусками?" description="Опишите тип элемента CRM, путь запуска и ситуацию без данных клиентов. Поможем составить план проверки и обсудим будущий сценарий диагностики с MCP TrueTell." href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
  </section>

  <FaqSection title="Частые вопросы об остановке бизнес-процессов Битрикс24" items={faqItems} variant="article" />
  <p>Справка Битрикс24 проверена 31 октября 2026 года. Скриншоты взяты из её демонстрационных примеров. Действия в клиентском портале и работа MCP TrueTell в описанном сценарии не проверялись.</p>
  <ArticleSources publishedIso={article.publishedAt} modifiedIso={article.updatedAt} sources={sourceLinks} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Обсудим ' }, { text: 'диагностику CRM с MCP TrueTell', accent: true }]} description={mcpProduct.articleDescription} href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <ConsultationCtaSection slot="after-article" />
</ArticleLayout>
