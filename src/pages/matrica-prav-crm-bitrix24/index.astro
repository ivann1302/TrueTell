---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { mcpProduct } from '../../config/products';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import actionsImage from '../../images/articles/bitrix24-crm-rights-actions-official-136.jpg';
import overlapImage from '../../images/articles/bitrix24-crm-rights-overlap-official-136.jpg';

const article = getArticle('matrica-prav-crm-bitrix24/');
const { title, description } = article;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const ogImage = new URL(actionsImage.src, siteRoot).toString();
const imageAlt = 'Официальный скриншот Битрикс24: настройки чтения, добавления, изменения и экспорта лида для ролей CRM';
const faqItems = [
  { question: 'Можно ли создать сделку и сразу не увидеть её?', answer: 'Да. В Битрикс24 право «Добавление» и право «Чтение» задаются отдельно. Если сотруднику разрешено создавать элемент, но не читать его, после создания карточка может быть ему недоступна.' },
  { question: 'Достаточно ли РОПу права на чтение всех сделок?', answer: 'Зависит от его работы. Для просмотра дел в CRM нужно право чтения соответствующей карточки. Создание и изменение дел связано с правом изменения элемента. Отдельно проверьте воронки и стадии, с которыми руководитель работает.' },
  { question: 'Если у сотрудника две роли, какая действует?', answer: 'При пересечении ролей более широкое право обычно даёт доступ, но детализированное ограничение на стадии может перекрыть разрешение на уровне воронки. Проверьте назначенные роли и итоговый доступ на контрольных карточках каждой нужной стадии.' },
  { question: 'Разрешение crm у приложения даёт доступ ко всем сделкам?', answer: 'Нет. Scope crm разрешает обращения к методам CRM в пределах прав пользователя, от имени которого выполняется вызов. Для интеграции нужно проверить схему авторизации, назначенные права CRM и конкретный метод.' },
  { question: 'Может ли MCP TrueTell сейчас проверить матрицу прав автоматически?', answer: 'Такую готовую функцию мы не заявляем: MCP TrueTell для настройки и диагностики CRM находится в разработке. Можно обсудить требуемые проверки и минимальный набор прав для будущего сценария.' },
];
const sourceLinks = [
  { label: 'Битрикс24: ролевая модель прав в CRM', href: 'https://helpdesk.bitrix24.ru/open/23240636/' },
  { label: 'Битрикс24: конфликты прав на стадиях', href: 'https://helpdesk.bitrix24.ru/open/14749830/' },
  { label: 'Битрикс24: права на дела в CRM', href: 'https://helpdesk.bitrix24.ru/open/27844326/' },
  { label: 'Битрикс24: права доступа к CRM-формам', href: 'https://helpdesk.bitrix24.ru/open/23440556/' },
  { label: 'Битрикс24 REST API: первые шаги и область прав приложения', href: 'https://apidocs.bitrix24.ru/first-steps/' },
  { label: 'Битрикс24 REST API: список элементов CRM', href: 'https://apidocs.bitrix24.ru/api-reference/crm/universal/crm-item-list.html' },
];
const matrixRows = [
  ['Сделки: чтение', 'Свои или назначенная зона работы', 'Сделки своей команды, если это требуется для контроля', 'Только элементы, нужные сценарию; проверить фактическую видимость'],
  ['Сделки: добавление', 'Если создаёт сделки вручную', 'Если создаёт сделки в своей работе', 'Только если интеграция создаёт сделки'],
  ['Сделки: изменение и стадия', 'Свои сделки и разрешённые переходы', 'Сделки команды и нужные переходы', 'Только действия, которые действительно выполняет метод'],
  ['Контакты и компании', 'Те связи, которые нужны при работе со сделкой', 'Те связи, которые нужны для контроля команды', 'Проверить отдельно по каждому типу объекта'],
  ['Экспорт, импорт, удаление в интерфейсе', 'По отдельному решению владельца CRM', 'По отдельному решению владельца CRM', 'Права интерфейса проверять отдельно; для API решает доступ к данным и методам'],
  ['Настройки CRM и права', 'Не требуется для обычной работы', 'Только если РОП реально администрирует CRM', 'Не выдавать для обычного обмена данными'],
];
const testRows = [
  ['Менеджер', 'Своя сделка: открыть и изменить', 'Чужая сделка и соседняя воронка: проверить ожидаемое ограничение'],
  ['РОП', 'Сделка подчинённого: открыть, посмотреть дело, выполнить нужное изменение', 'Сделка другого отдела: проверить согласованную границу'],
  ['Интеграция', 'Один разрешённый вызов на тестовом элементе и ожидаемый результат', 'Чужой элемент или запрещённое действие: проверить отказ либо отсутствие в выборке'],
];
const structuredData = createArticleStructuredData({
  articleType: 'Article', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  breadcrumbs: [{ name: 'Главная', item: siteRoot.toString() }, { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() }, { name: title, item: articleUrl }],
  faqItems,
});
---
<ArticleLayout {title} titleParts={[{ text: 'Матрица прав CRM Битрикс24: ' }, { text: 'менеджер, РОП и интеграция', accent: true }]} {description}
  canonicalPath={`/${article.hrefPath}`} {structuredData} ogTitle={article.seoTitle} ogDescription={description}
  {ogImage} ogImageAlt={imageAlt} category={article.category} author={authorName}
  intro="Менеджер создаёт сделку, руководитель проверяет работу команды, интеграция обновляет карточки. Им нужны разные действия и разная область данных. Зафиксируйте это в одной матрице до выдачи прав.">
  <Fragment slot="quick-answer">
    <p><strong>Запишите для каждой роли тип элемента, действие и область доступа.</strong> Например: менеджер меняет свои сделки в рабочей воронке; РОП читает сделки команды; интеграция читает или меняет только то, что нужно её сценарию. Затем проверьте под каждой учётной записью разрешённый и запрещённый случай. Одного названия роли для проверки недостаточно.</p>
  </Fragment>

  <p data-article-lead>Вопрос «какие права дать менеджеру» часто возникает, когда он уже потерял карточку из виду. Удобнее начать с работы команды: кто отвечает за сделку, кто видит соседнюю воронку и что именно делает подключённая система. Это позволит проверить настройки без выдачи широкого доступа на всякий случай.</p>

  <section aria-labelledby="matrix">
    <h2 id="matrix">Составьте матрицу <span data-heading-accent>по действиям и объектам</span></h2>
    <p>В CRM права задаются для контактов, компаний, лидов, сделок в разных воронках и других элементов. Для них отдельно выбирают чтение, добавление, изменение, удаление, экспорт и импорт. Сделка может быть доступна в одной воронке и недоступна в другой; для стадий существуют дополнительные правила. Поэтому строка «доступ к CRM» в рабочей таблице слишком общая.</p>
    <p>Ниже — пример решения для обсуждения с владельцем CRM, а не готовые значения переключателей. Замените «свои» и «команды» на реальные процессы компании. Особенно внимательно согласуйте экспорт, удаление и право изменять настройки.</p>
    <DataTable label="Пример матрицы прав CRM для трёх рабочих ролей" columns={['Объект и действие', 'Менеджер', 'РОП', 'Интеграция']} rows={matrixRows} rowHeaders />
    <p>Если сотрудник создаёт карточку, проверьте и чтение: право «Добавление» само по себе не даёт увидеть созданный элемент. Для работы с делами тоже важно право на саму карточку: просмотр дела связан с чтением элемента, создание и изменение дела — с его изменением. Подробности по одной пропавшей карточке есть в <a href={`${base}ne-vidno-sdelku-bitrix24-prava/`}>инструкции по видимости сделки</a>.</p>
    <ArticleFigure src={actionsImage} fullSize alt={imageAlt} caption="Подлинный экран прав CRM на примере лида из справки Битрикс24, статья «Ролевая модель прав в CRM» (обновлена 23.07.2026). Показаны названия действий; значения «Все» в демонстрационных колонках не являются рекомендацией для вашей компании." />
  </section>

  <section aria-labelledby="configure">
    <h2 id="configure">Настройте роли и <span data-heading-accent>проверьте их пересечение</span></h2>
    <p>Администратор или сотрудник с правом «Разрешить изменять настройки» открывает CRM → Ещё → Настройки → Права доступа к CRM. Там можно сравнить роли, назначить их сотрудникам и уточнить права по воронкам и стадиям. Ролевая модель доступна не на каждом тарифе; перед работой проверьте возможности вашего портала.</p>
    <p>У сотрудника бывает несколько ролей. При их пересечении более широкое право может открыть доступ, который вы закрыли в другой роли. Но детализированное ограничение для стадии может перекрыть разрешение, заданное выше для воронки. Выберите сотрудника в настройках прав, посмотрите все назначенные ему роли, а затем откройте контрольные карточки на нужных стадиях от его имени. Это надёжнее, чем считать одну колонку матрицы окончательным ответом.</p>
    <ArticleFigure src={overlapImage} fullSize alt="Официальный экран Битрикс24 с выбором сотрудника для проверки назначенных ролей и прав CRM" caption="Подлинный экран выбора сотрудника из справки Битрикс24, статья «Ролевая модель прав в CRM» (обновлена 23.07.2026). Имена и данные на снимке принадлежат примеру в официальной справке; это не портал и не клиенты TrueTell." />
    <p>Для РОПа проверьте отдельной карточкой сделки подчинённого и работу с делами. Для менеджера — свою и чужую сделку, а также соседнюю воронку. Для команды из двух процессов полезна <a href={`${base}dve-voronki-bitrix24-nastroyka/`}>проверка границы между воронками</a>. Права на CRM-формы настраиваются отдельно: доступ к сделкам не означает право менять форму.</p>
  </section>

  <section aria-labelledby="integration">
    <h2 id="integration">Для интеграции проверьте <span data-heading-accent>две границы доступа</span></h2>
    <p>Первая граница — разрешения приложения или вебхука на методы REST API, в том числе область <code>crm</code>. Вторая — права пользователя, от имени которого выполняется запрос, к конкретному элементу CRM. Одно не расширяет другое. Схема авторизации зависит от типа подключения, поэтому сначала зафиксируйте, кто выполняет вызовы и какие методы нужны.</p>
    <p>Например, если интеграция только читает сделки для отчёта, не закладывайте в её роль изменение и удаление. Запрет «Экспорта» в интерфейсе сам по себе не закрывает программное получение доступных записей: метод <code>crm.item.list</code> может вернуть их через API. Для такого подключения ограничивайте чтение, scope и набор используемых методов и данных. Если интеграция создаёт дело в сделке, отдельно проверьте право изменения соответствующего элемента. Список элементов API может не содержать недоступные карточки; пустой результат не всегда означает, что в CRM нет данных. Проверьте тестовый ID в разрешённой и запрещённой области.</p>
    <p>Если речь о подключении внешнего ИИ, добавьте к матрице ещё источник данных, разрешённые действия и порядок отзыва доступа. Подробный разбор — в статье <a href={`${base}bezopasnyy-dostup-ii-k-crm/`}>о безопасном доступе ИИ к CRM</a>. MCP TrueTell для настройки и диагностики CRM находится в разработке. Мы можем обсудить, какую минимальную область данных дать будущему сценарию диагностики; готовую автоматическую проверку прав или подписку пока не заявляем.</p>
  </section>

  <section aria-labelledby="test">
    <h2 id="test">Пройдите три контрольных случая <span data-heading-accent>под реальными ролями</span></h2>
    <p>Создайте согласованные тестовые карточки без данных клиентов. Для каждой роли запишите пользователя или способ авторизации, ID элемента, ожидаемое действие и результат. Проверяйте положительный и отрицательный случай: слишком широкий доступ тоже ошибка матрицы.</p>
    <DataTable label="Минимальные контрольные случаи для матрицы прав" columns={['Кто проверяет', 'Разрешённый случай', 'Граница доступа']} rows={testRows} rowHeaders />
    <p>После исправления роли повторите оба случая. Если этап приёмки CRM ещё впереди, добавьте эти результаты к <a href={`${base}priemka-vnedreniya-crm-bitrix24/`}>маршруту контрольной заявки</a>. В журнале достаточно ID тестовой карточки, роли, даты и результата; токены, клиентские данные и переписку туда не переносите.</p>
    <InlineConsultation variant="product" title="Нужно согласовать права для диагностики CRM?" description="Опишите роли, воронки и действия интеграции без клиентских данных и токенов. Поможем составить проверяемую матрицу и обсудим сценарий MCP TrueTell." href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
  </section>

  <FaqSection title="Частые вопросы о правах CRM Битрикс24" items={faqItems} variant="article" />
  <p>Справка Битрикс24 и REST API проверены 31 октября 2026 года. Скриншоты взяты из официальной справки. На доступном нам тестовом портале раздел прав для текущей учётной записи закрыт, поэтому настройки и результат на вашем портале нужно проверить отдельно.</p>
  <ArticleSources publishedIso={article.publishedAt} modifiedIso={article.updatedAt} sources={sourceLinks} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Обсудим ' }, { text: 'диагностику CRM с MCP TrueTell', accent: true }]} description={mcpProduct.articleDescription} href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <ConsultationCtaSection slot="after-article" />
</ArticleLayout>
