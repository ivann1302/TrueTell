---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import Checklist from '../../components/editorial/checklist.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import linksImage from '../../images/articles/bitrix24-company-links-official.jpg';
import filterImage from '../../images/articles/bitrix24-companies-filter-official.jpg';
import recycleImage from '../../images/articles/bitrix24-companies-recycle-settings-official.jpg';

const article = getArticle('udalenie-kompaniy-bitrix24/');
const { title, description } = article;
const canonicalPath = `/${article.hrefPath}`;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const imageAlt = 'Карточка компании Битрикс24: на вкладке Связи показаны связанная сделка и контакт представителя';
const ogImage = new URL(linksImage.src, siteRoot).toString();
const titleParts = [{ text: 'Как ' }, { text: 'удалить компании', accent: true }, { text: ' в Битрикс24 и проверить связи' }];
const sourceLinks = [
  { label: 'Удаление элементов CRM: список и карточка — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/23238660/' },
  { label: 'Компании: фильтр, экспорт и права — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/25945936/' },
  { label: 'Связи компаний, контактов и сделок — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/27912504/' },
  { label: 'Действие «Удалить компанию» в бизнес-процессе — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/29046346/' },
  { label: 'Реквизиты клиента и их шаблоны — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/26052774/' },
  { label: 'Реквизиты собственной компании — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/24341258/' },
  { label: 'Объединение дубликатов в CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/25343258/' },
  { label: 'Корзина CRM: настройки и восстановление — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/24668648/' },
  { label: 'Групповые действия и опция «Для всех» — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/21064250/' },
];
const decisions = [
  ['Повторная карточка той же организации', 'Сопоставить реквизиты и объединить дубликаты', 'Выбрать основную карточку и сохраняемые значения полей'],
  ['Неверный адрес или банковский счёт', 'Исправить реквизиты нужного клиента', 'Проверить данные, используемые при подготовке документов'],
  ['С компанией временно не работают', 'Согласовать, какие сведения оставить в CRM', 'Проверить историю, открытые сделки и задачи менеджеров'],
  ['Ошибочная тестовая или ненужная карточка', 'Удалить выбранную компанию', 'Зафиксировать ID, проверить связи, экспорт и корзину'],
];
const bulkSteps = [
  { title: 'Откройте компании и настройте фильтр.', description: 'Перейдите в CRM → Клиенты → Компании. Задайте условия отбора и посмотрите несколько карточек из результата.' },
  { title: 'Сверьте выбранные организации.', description: 'Сравните названия, ID и реквизиты с согласованным списком. Убедитесь, что туда не попали действующие контрагенты.' },
  { title: 'Отметьте нужные строки.', description: 'Если операция касается только текущей страницы, оставьте выбор в её пределах. Для всех результатов фильтра на других страницах включите «Для всех».' },
  { title: 'Выберите «Удалить» и проверьте результат.', description: 'Прочитайте подтверждение, если оно появится, выполните действие и обновите список. По сохранённым ID проверьте удалённые и оставленные карточки.' },
];
const faqItems = [
  { question: 'Как удалить одну компанию в Битрикс24?', answer: 'Откройте CRM → Клиенты → Компании, найдите организацию и выберите «Удалить» в меню строки. Другой вариант — Настройки → Удалить в карточке CRM. Сотруднику нужны права на удаление компаний.' },
  { question: 'Как удалить компании сразу на всех страницах списка?', answer: 'Настройте фильтр, проверьте выборку, выделите строки и включите «Для всех». Затем выберите «Удалить». Опция расширяет действие на другие страницы текущего списка, поэтому перед удалением нужно ещё раз сверить условия отбора.' },
  { question: 'Удалятся ли контакты и сделки вместе с компанией?', answer: 'В официальном описании действия «Удалить компанию» в бизнес-процессе указано: связанные сделки, контакты и задачи сохраняются, но теряют связь с компанией. Это описание конкретного действия; последствия своих интеграций и автоматизации нужно проверить отдельно.' },
  { question: 'Как убрать дубль компании и сохранить нужные сведения?', answer: 'Проверьте, что карточки относятся к одной организации. Штатное объединение дубликатов позволяет выбрать основную карточку и значения конфликтующих полей. Для объединения нужны права на изменение и удаление элементов; после операции проверьте итоговую карточку и рабочие связи.' },
  { question: 'Можно ли вернуть компанию после удаления?', answer: 'Проверьте CRM → Ещё → Корзина и фильтр по типу «Компания». Если запись сохранилась и тариф позволяет восстановление, выберите «Восстановить» в её меню. Корзина должна быть включена для компаний; у восстановленного элемента меняется ID.' },
  { question: 'Чем реквизиты клиента отличаются от «Моих реквизитов»?', answer: 'Реквизиты клиента хранят сведения о контрагенте и используются в документах с ним. «Мои реквизиты» — данные вашей собственной организации для документов. Для удаления компании-клиента работайте с разделом «Компании»; переход в «Мои реквизиты» решает другую задачу.' },
  { question: 'Можно ли удалять компании через TrueTell Cleaner?', answer: 'Приложение TrueTell «Массовое удаление лидов и сделок» предназначено для лидов и сделок. Удаление компаний через Cleaner в этой инструкции не заявляется: компании удаляются штатными средствами Битрикс24.' },
];
const relatedArticles = getRelatedArticles(article.hrefPath)
  .map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const structuredData = createArticleStructuredData({
  articleType: 'Article', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  articleSection: 'Компании и клиентская база Битрикс24',
  breadcrumbs: [
    { name: 'Главная', item: siteRoot.toString() },
    { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() },
    { name: title, item: articleUrl },
  ], faqItems,
});
---

<ArticleLayout {title} {titleParts} {description} {canonicalPath} {structuredData}
  ogTitle={article.seoTitle} ogDescription={description} {ogImage} ogImageAlt={imageAlt}
  category={article.category} author={authorName}
  intro="Как убрать ненужную организацию из CRM: проверить контакты представителей, сделки и реквизиты, удалить одну карточку или выбранный список и найти запись в корзине.">
  <Fragment slot="quick-answer">
    <p>Перейдите в <strong>CRM → Клиенты → Компании</strong>. Для одной организации выберите «Удалить» в меню строки или настройках карточки. Для нескольких — задайте фильтр, отметьте строки и выберите удаление. Опция <strong>«Для всех»</strong> включает остальные страницы списка.</p>
    <p>До операции проверьте, нет ли дубля, какие контакты и сделки связаны с компанией и какие реквизиты нужны для документов. Потребуются права на удаление компаний; возможность восстановления зависит от настроек корзины и тарифа.</p>
  </Fragment>

  <p data-article-lead>В карточке организации могут сходиться работа нескольких менеджеров, контакты директора и бухгалтера, сделки и данные для договоров. Поэтому ненужное название в списке ещё не повод сразу удалять компанию. Сначала определите, что нужно убрать: повторную карточку, ошибку в реквизитах или саму организацию из рабочей базы.</p>

  <section aria-labelledby="company-decision">
    <h2 id="company-decision">Удалить компанию <span data-heading-accent>или объединить дубль</span></h2>
    <p>Две похожие записи могут относиться к одной организации, а могут представлять разных контрагентов. Сравните реквизиты, назначение карточек и историю работы. Совпадение названия или общего телефона само по себе не определяет, какую запись можно удалить.</p>
    <DataTable label="Как выбрать действие с карточкой компании" columns={['Ситуация', 'Что сделать', 'Что проверить']} rows={decisions} rowHeaders />
    <p>Если это подтверждённый дубль, используйте <a href={sourceLinks[6].href} target="_blank" rel="noopener noreferrer">штатное объединение</a>: выберите основную карточку и сохраняемые значения полей. Для него нужны права на изменение и удаление. Простое удаление лишней записи не заменяет выбор нужных данных при объединении.</p>
  </section>

  <section aria-labelledby="company-links">
    <h2 id="company-links">Что будет <span data-heading-accent>с контактами и сделками</span></h2>
    <p>Одна компания может быть связана с несколькими контактами, а один контакт — с несколькими компаниями. В сделке указывают только одну компанию, при этом контактов может быть несколько. Перед очисткой откройте карточку организации, посмотрите её контакты, сделки и вкладку <strong>«Связи»</strong>.</p>
    <ArticleFigure src={linksImage} fullSize alt={imageAlt}
      caption="Подлинный скриншот Поддержки24: в карточке компании показаны сделка и контакт представителя. Названия, имена и сумма — демонстрационные данные официальной справки. Экран иллюстрирует проверку связей до удаления." />
    <p>Дополнительно откройте важные сделки и карточки представителей. В справке есть ограничение: у контакта с несколькими компаниями вкладка «Связи» показывает только последнюю добавленную компанию. Остальные проверяют в поле <strong>«Компания»</strong> и на вкладке <strong>«История»</strong>. Если в сделке несколько контактов, на вкладке «Связи» также показан только последний. Всех участников проверяют в поле <strong>«Контакт»</strong> и на вкладке «История».</p>
    <p>В <a href={sourceLinks[3].href} target="_blank" rel="noopener noreferrer">описании действия «Удалить компанию» в бизнес-процессе</a> Битрикс24 прямо указывает: связанные сделки, контакты и задачи остаются, но теряют связь с компанией. Это описание конкретного штатного действия. Если удаление запускает приложение, робот или ваша интеграция, отдельно проверьте весь сценарий и дополнительные действия.</p>
    <p>Зафиксируйте ID компании и ссылки на важные карточки. Если работа с клиентом продолжается в другой карточке той же организации, согласуйте объединение или изменение связей до удаления. По отдельной задаче очистки сделок используйте <a href={`${base}udalenie-proigrannyh-sdelok-bitrix24/`}>инструкцию об удалении проигранных сделок</a>.</p>
  </section>

  <section aria-labelledby="company-requisites">
    <h2 id="company-requisites">Как проверить <span data-heading-accent>реквизиты и экспорт</span></h2>
    <p>В карточке клиента нажмите <strong>«Подробно»</strong> у поля «Реквизиты». Сверьте ИНН, КПП, адрес и банковские данные, которые нужны вашей работе. Если проблема только в устаревшем счёте или адресе, исправьте соответствующие сведения. Для этого не требуется удалять организацию целиком.</p>
    <p>Раздел <strong>«Мои реквизиты»</strong> хранит данные вашей собственной компании, подставляемые в документы. Очистка списка контрагентов — другая задача. Также не меняйте общий шаблон реквизитов ради исправления одного клиента: шаблон определяет набор полей, а значения проверяют в конкретной карточке.</p>
    <p>Перед удалением сохраните согласованный список компаний и нужные данные. В разделе компаний экспорт доступен через настройки списка при наличии права на экспорт. Проверьте ограничения своего тарифа, затем откройте полученный файл: есть ли нужные ID, поля и реквизиты. Не предполагайте, что выгрузка автоматически содержит всё необходимое для обратного переноса.</p>
    <p>Возврат таблицы в CRM не следует считать полным восстановлением связей, документов и истории. Если потребуется повторный импорт реквизитов, у Битрикс24 есть <a href="https://helpdesk.bitrix24.ru/open/25553660/" target="_blank" rel="noopener noreferrer">отдельная процедура импорта компаний с реквизитами</a>. Её условия стоит проверить до очистки.</p>
    <InlineConsultation title="Нужно разобрать клиентскую базу перед удалением?" description="Обсудим дубли организаций, связи с рабочими сделками и состав данных, которые нужно сохранить." />
  </section>

  <p>Если нужно убрать карточку представителя, используйте <a href={`${base}udalenie-kontaktov-bitrix24/`}>инструкцию по удалению контактов</a>. Удаление организации и удаление человека из клиентской базы — отдельные действия.</p>

  <section aria-labelledby="company-delete">
    <h2 id="company-delete">Как удалить <span data-heading-accent>одну компанию или список</span></h2>
    <p>Для одной записи откройте CRM → Клиенты → Компании, найдите организацию и сверьте её ID и реквизиты. В меню строки выберите <strong>«Удалить»</strong>. Из открытой карточки элемент также можно удалить через <strong>Настройки → Удалить</strong>. Расположение значков может различаться в интерфейсе портала.</p>
    <p>Для массового удаления сначала задайте границы выборки. Например, фильтр по типу компании и ответственному помогает найти нужную группу. Сам по себе такой отбор ещё не подтверждает, что все найденные организации можно убрать.</p>
    <ArticleFigure src={filterImage} fullSize
      alt="Фильтр списка компаний Битрикс24 с условиями Ответственный и Тип компании перед проверкой выборки"
      caption="Официальный демонстрационный экран: компании отбирают по ответственному и типу «Поставщик». Это пример настройки фильтра, а не рекомендация удалить поставщиков. Критерии и найденные записи проверяют на своём портале." />
    <Checklist label="Порядок массового удаления компаний" items={bulkSteps} />
    <p><strong>«Для всех» расширяет выбор за пределы видимой страницы.</strong> После изменения фильтра заново проверьте результат. Если кнопки нет или операция отклонена, попросите администратора проверить право на удаление именно компаний и доступ сотрудника к выбранным записям.</p>
    <p>Приложение <a href={`${base}bitrix24-cleaner/`}>TrueTell «Массовое удаление лидов и сделок»</a> работает с лидами и сделками. Компании удаляйте штатными средствами CRM.</p>
  </section>

  <section aria-labelledby="company-restore">
    <h2 id="company-restore">Как найти компанию <span data-heading-accent>в корзине</span></h2>
    <p>До удаления проверьте настройку хранения компаний: <strong>CRM → Ещё → Настройки → Настройки CRM → Другое → Прочие настройки → Корзина</strong>. Для компаний есть отдельный переключатель. Если он выключен, рассчитывать на помещение карточки в корзину нельзя.</p>
    <ArticleFigure src={recycleImage} fullSize
      alt="Настройки корзины CRM Битрикс24: отдельная включённая опция Включить корзину для компаний"
      caption="Подлинный скриншот Поддержки24: отдельная настройка корзины для компаний. Галочка на учебном экране не подтверждает настройку вашего портала. Доступность восстановления дополнительно зависит от тарифа." />
    <p>Если компанию удалили ошибочно, откройте <strong>CRM → Ещё → Корзина</strong>. Задайте тип «Компания», время удаления и при необходимости пользователя или ID. Администратор Битрикс24 видит все удалённые элементы, остальные сотрудники — только удалённые ими.</p>
    <p>Найдя запись, выберите <strong>Меню → Восстановить</strong>, если действие доступно на вашем тарифе. У восстановленного элемента меняется ID. Откройте новую карточку и проверьте реквизиты, нужные связи и внешние сопоставления: старая ссылка уже не подойдёт.</p>
    <p>Справка указывает хранение до 30 дней, затем автоматическое удаление по 100 элементов в день. Большая очередь может увеличить фактический срок, но планировать восстановление за его пределами не стоит. Окончательно удалить запись из корзины может администратор Битрикс24; после этого через корзину её не вернуть.</p>
  </section>

  <FaqSection variant="article" items={faqItems} />
  <ArticleSources sources={sourceLinks} publishedIso={article.publishedAt} modifiedIso={article.updatedAt} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Подготовьте ' }, { text: 'очистку клиентской базы', accent: true }]}
      description="Разберём, какие компании удалить, какие дубли объединить и что проверить в реквизитах и рабочих связях."
      href={companyInfo.contacts.consultationUrl} actionLabel="Обсудить задачу" />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <ConsultationCtaSection slot="after-article" />
</ArticleLayout>
