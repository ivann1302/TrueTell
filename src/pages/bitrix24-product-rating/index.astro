---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppHeader from '../../components/header/header.astro';
import SiteFooter from '../../components/footer/site-footer.astro';
import ProductSummary from '../../components/product-summary/product-summary.astro';
import ProductScenario from '../../components/product-scenario/product-scenario.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ProductArticles from '../../components/editorial/product-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import LineWave from '../../components/ui/line-wave.astro';
import ActionIcon from '../../components/product-scenario/action-icon.astro';
import { companyInfo } from '../../config/company';
import { productRating as product, productRatingPath } from '../../config/products';
import screenshot from '../../images/products/product-rating/products.png';
import heroStyles from '../../styles/product-hero.module.scss';
import closingStyles from '../../styles/product-closing.module.scss';
import layout from '../../styles/product-panels.module.scss';
import styles from './page.module.scss';

const title = `${product.heading} — ${companyInfo.brandName}`;
const description = 'Рейтинг товаров и клиентов в Битрикс24: сравнение продаж, ABC-анализ, история покупок и Excel. Найдите лидеров и проверьте результат по сделкам.';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, Astro.site ?? 'https://truetell-retail.ru');
const pageUrl = new URL(productRatingPath.slice(1), siteRoot).href;
const imageUrl = new URL(screenshot.src, siteRoot).href;
const imageAlt = `Интерфейс приложения «${product.name}» на тестовых данных: рейтинг товаров, доля продаж, ABC-класс и месячная динамика выбранного товара`;
const useCases = [
  ['Определить лидеров продаж', 'Увидеть, какие товары и клиенты дают наибольшую сумму продаж.'],
  ['Разобраться в изменениях', 'Найти товары и покупателей, у которых продажи выросли или снизились.'],
  ['Вернуться к клиентам', 'Выделить повторных покупателей и клиентов, которые давно ничего не покупали.'],
];
const features = [
  ['Рейтинг товаров', 'Сравнивайте товары по сумме продаж, количеству и числу сделок. Доля в общем результате помогает увидеть, какие позиции дают основной вклад.', 'price'],
  ['Рейтинг клиентов', 'Смотрите сумму и количество покупок, средний, минимальный и максимальный чек. Находите покупателей, с которыми стоит развивать отношения.', 'review'],
  ['Сравнение периодов', 'Сравнивайте продажи с прошлым годом, предыдущим периодом или выбранными датами. Видны изменения в деньгах и процентах, а также новые продажи.', 'report'],
  ['ABC-анализ', 'Группы A, B и C помогают выделить товары и клиентов, которые формируют основную часть суммы продаж, и расставить приоритеты.', 'report'],
  ['Динамика на графике', 'Посмотрите продажи по месяцам в целом или для выбранного товара и клиента. График помогает заметить изменения и сезонные колебания.', 'report'],
  ['Детализация до сделки', 'Откройте сделки, из которых сложился показатель, и перейдите к их карточкам в CRM. Для товара можно посмотреть его количество и сумму в каждой сделке.', 'review'],
  ['Товары и покупатели', 'Узнайте, кто покупал конкретный товар и что приобретал выбранный клиент. Из связанных списков можно перейти к сделкам или скачать отчёт.', 'price'],
  ['История покупок', 'Смотрите даты первой и последней покупки, количество покупок и дни без покупок. Отберите клиентов с одной покупкой, повторных покупателей или тех, кто давно не возвращался.', 'review'],
  ['Периоды и фильтры', 'Выбирайте год, месяц, квартал или свои даты в пределах одного года. Уточняйте отчёт по менеджерам и валюте, исключайте ненужные направления, источники и разделы товаров. Поиск помогает быстро найти нужную строку.', 'filter'],
  ['Excel и CSV', 'Скачивайте рейтинг, сделки и параметры отчёта для дальнейшей работы. В файл попадает весь найденный результат, а не только строки на текущей странице.', 'report'],
] as const;
const faqItems = [
  { question: 'Как подключить «Рейтинг продаж»?', answer: 'Приложение проходит финальную проверку перед запуском. Оставьте заявку: обсудим вашу задачу, возможности портала и условия подключения.' },
  { question: 'Какие продажи учитываются?', answer: 'Отчёт строится по сделкам облачного Битрикс24. По умолчанию учитываются успешные сделки за выбранный период по дате завершения. Можно выбрать дату создания, нужных менеджеров и другие условия отчёта.' },
  { question: 'Можно ли узнать, кто давно не покупал?', answer: 'Да. В клиентской базе видны последняя покупка и число дней без покупок. Укажите нужный срок, чтобы найти клиентов для повторного обращения. История включает покупки и за пределами периода основного рейтинга.' },
  { question: 'Можно ли проверить цифры в отчёте?', answer: 'Да. У товара или клиента можно открыть список исходных сделок и перейти к их карточкам в CRM. В Excel также доступны рейтинг, сделки, параметры отчёта и товары в сделках.' },
  { question: 'Сумма продаж — это полученная оплата?', answer: 'Успешная сделка в CRM не подтверждает оплату. Сумма товаров и полная сумма сделки показываются отдельно и могут различаться. Прибыль и бухгалтерская выручка в этом приложении не рассчитываются.' },
  { question: 'Как учитываются компании и контакты?', answer: 'Покупателем считается компания, указанная в сделке. Если её нет — основной контакт. Сделки без покупателя показываются отдельно. Одна сделка не увеличивает продажи сразу нескольких клиентов.' },
  { question: 'Можно ли объединить разные валюты?', answer: 'Денежные показатели рассчитываются в выбранной валюте. Автоматического пересчёта валют нет. Количество товаров суммируется в одинаковых единицах измерения.' },
  { question: 'Изменяет ли приложение данные CRM?', answer: 'Нет. Приложение читает данные для анализа и не изменяет сделки, товары или клиентов. Для отчёта используются сделки, доступные пользователю в Битрикс24.' },
  { question: 'Подходит ли приложение для анализа остатков и маржи?', answer: 'Приложение предназначено для анализа товаров и клиентов по CRM-сделкам. Складские остатки, закупки, маржа и прогнозирование в него не входят.' },
];
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebPage', '@id': `${pageUrl}#webpage`, url: pageUrl, name: title, description, inLanguage: 'ru-RU', breadcrumb: { '@id': `${pageUrl}#breadcrumbs` } },
    { '@type': 'BreadcrumbList', '@id': `${pageUrl}#breadcrumbs`, itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: siteRoot.href },
      { '@type': 'ListItem', position: 2, name: 'Продукты', item: new URL('products/', siteRoot).href },
      { '@type': 'ListItem', position: 3, name: product.heading, item: pageUrl },
    ] },
    { '@type': 'FAQPage', '@id': `${pageUrl}#faq`, mainEntity: faqItems.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) },
  ],
};
---

<BaseLayout contentType="commercial" contentCategory="Битрикс24" {title} {description} {structuredData} canonicalPath={productRatingPath} ogImage={imageUrl} ogImageAlt={imageAlt}>
  <AppHeader />
  <main class:list={['site-content', styles.page, heroStyles.productPage, closingStyles.flushFooter]}>
    <div class={styles.container}>
      <header class:list={[heroStyles.hero, heroStyles.heroWave]}>
        <LineWave centerOnMobile />
        <div class={heroStyles.heroCopy}>
          <h1>{product.heading}</h1>
          <p class={heroStyles.heroDescription}>Узнайте, какие товары продаются лучше, кто покупает больше и как меняются продажи. Проверьте любой результат по исходным сделкам.</p>
        </div>
        <div class={heroStyles.heroActions}>
          <a class={styles.button} href={companyInfo.contacts.consultationUrl}>{product.connectionActionLabel}</a>
        </div>
      </header>

      <ProductSummary description={`Приложение «${product.name}» поможет находить лидеров продаж и клиентов для повторного обращения. Выберите период и условия, сравните результаты и откройте сделки, чтобы разобраться в цифрах.`}>
        <span slot="title">Чтобы видеть, <strong>что продаётся и кто покупает</strong></span>
      </ProductSummary>

      <ProductScenario id="rating-scenario-title" title="Найти товары с наибольшим вкладом в продажи"
        description="Выберите период, посмотрите вклад каждого товара и откройте сделки, чтобы понять, из чего сложились продажи."
        steps={[
          { icon: 'filter', title: 'Задать выборку', text: 'Выбрать период и нужную область продаж.' },
          { icon: 'review', title: 'Сравнить товары', text: 'Посмотреть сумму, долю и изменение к выбранному периоду.' },
          { icon: 'report', title: 'Проверить результат', text: 'Выбрать товар и открыть сделки, вошедшие в расчёт.' },
        ]}>
        <ArticleFigure src={screenshot} fullSize alt={imageAlt} caption="Настоящий интерфейс приложения на тестовых данных. Значения иллюстрируют работу рейтинга." />
      </ProductScenario>

      <section class:list={[styles.useCases, layout.textPanel]} aria-labelledby="use-cases-title">
        <h2 id="use-cases-title">Когда нужен рейтинг продаж</h2>
        <dl class={styles.descriptionList}>
          {useCases.map(([heading, text]) => <div><dt>{heading}</dt><dd>{text}</dd></div>)}
        </dl>
      </section>

      <section class:list={[styles.features, layout.features, layout.textPanel]} aria-labelledby="features-title">
        <h2 id="features-title">Что поможет разобраться в продажах</h2>
        <p class={styles.sectionLead}>От лидеров продаж и повторных покупателей до подробностей каждой сделки.</p>
        <dl class={layout.featureGrid}>
          {features.map(([heading, text, icon]) => <div><dt><ActionIcon name={icon} />{heading}</dt><dd>{text}</dd></div>)}
        </dl>
      </section>

      <section class={styles.boundaries} aria-labelledby="data-title">
        <h2 id="data-title">Понятная основа каждого показателя</h2>
        <div>
          <p>Успешная сделка отражает результат работы в CRM, но не подтверждает оплату. В рейтинге товаров видна сумма проданных позиций, а в рейтинге клиентов — полная сумма их сделок. Эти показатели могут отличаться.</p>
          <p>Приложение анализирует данные без изменения CRM. В блоке «Что учтено в отчёте» можно проверить период, условия и общие итоги до поиска.</p>
        </div>
      </section>

      <div class={styles.faq}>
        <FaqSection items={faqItems} title="Вопросы о приложении" id="product-rating-faq" variant="article" />
      </div>
    </div>
    <ProductArticles productPath={productRatingPath} />
  </main>
  <div class={closingStyles.closingSurface}>
    <LineWave />
    <div class={styles.container}>
      <section class:list={[styles.connection, closingStyles.connectionDark]} aria-labelledby="connection-title">
        <h2 id="connection-title">Обсудим анализ продаж в вашем Битрикс24</h2>
        <div>
          <p>Приложение «{product.name}» проходит финальную проверку перед запуском. Расскажите, что хотите узнать о продажах и клиентах — обсудим, как использовать отчёт в вашей работе и какие условия нужны для подключения.</p>
          <a class={styles.button} href={companyInfo.contacts.consultationUrl}>{product.connectionActionLabel}</a>
        </div>
      </section>
    </div>
    <SiteFooter transparent hideDivider />
  </div>
</BaseLayout>
