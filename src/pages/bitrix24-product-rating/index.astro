---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppHeader from '../../components/header/header.astro';
import SiteFooter from '../../components/footer/site-footer.astro';
import ProductSummary from '../../components/product-summary/product-summary.astro';
import ProductScenario from '../../components/product-scenario/product-scenario.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import { companyInfo } from '../../config/company';
import { productRating as product, productRatingPath } from '../../config/products';
import screenshot from '../../images/products/product-rating/products.png';
import heroStyles from '../../styles/product-hero.module.scss';
import closingStyles from '../../styles/product-closing.module.scss';
import styles from './page.module.scss';

const title = `${product.heading} — ${companyInfo.brandName}`;
const description = product.description;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, Astro.site ?? 'https://truetell-retail.ru');
const pageUrl = new URL(productRatingPath.slice(1), siteRoot).href;
const imageUrl = new URL(screenshot.src, siteRoot).href;
const imageAlt = `Интерфейс приложения «${product.name}» на тестовых данных: рейтинг товаров, доля продаж, ABC-класс и месячная динамика выбранного товара`;
const features = [
  ['Рейтинг товаров', 'Сумма товарных строк, количество, доля продаж и число сделок. Товары и вариации с разными ID учитываются отдельно.'],
  ['Рейтинг клиентов', 'Сумма и число сделок, средний, минимальный и максимальный чек. Каждая сделка относится к одному покупателю, без повторного оборота по дополнительным контактам.'],
  ['Сравнение периодов', 'Месячный график и сравнение с аналогичным периодом прошлого года помогают увидеть рост и снижение продаж.'],
  ['ABC-анализ', 'Группы A, B и C показывают вклад товаров и клиентов в выбранную сумму. Для товаров база — сумма товарных строк, для клиентов — сумма сделок.'],
  ['Фильтры и поиск', 'Период, воронка, менеджер, источник и валюта задают область анализа. Текстовый поиск помогает найти строку, сохраняя исходную базу долей и ABC.'],
  ['Сделки и Excel', 'Расшифровка показывает, из каких сделок складывается результат. Выгрузка включает весь отфильтрованный рейтинг, а не только текущую страницу таблицы.'],
];
const faqItems = [
  { question: `Можно ли уже подключить приложение «${product.name}»?`, answer: 'Продукт готовится к запуску. Интерфейс и расчёты реализованы; проверка подключения, прав и работы на реальном портале ещё не завершена. Оставьте заявку, чтобы обсудить ваш сценарий и условия подключения.' },
  { question: 'По каким данным строится рейтинг?', answer: 'По проектной модели приложение анализирует сделки облачного Битрикс24, доступные текущему пользователю. По умолчанию учитываются успешные сделки за выбранный период по дате завершения. Изменение фильтров меняет область анализа.' },
  { question: 'Сумма продаж означает полученную оплату?', answer: 'Нет. Успешная сделка в CRM не подтверждает оплату. Сумма товарных строк и полная сумма сделки — разные показатели; они могут не совпадать. Приложение не рассчитывает бухгалтерскую выручку или прибыль.' },
  { question: 'Как определяется покупатель сделки?', answer: 'Сначала учитывается компания, иначе основной контакт. Сделки без покупателя попадают в группу «Клиент не указан». Дополнительные контакты не создают повторный оборот, а группа без покупателя исключается из ABC конкретных клиентов.' },
  { question: 'Можно ли складывать продажи в разных валютах?', answer: 'Общий денежный итог и ABC рассчитываются в выбранной валюте. Автоматическая конвертация разных валют в одну не входит в первую версию. Количество товаров суммируется только в одинаковых единицах измерения.' },
  { question: 'Будет ли приложение изменять CRM?', answer: 'Приложение спроектировано только для чтения и анализа. Расчёты выполняются в браузере пользователя; серверное хранение CRM-данных не предусмотрено. Проверка соблюдения прав на реальном портале входит в подготовку к запуску.' },
  { question: 'Есть ли анализ остатков, маржи или прогнозы?', answer: 'Нет. Первая версия посвящена товарам и клиентам по CRM-сделкам. Складские остатки, закупки, маржа, XYZ-анализ и прогнозирование в неё не входят.' },
];
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebPage', '@id': `${pageUrl}#webpage`, url: pageUrl, name: title, description, inLanguage: 'ru-RU', breadcrumb: { '@id': `${pageUrl}#breadcrumbs` } },
    { '@type': 'BreadcrumbList', '@id': `${pageUrl}#breadcrumbs`, itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: siteRoot.href },
      { '@type': 'ListItem', position: 2, name: 'Продукты', item: new URL('products/', siteRoot).href },
      { '@type': 'ListItem', position: 3, name: product.heading, item: pageUrl },
    ] },
    { '@type': 'FAQPage', '@id': `${pageUrl}#faq`, mainEntity: faqItems.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) },
  ],
};
---

<BaseLayout {title} {description} {structuredData} canonicalPath={productRatingPath} ogImage={imageUrl} ogImageAlt={imageAlt}>
  <AppHeader />
  <main class:list={['site-content', styles.page, heroStyles.productPage, closingStyles.flushFooter]}>
    <div class={styles.container}>
      <header class={heroStyles.hero}>
        <div class={heroStyles.heroCopy}>
          <h1>{product.heading}</h1>
          <p class={heroStyles.heroDescription}>Какие товары дают больше продаж и какие клиенты покупают чаще — с динамикой и расшифровкой до сделок.</p>
        </div>
        <div class={heroStyles.heroActions}>
          <a class={styles.button} href={companyInfo.contacts.consultationUrl}>{product.connectionActionLabel}</a>
        </div>
      </header>

      <ProductSummary description={`Приложение «${product.name}» поможет сравнивать товары и клиентов по сделкам Битрикс24 за выбранный период. Вы сможете найти лидеров, посмотреть динамику и открыть сделки, из которых сложился результат.`}>
        <span slot="title">Чтобы видеть, <strong>что продаётся и кто покупает</strong></span>
      </ProductSummary>

      <ProductScenario id="rating-scenario-title" title="Найти товары с наибольшим вкладом в продажи"
        description="В приложении можно будет выбрать период, сравнить товары по сумме продаж и проверить результат на уровне сделок."
        steps={[
          { icon: 'filter', title: 'Задать выборку', text: 'Выбрать период и нужную область продаж.' },
          { icon: 'review', title: 'Сравнить товары', text: 'Посмотреть сумму, долю и изменение к прошлому году.' },
          { icon: 'report', title: 'Проверить результат', text: 'Выбрать товар и открыть сделки, вошедшие в расчёт.' },
        ]}>
        <ArticleFigure src={screenshot} fullSize alt={imageAlt} caption="Настоящий интерфейс приложения на тестовых данных. Значения иллюстрируют работу рейтинга." />
      </ProductScenario>

      <section class={styles.features} aria-labelledby="features-title">
        <h2 id="features-title">Что предусмотрено в приложении</h2>
        <p class={styles.sectionLead}>Товары и клиенты в одном отчёте, от общей картины до конкретной сделки.</p>
        <dl class={styles.featureList}>
          {features.map(([heading, text]) => <div><dt>{heading}</dt><dd>{text}</dd></div>)}
        </dl>
      </section>

      <section class={styles.boundaries} aria-labelledby="data-title">
        <h2 id="data-title">Понятная основа каждого показателя</h2>
        <div>
          <p>Успешная сделка отражает результат работы в CRM, но не подтверждает оплату. Сумма товаров считается по товарным строкам, а сумма сделок — по полным суммам уникальных сделок.</p>
          <p>Приложение спроектировано для анализа без изменения CRM. Оно должно учитывать права текущего пользователя и показывать только доступные ему данные.</p>
        </div>
      </section>

      <div class={styles.faq}>
        <FaqSection items={faqItems} title="Вопросы о приложении" id="product-rating-faq" variant="article" />
      </div>
    </div>
  </main>
  <div class={closingStyles.closingSurface}>
    <div class={styles.container}>
      <section class:list={[styles.connection, closingStyles.connectionDark]} aria-labelledby="connection-title">
        <h2 id="connection-title">Обсудим анализ продаж в вашем Битрикс24</h2>
        <div>
          <p>Приложение «{product.name}» готовится к запуску. Расскажите, какие товары, клиенты и показатели вам важно сравнивать — обсудим сценарий и условия подключения.</p>
          <a class={styles.button} href={companyInfo.contacts.consultationUrl}>{product.connectionActionLabel}</a>
        </div>
      </section>
    </div>
    <SiteFooter transparent hideDivider />
  </div>
</BaseLayout>
