---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppHeader from '../../components/header/header.astro';
import SiteFooter from '../../components/footer/site-footer.astro';
import ProductSummary from '../../components/product-summary/product-summary.astro';
import ProductScenario from '../../components/product-scenario/product-scenario.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ProductArticles from '../../components/editorial/product-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import LineWave from '../../components/ui/line-wave.astro';
import ActionIcon from '../../components/product-scenario/action-icon.astro';
import { companyInfo } from '../../config/company';
import { productRating as product, productRatingPath } from '../../config/products';
import screenshot from '../../images/products/product-rating/rating-products-2026-10-renamed.jpg';
import buyersScreenshot from '../../images/products/product-rating/rating-product-buyers-2026-10.png';
import dealsScreenshot from '../../images/products/product-rating/rating-deal-contribution-2026-10.png';
import historyScreenshot from '../../images/products/product-rating/rating-customer-history-2026-10.png';
import heroStyles from '../../styles/product-hero.module.scss';
import closingStyles from '../../styles/product-closing.module.scss';
import layout from '../../styles/product-panels.module.scss';
import styles from './page.module.scss';

const heading = 'Рейтинг товаров и клиентов в Битрикс24';
const title = `${heading} — ${companyInfo.brandName}`;
const description = 'Рейтинг товаров и клиентов TrueTell для Битрикс24: товары, клиенты, ABC-анализ и сравнение периодов. Покупатели товара, история покупок, детализация сделок и Excel.';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, Astro.site ?? 'https://truetell-retail.ru');
const pageUrl = new URL(productRatingPath.slice(1), siteRoot).href;
const imageUrl = new URL(screenshot.src, siteRoot).href;
const imageAlt = `Интерфейс приложения «${product.name}» на тестовых данных: рейтинг товаров, ABC-класс, сравнение с прошлым годом и отдельные итоги товаров и сделок`;
const useCases = [
  ['Определить лидеров продаж', 'Увидеть, какие товары и клиенты дают наибольшую сумму продаж.'],
  ['Разобраться в изменениях', 'Найти товары и покупателей, у которых продажи выросли или снизились.'],
  ['Вернуться к клиентам', 'Выделить повторных покупателей и клиентов, которые давно ничего не покупали.'],
];
const features = [
  ['Рейтинг товаров', 'Сумма, количество, число сделок и доля каждого товара.', 'price'],
  ['Рейтинг клиентов', 'Покупки, сумма продаж и средний чек по каждому клиенту.', 'review'],
  ['Сравнение периодов', 'Изменения к прошлому году, предыдущему периоду или выбранным датам.', 'report'],
  ['ABC-анализ', 'Группы A, B и C по вкладу в сумму продаж.', 'report'],
  ['Динамика на графике', 'Продажи по месяцам: в целом, по товару или клиенту.', 'report'],
  ['Детализация до сделки', 'Исходные сделки с переходом к карточкам CRM.', 'review'],
  ['Товары и покупатели', 'Кто покупал товар и что приобретал клиент.', 'price'],
  ['История покупок', 'Первая и последняя покупка, повторы и дни без покупок.', 'review'],
  ['Периоды и фильтры', 'Даты в пределах одного года, менеджеры, валюта и условия отбора.', 'filter'],
  ['Excel и CSV', 'Весь найденный результат, сделки и параметры отчёта.', 'report'],
] as const;
const faqItems = [
  { question: 'Как подключить «Рейтинг товаров и клиентов»?', answer: 'Нажмите «Открыть в Маркете» и установите «Рейтинг товаров и клиентов» в облачный Битрикс24. Приложение доступно по подписке Битрикс24 Маркетплейс. Для установки нужны права администратора.' },
  { question: 'Это рейтинг менеджеров по продажам?', answer: 'Приложение строит рейтинги товаров и клиентов. Фильтр по менеджерам помогает ограничить выборку, но отдельный рейтинг сотрудников здесь не рассчитывается.' },
  { question: 'Какие продажи учитываются?', answer: 'Отчёт строится по сделкам облачного Битрикс24. По умолчанию учитываются успешные сделки за выбранный период по дате завершения. Можно выбрать дату создания, нужных менеджеров и другие условия отчёта.' },
  { question: 'Можно ли узнать, кто давно не покупал?', answer: 'Да. В клиентской базе видны последняя покупка и число дней без покупок. Укажите нужный срок, чтобы найти клиентов для повторного обращения. История включает покупки и за пределами периода основного рейтинга.' },
  { question: 'Можно ли проверить цифры в отчёте?', answer: 'Да. У товара или клиента можно открыть список исходных сделок и перейти к их карточкам в CRM. В Excel также доступны рейтинг, сделки, параметры отчёта и товары в сделках.' },
  { question: 'Сумма продаж — это полученная оплата?', answer: 'Успешная сделка в CRM не подтверждает оплату. Сумма товаров и полная сумма сделки показываются отдельно и могут различаться. Прибыль и бухгалтерская выручка в этом приложении не рассчитываются.' },
  { question: 'Как учитываются компании и контакты?', answer: 'Покупателем считается компания, указанная в сделке. Если её нет — основной контакт. Сделки без покупателя показываются отдельно. Одна сделка не увеличивает продажи сразу нескольких клиентов.' },
  { question: 'Можно ли объединить разные валюты?', answer: 'Денежные показатели рассчитываются в выбранной валюте. Автоматического пересчёта валют нет. Количество товаров суммируется в одинаковых единицах измерения.' },
  { question: 'Изменяет ли приложение данные CRM?', answer: 'Нет. Приложение читает данные для анализа и не изменяет сделки, товары или клиентов. Для отчёта используются сделки, доступные пользователю в Битрикс24.' },
  { question: 'Подходит ли приложение для анализа остатков и маржи?', answer: 'Приложение предназначено для анализа товаров и клиентов по CRM-сделкам. Складские остатки, закупки, маржа и прогнозирование в него не входят.' },
];
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebPage', '@id': `${pageUrl}#webpage`, url: pageUrl, name: title, description, inLanguage: 'ru-RU', breadcrumb: { '@id': `${pageUrl}#breadcrumbs` } },
    { '@type': 'BreadcrumbList', '@id': `${pageUrl}#breadcrumbs`, itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: siteRoot.href },
      { '@type': 'ListItem', position: 2, name: 'Продукты', item: new URL('products/', siteRoot).href },
      { '@type': 'ListItem', position: 3, name: heading, item: pageUrl },
    ] },
    { '@type': 'FAQPage', '@id': `${pageUrl}#faq`, mainEntity: faqItems.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) },
  ],
};
---

<BaseLayout contentType="commercial" contentCategory="Битрикс24" {title} {description} {structuredData} canonicalPath={productRatingPath} ogImage={imageUrl} ogImageAlt={imageAlt}>
  <AppHeader />
  <main class:list={['site-content', styles.page, heroStyles.productPage, closingStyles.flushFooter]}>
    <div class={styles.container}>
      <header class:list={[heroStyles.hero, heroStyles.heroWave]}>
        <LineWave centerOnMobile />
        <div class={heroStyles.heroCopy}>
          <h1>{heading}</h1>
          <p class={heroStyles.heroDescription} data-intro="description">Узнайте, какие товары продаются лучше, кто покупает больше и как меняются продажи. Проверьте любой результат по исходным сделкам.</p>
        </div>
        <div class={heroStyles.heroActions} data-intro="actions">
          <a class={styles.button} href={product.marketplaceUrl} target="_blank" rel="noopener noreferrer">{product.connectionActionLabel}</a>
        </div>
      </header>

      <ProductSummary description={`Приложение «${product.name}» поможет находить лидеров продаж и клиентов для повторного обращения. Выберите период и условия, сравните результаты и откройте сделки, чтобы разобраться в цифрах.`}>
        <span slot="title">Чтобы видеть, <strong>что продаётся и кто покупает</strong></span>
      </ProductSummary>
      <p class={styles.releaseNote}>Приложение опубликовано в Маркете Битрикс24. Доступ — по подписке Битрикс24 Маркетплейс.</p>

      <ProductScenario id="rating-scenario-title" title="Найти товары с наибольшим вкладом в продажи"
        description="Выберите период, посмотрите вклад каждого товара и откройте сделки, чтобы понять, из чего сложились продажи."
        steps={[
          { icon: 'filter', title: 'Задать выборку', text: 'Выбрать период и нужную область продаж.' },
          { icon: 'review', title: 'Сравнить товары', text: 'Посмотреть сумму, долю и изменение к выбранному периоду.' },
          { icon: 'report', title: 'Проверить результат', text: 'Выбрать товар и открыть сделки, вошедшие в расчёт.' },
        ]}>
        <ArticleFigure src={screenshot} fullSize alt={imageAlt} caption="Настоящий интерфейс текущей версии на синтетических данных: январь 2026 года, сумма товаров 14 500 ₽ и полная сумма сделок 15 000 ₽. Это пример работы отчёта, а не результаты клиента." />
      </ProductScenario>

      <ProductScenario id="buyers-scenario-title" title="Увидеть покупателей товара и проверить его вклад"
        description="От выбранного товара можно перейти к покупателям, затем к их сделкам. Обратный путь показывает, какие товары приобретал выбранный клиент."
        steps={[
          { icon: 'review', title: 'Найти нужного покупателя', text: 'Поиск и сортировка работают внутри связанного списка.' },
          { icon: 'price', title: 'Разделить две суммы', text: 'Вклад выбранного товара показывается отдельно от полной суммы сделки.' },
          { icon: 'report', title: 'Сохранить расшифровку', text: 'Связанный список можно выгрузить в Excel или CSV.' },
        ]}>
        <div class={styles.screenshotStack}>
          <ArticleFigure src={buyersScreenshot} fullSize alt="Покупатели товара «Насос»: Альфа — 3 500 рублей, Контакт Один — 1 000 рублей, общий вклад — 4 500 рублей" caption="Локальный тестовый пример: кто покупал выбранный товар в январе. Суммы относятся к этому товару, а не ко всем покупкам клиента." />
          <ArticleFigure src={dealsScreenshot} fullSize alt="Сделки покупателя Альфа: вклад товара 2 000 рублей при полной сумме сделки 10 000 рублей" caption="Тот же тестовый набор: в сделке 101 выбранный товар даёт 2 000 ₽ из полной суммы 10 000 ₽. Полную сумму нельзя складывать как вклад каждой товарной позиции." />
        </div>
      </ProductScenario>

      <ProductScenario id="history-scenario-title" title="Найти клиентов для повторного обращения"
        description="Клиентская база показывает доступную историю успешных сделок, включая покупки за пределами периода основного рейтинга."
        steps={[
          { icon: 'review', title: 'Посмотреть историю', text: 'Количество покупок, первая и последняя дата, число дней без покупок.' },
          { icon: 'filter', title: 'Выбрать сегмент', text: 'Одна покупка, повторные клиенты или отсутствие покупок дольше заданного срока.' },
          { icon: 'report', title: 'Подготовить список', text: 'Поиск, переход к клиенту в CRM и выгрузка найденного списка.' },
        ]}>
        <ArticleFigure src={historyScreenshot} fullSize alt="Клиентская база: первая и последняя покупка, количество покупок и дни без покупок по каждому клиенту" caption="Синтетические данные на 31 марта 2026 года. У клиента «Альфа» учтены четыре покупки, в том числе за пределами январского рейтинга. Покупка означает успешную сделку и не подтверждает оплату." />
      </ProductScenario>

      <section class:list={[styles.useCases, layout.textPanel]} aria-labelledby="use-cases-title">
        <h2 id="use-cases-title">Когда нужен рейтинг товаров и клиентов</h2>
        <dl class={styles.descriptionList}>
          {useCases.map(([heading, text]) => <div data-reveal><dt>{heading}</dt><dd>{text}</dd></div>)}
        </dl>
      </section>

      <section class:list={[styles.features, layout.features, layout.textPanel]} aria-labelledby="features-title">
        <h2 id="features-title">Что поможет разобраться в продажах</h2>
        <p class={styles.sectionLead}>От лидеров продаж и повторных покупателей до подробностей каждой сделки.</p>
        <dl class={layout.featureGrid}>
          {features.map(([heading, text, icon]) => <div data-reveal><dt><ActionIcon name={icon} />{heading}</dt><dd>{text}</dd></div>)}
        </dl>
      </section>

      <section class={styles.boundaries} aria-labelledby="data-title">
        <h2 id="data-title">Понятная основа каждого показателя</h2>
        <div>
          <p>Успешная сделка отражает результат работы в CRM, но не подтверждает оплату. В рейтинге товаров видна сумма проданных позиций, а в рейтинге клиентов — полная сумма их сделок. Эти показатели могут отличаться.</p>
          <p>Приложение анализирует данные без изменения CRM. В блоке «Что учтено в отчёте» можно проверить период, условия и общие итоги до поиска.</p>
        </div>
      </section>

      <div class={styles.faq}>
        <FaqSection items={faqItems} title="Вопросы о приложении" id="product-rating-faq" variant="article" />
      </div>
    </div>
    <ProductArticles productPath={productRatingPath} />
  </main>
  <div class={closingStyles.closingSurface}>
    <LineWave />
    <div class={styles.container}>
      <section class:list={[styles.connection, closingStyles.connectionDark]} aria-labelledby="connection-title">
        <h2 id="connection-title" data-reveal>Откройте рейтинг товаров и клиентов в Битрикс24</h2>
        <div data-reveal="1">
          <p>Установите «{product.name}» из Маркета Битрикс24 и начните анализ товаров и клиентов по доступным сделкам. Если нужна помощь с настройкой отчёта, <a href={companyInfo.contacts.consultationUrl}>обсудите задачу с нами</a>.</p>
          <p class={styles.legalLinks}><a href={`${base}bitrix24-product-rating-license/`}>Лицензионное соглашение</a> · <a href={`${base}bitrix24-product-rating-privacy/`}>Политика конфиденциальности приложения</a></p>
          <a class={styles.button} href={product.marketplaceUrl} target="_blank" rel="noopener noreferrer">{product.connectionActionLabel}</a>
        </div>
      </section>
    </div>
    <SiteFooter transparent hideDivider />
  </div>
</BaseLayout>
