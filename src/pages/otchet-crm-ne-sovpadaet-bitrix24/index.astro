---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { mcpProduct } from '../../config/products';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import reportImage from '../../images/articles/bitrix24-sales-report-native.png';
import stageImage from '../../images/articles/bitrix24-report-stage-history-132.png';

const article = getArticle('otchet-crm-ne-sovpadaet-bitrix24/');
const { title, description } = article;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const ogImage = new URL(reportImage.src, siteRoot).toString();
const imageAlt = 'Реальный тестовый отчёт Битрикс24 «Вклад в продажи» с видимым фильтром «Отчётный период»';
const faqItems = [
  { question: 'Почему в отчёте CRM больше сделок, чем в списке за тот же месяц?', answer: 'Проверьте название отчёта и оба фильтра. В CRM-аналитике «Отчётный период» может включать сделку, созданную раньше месяца, если она оставалась в работе или по ней была активность. Список с фильтром «Дата начала» отбирает по значению этого поля, которое может отличаться от даты создания. Сравните оба поля у одних и тех же ID.' },
  { question: 'Можно ли убрать скрытый «Отчётный период» из фильтра отчёта?', answer: 'Нет. По справке Битрикс24 он продолжает влиять на выборку, даже если поле скрыто. Для сверки по конкретной дате сначала задайте достаточно широкий отчётный период, затем проверьте поле даты в фильтре и карточке.' },
  { question: 'Дата начала сделки всегда равна дате создания?', answer: 'Нет. По умолчанию «Дата начала» совпадает с созданием сделки, но её может изменить робот. У регулярной сделки дата начала тоже может быть позже создания. Поле «Дата создания» заполняется автоматически и не меняется.' },
  { question: 'Почему сделка есть в успешной стадии воронки, а в списке она проиграна?', answer: 'Воронка CRM-аналитики учитывает прохождение стадий в истории. Список с фильтром «Группа стадий» показывает текущее состояние. Сделка могла пройти стадию успеха, а затем вернуться в работу или завершиться неуспешно. Факт прохождения успеха не равен текущему результату.' },
  { question: 'Могут ли руководитель и менеджер видеть разные числа в одном отчёте?', answer: 'Да. Видимость данных в отчётах CRM-аналитики зависит от прав на элементы CRM. Сравните пользователей, направление и фильтры, затем попросите администратора проверить чтение нужных сделок. Не расширяйте права только ради одинакового числа.' },
  { question: 'Почему сделка попала в соседний день отчёта?', answer: 'В официальной справке Битрикс24 указано, что аналитические системы получают даты в часовом поясе сервера UTC+3, а карточка показывает время в часовом поясе пользователя. Для сделки около полуночи сравните точное время и оба часовых пояса.' },
  { question: 'MCP TrueTell уже автоматически сводит отчёт со списком?', answer: 'Автоматическую сверку мы пока не заявляем. MCP TrueTell для настройки и диагностики CRM находится в разработке. Для обсуждения сценария подготовьте название отчёта, показатель, обезличенные ID контрольных сделок и правила доступа.' },
];
const sourceLinks = [
  { label: 'Битрикс24: отчётный период в CRM', href: 'https://helpdesk.bitrix24.ru/open/11162430/' },
  { label: 'Битрикс24: частые вопросы о CRM-аналитике и сквозной аналитике', href: 'https://helpdesk.bitrix24.ru/open/27273254/' },
  { label: 'Битрикс24: как работают фильтры в CRM', href: 'https://helpdesk.bitrix24.ru/open/24206616/' },
  { label: 'Битрикс24: отчёт по сделкам', href: 'https://helpdesk.bitrix24.ru/open/10519434/' },
  { label: 'Битрикс24: классическая и конверсионная воронки', href: 'https://helpdesk.bitrix24.ru/open/23203898/' },
  { label: 'Битрикс24: ролевая модель прав CRM', href: 'https://helpdesk.bitrix24.ru/open/23240636/' },
  { label: 'Битрикс24: системные поля CRM, дата создания и дата начала', href: 'https://helpdesk.bitrix24.ru/open/18478840/' },
  { label: 'Битрикс24: регулярные сделки и отложенная дата начала', href: 'https://helpdesk.bitrix24.ru/open/27203912/' },
  { label: 'Битрикс24: детализация чисел CRM-аналитики', href: 'https://helpdesk.bitrix24.ru/open/9673603/' },
];
const checkRows = [
  ['В отчёте больше сделок', 'Отчётный период CRM, дата начала и дата создания', 'Проверить ID созданной раньше, но активной сделки'],
  ['Воронка показывает успех, список — провал', 'История прохождения стадии и текущая группа стадий', 'Открыть историю одной сделки'],
  ['У коллег разные итоги', 'Один отчёт и фильтр под разными учётными записями', 'Сравнить право чтения на контрольные ID'],
  ['Разница на границе дня', 'Время карточки и часовой пояс аналитики', 'Сверить время сделки около полуночи'],
];
const structuredData = createArticleStructuredData({
  articleType: 'Article', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  breadcrumbs: [{ name: 'Главная', item: siteRoot.toString() }, { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() }, { name: title, item: articleUrl }],
  faqItems,
});
---
<ArticleLayout {title} titleParts={[{ text: 'Отчёт CRM не совпадает ' }, { text: 'со списком сделок Битрикс24', accent: true }]} {description}
  canonicalPath={`/${article.hrefPath}`} {structuredData} ogTitle={article.seoTitle} ogDescription={description}
  {ogImage} ogImageAlt={imageAlt} category={article.category} author={authorName}
  intro="В отчёте за месяц одна цифра, а в списке сделок другая. Чтобы найти причину, нужно сравнить не только даты, но и то, какие сделки считает каждый экран.">
  <Fragment slot="quick-answer">
    <p><strong>Запишите название отчёта и показателя, направление, период и пользователя. Затем найдите один ID сделки, который есть только в одной выборке.</strong> Для него сравните даты создания и начала, активность в отчётном периоде, текущую стадию и историю переходов.</p>
    <p>Проверьте скрытые фильтры и права. Если расхождение приходится на границу суток, сравните часовой пояс карточки и аналитики. Одинаковое слово «период» в разных видах отчётов Битрикс24 может означать разные правила отбора.</p>
  </Fragment>

  <p data-article-lead>По двум итоговым числам причину расхождения не определить. Найдите хотя бы один ID сделки, который попал в отчёт и отсутствует в списке, или наоборот. В карточке можно проверить обе даты, переходы по стадиям и доступ конкретного сотрудника.</p>

  <section aria-labelledby="same-comparison">
    <h2 id="same-comparison">Сначала проверьте, <span data-heading-accent>что именно сравниваете</span></h2>
    <p>Откройте нужный отчёт и запишите его точное название: «Отчёт по сделкам», «Воронка продаж», «Вклад в продажи», сквозная аналитика и BI-отчёт используют разные показатели. Уточните, сравниваете количество сделок или их сумму, одну воронку или все направления, одну группу стадий или весь список.</p>
    <p>На тестовом экране «Вклад в продажи» видны два активных условия, в том числе «Отчётный период». Если просто запомнить выбранный месяц и повторить его в списке, второго условия можно не заметить. Откройте фильтр отчёта и запишите все условия отбора до сверки.</p>
    <ArticleFigure src={reportImage} fullSize alt={imageAlt} caption="Подлинный экран отчёта «Вклад в продажи» с тестовой сделкой; имя сотрудника скрыто. Фильтры на снимке показывают, какие условия нужно выписать перед сверкой, но не доказывают причину расхождения в вашем портале." />
    <p>Нажмите на число или сумму в CRM-аналитике: доступный показатель открывает список соответствующих элементов. Выпишите ID нескольких сделок. Если на вашем экране детализация недоступна, используйте таблицу исходных записей отчёта или согласованную выгрузку по тем же условиям. В списке CRM сбросьте старый поиск, выберите ту же воронку и проверьте значения «Фильтр + поиск». Найдите ID, которые есть только в одной выборке, и разберите один из них.</p>
  </section>

  <section aria-labelledby="period-rule">
    <h2 id="period-rule">«Отчётный период» и <span data-heading-accent>дата начала — не одно условие</span></h2>
    <p>В CRM-аналитике Битрикс24 отчётный период включает сделки, созданные, изменённые или завершённые за выбранное время. В него могут попасть ранее закрытые сделки с новым делом и ещё открытые сделки. Поэтому февральская сделка, с которой работали в марте, может быть в мартовском отчёте, хотя фильтр списка «Дата начала: март» её не найдёт, если дата начала осталась февральской.</p>
    <p>«Дата начала» по умолчанию совпадает с датой создания сделки, но её может изменить робот. У регулярной сделки начало тоже может быть назначено позже создания. Сверьте оба поля в контрольной карточке: «Дата создания» заполняется автоматически и не меняется. Проверьте значение отчётного периода даже тогда, когда поле скрыто в фильтре отчёта: по официальной справке оно продолжает ограничивать выборку. Для проверки по конкретной дате сначала установите охватывающий отчётный период, затем добавьте нужный фильтр даты. Сохраните прежние условия рабочего отчёта перед изменением.</p>
    <p>У сквозной аналитики есть одноимённый фильтр «Отчётный период», но он отбирает сделки по дате создания. Перед сравнением убедитесь, какой именно раздел Битрикс24 открыт. Если это BI-отчёт, отдельно выясните, по какому полю даты построен его фильтр; маршрут ниже относится к CRM-аналитике и списку сделок.</p>
  </section>

  <section aria-labelledby="stage-history">
    <h2 id="stage-history">Воронка учитывает <span data-heading-accent>историю стадий</span></h2>
    <p>Строка списка со стадией «Провалена» показывает текущее состояние. Воронка CRM-аналитики отвечает на другой вопрос: проходила ли сделка определённый этап. Если карточка побывала в «Успехе», а затем её вернули в работу или закрыли неуспешно, факт прохождения успешной стадии остаётся в истории воронки. Это не делает текущую сделку выигранной.</p>
    <ArticleFigure src={stageImage} fullSize alt="Учебная последовательность стадий сделки: в работе, успех, возврат в работу, провал; воронка показывает историю, список — текущую стадию" caption="Редакционный пример без реальных клиентских данных. По справке Битрикс24 воронка учитывает путь сделки, а фильтр списка «Группа стадий» — текущее состояние." />
    <p>В списке Битрикс24 различаются фильтры «Группа стадий» и «Группа стадий по истории». Первый ищет текущее состояние, второй — группы, через которые сделка уже проходила. Классическая и конверсионная воронки тоже по-разному учитывают пропущенные этапы. Поэтому для сверки запишите вид воронки и откройте историю контрольной карточки.</p>
  </section>

  <section aria-labelledby="access-time">
    <h2 id="access-time">Проверьте <span data-heading-accent>права и границу суток</span></h2>
    <p>Один и тот же отчёт может показать менеджеру и руководителю разные итоги. Видимость данных CRM-аналитики зависит от прав на сделки: сотрудник с доступом только к своим карточкам не увидит записи всей команды. Сначала сравните выборки под одним пользователем, затем попросите администратора проверить право чтения на конкретные ID. Не выдавайте доступ ко всем сделкам ради совпадения отчёта.</p>
    <p>Если отличается дата одной сделки около полуночи, сверьте точное время события. Битрикс24 передаёт даты в аналитические системы по часовому поясу сервера UTC+3, а в карточке показывает время с учётом часового пояса пользователя. Это может сдвинуть запись на соседний день. Для дневной сверки запишите обе временные зоны и границы фильтра.</p>
    <DataTable label="Причина расхождения отчёта и списка сделок" columns={['Признак', 'Что сравнить', 'Контрольная проверка']} rows={checkRows} rowHeaders />
  </section>

  <section aria-labelledby="record-result">
    <h2 id="record-result">Сохраните правило сверки <span data-heading-accent>для следующего отчёта</span></h2>
    <p>Зафиксируйте название отчёта, показатель, воронку, период, пользователя и ID контрольных сделок. Для каждого расхождения запишите конкретную причину: дата начала, история стадии, право чтения или часовой пояс. После изменения фильтра снова проверьте те же ID и итог. Если причина осталась неясной, передайте список расхождений администратору или поддержке вместе с названиями экранов и настройками выборки.</p>
    <p>Если вы только выбираете отчёт для руководителя, начните с <a href={`${base}otchety-po-prodazham-bitrix24/`}>обзора штатных отчётов по продажам</a>. Для первого отчёта из CRM в BI Конструкторе есть <a href={`${base}bi-analitika-bitrix24-pervyy-otchet/`}>отдельная инструкция</a>.</p>
    <p>MCP TrueTell для настройки и диагностики CRM находится в разработке. Автоматическую сверку отчётов со списком сделок мы пока не заявляем. Для обсуждения повторяемой проверки нужны обезличенные ID, названия показателей и согласованный уровень доступа к CRM. Данные клиентов и содержимое сделок в форму отправлять не нужно.</p>
    <InlineConsultation variant="product" title="Отчёт снова расходится со списком?" description="Опишите вид отчёта, показатель и расхождение без данных клиентов. Поможем составить контрольную выборку и обсудить сценарий регулярной диагностики CRM." href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
  </section>

  <FaqSection title="Частые вопросы о сверке отчёта CRM" items={faqItems} variant="article" />
  <p>Официальная справка Битрикс24 проверена 31 октября 2026 года. Числа и фильтры клиентского портала не проверялись; доступность функций зависит от тарифа и прав.</p>
  <ArticleSources publishedIso={article.publishedAt} modifiedIso={article.updatedAt} sources={sourceLinks} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Обсудим ' }, { text: 'диагностику CRM с MCP TrueTell', accent: true }]} description={mcpProduct.articleDescription} href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <ConsultationCtaSection slot="after-article" />
</ArticleLayout>
