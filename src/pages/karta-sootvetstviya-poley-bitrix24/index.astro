---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import { fieldDirectoryProduct } from '../../config/products';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import Checklist from '../../components/editorial/checklist.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import directoryImage from '../../images/articles/truetell-field-directory-filtered-live.jpg';
import mappingImage from '../../images/articles/bitrix24-field-value-mapping-demo.png';
const article = getArticle('karta-sootvetstviya-poley-bitrix24/');
const { title, description } = article;
const canonicalPath = `/${article.hrefPath}`;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const ogImage = new URL(directoryImage.src, siteRoot).toString();
const imageAlt = 'Справочник полей сделки: поиск CALC_COMP показывает три разных названия и технических кода для проверки перед сопоставлением';
const titleParts = [{ text: 'Карта соответствия полей ' }, { text: 'Битрикс24 для интеграции', accent: true }];
const sourceLinks = [
  { label: 'Описания полей crm.item.fields — REST API Битрикс24', href: 'https://apidocs.bitrix24.ru/api-reference/crm/universal/crm-item-fields.html' },
  { label: 'Обновление элемента crm.item.update — REST API Битрикс24', href: 'https://apidocs.bitrix24.ru/api-reference/crm/universal/crm-item-update.html' },
  { label: 'Типы данных и связи CRM — REST API Битрикс24', href: 'https://apidocs.bitrix24.ru/api-reference/crm/data-types.html' },
  { label: 'Пользовательские поля в CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/22048980/' },
  { label: 'Конфигурация пользовательского поля сделки — REST API Битрикс24', href: 'https://apidocs.bitrix24.ru/api-reference/crm/deals/user-defined-fields/crm-deal-userfield-get.html' },
];
const example = [
  ['Назначение', 'Показывать менеджеру статус доставки; не менять стадию продажи'],
  ['Источник', 'Условная ERP, заказ, поле delivery_status; техническое имя учебное'],
  ['Приёмник', 'Битрикс24, сделка, пользовательское поле «Статус доставки»; точный код получают на портале'],
  ['Связь записей', 'Внешний ID заказа сопоставлен с ID сделки; равенство чисел не считается связью'],
  ['Владелец и направление', 'В этом примере ERP определяет статус, обмен идёт в CRM; обратная запись не предусмотрена'],
  ['Тип и количество значений', 'Код в источнике, одиночный список в CRM; соответствия вариантов согласованы отдельно'],
  ['Событие и срок', 'Изменение статуса доставки; допустимую задержку и способ повторной обработки согласуют до разработки'],
];
const faqItems = [
  { question: 'Что такое карта соответствия полей Битрикс24?', answer: 'Это рабочее описание того, откуда берётся значение, в какую сущность и поле CRM оно передаётся и по каким правилам. Кроме кодов в ней фиксируют смысл, направление обмена, типы, пустые значения, связь записей и критерии проверки.' },
  { question: 'Достаточно ли сопоставить одинаковые названия полей?', answer: 'Нет. Похожая подпись может означать разные данные, например плановую и фактическую дату. Нужно проверить сущность, полный технический код, тип и назначение обоих полей.' },
  { question: 'CSV справочника уже является готовой картой интеграции?', answer: 'Нет. Это каталог метаданных выбранной сущности с текущими фильтрами. Он помогает получить названия, коды и свойства, а правила обмена, значения списков и связи записей согласуют отдельно.' },
  { question: 'Можно ли связывать клиента по одинаковому ID в двух системах?', answer: 'Совпадение чисел не подтверждает соответствие. Нужны правило поиска и сохранённая связь внешнего объекта с правильной записью CRM. Для привязки передают идентификатор нужной сущности по требованиям конкретного метода.' },
  { question: 'Пустое значение источника должно очищать поле CRM?', answer: 'Это нужно согласовать отдельно. Отсутствие ключа, null, пустая строка и намеренное очищение не считаются одним случаем. Способ очистки зависит от типа поля и REST-метода; универсального правила для всех полей здесь нет.' },
  { question: 'Когда карту можно передавать разработчику?', answer: 'Когда понятны источник и приёмник, зафиксированы точные коды, направление и владелец данных, правила преобразования и обработки ошибок, а нормальные и пограничные примеры имеют ожидаемый результат. Неуточнённые пункты должны оставаться явно открытыми.' },
];
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const structuredData = createArticleStructuredData({
  articleType: 'BlogPosting', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  articleSection: article.category,
  breadcrumbs: [{ name: 'Главная', item: siteRoot.toString() }, { name: 'Блог', item: new URL('blog/', siteRoot).toString() }, { name: title, item: articleUrl }], faqItems,
});
---
<ArticleLayout {title} {titleParts} {description} {canonicalPath} category={article.category}
  intro="Что согласовать между владельцем процесса и интегратором: смысл данных, точные поля, направление обмена, пустые значения и проверку результата."
  {structuredData} ogTitle={article.seoTitle ?? title} ogDescription={description} {ogImage} ogImageAlt={imageAlt} author={authorName}>
  <Fragment slot="quick-answer">
    <p>Карта соответствия связывает <strong>источник, сущность и поле приёмника</strong> с правилами передачи значения. Одних названий и кодов недостаточно: нужно определить владельца данных, направление, преобразования и ожидаемый результат.</p>
    <p>Начните с одной понятной операции и нескольких учебных примеров. Каталог полей помогает заполнить техническую часть, но <strong>не создаёт готовую интеграцию</strong> и не определяет бизнес-правила автоматически.</p>
  </Fragment>
  <p data-article-lead>У двух систем может быть поле «Статус», а задачи у этих полей — разные. В одной системе это этап доставки, в другой — стадия продажи. Если связать их только по подписи, технически успешный обмен способен передать неверный смысл. Карта нужна, чтобы договориться о значении данных до написания кода.</p>
  <section aria-labelledby="start-with-purpose">
    <h2 id="start-with-purpose">Сначала согласуйте <span data-heading-accent>операцию и результат</span></h2>
    <p>Выберите конкретный сценарий: что изменилось в источнике и что после этого должен увидеть сотрудник в CRM. Например, менеджеру нужно знать, отгружен ли заказ. Это не означает, что статус доставки должен автоматически переводить сделку в успешную стадию.</p>
    <p>Определите участников: кто объясняет смысл поля, кто подтверждает технический источник и кто принимает результат. Если владельцы процесса ещё не решили, что считать оплатой, завершением или готовностью, разработчик не должен выводить это из названия столбца.</p>
    <p>Состав карты можно расширять под конкретный обмен. Единого формата Битрикс24 для такой карты нет.</p>
  </section>
  <section aria-labelledby="mapping-example">
    <h2 id="mapping-example">Что записать <span data-heading-accent>в карту соответствия</span></h2>
    <p>Для первого прохода подробно опишите одну связь. В учебном примере статус доставки приходит из условной ERP в отдельное пользовательское поле сделки; коды вашего портала и настройки коннектора определяйте отдельно.</p>
    <DataTable label="Учебный пример рабочей карты соответствия полей" columns={['Что фиксируем', 'Пример решения']} rows={example} rowHeaders />
    <p>Когда источник и приёмник согласованы, добавьте правила значений, пустых состояний, повторов, ошибок и приёмки. Для каждой следующей связи повторяйте ту же структуру. Если несколько полей должны изменяться согласованно, отдельно опишите, что происходит при частичной ошибке.</p>
    <p>Направление выбирают для каждого поля, а не только для интеграции в целом. Например, в учебной схеме ERP управляет доставкой, а менеджер ведёт комментарий в CRM. Двусторонняя синхронизация обоих полей потребовала бы отдельных правил конфликтов: чьё изменение и при каких условиях сохраняется.</p>
  </section>
  <section aria-labelledby="metadata-source">
    <h2 id="metadata-source">Откуда взять <span data-heading-accent>точные названия, коды и типы</span></h2>
    <p>Если справочник полей CRM от {companyInfo.brandName} подключён к порталу, используйте его как источник метаданных сделок, лидов, контактов и компаний. Каталог помогает отличить похожие поля и записать техническое имя рядом с понятной подписью.</p>
    <ArticleFigure src={directoryImage} fullSize alt={imageAlt}
      caption="Подлинный снимок справочника 1.0.2 на тестовом портале, 14.10.2026. Поиск CALC_COMP показывает три демонстрационных поля с разными кодами и назначениями. Это пример проверки метаданных, а не готовая карта обмена и не данные клиентских карточек." />
    <p>Экспорт описаний удобно использовать как заготовку; порядок работы разобран в <a href={`${base}spisok-poley-bitrix24/`}>инструкции по каталогу полей и CSV</a>. Зафиксируйте портал, дату и фильтры выгрузки. Для точного кода и формата REST используйте <a href={`${base}uf-crm-ufcrm-bitrix24-api/`}>разбор имён API</a>, а для смысла свойств — <a href={`${base}tipy-poley-crm-bitrix24/`}>материал о типах и множественности</a>.</p>
    <p>Каталог не показывает значения записей, зависимости роботов или используемость поля. Его CSV также не содержит готовой таблицы вариантов списка, соответствий внешним системам и всех настроек CRM. Эти части карты собираются отдельно; приложение не выполняет автоматическое сопоставление.</p>
    <InlineConsultation title="Нужно согласовать поля до разработки обмена?" description="Разберём сценарий, владельцев данных и спорные соответствия. Определим, каких правил не хватает для понятного задания интегратору." href={companyInfo.contacts.consultationUrl} actionLabel="Обсудить карту полей" />
  </section>
  <section aria-labelledby="map-values">
    <h2 id="map-values">Сопоставляйте <span data-heading-accent>не только поля, но и значения</span></h2>
    <p>Связь «статус → статус» не объясняет, как переводить каждый вариант. В учебном примере внешнее значение <code>ready</code> означает «Готов к отгрузке», а <code>shipped</code> — «Отгружен». Приёмник — пользовательское поле «Статус доставки», а не стадия сделки.</p>
    <ArticleFigure src={mappingImage} fullSize
      alt="Учебное сопоставление статусов доставки: ready с вариантом Готов к отгрузке, пример ID 17; shipped с вариантом Отгружен, пример ID 23"
      caption="Редакционная инфографика с вымышленными значениями и ID. Числа 17 и 23 показывают принцип сопоставления и не подходят для установки в ваш обмен без проверки. Реальные коды и варианты получают из конфигурации нужного поля." />
    <p>Для списочного поля зафиксируйте соответствие внешнего кода конкретному варианту CRM. Одинаковая подпись не гарантирует одинаковый идентификатор на разных порталах. Проверьте настройки поля и подходящий метод его <a href={sourceLinks[4].href} target="_blank" rel="noopener noreferrer">конфигурации</a>. Также решите, что делать с новым неизвестным вариантом: отклонять изменение, отправлять на разбор или применять заранее согласованный резервный вариант.</p>
    <p>Для <a href={sourceLinks[2].href} target="_blank" rel="noopener noreferrer">привязок к объектам CRM</a> нужна связь записей. Внешний клиент с ID 42 не становится контактом CRM с ID 42 по совпадению чисел. Сначала должна быть определена нужная запись, затем её идентификатор используется по правилам поля и метода.</p>
  </section>
  <section aria-labelledby="empty-and-clear">
    <h2 id="empty-and-clear">Пустые значения <span data-heading-accent>и намеренное очищение</span></h2>
    <p>Разделите хотя бы четыре случая: ключ не пришёл; пришёл <code>null</code>; пришла пустая строка; отправитель явно просит очистить поле. У них могут быть разные причины. Для учебного статуса можно согласовать отсутствие ключа как «не менять CRM», а неизвестное пустое состояние — как ошибку, требующую разбора.</p>
    <p>Это решения примера, а не поведение Битрикс24 по умолчанию. Если очистка допускается, запишите, кто может её инициировать и как она передаётся для конкретного типа и метода. Не используйте одну универсальную команду очистки для строк, списков, файлов и привязок без проверки документации.</p>
    <p>Отдельно определите судьбу значения, которое не удалось преобразовать. Неверная дата, неизвестный код списка или отсутствующая связанная запись не должны молча заменяться похожим значением. В карте должен быть понятный следующий шаг и ответственный за исправление источника или правила.</p>
  </section>
  <section aria-labelledby="events-and-retries">
    <h2 id="events-and-retries">Направление, повторы <span data-heading-accent>и конфликты изменений</span></h2>
    <p>Укажите событие обмена, допустимую задержку и способ повторной обработки после сбоя. «Синхронизировать постоянно» не объясняет, что делать, когда доставка уже изменилась второй раз, а старое событие пришло позже нового.</p>
    <p>Согласуйте правила для повторного события и устаревшей версии: когда обновление пропускают, когда применяют и где виден результат. При двустороннем обмене дополнительно опишите, как предотвращается бесконечная передача одного изменения туда и обратно. Это требования к реализации, а не возможности справочника полей.</p>
    <p>Уточните связанные автоматизации. Изменение одного поля может быть частью более широкого процесса, поэтому приёмка должна включать проверку ожидаемых действий и отсутствия ненужных повторов.</p>
  </section>
  <section aria-labelledby="acceptance">
    <h2 id="acceptance">Как понять, <span data-heading-accent>что карта готова к разработке</span></h2>
    <p>У каждой связи должны быть примеры входа и ожидаемого результата. Начните с небольшой согласованной выборки и включите пограничные случаи. По этим критериям затем проверяйте работу интеграции.</p>
    <Checklist label="Критерии приёмки карты соответствия и будущего обмена" items={[
      { title: 'Правильная запись и значение.', description: 'Известный внешний объект связан с нужной записью CRM. Для обычного входа указаны точное целевое поле и ожидаемое значение.' },
      { title: 'Пустые и неизвестные данные.', description: 'Проверены отсутствие ключа, null, неизвестный вариант списка и недоступная связанная запись. Для каждого случая согласованы действие и ответственный.' },
      { title: 'Повтор и конфликт.', description: 'Повторное событие, устаревшее обновление и ручное изменение в CRM имеют понятный результат; нет дубликатов или бесконечного обмена.' },
      { title: 'Подтверждение результата.', description: 'После согласованного изменения проверяется целевое значение, а не только HTTP-ответ. Видны ошибка, результат повторной обработки и влияние на связанные процессы.' },
    ]} />
    <p>Документация <a href={sourceLinks[1].href} target="_blank" rel="noopener noreferrer">crm.item.update</a> отдельно предупреждает: некорректное поле может быть проигнорировано. Поэтому успешный ответ сам по себе не подтверждает выполнение договорённости. Проверять нужно согласованное значение в правильной записи.</p>
    <p>Открытые вопросы оставляйте помеченными. Отсутствующий код, невыбранный владелец данных или неуточнённое правило очистки — повод уточнить карту, а не заполнить её предположением. Общий контекст такого обмена разобран в статье <a href={`${base}bitrix24-moysklad-integraciya/`}>об интеграции Битрикс24 и МоегоСклада</a>.</p>
  </section>
  <p>Если до сопоставления нужно разобраться в накопившихся полях, используйте <a href={`${base}audit-poley-crm-bitrix24/`}>методику аудита полей CRM</a>. Она помогает отделить проблему вида карточки от изменения данных и зафиксировать основания решений.</p>

  <FaqSection variant="article" items={faqItems} />
  <ArticleSources sources={sourceLinks} publishedIso={article.publishedAt} modifiedIso={article.updatedAt} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Начните с ' }, { text: 'проверенного каталога полей', accent: true }]}
      description={`Справочник полей CRM от ${companyInfo.brandName} помогает получить названия, коды и технические свойства. Приложение доступно в Маркете Битрикс24; правила обмена и сама интеграция согласуются отдельно.`}
      href={fieldDirectoryProduct.marketplaceUrl} actionLabel={fieldDirectoryProduct.connectionActionLabel} />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <ConsultationCtaSection slot="after-article" />
</ArticleLayout>
