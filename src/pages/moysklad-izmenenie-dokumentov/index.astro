---
import ScenarioPage from '../../components/moysklad-scenario-page/moysklad-scenario-page.astro';
import Screenshot from '../../components/moysklad-scenario-page/scenario-screenshot.astro';
import ProductScenario from '../../components/product-scenario/product-scenario.astro';
import Checklist from '../../components/editorial/checklist.astro';
import { companyInfo } from '../../config/company';
import styles from '../bitrix24-cleaner/page.module.scss';
import productStyles from '../moysklad-mass-operations/page.module.scss';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const title = `Массовое изменение документов в МойСклад — ${companyInfo.brandName}`;
const description = 'Меняйте статус, проводите документы или снимайте проведение в МойСклад для выбранной группы. Проверяйте план и сохраняйте отчёт по результатам обработки.';
const faqItems = [
  { question: 'Можно ли работать с любым документом МойСклад?', answer: 'Такое обещание не даётся. В описании продукта перечислены заказы покупателей, отгрузки, возвраты и розничные документы; нужный тип и действие следует проверить в приложении.' },
  { question: 'Изменение статуса автоматически проводит документ?', answer: 'Не следует считать эти действия равнозначными. В приложении отдельно заявлены изменение статуса, проведение и снятие проведения; выбирайте требуемое действие явно.' },
  { question: 'Что делать при частичном выполнении?', answer: 'Посмотрите результаты по конкретным документам и проверьте их состояние в МойСклад. Повторную обработку планируйте после выяснения причин ошибок и пропусков.' },
  { question: 'Как сохранить результат операции?', answer: 'Скачайте отчёт в CSV или XLSX; доступность XLSX зависит от объёма отчёта. История завершённых подтверждённых операций и подробные результаты хранятся 90 дней.' },
];
const steps = [
  { title: 'Выберите тип документов и действие', description: 'Проверьте доступность нужного действия для выбранного типа документов в приложении.' },
  { title: 'Настройте выборку и проверьте состав', description: 'Соберите документы, к которым нужно применить одинаковое действие.' },
  { title: 'Изучите план и подтвердите запуск', description: 'До подтверждения уточните последствия для учёта и связанных данных.' },
  { title: 'Сверьте результат по каждому документу', description: 'Сопоставьте выполненные действия, ошибки и пропуски с состоянием документов в МойСклад.' },
];
---

<ScenarioPage slug="izmenenie-dokumentov" label="Изменение документов" draft {title} {description} {faqItems}
  heroTitle="Массовое изменение документов в МойСклад"
  heroDescription="Меняйте статус, проводите документы или снимайте проведение для выбранной группы. Подготовьте операцию, проверьте план и получите отчёт по результатам обработки."
  summaryDescription="Приложение помогает применить одно действие к группе документов в МойСклад. Вы собираете выборку, проверяете будущие изменения и сверяете результат по каждому документу."
  mentions={['Заказы покупателей', 'Отгрузки', 'Возвраты', 'Розничные документы', 'Статус документа', 'Проведение документов']}
  connectionTitle="Подключите обработку документов под вашу задачу"
  connectionDescription="Укажите тип документов и требуемое действие. Поможем уточнить доступные возможности приложения и условия подключения.">
  <Fragment slot="summary-title">Обрабатывайте документы <strong>по общей задаче</strong></Fragment>

  <ProductScenario id="documents-example-title" title="Изменить статус подготовленной группы заказов"
    description="Если выбранным заказам требуется согласованное изменение статуса, соберите их в выборку и проверьте будущую операцию. Один только новый статус не подтверждает корректность всех связанных данных."
    steps={[
      { icon: 'filter', title: 'Проверьте тип документов', text: 'В описании приложения указаны заказы покупателей, отгрузки, возвраты и розничные документы.' },
      { icon: 'review', title: 'Выберите действие явно', text: 'Изменение статуса, проведение и снятие проведения — разные действия.' },
      { icon: 'report', title: 'Сверьте результат по объектам', text: 'Доступность нужного действия проверьте для выбранного типа документа.' },
    ]}>
    <Screenshot filename="documents-action.png" title="Выбор действия с документами" alt="Форма массового изменения документов с выбором типа, действия и демонстрационной группы"
      caption="Выберите тип документа и доступное действие, затем проверьте состав выборки." />
  </ProductScenario>

  <section class={productStyles.darkPanel} aria-labelledby="documents-actions-title">
    <div class={productStyles.copy}>
      <h2 id="documents-actions-title">Выберите нужное действие</h2>
      <h3>Изменение статуса</h3>
      <p>Примените доступное изменение к подготовленной группе.</p>
      <h3>Проведение</h3>
      <p>Запустите проведение выбранных документов после проверки данных и плана.</p>
      <h3>Снятие проведения</h3>
      <p>Используйте соответствующее действие, когда это требуется вашему процессу, предварительно оценив последствия для учёта.</p>
      <h3>Результат по каждому документу</h3>
      <p>После выполнения сверьте отчёт с состоянием документов в МойСклад. Ошибки и пропуски требуют отдельной проверки.</p>
    </div>
    <Screenshot filename="documents-result.png" title="Результат обработки документов" dark alt="Отчёт массового изменения документов с результатами по обезличенным заказам"
      caption="Выполненные действия, ошибки и пропуски по выбранным документам." />
  </section>

  <Fragment slot="editorial">
    <section aria-labelledby="documents-workflow-title">
      <h2 id="documents-workflow-title">Проверьте результат по каждому документу</h2>
      <Checklist items={steps} label="Порядок массового изменения документов" />
      <aside data-article-note><p>Не запускайте повторно всю выборку только потому, что часть документов осталась без изменений. Сначала определите причину по отчёту и проверьте конкретные объекты. Уже применённые изменения сохраняются, общего отката операции нет.</p></aside>
      <p class={styles.support}><a href={`${base}moysklad-mass-operations/`}>Все возможности приложения →</a></p>
    </section>
  </Fragment>
</ScenarioPage>
