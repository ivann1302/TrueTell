---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { mcpProduct } from '../../config/products';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import channelImage from '../../images/articles/bitrix24-assignee-channel-map-128.png';
import changeImage from '../../images/articles/bitrix24-assignee-change-example-128.png';

const article = getArticle('ne-tot-otvetstvennyy-bitrix24/');
const { title, description } = article;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const ogImage = new URL(channelImage.src, siteRoot).toString();
const imageAlt = 'Карта настроек распределения обращений: CRM-форма, почта, телефония и открытая линия';
const faqItems = [
  { question: 'Почему CRM-форма назначила заявку не тому менеджеру?', answer: 'Сначала проверьте список ответственных в разделе «Другие настройки» конкретной формы. Элементы распределяются между ними по очереди. На выбор также может влиять опция учёта начала рабочего дня или перерыва; когда все недоступны либо на тарифе нет учёта рабочего времени, распределение снова идёт по очереди. Затем проверьте, не изменил ли ответственного робот или сотрудник после создания записи.' },
  { question: 'Почему письмо от постоянного клиента получил его прежний менеджер?', answer: 'В настройках интеграции почты с CRM есть опция назначения писем известных клиентов ответственному сотруднику. При включённой опции письмо может прикрепиться к существующей карточке клиента и попасть тому, кто уже с ним работает. Проверьте связь письма с карточкой и очередь почты.' },
  { question: 'Почему звонок известного клиента не прошёл по общей очереди?', answer: 'В настройках номера проверьте опцию «Направлять входящий звонок на ответственного менеджера в случае идентификации клиента». Если она включена и Битрикс24 нашёл клиента, звонок может попасть его ответственному. Сверьте номер, найденную карточку и правило маршрутизации.' },
  { question: 'Оператор чата и ответственный за сделку — всегда один человек?', answer: 'Нет. В открытой линии можно направить диалог ответственному за найденного клиента и отдельно включить смену ответственного за лид или сделку при ручной передаче диалога другому оператору. Сверьте владельца диалога, поле в карточке CRM и настройки линии.' },
  { question: 'Как узнать, почему ответственный изменился после поступления обращения?', answer: 'Проверьте CRM → Ещё → История и найдите изменение поля «Ответственный» по ID элемента и времени. Сопоставьте его со стадией и условиями роботов: робот может выполнить действие от имени сотрудника, поэтому имя в истории само по себе не доказывает ручную смену. Запись может отсутствовать, если сохранение соответствующих событий отключено; тогда проверьте путь на тестовом обращении.' },
  { question: 'Можно ли исправить ошибку сменой ответственного в одной карточке?', answer: 'Так вы передадите конкретную карточку, но не устраните причину для следующих заявок. После фиксации случая проверьте правило нужного канала и автоматизацию. При передаче карточки отдельно проверьте связанные дела и задачи: ответственный за них не меняется автоматически вместе с элементом CRM.' },
  { question: 'MCP TrueTell уже проверяет очереди и переназначения автоматически?', answer: 'Готовую проверку всех каналов и подписку мы пока не заявляем. MCP TrueTell для Битрикс24 находится в разработке. Сейчас можно согласовать, какие поля и события нужны для будущей регулярной диагностики и кто имеет право их читать.' },
];
const sourceLinks = [
  { label: 'Битрикс24: распределение обращений из разных каналов в CRM', href: 'https://helpdesk.bitrix24.ru/open/27516124/' },
  { label: 'Битрикс24: настройка CRM-формы и ответственных', href: 'https://helpdesk.bitrix24.ru/open/24730032/' },
  { label: 'Битрикс24: история изменений элементов CRM', href: 'https://helpdesk.bitrix24.ru/open/24296386/' },
  { label: 'Битрикс24: робот «Изменить ответственного»', href: 'https://helpdesk.bitrix24.ru/open/22381314/' },
  { label: 'Битрикс24: смена ответственного в элементе CRM и связанных делах', href: 'https://helpdesk.bitrix24.ru/open/27682504/' },
  { label: 'Битрикс24: маршрутизация звонков известного клиента и настройка номера', href: 'https://helpdesk.bitrix24.ru/open/19235998/' },
];
const channelRows = [
  ['CRM-форма', '«Другие настройки» выбранной формы → «Ответственный»', 'Очередь выбранных сотрудников; условие рабочего дня и перерыва'],
  ['Почта', 'Почта → Настройки → Интеграция с CRM', 'Очередь новых обращений; ответственный уже известного клиента'],
  ['Телефония', 'Настройка номера → Маршрутизация и Интеграция с CRM', 'Группа сотрудников; ответственный найденного клиента; перевод звонка'],
  ['Открытая линия', 'Контакт-центр → нужный канал → Настроить', 'Очередь операторов; найденный клиент; передача диалога'],
];
const structuredData = createArticleStructuredData({
  articleType: 'Article', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  breadcrumbs: [{ name: 'Главная', item: siteRoot.toString() }, { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() }, { name: title, item: articleUrl }],
  faqItems,
});
---
<ArticleLayout {title} titleParts={[{ text: 'Заявка попала не тому менеджеру: ' }, { text: 'проверка очереди Битрикс24', accent: true }]} {description}
  canonicalPath={`/${article.hrefPath}`} {structuredData} ogTitle={article.seoTitle} ogDescription={description}
  {ogImage} ogImageAlt={imageAlt} category={article.category} author={authorName}
  intro="Карточка есть в CRM, но её получил другой сотрудник? Сначала выясните, по какому каналу пришло обращение и кто был назначен в карточке. Затем сопоставьте правило этого канала с историей последующих изменений.">
  <Fragment slot="quick-answer">
    <p><strong>Запишите ID карточки, канал, время поступления и текущего ответственного. Проверьте очередь именно этого канала, затем историю изменения поля «Ответственный» и роботов на стадии.</strong></p>
    <p>Один неожиданный исполнитель ещё не доказывает сбой очереди: заявку могли передать после создания, а обращение известного клиента могло пойти по отдельному правилу.</p>
  </Fragment>

  <p data-article-lead>Заявка уже находится в CRM — значит, задача отличается от ситуации, когда <a href={`${base}poteryannye-zayavki-bitrix24/`}>обращение не удаётся найти</a>. Здесь нужно восстановить маршрут назначения. Не меняйте список сотрудников сразу: сначала разберите одну карточку и проверьте, на каком шаге фактический ответственный разошёлся с вашим правилом.</p>

  <section aria-labelledby="case">
    <h2 id="case">Зафиксируйте <span data-heading-accent>один случай</span></h2>
    <p>Откройте запись под пользователем, который имеет право её видеть. Запишите тип и ID элемента, время обращения, источник, текущего ответственного и того, кого ожидала команда. Для формы сохраните её название; для письма — подключённый ящик; для звонка — номер; для чата — открытую линию. Не включайте в рабочую заметку полный телефон или содержимое переписки клиента.</p>
    <p>Уточните, новый это клиент или уже существующий. Письмо и диалог известного клиента могут попасть сотруднику, который работает с его карточкой. Если обращение оказалось в существующей сделке, время создания сделки не является временем новой заявки: сверяйте событие в таймлайне. Как искать результат отправки формы, разобрано в <a href={`${base}crm-forma-ne-sozdaet-zayavku-bitrix24/`}>отдельной инструкции</a>.</p>
  </section>

  <section aria-labelledby="channel">
    <h2 id="channel">Проверьте правило <span data-heading-accent>нужного канала</span></h2>
    <p>В Битрикс24 очередь формы, почты, телефона и открытой линии настраивают в разных местах. Сравнивайте карточку с тем правилом, которое действовало для её источника, а не с общей таблицей дежурств. Названия разделов ниже сверены со справкой Битрикс24; доступ к настройкам зависит от роли сотрудника.</p>
    <ArticleFigure src={channelImage} fullSize portrait alt={imageAlt} caption="Редакционная карта четырёх каналов по справке Битрикс24. Это не снимок интерфейса и не схема одной общей очереди: у каждого канала свои настройки." />
    <DataTable label="Где проверить назначение ответственного по каналу" columns={['Канал', 'Где проверить', 'Что влияет на выбор']} rows={channelRows} rowHeaders />
    <p>Для CRM-формы откройте «Другие настройки» конкретной формы и посмотрите список «Ответственный». Создаваемые элементы распределяются между выбранными сотрудниками по очереди. Опция «Не назначать ответственным, если не начат рабочий день или перерыв» может исключать недоступных сотрудников. Если все недоступны или на тарифе нет учёта рабочего времени, Битрикс24 распределяет заявки по очереди. Поэтому без состояния очереди в момент отправки нельзя назвать одного «правильного» менеджера только по списку имён.</p>
    <p>Для почты проверьте «Интеграцию с CRM»: новое обращение может идти по очереди, а письмо известного клиента — к его текущему ответственному. В телефонии смотрите группу номера и опцию «Направлять входящий звонок на ответственного менеджера в случае идентификации клиента»: звонок найденного клиента может миновать обычную очередь. При ручном переводе звонка отдельная настройка может менять ответственного за лид. В открытой линии различайте оператора диалога и ответственного в CRM: найденного клиента можно направить его менеджеру, а ручная передача диалога может менять поле в лиде или сделке, если эта опция включена.</p>
  </section>

  <section aria-labelledby="after">
    <h2 id="after">Проверьте, <span data-heading-accent>не сменился ли ответственный позже</span></h2>
    <p>Текущая карточка показывает конечное состояние. Откройте CRM → Ещё → История и найдите изменения по ID элемента и времени: справка Битрикс24 относит поле «Ответственный» к фиксируемым изменениям. Администратор видит всю историю CRM, сотрудники — только доступные им элементы. В настройках CRM сохранение отдельных событий истории можно отключить, поэтому отсутствие записи не всегда доказывает отсутствие изменения.</p>
    <ArticleFigure src={changeImage} fullSize alt="Учебная последовательность: форма поступила, очередь назначила менеджера А, затем робот сменил ответственного на менеджера Б" caption="Учебный пример, не данные портала TrueTell: текущий ответственный Б появился после работы робота. История поля помогает отделить последующее переназначение от первичного правила очереди." />
    <p>Если в истории есть смена поля после поступления обращения, отметьте время и автора записи, затем сверьте стадию и условия роботов. Робот «Изменить ответственного» может работать от имени выбранного сотрудника: одно имя в истории не доказывает, что карточку передали вручную. Не перезапускайте автоматизацию на рабочих карточках ради эксперимента. Если история не даёт ответа, воспроизведите путь на согласованном тестовом обращении и наблюдайте поле сразу после создания и после срабатывания автоматизации.</p>
  </section>

  <section aria-labelledby="fix">
    <h2 id="fix">Исправьте причину <span data-heading-accent>и повторите тест</span></h2>
    <p>Если правило канала не соответствует принятому порядку дежурств, измените только его: состав очереди формы, почты, группы телефонии или открытой линии. Если первичное назначение было верным, но ответственного сменил робот, исправляйте условие и порядок автоматизации. Ручная смена в одной карточке поможет передать именно эту заявку, но не изменит правило для следующих обращений.</p>
    <p>После правки отправьте тест из того же канала, сохранив время, ID новой или существующей карточки, назначенного сотрудника и запись в истории. Для сценария с известным клиентом сделайте отдельный тест на своей тестовой карточке: его маршрут может отличаться от нового обращения. Не используйте реальные контактные данные без необходимости и не меняйте права всей команды ради одного теста.</p>
    <p>Передавая заявку другому менеджеру, отдельно проверьте связанные дела и задачи. Справка Битрикс24 отмечает, что смена ответственного за элемент CRM не назначает автоматически нового ответственного за связанными элементами и делами. Если после изменения правила повторный тест снова расходится с ожиданием, сохраните ID, время, настройки канала и историю для администратора или поддержки.</p>
  </section>

  <section aria-labelledby="regular">
    <h2 id="regular">Как отслеживать <span data-heading-accent>повторения</span></h2>
    <p>Для регулярной диагностики ведите короткую запись по каждому расхождению: канал, тип клиента, ID элемента, правило на момент обращения, текущий ответственный и событие переназначения. Она показывает, повторяется ли ошибка в одной форме, смене дежурства или конкретном роботе. Агрегированный список полезнее общего числа «неправильно назначенных»: без согласованного правила для каждого канала такое число нельзя проверить.</p>
    <p>Мы разрабатываем MCP TrueTell для работы внешнего ИИ с данными Битрикс24. Готовую автоматическую проверку очередей и подписку сейчас не заявляем. Можно обсудить, какие поля и события вашего портала разрешено читать и как человек будет подтверждать вывод диагностики. О границах доступа рассказываем в статье <a href={`${base}bezopasnyy-dostup-ii-k-crm/`}>«Как безопасно дать ИИ доступ к CRM»</a>.</p>
    <InlineConsultation variant="product" title="Разбираете неожиданные назначения в CRM?" description="Опишите канал, ожидаемое правило и один тестовый случай без клиентских данных. Поможем составить ручную проверку и требования к будущему регулярному контролю." href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
  </section>

  <FaqSection title="Частые вопросы о назначении заявок" items={faqItems} variant="article" />
  <p>Официальная справка Битрикс24 проверена 30 октября 2026 года. Маршрут на клиентском портале не тестировался: состав меню, доступные настройки и тариф сверяйте в своём Битрикс24.</p>
  <ArticleSources publishedIso={article.publishedAt} modifiedIso={article.updatedAt} sources={sourceLinks} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Обсудим ' }, { text: 'MCP TrueTell для Битрикс24', accent: true }]} description={mcpProduct.articleDescription} href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <ConsultationCtaSection slot="after-article" />
</ArticleLayout>
