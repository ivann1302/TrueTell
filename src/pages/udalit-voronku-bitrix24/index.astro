---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { cleanerProduct, cleanerProductPath } from '../../config/products';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import filterImage from '../../images/articles/bitrix24-deal-filter-native.png';
import transferImage from '../../images/articles/bitrix24-two-pipelines-handoff-134.png';

const article = getArticle('udalit-voronku-bitrix24/');
const { title, description } = article;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const imageAlt = 'Подлинный экран фильтра сделок Битрикс24: группа стадий и диапазон дат ограничивают видимые записи';
const ogImage = new URL(filterImage.src, siteRoot).toString();
const sourceLinks = [
  { label: 'Битрикс24: воронки продаж и ограничения удаления', href: 'https://helpdesk.bitrix24.ru/open/20732764/' },
  { label: 'Битрикс24: групповые действия и перенос сделок в другую воронку', href: 'https://helpdesk.bitrix24.ru/open/21064250/' },
  { label: 'Битрикс24: регулярные сделки и шаблоны по воронкам', href: 'https://helpdesk.bitrix24.ru/open/27203912/' },
  { label: 'Битрикс24: корзина CRM', href: 'https://helpdesk.bitrix24.ru/open/24668648/' },
  { label: 'Битрикс24: экспорт данных CRM', href: 'https://helpdesk.bitrix24.ru/open/20966844/' },
  { label: 'Битрикс24: туннели продаж, копирование и перемещение', href: 'https://helpdesk.bitrix24.ru/open/20820936/' },
];
const actionRows = [
  ['Рабочая или завершённая сделка', 'Перенести в подходящую воронку и стадию', 'Карточка остаётся в CRM; проверьте права и автоматизацию'],
  ['Ошибочная или тестовая сделка', 'Удалить после сверки ID и связей', 'Запись попадёт в корзину и продолжит блокировать удаление воронки'],
  ['Общая воронка с ID 0', 'Оставить; при необходимости переименовать', 'Стандартное направление удалить нельзя'],
];
const faqItems = [
  { question: 'Можно ли удалить воронку Битрикс24 вместе со сделками?', answer: 'Официальная справка не разрешает удалить направление, пока в нём есть сделки. Сначала решите судьбу каждой группы: рабочие и нужные для истории перенесите, ошибочные удаляйте только после проверки. Также проверьте корзину и шаблоны сделок.' },
  { question: 'Почему пустая на экране воронка не удаляется?', answer: 'Видимый список может быть ограничен фильтром, правами или стадией. Кроме того, удаление блокируют сделки этой воронки в корзине CRM и привязанные шаблоны регулярных сделок. Стандартную Общую воронку с ID 0 удалить нельзя.' },
  { question: 'Как перенести несколько сделок в другую воронку?', answer: 'В CRM → Сделки переключитесь в режим «Список», проверьте выбранное направление и фильтр, отметьте нужные сделки и используйте групповое действие «Перенести в воронку». Опция «Для всех» распространяет действие на все элементы найденного списка, в том числе на других страницах, поэтому перед применением проверьте охват.' },
  { question: 'Удалять ли закрытые сделки перед удалением воронки?', answer: 'Если сделки отражают реальные продажи или отказы, обычно их переносят в подходящее направление, сохраняя историю. Удаление подходит для ошибочных записей и меняет отчётность. На одной контрольной сделке проверьте целевую стадию и права, прежде чем переносить всю выборку.' },
  { question: 'Что делать с шаблонами регулярных сделок?', answer: 'В нужной воронке откройте Настройки (⚙️) → «Шаблоны регулярных сделок». Проверьте, нужны ли будущие сделки по расписанию. Для неиспользуемого шаблона доступно действие удаления; уже созданные по нему сделки сохраняются. Если шаблон нужен, согласуйте новую схему до удаления направления.' },
  { question: 'Поможет ли Cleaner TrueTell удалить воронку?', answer: 'Cleaner предназначен для массового удаления лидов и сделок, а не самих воронок. Он уместен только если вы подтвердили, что сделки действительно ошибочные, и проверили выборку. Рабочие сделки нужно переносить штатными средствами Битрикс24.' },
];
const structuredData = createArticleStructuredData({
  articleType: 'Article', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  breadcrumbs: [{ name: 'Главная', item: siteRoot.toString() }, { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() }, { name: title, item: articleUrl }],
  faqItems,
});
---
<ArticleLayout {title} titleParts={[{ text: 'Как удалить воронку ' }, { text: 'продаж Битрикс24', accent: true }]} {description}
  canonicalPath={`/${article.hrefPath}`} {structuredData} ogTitle={article.seoTitle} ogDescription={description}
  {ogImage} ogImageAlt={imageAlt} category={article.category} author={authorName}
  intro="Ненужное направление сделок может остаться после смены процесса или объединения отделов. Перед удалением важно найти все сделки, включая закрытые и находящиеся в корзине, выбрать для них новый маршрут и проверить шаблоны регулярных сделок.">
  <Fragment slot="quick-answer">
    <p><strong>Откройте CRM → Сделки → Воронки → «Воронки и туннели продаж» и выберите нужное направление.</strong> Удалить его можно при наличии прав, если это не стандартная воронка с ID 0 и к ней не относятся сделки в CRM или корзине и шаблоны сделок.</p>
    <p>Рабочие сделки перенесите в другое направление. Удаляйте только ошибочные записи после проверки. Затем сверяйте автоматизацию и права в новой воронке; саму команду удаления применяйте лишь после проверки зависимостей.</p>
  </Fragment>

  <p data-article-lead>Направление «Проектные продажи» больше не используется, но в нём могли остаться завершённые сделки, регулярные шаблоны и карточки, которые не видны из-за фильтра. Из-за таких зависимостей Битрикс24 может отказать в удалении. Проверка всех стадий и источников новых сделок поможет сохранить рабочую историю.</p>

  <section aria-labelledby="find">
    <h2 id="find">Найдите все сделки <span data-heading-accent>этого направления</span></h2>
    <p>В <strong>CRM → Сделки</strong> выберите направление, которое хотите убрать, и переключитесь в режим «Список». Сбросьте сохранённые фильтры по дате, стадии и ответственному. Просмотрите открытые, выигранные и проигранные сделки. Если их видит администратор, но не видит сотрудник, проверьте права роли: список одного пользователя не доказывает, что направление пустое.</p>
    <ArticleFigure src={filterImage} fullSize portrait alt={imageAlt} caption="Подлинный фрагмент фильтра Битрикс24 из материала TrueTell об удалении проигранных сделок. На демонстрационном экране задан диапазон дат октября 2026 года и группа стадий. Перед оценкой всей воронки такие ограничения нужно снять; снимок не показывает её фактическое содержимое." />
    <p>Если нужно сохранить список перед изменением, экспортируйте сделки с ID и нужными полями. Экспорт отражает текущую выборку и показанные столбцы, поэтому проверьте охват и число строк в файле. Подробный порядок есть в <a href={`${base}eksport-lidov-sdelok-bitrix24-pered-udaleniem/`}>инструкции по экспорту перед удалением</a>.</p>
  </section>

  <section aria-labelledby="decide">
    <h2 id="decide">Решите судьбу сделок <span data-heading-accent>до удаления воронки</span></h2>
    <p>Нужные для работы и отчётов сделки перенесите в действующую воронку. Для тестовой или ошибочно созданной записи возможно удаление после сверки ID и связанных операций. Реальные проигрыши не стоит превращать в «мусор» только ради очистки направления: удалённые сделки не участвуют в аналитических отчётах.</p>
    <DataTable label="Как поступить с воронкой и сделками" columns={['Что найдено', 'Действие', 'Что проверить']} rows={actionRows} rowHeaders />
    <p>Начните с одной контрольной сделки. Выберите целевую стадию, проверьте ответственного, значения полей и доступ команды. При групповом переносе Битрикс24 позволяет изменить воронку сразу у нескольких сделок в режиме «Список». Опция <strong>«Для всех»</strong> захватит и другие страницы результата, поэтому перед её включением проверьте фильтр и количество записей.</p>
    <ArticleFigure src={transferImage} fullSize alt="Учебная схема: копирование создаёт вторую сделку, а перемещение переводит ту же сделку в другое направление" caption="Редакционная схема на условных ID, ранее подготовленная для статьи TrueTell о двух воронках. Для освобождения удаляемого направления подходит перемещение: копия оставляет исходную сделку на месте. Это схема процесса, не экран Битрикс24." />
    <p>Не путайте перенос с копированием через туннель: при копировании исходная сделка остаётся в старом направлении и продолжит мешать его удалению. После переноса контрольной карточки проверьте её историю, права и роботов в целевой воронке. Если есть интеграции, уточните, не создают ли они новые сделки в направлении, которое собираетесь убрать. Подробнее о разделении процессов: <a href={`${base}dve-voronki-bitrix24-nastroyka/`}>как настроить две воронки</a>.</p>
  </section>

  <section aria-labelledby="blockers">
    <h2 id="blockers">Проверьте корзину <span data-heading-accent>и регулярные шаблоны</span></h2>
    <p>По официальной справке даже после очистки списка удаление воронки блокируют сделки из неё, оставшиеся в корзине CRM. Откройте <strong>CRM → Ещё → Корзина</strong> и проверьте такие записи. Восстановление и окончательная очистка корзины влияют на данные; не очищайте её целиком ради одного направления без согласования и проверки нужных записей. Если сделка нужна, восстановите её и перенесите в действующую воронку. После восстановления ID изменится: проверьте ссылки и интеграции. Если запись точно ошибочная, администратор Битрикс24 может окончательно удалить именно её через «Меню (≡) → Удалить → Продолжить». Проверьте ID перед необратимым действием. О правилах корзины см. <a href={`${base}udalennye-sdelki-bitrix24/`}>разбор удалённых сделок</a>.</p>
    <p>Ещё одна причина отказа: привязанные шаблоны сделок. В нужной воронке откройте <strong>Настройки (⚙️) → Шаблоны регулярных сделок</strong>. Посмотрите, по каким шаблонам ещё должны появляться сделки. Удаление неиспользуемого шаблона прекращает создание новых карточек по нему, но уже созданные сделки сохраняются. Если расписание нужно бизнесу, сначала согласуйте его новый маршрут.</p>
    <p>Проверьте также роботов, туннели, CRM-формы и интеграции, которые могут создавать или перемещать сделки в старую воронку. Справка перечисляет четыре прямых блокировки удаления; эти настройки мы рекомендуем проверить как операционные зависимости, чтобы направление не понадобилось вернуть после изменения процесса.</p>
  </section>

  <section aria-labelledby="remove">
    <h2 id="remove">Удалите направление <span data-heading-accent>и проверьте результат</span></h2>
    <p>Вернитесь в <strong>CRM → Сделки → Воронки → «Воронки и туннели продаж»</strong> или в <strong>Настройки CRM → Воронки продаж</strong>. Выберите нужное пользовательское направление и доступное в вашем интерфейсе действие удаления. Сверьте его название перед подтверждением. Стандартную «Общую воронку» с ID 0 удалить нельзя; если мешает её название, Битрикс24 разрешает переименовать и изменить порядок.</p>
    <p>После действия проверьте, что пользовательская воронка исчезла из списка, а перенесённые сделки доступны в целевой стадии под нужными ролями. Откройте несколько контрольных ID, проверьте автоматизацию и отчёт за фиксированный период. Если Битрикс24 всё ещё не даёт удалить направление, вернитесь к сделкам в списке и корзине, регулярным шаблонам и правам доступа. Не удаляйте рабочие сделки ради обхода сообщения.</p>
    <InlineConsultation variant="product" title="Нужно разобрать зависимое направление?" description="Опишите без данных клиентов, какие сделки, шаблоны и правила создания связаны с воронкой. Поможем составить порядок переноса и проверки до изменения CRM." href={companyInfo.contacts.consultationUrl} actionLabel="Обсудить задачу" />
  </section>

  <FaqSection title="Частые вопросы об удалении воронки Битрикс24" items={faqItems} variant="article" />
  <p>Официальная справка Битрикс24 проверена 1 ноября 2026 года. Удаление направления и перенос сделок на клиентском портале не выполнялись; названия доступных команд могут зависеть от интерфейса и прав пользователя.</p>
  <ArticleSources publishedIso={article.publishedAt} modifiedIso={article.updatedAt} sources={sourceLinks} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Если мешают ошибочные сделки: ' }, { text: 'проверьте очистку с Cleaner', accent: true }]} description={cleanerProduct.articleDescription} href={cleanerProductPath} actionLabel={cleanerProduct.articleActionLabel} />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <ConsultationCtaSection slot="after-article" />
</ArticleLayout>
