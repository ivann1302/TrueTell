---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { mcpProduct } from '../../config/products';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import pathImage from '../../images/articles/bitrix24-robot-check-path-130.png';
import logImage from '../../images/articles/bitrix24-robot-log-states-130.png';

const article = getArticle('robot-ne-srabatyvaet-bitrix24/');
const { title, description } = article;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const ogImage = new URL(pathImage.src, siteRoot).toString();
const imageAlt = 'Путь диагностики робота на одной сделке: стадия, статус в карточке, настройки и лог отладчика';
const faqItems = [
  { question: 'Где увидеть, сработал ли робот в конкретной сделке?', answer: 'Откройте карточку сделки и вкладку «Роботы». Посмотрите статус нужного робота: выполнен, ожидает паузу, не сработал из-за ошибки или не запустился. Для подробного разбора запустите отладчик на тестовой сделке и откройте его лог.' },
  { question: 'Почему робот не срабатывает после изменения поля сделки?', answer: 'Робот CRM обычно запускается при попадании элемента на стадию. Проверьте, когда сделка вошла на стадию и какое значение поля было доступно в момент проверки условия. Если поле заполняется приложением или вебхуком позже, условие может оказаться ложным. Для такого случая Битрикс24 рекомендует отдельно проверять порядок заполнения данных и запуска.' },
  { question: 'Можно ли пропустить ожидание робота в отладчике?', answer: 'Да. В отладчике тестовой сделки для робота с паузой есть действие «Пропустить паузу». Оно помогает проверить следующий шаг без ожидания заданного срока. На реальной сделке такое действие может повлиять на рабочие данные, поэтому сначала воспроизведите сценарий на тестовой.' },
  { question: 'Почему робот работает по старым настройкам после правки?', answer: 'По справке Битрикс24 уже запущенные роботы и бизнес-процессы продолжают работать по настройкам на момент запуска. Проверьте дату входа конкретной сделки на стадию и протестируйте исправление на новой тестовой сделке.' },
  { question: 'Отладчик роботов работает с лидами и смарт-процессами?', answer: 'В официальной справке Битрикс24 отладчик описан только для сделок. Статус робота можно смотреть во вкладке «Роботы» карточки CRM-элемента, если функция доступна на вашем тарифе и у сотрудника есть нужные права.' },
  { question: 'MCP TrueTell уже сам исправляет роботов?', answer: 'Автоматическое исправление и готовую подписку на ошибки роботов мы не заявляем. MCP TrueTell для настройки и диагностики CRM находится в разработке. Сейчас можно обсудить сценарий, необходимые права и какие изменения человек должен подтверждать отдельно.' },
];
const sourceLinks = [
  { label: 'Битрикс24: роботы в CRM и статусы в карточке', href: 'https://helpdesk.bitrix24.ru/open/24367166/' },
  { label: 'Битрикс24: условия, очередь, время и рабочие часы', href: 'https://helpdesk.bitrix24.ru/open/21491832/' },
  { label: 'Битрикс24: что такое отладчик роботов', href: 'https://helpdesk.bitrix24.ru/open/19361188/' },
  { label: 'Битрикс24: отладка на тестовой сделке', href: 'https://helpdesk.bitrix24.ru/open/19361194/' },
  { label: 'Битрикс24: отладка реальной сделки', href: 'https://helpdesk.bitrix24.ru/open/19425336/' },
  { label: 'Битрикс24: статусы и записи лога отладчика', href: 'https://helpdesk.bitrix24.ru/open/19426954/' },
  { label: 'Битрикс24: причины сбоев роботов и бизнес-процессов', href: 'https://helpdesk.bitrix24.ru/open/23046316/' },
  { label: 'Битрикс24: остановка роботов при смене стадии', href: 'https://helpdesk.bitrix24.ru/open/22381314/' },
];
const statusRows = [
  ['Зелёная галочка', 'Действие выполнено', 'Проверьте результат в карточке: задача, письмо или изменённое поле'],
  ['Белый кружок', 'Робот ждёт паузу', 'Сверьте «Когда», рабочее время и очередь запуска'],
  ['Знак ошибки', 'Робот не выполнил действие из-за ошибки', 'Откройте причину в карточке и запись в логе'],
  ['Белый без значка', 'Робот не сработал', 'Проверьте условие, стадию и предыдущего робота'],
];
const structuredData = createArticleStructuredData({
  articleType: 'Article', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  breadcrumbs: [{ name: 'Главная', item: siteRoot.toString() }, { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() }, { name: title, item: articleUrl }],
  faqItems,
});
---
<ArticleLayout {title} titleParts={[{ text: 'Робот Битрикс24 ' }, { text: 'не срабатывает', accent: true }]} {description}
  canonicalPath={`/${article.hrefPath}`} {structuredData} ogTitle={article.seoTitle} ogDescription={description}
  {ogImage} ogImageAlt={imageAlt} category={article.category} author={authorName}
  intro="Сделка перешла на стадию, а письмо, задача или изменение поля не появились? Начните с одной карточки: её стадия и статус робота обычно быстрее показывают, где искать причину.">
  <Fragment slot="quick-answer">
    <p><strong>Откройте проблемную сделку → «Роботы» и найдите статус нужного действия. Затем проверьте его стадию, условие, время и очередь запуска.</strong></p>
    <p>Если причина неясна, откройте CRM → Сделки → Роботы → Отладчик роботов и воспроизведите сценарий на тестовой сделке с теми же значениями полей. В логе видно, было ли условие истинным, ожидал ли робот паузу и возникла ли ошибка.</p>
  </Fragment>

  <p data-article-lead>Фраза «робот не работает» описывает разные сбои. Действие могло не запускаться из-за условия, ждать своего времени, завершиться ошибкой или выполниться, но изменить не ту карточку, которую вы смотрите. Возьмите одну сделку с известным ID, запишите ожидаемое действие и фактический результат. После этого проверка становится предметной.</p>

  <section aria-labelledby="start-card">
    <h2 id="start-card">Сначала откройте <span data-heading-accent>нужную сделку</span></h2>
    <p>Сверьте направление, текущую стадию и момент входа на неё. Роботы CRM выполняют действия, когда элемент попадает на стадию, к которой они привязаны. Если вы добавили робота позже, старая сделка уже могла пройти этот момент. Если другой робот успел сменить стадию, незавершённые действия предыдущей стадии останавливаются.</p>
    <p>В карточке откройте вкладку «Роботы» и найдите нужное действие. Зелёная галочка означает выполнение, белый кружок — ожидание паузы, значок ошибки требует прочитать причину, белая карточка без значка указывает, что действие не сработало. Цвет сам по себе не заменяет проверку результата: например, после «Отправить письмо» посмотрите историю письма и адрес получателя.</p>
    <ArticleFigure src={pathImage} fullSize alt={imageAlt} caption="Редакционная схема проверки одной сделки по справке Битрикс24. Это не экран продукта и не выгрузка из клиентской CRM." />
    <DataTable label="Статус робота и следующий шаг проверки" columns={['Статус', 'Что известно', 'Что проверить']} rows={statusRows} rowHeaders />
  </section>

  <section aria-labelledby="settings">
    <h2 id="settings">Проверьте <span data-heading-accent>условие, время и очередь</span></h2>
    <p>Откройте настройки робота на той же стадии. Сравните значения полей сделки с условием запуска. Для составного условия проверьте каждую группу И/ИЛИ. Если поле заполняется приложением или вебхуком после создания сделки, робот мог проверить его ещё пустым; это отдельный сценарий в официальной справке Битрикс24. Зафиксируйте порядок событий, прежде чем менять настройку.</p>
    <p>Затем посмотрите поле «Когда»: действие может быть отложено или ограничено рабочим временем компании либо сотрудника. У отложенного запуска минимальный интервал в справке составляет 10 минут. В поле очереди робот может ждать предыдущего робота на стадии или работать независимо. Если предыдущее действие не выполнилось, проверьте эту зависимость до изменения условий следующего.</p>
    <p>Сохраните настройки и в окне робота, и на странице автоматизации. Уже запущенные сценарии по справке Битрикс24 продолжают работать по настройкам на момент своего запуска. Новую конфигурацию проверяйте на новой тестовой сделке: старая карточка могла запустить прежний вариант робота.</p>
  </section>

  <section aria-labelledby="debugger">
    <h2 id="debugger">Воспроизведите сбой <span data-heading-accent>в отладчике</span></h2>
    <p>Отладчик Битрикс24 доступен для сделок. Сотруднику нужно право «Разрешить изменять настройки CRM»; функции роботов зависят от тарифа. Перейдите в CRM → Сделки → Роботы → Отладчик роботов и выберите «Отладка на тестовой сделке». Отладчик создаст сделку. Заполните в ней те же поля, от которых зависит условие, и проведите её по нужным стадиям. Используйте учебные данные без контактов реальных клиентов.</p>
    <p>Выберите отслеживаемые поля и запустите отладку. Для действия с задержкой можно нажать «Пропустить паузу». В логе проверьте время запуска, результат условия и текст ошибки, если она возникла. «Условие ложь» означает пропуск по правилу; ошибка действия, например отсутствие e-mail для письма, требует исправить входные данные или настройки самого робота.</p>
    <ArticleFigure src={logImage} fullSize alt="Четыре результата отладки робота: условие ложно, ожидание паузы, ошибка действия и выполнено" caption="Учебная карта чтения лога по официальной справке Битрикс24. Слова и состояния обобщены; точную причину берите из своей сессии отладки." />
    <p>Режим «Перехват сделки из других каналов» нужен, когда важно проверить поступление новой реальной сделки. Он перехватывает сделки, созданные после запуска отладчика, а действия роботов способны изменить рабочие данные. Для первой проверки безопаснее тестовая сделка. Логи сессий доступны через «Роботы → Сессии отладки»; после проверки тестовую сделку можно удалить при завершении отладки.</p>
  </section>

  <section aria-labelledby="fix">
    <h2 id="fix">Исправьте одну причину <span data-heading-accent>и проверьте заново</span></h2>
    <p>Меняйте по одному параметру: условие, время, очередь или данные для действия. Повторите сценарий на новой тестовой сделке и проверьте два результата: статус в логе и фактическое письмо, задачу либо поле в карточке. Если робот не выполнил действие в рабочих сделках, составьте список затронутых ID и решите, что нужно восстановить вручную.</p>
    <p>Не запускайте всех роботов повторно без такого списка. Повтор может ещё раз отправить сообщение, создать задачу или изменить поле; это практический риск, следующий из типов действий. Если нет доступа к вкладке роботов или отладчику, проверьте права и тариф с администратором портала. При сбое на многих сделках соберите общие признаки и разберите схему автоматизации отдельно.</p>
    <p>Мы развиваем MCP TrueTell для настройки и диагностики CRM. Сейчас не обещаем, что продукт автоматически читает лог отладчика, исправляет роботов или следит за ними по подписке. Чтобы обсудить применимость к вашему процессу, достаточно описать один обезличенный пример: ID можно заменить условным номером, указать стадию, ожидаемое действие, статус и текст ошибки без данных клиента.</p>
    <InlineConsultation variant="product" title="Нужно разобрать сбой робота?" description="Опишите стадию, условие и фактический результат без персональных данных. Поможем определить ручной маршрут проверки и требования к диагностике." href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
  </section>

  <FaqSection title="Частые вопросы о роботах Битрикс24" items={faqItems} variant="article" />
  <p>Официальная справка Битрикс24 проверена 30 октября 2026 года. Клиентский портал и конкретная конфигурация роботов не тестировались; меню, тариф и права сверяйте в своей CRM.</p>
  <ArticleSources publishedIso={article.publishedAt} modifiedIso={article.updatedAt} sources={sourceLinks} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Обсудим ' }, { text: 'MCP TrueTell для CRM', accent: true }]} description={mcpProduct.articleDescription} href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <ConsultationCtaSection slot="after-article" />
</ArticleLayout>
