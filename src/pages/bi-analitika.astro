---
import { Image } from 'astro:assets';

import AppHeader from '../components/header/header.astro';
import SiteFooter from '../components/footer/site-footer.astro';
import LineWave from '../components/ui/line-wave.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { companyInfo } from '../config/company';

import heroStyles from '../sections/hero-section/hero-section.module.scss';
import styles from './bi-analitika.module.scss';

import clientsDashboardImage from '../images/bi-dashboard/clients.png';
import categoriesDashboardImage from '../images/bi-dashboard/categories.png';
import overviewDashboardImage from '../images/bi-dashboard/overview.png';
import overviewMobileDashboardImage from '../images/bi-dashboard/overview-mobile.png';
import profitDashboardImage from '../images/bi-dashboard/profit.png';
import stockDashboardImage from '../images/bi-dashboard/stock.png';
import stockMobileDashboardImage from '../images/bi-dashboard/stock-mobile.png';
import storesDashboardImage from '../images/bi-dashboard/stores.png';
import storesMobileDashboardImage from '../images/bi-dashboard/stores-mobile.png';
import clientPhoto from '../images/photos/clientPhoto.png';

const title = 'BI-аналитика и дашборды для торговли — TrueTell';
const description = 'BI-аналитика TrueTell объединяет продажи, остатки и маржинальность в управленческих дашбордах для розничных сетей и пользователей МойСклад.';
const demoUrl = 'https://datalens.yandex/cts92knihou4y';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const homeUrl = siteRoot.toString();
const biUrl = new URL('bi-analitika/', siteRoot).toString();

const audience = [
  'Розница от 3 точек',
  'Вы используете систему управленческого учёта «МойСклад»',
  'У вас несколько разных отчётов, их делают люди',
  'Либо отчёта нет вообще',
];

const painPoints = [
  {
    title: 'Товары-«мертвецы»',
    text: '20–30% ассортимента не продаётся, но менеджеры продолжают его заказывать.',
  },
  {
    title: 'Поставщики впаривают неликвид',
    text: 'Менеджеры по продажам поставщиков работают на свои KPI.',
  },
  {
    title: 'Погрешности в заказах',
    text: 'Как вы сейчас принимаете решения — на глазок или по данным?',
  },
];

const capabilities = [
  {
    title: 'Заказы и продажи',
    text: 'Сопоставляет то, что заказывают менеджеры, с тем, что действительно продаётся.',
  },
  {
    title: 'Реальная прибыльность',
    text: 'Показывает прибыльные товары и позиции, которые только занимают оборотные средства.',
  },
  {
    title: 'Все точки в одном окне',
    text: 'Объединяет показатели сети и остатки онлайн при использовании системы «МойСклад».',
  },
];

const reportPreviews = [
  {
    image: clientsDashboardImage,
    title: 'Клиенты',
    alt: 'Демо-отчёт TrueTell: число уникальных клиентов, повторные покупки и LTV',
  },
  {
    image: categoriesDashboardImage,
    title: 'Категории',
    alt: 'Демо-отчёт TrueTell: продажи, прибыль и маржинальность товарных категорий',
  },
  {
    image: profitDashboardImage,
    title: 'ABC-анализ прибыли',
    alt: 'Демо-отчёт TrueTell: ABC-анализ категорий по валовой прибыли',
  },
];

const pricing = [
  {
    title: 'Внедрение',
    description: 'В зависимости от числа источников',
    price: '40 000–60 000 ₽',
  },
  {
    title: 'Поддержка',
    description: 'Работоспособность системы и доработка запросов заказчика',
    price: '7 000–15 000 ₽',
    period: 'в месяц',
  },
];

const results = [
  { value: '−35%', text: '«мёртвого» ассортимента' },
  { value: '+18%', text: 'маржи за счёт перераспределения закупок' },
  { value: 'KPI', text: 'понятные менеджерам и доступные в одном дашборде' },
];

const steps = [
  {
    title: 'Обсуждаем',
    text: 'Текущее положение дел и описываем целевое состояние отчётности.',
  },
  {
    title: 'Заключаем договор',
    text: 'Фиксируем объём работ, источники данных и результат внедрения.',
  },
  {
    title: 'Запускаем интеграцию',
    text: 'Подключаем данные, проверяем показатели и передаём готовые отчёты.',
  },
];

const faqItems = [
  {
    question: 'У нас маленький бизнес — зачем это?',
    answer: 'Именно небольшие сети теряют больше всего из-за ошибок в заказах. Проверьте, сколько товаров у вас лежит более трёх месяцев.',
  },
  {
    question: 'Можно ли добавить свои метрики?',
    answer: 'Да. Например, маржинальность по категориям с учётом логистики или LTV клиента с данными из CRM. Настроим отчёт под ваш уникальный KPI.',
  },
  {
    question: 'Почему мы должны доверять этой аналитике?',
    answer: 'Данные обрабатываются алгоритмами. Ошибка будет заметна: показатели уйдут в ноль или в красную зону. В ручной аналитике больше звеньев, где может появиться незаметная погрешность.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'BI-аналитика и управленческие дашборды для торговли',
      serviceType: 'Разработка и внедрение BI-аналитики',
      url: biUrl,
      areaServed: 'RU',
      provider: {
        '@type': 'Organization',
        name: companyInfo.brandName,
        url: homeUrl,
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: companyInfo.brandName,
          item: homeUrl,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'BI-аналитика для торговли',
          item: biUrl,
        },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    },
  ],
};
---

<BaseLayout {title} {description} canonicalPath="/bi-analitika/" {structuredData}>
  <AppHeader />

  <main class="site-content">
    <section id="home" class={heroStyles['hero-section']}>
      <LineWave />
      <div class={heroStyles.container}>
        <h1 class={heroStyles.title}>BI-аналитика и дашборды для торговли</h1>
        <p class={heroStyles.subtitle}>Объединяем данные о продажах, остатках и маржинальности, чтобы управленческие решения принимались по фактам.</p>
        <div class={heroStyles.actions}>
          <a class={heroStyles.primaryAction} href="#demo">Посмотреть демо</a>
          <a class={heroStyles.secondaryAction} href={`${base}products/`}>Все решения</a>
        </div>
      </div>
    </section>

    <section class={styles.auditSection} aria-labelledby="audit-title">
      <div class={styles.container}>
        <header class={styles.editorialHeader}>
          <h2 id="audit-title">Сбросьте балласт</h2>
          <p>Увидьте товары, которые замораживают деньги, и принимайте решения о закупках на основе фактических продаж.</p>
        </header>

        <div class={styles.dashboardFrame}>
          <div class={styles.dashboardBar} aria-hidden="true">
            <span>Неликвид и оборачиваемость</span>
            <span>Публичное демо · DataLens</span>
          </div>
          <a class={styles.fullSizeLink} href={stockDashboardImage.src} target="_blank" rel="noopener noreferrer" aria-label="Открыть отчёт по товарным остаткам в полном размере — новая вкладка">
            <Image
              class:list={[styles.dashboardImage, styles.dashboardImageDesktop]}
              src={stockDashboardImage}
              alt="Демо-дашборд TrueTell: товарные остатки по категориям и товары без движения"
              widths={[480, 720, 960, 1320, 1920, 2640]}
              sizes="(max-width: 768px) calc(100vw - 32px), min(calc(100vw - 64px), 1320px)"
              format="webp"
              quality={95}
              loading="lazy"
            />
            <Image
              class:list={[styles.dashboardImage, styles.dashboardImageMobile]}
              src={stockMobileDashboardImage}
              alt="Крупный план демо-отчёта TrueTell: категории и товарные запасы за последние 30 дней"
              widths={[480, 720, 960, 1320]}
              sizes="calc(100vw - 32px)"
              format="webp"
              quality={95}
              loading="lazy"
            />
          </a>
        </div>
      </div>
    </section>

    <section class={styles.audienceSection} aria-labelledby="audience-title">
      <div class={styles.container}>
        <div class={styles.splitHeading}>
          <h2 id="audience-title">Кому мы подходим?</h2>
          <p>Решение для розничного бизнеса, которому нужна единая и проверяемая картина вместо разрозненных таблиц.</p>
        </div>

        <ul class={styles.audienceList}>
          {audience.map((item) => (
            <li>
              <span class={styles.listMarker} aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="m9 6 6 6-6 6"></path></svg>
              </span>
              <p>{item}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class={styles.painSection} aria-labelledby="pain-title">
      <div class={styles.container}>
        <div class={styles.splitHeading}>
          <h2 id="pain-title">Какие боли мы закрываем?</h2>
          <p>Находим места, где ручные решения, интересы поставщиков и непрозрачные остатки снижают прибыль.</p>
        </div>

        <div class={styles.painList}>
          {painPoints.map((item) => (
            <article>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="features" class={styles.solutionSection} aria-labelledby="solution-title">
      <div class={styles.container}>
        <div class={styles.solutionIntro}>
          <h2 id="solution-title">Решение</h2>
          <p>Дашборд, который связывает закупки, продажи, остатки и прибыльность в одной системе координат.</p>
        </div>

        <div class={styles.capabilityList}>
          {capabilities.map((item) => (
            <article>
              <span class={styles.listMarker} aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="m9 6 6 6-6 6"></path></svg>
              </span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
            </article>
          ))}
        </div>

        <div class={styles.profitPanel}>
          <div class={styles.profitCopy}>
            <h3>Нацельтесь на прибыль</h3>
            <p>Показатели по всем точкам на одном экране.</p>
          </div>
          <div class={styles.profitDashboard}>
            <a class={styles.fullSizeLink} href={storesDashboardImage.src} target="_blank" rel="noopener noreferrer" aria-label="Открыть сравнение магазинов в полном размере — новая вкладка">
              <Image
                class:list={[styles.dashboardImage, styles.dashboardImageDesktop]}
                src={storesDashboardImage}
                alt="Демо-дашборд TrueTell: сравнение магазинов по прибыли, выручке и числу чеков"
                widths={[480, 720, 960, 1200, 1760]}
                sizes="(max-width: 768px) calc(100vw - 32px), min(66vw, 880px)"
                format="webp"
                quality={95}
                loading="lazy"
              />
              <Image
                class:list={[styles.dashboardImage, styles.dashboardImageMobile]}
                src={storesMobileDashboardImage}
                alt="Крупный план демо-отчёта TrueTell: валовая прибыль по магазинам"
                widths={[480, 720, 960, 1320]}
                sizes="calc(100vw - 32px)"
                format="webp"
                quality={95}
                loading="lazy"
              />
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class={styles.productViewSection} aria-labelledby="product-view-title">
      <div class={styles.container}>
        <header class={styles.editorialHeader}>
          <h2 id="product-view-title">Как это выглядит</h2>
          <p>Продажи, клиенты и прибыль в одном рабочем пространстве. На скриншотах — демонстрационные данные; откройте отчёт, чтобы рассмотреть детали.</p>
        </header>

        <div class={styles.productImageFrame}>
          <a class={styles.fullSizeLink} href={overviewDashboardImage.src} target="_blank" rel="noopener noreferrer" aria-label="Открыть общий дашборд в полном размере — новая вкладка">
            <Image
              class={styles.productImageDesktop}
              src={overviewDashboardImage}
              alt="Демо-дашборд TrueTell: выручка, валовая прибыль и количество чеков по магазинам"
              widths={[768, 1100, 1440, 2160, 2640]}
              sizes="(max-width: 768px) calc(100vw - 32px), min(calc(100vw - 64px), 1320px)"
              format="webp"
              quality={95}
              loading="lazy"
            />
            <Image
              class={styles.productImageMobile}
              src={overviewMobileDashboardImage}
              alt="Крупный план графика выручки по магазинам в демо-дашборде TrueTell"
              widths={[480, 720, 960, 1100]}
              sizes="calc(100vw - 32px)"
              format="webp"
              quality={95}
              loading="lazy"
            />
          </a>
        </div>

        <div class={styles.reportGallery} aria-label="Примеры отчётов">
          {reportPreviews.map((report) => (
            <figure>
              <a class={styles.fullSizeLink} href={report.image.src} target="_blank" rel="noopener noreferrer" aria-label={`${report.title}: открыть отчёт в полном размере — новая вкладка`}>
                <Image
                  src={report.image}
                  alt={report.alt}
                  widths={[480, 720, 960, 1320, 1920, 2640]}
                  sizes="(max-width: 768px) calc(100vw - 32px), min(calc(100vw - 64px), 1320px)"
                  format="webp"
                  quality={95}
                  loading="lazy"
                />
              </a>
              <figcaption>{report.title}<span>Открыть в полном размере ↗</span></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section id="pricing" class={styles.pricingSection} aria-labelledby="pricing-title">
      <div class={styles.container}>
        <div class={styles.pricingLayout}>
          <div class={styles.pricingIntro}>
            <h2 id="pricing-title">Начните прямо сейчас</h2>
            <p>Испытайте перед покупкой: демо займёт одну минуту, и мы не попросим ваши контакты.</p>
            <a href={demoUrl} target="_blank" rel="noopener noreferrer">
              Протестировать демо
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"></path></svg>
            </a>
          </div>

          <div class={styles.priceList}>
            {pricing.map((item) => (
              <article>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </div>
                <p class={styles.price}>{item.price}{item.period && <small>{item.period}</small>}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="cases" class={styles.caseSection} aria-labelledby="case-title">
      <div class={styles.container}>
        <div class={styles.caseHeader}>
          <div class={styles.client}>
            <Image src={clientPhoto} alt="Дмитрий Баржин" width={120} height={120} format="webp" loading="lazy" />
            <div>
              <p>Дмитрий Баржин</p>
              <span>Владелец сети из 6 табачных магазинов AllSmoke</span>
            </div>
          </div>
          <h2 id="case-title">Результаты через месяц</h2>
        </div>

        <div class={styles.metrics}>
          {results.map((result) => (
            <article>
              <strong>{result.value}</strong>
              <p>{result.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class={styles.stepsSection} aria-labelledby="steps-title">
      <div class={styles.container}>
        <div class={styles.splitHeading}>
          <h2 id="steps-title">Этапы внедрения</h2>
          <p>Три понятных шага от текущей отчётности до работающего управленческого дашборда.</p>
        </div>

        <ul class={styles.stepsList}>
          {steps.map((step) => (
            <li>
              <span class={styles.listMarker} aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="m9 6 6 6-6 6"></path></svg>
              </span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class={styles.faqSection} aria-labelledby="faq-title">
      <div class={styles.container}>
        <h2 id="faq-title">Частые вопросы</h2>
        <div class={styles.accordion}>
          {faqItems.map((item) => (
            <details name="bi-faq">
              <summary>
                <span>{item.question}</span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
              </summary>
              <div><p>{item.answer}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section id="demo" class={styles.ctaSection} aria-labelledby="cta-title">
      <LineWave />
      <div class={styles.container}>
        <div class={styles.ctaContent}>
          <div>
            <h2 id="cta-title">Поднимите прибыльность на 5% уже в этом месяце</h2>
            <p>Попробуйте сами — демо займёт одну минуту, и мы не попросим ваши контакты.</p>
          </div>
          <div class={styles.ctaActions}>
            <a class={styles.primaryAction} href={demoUrl} target="_blank" rel="noopener noreferrer">Протестировать демо</a>
            <a class={styles.secondaryAction} href={companyInfo.contacts.consultationUrl}>Или напишите нам, мы же люди</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
