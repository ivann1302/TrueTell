---
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import Checklist from '../../components/editorial/checklist.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { cleanerProduct } from '../../config/products';
import spaceImage from '../../images/articles/bitrix24-cleanup-space-official.jpg';
import mergeImage from '../../images/articles/bitrix24-merge-preview-official.jpg';
import cleanerImage from '../../images/products/cleaner-selection.png';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';

const article = getArticle('ochistka-crm-bitrix24/');
const { title, description } = article;
const canonicalPath = `/${article.hrefPath}`;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const cleanerHref = `${base}${article.relatedProduct!.slice(1)}`;
const imageAlt = 'Штатная Очистка CRM в Битрикс24: таблица Чем занято место с объёмом данных и файлов';
const ogImage = new URL(spaceImage.src, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const titleParts = [{ text: 'Очистка CRM в Битрикс24: ' }, { text: 'дубли, старые данные', accent: true }, { text: ' и место в базе' }];
const sourceLinks = [
  { label: 'Как освободить место в CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/26995556/' },
  { label: 'Место в облаке: как узнать, чем оно занято — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/18354376/' },
  { label: 'Как объединить дубликаты в CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/25343258/' },
  { label: 'Автоматическое объединение дубликатов — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/25368844/' },
  { label: 'Как передать элементы CRM уволенного сотрудника — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/18001440/' },
  { label: 'Ролевая модель прав в CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/23240636/' },
  { label: 'Как экспортировать данные из CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/20966844/' },
  { label: 'Что такое Корзина в CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/24668648/' },
  { label: 'Как удалить элементы CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/23238660/' },
];
const decisionRows = [
  ['Один клиент в нескольких карточках', 'Проверить и объединить дубли', 'Основную карточку, разные значения полей и связи'],
  ['Сделки остались у бывшего менеджера', 'Передать карточки и отдельно назначенные дела', 'Нового ответственного и продолжение работы с клиентами'],
  ['Пустые или противоречивые поля', 'Уточнить и исправить данные', 'Источник верного значения и назначение поля'],
  ['Тестовые или согласованные ненужные записи', 'Удалить проверенную выборку', 'ID, исключения, выгрузку и последствия для отчётов'],
  ['Не хватает места в CRM', 'Проверить занимаемый объём и штатную очистку', 'Какие данные дают объём и что допустимо убрать'],
  ['Не хватает места для файлов', 'Проверить файловое хранилище и Диск', 'Владельцев, версии и необходимость самих файлов'],
];
const reviewSteps = [
  { title: 'Сформулируйте результат', description: 'Например: передать незавершённую работу, объединить подтверждённые дубли или освободить конкретный объём. «Удалить старое» не задаёт достаточных критериев.' },
  { title: 'Разделите записи по решениям', description: 'Для каждой группы зафиксируйте: оставить, исправить, передать, объединить или удалить. Согласуйте спорные карточки с теми, кто работает с клиентами.' },
  { title: 'Сохраните данные и условия отбора', description: 'Запишите фильтр, количество и ID. Откройте выгрузку до изменения CRM; отдельно определите, как сохранить необходимые файлы и историю.' },
  { title: 'Проверьте небольшую согласованную группу', description: 'После изменения убедитесь, что сохранены нужные значения, связи и рабочие процессы. Масштабируйте только после этой проверки.' },
  { title: 'Сверьте результат с исходной задачей', description: 'Проверьте ID, ответственных, дубли или объём хранилища — тот показатель, ради которого начали очистку. Сохраните результат и исключения.' },
];
const faqItems = [
  { question: 'Где находится «Очистка CRM» в Битрикс24?', answer: 'Откройте CRM → Ещё → Настройки → Настройки CRM → Другое → Чем занято место. Начните со сканирования. Это инструмент анализа и очистки занимаемого места; работа с дублями и передача клиентов выполняются отдельно.' },
  { question: 'Можно ли очистить CRM, сохранив нужных клиентов?', answer: 'Да, начните с разделения задач. Подтверждённые дубли объединяют, незавершённые карточки передают другому сотруднику, ошибки полей исправляют. Удаление оставляют для проверенной ненужной выборки. Полную сохранность истории при любом действии обещать нельзя — заранее определите, что требуется сохранить.' },
  { question: 'Умеет ли Битрикс24 автоматически объединять дубли сделок?', answer: 'Официальная инструкция описывает автоматическое объединение для лидов, контактов и компаний, с ограничениями по тарифу и совпадению данных. Для сделок доступен отдельный сценарий ручного объединения с выбором основной карточки и значений полей.' },
  { question: 'Нужно ли удалять сделки уволенного менеджера?', answer: 'Увольнение сотрудника не означает, что его сделки больше не нужны. Передайте полезные карточки новому ответственному. Назначенные дела нужно проверить и передать отдельно: смена ответственного карточки сама по себе не завершает эту работу.' },
  { question: 'Почему после удаления карточек место не освободилось?', answer: 'Проверьте корзину: находящиеся в ней элементы продолжают занимать объём. Кроме того, место могут занимать файлы. Сравнивайте показатели хранилища, а не только количество строк в CRM; окончательно удалить элементы из корзины может только администратор. Это отдельное необратимое действие.' },
  { question: 'Может ли Cleaner TrueTell очистить всю CRM от дублей и файлов?', answer: 'Нет. Приложение предназначено для удаления заранее выбранных лидов и сделок с проверкой списка, исключениями и CSV. Оно не объединяет дубли, не исправляет значения полей, не переназначает работу и не очищает Диск, контакты или компании.' },
];
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const structuredData = createArticleStructuredData({ articleType: 'Article', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt, publisherUrl: siteRoot.toString(), author: authorName,
  image: ogImage, articleSection: 'Порядок в CRM Битрикс24',
  breadcrumbs: [{ name: 'Главная', item: siteRoot.toString() }, { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() }, { name: title, item: articleUrl }], faqItems,
});
---

<ArticleLayout {title} {titleParts} {description} {canonicalPath} {structuredData}
  ogTitle={article.seoTitle} ogDescription={description} {ogImage} ogImageAlt={imageAlt}
  category={article.category} author={authorName}
  intro="Как навести порядок в клиентской базе: выбрать нужное действие, сохранить полезные данные и отдельно разобраться с занимаемым местом."
>
  <Fragment slot="quick-answer">
    <p>Начните с причины: <strong>дубли объединяют, работу передают, ошибки исправляют</strong>. Удаляйте только записи, которые проверили и признали ненужными.</p>
    <p>Если заканчивается место, откройте <strong>«Чем занято место»</strong> в настройках CRM и выполните сканирование. Удаление карточек, очистка истории и работа с файлами имеют разные последствия.</p>
  </Fragment>

  <p data-article-lead>Сначала определите, какие данные мешают работе, что должно измениться после очистки и как вы проверите результат. Иначе легко сократить список карточек, не решив исходную задачу.</p>

  <section aria-labelledby="choose-action">
    <h2 id="choose-action">Сначала выберите <span data-heading-accent>задачу очистки</span></h2>
    <p>Большое количество карточек само по себе не означает беспорядок. Закрытая сделка может быть нужна для аналитики и повторной продажи, а две записи с одним телефоном — относиться к разным обращениям. Решение принимайте по содержимому и назначению данных.</p>
    <DataTable label="Как выбрать способ очистки CRM" columns={['Что мешает', 'С чего начать', 'Что проверить']} rows={decisionRows} rowHeaders compact />
    <p>Например, если у менеджера сотни старых сделок без следующего действия, сначала выясните, какие переговоры нужно продолжить. Удаление сократит список, но не восстановит работу с клиентами. А если проблема — несколько гигабайт ненужных файлов, перенос ответственного не уменьшит занимаемый ими объём.</p>
  </section>

  <section aria-labelledby="native-cleanup">
    <h2 id="native-cleanup">Где найти штатную <span data-heading-accent>«Очистку CRM»</span></h2>
    <p>Путь: <strong>CRM → Ещё → Настройки → Настройки CRM → Другое → Чем занято место</strong>. Нажмите «Начать сканирование» и не закрывайте страницу до окончания. Результат покажет распределение объёма по данным CRM.</p>
    <ArticleFigure src={spaceImage} alt={imageAlt} fullSize caption="Официальный скриншот Поддержки24: таблица «Чем занято место» разделяет размер таблиц в базе и файлов. Числа 14,93 МБ и 429,47 КБ относятся к примеру из справки, а не к порталу TrueTell или данным клиента." />
    <p>Через меню строки доступны разные действия: удалить элементы либо их дела и историю. Для ограниченного отбора предусмотрены дата создания и группа стадий. После операции повторите сканирование. <a href={sourceLinks[0].href} target="_blank" rel="noopener noreferrer">Инструкция по штатной очистке CRM</a>.</p>
    <p>Удаление дел и истории — изменение рабочих данных, а не архивация. До запуска согласуйте, какие комментарии, события и сведения о работе необходимо сохранить. Дата создания карточки не равна дате закрытия сделки.</p>
    <h3 id="database-or-files">Проверьте, что именно занимает место</h3>
    <p>В разделе <strong>Мой тариф → Открыть лимиты → Место в облаке</strong> можно посмотреть общий объём хранилища. Битрикс24 различает данные базы и файлы; в «Занято другим» учитываются, в частности, файлы Диска и других инструментов. Если основной объём дают файлы, отдельно проверьте их источник и владельца. <a href={sourceLinks[1].href} target="_blank" rel="noopener noreferrer">Как устроен учёт места в облаке</a>.</p>
    <p>Не удаляйте сделки наугад ради уменьшения общего счётчика. Сначала сопоставьте большой раздел с теми данными, которые компания действительно готова убрать. Элементы в корзине продолжают занимать место, поэтому сокращение активного списка не доказывает освобождение объёма.</p>
  </section>

  <section aria-labelledby="duplicates">
    <h2 id="duplicates">Как разобрать <span data-heading-accent>и объединить дубли</span></h2>
    <p>Если записи описывают одного клиента, сначала сравните реквизиты, телефоны, ответственных и связанные сделки. Похожие имена или общий корпоративный номер ещё не доказывают, что перед вами один человек. Удалив одну карточку без проверки, можно потерять нужные сведения.</p>
    <p>При ручном объединении выбирают основную карточку и сохраняемые значения полей. Предварительный результат помогает проверить, что останется после операции. Остальные объединяемые карточки удаляются. Для этого нужны соответствующие права на изменение и удаление. <a href={sourceLinks[2].href} target="_blank" rel="noopener noreferrer">Как объединять дубликаты вручную</a>.</p>
    <ArticleFigure src={mergeImage} alt="Объединение контактов в Битрикс24: основная карточка, выбор значений и предварительный результат слева" fullSize caption="Официальный пример Поддержки24: ручное объединение контактов с выбором основной карточки и значений. Снимок показывает проверку результата до подтверждения, а не автоматическое решение о том, какие записи являются дублями." />
    <p>Автоматический контроль дубликатов описан для <strong>лидов, контактов и компаний</strong> и доступен не на всех тарифах. Автоматическое объединение требует совпадения данных и ответственного; для лидов учитывается также стадия. Сделки не следует относить к этому автоматическому сценарию: для них справка описывает ручное объединение. <a href={sourceLinks[3].href} target="_blank" rel="noopener noreferrer">Ограничения автоматического объединения</a>.</p>
    <p>После объединения откройте основную карточку и проверьте нужные значения и связи. Если это две разные покупки одного клиента, общая контактная информация не делает сделки дублями.</p>
    <p>Если разбираете именно лиды, смотрите <a href={base + 'dubli-lidov-bitrix24/'}>пошаговую проверку и объединение дублей лидов</a>: там отдельно разобраны повторные обращения и последствия запуска сканирования.</p>
  </section>

  <section aria-labelledby="responsibility-and-fields">
    <h2 id="responsibility-and-fields">Карточки бывших сотрудников <span data-heading-accent>и ошибки в полях</span></h2>
    <p>Сделки уволенного менеджера сначала разберите по возможности продолжить работу. Полезные карточки передайте новому ответственному. В списке CRM для этого есть отбор по ответственному, включая вкладку уволенных сотрудников, и групповая смена ответственного.</p>
    <p><strong>Назначенные дела передают отдельно.</strong> После изменения карточек проверьте, у кого остались звонки, встречи и другие действия. Иначе клиент появится у нового менеджера, а запланированная работа останется за прежним. <a href={sourceLinks[4].href} target="_blank" rel="noopener noreferrer">Передача элементов CRM после увольнения сотрудника</a>.</p>
    <p>Пустое поле тоже не является основанием удалить карточку. Определите, какие сведения обязательны для текущего процесса, где взять достоверное значение и кто его проверит. Например, отсутствие источника обращения может искажать отчёт, но исправлять его предположением «всем поставить сайт» нельзя.</p>
    <p>Прежде чем убирать сами пользовательские поля, проверьте их участие в формах, роботах, отчётах и интеграциях. Порядок такой проверки разобран в <a href={`${base}audit-poley-crm-bitrix24/`}>статье об аудите полей CRM</a>. Очистка значений и удаление поля — разные изменения.</p>
  </section>

  <section aria-labelledby="delete-unneeded">
    <h2 id="delete-unneeded">Когда переходить <span data-heading-accent>к удалению</span></h2>
    <p>Удаление уместно для проверенных тестовых записей и других групп, по которым согласовано, что история больше не нужна. Возраст карточки, отказ или увольнение ответственного не заменяют такого решения. Удалённые элементы перестают учитываться в аналитических отчётах — необходимые показатели сохраните заранее. <a href={sourceLinks[8].href} target="_blank" rel="noopener noreferrer">Последствия удаления элементов CRM</a>.</p>
    <p>Перед операцией проверьте разрешения: чтение, изменение, удаление и экспорт — отдельные права. Доступ может различаться между сущностями и воронками. <a href={sourceLinks[5].href} target="_blank" rel="noopener noreferrer">Роли и права в CRM</a>.</p>
    <p>Скачайте и откройте выгрузку нужной выборки. CSV и Excel не являются полной копией файлов, связей и истории портала. Штатный экспорт ориентируется на фильтр списка, а не на выделение галочками; при товарной детализации одна сделка может занять несколько строк. <a href={sourceLinks[6].href} target="_blank" rel="noopener noreferrer">Правила экспорта CRM</a>.</p>
    <p>Пошаговые операции вынесены в отдельные инструкции: <a href={`${base}massovoe-udalenie-lidov-bitrix24/`}>массовое удаление лидов</a>, <a href={`${base}massovoe-udalenie-sdelok-bitrix24/`}>удаление выбранных сделок и всех страниц фильтра</a>, <a href={`${base}udalenie-kontaktov-bitrix24/`}>удаление контактов</a> и <a href={`${base}udalenie-kompaniy-bitrix24/`}>компаний</a>. Для отбора отказов смотрите <a href={`${base}udalenie-proigrannyh-sdelok-bitrix24/`}>разбор проигранных сделок</a>.</p>
    <p>Заранее проверьте корзину, тариф и условия восстановления. Корзину для некоторых типов элементов можно отключить, а восстановление доступно не на каждом тарифе. После окончательного удаления рассчитывать на неё нельзя. <a href={sourceLinks[7].href} target="_blank" rel="noopener noreferrer">Условия работы корзины CRM</a>.</p>
  </section>

  <section aria-labelledby="cleaner-role">
    <h2 id="cleaner-role">Что берёт на себя <span data-heading-accent>Cleaner TrueTell</span></h2>
    <p>Когда решение об удалении лидов или сделок уже принято, Cleaner показывает выборку, позволяет исключить важные карточки и подготовить CSV выбранных записей. До подтверждения проверьте, удаётся ли сохранить или скопировать CSV в вашем браузере. Для работы нужен администратор; предел одного отбора — 3000 записей.</p>
    <ArticleFigure src={cleanerImage} alt="Cleaner TrueTell: предварительный список сделок, исключённая карточка и CSV выбранных записей" fullSize caption="Демонстрационный экран Cleaner TrueTell: найдено 120 сделок, одна исключена, выбрано 119. На снимке действует режим «Доступно только чтение»; он иллюстрирует проверку списка, а не удаление данных на клиентском портале." />
    <p>Cleaner не ищет и не объединяет дубли, не исправляет поля, не меняет ответственных и не удаляет контакты, компании или файлы Диска. Он решает конкретную часть общей очистки CRM. Перед установкой проверьте актуальное описание, подписку и доступность нужного сценария в вашем портале.</p>
    <p>После операции Cleaner показывает результат по ID и предусматривает CSV-отчёт. Получение итогового файла в установленном приложении и удаление на клиентском портале ещё не прошли приёмку. Остановка прекращает новые запросы, но не отменяет уже отправленные. CSV не даёт полного отката CRM — необходимые данные и допустимые последствия определяют до запуска.</p>
    <InlineConsultation variant="product" title="Нужен проверяемый список на удаление?" description="Посмотрите сценарий работы, фильтры и ограничения приложения для лидов и сделок." href={cleanerHref} actionLabel={cleanerProduct.articleActionLabel} />
  </section>

  <section aria-labelledby="review-and-prevention">
    <h2 id="review-and-prevention">Как принять результат <span data-heading-accent>и не накопить беспорядок снова</span></h2>
    <Checklist items={reviewSteps} label="Порядок проверки очистки CRM" />
    <p>Сохраните итог проверки: исходное и конечное значение целевого показателя, контрольные ID и исключения. Число оставшихся карточек само по себе не показывает качество очистки.</p>
    <p>После очистки найдите источник повторного накопления: повторный импорт, создание карточек интеграцией, непонятные правила заполнения или отсутствие передачи клиентов. Назначьте ответственного за проверку этих причин и подходящую периодичность. Без этого очередное удаление лишь ненадолго уменьшит список.</p>
  </section>

  <FaqSection items={faqItems} id="faq" variant="article" />
  <ArticleSources publishedIso={article.publishedAt} sources={sourceLinks} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Лиды и сделки: ' }, { text: 'проверка перед удалением', accent: true }]} description="Cleaner TrueTell помогает проверить выбранные карточки, исключить важные и подготовить CSV. Перед удалением проверьте, что можете сохранить или скопировать CSV выбранных карточек." href={cleanerProduct.marketplaceUrl} actionLabel={cleanerProduct.connectionActionLabel} />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <Fragment slot="after-article"><ConsultationCtaSection /></Fragment>
</ArticleLayout>
