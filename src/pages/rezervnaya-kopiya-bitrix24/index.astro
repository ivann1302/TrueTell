---
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import comparisonImage from '../../images/articles/bitrix24-backup-options-105.png';
import exportImage from '../../images/articles/bitrix24-export-columns-official.jpg';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';

const article = getArticle('rezervnaya-kopiya-bitrix24/');
const title = article.title;
const seoTitle = article.seoTitle ?? title;
const description = article.description;
const canonicalPath = '/' + article.hrefPath;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const ogImage = new URL(comparisonImage.src, siteRoot).toString();
const ogImageAlt = 'Сравнение трёх способов сохранить данные Битрикс24: облачный бэкап, коробочный архив и экспорт CRM';
const titleParts = [
  { text: 'Резервная копия Битрикс24 ' },
  { text: 'перед очисткой: что сохранить', accent: true },
];
const sourceLinks = [
  { label: 'Как восстановить данные в Битрикс24 — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/24955644/' },
  { label: 'Как экспортировать данные из CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/20966844/' },
  { label: 'Что такое Корзина в CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/24668648/' },
  { label: 'Различия облачной и коробочной версий — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/23155430/' },
  { label: 'Создание резервной копии коробочной версии — 1С-Битрикс', href: 'https://dev.1c-bitrix.ru/learning/course/index.php?COURSE_ID=48&LESSON_ID=5330&LESSON_PATH=3918.4633.4833.5330&MID=' },
  { label: 'Частые вопросы о CRM: импорт и экспорт дел — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/25817644/' },
];
const methodRows = [
  ['Облачная резервная копия', 'Ежедневная копия портала на стороне Битрикс24', 'Полный возврат портала через поддержку за доступную дату; зависит от тарифа'],
  ['Архив коробочной версии', 'База данных и файлы по выбранным настройкам', 'Администратор создаёт и проверяет архив; состав и порядок восстановления зависят от конфигурации'],
  ['Экспорт CRM', 'Поля отобранных лидов, сделок и других доступных элементов', 'Файл для сверки и переноса части данных; не возвращает портал целиком'],
];
const faqItems = [
  {
    question: 'Можно ли сделать резервную копию облачного Битрикс24 прямо перед очисткой?',
    answer: 'Официальная справка описывает ежедневные автоматические копии и восстановление через поддержку. Самостоятельную кнопку создания полной копии облачного портала на нужную минуту она не описывает. Перед очисткой проверьте условия тарифа и сохраните доступные данные отдельным экспортом.',
  },
  {
    question: 'Сколько хранятся резервные копии облачного Битрикс24?',
    answer: 'По официальной справке Битрикс24, автоматические копии хранятся семь дней. Это правило относится к описанному облачному сценарию; для коробочной версии порядок резервирования задаётся отдельно.',
  },
  {
    question: 'Можно ли восстановить из бэкапа одну удалённую сделку?',
    answer: 'Описанное Битрикс24 восстановление из облачной копии возвращает весь портал к выбранной дате. Сначала проверьте корзину CRM: отдельную сделку можно вернуть оттуда, если запись ещё доступна и тариф поддерживает восстановление.',
  },
  {
    question: 'Что потеряется при полном откате портала?',
    answer: 'Битрикс24 предупреждает, что изменения после выбранной даты будут удалены. Перед решением администратору нужно оценить, какие новые записи и действия команды затронет откат.',
  },
  {
    question: 'Достаточно ли выгрузить сделки в Excel или CSV?',
    answer: 'Файл помогает сохранить экспортируемые поля и сверить выбранные записи. Он не является полной копией портала с файлами, делами, историей и настройками. Импорт и экспорт дел CRM, согласно справке Битрикс24, недоступен.',
  },
  {
    question: 'Как сделать копию коробочного Битрикс24?',
    answer: 'Для коробочной версии официальная документация описывает создание архива в административной части: Настройки → Инструменты → Резервное копирование → Создание резервной копии. Администратор должен проверить состав, место хранения и возможность восстановления архива.',
  },
  {
    question: 'Что делать, если удаление уже произошло?',
    answer: 'Остановите следующие операции и проверьте корзину нужного раздела. Для CRM это CRM → Ещё → Корзина. Если нужных данных там нет, администратор может оценить с поддержкой полный откат облачного портала и потери изменений после даты копии.',
  },
];
const relatedArticles = getRelatedArticles(article.hrefPath)
  .map((item) => ({ ...item, description: item.summaryDescription ?? item.description, href: base + item.hrefPath }));
const structuredData = createArticleStructuredData({
  articleType: 'Article',
  title,
  description,
  articleUrl,
  publishedDate: article.publishedAt,
  modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(),
  author: authorName,
  image: ogImage,
  articleSection: 'Сохранение данных Битрикс24',
  breadcrumbs: [
    { name: 'Главная', item: siteRoot.toString() },
    { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() },
    { name: title, item: articleUrl },
  ],
  faqItems,
});
---

<ArticleLayout
  title={seoTitle} {titleParts} {description} {canonicalPath} {structuredData}
  ogTitle={seoTitle} ogDescription={description} {ogImage} {ogImageAlt}
  category={article.category} author={authorName}
  publishedTime={article.publishedAt} modifiedTime={article.updatedAt}
  intro="Перед массовой очисткой хочется иметь точку возврата. В облачном Битрикс24 полное восстановление зависит от автоматической копии и выполняется через поддержку; выгрузку нужных записей CRM готовят отдельно. Для коробочной версии порядок другой."
>
  <Fragment slot="quick-answer">
    <p>В <strong>облачном Битрикс24</strong> копии создаются автоматически каждый день и хранятся семь дней. Администратор запрашивает восстановление через поддержку; откатывается <strong>весь портал</strong>, а изменения после выбранной даты теряются. Возможность зависит от тарифа.</p>
    <p>Прямо перед очисткой сохраните проверенную выгрузку нужных элементов CRM и отдельно определите, какие файлы, дела и настройки критичны. Excel или CSV помогает со сверкой, но не даёт полного возврата портала. В коробочной версии архив создаёт и проверяет администратор.</p>
  </Fragment>

  <p>Вопрос «есть ли резервная копия?» лучше решить до удаления. У облачного портала, коробочной установки и выгрузки CRM разные способы возврата данных. Если перепутать их, можно сохранить таблицу сделок, но остаться без удобного способа вернуть весь рабочий контекст.</p>

  <section aria-labelledby="three-methods">
    <h2 id="three-methods">Три способа <span data-heading-accent>сохранить данные</span></h2>
    <p>Сначала уточните, где работает ваш Битрикс24. Облачный портал обслуживает Битрикс24; коробочная версия установлена на сервере компании. Экспорт CRM доступен как отдельная операция с выбранными элементами и полями. У каждого способа свой результат.</p>
    <ArticleFigure src={comparisonImage} fullSize portrait alt="Облако: ежедневная копия и полный откат через поддержку; коробка: архив администратора; экспорт: поля выбранных CRM-записей" caption="Сравнение TrueTell по официальной документации. Срок семь дней относится к облачному сценарию, не к коробочной версии или файлу экспорта. Иллюстрация не показывает интерфейс Битрикс24." />
    <DataTable label="Что дают облачная копия, коробочный архив и экспорт CRM" columns={['Способ', 'Что сохраняется', 'Как возвращать']} rows={methodRows} rowHeaders compact />
    <p>Битрикс24 называет экспорт «резервной копией данных» для конкретных сущностей CRM. Такой файл действительно полезен. Но он не равен полной копии портала: штатная выгрузка не сохраняет всё, что видно в карточках и других разделах. Например, <a href={sourceLinks[5].href} target="_blank" rel="noopener noreferrer">импорт и экспорт дел CRM пока недоступен</a>.</p>
  </section>

  <section aria-labelledby="cloud-backup">
    <h2 id="cloud-backup">Как работает резервная копия <span data-heading-accent>облачного Битрикс24</span></h2>
    <p>По <a href={sourceLinks[0].href} target="_blank" rel="noopener noreferrer">официальной инструкции</a>, Битрикс24 ежедневно создаёт копии и хранит их семь дней. Восстановление на выбранную дату выполняет поддержка по запросу администратора и доступно не на всех тарифах. Поддержка проверяет наличие подходящей копии; во время операции портал временно блокируется.</p>
    <p>В инструкции не описана самостоятельная кнопка, которая создаёт полную копию облачного портала именно за минуту до очистки. Поэтому не стоит строить план на предположении, что в случае ошибки получится выбрать любую нужную минуту. До операции администратор должен проверить тариф, доступный порядок обращения в поддержку и последствия отката.</p>
    <p>Полный возврат затронет работу всех сотрудников. Всё, что команда изменила после выбранной даты, будет удалено. Если из CRM пропала одна сделка, такой откат может причинить больше потерь, чем ошибка. Сначала проверьте <a href={base + 'udalennye-sdelki-bitrix24/'}>корзину и восстановление отдельной сделки</a>.</p>
  </section>

  <section aria-labelledby="box-backup">
    <h2 id="box-backup">Если Битрикс24 работает <span data-heading-accent>в коробке</span></h2>
    <p>Коробочная версия хранит данные на сервере компании. Администратору доступно резервное копирование в административной части: Настройки → Инструменты → Резервное копирование → Создание резервной копии. <a href={sourceLinks[4].href} target="_blank" rel="noopener noreferrer">Документация 1С-Битрикс</a> описывает архив базы данных и файлов, варианты хранения и список созданных копий.</p>
    <p>Перед очисткой попросите администратора проверить завершение копирования, состав архива, место хранения и порядок восстановления. Настройки позволяют исключать файлы и таблицы, поэтому само наличие архива ещё не доказывает, что в нём есть всё необходимое. Срок семь дней и процедура полного отката через поддержку из облачной инструкции на коробочную установку не переносятся.</p>
  </section>

  <section aria-labelledby="export-crm">
    <h2 id="export-crm">Что сохранить <span data-heading-accent>из CRM перед очисткой</span></h2>
    <p>Для облачного портала практический шаг — выгрузить нужные лиды, сделки, контакты и другие доступные элементы в Excel или CSV. Штатный экспорт берёт текущий список по фильтру и доступные для выгрузки поля; права на экспорт настраиваются по типам элементов. Сохраните условия отбора и число уникальных ID, затем откройте готовый файл и сравните несколько строк с исходными карточками.</p>
    <ArticleFigure src={exportImage} fullSize alt="Официальный пример экспорта лидов Битрикс24 в Excel с полями и идентификаторами" caption="Скриншот Поддержки24: демонстрационный файл экспорта лидов. Он иллюстрирует выгруженные поля и ID, а не полную резервную копию портала. Проверяйте собственный файл до удаления." />
    <p>Пошаговый выбор полей, формата и проверка выгрузки разобраны в <a href={base + 'eksport-lidov-sdelok-bitrix24-pered-udaleniem/'}>отдельной инструкции по экспорту лидов и сделок</a>. Сохраните также сведения, которые в обычный файл не попадают, по правилам вашей компании: документы, важные договорённости и настройки процесса. Для них нужен отдельный план, согласованный с ответственными за данные.</p>
    <p>Файл с клиентскими данными храните с ограниченным доступом. Перед удалением ещё раз сравните фильтр в CRM с сохранённой выборкой: за время подготовки карточки могли измениться.</p>
  </section>

  <section aria-labelledby="before-cleanup">
    <h2 id="before-cleanup">Что согласовать <span data-heading-accent>до массовой очистки</span></h2>
    <p>Зафиксируйте цель, границы операции и ответственного за решение: какие сущности и воронки затрагиваются, какие ID исключены, кто проверяет выгрузку. Для облачного портала уточните тарифные условия и порядок обращения в поддержку. Наличие подходящей копии поддержка проверит по запросу. Не называйте сохранённый CSV «точкой восстановления» всего портала.</p>
    <p>Проведите пробную операцию на небольшой согласованной выборке, проверьте результат и только затем расширяйте действие. Порядок отбора и проверки сделок описан в <a href={base + 'massovoe-udalenie-sdelok-bitrix24/'}>инструкции по массовому удалению</a>. Если задача шире удаления, начните с <a href={base + 'ochistka-crm-bitrix24/'}>выбора способа очистки CRM</a>: иногда записи лучше исправить, объединить или передать другому сотруднику.</p>
    <InlineConsultation title="Планируете большую очистку CRM?" description="Поможем сверить выборку, выгрузки и последствия возможного отката до удаления данных." actionLabel="Обсудить план" />
  </section>

  <section aria-labelledby="after-error">
    <h2 id="after-error">Если данные <span data-heading-accent>уже удалены</span></h2>
    <p>Остановите следующие операции и определите масштаб: какие элементы исчезли и когда. Для CRM сначала откройте CRM → Ещё → Корзина. Администратор видит все удалённые элементы; сотрудник — только удалённые им самим. Восстановление из корзины зависит от тарифа, настройки типа элемента и того, сохранилась ли запись.</p>
    <p>Если корзина не помогает, администратор может обратиться в поддержку по поводу полного восстановления облачного портала. Сравните пользу возврата с потерей всех изменений после выбранной даты и заранее сообщите команде о возможной временной недоступности. Выгрузка CRM может помочь сверить утраченные записи или частично перенести данные, но не восстановит прежнюю карточку с полной историей одной командой.</p>
  </section>

  <FaqSection items={faqItems} id="faq" variant="article" />
  <ArticleSources publishedIso={article.publishedAt} sources={sourceLinks} />
  <Fragment slot="article-end"><RelatedArticles items={relatedArticles} /></Fragment>
  <Fragment slot="after-article"><ConsultationCtaSection title="Нужно подготовить очистку без потери рабочих данных?" description="Разберём состав выборки, доступные выгрузки и порядок проверки результата." actionLabel="Обсудить задачу" /></Fragment>
</ArticleLayout>
