---
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import idCheckImage from '../../images/articles/bitrix24-backup-id-check-166.png';
import boxBackupImage from '../../images/articles/bitrix24-box-backup-list-official-166.png';
import exportImage from '../../images/articles/bitrix24-export-columns-official.jpg';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';

const article = getArticle('rezervnaya-kopiya-bitrix24/');
const title = article.title;
const seoTitle = article.seoTitle ?? title;
const description = article.description;
const canonicalPath = '/' + article.hrefPath;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const ogImage = new URL(idCheckImage.src, siteRoot).toString();
const ogImageAlt = 'Учебная сверка ID. В плане сделки 314, 318 и 420, в файле 314, 318 и 598';
const titleParts = [
  { text: 'Резервная копия Битрикс24 ' },
  { text: 'перед очисткой: что сохранить', accent: true },
];
const sourceLinks = [
  { label: 'Как восстановить данные в Битрикс24 — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/24955644/' },
  { label: 'Как экспортировать данные из CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/20966844/' },
  { label: 'Что такое Корзина в CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/24668648/' },
  { label: 'Различия облачной и коробочной версий — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/23155430/' },
  { label: 'Создание резервной копии коробочной версии — 1С-Битрикс', href: 'https://dev.1c-bitrix.ru/learning/course/index.php?COURSE_ID=48&LESSON_ID=5330&LESSON_PATH=3918.4633.4833.5330&MID=' },
  { label: 'Частые вопросы о CRM: импорт и экспорт дел — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/25817644/' },
  { label: 'Поддерживаемые СУБД коробочной версии — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/5825131/' },
  { label: 'Резервная копия перед обновлением коробочной версии — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/24668808/' },
];
const methodRows = [
  ['Облачная резервная копия', 'Ежедневная копия портала на стороне Битрикс24', 'Полное восстановление через поддержку на доступную дату, если тариф его поддерживает'],
  ['Архив коробочной версии', 'База данных и файлы по выбранным настройкам', 'Администратор проверяет состав архива и восстанавливает данные по процедуре своей установки'],
  ['Экспорт CRM', 'Поля отобранных лидов, сделок и других доступных элементов', 'Сверка записей и перенос экспортируемых полей'],
];
const faqItems = [
  {
    question: 'Можно ли сделать резервную копию облачного Битрикс24 прямо перед очисткой?',
    answer: 'Официальная справка описывает ежедневные автоматические копии и восстановление через поддержку. Самостоятельную кнопку создания полной копии облачного портала на нужную минуту она не описывает. Перед очисткой проверьте условия тарифа и сохраните доступные данные отдельным экспортом.',
  },
  {
    question: 'Сколько хранятся резервные копии облачного Битрикс24?',
    answer: 'По официальной справке Битрикс24, автоматические копии хранятся семь дней. Это правило относится к описанному облачному сценарию; для коробочной версии порядок резервирования задаётся отдельно.',
  },
  {
    question: 'Можно ли восстановить из бэкапа одну удалённую сделку?',
    answer: 'Описанное Битрикс24 восстановление из облачной копии возвращает весь портал к выбранной дате. Сначала проверьте корзину CRM: отдельную сделку можно вернуть оттуда, если запись ещё доступна и тариф поддерживает восстановление.',
  },
  {
    question: 'Что потеряется при полном откате портала?',
    answer: 'Битрикс24 предупреждает, что изменения после выбранной даты будут удалены. Перед решением администратору нужно оценить, какие новые записи и действия команды затронет откат.',
  },
  {
    question: 'Достаточно ли выгрузить сделки в Excel или CSV?',
    answer: 'Экспорт сохраняет доступные поля выбранных сделок. Полную копию портала готовят отдельно. В штатном мастере Битрикс24 экспорт и импорт дел CRM недоступны.',
  },
  {
    question: 'Как сделать копию коробочного Битрикс24?',
    answer: 'Для коробки на MySQL откройте в административной части «Настройки» → «Инструменты» → «Резервное копирование» → «Создание резервной копии». Для PostgreSQL согласуйте с администратором процедуру копирования базы и файлов.',
  },
  {
    question: 'Что делать, если удаление уже произошло?',
    answer: 'Остановите следующие операции и проверьте корзину нужного раздела. Для CRM это CRM → Ещё → Корзина. Если нужных данных там нет, администратор может оценить с поддержкой полный откат облачного портала и потери изменений после даты копии.',
  },
];
const relatedArticles = getRelatedArticles(article.hrefPath)
  .map((item) => ({ ...item, description: item.summaryDescription ?? item.description, href: base + item.hrefPath }));
const structuredData = createArticleStructuredData({
  articleType: 'Article',
  title,
  description,
  articleUrl,
  publishedDate: article.publishedAt,
  modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(),
  author: authorName,
  image: ogImage,
  articleSection: 'Сохранение данных Битрикс24',
  breadcrumbs: [
    { name: 'Главная', item: siteRoot.toString() },
    { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() },
    { name: title, item: articleUrl },
  ],
  faqItems,
});
---

<ArticleLayout
  title={seoTitle} {titleParts} {description} {canonicalPath} {structuredData}
  ogTitle={seoTitle} ogDescription={description} {ogImage} {ogImageAlt}
  category={article.category} author={authorName}
  publishedTime={article.publishedAt} modifiedTime={article.updatedAt}
  intro="Что сохранить перед очисткой CRM, как сверить состав выгрузки и что вернёт резервная копия облачного или коробочного Битрикс24."
>
  <Fragment slot="quick-answer">
    <p>В облаке Битрикс24 делает ежедневные копии и хранит их семь дней. Администратор запрашивает восстановление всего портала через поддержку, если это доступно на тарифе. Изменения после точки восстановления теряются. В коробке процедуру определяет администратор.</p>
    <p>Перед очисткой CRM сохраните ID выбранных записей и сравните их с выгрузкой Excel или CSV. Если данные уже удалены, сначала проверьте корзину.</p>
  </Fragment>

  <p data-article-lead>В учебном примере в плане очистки три сделки. В CSV тоже три уникальных ID, но одна карточка пропущена, а другая попала в файл сверх списка. Прежде чем удалять записи, разберём, как найти такое расхождение и какие данные ещё понадобятся для возврата.</p>

  <section aria-labelledby="three-methods">
    <h2 id="three-methods">Три способа <span data-heading-accent>сохранить данные</span></h2>
    <DataTable label="Что дают облачная копия, коробочный архив и экспорт CRM" columns={['Способ', 'Что сохраняется', 'Как возвращать']} rows={methodRows} rowHeaders compact />
    <p>Штатная выгрузка сохраняет доступные поля CRM. Для рабочих файлов, истории и настроек нужен отдельный способ сохранения. Например, <a href={sourceLinks[5].href} target="_blank" rel="noopener noreferrer">штатный мастер Битрикс24 не выгружает дела CRM</a>.</p>
  </section>

  <section aria-labelledby="cloud-backup">
    <h2 id="cloud-backup">Как работает резервная копия <span data-heading-accent>облачного Битрикс24</span></h2>
    <p>По <a href={sourceLinks[0].href} target="_blank" rel="noopener noreferrer">официальной инструкции</a>, Битрикс24 ежедневно создаёт копии и хранит их семь дней. Восстановление на выбранную дату выполняет поддержка по запросу администратора и доступно не на всех тарифах. Поддержка проверяет наличие подходящей копии; во время операции портал временно блокируется.</p>
    <p>Планируйте восстановление на дату доступной автоматической копии. Если после неё появилась новая сделка, при откате она исчезнет. У сделки, которую после копии перевели в другую стадию, вернётся прежняя стадия. Для одной пропавшей сделки сначала проверьте <a href={base + 'udalennye-sdelki-bitrix24/'}>восстановление из корзины</a>.</p>
  </section>

  <section aria-labelledby="box-backup">
    <h2 id="box-backup">Если Битрикс24 работает <span data-heading-accent>в коробке</span></h2>
    <p>Для коробки на MySQL администратор может воспользоваться мастером в административной части. Откройте «Настройки» → «Инструменты» → «Резервное копирование» → «Создание резервной копии». Для установки на PostgreSQL согласуйте с администратором процедуру копирования базы и файлов. <a href={sourceLinks[4].href} target="_blank" rel="noopener noreferrer">Описание мастера</a> и <a href={sourceLinks[6].href} target="_blank" rel="noopener noreferrer">требования к СУБД</a>.</p>
    <ArticleFigure src={boxBackupImage} fullSize alt="Список резервных копий в административной части 1С-Битрикс, открыто меню одного из архивов"
      caption="Демонстрационный снимок из курса 1С-Битрикс. В списке видны созданные архивы, в меню выбранной копии есть «Скачать» и «Восстановить»." />
    <p>До очистки проверьте, какие файлы и таблицы вошли в архив, где он хранится и кто может его восстановить. Настройки позволяют исключать часть данных. Если доступен изолированный тестовый контур, проверьте восстановление на нём.</p>
  </section>

  <section aria-labelledby="export-crm">
    <h2 id="export-crm">Что сохранить <span data-heading-accent>из CRM перед очисткой</span></h2>
    <p>Выгрузите нужные элементы в Excel или CSV из списка CRM. В файл попадут записи по текущему фильтру. Права на экспорт настраиваются отдельно для каждого типа. Если выгружаете контакты, проверьте тариф и настройку «Участвует в экспорте контактов» в нужных карточках.</p>
    <ArticleFigure src={exportImage} fullSize alt="Официальный пример экспорта лидов Битрикс24 в Excel с полями и идентификаторами" caption="Скриншот Поддержки24: демонстрационный файл экспорта лидов. Он иллюстрирует выгруженные поля и ID, а не полную резервную копию портала. Проверяйте собственный файл до удаления." />
    <p>Пошаговый выбор полей, формата и проверка выгрузки разобраны в <a href={base + 'eksport-lidov-sdelok-bitrix24-pered-udaleniem/'}>отдельной инструкции по экспорту лидов и сделок</a>. Сохраните также сведения, которые в обычный файл не попадают, по правилам вашей компании: документы, важные договорённости и настройки процесса. Для них нужен отдельный план, согласованный с ответственными за данные.</p>
    <p>Файл с клиентскими данными храните с ограниченным доступом. Перед удалением ещё раз сравните фильтр в CRM с сохранённой выборкой: за время подготовки карточки могли измениться.</p>
  </section>

  <section aria-labelledby="before-cleanup">
    <h2 id="before-cleanup">Сверьте состав выгрузки <span data-heading-accent>до массовой очистки</span></h2>
    <p>Зафиксируйте тип записей, воронку, фильтр и согласованный список ID. При экспорте сделок с детализацией по товарным позициям одна сделка может занимать несколько строк. Сохраните исходный файл и уберите повторы только в отдельном списке ID. Сравните этот список с планом очистки в обе стороны.</p>
    <p>В учебном примере в плане сделки 314, 318 и 420. В файле четыре строки с ID 314, 314, 318 и 598. Уникальных ID тоже три, но 420 в файле нет, а 598 не входит в план.</p>
    <ArticleFigure src={idCheckImage} fullSize alt={ogImageAlt}
      caption="Учебные данные. Три ID в каждом списке, а состав различается. Перед очисткой выясните, почему 420 пропущен, а 598 попал в выгрузку." />
    <p>Если списки расходятся, проверьте воронку, фильтр, права на экспорт и дату выгрузки. Повторите сверку до удаления. Отдельно решите, где сохраните документы и сведения, которых нет в файле, и кто сможет запросить восстановление.</p>
    <p>Порядок проверки небольшой партии описан в <a href={base + 'massovoe-udalenie-sdelok-bitrix24/'}>инструкции по массовому удалению сделок</a>. Если нужен другой способ работы с записями, посмотрите <a href={base + 'ochistka-crm-bitrix24/'}>варианты очистки CRM</a>.</p>
    <InlineConsultation title="Планируете большую очистку CRM?" description="Поможем сверить выборку, выгрузки и последствия возможного отката до удаления данных." actionLabel="Обсудить план" />
  </section>

  <section aria-labelledby="after-error">
    <h2 id="after-error">Если данные <span data-heading-accent>уже удалены</span></h2>
    <p>Приостановите очистку. Запишите время удаления, тип элементов и известные ID. Откройте CRM → Ещё → Корзина. Администратор видит все записи в корзине, сотрудник видит удалённые им самим. Возможность восстановления зависит от тарифа, настроек типа элемента и наличия записи.</p>
    <p>Если нужная сделка есть в корзине, воспользуйтесь <a href={base + 'udalennye-sdelki-bitrix24/'}>порядком точечного восстановления</a>. Битрикс24 присвоит восстановленной сделке новый ID. Если нужных данных в корзине нет, для облака администратор уточняет доступную дату в поддержке и сверяет, какие изменения команды затронет полный откат.</p>
  </section>

  <FaqSection items={faqItems} id="faq" variant="article" />
  <ArticleSources publishedIso={article.publishedAt} modifiedIso={article.updatedAt} sources={sourceLinks} />
  <Fragment slot="article-end"><RelatedArticles items={relatedArticles} /></Fragment>
  <Fragment slot="after-article"><ConsultationCtaSection title="Нужно подготовить очистку без потери рабочих данных?" description="Разберём состав выборки, доступные выгрузки и порядок проверки результата." actionLabel="Обсудить задачу" /></Fragment>
</ArticleLayout>
