---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { mcpProduct } from '../../config/products';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import formImage from '../../images/articles/bitrix24-crm-form-list-native-137.png';
import integrationsImage from '../../images/articles/bitrix24-integrations-list-official-139.jpg';

const article = getArticle('peredacha-crm-bitrix24-posle-vnedreniya/');
const { title, description } = article;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const ogImage = new URL(integrationsImage.src, siteRoot).toString();
const imageAlt = 'Официальный экран Битрикс24 «Разработчикам → Интеграции»: список вебхуков и приложений с пользователем, названием и доступами';
const faqItems = [
  { question: 'Достаточно ли получить доступ администратора Битрикс24?', answer: 'Нет. Администратор может открыть настройки, но без карты процессов и интеграций новому специалисту придётся восстанавливать логику по отдельным экранам. Запросите реестр настроек, владельцев, контрольные сценарии и список открытых вопросов.' },
  { question: 'Можно ли вместо документации выгрузить CRM в Excel?', answer: 'Экспорт элементов CRM выгружает выбранные записи и поля при наличии права на экспорт. Он не заменяет описание воронок, роботов, форм, интеграций и их внешних зависимостей. Используйте выгрузку для отдельной задачи с данными, а карту конфигурации передайте отдельно.' },
  { question: 'Нужно ли просить у интегратора пароли и URL вебхуков?', answer: 'Запросите список подключений, владельцев, области доступа и способ безопасной передачи управления. Секреты и полные URL входящих вебхуков не кладите в общий передаточный файл: они дают доступ к данным портала. Если доступ прежнего подрядчика прекращается, смену владельцев и секретов проводите по согласованному плану с повторным тестом.' },
  { question: 'Какие тесты приложить к передаче CRM?', answer: 'Сохраните несколько контрольных сценариев по критичным маршрутам: откуда пришло обращение, какая карточка создана, кто назначен, что сделал робот и какой показатель проверен в отчёте. Для каждого нужны дата, тестовый ID, ожидаемый и фактический результат, а также открытое ограничение.' },
  { question: 'Заменит ли MCP TrueTell передаточный пакет?', answer: 'Нет. MCP TrueTell для настройки и диагностики CRM находится в разработке, и готовую автоматическую приёмку мы не заявляем. Карта процессов, владельцы доступов и критерии проверки всё равно должны быть согласованы людьми; с ними можно обсуждать будущий диагностический сценарий.' },
];
const sourceLinks = [
  { label: 'Битрикс24: раздел «Разработчикам» и список интеграций', href: 'https://helpdesk.bitrix24.ru/open/20886106/' },
  { label: 'Битрикс24: ролевая модель прав CRM', href: 'https://helpdesk.bitrix24.ru/open/23240636/' },
  { label: 'Битрикс24: увольнение сотрудника с активными вебхуками', href: 'https://helpdesk.bitrix24.ru/open/26213326/' },
  { label: 'Битрикс24: экспорт элементов CRM', href: 'https://helpdesk.bitrix24.ru/open/20966844/' },
  { label: 'Битрикс24: как запустить отладчик роботов', href: 'https://helpdesk.bitrix24.ru/open/19425336/' },
  { label: 'Битрикс24: восстановление данных из резервной копии', href: 'https://helpdesk.bitrix24.ru/open/24955644/' },
];
const handoffRows = [
  ['Маршрут заявки', 'Канал, форма или подключение; тип карточки, воронка, правило назначения', 'Владелец канала и тестовый ID с результатом'],
  ['Настройки CRM', 'Воронки, стадии, обязательные и пользовательские поля, роли', 'Ссылка на настройку, владелец изменения и граница доступа'],
  ['Автоматизация', 'Роботы, триггеры, условия, задержки и зависимые сервисы', 'Что должно произойти и где смотреть результат или ошибку'],
  ['Отчёт', 'Название показателя, период, фильтры, воронка и роль', 'Контрольный срез и определение числа'],
  ['Интеграция', 'Название, назначение, владелец, внешняя система, область данных', 'Как проверить обмен и кому сообщать о сбое'],
];
const decisionRows = [
  ['Принято', 'Новый ответственный нашёл настройку и повторил согласованный тест', 'Дата, ID и ссылка на результат'],
  ['Принято с ограничением', 'Сценарий работает, но известный случай требует отдельной правки', 'Ограничение, владелец и дата следующей проверки'],
  ['Не принято', 'Критичный маршрут не воспроизводится или нет владельца интеграции', 'Факт сбоя и условие повторной приёмки'],
];
const structuredData = createArticleStructuredData({
  articleType: 'BlogPosting', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  breadcrumbs: [{ name: 'Главная', item: siteRoot.toString() }, { name: 'Блог', item: new URL('blog/', siteRoot).toString() }, { name: title, item: articleUrl }],
  faqItems,
});
---
<ArticleLayout {title} titleParts={[{ text: 'Передача CRM Битрикс24 на поддержку: ' }, { text: 'что получить от интегратора', accent: true }]} {description}
  canonicalPath={`/${article.hrefPath}`} {structuredData} ogTitle={article.seoTitle} ogDescription={description}
  {ogImage} ogImageAlt={imageAlt} category={article.category} author={authorName}
  intro="После внедрения CRM остаётся у команды заказчика. Руководителю и будущей поддержке нужна карта: какие процессы настроены, от чего они зависят и кто разбирает сбой.">
  <Fragment slot="quick-answer">
    <p><strong>Попросите один передаточный пакет с пятью частями:</strong> карту маршрутов заявок и настроек, реестр интеграций и владельцев, матрицу прав, результаты контрольных тестов и список открытых вопросов. Для каждого критичного сценария новый ответственный должен суметь найти настройку, повторить проверку и понять, кто исправляет отклонение.</p>
    <p>Это рабочий формат TrueTell для передачи CRM, а не обязательный шаблон Битрикс24. Состав пакета уточняют по договору и фактическим доработкам.</p>
  </Fragment>

  <p data-article-lead>На встрече интегратор показывает работающую CRM. Через месяц новый специалист может не знать, почему форма создаёт сделку в конкретной воронке и от чего зависит робот. Запись маршрута и владельца настройки поможет разобраться без автора внедрения.</p>

  <section aria-labelledby="map">
    <h2 id="map">Соберите карту <span data-heading-accent>реальных маршрутов и настроек</span></h2>
    <p>Начните с каналов, через которые компания получает обращения. Для каждого укажите точку входа, тип создаваемого элемента, воронку, правило назначения и первый ожидаемый шаг. Затем добавьте связанные поля, стадии, роботов и отчёты. Битрикс24 позволяет настраивать права по элементам и воронкам, поэтому доступ будущего ответственного к перечисленным экранам и карточкам проверьте под его ролью.</p>
    <p>Не требуйте снимок каждого переключателя. Гораздо полезнее запись, по которой можно найти нужный экран и понять результат. Например: «Форма обратной связи → сделка в воронке продаж → ответственный из группы обработки → контрольная карточка №…». Ссылка на настройку и имя владельца помогут при следующем изменении.</p>
    <DataTable label="Что включить в карту передачи CRM" columns={['Блок', 'Что описать', 'Что проверить или приложить']} rows={handoffRows} rowHeaders />
    <ArticleFigure src={formImage} fullSize alt="Подлинный экран CRM-форм тестового Битрикс24: активная форма обратной связи создаёт сделку" caption="Снимок тестового портала TrueTell сделан 31.10.2026. В списке CRM-форм видно тип создаваемого элемента; это пример записи для карты каналов, а не доказательство работы заявки. Дата 06.08.2026 в строке относится к активности формы." />
    <p>Техническую приёмку одного маршрута по ID мы разобрали отдельно — в статье <a href={`${base}priemka-vnedreniya-crm-bitrix24/`}>от тестовой заявки до отчёта</a>. Здесь сохраните итог её проверки и место, где будущая поддержка найдёт детали.</p>
  </section>

  <section aria-labelledby="integrations">
    <h2 id="integrations">Передайте реестр интеграций <span data-heading-accent>с владельцами</span></h2>
    <p>Отдельной строкой запишите каждое приложение, вебхук и внешнюю систему, от которых зависит CRM. Нужны назначение, тип данных и действий, владелец подключения, место настройки, зависимость от сотрудника или внешнего сервера, способ проверки обмена и контакт для разбора сбоя. Для заказной разработки сверяйтесь с договором: если передача исходного кода предусмотрена, добавьте ссылку на него и версию работающего сценария. Если доступ к коду нужен для поддержки, а его передача не согласована, запишите вопрос как открытый.</p>
    <p>В Битрикс24 список созданных вебхуков и приложений находится в разделе «Разработчикам» → «Интеграции». Там видны название, пользователь и доступы; администратор видит все созданные подключения, обычный сотрудник — свои. Снимок ниже показывает расположение списка, а не интеграции TrueTell или вашего портала.</p>
    <ArticleFigure src={integrationsImage} fullSize alt={imageAlt} caption="Подлинный экран раздела «Интеграции» из справки Битрикс24, обновлённой 04.09.2026. Имена и примеры подключений принадлежат официальной демонстрации; это не список TrueTell или клиента. В передаточный реестр переносите назначение и владельца, но не секрет вебхука." />
    <p>Полный URL входящего вебхука содержит секрет. Не вставляйте его в общий передаточный файл. Передайте контроль над подключением безопасным способом и проверьте его работу после смены ответственного. При увольнении владельца Битрикс24 предлагает отключить вебхуки или сохранить их на системном пользователе; сохранённая ссылка продолжает давать доступ тому, кто её знает. Поэтому вопрос владельца и отзыва старого секрета нельзя оставлять устной договорённостью.</p>
  </section>

  <section aria-labelledby="evidence">
    <h2 id="evidence">Приложите результаты тестов <span data-heading-accent>и открытые ограничения</span></h2>
    <p>Попросите интегратора передать короткие контрольные сценарии по важным каналам, роботам и отчётам. В каждом укажите дату, тестовый ID, роль проверяющего, ожидание и факт. Для отчёта сохраните название показателя, период и фильтры: число без условий отбора трудно перепроверить. Для робота укажите сделку, стадию, действие и место, где видно результат или ошибку. Доступный в Битрикс24 отладчик может помочь разобрать конкретную автоматизацию, но его лог не заменяет перечень согласованных сценариев.</p>
    <p>Если часть работ ещё не закончена, не превращайте её в расплывчатое «доработать позже». Запишите конкретный сбой, владельца, срок следующей проверки и условие, по которому пункт можно закрыть. Тогда поддержка видит границу принятого решения и не ищет ошибку заново. Для первого рабочего месяца полезен отдельный <a href={`${base}pervye-30-dney-crm-bitrix24/`}>план контроля после запуска</a>; в передаточный пакет достаточно включить его владельца и ссылку на журнал.</p>
    <DataTable label="Как фиксировать результат передачи CRM" columns={['Статус', 'Условие', 'Запись в передаточном пакете']} rows={decisionRows} rowHeaders />
  </section>

  <section aria-labelledby="ownership">
    <h2 id="ownership">Назначьте, кто принимает изменения <span data-heading-accent>после передачи</span></h2>
    <p>У владельца CRM должен остаться список людей, которые могут менять воронки, поля, роли и автоматизацию, а также порядок согласования таких изменений. Матрица прав помогает найти фактический доступ менеджера, РОПа и подключения; пример её составления есть в <a href={`${base}matrica-prav-crm-bitrix24/`}>отдельной статье</a>. При смене подрядчика найдите подключения, зависящие от его учётной записи, назначьте новых владельцев и оперативно отзовите прежний доступ к порталу, внешним сервисам и коду. Затем повторите контрольный тест обмена.</p>
    <p>Excel-выгрузка карточек не заменяет карту настроек. Резервная копия Битрикс24 тоже решает другую задачу: восстановление на выбранную дату через поддержку возвращает состояние всего портала и зависит от тарифа. Поэтому в пакете нужны и описание конфигурации, и порядок действий при сбое, а не обещание «всё есть в бэкапе».</p>
    <p>MCP TrueTell для настройки и диагностики CRM находится в разработке. Если планируете регулярную диагностику, передаточная карта поможет выбрать проверяемые сигналы и согласовать права для будущего подключения. Автоматическую приёмку CRM, готовую подписку и проверку всех интеграций мы пока не заявляем.</p>
    <InlineConsultation variant="product" title="Нужно передать CRM на поддержку?" description="Опишите маршруты заявок, интеграции и открытые вопросы без клиентских данных и секретов. Поможем определить состав передаточной карты и обсудим будущий сценарий MCP TrueTell." href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
  </section>

  <FaqSection title="Частые вопросы о передаче CRM Битрикс24" items={faqItems} variant="article" />
  <p>Официальная справка Битрикс24 проверена 31 октября 2026 года. Реальный договор внедрения, клиентский портал, состав его интеграций и работа MCP TrueTell в таком сценарии не проверялись. Передаточный пакет выше — редакционная рекомендация TrueTell.</p>
  <ArticleSources publishedIso={article.publishedAt} modifiedIso={article.updatedAt} sources={sourceLinks} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Обсудим ' }, { text: 'диагностику CRM с MCP TrueTell', accent: true }]} description={mcpProduct.articleDescription} href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <ConsultationCtaSection slot="after-article" />
</ArticleLayout>
