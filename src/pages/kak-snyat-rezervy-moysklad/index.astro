---
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import { companyInfo } from '../../config/company';
import { cleanerProductPath } from '../../config/products';
import { reserveRelatedArticles } from '../../config/articles';
import reserveFlowImage from '../../images/articles/moysklad-reserve-flow.png';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import {
  createArticleStructuredData,
  DEFAULT_ARTICLE_AUTHOR,
} from '../../utils/functions/createArticleStructuredData';

const title = 'Как снять все резервы в МоемСкладе и почему они зависают';
const description =
  'Как снять резерв в МоемСкладе, найти зависшие заказы и настроить автоматическое снятие резервов после отмены, отгрузки или истечения срока.';
const ogTitle = 'Как снять зависшие резервы в МоемСкладе';
const ogDescription =
  'Почему товар остаётся в резерве, как найти проблемный заказ и настроить автоматическую очистку резервов в МоемСкладе.';
const canonicalPath = '/kak-snyat-rezervy-moysklad/';
const publishedDate = '2026-09-08T00:00:00+03:00';
const modifiedDate = '2026-09-22T00:00:00+03:00';
const authorName = DEFAULT_ARTICLE_AUTHOR;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const cleanerHref = `${base}${cleanerProductPath.slice(1)}`;
const siteRoot = new URL(base, import.meta.env.SITE);
const homeUrl = siteRoot.toString();
const blogUrl = new URL('blog/', siteRoot).toString();
const articleUrl = new URL('kak-snyat-rezervy-moysklad/', siteRoot).toString();
const productUrl = `${base}products/upravlenie-rezervami-moysklad/`;
const imageAlt = 'Схема движения товара со склада через резерв заказа к доступному остатку';
const ogImage = new URL(reserveFlowImage.src, siteRoot).toString();

const titleParts = [
  { text: 'Как снять все ' },
  { text: 'резервы в МоемСкладе', accent: true },
  { text: ' и почему они зависают' },
];

const breadcrumbs = [
  { label: 'Главная', href: base },
  { label: 'Блог', href: `${base}blog/` },
  { label: 'Резервы в МоемСкладе' },
];

const sourceLinks = [
  {
    label: 'Резервы — Служба поддержки МоегоСклада',
    href: 'https://support.moysklad.ru/hc/ru/%D1%82%D0%BE%D0%B2%D0%B0%D1%80%D1%8B%20%D0%B8%20%D1%81%D0%BA%D0%BB%D0%B0%D0%B4%D1%8B/%D0%BE%D1%81%D1%82%D0%B0%D1%82%D0%BA%D0%B8%20%D0%B8%20%D1%81%D0%B5%D0%B1%D0%B5%D1%81%D1%82%D0%BE%D0%B8%D0%BC%D0%BE%D1%81%D1%82%D1%8C/%D1%80%D0%B5%D0%B7%D0%B5%D1%80%D0%B2%D1%8B',
  },
  {
    label: 'Шаблоны сценариев для заказов покупателей',
    href: 'https://support.moysklad.ru/hc/ru/%D0%BF%D1%80%D0%BE%D0%B4%D0%B0%D0%B6%D0%B8/%D1%88%D0%B0%D0%B1%D0%BB%D0%BE%D0%BD%D1%8B_%D1%81%D1%86%D0%B5%D0%BD%D0%B0%D1%80%D0%B8%D0%B5%D0%B2_%D0%B4%D0%BB%D1%8F_%D0%B7%D0%B0%D0%BA%D0%B0%D0%B7%D0%BE%D0%B2_%D0%BF%D0%BE%D0%BA%D1%83%D0%BF%D0%B0%D1%82%D0%B5%D0%BB%D1%8F',
  },
  {
    label: 'JSON API МоегоСклада',
    href: 'https://dev.moysklad.ru/doc/api/remap/1.2/',
  },
];

const stockRows = [
  ['Остаток', 'Фактическое количество товара'],
  ['Резерв', 'Количество, закреплённое под заказы'],
  ['Ожидание', 'Товар, который ожидается к поступлению'],
  ['Доступно', 'Количество, которым можно распоряжаться с учётом резервов и ожиданий'],
];

const diagnosticRows = [
  ['Заказ отменён, товар в резерве', 'Статус не связан со снятием', 'Сценарии заказа'],
  ['Товар уже отгружен', 'Отгрузка не связана с заказом', 'Связанные документы'],
  ['В заказе стоит флажок', 'Фактический резерв уже снялся', 'Показатель резерва'],
  ['Старые заказы занимают товар', 'Нет автоматического снятия', 'Статусы и сроки'],
  ['Резерв появился снова', 'Его ставит интеграция', 'Магазин, CRM, приложение'],
  ['Данные обновились не сразу', 'Идёт пересчёт', 'Проверить позднее'],
];

const relatedArticles = reserveRelatedArticles.map((article) => ({
  ...article,
  href: `${base}${article.hrefPath}`,
}));

const faqItems = [
  {
    question: 'Снимается ли резерв автоматически после отгрузки в МоемСкладе?',
    answer:
      'Да. МойСклад снимает резерв после отгрузки или розничной продажи, если отгрузка связана с Заказом покупателя. При этом сам флажок «Резерв» в заказе может сохраниться.',
  },
  {
    question: 'Почему после отмены заказа резерв остался?',
    answer:
      'Само изменение статуса заказа не гарантирует снятие резерва. Для таких ситуаций можно настроить отдельный сценарий с действием «Изменить резерв → Снять резерв».',
  },
  {
    question: 'Можно ли автоматически снимать резерв у просроченных заказов?',
    answer:
      'Да. В официальных шаблонах сценариев МоегоСклада есть вариант, в котором событие «Истёк срок» запускает действие «Снять резерв».',
  },
  {
    question: 'Почему остаток есть, а доступного товара нет?',
    answer:
      'Остаток показывает фактическое количество товара, а резерв уменьшает доступное количество. Поэтому часть физического остатка может быть закреплена под заказы.',
  },
  {
    question: 'Можно ли снять резервы сразу с сотен заказов?',
    answer:
      'Для большой базы удобнее автоматизированная обработка: отобрать документы по условиям, проверить реальные резервы и изменить их через API. Действующие и оплаченные заказы лучше исключить из автоматической очистки.',
  },
];

const structuredData = createArticleStructuredData({
  title,
  description,
  articleUrl,
  publishedDate,
  modifiedDate,
  publisherUrl: homeUrl,
  author: authorName,
  breadcrumbs: [
    { name: companyInfo.brandName, item: homeUrl },
    { name: 'Блог', item: blogUrl },
    { name: title, item: articleUrl },
  ],
  faqItems,
});
---

<ArticleLayout
  {title}
  {titleParts}
  {description}
  {canonicalPath}
  {structuredData}
  {ogTitle}
  {ogDescription}
  {ogImage}
  ogImageAlt={imageAlt}
  category="МойСклад"
  intro="Разбираемся, где искать активный резерв, почему одной отмены заказа бывает недостаточно и как безопасно обработать сотни старых документов."
  {breadcrumbs}
  author={authorName}
  publishedTime={publishedDate}
  modifiedTime={modifiedDate}
>
  <Fragment slot="quick-answer">
    <p>
      Чтобы снять резерв с одного заказа, откройте{' '}
      <strong>Продажи → Заказы покупателей</strong>, перейдите в нужный заказ, снимите флажок{' '}
      <strong>Резерв</strong> и сохраните документ.
    </p>
    <p>
      Если используется резервирование отдельных позиций, уберите резерв у соответствующих
      товарных строк. Для регулярной очистки настройте сценарий
      <code>Изменить резерв → Снять резерв</code>.
    </p>
    <p>
      Перед массовым снятием отделите отменённые и просроченные заказы от действующих.
      Оплаченные заказы и товары, ожидающие самовывоза, требуют отдельной проверки.
    </p>
  </Fragment>

          <p data-article-lead>
            Покупатель отменил заказ, менеджер сменил статус, а товар по-прежнему числится
            в резерве. Для сотрудника работа закончена; в учёте заказ всё ещё удерживает
            остаток. Разберём, как найти такой документ, освободить товар и проверить,
            что следующая отмена не приведёт к той же проблеме.
          </p>

          <aside data-article-note>
            <strong>Главное различие</strong>
            <p>
              После корректной отгрузки фактический резерв может уже сняться, хотя флажок
              «Резерв» в заказе останется установленным. Галочка говорит о настройке документа,
              а фактический показатель — о том, удерживается ли товар сейчас. Смешивать эти два
              состояния не стоит.
            </p>
          </aside>

          <section aria-labelledby="what-is-reserve">
            <h2 id="what-is-reserve">
              Что такое <span data-heading-accent>резерв в МоемСкладе</span>
            </h2>
            <p>
              Резерв — это количество товара, которое закреплено за конкретным заказом
              покупателя. Он уменьшает доступное количество, но сам по себе не уменьшает
              фактический остаток товара на складе.
            </p>
            <p>
              Например, если на складе находится 10 единиц товара, а 7 зарезервированы под
              заказы, фактический остаток остаётся равным 10. Но часть товара уже обещана
              покупателям и должна учитываться при планировании следующих продаж.
            </p>

            <ArticleFigure
              src={reserveFlowImage}
              alt={imageAlt}
              caption="Резерв связывает товар с заказом; после завершения сценария часть остатка снова становится доступной."
            />

            <DataTable
              label="Показатели складского учёта"
              columns={['Показатель', 'Что означает']}
              rows={stockRows}
              rowHeaders
            />

            <p>
              Зависшие резервы особенно заметны, когда заказы автоматически поступают с сайта,
              маркетплейсов или из других систем: физически товар лежит на складе, но часть
              количества по-прежнему считается занятой.
            </p>
          </section>

          <section aria-labelledby="remove-reserve">
            <h2 id="remove-reserve">
              Как снять <span data-heading-accent>резерв вручную</span> — и когда этого уже
              недостаточно
            </h2>
            <p>
              С одним заказом всё довольно просто. Откройте <strong>Продажи → Заказы
              покупателей</strong>, найдите нужный документ, снимите флажок
              {' '}<strong>Резерв</strong> и сохраните изменения. Если компания резервирует не заказ
              целиком, а отдельные позиции, нужно открыть товарные строки и проверить количество
              в резерве у каждой из них.
            </p>
            <p>
              Сложность появляется не в самой операции, а в масштабе. Официальная инструкция
              описывает массовую постановку товаров в резерв, но не отдельную симметричную кнопку,
              которая безопасно снимет все существующие резервы. Несколько документов ещё можно
              проверить вручную; сотни старых заказов уже требуют отбора по статусам, датам,
              оплате и связанным отгрузкам.
            </p>
            <p>
              Именно поэтому простое обнуление — плохая стратегия. Оно устраняет видимый симптом,
              но не объясняет, откуда взялся резерв. Если его создаёт интеграция или незавершённый
              сценарий, через несколько дней товар снова окажется недоступным для продажи.
            </p>
          </section>

          <section aria-labelledby="why-stuck">
            <h2 id="why-stuck">
              Почему резервы <span data-heading-accent>«зависают»</span>
            </h2>
            <p>
              Почти все такие случаи связаны с жизненным циклом заказа. Товар зарезервировали в
              начале продажи, а обратное действие — снятие резерва после отмены, истечения срока
              или отгрузки — не произошло либо прошло не так, как ожидалось.
            </p>

            <h3>Заказ отменили, но резерв отдельно не сняли</h3>
            <p>
              Для сотрудника статус «Отменён» обычно означает конец работы с заказом. Для системы
              это лишь изменение одного поля: статус документа и количество в резерве остаются
              разными сущностями. Поэтому отмена должна сопровождаться явным правилом, которое
              освобождает товар. Без него заказ выглядит закрытым, но продолжает влиять на
              доступный остаток.
            </p>

            <h3>Отгрузка не связана с заказом покупателя</h3>
            <p>
              МойСклад автоматически снимает резерв, когда по заказу проходит отгрузка или
              розничная продажа. Для этого отгрузка должна быть связана с соответствующим
              Заказом покупателя. Если менеджер создал отгрузку отдельно, товар физически и
              документально уже продан, но исходный заказ не знает об этом и продолжает жить по
              прежним правилам. Поэтому после проверки статуса заказа следующим шагом всегда
              становится проверка связанных документов.
            </p>

            <h3>Фактический резерв уже снят, но флажок остался</h3>
            <p>
              После связанной отгрузки резерв с товара снимается автоматически, но флажок
              «Резерв» сохраняется в заказе. Внешне это похоже на ошибку, хотя доступное количество
              уже пересчитано правильно. Поэтому завершать диагностику нужно там же, где проблема
              была замечена: в фактическом резерве товара и его доступном количестве, а не в
              одной галочке внутри заказа.
            </p>
          </section>

          <section aria-labelledby="find-order">
            <h2 id="find-order">
              Как найти <span data-heading-accent>заказ, который держит товар</span>
            </h2>
            <p>
              Если проблема обнаружилась в отчёте об остатках, удобнее двигаться от товара к
              документу, а не наоборот. Сначала сравните фактический остаток, резерв и доступное
              количество. Разница между ними покажет, действительно ли товар удерживается, после
              чего можно искать заказы покупателей с этой позицией.
            </p>
            <p>
              <strong>Условный пример.</strong> На складе 25 единиц, из них 17 в резерве:
              12 под оплаченный заказ и 5 под отменённый. Если снять оба резерва, учёт перестанет
              показывать, что 12 единиц уже обещаны покупателю. Проверять и освобождать нужно
              только 5 единиц отменённого заказа.
            </p>
            <p>
              Чтобы разделить эти 17 единиц по документам, просмотрите заказы с данным товаром. В первую
              очередь подозрение вызывают отменённые, закрытые, неоплаченные и просроченные
              документы, а также заказы, которые месяцами остаются новыми или выполнены лишь
              частично. Названия статусов могут отличаться, но смысл проверки остаётся тем же:
              понять, есть ли у заказа реальная причина продолжать удерживать товар.
            </p>
            <p>
              Такой путь занимает немного больше времени, чем массовое снятие, зато сразу
              показывает источник расхождения. Это важно: один и тот же симптом может означать и
              забытый заказ, и разорванную связь с отгрузкой, и всего лишь сохранённый флажок при
              уже снятом фактическом резерве.
            </p>
          </section>

          <section aria-labelledby="automation">
            <h2 id="automation">
              Как автоматизация создаёт проблему —{' '}
              <span data-heading-accent>и как её исправить</span>
            </h2>
            <p>
              Часто резервы начинают накапливаться после подключения интернет-магазина. Новые
              заказы приходят в МойСклад уже с зарезервированными товарами, что защищает бизнес
              от повторной продажи одного остатка. Сама настройка полезна; проблема возникает,
              когда автоматизировано только начало процесса.
            </p>

    <InlineConsultation
      variant="product"
      title="Используете вместе с МоимСкладом Битрикс24?"
      description="Если после настройки резервов нужно отдельно убрать ненужные лиды или сделки в Битрикс24, воспользуйтесь нашим клинером для удаления записей по фильтрам. Сначала проверьте связи с заказами и правила обмена. Клинер работает с CRM и не снимает резервы МоегоСклада; подробная страница приложения готовится."
      href={cleanerHref}
      actionLabel="Посмотреть клинер"
    />

            <p>
              Если отмена, неоплата или истечение срока остаются ручными действиями, старые
              документы постепенно заполняют базу. Поэтому постановку и снятие резерва лучше
              проектировать как две стороны одного процесса. Для просроченного заказа, например,
              можно использовать сценарий <code>Истёк срок → Изменить резерв → Снять резерв</code>.
              Для отменённого заказа резерв разумно снимать сразу, а неоплаченный можно освободить
              через установленный компанией срок.
            </p>
            <p>
              После срабатывания сценария цифры не всегда меняются мгновенно: массовый пересчёт
              остатков может занять некоторое время. Старые документы тоже требуют внимания,
              потому что автоматизация не сможет изменить заказ из закрытого периода. Эти
              исключения лучше учитывать заранее, а не воспринимать как новую поломку.
            </p>
          </section>

          <section aria-labelledby="diagnostics">
            <h2 id="diagnostics">
              Резерв остался или появился снова: <span data-heading-accent>что проверить</span>
            </h2>
            <p>
              Найдите свой симптом в таблице и проверьте указанную связь. Например, если
              снятый резерв появился снова, начните с интеграции, которая обновляет заказ.
            </p>
            <DataTable
              label="Причины неснятого резерва"
              columns={['Симптом', 'Возможная причина', 'Что проверить']}
              rows={diagnosticRows}
            />
            <p>
              Если одна причина не подтверждается, переходите к следующей связи в цепочке:
              заказу, его статусу, отгрузке и источнику, из которого документ появился. Обычно
              этого достаточно, чтобы отделить реальный зависший резерв от визуально похожей
              ситуации.
            </p>
          </section>

          <section aria-labelledby="api">
            <h2 id="api">
              <span data-heading-accent>Массовая очистка через API</span>: почему здесь важна
              осторожность
            </h2>
            <p>
              В API МоегоСклада резерв хранится на уровне позиции Заказа покупателя. Поэтому
              для большой базы можно построить контролируемую массовую обработку: получить
              заказы, отобрать их по статусу, дате, складу или каналу продаж и найти позиции с
              ненулевым резервом. Но между поиском и изменением документов обязательно должен
              оставаться этап проверки.
            </p>
            <p>
              В одной базе могут одновременно находиться оплаченные заказы, товары для
              самовывоза, предзаказы, отменённые документы и забытые черновики. Если обнулить всё
              без разбора, уже обещанный клиенту товар снова станет доступен для продажи. Поэтому
              автоматизация должна сначала показать будущие изменения и только потом применить
              их к выбранным заказам.
            </p>
            <p>
              Практическое правило здесь простое: отменённые и давно неоплаченные заказы обычно
              можно освобождать автоматически, оплаченные — оставлять, а документы без понятной
              связи с отгрузкой отправлять на ручную проверку. Журнал изменений завершает эту
              логику и позволяет восстановить ход операции, если результат вызывает вопросы.
            </p>
          </section>

          <section aria-labelledby="prevention">
            <h2 id="prevention">
              Как сделать, чтобы резервы{' '}
              <span data-heading-accent>больше не зависали</span>
            </h2>
            <p>
              Начните с одного проблемного сценария: например, отмены заказа из интернет-магазина.
              Проверьте, как меняется статус, снимается ли резерв и не ставит ли его интеграция
              повторно. После исправления проследите весь путь на тестовом заказе.
            </p>
            <p>
              Затем закрепите срок резервирования неоплаченных заказов и исключения для
              самовывоза и предзаказов. При следующей очистке сравните число подозрительных
              документов: если они появляются снова, ищите незавершённый переход в процессе,
              а не повторяйте массовое обнуление.
            </p>
          </section>

