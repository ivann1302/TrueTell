---
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import Checklist from '../../components/editorial/checklist.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { cleanerProduct } from '../../config/products';
import selectionImage from '../../images/articles/bitrix24-multiple-delete-official.jpg';
import cleanerImage from '../../images/products/cleaner-selection.png';
import recycleImage from '../../images/articles/bitrix24-recycle-entry-official.jpg';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';

const article = getArticle('massovoe-udalenie-sdelok-bitrix24/');
const { title, description } = article;
const canonicalPath = `/${article.hrefPath}`;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const cleanerHref = `${base}${article.relatedProduct!.slice(1)}`;
const imageAlt = 'Список сделок Битрикс24: фильтр, выделенные строки, опция Для всех и действие Удалить';
const ogImage = new URL(selectionImage.src, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const titleParts = [{ text: 'Как ' }, { text: 'массово удалить сделки', accent: true }, { text: ' в Битрикс24: выбранные или все по фильтру' }];
const sourceLinks = [
  { label: 'Как удалить элементы CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/23238660/' },
  { label: 'Групповые действия в CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/21064250/' },
  { label: 'Как работают фильтры в CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/24206616/' },
  { label: 'Ролевая модель прав в CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/23240636/' },
  { label: 'Как экспортировать данные из CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/20966844/' },
  { label: 'Что такое Корзина в CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/24668648/' },
];
const deleteSteps = [
  { title: 'Откройте CRM → Сделки → Список', description: 'Проверьте выбранную воронку и оставшиеся условия поиска. Для нескольких известных карточек достаточно ручного выделения.' },
  { title: 'Задайте условия отбора', description: 'Для массовой операции примените нужные фильтры, например по ответственному, текущей стадии и полю «Дата начала» (дата создания сделки). Проверьте доступность полей в вашем портале.' },
  { title: 'Проверьте состав списка', description: 'Сверьте количество и ID нескольких карточек. Откройте спорные сделки и убедитесь, что они действительно относятся к согласованной очистке.' },
  { title: 'Выберите строки или включите «Для всех»', description: 'Чекбоксы подходят для конкретных записей. «Для всех» расширяет действие на все страницы текущей выборки — включайте его только после её проверки.' },
  { title: 'Нажмите «Удалить»', description: 'Проверьте объём операции и подтвердите действие, если появится запрос. После обработки обновите список и сверяйте результат по сохранённым ID.' },
];
const scopeRows = [
  ['Несколько известных сделок', 'Отметить конкретные строки', 'Что отмечены именно нужные ID'],
  ['Все сделки по условию', 'Применить фильтр и включить «Для всех»', 'Все страницы выборки, а не только текущий экран'],
  ['Все сделки одной воронки', 'Проверить воронку, убрать лишние ограничения, проверить список', 'Нет ли скрытых условий и ограничений доступа'],
  ['Все сделки портала', 'Сначала проверить все воронки и права администратора', 'Список в одной воронке не доказывает полноту всей базы'],
];
const faqItems = [
  { question: 'Как удалить все сделки в Битрикс24 сразу?', answer: 'В режиме «Список» проверьте воронку и фильтр, выделите записи и включите «Для всех», затем выберите «Удалить». Опция действует на все страницы текущей выборки. Перед полной очисткой портала отдельно проверьте все воронки и права: видимый список может не включать всю базу.' },
  { question: 'Почему удалились сделки только с первой страницы?', answer: 'Проверьте, была ли включена опция «Для всех». Обычное выделение строк и действие на все страницы списка — разные режимы. Перед повторной операцией обновите выборку и выясните, какие ID уже удалены.' },
  { question: 'Как удалить сделки только определённого менеджера?', answer: 'Настройте фильтр по ответственному и дополните его критериями вашей задачи. Проверьте текущую воронку, стадии и конкретные карточки. Если цель — продолжить работу после увольнения сотрудника, рассмотрите передачу сделок другому ответственному.' },
  { question: 'Можно ли удалить 1000 сделок без приложения?', answer: 'Для массовой операции предусмотрены штатные групповые действия со всеми страницами списка. В использованных официальных инструкциях не указан фиксированный предел числа сделок и не обещана скорость удаления. Доступность операции зависит от прав и конфигурации портала.' },
  { question: 'Экспортирует ли Битрикс24 только отмеченные галочками сделки?', answer: 'Штатный экспорт выгружает список по фильтру. Ручное выделение строк не является способом ограничить файл только этими карточками. Проверьте условия отбора и уникальные ID в скачанном файле до удаления.' },
  { question: 'Можно ли восстановить удалённые сделки?', answer: 'Это зависит от тарифа, включённой корзины для сделок и того, остались ли записи в ней. Проверьте CRM → Ещё → Корзина и тип элемента «Сделка». Восстановленный элемент получает новый ID; безусловного отката всей массовой операции нет.' },
];
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const structuredData = createArticleStructuredData({
  articleType: 'Article', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  articleSection: 'Работа со сделками в Битрикс24',
  breadcrumbs: [{ name: 'Главная', item: siteRoot.toString() }, { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() }, { name: title, item: articleUrl }], faqItems,
});
---

<ArticleLayout {title} {titleParts} {description} {canonicalPath} {structuredData}
  ogTitle={article.seoTitle} ogDescription={description} {ogImage} ogImageAlt={imageAlt}
  category={article.category} author={authorName}
  intro="Как выбрать несколько карточек или все страницы списка, ограничить удаление нужной воронкой и проверить результат."
>
  <Fragment slot="quick-answer">
    <p>Откройте <strong>CRM → Сделки → Список</strong>, примените нужный фильтр, отметьте записи и выберите «Удалить». Для действия нужны права на удаление сделок.</p>
    <p>Для всех страниц текущей выборки включите <strong>«Для всех»</strong>. Это не означает автоматически все сделки портала: проверьте воронку, фильтр и доступные вам записи. Нужные данные сохраните заранее.</p>
  </Fragment>

  <p data-article-lead>После тестового импорта или изменения процесса продаж бывает нужно убрать сразу много сделок. Основная сложность — точно определить состав операции. На экране может быть двадцать строк, по фильтру — несколько сотен, а в других воронках — ещё тысячи карточек. До операции зафиксируйте выбранные воронки, условия и контрольные ID.</p>

  <section aria-labelledby="delete-from-list">
    <h2 id="delete-from-list">Как удалить сделки <span data-heading-accent>списком</span></h2>
    <Checklist items={deleteSteps} label="Порядок массового удаления сделок" />
    <p>Названия и положение элементов могут отличаться в зависимости от интерфейса портала. Базовая последовательность описана в <a href={sourceLinks[0].href} target="_blank" rel="noopener noreferrer">официальной инструкции по удалению элементов CRM</a>.</p>
    <ArticleFigure src={selectionImage} alt={imageAlt} fullSize caption="Официальный скриншот Поддержки24: отмечены три сделки, «Для всех» ещё не включено. Фильтр «Сделки в работе» здесь иллюстрирует интерфейс; удалять действующие сделки по этому примеру не предлагается." />
    <p>Если нужно убрать одну карточку, её можно удалить через меню строки или настройки открытой сделки. Для большого набора удобнее список: в нём проще сопоставить фильтр, отмеченные строки и общий объём.</p>
  </section>

  <section aria-labelledby="selection-scope">
    <h2 id="selection-scope">Что означает <span data-heading-accent>«Для всех»</span></h2>
    <p>Групповое действие с этой опцией распространяется на другие страницы списка, а не только на видимые строки. Например, если проверенный фильтр нашёл 240 сделок и на странице отображается 20, «Для всех» относится ко всей выборке из 240. Это учебные числа, а не лимит Битрикс24. <a href={sourceLinks[1].href} target="_blank" rel="noopener noreferrer">Как работают групповые действия</a>.</p>
    <DataTable label="Как выбрать объём удаления сделок" columns={['Задача', 'Как выбирать', 'Что проверить']} rows={scopeRows} rowHeaders compact />
    <p>Не считайте снятые вручную галочки надёжным исключением при последующем переходе к «Для всех». Если часть карточек нужно сохранить, вручную отметьте конкретные строки и не включайте «Для всех» либо измените условия отбора и снова проверьте результат. Объём операции должен быть понятен до нажатия «Удалить».</p>
    <h3 id="all-funnels">Как удалить все сделки одной воронки или всего портала</h3>
    <p>Для очистки одной воронки сначала убедитесь, что открыта именно она, затем проверьте оставшиеся условия. Сохранённый фильтр по сотруднику, периоду или стадии может оставить в списке лишь часть её сделок.</p>
    <p>Для полной очистки тестового портала составьте перечень воронок и проверьте каждую под учётной записью с необходимыми правами. Отсутствие карточки в списке сотрудника не доказывает, что её нет в CRM. Не переносите результат «пусто в этой выборке» на весь портал.</p>
    <p>Перед полной очисткой согласуйте, что делать с CRM-формами и интеграциями, которые продолжают создавать сделки. Новая карточка после операции может оказаться новым поступлением, поэтому проверяйте ID и время создания.</p>
  </section>

  <p>Если ещё не решено, что делать со старыми карточками, смотрите <a href={`${base}ochistka-crm-bitrix24/`}>как выбрать способ очистки CRM</a>. Объединение дублей и передача клиентов могут решить задачу с сохранением полезных данных.</p>

  <section aria-labelledby="filters-and-rights">
    <h2 id="filters-and-rights">Какие <span data-heading-accent>фильтры и права</span> проверить</h2>
    <p>Запишите критерии задачи обычными словами: например, «тестовые сделки отдела внедрения, созданные в указанном периоде». Затем сопоставьте их с доступными полями фильтра. Название с пометкой «тест» само по себе не доказывает, что карточку можно удалить: откройте несколько записей и проверьте клиента и историю работы.</p>
    <p>Для отбора по текущему положению используйте текущую стадию или группу стадий. Фильтры «по истории» отвечают на другой вопрос: где сделка побывала раньше. «Дата начала» (создание сделки) и дата изменения также описывают разные события. Набор фильтров зависит от настроек и тарифа. <a href={sourceLinks[2].href} target="_blank" rel="noopener noreferrer">Справка о фильтрах CRM</a>.</p>
    <p>Если нужно убрать именно отказы, сначала решите, какие из них стоит сохранить для повторных продаж и анализа. Это подробно разобрано в статье <a href={`${base}udalenie-proigrannyh-sdelok-bitrix24/`}>об удалении проигранных сделок</a>.</p>
    <p>Права на чтение, удаление и экспорт настраиваются отдельно. У сделок доступ может различаться по воронкам и стадиям. Если кнопки удаления нет или часть карточек не обрабатывается, администратору нужно проверить роль сотрудника и разрешения для конкретной выборки. <a href={sourceLinks[3].href} target="_blank" rel="noopener noreferrer">Ролевая модель прав CRM</a>.</p>
  </section>

  <section aria-labelledby="save-data">
    <h2 id="save-data">Что сохранить <span data-heading-accent>перед удалением</span></h2>
    <p>Зафиксируйте воронку, условия фильтра и ID согласованных сделок. Затем выгрузите нужные поля в CSV или Excel и откройте файл. Проверьте названия, суммы, ответственных и несколько ID: успешно скачанный файл ещё не подтверждает, что сохранена нужная выборка.</p>
    <p><strong>Штатный экспорт выгружает список по фильтру, а не только строки с галочками.</strong> Если удаляете вручную выбранную часть, отдельно сверяйте её с выгрузкой. При детализации по товарам одна сделка может занимать несколько строк, поэтому количество строк файла не равно числу сделок — считайте уникальные ID. <a href={sourceLinks[4].href} target="_blank" rel="noopener noreferrer">Правила экспорта CRM</a>.</p>
    <p>CSV или Excel не являются полной копией всех связей, файлов и истории портала. Если эти данные нужны, заранее определите способ их сохранения. Подробный порядок проверки файла есть в инструкции <a href={`${base}eksport-lidov-sdelok-bitrix24-pered-udaleniem/`}>по экспорту лидов и сделок перед удалением</a>.</p>
    <p>Отдельно сохраните необходимые показатели отчётности: удалённые элементы CRM перестают учитываться в аналитических отчётах. Закрытую сделку с полезной историей часто разумнее оставить в CRM.</p>
  </section>

  <section aria-labelledby="cleaner-selection">
    <h2 id="cleaner-selection">Когда пригодится <span data-heading-accent>Cleaner TrueTell</span></h2>
    <p>Штатного списка достаточно, если отбор понятен и дополнительные этапы контроля не нужны. Наше приложение «Массовое удаление лидов и сделок» добавляет отдельную проверку выборки: можно увидеть карточки, исключить важные и подготовить CSV до подтверждения. Проверьте, удаётся ли сохранить или скопировать CSV в вашем браузере до удаления.</p>
    <p>В текущей реализации предусмотрены работа администратора и выборка до <strong>3000 записей за один отбор</strong>. Доступны фильтры по воронке и стадии, ответственному, источнику, дате создания или изменения, части названия и диапазону ID. Условия задаются в самом приложении: оно не переносит автоматически сохранённые фильтры CRM и не поддерживает произвольные пользовательские поля.</p>
    <ArticleFigure src={cleanerImage} alt="Проверка списка в Cleaner TrueTell: 120 найденных сделок, одна исключена, 119 выбраны для CSV" fullSize caption="Демонстрационный экран Cleaner TrueTell: из 120 найденных карточек одна исключена, выбрано 119. На этом снимке включён режим «Доступно только чтение»; он показывает проверку списка, а не выполненное удаление на клиентском портале." />
    <p>После подтверждения предусмотрен отсчёт в пять секунд. Во время операции можно остановить отправку новых запросов; уже отправленные запросы это не отменяет. Итоговый экран показывает результат по ID, включая ошибки и неопределённые ответы; приложение также предусматривает CSV-отчёт. Получение итогового файла в установленном приложении и удаление на клиентском портале ещё не прошли приёмку. Перед повторной попыткой разберите результат, чтобы не запускать удаление вслепую.</p>
    <p>Перед использованием проверьте установку, подписку и доступность операции в вашем портале. Возможности описаны по текущей реализации продукта; скриншот и карточка в Маркете не подтверждают успешное удаление в конкретном клиентском Битрикс24.</p>
    <InlineConsultation variant="product" title="Нужна проверка списка перед очисткой?" description="Посмотрите порядок работы, фильтры и ограничения приложения для лидов и сделок." href={cleanerHref} actionLabel={cleanerProduct.articleActionLabel} />
  </section>

  <section aria-labelledby="verify-results">
    <h2 id="verify-results">Как проверить результат <span data-heading-accent>и найти ошибочно удалённую сделку</span></h2>
    <p>Обновите тот же список и проверьте исходные условия фильтра. Затем найдите несколько сохранённых ID. Если часть записей осталась, сначала выясните причину: другие права, изменившиеся условия, прерванная обработка или повторное создание из интеграции. Не расширяйте фильтр только ради нулевого счётчика.</p>
    <p>При ошибке откройте <strong>CRM → Ещё → Корзина</strong>, выберите тип элемента «Сделка» и найдите нужную запись. Администратор видит все удалённые элементы, другие сотрудники — удалённые ими самими.</p>
    <ArticleFigure src={recycleImage} alt="Официальный интерфейс Битрикс24: переход в корзину через CRM и меню Ещё" fullSize caption="Официальный пример Поддержки24: вход в корзину CRM. Для поиска удалённой сделки далее выберите её тип и нужные условия; этот экран не подтверждает восстановление конкретной карточки." />
    <p>Корзину для сделок можно отключить, а восстановление доступно не на всех тарифах. Справка описывает хранение до 30 дней и последующее постепенное удаление. Проверьте настройки заранее: гарантировать возврат любой сделки на протяжении месяца нельзя. Восстановленный элемент получает новый ID, поэтому прежние ссылки и внешние привязки требуют проверки. <a href={sourceLinks[5].href} target="_blank" rel="noopener noreferrer">Условия работы корзины CRM</a>.</p>
    <p>Если сделка удалена ошибочно, перейдите к <a href={`${base}udalennye-sdelki-bitrix24/`}>инструкции по поиску и восстановлению сделки</a>. Там есть порядок возврата и список данных, которые стоит проверить после него.</p>
    <p>В конце сопоставьте согласованный набор ID с фактическим результатом и сохраните доступный отчёт. Пустой экран с другим фильтром не подтверждает успешную очистку исходной выборки.</p>
  </section>

  <FaqSection items={faqItems} id="faq" variant="article" />
  <ArticleSources publishedIso={article.publishedAt} sources={sourceLinks} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Удаление сделок ' }, { text: 'с проверкой списка', accent: true }]} description="Проверьте карточки, исключите важные и подготовьте CSV выбранных записей. До подтверждения убедитесь, что можете сохранить или скопировать файл." href={cleanerProduct.marketplaceUrl} actionLabel={cleanerProduct.connectionActionLabel} />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <Fragment slot="after-article"><ConsultationCtaSection /></Fragment>
</ArticleLayout>
