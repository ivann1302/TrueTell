---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { productRating, productRatingPath } from '../../config/products';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import itemsImage from '../../images/articles/bitrix24-deal-products-official-098.jpg';
import columnsImage from '../../images/articles/bitrix24-deal-product-columns-official-098.jpg';

const article = getArticle('tovary-v-sdelke-bitrix24/');
const { title, description } = article;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const imageAlt = 'Официальный экран сделки Битрикс24: вкладка Товары с позициями, количеством, ценой, скидкой и итогом';
const ogImage = new URL(itemsImage.src, siteRoot).toString();
const sourceLinks = [
  { label: 'Битрикс24: как добавить товары в карточку CRM', href: 'https://helpdesk.bitrix24.ru/open/27964692/' },
  { label: 'Битрикс24: ручной и автоматический расчёт суммы сделки', href: 'https://helpdesk.bitrix24.ru/open/27634104/' },
  { label: 'Битрикс24: права доступа к каталогу товаров', href: 'https://helpdesk.bitrix24.ru/open/25376682/' },
  { label: 'Битрикс24: как работать со сделками в мобильной CRM', href: 'https://helpdesk.bitrix24.ru/open/16758628/' },
];
const checkRows = [
  ['Что входит в эту сделку', 'Вкладка «Товары», название и вариация каждой строки', 'Проверьте, не добавлена ли та же позиция дважды'],
  ['Сколько стоит строка', 'Количество, цена за единицу, скидка, налог и сумма строки', 'После изменения сохраните сделку и проверьте итог справа'],
  ['Почему сумма сделки отличается', 'Итог товаров справа и поле «Сумма» в карточке', 'Сверьте ручной или автоматический режим расчёта'],
];
const faqItems = [
  { question: 'Где посмотреть товары в сделке Битрикс24?', answer: 'Откройте CRM → Сделки, выберите нужную карточку и перейдите на вкладку «Товары». В таблице показаны товарные строки; через настройки столбцов можно вывести цену, количество, скидку, налог и сумму, если эти поля доступны вашему пользователю.' },
  { question: 'Почему цена в сделке отличается от цены в каталоге?', answer: 'В сделке цену позиции можно изменить отдельно при наличии права «Изменение цены товара в CRM». Такая правка не меняет цену в каталоге. Проверьте также количество, скидку, налог и вариацию товара, прежде чем сравнивать итоговые суммы.' },
  { question: 'Почему сумма сделки не равна сумме товаров?', answer: 'Проверьте режим расчёта. В ручном режиме поле «Сумма» задают отдельно, и изменение строк товаров его не пересчитывает. В автоматическом режиме оно зависит от товаров и услуг в сделке. Итог по товарным строкам смотрите справа на вкладке «Товары».' },
  { question: 'Как показать скрытую цену или закупочную стоимость?', answer: 'На вкладке «Товары» нажмите шестерёнку слева над таблицей и отметьте нужный столбец. В списке доступны только поля, которые разрешены пользователю. Если «Закупочной цены» нет, администратор должен проверить соответствующее право; возможность настройки прав зависит от тарифа.' },
  { question: 'Можно ли посмотреть товары сделки с телефона?', answer: 'Да. Откройте сделку в мобильном приложении Битрикс24 и вкладку «Товары». Там можно посмотреть позиции, указать количество и скидку; набор элементов управления отличается от веб-версии.' },
  { question: 'Покажет ли вкладка «Товары», какие позиции продаются чаще всего?', answer: 'Она показывает состав одной карточки. Для сравнения товаров по нескольким сделкам нужен отдельный отчёт. Приложение TrueTell «ABC анализ товаров и клиентов» позволяет смотреть вклад позиций в продажи и переходить к исходным сделкам; успешная сделка сама по себе не подтверждает оплату.' },
];
const structuredData = createArticleStructuredData({
  articleType: 'Article', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  breadcrumbs: [{ name: 'Главная', item: siteRoot.toString() }, { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() }, { name: title, item: articleUrl }],
  faqItems,
});
---
<ArticleLayout {title} titleParts={[{ text: 'Товары в сделке Битрикс24: ' }, { text: 'где посмотреть позиции и цены', accent: true }]} {description}
  canonicalPath={`/${article.hrefPath}`} {structuredData} ogTitle={article.seoTitle} ogDescription={description}
  {ogImage} ogImageAlt={imageAlt} category={article.category} author={authorName}
  intro="В карточке сделки есть сумма, но по ней нельзя понять, какие позиции выбрал клиент. Откройте вкладку «Товары»: там видны строки с количеством и ценами, а справа — расчёт по ним. Если две суммы расходятся, проверьте режим расчёта сделки.">
  <Fragment slot="quick-answer">
    <p><strong>CRM → Сделки → нужная сделка → вкладка «Товары».</strong> В таблице посмотрите названия позиций, вариации, количество, цену за единицу, скидки и налоги. Справа от строк находится общий расчёт по товарам.</p>
    <p>Если нужной колонки нет, нажмите шестерёнку слева над таблицей. Сумма всей сделки совпадает с итогом товаров при автоматическом расчёте; в ручном режиме она может отличаться.</p>
  </Fragment>

  <p data-article-lead>В карточке сделки одна сумма, а в строках товаров получается другая. Проверьте состав покупки, количество, цену и скидку каждой позиции. Затем сравните итог строк с полем «Сумма» и посмотрите режим расчёта. Сводный отчёт по продажам не объяснит расхождение в конкретной карточке.</p>

  <section aria-labelledby="where">
    <h2 id="where">Где находятся <span data-heading-accent>товары и цены сделки</span></h2>
    <p>Откройте <strong>CRM → Сделки</strong>, найдите нужную карточку и выберите вкладку <strong>«Товары»</strong>. Каждая строка относится к позиции, добавленной в эту сделку. Здесь можно увидеть название, выбранную вариацию, количество, цену, скидку, налог и рассчитанную сумму. В правой части расположен итог по товарам. Состав видимых колонок зависит от настроек таблицы и прав пользователя.</p>
    <ArticleFigure src={itemsImage} fullSize alt={imageAlt} caption="Подлинный демонстрационный экран из официальной справки Битрикс24. В примере туристической сделки видны три позиции; у «Зимнего тура на Байкал» указаны 2 шт. по 180 000 ₽ и строка 360 000 ₽ без скидки и налога. Это учебные данные Битрикс24, не продажи клиента TrueTell. Откройте снимок в полном размере для чтения столбцов." />
    <p>Цена в строке — цена конкретной позиции в сделке. При выборе товара Битрикс24 подставляет цену из каталога; при наличии права на изменение цены товара в CRM менеджер может согласовать особую цену для этой сделки, не меняя карточку каталога. Поэтому для спорной суммы смотрите сохранённую строку сделки, а не только текущий прайс каталога.</p>
  </section>

  <section aria-labelledby="columns">
    <h2 id="columns">Если колонка не видна, <span data-heading-accent>настройте таблицу</span></h2>
    <p>На вкладке «Товары» нажмите <strong>шестерёнку слева над таблицей</strong>, отметьте нужные поля и примените настройки. Для обычной проверки достаточно названия, количества, цены, скидки, налога и суммы строки. Дополнительные поля, в том числе закупочную цену, показывайте только тем, кому они нужны по роли. Администратор может применить выбранный набор столбцов для всех; сотрудники затем смогут настроить свой вид.</p>
    <ArticleFigure src={columnsImage} fullSize alt="Официальный экран настройки колонок вкладки Товары: Цена, Количество, Скидка, Налог, Сумма и Закупочная цена" caption="Официальный демонстрационный экран настройки столбцов Битрикс24. Поля «Цена», «Количество», «Скидка», «Налог» и «Сумма» выбираются для таблицы сделки; закупочная цена доступна только при соответствующем праве. Снимок относится к примеру справки, не к порталу TrueTell." />
    <p>Если столбца «Закупочная цена» нет даже в настройках, проверьте право на просмотр закупочной цены товара. Право <strong>«Изменение цены товара в CRM»</strong> отдельно регулирует изменение цены внутри сделки; оно не равно праву менять цену продажи в каталоге. Настройка прав каталога доступна не на каждом тарифе.</p>
  </section>

  <section aria-labelledby="read">
    <h2 id="read">Как читать цену, скидку <span data-heading-accent>и итог</span></h2>
    <p>Для проверки одной строки сопоставьте выбранную вариацию, количество и цену за единицу. Затем посмотрите скидку и налог — они влияют на окончательную сумму. Справа от таблицы Битрикс24 показывает сумму до скидок и налогов, величину скидки, сумму налога и общий итог по товарным строкам. Если менеджер изменил позицию, сохраните сделку и проверьте итог ещё раз.</p>
    <DataTable label="Что проверить в товарах одной сделки" columns={['Вопрос', 'Где смотреть', 'Что делать дальше']} rows={checkRows} rowHeaders />
    <p>Строка может относиться к товару каталога или к позиции, добавленной только в сделку. Создание новой позиции без сохранения в каталоге зависит от настройки CRM. Если в другой сделке такой же товар не находится в каталоге, это один из вариантов для проверки. Когда товара нет вовсе, его можно добавить по названию или выбрать из каталога, но до этого убедитесь, что не создадите дубликат.</p>
  </section>

  <section aria-labelledby="total">
    <h2 id="total">Почему поле «Сумма» <span data-heading-accent>расходится с товарами</span></h2>
    <p>Итог справа на вкладке «Товары» и поле <strong>«Сумма»</strong> сделки решают разные задачи, когда включён ручной режим. В нём менеджер вводит сумму сделки отдельно, а изменение товарных строк её не пересчитывает. При автоматическом режиме Битрикс24 рассчитывает сумму сделки по товарам и услугам в карточке. Режим по умолчанию зависит от того, как сделка создана, поэтому для спорной карточки проверяйте фактическое состояние, а не предполагайте его.</p>
    <p>Если нужен автоматический пересчёт, в карточке сделки справа от поля «Сумма» откройте настройки и выберите <strong>«Вернуть автоматический пересчёт суммы»</strong>, затем сохраните. Перед этим согласуйте изменение: оно поменяет сумму сделки и может повлиять на документы и аналитику. Переключение режима отражается в таймлайне и истории. Подробный разбор режима приведён в <a href="https://helpdesk.bitrix24.ru/open/27634104/" target="_blank" rel="noopener noreferrer">официальной инструкции Битрикс24</a>.</p>
    <p>Если вы хотите проверить, как смена суммы повлияла на отчёт, сохраните ID сделки и сравните её карточку с результатом за тот же период. Успешная стадия сделки не подтверждает получение оплаты. Подробнее о разнице суммы товаров и полной суммы сделки — на <a href={productRatingPath}>странице нашего ABC анализа</a>.</p>
  </section>

  <section aria-labelledby="next">
    <h2 id="next">От одной сделки <span data-heading-accent>к продажам по товарам</span></h2>
    <p>Вкладка «Товары» отвечает на вопрос о составе конкретной сделки. Если нужен список позиций, которые чаще продаются за период, сравнение клиентов или проверка вклада товара по нескольким сделкам, используйте отдельный отчёт. В нашем приложении <a href={productRatingPath}>«ABC анализ товаров и клиентов»</a> можно перейти от товара к исходным сделкам и проверить, из чего получился показатель. Приложение читает доступные пользователю CRM-данные и не меняет карточки.</p>
    <InlineConsultation variant="product" title="Не сходятся товарные строки и сумма сделки?" description="Напишите, какая строка или итог вызывает вопрос, и укажите тестовый ID без данных клиента. Поможем составить порядок проверки цены, скидки, прав и режима расчёта." href={companyInfo.contacts.consultationUrl} actionLabel="Обсудить задачу" />
  </section>

  <FaqSection title="Частые вопросы о товарах в сделке Битрикс24" items={faqItems} variant="article" />
  <p>Официальная справка Битрикс24 проверена 1 ноября 2026 года. Скриншоты взяты из её демонстрационного портала. Интерфейс, права и режим суммы в клиентском Битрикс24 для статьи не менялись и не проверялись.</p>
  <ArticleSources publishedIso={article.publishedAt} modifiedIso={article.updatedAt} sources={sourceLinks} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Сравнить товары по сделкам с ' }, { text: 'ABC анализом TrueTell', accent: true }]} description={productRating.description} href={productRatingPath} actionLabel="Посмотреть приложение" />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <ConsultationCtaSection slot="after-article" />
</ArticleLayout>
