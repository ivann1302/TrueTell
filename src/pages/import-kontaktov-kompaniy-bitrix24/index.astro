---
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import importPlanImage from '../../images/articles/bitrix24-client-import-plan-106.png';
import linksImage from '../../images/articles/bitrix24-company-links-official.jpg';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';

const article = getArticle('import-kontaktov-kompaniy-bitrix24/');
const title = article.title;
const seoTitle = article.seoTitle ?? title;
const description = article.description;
const canonicalPath = '/' + article.hrefPath;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const ogImage = new URL(importPlanImage.src, siteRoot).toString();
const ogImageAlt = 'План импорта клиентской базы Битрикс24: CSV, компании, контакты и проверка связей';
const titleParts = [
  { text: 'Импорт контактов и компаний ' },
  { text: 'в Битрикс24 из Excel', accent: true },
];
const sourceLinks = [
  { label: 'Как импортировать связанные компании, контакты и сделки — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/27844102/' },
  { label: 'Как импортировать контакты и компании с реквизитами — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/25553660/' },
  { label: 'Как импортировать элементы CRM без реквизитов — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/25999954/' },
  { label: 'Частые вопросы о CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/25817644/' },
  { label: 'Как связать компании, контакты и сделки — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/27912504/' },
  { label: 'Ролевая модель прав в CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/23240636/' },
  { label: 'Как перенести данные с одного Битрикс24 на другой — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/18385562/' },
];
const modeRows = [
  ['Разрешить', 'Загрузить все строки, включая совпадения', 'Может создать новые дубли'],
  ['Заменять', 'Обновить поля найденной существующей карточки', 'Значения в CRM могут быть перезаписаны'],
  ['Объединять', 'Заполнить пустые поля найденной карточки', 'Уже заполненные поля остаются прежними'],
  ['Пропустить', 'Не загружать найденные дубли', 'После импорта доступен файл с пропущенными строками'],
];
const faqItems = [
  {
    question: 'Можно ли импортировать контакты и компании в Битрикс24 напрямую из Excel?',
    answer: 'Штатный мастер импорта принимает CSV. Подготовьте таблицу в Excel, сохраните копию в формате CSV и проверьте разделитель столбцов перед загрузкой. Исходный XLSX сохраните отдельно.',
  },
  {
    question: 'Что импортировать первым: компании или контакты?',
    answer: 'Сначала компании. Затем в CSV контактов заполните поле «Компания» точным названием уже существующей в CRM компании и сопоставьте этот столбец с полем «Компания» в мастере импорта.',
  },
  {
    question: 'Почему контакт не связался с компанией после импорта?',
    answer: 'Проверьте порядок загрузки, точное совпадение названия компании в CSV и CRM и сопоставление поля «Компания». Разница даже в одном символе может помешать автоматической связи.',
  },
  {
    question: 'Как не создать дубли при повторном импорте?',
    answer: 'Перед запуском выберите режим обработки дублей и поля проверки. «Разрешить» загрузит и совпадающие строки; «Пропустить» исключит найденные дубли; «Заменять» обновит значения; «Объединять» заполнит только пустые поля. Сначала проверьте небольшую партию.',
  },
  {
    question: 'Можно ли обновить существующие компании из CSV?',
    answer: 'В импорте компаний и контактов есть режим «Заменять»: найденные дубли обновляются значениями из файла. Перед ним проверьте поля поиска дублей и значения, которые не должны меняться.',
  },
  {
    question: 'Как импортировать реквизиты компании?',
    answer: 'В мастере импорта компаний включите «Импортировать реквизиты» перед скачиванием шаблона и настройте сопоставление шаблонов реквизитов. После загрузки проверьте реквизиты в нескольких карточках.',
  },
  {
    question: 'Что делать, если столбцы CSV попали в одно поле?',
    answer: 'Откройте CSV в текстовом редакторе и посмотрите разделитель в первой строке. В мастере импорта укажите тот же символ в поле «Разделитель столбцов», затем повторно проверьте соответствие полей.',
  },
];
const relatedArticles = getRelatedArticles(article.hrefPath)
  .map((item) => ({ ...item, description: item.summaryDescription ?? item.description, href: base + item.hrefPath }));
const structuredData = createArticleStructuredData({
  articleType: 'Article',
  title,
  description,
  articleUrl,
  publishedDate: article.publishedAt,
  modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(),
  author: authorName,
  image: ogImage,
  articleSection: 'Импорт клиентской базы Битрикс24',
  breadcrumbs: [
    { name: 'Главная', item: siteRoot.toString() },
    { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() },
    { name: title, item: articleUrl },
  ],
  faqItems,
});
---

<ArticleLayout
  title={seoTitle} {titleParts} {description} {canonicalPath} {structuredData}
  ogTitle={seoTitle} ogDescription={description} {ogImage} {ogImageAlt}
  category={article.category} author={authorName}
  publishedTime={article.publishedAt} modifiedTime={article.updatedAt}
  intro="Клиентскую базу можно подготовить в Excel, но штатный импорт Битрикс24 загружает CSV. Чтобы контакты связались с компаниями, сначала внесите компании, затем контакты с точным названием компании в отдельном столбце."
>
  <Fragment slot="quick-answer">
    <p>Сохраните таблицы компаний и контактов как <strong>CSV</strong>. В CRM → Клиенты → Компании скачайте шаблон, сопоставьте столбцы и импортируйте компании. Затем откройте импорт контактов и сопоставьте поле «Компания» с названиями уже загруженных организаций.</p>
    <p>До запуска выберите правила обработки дублей. После небольшой пробной партии проверьте карточки и связи, исправьте файл при необходимости и только затем загружайте остальную базу.</p>
  </Fragment>

  <p>Одна таблица с именами людей и организаций удобна для работы в Excel. В CRM это разные карточки. Их нужно загрузить в правильном порядке и проверить, какую компанию Битрикс24 связал с каждым контактом. Особенно внимательно готовьте файл, если клиентская база уже частично заполнена.</p>

  <section aria-labelledby="prepare-csv">
    <h2 id="prepare-csv">Как подготовить <span data-heading-accent>таблицу Excel</span></h2>
    <p>Штатный мастер импорта принимает CSV, поэтому сохраните исходный Excel-файл и подготовьте отдельные CSV для компаний и контактов. Скачайте шаблоны из мастера Битрикс24 и подстройте столбцы под них. Для компании обязательным является название; для контакта заполняйте имя или фамилию и рабочие данные, по которым менеджер узнает клиента.</p>
    <p>При сохранении CSV проверьте кириллицу, телефоны с ведущими символами и разбивку на столбцы. В шаблоне Битрикс24 используется точка с запятой, но редактор таблиц может сохранить другой разделитель. Откройте файл как текст и сравните первый ряд с настройкой «Разделитель столбцов» в мастере импорта. Не исправляйте разделитель слепой заменой символов внутри клиентских данных.</p>
    <p>При переносе контактов из другого портала отдельно проверьте столбцы поля «Мессенджер». <a href={sourceLinks[2].href} target="_blank" rel="noopener noreferrer">Поддержка24 предупреждает</a>: старые идентификаторы, обычно начинающиеся с <code>imol</code>, могут привязать будущие чаты к неверному человеку. Перед импортом удалите эти значения из CSV.</p>
    <ArticleFigure src={importPlanImage} fullSize portrait alt="План импорта: подготовить CSV из Excel, загрузить компании, потом контакты и проверить связи" caption="Памятка TrueTell по официальному порядку импорта. Это не экран Битрикс24; названия компаний и контактов в примерах нужно сверять с вашими данными." />
    <p>Поля в шаблоне портала могут отличаться от ваших столбцов. На шаге сопоставления слева показаны поля CRM, справа — колонки CSV. Проверьте название компании, имя, фамилию, телефон, e-mail и особенно поле «Компания» у контакта. Если колонка не распознана, укажите её вручную через «Выбрать» или «Изменить». Если у вас есть отдельная API-интеграция, пригодится <a href={base + 'karta-sootvetstviya-poley-bitrix24/'}>карта соответствия полей</a>. Для штатного CSV-импорта ориентируйтесь на шаблон своего портала и сопоставление в мастере.</p>
  </section>

  <section aria-labelledby="companies-first">
    <h2 id="companies-first">Сначала загрузите <span data-heading-accent>компании</span></h2>
    <p>Откройте CRM → Клиенты → Компании и в настройках выберите импорт компаний. Скачайте CSV-шаблон, заполните название и нужные поля, затем загрузите файл. Проверьте разделитель и соответствие колонок. Перед завершением мастер предложит выбрать, что делать с дублями.</p>
    <p>Если нужны ИНН, КПП и другие реквизиты, включите «Импортировать реквизиты» <strong>до скачивания шаблона</strong>. Для реквизитов Битрикс24 отдельно сопоставляет шаблоны; заполненного столбца в файле недостаточно для гарантии правильного результата. После импорта откройте несколько компаний и проверьте реквизиты. Подробности есть в <a href={sourceLinks[1].href} target="_blank" rel="noopener noreferrer">официальной инструкции</a>.</p>
    <p>Если компания уже есть в CRM, решите, обновлять её или оставлять без изменений до загрузки. Названия существующих организаций тоже нужны для следующего шага: именно с ними будет сравниваться значение поля «Компания» у контакта.</p>
  </section>

  <section aria-labelledby="contacts-second">
    <h2 id="contacts-second">Затем импортируйте <span data-heading-accent>контакты и связи</span></h2>
    <p>Откройте CRM → Клиенты → Контакты → Настройки (⚙️) → «Импорт из CSV со своими настройками». Скачайте шаблон, заполните сведения о людях и столбец «Компания». В нём укажите название компании так, как оно записано в CRM. Затем загрузите CSV и сопоставьте столбец с полем «Компания» в карточке контакта.</p>
    <p>По <a href={sourceLinks[0].href} target="_blank" rel="noopener noreferrer">справке Битрикс24</a>, связь создаётся по названию. Если в CRM значится «ООО Новые технологии», а в файле — «ООО «Новые технологии»», автоматическая связь не появится. Для компаний с похожими названиями проверьте результат вручную; простого совпадения текста недостаточно, чтобы убедиться, что выбран нужный контрагент.</p>
    <p>После небольшой пробной загрузки откройте контакт и посмотрите поле «Компания», затем перейдите в связанную карточку. На официальном снимке показана вкладка «Связи» компании; проверяйте и поле связи в самом контакте, особенно если он связан с несколькими организациями.</p>
    <ArticleFigure src={linksImage} fullSize alt="Официальная карточка компании Битрикс24 с вкладкой «Связи» и связанным контактом" caption="Скриншот Поддержки24 показывает реальные элементы интерфейса на демонстрационных данных. Вкладка помогает проверить связь после импорта, но не доказывает, что она появилась у всех строк вашей загрузки." />
  </section>

  <section aria-labelledby="duplicates">
    <h2 id="duplicates">Как выбрать режим <span data-heading-accent>обработки дублей</span></h2>
    <p>Мастер импорта компаний и контактов предлагает четыре режима. Выберите поля, по которым он будет искать совпадения, например название компании или телефон. Результат зависит от качества этих значений: одинаковый телефон может принадлежать двум людям, а одна компания может быть записана под разными названиями.</p>
    <DataTable label="Режимы обработки дублей при импорте компаний и контактов" columns={['Режим', 'Действие', 'Что проверить']} rows={modeRows} rowHeaders compact />
    <p>Если база уже частично заполнена, начните с небольшой партии и режима «Пропустить». Так вы увидите совпадения без перезаписи существующих карточек. Скачайте список пропущенных дублей и разберите спорные случаи. «Заменять» выбирайте только после сверки полей: этот режим может изменить уже заполненные данные. «Объединять» добавляет значения в пустые поля, но не решает самостоятельно, какая из двух похожих организаций правильная.</p>
    <p>Пробные строки не должны незаметно попасть во вторую загрузку с режимом «Разрешить». Уберите их из следующего файла или осознанно настройте обработку совпадений. Если после импорта получились реальные дубли, исправляйте их отдельно; не запускайте повторно тот же файл в надежде, что второй импорт сам всё исправит.</p>
  </section>

  <section aria-labelledby="verify-import">
    <h2 id="verify-import">Что проверить <span data-heading-accent>после загрузки</span></h2>
    <p>Сравните число строк исходных CSV, созданных карточек и пропущенных дублей. Откройте несколько компаний и контактов из начала и конца файла, в том числе строки с существующими клиентами. Сверьте названия, телефоны, e-mail и ответственного. Для контактов отдельно проверьте связь с компанией в карточке, а для компаний — нужные реквизиты, если их импортировали.</p>
    <p>Если связь не появилась, проверьте порядок импорта, точность названия компании и сопоставление поля «Компания». Если в таблице возникли смещённые колонки, вернитесь к разделителю CSV. Если часть строк была пропущена как дубли, скачайте файл со списком этих строк и выясните, по какому полю найдено совпадение.</p>
    <p>После исправления тестовой партии подготовьте основной файл. Сохраните исходные Excel и CSV, выбранные настройки дублей и список проверенных карточек, чтобы при следующем импорте было понятно, какие данные уже загружены. Когда клиентские карточки проверены, переходите к <a href={base + 'import-sdelok-bitrix24/'}>импорту сделок с привязкой к клиентам</a>. Это отдельный этап после компаний и контактов.</p>
    <InlineConsultation title="Переносите большую клиентскую базу?" description="Поможем проверить структуру файлов, правила дублей и связи на пробной партии перед основной загрузкой." actionLabel="Обсудить импорт" />
  </section>

  <FaqSection items={faqItems} id="faq" variant="article" />
  <ArticleSources publishedIso={article.publishedAt} sources={sourceLinks} />
  <Fragment slot="article-end"><RelatedArticles items={relatedArticles} /></Fragment>
  <Fragment slot="after-article"><ConsultationCtaSection title="Нужна помощь с импортом клиентов в CRM?" description="Разберём файлы, соответствие полей и проверку связей после пробной загрузки." actionLabel="Обсудить задачу" /></Fragment>
</ArticleLayout>
