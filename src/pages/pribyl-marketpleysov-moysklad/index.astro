---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import Checklist from '../../components/editorial/checklist.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import ozonImage from '../../images/articles/moysklad-ozon-costs-official.png';
import wbImage from '../../images/articles/moysklad-wildberries-costs-official.png';
import unitImage from '../../images/articles/moysklad-unit-economics-official.png';

const article = getArticle('pribyl-marketpleysov-moysklad/');
const { title, description } = article;
const canonicalPath = `/${article.hrefPath}`;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const imageAlt = 'Настройка затрат Ozon в МойСклад: выбор между себестоимостью и операционными расходами для разных услуг';
const ogImage = new URL(ozonImage.src, siteRoot).toString();
const titleParts = [{ text: 'Как проверить ' }, { text: 'прибыль Ozon и Wildberries', accent: true }, { text: ' в МойСклад' }];
const support = 'https://support.moysklad.ru/hc/ru/';
const sourceLinks = [
  { label: 'Ozon: отчёты и учёт дополнительных затрат — МойСклад', href: `${support}онлаин%20торговля/маркетплеисы/ozon` },
  { label: 'Wildberries: отчёты и управление затратами — МойСклад', href: `${support}онлаин%20торговля/маркетплеисы/wildberries` },
  { label: 'Юнит-экономика товаров: расходы и каналы продаж — МойСклад', href: `${support}отчеты/юнит_экономика_товаров` },
  { label: 'Прибыльность: реализация и себестоимость — МойСклад', href: `${support}отчеты/отчет_прибыльность` },
  { label: 'Прибыли и убытки: статьи и даты расходов — МойСклад', href: `${support}отчеты/прибыли_и_убытки` },
  { label: 'Детализация еженедельного отчёта реализации — Wildberries', href: 'https://seller.wildberries.ru/instructions/ru/ru/material/how-to-read-fimancial-reports-detalization' },
];
const exampleRows = [
  ['Продажи после учёта возвратов', '+100 000 ₽', 'Выручка выбранной группы товаров за период'],
  ['Закупочная стоимость проданных товаров', '−60 000 ₽', 'Только стоимость товара, без комиссии и услуг площадки'],
  ['Комиссия маркетплейса', '−15 000 ₽', 'В модели учитывается один раз'],
  ['Логистика и хранение', '−7 000 ₽', 'В модели удержаны площадкой'],
  ['Реклама', '−8 000 ₽', 'В этом примере оплачена отдельно от выплаты площадки'],
  ['Результат по перечисленным статьям', '=10 000 ₽', 'До остальных расходов бизнеса и налогов'],
];
const reviewSteps = [
  { title: 'Выберите один период и канал.', description: 'Начните с завершённого отчётного периода и нескольких знакомых товаров. Проверьте, загружены ли продажи и возвраты за него.' },
  { title: 'Сопоставьте затраты с документами.', description: 'Для комиссии, логистики, хранения и рекламы зафиксируйте сумму, источник и место учёта: себестоимость либо отдельный расход.' },
  { title: 'Проверьте расходы по каналу.', description: 'Посмотрите документы и статьи расходов. Убедитесь, что затрата не пропущена и не записана повторно другим способом.' },
  { title: 'Сравните отчёт с исходными документами.', description: 'Объясните расхождения на выбранных товарах, затем расширяйте проверку. Зафиксируйте период и состояние переключателя операционных расходов.' },
];
const faqItems = [
  { question: 'Почему выплата Ozon или Wildberries не равна прибыли?', answer: 'Выплата показывает расчёт с площадкой с учётом удержаний и корректировок. Для прибыли нужно также учесть стоимость проданных товаров и расходы бизнеса. Сначала разберите состав выплаты и выбранного показателя, чтобы не вычесть удержания повторно.' },
  { question: 'Учитывает ли МойСклад комиссию маркетплейса?', answer: 'В описании встроенных интеграций Ozon и Wildberries комиссия за продажу увеличивает себестоимость товара, а комиссия за возврат уменьшает её. Проверяйте загруженный отчёт и состав конкретного показателя: вычитать ту же комиссию второй раз нельзя.' },
  { question: 'Куда отнести логистику и хранение?', answer: 'В настройке дополнительных затрат встроенной интеграции их можно включать в себестоимость либо учитывать как операционные расходы. Выбор должен соответствовать принятому у вас способу учёта. Для каждой суммы проверьте документ и отсутствие повторного включения.' },
  { question: 'Все ли операционные расходы загружаются автоматически?', answer: 'При выбранном операционном способе интеграция создаёт Приёмку услуги. По актуальной справке на её основании нужно вручную создать Исходящий платёж и указать статью расходов. Наличие Приёмки само по себе не подтверждает, что весь путь учёта завершён.' },
  { question: 'Что делает переключатель операционных расходов в Юнит-экономике?', answer: 'Он меняет состав расчёта прибыли по товарам и каналам. При включённом учёте операционных расходов учитываемый расход с указанным каналом продаж относится к нему; без канала распределяется по товарам пропорционально сумме продаж. Сравнивать результаты нужно при одинаковых настройках.' },
  { question: 'Как проверить возвраты при расчёте прибыли?', answer: 'Сверьте не только уменьшение продаж, но и стоимость возвращённого товара, комиссию и связанные услуги по документам за выбранный период. Не заменяйте данные о реализации списком заказов: заказ ещё не подтверждает завершённую продажу.' },
  { question: 'Нужен ли отдельный сервис для первого расчёта?', answer: 'Сначала проверьте штатные отчёты МоегоСклада и полноту документов. Если нужный разрез или источник данных ими не покрыт, сформулируйте конкретное расхождение для доработки. Массовые операции TrueTell не заявляются здесь как готовый сервис расчёта прибыли маркетплейсов.' },
];
const relatedArticles = getRelatedArticles(article.hrefPath)
  .map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const structuredData = createArticleStructuredData({
  articleType: 'Article', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  articleSection: 'МойСклад и экономика маркетплейсов',
  breadcrumbs: [
    { name: 'Главная', item: siteRoot.toString() },
    { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() },
    { name: title, item: articleUrl },
  ], faqItems,
});
---

<ArticleLayout {title} {titleParts} {description} {canonicalPath} {structuredData}
  ogTitle={article.seoTitle} ogDescription={description} {ogImage} ogImageAlt={imageAlt}
  category={article.category} author={authorName}
  intro="Как сверить комиссии, логистику, хранение и рекламу в отчётах МоегоСклада и понять, какие затраты уже включены в результат продаж.">
  <Fragment slot="quick-answer">
    <p>Начните с загруженного <strong>Полученного отчёта комиссионера</strong> и настроек дополнительных затрат интеграции Ozon или Wildberries. Определите, что уже входит в себестоимость, а что учитывается отдельными расходами. Каждую сумму вычитайте только один раз.</p>
    <p>Сверьте продажи и возвраты за один период, проверьте документы расходов и нужный канал продаж. Выплата площадки и прибыль имеют разный состав; результат отчёта зависит от полноты документов и выбранных настроек.</p>
  </Fragment>

  <p data-article-lead>Продажи растут, деньги от маркетплейса поступают, а итог в таблице не сходится с ожиданиями. Часто проверку осложняет смешение разных величин: стоимость закупки сравнивают с себестоимостью отчёта, а удержанную комиссию вычитают ещё раз. Для сверки полезно восстановить путь одной суммы от документа площадки до итогового показателя.</p>

  <section aria-labelledby="costs">
    <h2 id="costs">Где комиссия и услуги <span data-heading-accent>уже учтены</span></h2>
    <p>Встроенные интеграции МоегоСклада для Ozon и Wildberries загружают отчёты реализации с комиссией и прочими услугами. По справке, комиссия за продажу увеличивает себестоимость товара, комиссия за возврат — уменьшает. Поэтому закупочная стоимость товара и себестоимость в конкретном отчёте могут иметь разный состав.</p>
    <p>Для дополнительных затрат есть режимы <strong>«Все в себестоимость»</strong>, <strong>«Все в расходы»</strong>, <strong>«Настроить вручную»</strong> и <strong>«Никакие не учитывать»</strong>. Перед расчётом посмотрите, какой вариант выбран в вашем подключении. Не меняйте способ учёта ради получения ожидаемой цифры: сначала объясните текущие документы.</p>

    <h3>Ozon: проверьте каждую категорию затрат</h3>
    <p>В настройках отчётов подключения Ozon откройте <strong>«Настроить учет затрат»</strong>. При включении в себестоимость дополнительные суммы попадают в «Прочие услуги» Полученного отчёта комиссионера; комментарий помогает разобрать их состав. При операционном способе создаётся Приёмка соответствующей услуги.</p>
    <ArticleFigure src={ozonImage} fullSize alt={imageAlt}
      caption="Официальный пример настройки Ozon из справки МоегоСклада. Показаны разные способы учёта логистики, хранения и рекламы. Это демонстрация интерфейса; выбранные на экране варианты не являются рекомендацией для вашего аккаунта." />

    <h3>Wildberries: сверяйте настройку с детализацией отчёта</h3>
    <p>В подключении Wildberries также доступны способы распределения дополнительных затрат. Сопоставьте их с <a href={sourceLinks[5].href} target="_blank" rel="noopener noreferrer">детализацией отчёта реализации площадки</a>. Отдельные строки логистики, хранения и других удержаний помогают проверить происхождение итоговой суммы. Не заменяйте эту сверку одним числом «к перечислению».</p>
    <ArticleFigure src={wbImage} fullSize
      alt="Настройка затрат Wildberries в МойСклад: логистика, хранение, платная приёмка и другие категории с выбором способа учёта"
      caption="Подлинный экран из справки МоегоСклада по Wildberries: категории затрат и способы их распределения. Настройки отличаются по категориям; названия услуг и выбранные значения относятся к примеру справки." />
    <p><strong>При операционном способе проверьте следующий шаг.</strong> Актуальная справка обеих интеграций требует на основании Приёмки вручную создать <strong>Исходящий платёж</strong> и указать статью расходов. Автоматическое создание платежей там обозначено как будущая возможность. Одна загруженная Приёмка ещё не доказывает, что расход полностью отражён в нужном отчёте.</p>
  </section>

  <section aria-labelledby="example">
    <h2 id="example">Учебный расчёт: <span data-heading-accent>100 000 ₽ продаж и 10 000 ₽ результата</span></h2>
    <p>Рассмотрим условную группу товаров за один период. Продажи и закупочная стоимость ниже уже скорректированы на возвраты. В строке стоимости товара пока нет комиссии и услуг площадки. Суммы придуманы для объяснения расчёта и не описывают действующие тарифы Ozon или Wildberries.</p>
    <DataTable label="Учебный расчёт результата после расходов маркетплейса" columns={['Статья', 'Сумма', 'Граница расчёта']} rows={exampleRows} rowHeaders />
    <p>В этой модели площадка перечисляет <strong>78 000 ₽</strong>: 100 000 − 15 000 − 7 000. После стоимости товара 60 000 ₽ и отдельно оплаченной рекламы 8 000 ₽ остаётся <strong>10 000 ₽</strong>. Комиссию и логистику повторно из выплаты не вычитаем.</p>
    <p>Если вы начинаете с выручки 100 000 ₽, а в используемой себестоимости отчёта уже находятся товар и эти 22 000 ₽ затрат площадки, её величина составит 82 000 ₽. Тогда до отдельно учтённой рекламы останется 18 000 ₽, после неё — те же 10 000 ₽. Оба пути сходятся, когда у каждой статьи одно место в расчёте.</p>
    <p>Это результат только по перечисленным статьям. Чтобы получить итог бизнеса, нужно проверить остальные расходы и налоги. Не называйте 10 000 ₽ чистой прибылью, пока состав расчёта не определён полностью.</p>
  </section>

  <section aria-labelledby="reports">
    <h2 id="reports">Как проверить результат <span data-heading-accent>по товарам и каналам</span></h2>
    <p>Откройте <strong>Продажи → Юнит-экономика</strong> и задайте период. Отчёт сравнивает прибыльность товаров в разных каналах продаж. Проверьте переключатель <strong>«Распределить операционные расходы»</strong>: включённый и выключенный варианты показывают результат с разным составом затрат.</p>
    <ArticleFigure src={unitImage} fullSize
      alt="Отчёт Юнит-экономика МоегоСклада: период, переключатель распределения операционных расходов и колонки каналов продаж"
      caption="Подлинный общий пример отчёта из справки МоегоСклада. На экране показаны «Строительный магазин» и «Без канала продаж», а не Ozon или Wildberries. Он иллюстрирует устройство отчёта и переключатель расходов, но не подтверждает данные конкретного подключения." />
    <p>При включённом учёте операционных расходов учитываемый расход с указанным каналом продаж относится к нему. Без канала он распределяется по товарам пропорционально сумме продаж. Такая общая сумма может влиять сразу на несколько направлений; при неожиданном результате проверьте, к какому каналу отнесён исходный документ.</p>
    <p>Не каждый платёж входит в операционные расходы отчёта. Справка исключает документы со статьями «Закупка товаров», «Перемещение» и «Возврат», а также статьи с выключенной настройкой <strong>«Учитывать в прибыли»</strong>. Поэтому при расхождении проверьте не только сумму платежа, но и его статью.</p>
    <Checklist label="Последовательность сверки прибыли маркетплейса" items={reviewSteps} />
    <p>Для результата всей организации используйте <strong>Деньги → Прибыли и убытки</strong>; для этого отчёта нужна опция «Финансы». Проверяйте статью расхода, её настройку «Учитывать в прибыли» и дату начисления. Общий выбор между отчётами разобран в <a href={`${base}otchety-moysklad/`}>инструкции по отчётам МоегоСклада</a>.</p>
    <InlineConsultation title="Суммы расходятся между площадкой и МойСклад?" description="Разберём один период и несколько товаров: откуда взята сумма, где учтена комиссия и какие документы объясняют разницу." />
  </section>

  <section aria-labelledby="differences">
    <h2 id="differences">С чего начать, <span data-heading-accent>если цифры не сходятся</span></h2>
    <p>Сравнивайте одинаковые периоды и наборы товаров. Возврат, попавший в другой период, корректировка или ещё не загруженный отчёт могут менять результат. Сверьте продажи, возвращённые товары и их стоимость по документам, затем переходите к услугам и расходам. Список заказов сам по себе не заменяет данные о реализации.</p>
    <p>Для каждой спорной суммы запишите источник, дату, знак и документ в МойСклад. Затем определите, включена ли она в себестоимость, отдельный расход или пока нигде не отражена. Если источник повторяет уже учтённую затрату, повторное вычитание занизит прибыль; пропущенный расход завысит её.</p>
    <p>Проверка обмена заказами, остатками и ценами — отдельный сценарий. Его порядок описан в статье <a href={`${base}moysklad-dlya-marketpleysov/`}>о подключении МоегоСклада к маркетплейсам</a>.</p>
  </section>

  <FaqSection variant="article" items={faqItems} />
  <ArticleSources sources={sourceLinks} publishedIso={article.publishedAt} modifiedIso={article.updatedAt} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Сверьте ' }, { text: 'состав прибыли', accent: true }]}
      description="Обсудим источники продаж и затрат, документы и нужный разрез отчёта. Начнём с конкретного расхождения в данных."
      href={companyInfo.contacts.consultationUrl} actionLabel="Обсудить расчёт" />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <ConsultationCtaSection slot="after-article" />
</ArticleLayout>
