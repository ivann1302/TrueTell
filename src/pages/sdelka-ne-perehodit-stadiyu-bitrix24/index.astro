---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { mcpProduct } from '../../config/products';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import outcomeImage from '../../images/articles/bitrix24-stage-transition-outcomes-133.png';
import scopeImage from '../../images/articles/bitrix24-required-field-scope-133.png';

const article = getArticle('sdelka-ne-perehodit-stadiyu-bitrix24/');
const { title, description } = article;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const ogImage = new URL(outcomeImage.src, siteRoot).toString();
const imageAlt = 'Три результата попытки перевести сделку: запрос заполнить поле, отказ в доступе или возврат на прежнюю стадию';
const faqItems = [
  { question: 'Почему сделка не переходит на следующую стадию Битрикс24?', answer: 'Сначала повторите переход в карточке и запишите точное сообщение. Если Битрикс24 просит заполнить поле, проверьте его значение и обязательность на целевой стадии нужной воронки. Если речь о доступе, проверьте права сотрудника на изменение и перемещение. Когда стадия сначала изменилась, а затем вернулась, изучите историю карточки и автоматизацию.' },
  { question: 'Где настроено обязательное поле для стадии сделки?', answer: 'Администратор или сотрудник с правом менять настройки CRM может открыть карточку сделки, навести курсор на поле и выбрать «Настройки» → «Настроить». В параметре «Обязательное на стадии» видно, для каких стадий и воронок действует правило. Стадийная обязательность доступна не на всех тарифах.' },
  { question: 'Почему у коллеги сделка переходит, а у меня нет?', answer: 'Сравните одну и ту же сделку, воронку, целевую стадию и точный текст отказа. Роли могут различаться правом «Перемещение на стадию». Кроме того, обязательное пользовательское поле с ограниченной видимостью должны заполнять только сотрудники, которым оно доступно. По одному результату нельзя определить причину без проверки настроек.' },
  { question: 'Может ли робот на новой стадии заполнить обязательное поле перед переходом?', answer: 'Робот целевой стадии не стоит считать способом обойти незаполненное обязательное поле при ручном переходе. Сначала выполните требование для сохранения и перемещения, затем проверьте, запускалась ли автоматизация после перехода. Метод crm.item.update проверяет права и стадийные обязательные поля, когда меняется стадия в рамках того же направления.' },
  { question: 'Нужно ли отключить обязательность, чтобы сдвинуть зависшие сделки?', answer: 'Сначала выясните, какое поле и для какой стадии настроено, и заполните достоверное значение в контрольной сделке. Если правило мешает рабочему процессу, согласуйте изменение с владельцем CRM и проверьте его на одной сделке в той же воронке. Массовое снятие обязательности может убрать нужный контроль данных.' },
  { question: 'MCP TrueTell уже проверяет причины отказа автоматически?', answer: 'Такую автоматическую проверку мы пока не заявляем. MCP TrueTell для настройки и диагностики CRM находится в разработке. Для обсуждения сценария достаточно номера сделки, названия воронки и стадии, обезличенного текста ошибки и роли сотрудника; данные клиента отправлять не нужно.' },
];
const sourceLinks = [
  { label: 'Битрикс24: как сделать поле обязательным в карточке CRM', href: 'https://helpdesk.bitrix24.ru/open/27744544/' },
  { label: 'Битрикс24: как контролировать сделки, взятые в работу', href: 'https://helpdesk.bitrix24.ru/open/25552664/' },
  { label: 'Битрикс24: ролевая модель прав в CRM', href: 'https://helpdesk.bitrix24.ru/open/23240636/' },
  { label: 'Битрикс24: ограниченная видимость пользовательских полей', href: 'https://helpdesk.bitrix24.ru/open/23204032/' },
  { label: 'Битрикс24: пример запроса обязательного поля перед запуском робота', href: 'https://helpdesk.bitrix24.ru/open/28120760/' },
  { label: 'Битрикс24: история изменений карточки CRM', href: 'https://helpdesk.bitrix24.ru/open/24296386/' },
  { label: 'Битрикс24: робот «Сменить стадию»', href: 'https://helpdesk.bitrix24.ru/open/22381314/' },
  { label: 'Битрикс24 REST API: обновление элемента и проверки при смене стадии', href: 'https://apidocs.bitrix24.ru/api-reference/crm/universal/crm-item-update.html' },
];
const checkRows = [
  ['Просьба заполнить поле', 'Название поля и его значение в карточке', 'Правило для целевой стадии нужной воронки'],
  ['Отказ в перемещении', 'Роль сотрудника и точный текст сообщения', 'Право «Перемещение на стадию» и доступ к стадии'],
  ['Переход состоялся, затем откатился', 'Время и автор изменений в истории сделки', 'Роботы и другие действия после перехода'],
];
const structuredData = createArticleStructuredData({
  articleType: 'Article', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  breadcrumbs: [{ name: 'Главная', item: siteRoot.toString() }, { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() }, { name: title, item: articleUrl }],
  faqItems,
});
---
<ArticleLayout {title} titleParts={[{ text: 'Сделка не переходит ' }, { text: 'на стадию Битрикс24', accent: true }]} {description}
  canonicalPath={`/${article.hrefPath}`} {structuredData} ogTitle={article.seoTitle} ogDescription={description}
  {ogImage} ogImageAlt={imageAlt} category={article.category} author={authorName}
  intro="Менеджер передвинул сделку, а она осталась на месте. Повторите действие на той же карточке и запишите ответ Битрикс24: сообщение о поле, отказ в доступе или смену стадии с последующим возвратом.">
  <Fragment slot="quick-answer">
    <p><strong>Откройте одну сделку и повторите переход в нужную стадию. Запишите точное сообщение и название поля, если Битрикс24 попросил его заполнить.</strong> Введите достоверное значение, сохраните и проверьте стадию. Если сделка осталась на прежнем этапе, повторите переход и зафиксируйте результат.</p>
    <p>Если запроса о поле нет, проверьте право сотрудника на перемещение в эту стадию. Если переход состоялся, но сделка вернулась назад, откройте историю и проверьте автоматизацию. Не меняйте настройки всех сделок по одному неразобранному случаю.</p>
  </Fragment>

  <p data-article-lead>Для диагностики возьмите ID одной сделки, на которой переход не удался. Запишите текущую и целевую стадии, воронку и пользователя. Попросите его повторить действие в карточке сделки или канбане и сохранить точный текст сообщения без данных клиента.</p>

  <section aria-labelledby="one-attempt">
    <h2 id="one-attempt">Определите, <span data-heading-accent>на каком шаге остановилась сделка</span></h2>
    <p>Битрикс24 может попросить заполнить обязательное поле до сохранения или отказать в праве перемещения. Если стадия успела измениться и позже стала прежней, проверяйте историю действий после перехода.</p>
    <ArticleFigure src={outcomeImage} fullSize alt={imageAlt} caption="Редакционная схема по официальной справке Битрикс24. Она различает три результата одной попытки и не изображает интерфейс или данные клиентского портала." />
    <p>Сохраните скриншот только сообщения об ошибке и номер сделки, если это допускают правила вашей компании. Содержание переписки и персональные данные для поиска причины не нужны. Если сотрудник не видит саму карточку, начните с <a href={`${base}ne-vidno-sdelku-bitrix24-prava/`}>проверки видимости сделки и прав чтения</a>.</p>
  </section>

  <section aria-labelledby="required-field">
    <h2 id="required-field">Когда Битрикс24 <span data-heading-accent>просит заполнить поле</span></h2>
    <p>Пользовательские и некоторые системные поля CRM можно сделать обязательными. Пока обязательное поле пустое, сотрудник не сможет сохранить или переместить сделку. В карточке такое поле отмечено красной звёздочкой. Укажите реальное значение, сохраните и проверьте стадию. Если сделка осталась на месте, повторите переход; произвольный текст ради обхода проверки испортит данные.</p>
    <p>Если правило кажется неожиданным, попросите администратора проверить настройку именно для воронки и целевой стадии. В карточке сделки наведите курсор на поле и откройте «Настройки» → «Настроить». Параметр «Обязательное на стадии» может действовать на все стадии и воронки либо на выбранные стадии конкретной воронки. Менять его может администратор или сотрудник с правом изменения настроек CRM. Доступность настройки обязательности по стадиям зависит от тарифа.</p>
    <ArticleFigure src={scopeImage} fullSize alt="Учебный пример проверки обязательного поля: воронка Продажи, целевая стадия Договор, пустой номер договора и проверка стадии после заполнения" caption="Учебный пример без данных клиента. Важно проверить требование на целевой стадии той воронки, где находится сделка; это не снимок настроек Битрикс24." />
    <p>Если поле не видно в карточке сотрудника, не делайте вывод, что именно оно блокирует переход. В Битрикс24 пользовательское поле с ограниченной видимостью должны заполнять только сотрудники, которым оно доступно. Администратор может сопоставить видимость и обязательность поля с ролью сотрудника. О том, чем системная обязательность отличается от требований стадии, есть отдельный материал <a href={`${base}tipy-poley-crm-bitrix24/`}>о типах полей CRM</a>.</p>
  </section>

  <section aria-labelledby="rights-and-automation">
    <h2 id="rights-and-automation">Если проблема <span data-heading-accent>не в незаполненном поле</span></h2>
    <p>При отказе в доступе администратор проверяет роль сотрудника и право «Перемещение на стадию», а также ограничения конкретной стадии. Сравните точный текст ошибки и результат на той же сделке под уполномоченным пользователем. Не расширяйте доступ ко всей CRM только ради одной карточки.</p>
    <p>Если стадия изменилась, а затем сделка вернулась, откройте историю карточки и отметьте время и автора следующего изменения. После этого проверьте действия роботов и процессов на текущей и целевой стадиях. У нас есть <a href={`${base}robot-ne-srabatyvaet-bitrix24/`}>отдельная инструкция для робота, который не сработал</a>; она пригодится, когда переход уже состоялся.</p>
    <p>Робот на целевой стадии не следует считать способом заполнить обязательное поле до ручного перехода: сначала Битрикс24 проверяет сохранение и перемещение. Для метода REST <code>crm.item.update</code> официальная документация описывает проверку прав и стадийных обязательных полей при смене стадии в рамках того же направления до запуска роботов. Если сделку перемещает интеграция, зафиксируйте её ответ об ошибке и сверяйте его с настройкой поля и правами того подключения.</p>
    <DataTable label="Проверка отказа при смене стадии сделки" columns={['Что произошло', 'Что зафиксировать', 'Где искать причину']} rows={checkRows} rowHeaders />
  </section>

  <section aria-labelledby="confirm-fix">
    <h2 id="confirm-fix">Проверьте исправление <span data-heading-accent>на той же сделке</span></h2>
    <p>После заполнения поля или согласованного изменения настройки проверьте стадию сделки. Если она не изменилась, повторите переход с той же ролью и воронкой. Убедитесь, что карточка осталась в целевой стадии после работы автоматизации. В записи диагностики оставьте ID, название поля, целевую стадию, текст ошибки и принятое изменение. Так можно отличить единичный пропуск данных от неверного правила для всей воронки.</p>
    <p>Если обязательность мешает нормальной работе, обсудите правило с владельцем процесса до изменения. Возможно, поле требуется на более поздней стадии или должно заполняться другим сотрудником. После корректировки проверьте соседние стадии той же воронки, чтобы нужные данные по-прежнему собирались.</p>
    <p>MCP TrueTell для настройки и диагностики CRM находится в разработке. Автоматический поиск причин отказа и исправление полей пока не заявлены. Можно обсудить, какие сведения понадобятся для будущей диагностики: обезличенный текст ошибки, стадию, воронку и права подключения.</p>
    <InlineConsultation variant="product" title="Переход блокируется в нескольких сделках?" description="Опишите стадию, поле или сообщение об отказе без данных клиентов. Поможем отделить настройку обязательности от прав и автоматизации и обсудим сценарий диагностики CRM." href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
  </section>

  <FaqSection title="Частые вопросы о переходе сделки на стадию" items={faqItems} variant="article" />
  <p>Официальная справка Битрикс24 проверена 31 октября 2026 года. Конкретный клиентский портал и его роли не проверялись; элементы интерфейса и доступность опций зависят от тарифа и прав.</p>
  <ArticleSources publishedIso={article.publishedAt} modifiedIso={article.updatedAt} sources={sourceLinks} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Обсудим ' }, { text: 'диагностику CRM с MCP TrueTell', accent: true }]} description={mcpProduct.articleDescription} href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <ConsultationCtaSection slot="after-article" />
</ArticleLayout>
