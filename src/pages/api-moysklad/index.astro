---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import dataMapImage from '../../images/articles/moysklad-api-data-map-091.png';
import authDocsImage from '../../images/articles/moysklad-api-auth-official-091.png';

const article = getArticle('api-moysklad/');
const { title, description } = article;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const canonicalPath = `/${article.hrefPath}`;
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const imageAlt = 'Карта разделов JSON API МойСклад: товары, розничные документы, платежи и отчёты';
const ogImage = new URL(dataMapImage.src, siteRoot).toString();
const titleParts = [
  { text: 'API МойСклад: какие данные можно получить ' },
  { text: 'и как обойтись без программиста', accent: true },
];
const dataRows = [
  ['Товары, модификации, склады', 'Справочники', 'Состав ассортимента, карточки и места хранения'],
  ['Розничные продажи, возвраты, смены', 'Документы', 'Чеки, возвраты, точка и период продажи'],
  ['Входящие и исходящие платежи', 'Документы', 'Движение денег; правила ДДС задаются отдельно'],
  ['Остатки на дату', 'Отчёт', 'Срез запаса по заданному моменту, с учётом прав и фильтров'],
  ['События изменения и удаления', 'Аудит', 'Проверка изменений при наличии доступа к журналу'],
];
const limitRows = [
  ['Токен пользователя или логин и пароль', '15 обычных запросов за 3 секунды', 'С 1 сентября до 30 ноября 2026 года; с 1 декабря по опубликованному графику — 11'],
  ['Токен опубликованного решения', '45 обычных запросов за 3 секунды', 'Лимит считается отдельно для каждого решения'],
  ['Токен решения в статусе «Черновик» или «На модерации»', '11 обычных запросов за 3 секунды', 'Отдельное правило для разработки решения'],
  ['Два метода отчёта остатков: /report/stock/all и /report/stock/bystore', 'Вес 5 единиц за запрос', 'Вес не зависит от способа авторизации'],
];
const faqItems = [
  { question: 'Можно ли пользоваться API МойСклад без программиста?', answer: 'Создать токен в интерфейсе можно без разработки. Для регулярных запросов, обработки страниц ответа и изменений нужен настроенный процесс. Если задача решается одним отчётом, удобнее начать с интерфейса МойСклад или проверить готовую интеграцию.' },
  { question: 'Где находится документация API МойСклад?', answer: 'Официальная документация JSON API 1.2 размещена на dev.moysklad.ru. В ней есть разделы «Сущности», «Документы», «Отчёты», «Аудит» и описание ограничений.' },
  { question: 'Можно ли через API только читать данные?', answer: 'JSON API поддерживает и чтение, и изменение. Возможности конкретного токена зависят от прав сотрудника либо прав, выданных решению. Для аналитики заранее проверьте нужные права и не передавайте токен в открытый доступ.' },
  { question: 'Можно ли получить остаток за прошлую дату через API?', answer: 'Да. Для отчёта об остатках в документации описан фильтр moment. Для истории по многим датам потребуется отдельный процесс получения, хранения и сверки с отчётом МойСклад.' },
];
const sourceLinks = [
  { label: 'JSON API 1.2 — официальная документация МойСклад', href: 'https://dev.moysklad.ru/doc/api/remap/1.2/' },
  { label: 'Лимиты и тарифные ограничения JSON API — официальный репозиторий МойСклад', href: 'https://github.com/moysklad/api-remap-1.2-doc/blob/master/md/_restrictions.md' },
  { label: 'Создание токена в интерфейсе — справка МойСклад', href: 'https://support.moysklad.ru/hc/ru/касса%20и%20розница/онлайн%20кассы/интеграция_с_онлайн_кассами_aqsi' },
  { label: 'Отчёт об остатках через API — официальный репозиторий МойСклад', href: 'https://github.com/moysklad/api-remap-1.2-doc/blob/master/md/reports/_report_stock.md' },
  { label: 'Аудит изменений — официальный репозиторий МойСклад', href: 'https://github.com/moysklad/api-remap-1.2-doc/blob/master/md/audit/_audit.md' },
  { label: 'Доступ серверных решений — Vendor API МойСклад', href: 'https://dev.moysklad.ru/doc/api/vendor/1.0/' },
];
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({
  ...item,
  description: item.summaryDescription ?? item.description,
  href: `${base}${item.hrefPath}`,
}));
const structuredData = createArticleStructuredData({
  articleType: 'Article',
  title,
  description,
  articleUrl,
  publishedDate: article.publishedAt,
  modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(),
  image: ogImage,
  author: authorName,
  breadcrumbs: [
    { name: 'Главная', item: siteRoot.toString() },
    { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() },
    { name: title, item: articleUrl },
  ],
  faqItems,
});
---

<ArticleLayout {title} {titleParts} {description} {canonicalPath} {structuredData}
  ogTitle={article.seoTitle} ogDescription={description} {ogImage} ogImageAlt={imageAlt}
  category={article.category} author={authorName}
  intro="Разбираем данные JSON API 1.2, токены, права и лимиты. Показываем, когда для задачи достаточно штатного отчёта или готовой интеграции.">
  <Fragment slot="quick-answer">
    <p>Через JSON API МойСклад можно получать товары, документы, отдельные отчёты и события аудита. Доступ к конкретным данным зависит от прав и тарифа.</p>
    <p>Токен создают в интерфейсе без кода. Для регулярной выгрузки понадобится настроить запросы, хранение данных и контроль ошибок. Если нужен один файл, начните со штатного отчёта.</p>
  </Fragment>

  <p data-article-lead>Частый вопрос звучит так: «Можно ли просто подключить API и получить все продажи с остатками в одной таблице?» API даёт исходные записи. Какие документы брать, как связать их по товарам и датам и что считать выручкой, решает тот, кто строит отчёт. Поэтому до токена полезнее выбрать один показатель и проверить, из каких данных он складывается.</p>

  <section aria-labelledby="data">
    <h2 id="data">Какие данные <span data-heading-accent>доступны через API</span></h2>
    <p>Документация JSON API 1.2 разделяет справочники, документы, отчёты и аудит. Для магазина это могут быть карточки товаров и модификаций, розничные продажи и возвраты, смены, платежи и срез остатков. Состав полей у каждого ресурса свой; наличие ресурса в документации ещё не гарантирует доступ к нему вашему сотруднику или решению.</p>
    <ArticleFigure src={dataMapImage} fullSize portrait alt={imageAlt} caption="Схема показывает, с какого раздела документации начать поиск данных. Это примеры ресурсов, а не обещание доступа на любом тарифе." />
    <DataTable label="Примеры данных МойСклад для разных аналитических вопросов" columns={['Что нужно', 'Раздел API', 'Что поможет проверить']} rows={dataRows} rowHeaders />
    <p>Например, продажа и возврат находятся в разных документах. Для отчёта о чистой выручке их нужно сопоставить и определить, какую дату и какую сумму включать. Если задача уже решается штатным отчётом, посмотрите <a href={`${base}otchety-moysklad/`}>разбор отчётов МойСклад</a> до начала собственной интеграции.</p>
  </section>

  <section aria-labelledby="token">
    <h2 id="token">Где взять <span data-heading-accent>токен API</span></h2>
    <p>В официальной справке МойСклад путь указан так: <strong>Меню пользователя → Настройки → Токены → +Токен</strong>. После создания скопируйте значение и сохраните его в настройках того инструмента, которому доверяете доступ. Токен даёт возможность обращаться к данным от имени пользователя; не вставляйте его в публичные документы, чаты или примеры запросов.</p>
    <p>Документация описывает и другой способ: запрос к <code>/security/token</code> с логином и паролем. При выпуске токена этим способом прежние токены пользователя отзываются. Для знакомства с API не перевыпускайте рабочий токен действующей интеграции.</p>
    <ArticleFigure src={authDocsImage} fullSize alt="Официальная документация JSON API МойСклад: раздел аутентификации и получение токена" caption="Скриншот официальной документации JSON API 1.2, 25 октября 2026 года. На экране показаны способы авторизации и предупреждение об отзыве прежних токенов при выпуске нового через API." />
    <p>При запросе программа передаёт токен в заголовке <code>Authorization: Bearer &lt;токен&gt;</code>. Сначала проверьте права сотрудника, для которого он создан. У решения из каталога доступ задаётся отдельно при его установке. Доступ к себестоимости, финансовым документам и аудиту проверяйте на своём аккаунте; тариф тоже влияет на доступную функциональность.</p>
  </section>

  <section aria-labelledby="first-check">
    <h2 id="first-check">Как понять, <span data-heading-accent>подходит ли API для задачи</span></h2>
    <p>Возьмите один вопрос, например «Какие товары продали в этой точке за вчера?». Найдите в документации розничную продажу, проверьте нужные поля, фильтр по точке и права на просмотр. Затем попросите разработчика или поставщика интеграции получить небольшую выборку, например один документ с позициями, и сравните его с интерфейсом МойСклад.</p>
    <p>Для первого чтения товара в документации есть ресурс <code>/entity/product</code>. Технический пробный запрос вроде <code>GET /entity/product?limit=1</code> проверяет авторизацию и форму ответа, но ничего не говорит о полноте будущего отчёта. В реальном запросе нужны заголовки авторизации и <code>Accept-Encoding: gzip</code>. Для отчёта отдельно понадобятся возвраты, позиции документов, справочники и правила расчёта. Если нужен ежедневный результат, проверьте также постраничное чтение, повтор неудачных запросов и сверку итогов.</p>
    <p>Разобрать выбор между файлом, рассылкой, API и своей базой помогает <a href={`${base}vygruzka-dannyh-moysklad-dlya-analitiki/`}>сравнение способов выгрузки данных</a>. Здесь важнее выяснить, какие ресурсы API действительно нужны вашему показателю.</p>
  </section>

  <section aria-labelledby="limits">
    <h2 id="limits">Какие лимиты API <span data-heading-accent>учесть в 2026 году</span></h2>
    <p>По правилам МойСклад, действующим на 25 октября 2026 года, для обычных методов доступно 45 единиц лимита на три секунды отдельно для пользователя или решения. Сколько единиц списывает запрос, зависит от способа авторизации. Поэтому одинаковый скрипт может получить разный предел запросов в зависимости от токена.</p>
    <DataTable label="Лимиты JSON API МойСклад по способу доступа на 25 октября 2026 года" columns={['Способ доступа или метод', 'Текущий предел', 'Условие']} rows={limitRows} rowHeaders />
    <p>Кроме временного лимита, допускается не более пяти параллельных запросов от пользователя или решения и 20 на аккаунт. При ответе 429 проверьте причину: для временного лимита учитывайте заголовки ответа и паузу, а при превышении числа одновременных запросов уменьшайте параллельность. Эти числа и объявленное изменение с 1 декабря стоит перепроверить в <a href={sourceLinks[1].href} target="_blank" rel="noopener noreferrer">официальном разделе ограничений</a> перед запуском интеграции.</p>
  </section>

  <section aria-labelledby="updates">
    <h2 id="updates">Что проверить, чтобы <span data-heading-accent>отчёт не устарел</span></h2>
    <p>Разовая выборка подтверждает только состояние на момент запроса. При регулярной загрузке нужно решить, как замечать исправленные документы и пересчитывать зависимые показатели. Например, новая приёмка с датой прошлого месяца способна изменить расчёт себестоимости, даже если сама продажа не редактировалась. Загрузка только продаж с новым <code>updated</code> может оставить прежний результат в аналитической копии. Для таких показателей задают период повторной сверки с МойСклад.</p>
    <p>Документы, отправленные в корзину, можно выбирать с <code>isDeleted=true</code>. Журнал аудита отдельно описывает события удаления и восстановления, если у интеграции есть право его читать. Обработку окончательных удалений и архивных карточек проверяйте на конкретных сущностях, а не предполагайте по одному ответу списка.</p>
    <p>Для остатков на прошлую дату документация отчёта поддерживает фильтр <code>moment</code>. Чтобы получить историю по дням, нужно запрашивать нужные даты, сохранять результаты и сопоставлять их с <a href={`${base}ostatki-moysklad/`}>отчётом об остатках</a>. Пустая строка ответа и нулевой остаток требуют отдельной проверки при построении графика.</p>
  </section>

  <section aria-labelledby="without-code">
    <h2 id="without-code">Когда можно <span data-heading-accent>обойтись без разработчика</span></h2>
    <p>Для одного отчёта за период API обычно не нужен: сформируйте файл в интерфейсе. Если тот же отчёт нужен по расписанию, проверьте его автоматическую отправку. Готовое решение для обмена или аналитики берёт на себя технические запросы, но до подключения попросите показать состав данных, права, частоту обновления и сверку с вашими цифрами.</p>
    <p>TrueTell разрабатывает инструмент подготовки данных МойСклад для аналитики. Пока мы не обещаем установку, конкретные витрины и частоту обновления: сначала проверяем нужные данные и сценарий на задаче клиента.</p>
    <InlineConsultation title="Проверяете, хватит ли API для отчёта?" description="Назовите показатель, период и магазин. Поможем определить документы, права и первую сверку с МойСклад." />
  </section>

  <FaqSection id="faq" title="Частые вопросы об API МойСклад" items={faqItems} variant="article" />
  <p>Официальная документация проверена 25 октября 2026 года. Доступ к клиентскому аккаунту, его тарифу и рабочему токену при подготовке статьи не проверялся.</p>
  <ArticleSources publishedIso={article.publishedAt} modifiedIso={article.updatedAt} sources={sourceLinks} />

  <Fragment slot="article-end">
    <ArticleProductCta
      titleParts={[{ text: 'Нужны данные МойСклад ' }, { text: 'для своих отчётов?', accent: true }]}
      description="TrueTell разрабатывает инструмент подготовки данных для аналитики. Расскажите, какие показатели и источники нужно связать: обсудим состав данных и способ проверки."
      href={companyInfo.contacts.consultationUrl}
      actionLabel="Обсудить задачу"
    />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <ConsultationCtaSection slot="after-article" />
</ArticleLayout>
