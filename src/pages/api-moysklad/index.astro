---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { moyskladMcpProduct, moyskladMcpProductPath } from '../../config/products';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import responseImage from '../../images/articles/moysklad-api-first-response-162.png';
import authDocsImage from '../../images/articles/moysklad-api-auth-official-091.png';

const article = getArticle('api-moysklad/');
const { title, description } = article;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const canonicalPath = `/${article.hrefPath}`;
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const imageAlt = 'Учебный ответ API МойСклад. В meta.size указано 2 товара, в rows одна карточка';
const ogImage = new URL(responseImage.src, siteRoot).toString();
const titleParts = [
  { text: 'API МойСклад: ' },
  { text: 'токен и первый запрос', accent: true },
];
const firstRequest = [
  'read -r -s MOYSKLAD_TOKEN',
  'curl --silent --show-error --include --compressed \\',
  '  -H \'Accept-Encoding: gzip\' \\',
  '  -H "Authorization: Bearer $MOYSKLAD_TOKEN" \\',
  "  'https://api.moysklad.ru/api/remap/1.2/entity/product?limit=1'",
  'unset MOYSKLAD_TOKEN',
].join('\n');
const dataRows = [
  ['Товары, модификации, склады', 'Справочники', 'Состав ассортимента, карточки и места хранения'],
  ['Розничные продажи, возвраты, смены', 'Документы', 'Чеки, возвраты, точка и период продажи'],
  ['Входящие и исходящие платежи', 'Документы', 'Движение денег по документам'],
  ['Остатки на дату', 'Отчёт', 'Срез запаса по заданному моменту, с учётом прав и фильтров'],
  ['События изменения и удаления', 'Аудит', 'Проверка изменений при наличии доступа к журналу'],
];
const limitRows = [
  ['Токен пользователя или логин и пароль', '15 обычных запросов за 3 секунды', 'По 30 ноября 2026 года включительно. С 1 декабря лимит снижается до 11 запросов'],
  ['Токен публичного или приватного решения', '45 обычных запросов за 3 секунды', 'Лимит учитывается для каждого решения отдельно'],
  ['Токен решения в статусе «Черновик» или «На модерации»', '11 обычных запросов за 3 секунды', 'Отдельное правило для разработки решения'],
  ['Два метода отчёта остатков: /report/stock/all и /report/stock/bystore', 'Вес 5 единиц за запрос', 'Вес не зависит от способа авторизации'],
];
const statusRows = [
  ['401', 'Проверьте токен, заголовок Authorization и доступ к учётной записи.'],
  ['403', 'Посмотрите сообщение в errors и проверьте права сотрудника на данные, которые запрашиваете.'],
  ['415', 'Проверьте, что в запросе указан заголовок Accept-Encoding: gzip.'],
  ['429', 'При превышении частоты выждите время из заголовка X-Lognex-Retry-After в миллисекундах, если он есть. При ошибке 1073 уменьшите число одновременных запросов.'],
];
const faqItems = [
  { question: 'Где создать токен API МойСклад?', answer: 'Откройте меню пользователя, затем «Настройки» → «Токены» → «+Токен». Для чтения товаров проверьте, что у сотрудника есть права на их просмотр.' },
  { question: 'Можно ли проверить API МойСклад без программиста?', answer: 'Да. Один запрос на чтение товаров можно выполнить в терминале с curl. Для регулярной выгрузки проверьте подходящее готовое решение или настройте интеграцию с обработкой страниц ответа и ошибок.' },
  { question: 'Почему API МойСклад вернул пустой список товаров?', answer: 'При HTTP 200 пустой массив rows означает, что в выборке нет записей. Сверьте аккаунт и тип позиции в МойСклад. Если применяли фильтры, проверьте их условия.' },
  { question: 'Можно ли через API получить остатки за прошлую дату?', answer: 'Да. Параметр moment описан для методов /report/stock/all и /report/stock/bystore. Результат можно сверить с отчётом МойСклад на ту же дату.' },
];
const limitsSource = { label: 'Лимиты и тарифные ограничения — документация JSON API', href: 'https://github.com/moysklad/api-remap-1.2-doc/blob/master/md/_restrictions.md' };
const sourceLinks = [
  { label: 'JSON API 1.2 — официальная документация МойСклад', href: 'https://dev.moysklad.ru/doc/api/remap/1.2/' },
  { label: 'Список товаров и формат ответа — документация JSON API', href: 'https://github.com/moysklad/api-remap-1.2-doc/blob/master/md/dictionaries/_product.md#получить-список-товаров' },
  { label: 'Аутентификация, сжатие, ошибки и фильтры — документация JSON API', href: 'https://github.com/moysklad/api-remap-1.2-doc/blob/master/md/_general.md' },
  limitsSource,
  { label: 'Создание токена в интерфейсе — справка МойСклад', href: 'https://support.moysklad.ru/hc/ru/касса%20и%20розница/онлайн%20кассы/интеграция_с_онлайн_кассами_aqsi' },
  { label: 'Отчёт об остатках — документация JSON API', href: 'https://github.com/moysklad/api-remap-1.2-doc/blob/master/md/reports/_report_stock.md' },
  { label: 'Аудит изменений — документация JSON API', href: 'https://github.com/moysklad/api-remap-1.2-doc/blob/master/md/audit/_audit.md' },
  { label: 'Доступ серверных решений — Vendor API МойСклад', href: 'https://dev.moysklad.ru/doc/api/vendor/1.0/' },
];
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({
  ...item,
  description: item.summaryDescription ?? item.description,
  href: `${base}${item.hrefPath}`,
}));
const structuredData = createArticleStructuredData({
  articleType: 'Article',
  title,
  description,
  articleUrl,
  publishedDate: article.publishedAt,
  modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(),
  image: ogImage,
  author: authorName,
  breadcrumbs: [
    { name: 'Главная', item: siteRoot.toString() },
    { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() },
    { name: title, item: articleUrl },
  ],
  faqItems,
});
---

<ArticleLayout {title} {titleParts} {description} {canonicalPath} {structuredData}
  ogTitle={article.seoTitle} ogDescription={description} {ogImage} ogImageAlt={imageAlt}
  category={article.category} author={authorName}
  intro="Где создать токен JSON API 1.2, как запросить одну карточку товара через curl и что проверить в ответе перед настройкой выгрузки.">
  <Fragment slot="quick-answer">
    <p>Создайте токен в настройках МойСклад и выполните <code>GET /entity/product?limit=1</code>. Запрос вернёт до одной карточки товара в <code>rows</code>. Если получили ошибку, начните с HTTP-кода и сообщения в ответе.</p>
  </Fragment>

  <p data-article-lead>Проверьте доступ к данным на одной карточке из своего аккаунта. Ниже можно скопировать команду для терминала и сравнить ответ с карточкой в МойСклад.</p>

  <section aria-labelledby="token">
    <h2 id="token">Где взять <span data-heading-accent>токен API</span></h2>
    <p>В МойСклад откройте <strong>меню пользователя → Настройки → Токены → +Токен</strong>. Для пробного запроса нужен токен сотрудника с правом просмотра товаров. Токен передаётся в заголовке <code>Authorization</code>. Храните его в настройках доверенного инструмента и убирайте из команд и скриншотов, которыми делитесь.</p>
    <p>Документация также описывает выпуск токена через <code>POST /security/token</code> с логином и паролем. Этот метод отзывает выданные ранее токены пользователя, поэтому его вызов может остановить действующую интеграцию.</p>
    <ArticleFigure src={authDocsImage} fullSize alt="Раздел аутентификации официальной документации JSON API МойСклад" caption="Скриншот документации МойСклад от 25 октября 2026 года. В разделе о выпуске токена через API указано, когда отзываются предыдущие токены." />
  </section>

  <section aria-labelledby="first-check">
    <h2 id="first-check">Как выполнить <span data-heading-accent>первый запрос</span></h2>
    <p>Откройте Bash или Zsh. Выполните первую строку, вставьте токен и нажмите Enter. Символы при вводе скрыты. Затем выполните остальные строки. Запрос читает товары, а последняя команда удаляет переменную с токеном из текущего сеанса.</p>
    <pre><code>{firstRequest}</code></pre>
    <p>Посмотрите HTTP-статус ответа. При <code>200</code> массив <code>rows</code> содержит товары текущей страницы, а <code>meta.size</code> показывает размер всей выборки. Если карточка вернулась, откройте этот товар в МойСклад и сверьте название и артикул, если он заполнен. Для чтения следующей страницы используйте <code>meta.nextHref</code>, когда он есть в ответе.</p>
    <ArticleFigure src={responseImage} fullSize alt={imageAlt} caption="Сокращённый учебный JSON. Параметр limit=1 ограничивает число карточек на странице ответа." />
    <p>При <code>200</code> и <code>rows: []</code> выборка пуста. Сверьте аккаунт, права и тип позиции в интерфейсе. Услуги, комплекты и модификации запрашиваются через отдельные ресурсы.</p>
    <DataTable label="Что проверить при ошибке первого запроса к API МойСклад" columns={['HTTP-код', 'Что проверить']} rows={statusRows} rowHeaders />
  </section>

  <section aria-labelledby="data">
    <h2 id="data">Какие данные <span data-heading-accent>можно получить через API</span></h2>
    <p>После проверки товара выберите ресурс, который отвечает на ваш рабочий вопрос. Доступ к финансовым документам, себестоимости и аудиту зависит от прав и условий тарифа. У решения из каталога доступ задаётся отдельно при установке.</p>
    <DataTable label="Примеры данных МойСклад для разных аналитических вопросов" columns={['Что нужно', 'Раздел API', 'Что поможет проверить']} rows={dataRows} rowHeaders />
    <p>Чтобы узнать, какие товары продали за вчера в одной точке, начните с одной розничной продажи с позициями и сравните её с документом в МойСклад. Для расчёта выручки после возвратов проверьте оба типа документов и правила учёта сумм и дат. Если эти данные уже есть в интерфейсе, посмотрите <a href={`${base}otchety-moysklad/`}>разбор штатных отчётов МойСклад</a>.</p>
  </section>

  <section aria-labelledby="limits">
    <h2 id="limits">Какие лимиты API <span data-heading-accent>учесть в 2026 году</span></h2>
    <p>МойСклад выделяет каждому пользователю или решению 45 единиц лимита на три секунды. Обычный запрос расходует разное число единиц в зависимости от способа авторизации. Два метода отчёта остатков всегда расходуют по пять единиц.</p>
    <DataTable label="Лимиты JSON API МойСклад по способу доступа на 19 ноября 2026 года" columns={['Способ доступа или метод', 'Текущий предел', 'Условие']} rows={limitRows} rowHeaders />
    <p>Одновременно допускается до пяти запросов от пользователя или решения и до 20 на аккаунт. Перед запуском интеграции сверьте цифры с <a href={limitsSource.href} target="_blank" rel="noopener noreferrer">официальным разделом ограничений</a>.</p>
  </section>

  <section aria-labelledby="updates">
    <h2 id="updates">Что проверить, чтобы <span data-heading-accent>отчёт не устарел</span></h2>
    <p>При регулярной загрузке сверяйте документы за прошедшие даты. Например, возврат может появиться после того, как продажу уже выгрузили. Если отчёт учитывает возвраты, загружайте их отдельно и пересчитывайте итог за нужный период.</p>
    <p>Для поддерживаемых документов фильтр <code>filter=isDeleted=true</code> возвращает записи из корзины. Журнал аудита отдельно описывает события удаления и восстановления, если у интеграции есть право его читать. Обработку окончательных удалений и архивных карточек проверяйте на конкретных сущностях, а не предполагайте по одному ответу списка.</p>
    <p>Для остатков на прошлую дату укажите <code>moment</code> в запросе отчёта <code>/report/stock/all</code> или <code>/report/stock/bystore</code>. Чтобы получить историю по дням, нужно запрашивать нужные даты, сохранять результаты и сопоставлять их с <a href={`${base}ostatki-moysklad/`}>отчётом об остатках</a>. Пустая строка ответа и нулевой остаток требуют отдельной проверки при построении графика.</p>
  </section>

  <section aria-labelledby="without-code">
    <h2 id="without-code">Когда можно <span data-heading-accent>обойтись без разработчика</span></h2>
    <p>Для одного отчёта за период обычно достаточно файла из МойСклад. Если он нужен регулярно, сравните <a href={`${base}vygruzka-dannyh-moysklad-dlya-analitiki/`}>способы выгрузки данных для аналитики</a>. Перед подключением готового решения попросите показать, какие данные оно выгружает, как часто обновляет отчёт и как сверить цифры с МойСклад.</p>
    {moyskladMcpProduct.published && <p>Если нужно разово найти товар или спросить об остатках в чате, посмотрите, как работает <a href={`${base}${moyskladMcpProductPath.slice(1)}`}>{moyskladMcpProduct.name}</a>.</p>}
    <InlineConsultation title="Проверяете, хватит ли API для отчёта?" description="Расскажите, какой показатель и по каким магазинам нужен. Поможем определить, из каких документов его собрать и с чем сверить результат." />
  </section>

  <FaqSection id="faq" title="Частые вопросы об API МойСклад" items={faqItems} variant="article" />
  <p>Документация проверена 19 ноября 2026 года.</p>
  <ArticleSources publishedIso={article.publishedAt} modifiedIso={article.updatedAt} sources={sourceLinks} />

  <Fragment slot="article-end">
    <ArticleProductCta
      titleParts={[{ text: 'Нужны данные МойСклад ' }, { text: 'для своих отчётов?', accent: true }]}
      description="Если данные МойСклад нужны для отчёта в другой системе, расскажите, какие показатели хотите получать и как часто."
      href={companyInfo.contacts.consultationUrl}
      actionLabel="Обсудить задачу"
    />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <ConsultationCtaSection slot="after-article" />
</ArticleLayout>
