---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { mcpProduct } from '../../config/products';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import placementImage from '../../images/articles/bitrix24-crm-form-two-tests-127.png';
import destinationImage from '../../images/articles/bitrix24-crm-form-destination-127.png';

const article = getArticle('crm-forma-ne-sozdaet-zayavku-bitrix24/');
const { title, description } = article;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const ogImage = new URL(placementImage.src, siteRoot).toString();
const imageAlt = 'Сравнение отправки одной CRM-формы по публичной ссылке Битрикс24 и через форму, встроенную на сайте';
const faqItems = [
  { question: 'CRM-форма открывается по прямой ссылке, но не работает на сайте. Что проверить?', answer: 'Сверьте, что на странице размещена та же активная CRM-форма: откройте в списке её публичную ссылку и «Код на сайт», затем проверьте блок или виджет на нужной странице. Успешный тест по прямой ссылке помогает сузить проверку, но сам по себе не устанавливает причину сбоя на сайте.' },
  { question: 'Почему после формы нет новой сделки?', answer: 'Проверьте «Сущности в CRM»: форма может быть настроена на другой элемент. Если включено «Использовать активную сделку, не создавать новую», заполнение от существующего клиента может оказаться в таймлайне последней активной сделки. Ищите событие по тестовым данным, а не только новую карточку.' },
  { question: 'Можно ли считать сообщение «Спасибо» доказательством создания заявки?', answer: 'Нет. Действие после отправки и тексты сообщений настраиваются. Зафиксируйте, что произошло в браузере, затем найдите соответствующий элемент или событие в CRM и сверьте поля контрольного обращения.' },
  { question: 'Счётчик заполнений в списке форм равен числу всех заявок?', answer: 'Не обязательно. В списке показываются показатели формы, но счётчики можно обнулить; они не заменяют поиск конкретной записи по тестовым данным. Статистику используйте как дополнительный сигнал.' },
  { question: 'Что делать с ошибкой «Не удалось отправить сообщение. Повторите попытку позже»?', answer: 'Зафиксируйте текст ошибки и проверьте отправку по публичной ссылке. Для этой конкретной ошибки официальная справка Битрикс24 описывает обновление всех форм через адрес /crm/webform/?rebuildAll=y на своём портале. Выполняйте его осознанно под учётной записью с нужным доступом и повторите тест; при сохранении ошибки обратитесь в поддержку с временем, названием формы и результатами проверки.' },
  { question: 'Может ли MCP TrueTell уже следить за отправкой каждой формы?', answer: 'Готовую функцию такого мониторинга мы пока не заявляем. MCP TrueTell для Битрикс24 находится в разработке. Сейчас можно обсудить, какие формы, типы записей и контрольные события нужно проверять в будущем сценарии.' },
];
const sourceLinks = [
  { label: 'Битрикс24: CRM-формы — создание, публикация, список и права', href: 'https://helpdesk.bitrix24.ru/open/28809760/' },
  { label: 'Битрикс24: список форм, публичная ссылка, активность и статистика', href: 'https://helpdesk.bitrix24.ru/open/25221720/' },
  { label: 'Битрикс24: настройка формы, сущности CRM, дубликаты и ошибка отправки', href: 'https://helpdesk.bitrix24.ru/open/24730032' },
  { label: 'Битрикс24: размещение CRM-формы на стороннем сайте', href: 'https://helpdesk.bitrix24.ru/open/13003062/' },
  { label: 'Битрикс24: размещение CRM-формы на сайте Битрикс24', href: 'https://helpdesk.bitrix24.ru/open/26881642/' },
  { label: 'Битрикс24: фильтры в CRM', href: 'https://helpdesk.bitrix24.ru/open/24206616/' },
  { label: 'Битрикс24: права доступа к CRM', href: 'https://helpdesk.bitrix24.ru/open/23240636/' },
  { label: 'Битрикс24: события CRM-форм в таймлайне карточки', href: 'https://helpdesk.bitrix24.ru/open/23960160/' },
];
const structuredData = createArticleStructuredData({
  articleType: 'Article', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  breadcrumbs: [{ name: 'Главная', item: siteRoot.toString() }, { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() }, { name: title, item: articleUrl }],
  faqItems,
});
---
<ArticleLayout {title} titleParts={[{ text: 'CRM-форма отправлена, ' }, { text: 'а заявки нет', accent: true }, { text: ' в Битрикс24: что проверить' }]} {description}
  canonicalPath={`/${article.hrefPath}`} {structuredData} ogTitle={article.seoTitle} ogDescription={description}
  {ogImage} ogImageAlt={imageAlt} category={article.category} author={authorName}
  intro="Проверка начинается с конкретной формы. Сравните отправку по её публичной ссылке и на сайте, затем посмотрите, какой элемент CRM она создаёт или обновляет. Отсутствие новой сделки ещё не означает, что данные пропали.">
  <Fragment slot="quick-answer">
    <p><strong>Откройте CRM → Продажи → Каналы продаж → CRM-формы. У нужной формы проверьте активность и публичную ссылку, затем отправьте тест с узнаваемыми данными. Повторите тест на странице сайта.</strong></p>
    <p>Если отправка подтверждена, откройте настройки «Сущности в CRM»: форма может создать не сделку, а другой элемент, либо записать данные в таймлайн активной сделки. Ищите результат по тестовым полям с учётом фильтров и прав.</p>
  </Fragment>

  <p data-article-lead>Руководитель видит заполненную форму на сайте, а в списке новых сделок пусто. Причина бывает в отправке или размещении формы; иногда данные попадают в другой раздел CRM. Чтобы не менять настройки наугад, проведите два теста одной и той же формы и сохраните, что произошло на каждом шаге.</p>

  <section aria-labelledby="identify-form">
    <h2 id="identify-form">Найдите <span data-heading-accent>именно ту форму</span></h2>
    <p>В списке CRM-форм найдите форму, которая должна стоять на проблемной странице. Сверьте её внутреннее название и колонку «Активность»: там видно, включена ли форма, а по кнопке «Подробнее» — кто и когда менял её активность. Выключенная форма не принимает заполнения. В колонке «Публичная ссылка» кнопка «Открыть» ведёт к самой форме; «Код на сайт» показывает варианты размещения. Если у вас нет доступа к списку или редактору, попросите сотрудника с правами на CRM-формы провести проверку вместе с вами.</p>
    <p>Перед тестом запишите адрес страницы сайта, название формы и время. Для контрольного заполнения используйте свои тестовые контактные данные и узнаваемую метку в доступном поле. Если видимых полей мало, достаточно уникального тестового контакта и точного времени. Не отправляйте в форму чужие персональные данные и заранее предупредите менеджера, которому может прийти тестовая заявка.</p>
  </section>

  <section aria-labelledby="two-tests">
    <h2 id="two-tests">Сравните <span data-heading-accent>публичную ссылку и сайт</span></h2>
    <p>Сначала откройте форму через «Публичная ссылка → Открыть» и заполните её. Затем повторите с другими тестовыми данными на странице сайта, где видят форму клиенты. Отметьте, появилась ли ошибка, сработали ли обязательные поля и капча, какое сообщение или перенаправление показано после отправки. Действие после отправки настраивается в редакторе, поэтому сам текст «Спасибо» ещё не доказывает, что запись найдена в CRM.</p>
    <ArticleFigure src={placementImage} fullSize portrait alt={imageAlt} caption="Редакционная схема двух тестов одной CRM-формы. Она показывает, где сузить поиск: в настройках формы или в её размещении. Это не экран Битрикс24; результаты и контакты здесь условные." />
    <p>Если прямая ссылка работает, а встроенный вариант нет, проверьте, та ли форма выбрана в блоке или виджете сайта и актуален ли код размещения. На стороннем сайте код берут из настройки нужной формы; на сайте Битрикс24 выбирают активную форму в блоке или виджете. Если ошибка возникает в обоих местах, сначала разбирайте саму форму и текст ошибки. Такое сравнение сужает область проверки, но не устанавливает техническую причину без доступа к конкретной странице и порталу.</p>
  </section>

  <section aria-labelledby="submission">
    <h2 id="submission">Отделите неудачную отправку <span data-heading-accent>от ненайденной записи</span></h2>
    <p>Когда форма не даёт завершить заполнение, проверьте обязательные поля, соглашения и капчу. Защита от спама может блокировать подозрительные попытки. Запишите точный текст на экране и сделайте скриншот без личных данных. В редакторе формы можно настроить отдельные сообщения об успешном и неуспешном заполнении, редирект или повторное открытие формы; поэтому сравнивайте увиденное с настройками именно этой формы.</p>
    <p>Для конкретной ошибки «Не удалось отправить сообщение. Повторите попытку позже» справка Битрикс24 предлагает обновить формы через адрес своего портала с параметром <code>/crm/webform/?rebuildAll=y</code>. Это действие относится ко всем формам портала. Применяйте его после фиксации ошибки и проверки прямой ссылки, затем повторите контрольную отправку. Если ошибка остаётся, передайте в поддержку название формы, адрес страницы, время и результат обоих тестов. Успешное сообщение без найденной записи этим действием не диагностируют.</p>
  </section>

  <section aria-labelledby="destination">
    <h2 id="destination">Проверьте, <span data-heading-accent>куда попали данные</span></h2>
    <p>В редакторе откройте «Сущности в CRM». Там видно, какие элементы должна создавать форма: например, лид, сделку с клиентом, счёт или элемент смарт-процесса. В списке форм колонка «Форма создает» также показывает выбранный тип и даёт перейти к статистике созданных элементов. Эти показатели полезны для общей проверки, но не заменяют поиск конкретной тестовой отправки: счётчики в списке можно обнулить.</p>
    <ArticleFigure src={destinationImage} fullSize portrait alt="Карта результатов отправки CRM-формы: лид, сделка, контакт или компания, активная сделка и смарт-процесс" caption="Редакционная карта результата отправки. Конкретный набор элементов зависит от настройки «Сущности в CRM»; схема не воспроизводит интерфейс портала." />
    <p>Если форма создаёт сделку, проверьте выбранную воронку. Если включена опция «Использовать активную сделку, не создавать новую», данные от найденного клиента появятся в таймлайне последней созданной активной сделки, а новой сделки не будет. Опция доступна при настройках обработки дубликатов «Заменять» или «Объединять». Для смарт-процесса справка описывает создание нового элемента после каждого заполнения.</p>
    <p>Ищите тестовый телефон, e-mail или метку в том разделе CRM, который указан в форме. Снимите сохранённые фильтры, проверьте период и права пользователя на просмотр записи. Если после этих проверок ни новой записи, ни события в существующей сделке нет, сохраните результаты теста для администратора или поддержки. Если запись нашлась, дальше проверяют назначение и первое действие менеджера; это отдельный участок маршрута.</p>
  </section>

  <section aria-labelledby="result">
    <h2 id="result">Как зафиксировать <span data-heading-accent>результат проверки</span></h2>
    <p>Сохраните короткую карточку диагностики: название формы и её активность, адрес публичной ссылки и страницы сайта, время двух отправок, сообщения на экране, настройку «Сущности в CRM», найденный ID записи либо сделку с событием в таймлайне. Не включайте в отчёт полные телефоны, пароли и служебные ссылки с секретами. По этой карточке специалист увидит, на каком шаге расходится ожидаемый и фактический результат, а после исправления сможет повторить те же два теста.</p>
    <p>Для нескольких форм такую проверку полезно проводить после изменения полей, размещения или сценария создания записи. Мы разрабатываем MCP TrueTell для работы внешнего ИИ с данными Битрикс24, но готовый мониторинг отправок и открытую подписку сейчас не заявляем. Если хотите обсудить будущий контроль, опишите количество форм, типы создаваемых записей и какой результат должен получать ответственный. Перед доступом ИИ к CRM полезно определить <a href={`${base}bezopasnyy-dostup-ii-k-crm/`}>границы прав и проверки ответа</a>.</p>
    <InlineConsultation variant="product" title="Хотите разобрать сбой вашей CRM-формы?" description="Пришлите название формы, где она размещена, и результат двух тестов без клиентских данных. Обсудим диагностику сейчас и требования к будущему регулярному контролю." href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
  </section>

  <FaqSection title="Частые вопросы о CRM-форме без заявки" items={faqItems} variant="article" />
  <p>Справка Битрикс24 проверена 30 октября 2026 года. Клиентский портал для этой статьи не тестировался; фактические настройки формы и тариф нужно сверять в своём Битрикс24.</p>
  <ArticleSources publishedIso={article.publishedAt} modifiedIso={article.updatedAt} sources={sourceLinks} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Обсудим ' }, { text: 'MCP TrueTell для Битрикс24', accent: true }]} description={mcpProduct.articleDescription} href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <ConsultationCtaSection slot="after-article" />
</ArticleLayout>
