---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppHeader from '../../components/header/header.astro';
import SiteFooter from '../../components/footer/site-footer.astro';
import ProductSummary from '../../components/product-summary/product-summary.astro';
import ProductScenario from '../../components/product-scenario/product-scenario.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import LineWave from '../../components/ui/line-wave.astro';
import ActionIcon from '../../components/product-scenario/action-icon.astro';
import { companyInfo } from '../../config/company';
import { createOrganizationLogo } from '../../utils/functions/createOrganizationLogo';
import { fieldDirectoryProduct as product, fieldDirectoryProductPath } from '../../config/products';
import listScreenshot from '../../images/articles/truetell-field-directory-list-live.jpg';
import searchScreenshot from '../../images/articles/truetell-field-directory-code-search-live.jpg';
import heroStyles from '../../styles/product-hero.module.scss';
import closingStyles from '../../styles/product-closing.module.scss';
import layout from '../../styles/product-panels.module.scss';
import styles from './page.module.scss';

const title = `${product.heading} — ${companyInfo.brandName}`;
const description = product.description;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, Astro.site ?? 'https://truetell-retail.ru');
const pageUrl = new URL(fieldDirectoryProductPath.slice(1), siteRoot).href;
const listAlt = 'Приложение «Поля CRM — поиск кодов и экспорт» в Битрикс24: выбор сущности, поиск, фильтры, коды и типы полей; показаны строки 1–20 из 61';
const searchAlt = 'Поиск по полному коду UF_CRM в установленном приложении: найдено одно поле, видны название, тип и кнопка копирования';
const features = [
  ['Поля CRM', 'Системные и пользовательские поля сделок, лидов, контактов и компаний.', 'review'],
  ['Поиск по названию и коду', 'Ищите по названию, коду или его части во всём списке.', 'filter'],
  ['Тип и свойства поля', 'Тип, обязательность и множественность из API. Отсутствующие свойства отмечены отдельно.', 'review'],
  ['Фильтры без лишних строк', 'Оставьте нужный тип и категорию полей.', 'filter'],
  ['Копирование кода', 'Основной и доступный дополнительный код — с подтверждением копирования.', 'report'],
  ['CSV всей выборки', 'Вся отфильтрованная выборка со всех страниц.', 'report'],
  ['По 20 полей на странице', 'Удобный просмотр большого списка по 20 строк.', 'review'],
  ['Сравнение снимков', 'Сохраните описание полей в JSON и сравните два файла в браузере.', 'report'],
  ['Смарт-процессы', 'Загрузите доступные на портале смарт-процессы по отдельной кнопке.', 'review'],
  ['Обновление списка', 'Получите актуальные описания после изменений в настройках CRM.', 'run'],
] as const;
const faqItems = [
  { question: 'Кому нужно приложение «Поля CRM — поиск кодов и экспорт»?', answer: 'Администратору или интегратору, которому нужно узнать код и тип поля, разобраться в структуре CRM или подготовить список полей для интеграции.' },
  { question: 'Как подключить приложение?', answer: 'Нажмите «Открыть в Маркете» и установите приложение в облачный Битрикс24. Установку выполняет администратор с необходимыми правами. Для доступа нужна подписка Битрикс24 Маркетплейс.' },
  { question: 'Изменяет ли приложение CRM?', answer: 'Нет. Справочник читает описания полей. Он не создаёт, не изменяет и не удаляет поля или карточки CRM.' },
  { question: 'Почему поле есть в справочнике, но не видно в карточке?', answer: 'Справочник показывает техническое описание из API. Видимость поля в форме CRM и обязательность на конкретной стадии зависят от настроек карточки и процесса. Наличие поля в каталоге не подтверждает его видимость в интерфейсе.' },
  { question: 'Все ли коды подходят для любого REST-метода?', answer: 'Нет. Приложение отдельно показывает код универсального API и дополнительный код, если он пришёл в ответе. Выбирайте формат по документации конкретного метода: автоматически заменять регистр или подчёркивания нельзя.' },
  { question: 'Что означают обязательность и множественность?', answer: 'Это технические свойства из ответа API: требуется ли значение на этом уровне и может ли поле содержать несколько значений. Они не заменяют проверку требований вашей стадии CRM. Неизвестное или отсутствующее свойство не подменяется значением «Нет».' },
  { question: 'Что входит в CSV?', answer: 'Описания полей выбранной сущности, соответствующих текущему поиску и фильтрам, со всех страниц. Значения из карточек клиентов и сделок не выгружаются. CSV сохраняется в UTF-8 с BOM и разделителем «;»; текст защищён от интерпретации как формул.' },
  { question: 'Какие права нужны и где обрабатываются данные?', answer: 'Приложение работает в браузере через SDK и REST API Битрикс24 с правами текущего пользователя. Собственного бэкенда и базы данных у справочника нет. Отказ API из-за прав не обходится приложением.' },
  { question: 'Можно ли проверить заполненность и использование полей?', answer: 'Нет. Справочник помогает изучить описание полей. Анализ заполненности карточек, проверка роботов и бизнес-процессов, изменение и удаление полей в приложение не входят.' },
  { question: 'Как сравнить поля до и после изменений?', answer: 'Сохраните описание полей в JSON дважды и выберите оба файла для сравнения. Приложение покажет добавленные, удалённые и изменённые свойства. Файлы сравниваются в браузере; автоматического наблюдения за изменениями нет.' },
  { question: 'Можно ли открыть справочник из карточки CRM?', answer: 'После подключения вкладок откройте «Поля CRM» в сделке, лиде, контакте или компании. Приложение выберет соответствующую сущность. Доступные смарт-процессы загружаются отдельно и зависят от тарифа и прав пользователя.' },
  { question: 'Работает ли приложение в Битрикс24 Мобайл?', answer: 'Первая версия предназначена для облачного Битрикс24 в браузере на компьютере. Поддержка мобильного приложения Битрикс24 пока не заявлена.' },
];
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebPage', '@id': `${pageUrl}#webpage`, url: pageUrl, name: title, description, inLanguage: 'ru-RU', mainEntity: { '@id': `${pageUrl}#application` }, breadcrumb: { '@id': `${pageUrl}#breadcrumbs` } },
    { '@type': 'SoftwareApplication', '@id': `${pageUrl}#application`, name: product.name, url: pageUrl, description, applicationCategory: 'BusinessApplication', operatingSystem: 'Web browser', inLanguage: 'ru-RU', screenshot: [listScreenshot, searchScreenshot].map(image => new URL(image.src, siteRoot).href), featureList: features.map(([heading, text]) => `${heading}. ${text}`), publisher: { '@type': 'Organization', name: companyInfo.brandName, url: siteRoot.href, logo: createOrganizationLogo(siteRoot.href) } },
    { '@type': 'BreadcrumbList', '@id': `${pageUrl}#breadcrumbs`, itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: siteRoot.href },
      { '@type': 'ListItem', position: 2, name: 'Продукты', item: new URL('products/', siteRoot).href },
      { '@type': 'ListItem', position: 3, name: product.name, item: pageUrl },
    ] },
    { '@type': 'FAQPage', '@id': `${pageUrl}#faq`, mainEntity: faqItems.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) },
  ],
};
---

<BaseLayout contentType="commercial" contentCategory="Битрикс24" {title} {description} {structuredData} canonicalPath={fieldDirectoryProductPath} ogImage={new URL(listScreenshot.src, siteRoot).href} ogImageAlt={listAlt}>
  <AppHeader />
  <main class:list={['site-content', styles.page, heroStyles.productPage, closingStyles.flushFooter]}>
    <div class={styles.container}>
      <header class:list={[heroStyles.hero, heroStyles.heroWave]}>
        <LineWave centerOnMobile />
        <div class={heroStyles.heroCopy}>
          <h1>{product.heading}</h1>
          <p class={heroStyles.heroDescription} data-intro="description">Найдите поле по названию или коду, посмотрите его тип и скопируйте код. Сохраните нужный список в CSV для работы над интеграцией.</p>
        </div>
        <div class={heroStyles.heroActions} data-intro="actions">
          <a class={styles.button} href={product.marketplaceUrl} target="_blank" rel="noopener noreferrer">{product.connectionActionLabel}</a>
        </div>
      </header>

      <ProductSummary description="Справочник собирает техническое описание полей вашего Битрикс24 в одной таблице. Найдите и скопируйте код, выгрузите список в CSV или сохраните JSON-снимки, чтобы сравнить свойства полей после изменений.">
        <span slot="title">Чтобы быстро найти <strong>нужное поле и его код</strong></span>
      </ProductSummary>

      <ProductScenario id="field-search-scenario-title" title="Найти код поля перед настройкой интеграции"
        description="Не нужно открывать настройки каждого поля по отдельности: название, код и тип собраны в одном рабочем экране."
        steps={[
          { icon: 'review', title: 'Выберите сущность', text: 'Сделки, лиды, контакты или компании.' },
          { icon: 'filter', title: 'Найдите поле', text: 'Введите название или код, уточните тип и категорию.' },
          { icon: 'report', title: 'Заберите результат', text: 'Скопируйте нужный код или скачайте CSV всей выборки.' },
        ]}>
        <ArticleFigure src={listScreenshot} fullSize alt={listAlt} caption="Настоящий интерфейс установленного приложения на тестовом портале. В таблице — описания полей, без значений из карточек CRM." />
      </ProductScenario>

      <section class:list={[styles.features, layout.features, layout.textPanel]} aria-labelledby="features-title">
        <h2 id="features-title">Что можно сделать в справочнике</h2>
        <dl class={layout.featureGrid}>
          {features.map(([heading, text, icon]) => <div data-reveal><dt><ActionIcon name={icon} />{heading}</dt><dd>{text}</dd></div>)}
        </dl>
      </section>

      <section class={styles.searchExample} aria-labelledby="code-search-title">
        <div>
          <h2 id="code-search-title">Есть код — найдите понятное название</h2>
          <p>Вставьте код из запроса или отчёта в поиск. Справочник найдёт поле выбранной сущности и покажет его название и свойства.</p>
          <p>Основной и дополнительный коды подписаны отдельно. Перед использованием проверьте, какой формат нужен вашему REST-методу.</p>
          <a href={`${base}kod-polya-bitrix24/`}>Как узнать и проверить код поля</a>
        </div>
        <ArticleFigure src={searchScreenshot} fullSize alt={searchAlt} caption="Поиск по полному коду на тестовом портале. Найдено одно пользовательское поле; кнопка рядом копирует его код." />
      </section>

      <section class={styles.boundaries} aria-labelledby="data-title">
        <h2 id="data-title">Описание полей — без изменения CRM</h2>
        <div>
          <p>Справочник читает свойства, доступные через API с правами текущего пользователя. Он не меняет поля, сделки, лиды, контакты и компании.</p>
          <p>Технические свойства не показывают, где поле выведено в карточке и какие роботы его используют. Заполненность и зависимости проверяются отдельно.</p>
        </div>
      </section>

      <div class={styles.faq}>
        <FaqSection items={faqItems} title="Вопросы о приложении" id="field-directory-faq" variant="article" />
      </div>
      <section class={styles.guides} aria-labelledby="guides-title">
        <h2 id="guides-title">Полезно перед работой с полями</h2>
        <ul>
          <li><a href={`${base}spisok-poley-bitrix24/`}>Как получить список полей и выгрузить CSV</a></li>
          <li><a href={`${base}tipy-poley-crm-bitrix24/`}>Типы полей, множественность и обязательность</a></li>
          <li><a href={`${base}uf-crm-ufcrm-bitrix24-api/`}>Чем отличаются коды UF_CRM и ufCrm</a></li>
        </ul>
      </section>
    </div>
  </main>
  <div class={closingStyles.closingSurface}>
    <LineWave />
    <div class={styles.container}>
      <section class:list={[styles.connection, closingStyles.connectionDark]} aria-labelledby="connection-title">
        <h2 id="connection-title" data-reveal>Откройте справочник в Битрикс24</h2>
        <div data-reveal="1">
          <p>Приложение опубликовано в Маркете Битрикс24 и доступно по подписке Битрикс24 Маркетплейс. Если нужна помощь с установкой или поиском полей, <a href={companyInfo.contacts.consultationUrl}>обсудите задачу с нами</a>.</p>
          <a class={styles.button} href={product.marketplaceUrl} target="_blank" rel="noopener noreferrer">{product.connectionActionLabel}</a>
        </div>
      </section>
    </div>
    <SiteFooter transparent hideDivider />
  </div>
</BaseLayout>
