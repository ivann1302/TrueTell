---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import invoiceImage from '../../images/articles/bitrix24-invoice-deadlines-official.jpg';
import taskImage from '../../images/articles/bitrix24-crm-task-assignee-official.jpg';
import balanceImage from '../../images/articles/bitrix24-overdue-and-future-balance.png';

const article = getArticle('debitorskaya-zadolzhennost-bitrix24/');
const { title, description } = article;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const canonicalPath = `/${article.hrefPath}`;
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const imageAlt = 'Официальный экран Битрикс24: счета в режиме Сроки с колонками по датам оплаты';
const ogImage = new URL(invoiceImage.src, siteRoot).toString();
const titleParts = [
  { text: 'Дебиторская задолженность в Битрикс24: ' },
  { text: 'что контролировать руководителю', accent: true },
];
const sourceLinks = [
  { label: 'Фильтры сделок и счетов в CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/24206616/' },
  { label: 'Режим просмотра «Сроки» в CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/25376268/' },
  { label: 'Статусы оплаты заказа — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/18291172/' },
  { label: 'Задачи в CRM и работа после закрытия сделки — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/24212648/' },
  { label: 'Настройка прав доступа к CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/23240636/' },
];
const registerRows = [
  ['D-1042', '120 000 ₽', '72 000 ₽', '48 000 ₽', '48 000 ₽ — 20.10; срок впереди'],
  ['D-1181', '90 000 ₽', '30 000 ₽', '60 000 ₽', '40 000 ₽ — 05.10; 20 000 ₽ — 25.10'],
  ['D-1210', '50 000 ₽', '50 000 ₽', '0 ₽', 'Непогашенных платежей нет'],
];
const stateRows = [
  ['Подтверждённая просрочка', 'Остаток больше нуля, срок раньше даты среза, поступления сверены', 'Проверить причину и назначить действие по непогашенной части'],
  ['Срок сегодня', 'Остаток больше нуля, срок равен дате среза', 'Проверить ожидаемую оплату и назначить повторную сверку'],
  ['Будущая оплата', 'Остаток больше нуля, подтверждённый срок позже даты среза', 'Оставить в календаре ожидаемых поступлений'],
  ['Дата требует уточнения', 'Срок не установлен либо не подтверждён', 'Найти действующие условия; не считать строку будущей или просроченной'],
  ['Поступление не сверено', 'Есть сообщение об оплате или неоднозначная операция', 'Проверить источник и распределение; до этого итог предварительный'],
];
const faqItems = [
  { question: 'Можно ли считать задолженность по сумме сделок в Битрикс24?', answer: 'Сумма сделки сама по себе не показывает, сколько клиент должен оплатить и когда. Для рабочего контроля нужны действующие обязательства, подтверждённые поступления с распределением по ним и согласованные сроки. Сверяйте данные CRM с платёжными и первичными документами; управленческий остаток не заменяет бухгалтерский расчёт дебиторской задолженности.' },
  { question: 'Как найти просроченные оплаты в Битрикс24?', answer: 'Если используете счета CRM, начните с фильтра «Срок оплаты» и проверьте состояние найденных счетов. Для оплаты по этапам рассчитайте непогашенную часть каждого обязательства со сроком, который уже прошёл. Статус оплаты, просроченное дело или открытая стадия сделки по отдельности не дают полного списка долгов.' },
  { question: 'Весь остаток сделки считается просроченным?', answer: 'Нет. В примере статьи из остатка 60 000 ₽ по одной сделке просрочены 40 000 ₽, а ещё 20 000 ₽ должны поступить позже. Если срок части обязательств не установлен или не подтверждён, покажите её отдельно как требующую уточнения. Не относите неизвестную дату к будущим платежам.' },
  { question: 'Как учитывать обещанную клиентом дату оплаты?', answer: 'Сохраните обещанную дату и договорённость рядом с действующим сроком обязательства. Если стороны согласовали изменение срока, зафиксируйте основание и обновите данные по принятому в компании порядку. Простое перемещение карточки или новая дата задачи не должны скрывать прежние условия и историю проверки.' },
  { question: 'Задача менеджера завершена. Это означает, что клиент оплатил?', answer: 'Нет. Задача фиксирует поручение и его результат. Получение денег проверяйте по подтверждённому источнику и распределению поступления. В Битрикс24 закрытие сделки может завершать незавершённые связанные задачи; проверьте настройку контроля после завершения, если работа по оплате продолжается.' },
  { question: 'Можно ли автоматически получить отчёт о долгах в «Графике платежей» TrueTell?', answer: 'На 25 октября 2026 года в тестовых установках на двух порталах проверено сохранение графиков. На первом проверены ручное поступление с исправлением и отменой, общий отчёт с остатками, календарь поступлений и две CSV; на втором — права доступа. Приложение ещё не выпущено в Маркете. Банковская сверка этими проверками не подтверждена; управленческий остаток не заменяет бухгалтерский расчёт задолженности.' },
  { question: 'Срок оплаты сегодня — это уже просрочка?', answer: 'В примерах статьи сроки заданы календарными датами без времени. Сумму со сроком, равным дате проверки, выделяем как «Срок сегодня»; просрочкой считаем непогашенный остаток со сроком раньше даты проверки. Если в ваших условиях указаны конкретное время, часовой пояс или особый порядок определения срока, учитывайте их при проверке.' },
  { question: 'Что делать, если срок оплаты неизвестен или платёж ещё не сверили?', answer: 'Оставьте такую строку в отдельной очереди на уточнение с ответственным и сроком проверки. Неизвестную дату нельзя считать будущей, а сообщение клиента об отправке денег не подтверждает поступление. Пока факты не сверены, помечайте итог как предварительный и сохраняйте ссылку на спорную запись. После уточнения пересчитайте соответствующее обязательство.' },
];
const relatedArticles = getRelatedArticles(article.hrefPath)
  .map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const structuredData = createArticleStructuredData({
  articleType: 'BlogPosting', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  articleSection: 'Контроль оплат клиентов',
  breadcrumbs: [
    { name: 'Главная', item: siteRoot.toString() },
    { name: 'Блог', item: new URL('blog/', siteRoot).toString() },
    { name: title, item: articleUrl },
  ],
  faqItems,
});
---

<ArticleLayout {title} {titleParts} {description} {canonicalPath} {structuredData}
  ogTitle={article.seoTitle} ogDescription={description} {ogImage} ogImageAlt={imageAlt}
  category={article.category} author={authorName}
  intro="Как собрать реестр оплат клиентов, отделить просрочку от срока сегодня и будущих платежей, а затем назначить поручения с проверяемым результатом."
>
  <Fragment slot="quick-answer">
    <p>Для контроля задолженности нужен реестр обязательств: клиент и сделка, основание, сумма, согласованный срок, подтверждённые поступления и ответственный. <strong>Просрочено только то, что осталось неоплаченным по обязательствам с уже прошедшим сроком.</strong></p>
    <p>Отдельно покажите оплату со сроком сегодня, будущие суммы и строки на уточнение. Счета и статусы Битрикс24 помогают найти записи, но руководителю нужны ещё дата сверки, ответственный и следующее действие. Закрытая задача или обещание клиента не подтверждают получение денег.</p>
  </Fragment>

  <p data-article-lead>На планёрке менеджер говорит: «Клиент обещал заплатить», а в карточке стоит крупная сумма сделки. Из этого ещё не ясно, сколько денег ожидается сегодня, какая часть уже получена и кто должен проверить результат. Начните с конкретных обязательств клиента и их сроков — тогда обсуждение заканчивается поручением, которое можно проверить.</p>

  <section aria-labelledby="what-to-control">
    <h2 id="what-to-control">Что включить <span data-heading-accent>в список задолженности</span></h2>
    <p>В рабочем списке должны быть суммы, для которых известны основание и действующие условия оплаты. Свяжите обязательство с клиентом, договором или документом и карточкой CRM. Если цена, состав заказа или сроки изменились, сначала сверяйте актуальные условия. Порядок записи будущих этапов по одной сделке есть в <a href={`${base}grafik-platezhey-bitrix24/`}>инструкции по графику платежей</a>.</p>
    <p>Неоплаченный остаток планируемой продажи не устанавливает бухгалтерскую дебиторскую задолженность сам по себе. В CRM могут одновременно находиться ожидаемые авансы, будущие этапы работ и уже возникшие требования к клиенту. Согласуйте с финансовым ответственным, какие подтверждённые обязательства входят в ваш список. Для сверки с бухгалтерией понадобятся первичные документы и принятые правила учёта.</p>
    <p>Для управленческого реестра считайте обязательства и фактические оплаты. Стадия продажи и сумма карточки дают контекст, но сами не показывают, что уже просрочено.</p>
  </section>

  <section aria-labelledby="native-crm-tools">
    <h2 id="native-crm-tools">С чего начать <span data-heading-accent>проверку в Битрикс24</span></h2>
    <p>Если используете счета CRM, отберите их по полю «Срок оплаты» и проверьте состояние каждой найденной записи. В сделках есть отдельный фильтр «Статус оплаты». Доступность поиска и фильтров зависит от тарифа; сначала проверьте возможности вашего портала. <a href={sourceLinks[0].href} target="_blank" rel="noopener noreferrer">Описание фильтров сделок и счетов</a>.</p>
    <p>Для просмотра счетов по датам откройте CRM → Продажи → Счета → Сроки. В этом режиме карточки расположены по сроку оплаты; общих денежных сумм колонок нет. <a href={sourceLinks[1].href} target="_blank" rel="noopener noreferrer">Как устроен режим «Сроки»</a>.</p>
    <ArticleFigure src={invoiceImage} fullSize alt={imageAlt} caption="Оригинальный пример Поддержки24: открытие счетов в режиме «Сроки». Даты, суммы и клиенты относятся к документации; экран помогает искать счета по датам, но не показывает рассчитанную задолженность вашей компании." />
    <p><strong>Перетаскивание карточки в «Сроках» меняет дату</strong> в поле «Срок оплаты». Используйте его для согласованного изменения срока, сохранив основание; для поиска нужных счетов достаточно просмотра и фильтра.</p>
    <p>Когда клиент платит через штатную оплату, проверяйте соответствующий заказ в таймлайне. Просмотр страницы и успешная оплата — разные события. Статус одного заказа не подтверждает полноту всех поступлений по договору. <a href={sourceLinks[2].href} target="_blank" rel="noopener noreferrer">Где видны статусы оплаты</a>.</p>
    <p>Не ограничивайте список только сделками в работе или созданными в этом месяце: обязательства по более старым и завершённым продажам могут оставаться непогашенными. Проверьте состав выборки и <a href={sourceLinks[4].href} target="_blank" rel="noopener noreferrer">права просмотра CRM</a>. Итог руководителя должен охватывать согласованный круг клиентов, а не только доступные ему случайные карточки.</p>
  </section>

  <section aria-labelledby="payment-register">
    <h2 id="payment-register">Какие данные <span data-heading-accent>нужны для расчёта</span></h2>
    <p>Удобная единица реестра — отдельное платёжное обязательство с датой. У одной сделки их может быть несколько. Сохраняйте ID клиента, сделки и обязательства, основание, валюту, первоначальную сумму и действующий срок. Рядом нужны погашенная часть, остаток, ответственный и время последней сверки.</p>
    <p>Каждое поступление связывайте с источником и устойчивым идентификатором операции, а затем распределяйте по обязательствам. Если платёж закрывает несколько этапов или сделок, запишите суммы распределения: одну и ту же оплату нельзя целиком вычесть несколько раз. Правило распределения согласуйте заранее, неоднозначные записи разбирайте вручную.</p>
    <p>Отдельно учитывайте реальные возвраты, исправления дублей и изменения стоимости. Суммы разных валют ведите раздельно либо применяйте заранее определённое правило пересчёта. Способ ведения отдельных поступлений и ручных итогов CRM разобран в <a href={`${base}chastichnaya-oplata-bitrix24/`}>инструкции о частичной оплате в Битрикс24</a>.</p>
    <p>Если срок не установлен или источник денег ещё не проверен, покажите строку как требующую уточнения. Не включайте её в подтверждённую просрочку и не прячьте среди будущих оплат. Такая очередь на сверку нужна руководителю вместе с денежными итогами.</p>
    <p>Для ручной проверки одной сделки можно использовать <a href={`${base}grafik-platezhey-bitrix24/#download-payment-template`}>Excel-шаблон графика и журнала поступлений</a>. Он рассчитан на одну сделку в RUB, до 20 этапов и 50 записей; связи с CRM и банком нет. Это основа сверки отдельной сделки, а не готовый сводный отчёт. Учебная DEMO-001 в файле имеет свой срез на 22 октября и не входит в реестр трёх сделок ниже.</p>
  </section>

  <section aria-labelledby="payment-states">
    <h2 id="payment-states">Как отделить <span data-heading-accent>просрочку от оплаты сегодня</span></h2>
    <p>Сначала зафиксируйте дату среза и момент последней сверки поступлений. В примерах этой статьи используем календарные даты без времени: срок раньше даты среза уже прошёл, равный ей относится к оплате сегодня. Если условия клиента задают время, часовой пояс или иной порядок определения срока, учитывайте их отдельно.</p>
    <p>Разделяйте строки по обязательствам, а не присваивайте один статус всей сделке. У одного клиента одновременно могут быть просроченный этап, платёж на сегодня и будущий аванс. Сообщение «мы уже заплатили» требует проверки источника и назначения платежа.</p>
    <DataTable label="Как разобрать непогашенные обязательства на выбранную дату" columns={['Состояние строки', 'Как определить', 'Следующее действие']} rows={stateRows} rowHeaders />
    <p>Неизвестный срок и несверенное поступление — причины для уточнения, они могут встретиться в одной строке. Не складывайте их с подтверждёнными денежными итогами как отдельные суммы и не выдавайте неполный расчёт за окончательный. Назначьте владельца проверки и покажите, какие данные ещё нужны.</p>
  </section>

  <section aria-labelledby="overdue-example">
    <h2 id="overdue-example">Почему <span data-heading-accent>108 000 ₽ остатка</span> — не 108 000 ₽ просрочки</h2>
    <p>Рассмотрим учебный список на 12 октября 2026 года. Все суммы — в RUB, условия подтверждены, возвратов и спорных операций нет. В компании сверены три условные сделки; это пример расчёта, не данные клиента TrueTell.</p>
    <p>По D-1042 стоимость — 120 000 ₽, подтверждённо получено 72 000 ₽. Оставшиеся 48 000 ₽ должны поступить 20 октября. По D-1181 согласованы два обязательства: 70 000 ₽ со сроком 5 октября и 20 000 ₽ со сроком 25 октября. Полученные 30 000 ₽ зачтены именно в первое обязательство: по нему осталось 40 000 ₽.</p>
    <p>На телефоне прокрутите таблицу вправо, чтобы увидеть все суммы и сроки.</p>
    <DataTable label="Учебный реестр платежей на 12 октября 2026 года, все суммы в RUB"
      columns={['Сделка', 'Стоимость', 'Получено', 'Остаток', 'Непогашенные сроки']} rows={registerRows} rowHeaders />
    <p>Общая стоимость — 260 000 ₽, поступления — 152 000 ₽, непогашенный остаток — 108 000 ₽. Срок прошёл только у 40 000 ₽ по D-1181. Ещё 68 000 ₽ ожидаются позже: 48 000 ₽ по D-1042 и 20 000 ₽ по D-1181. По D-1210 обязательства оплачены полностью.</p>
    <ArticleFigure src={balanceImage} fullSize
      alt="Учебное распределение остатков: D-1042 — 48 тысяч рублей с будущим сроком, D-1181 — 40 тысяч просрочено и 20 тысяч ожидаются позже, D-1210 — остаток ноль"
      caption="Учебная инфографика TrueTell по таблице выше, не экран приложения. Красная часть — 40 000 ₽ с прошедшим сроком, синяя — 68 000 ₽ с будущими сроками. Длины полос пропорциональны суммам." />
    <p>Задача руководителя — назначить действие по просроченному обязательству D-1181 и сохранить контроль будущих сроков. Если отметить все 60 000 ₽ этой сделки как просрочку, в разговор попадёт сумма, которую клиент пока не обязан перечислять по условиям примера.</p>
    <h3>Что изменится при следующей проверке</h3>
    <p>Предположим, до 22 октября новых поступлений и изменений условий не было. Общий остаток тех же трёх сделок останется 108 000 ₽, но его состав изменится: 48 000 ₽ по D-1042 со сроком 20 октября уже просрочены. Вместе с прежними 40 000 ₽ по D-1181 просрочка составит 88 000 ₽; будущими останутся 20 000 ₽ со сроком 25 октября. Инфографика выше относится к первому срезу — 12 октября, а не к этой повторной проверке.</p>
    <p>Поэтому отчёт должен хранить дату среза и опираться на проверенный факт по эту дату. Если новые поступления ещё не разобраны, руководителю нужен предварительный итог и очередь сверки; простое изменение даты в старом файле не подтверждает актуальность сумм.</p>
    <p>Отрицательный расчётный остаток разберите отдельно: это может быть переплата, ошибочное распределение или устаревшая стоимость. Не заменяйте его нулём без объяснения и не уменьшайте им автоматически остаток другой сделки. Для переноса оплаты между обязательствами нужно проверенное основание.</p>
  </section>

  <section aria-labelledby="manager-action">
    <h2 id="manager-action">Как превратить <span data-heading-accent>просрочку в поручение</span></h2>
    <p>За подтверждение поступлений отвечает назначенный сотрудник финансовой службы или другой согласованный владелец данных. Менеджер ведёт коммуникацию с клиентом. Руководитель разбирает отклонения и проверяет, что по каждой выбранной строке есть действие с исполнителем и сроком.</p>
    <p>Поручение должно описывать результат. Для D-1181 из первого среза на 12 октября, например: «Сверить непогашенные 40 000 ₽ по обязательству со сроком 5 октября; связаться с клиентом; сохранить ответ и дату следующей проверки». Срок выполнения этого поручения — отдельная дата, он не заменяет срок оплаты.</p>
    <p>Задачу можно создать из карточки сделки: в таймлайне выберите «Задача», укажите название, описание, исполнителя и крайний срок, затем нажмите «Поставить задачу». Проверьте связь с нужной сделкой. <a href={sourceLinks[3].href} target="_blank" rel="noopener noreferrer">Работа с задачами в CRM</a>.</p>
    <ArticleFigure src={taskImage} fullSize
      alt="Официальный пример задачи CRM Битрикс24: описание, исполнитель, крайний срок и связь со сделкой"
      caption="Оригинальный экран Поддержки24 показывает задачу по подготовке договора: видны исполнитель, крайний срок и связанная сделка. Он иллюстрирует оформление поручения, а не подтверждение оплаты или отчёт о долгах." />
    <p>Учитывайте поведение задач при закрытии CRM. В текущей справке Битрикс24 указано: незавершённые задачи могут завершиться вместе с лидом или сделкой. Для сделки предусмотрен контроль после завершения, при котором задача переходит в «Ждет контроля». Проверьте настройку и сохранение нужного поручения, если работа по оплате продолжается.</p>
    <p>Ответ клиента «оплатим в пятницу» сохраните рядом с действующим сроком. При согласованном изменении условий зафиксируйте основание и обновите реестр. После сообщения «платёж отправлен» нужна повторная сверка источника: завершение звонка или задачи не погашает обязательство.</p>
    <h3>Как провести короткий разбор с менеджером</h3>
    <p>Продолжим учебный срез 12 октября. Назначенный финансовый ответственный сверяет поступления по D-1181, затем менеджер до 16:00 того же дня уточняет причину непогашенных 40 000 ₽ и фиксирует ответ клиента. Результат поручения — запись о проверенном остатке, договорённости и следующем действии; обещание клиента хранится отдельно от действующего срока 5 октября.</p>
    <p>Если клиент сообщил об отправке денег, назначьте повторную сверку, например на 13 октября к 10:00. После подтверждения поступления распределите его по обязательству и пересчитайте остаток. Если денег нет, сохраните результат проверки и согласуйте дальнейшее действие. Сумма 20 000 ₽ со сроком 25 октября остаётся в будущих оплатах: она не должна попадать в это поручение как просроченная.</p>
    <InlineConsultation title="Нужен общий порядок контроля оплат?"
      description="Согласуем источники поступлений, сроки обязательств и роли сотрудников, чтобы менеджер и руководитель работали с одними данными."
      href={companyInfo.contacts.consultationUrl} actionLabel="Обсудить задачу" />
  </section>

  <section aria-labelledby="management-report">
    <h2 id="management-report">Что оставить <span data-heading-accent>на экране руководителя</span></h2>
    <p>Для первого разбора достаточно подтверждённого непогашенного остатка, его просроченной части, оплаты со сроком сегодня, ближайших будущих обязательств и числа строк на уточнение. Покажите дату среза и последней успешной сверки. По каждой сумме нужен переход к обязательствам, сделкам и основаниям расчёта.</p>
    <p>Число клиентов, сделок и платёжных обязательств — разные показатели. В примере одна сделка D-1181 содержит два непогашенных срока. Выберите единицу подсчёта и подпишите её; иначе менеджеры будут спорить о количестве долгов, хотя смотрят на одни записи.</p>
    <p>Начинайте рабочий разбор с подтверждённых просроченных сумм и несверенных записей, затем смотрите ближайшие сроки. Для каждой выбранной строки фиксируйте действие и дату повторной проверки. Если платёж уже поступил, сначала обновите источник и распределение, после этого пересчитайте итог.</p>
    <p>Для будущих оплат нужен другой разрез: ожидаемые поступления по датам. В <a href={`${base}platezhnyy-kalendar-bitrix24/`}>сравнении календаря в CRM и финансового календаря компании</a> разбираем, когда к клиентским срокам нужно добавить выплаты и доступные деньги.</p>
    <p>Другие показатели отдела продаж рассматриваем в <a href={`${base}dashbord-rukovoditelya-bitrix24/`}>материале о дашборде руководителя</a>. Для проверки суммы успешных сделок есть <a href={`${base}otchety-po-prodazham-bitrix24/`}>инструкция по отчётам продаж</a>. Итоги продаж и фактически полученные деньги должны иметь свои определения и источники.</p>
  </section>

  <section aria-labelledby="payment-schedule-readiness">
    <h2 id="payment-schedule-readiness">Когда потребуется <span data-heading-accent>отдельный инструмент</span></h2>
    <p>Ручной реестр подходит, пока назначенный сотрудник успевает сверять операции и поддерживать одинаковые итоги. Когда много сделок с несколькими сроками, распределениями и исправлениями, сформулируйте требования к автоматизации: история изменений, понятные остатки, детализация до источника, доступы и проверяемое обновление.</p>
    <p>TrueTell разрабатывает «График платежей» для Битрикс24. На 25 октября 2026 года в тестовых установках на двух порталах проверено сохранение графиков. На первом также проверены ручное поступление с исправлением и отменой, общий отчёт с остатками, календарь поступлений и обе CSV; на втором — разграничение доступа. <strong>Приложение ещё не выпущено в Маркете</strong>. Данные тестовых сделок не подтверждают банковскую сверку или готовность к тиражному внедрению.</p>
    <p>До внедрения можно обсудить свой процесс: где подтверждаются деньги, как они распределяются и какие действия нужны руководителю. Автоматическую банковскую сверку, готовые уведомления или полноценный отчёт о задолженности нельзя считать доступными только по названию приложения.</p>
  </section>

