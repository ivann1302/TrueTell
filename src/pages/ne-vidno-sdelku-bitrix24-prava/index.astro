---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { mcpProduct } from '../../config/products';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import accessImage from '../../images/articles/bitrix24-deal-access-route-131.png';
import mailImage from '../../images/articles/bitrix24-mail-visibility-check-131.png';

const article = getArticle('ne-vidno-sdelku-bitrix24-prava/');
const { title, description } = article;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const ogImage = new URL(accessImage.src, siteRoot).toString();
const imageAlt = 'Два маршрута проверки доступа в CRM Битрикс24: скрыта сама сделка или сделка видна, но письмо отсутствует';
const faqItems = [
  { question: 'Почему сотрудник не видит сделку, которую видит руководитель?', answer: 'Сначала сбросьте фильтр списка и откройте одну и ту же сделку по ссылке или ID. Если карточка недоступна, сравните направление, стадию, ответственного и роль сотрудника. В правах CRM проверьте «Чтение» для сделок этой воронки и стадии. Уровень «Свои» относится к карточкам, где сотрудник ответственный.' },
  { question: 'Почему сотрудник создал сделку, но потом перестал её видеть?', answer: 'Право создания не означает право чтения. По справке Битрикс24 сотрудник не увидит созданный элемент без права «Чтение». Также проверьте, не изменились ли ответственный, воронка или стадия: права могут различаться по этим признакам.' },
  { question: 'Сделка видна, но письма в ней нет. Нужно дать больше прав на сделки?', answer: 'Сначала сбросьте фильтр таймлайна. Затем проверьте, к каким CRM-элементам привязано письмо. Если оно связано со сделкой и контактом, сотруднику нужны права на просмотр обоих. Одного чтения сделки может быть недостаточно. Если письма в CRM нет и у сотрудника с нужным доступом, проверьте интеграцию ящика и синхронизацию.' },
  { question: 'Почему письмо есть в разделе «Почта», но его нет в CRM?', answer: 'Для автоматического сохранения входящих в карточку должна быть включена интеграция ящика с CRM. В настройках ящика также проверьте папки синхронизации. После проверки настроек найдите письмо в нужной карточке клиента и сверьте его связи.' },
  { question: 'Нужно ли выдавать сотруднику права администратора?', answer: 'Для просмотра конкретной сделки обычно достаточно подходящего права «Чтение» для нужной воронки, стадии и карточек. Настройки прав меняет администратор либо сотрудник с правом «Разрешить изменять настройки CRM». Выдавайте доступ по рабочей роли и проверяйте результат на конкретной карточке.' },
  { question: 'MCP TrueTell уже проверяет права и видимость писем автоматически?', answer: 'Такую автоматическую проверку мы пока не заявляем. MCP TrueTell для настройки и диагностики CRM находится в разработке. При обсуждении сценария можно определить, какие данные и права нужны для чтения, какие проверки проводит человек и кто подтверждает изменения.' },
];
const sourceLinks = [
  { label: 'Битрикс24: ролевая модель прав CRM', href: 'https://helpdesk.bitrix24.ru/open/23240636/' },
  { label: 'Битрикс24: приоритет прав стадии при конфликте', href: 'https://helpdesk.bitrix24.ru/open/14749830/' },
  { label: 'Битрикс24: доступ к воронкам продаж', href: 'https://helpdesk.bitrix24.ru/open/25552638/' },
  { label: 'Битрикс24: частые вопросы о почте в CRM', href: 'https://helpdesk.bitrix24.ru/open/24147062/' },
  { label: 'Битрикс24: как работать с почтой в CRM', href: 'https://helpdesk.bitrix24.ru/open/18048120/' },
  { label: 'Битрикс24: фильтры списка CRM', href: 'https://helpdesk.bitrix24.ru/open/24206616/' },
  { label: 'Битрикс24: поиск и фильтр таймлайна', href: 'https://helpdesk.bitrix24.ru/open/25676698/' },
  { label: 'Битрикс24: почему раздел CRM может быть скрыт', href: 'https://helpdesk.bitrix24.ru/open/25817644/' },
];
const routeRows = [
  ['Не видна сделка', 'Сброшен фильтр; ту же карточку видит коллега', 'Чтение сделок, воронка, стадия, ответственный и роль'],
  ['Сделка видна, письма нет', 'Сброшен фильтр таймлайна; письмо видно коллеге', 'Связанные контакт и компания, права чтения каждого элемента'],
  ['Письма нет ни у кого', 'Письмо есть в почтовом ящике', 'Интеграция ящика с CRM, папки синхронизации и привязка'],
];
const structuredData = createArticleStructuredData({
  articleType: 'Article', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  breadcrumbs: [{ name: 'Главная', item: siteRoot.toString() }, { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() }, { name: title, item: articleUrl }],
  faqItems,
});
---
<ArticleLayout {title} titleParts={[{ text: 'Не видно сделку или письмо ' }, { text: 'в CRM Битрикс24', accent: true }]} {description}
  canonicalPath={`/${article.hrefPath}`} {structuredData} ogTitle={article.seoTitle} ogDescription={description}
  {ogImage} ogImageAlt={imageAlt} category={article.category} author={authorName}
  intro="Руководитель видит сделку, а менеджер нет? Или карточка открывается, но письмо в таймлайне отсутствует? Эти симптомы требуют разных проверок доступа.">
  <Fragment slot="quick-answer">
    <p><strong>Возьмите одну сделку по ID, сбросьте фильтр списка и сравните карточку у двух сотрудников. Если менеджер всё ещё не может её открыть, проверьте право «Чтение» для нужной воронки и стадии, роль и ответственного.</strong></p>
    <p>Если карточка открывается, но письмо скрыто, сбросьте фильтр таймлайна и проверьте права на связанные с письмом CRM-элементы, прежде всего контакт. Когда письма нет в CRM ни у кого, переходите к настройкам интеграции почтового ящика.</p>
  </Fragment>

  <p data-article-lead>Менеджер сообщает, что сделка пропала, а у руководителя она открывается. Попросите обоих назвать ID карточки. Если спор касается письма, запишите его тему и время. По одному примеру можно выяснить, скрыта ли сделка из-за прав, недоступно ли письмо или оно вообще не попало в CRM. Тогда администратору не придётся расширять права сразу всей команде.</p>

  <section aria-labelledby="separate">
    <h2 id="separate">Определите, <span data-heading-accent>чего именно не видно</span></h2>
    <p>Попросите сотрудника сбросить фильтр списка и открыть ту же карточку, которую видит руководитель. Сверьте ID и стадию, чтобы не сравнивать похожие сделки одного клиента. Если карточка недоступна и по прямой ссылке, начните с прав на сделки. Если карточка доступна, сбросьте фильтр её таймлайна и уточните тему или время письма. Выбранный фильтр может сохраняться для карточки при следующем открытии.</p>
    <ArticleFigure src={accessImage} fullSize alt={imageAlt} caption="Редакционная схема по официальной справке Битрикс24. Перед маршрутом проверки сбросьте фильтр списка и таймлайна; это не снимок интерфейса." />
    <DataTable label="Как выбрать маршрут проверки" columns={['Что видит сотрудник', 'Контрольный факт', 'Следующая проверка']} rows={routeRows} rowHeaders />
    <p>Если у сотрудника вообще нет раздела CRM в меню, проверьте скрытые пункты, доступность инструмента в настройках портала и право просмотра CRM. Это более широкий случай, чем отсутствие одной сделки.</p>
  </section>

  <section aria-labelledby="deal-rights">
    <h2 id="deal-rights">Когда не видна <span data-heading-accent>сама сделка</span></h2>
    <p>Администратор или сотрудник с правом «Разрешить изменять настройки CRM» открывает CRM → Ещё → Настройки → Права доступа к CRM. В роли сотрудника проверяют действие «Чтение» для сделок нужной воронки и, если права детализированы, нужной стадии. Отдельно сверяют ответственного: уровень «Свои» относится к карточкам, за которые отвечает этот сотрудник; «Своего отдела» и другие уровни имеют иной охват.</p>
    <p>Сотрудник может создать элемент и затем не видеть его, если права на добавление есть, а на чтение нет. Воронка тоже может быть скрыта целиком: Битрикс24 показывает сотруднику только те воронки, где у него есть право хотя бы на просмотр сделок. При нескольких ролях проверьте право именно на стадии: заданное для неё правило заменяет общее, а детализированные права имеют приоритет над наследуемыми.</p>
    <p>После изменения настройки вернитесь к той же карточке под учётной записью сотрудника. Проверьте, может ли он её открыть и видит ли ожидаемые поля, не расширяя права остальных сотрудников. Ролевая модель и её возможности зависят от тарифа портала.</p>
  </section>

  <section aria-labelledby="mail-rights">
    <h2 id="mail-rights">Когда сделка есть, <span data-heading-accent>а письма нет</span></h2>
    <p>Сначала убедитесь, что в таймлайне показаны письма и нет оставшегося поискового запроса. Письмо в CRM может быть связано сразу с несколькими элементами. По справке Битрикс24 сотрудник не увидит письмо в карточке сделки, если оно также связано с контактом, на который у него нет прав просмотра. Проверьте связи конкретного письма и чтение каждого связанного контакта или компании. Право на сделку само по себе здесь не даёт полного ответа.</p>
    <ArticleFigure src={mailImage} fullSize alt="Учебная схема: для просмотра письма нужны права на связанные сделку и контакт; если письма нет в CRM, проверяют интеграцию почты" caption="Учебный пример связанного письма. Логика прав и интеграции взята из справки Битрикс24; реальные адреса и данные клиентов не показаны." />
    <p>Проверьте результат тем же пользователем после точечного изменения прав. Не смешивайте две роли: ответственный за письмо в карточке — ответственный за саму карточку, а аватар возле системной записи о письме показывает сотрудника, подключившего почтовый ящик. По нему нельзя определить, кому следует выдать доступ к связанному контакту.</p>
  </section>

  <section aria-labelledby="mail-missing">
    <h2 id="mail-missing">Когда письма <span data-heading-accent>нет в CRM ни у кого</span></h2>
    <p>Откройте письмо в разделе «Почта» и проверьте, какой ящик его получил. Для автоматического сохранения входящих в карточку должна быть включена «Интеграция с CRM». Если вручную сохранить письмо получается, а автоматически оно не появляется, проверьте папки синхронизации в настройках ящика. В справке отдельно описан случай, когда настройка перемещения спама во «Входящие» мешает автоматическому сохранению.</p>
    <p>После настройки найдите письмо по теме и времени в CRM, проверьте, к какому клиенту или карточке оно привязалось. Письма, которые отправили роботы и бизнес-процессы, сохраняются в карточке CRM, но не отображаются в разделе «Почта»; для такого письма ищите запись в таймлайне, а не в почтовом списке.</p>
    <p>Если проблема началась с формы или входящего канала и карточка вообще не создана, используйте отдельный маршрут <a href={`${base}poteryannye-zayavki-bitrix24/`}>поиска потерянной заявки</a>. Он проверяет путь обращения до CRM, тогда как здесь мы разбираем доступ к существующей записи или письму.</p>
  </section>

  <section aria-labelledby="record-result">
    <h2 id="record-result">Зафиксируйте причину <span data-heading-accent>на одном примере</span></h2>
    <p>Запишите ID сделки, её направление и стадию, роль сотрудника, связанные с письмом элементы и проверенный параметр доступа. После исправления попросите того же сотрудника повторить попытку. Так вы убедитесь, что правило сработало на нужной карточке: руководитель и менеджер могли смотреть разные сделки или разные письма клиента.</p>
    <p>MCP TrueTell для настройки и диагностики CRM находится в разработке. Мы пока не заявляем автоматическую проверку всех прав и видимости писем. Для обсуждения сценария полезны обезличенный пример, ожидаемый уровень доступа и решение, какие изменения человек должен подтверждать отдельно. Не отправляйте в форму содержание переписки и персональные данные клиента.</p>
    <InlineConsultation variant="product" title="Нужно разобраться с видимостью CRM?" description="Опишите, кто видит карточку, а кто нет, и укажите тип связанного элемента без данных клиента. Поможем составить проверку прав и обсудить сценарий диагностики." href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
  </section>

  <FaqSection title="Частые вопросы о доступе к CRM Битрикс24" items={faqItems} variant="article" />
  <p>Официальная справка Битрикс24 проверена 31 октября 2026 года. Клиентский портал, конкретные роли и почтовые ящики не тестировались; доступность настроек зависит от тарифа и прав.</p>
  <ArticleSources publishedIso={article.publishedAt} modifiedIso={article.updatedAt} sources={sourceLinks} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Обсудим ' }, { text: 'MCP TrueTell для CRM', accent: true }]} description={mcpProduct.articleDescription} href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <ConsultationCtaSection slot="after-article" />
</ArticleLayout>
