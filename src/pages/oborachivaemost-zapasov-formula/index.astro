---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import Checklist from '../../components/editorial/checklist.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import calculationImage from '../../images/articles/inventory-turnover-example-068.png';
import comparisonImage from '../../images/articles/inventory-turnover-vs-stock-age-068.png';

const article = getArticle('oborachivaemost-zapasov-formula/');
const { title, description } = article;
const canonicalPath = '/' + article.hrefPath;
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const imageAlt = 'Учебный расчёт оборачиваемости запасов за квартал: себестоимость продаж 900 тысяч рублей, средний запас 300 тысяч, три оборота и 30 дней';
const ogImage = new URL(calculationImage.src, siteRoot).toString();
const titleParts = [{ text: 'Оборачиваемость запасов: ' }, { text: 'формула и расчёт', accent: true }, { text: ' в днях' }];

const sourceLinks = [
  { label: 'Inventory Turns — Lean Enterprise Institute', href: 'https://www.lean.org/lexicon-terms/inventory-turns/' },
  { label: 'How Do You Calculate Inventory Turns? — APQC', href: 'https://www.apqc.org/How-Do-You-Calculate-Inventory-Turns' },
  { label: 'Отчёт «Остатки» — Служба поддержки МоегоСклада', href: 'https://support.moysklad.ru/hc/ru/%D1%82%D0%BE%D0%B2%D0%B0%D1%80%D1%8B%20%D0%B8%20%D1%81%D0%BA%D0%BB%D0%B0%D0%B4%D1%8B/%D0%BE%D1%81%D1%82%D0%B0%D1%82%D0%BA%D0%B8%20%D0%B8%20%D1%81%D0%B5%D0%B1%D0%B5%D1%81%D1%82%D0%BE%D0%B8%D0%BC%D0%BE%D1%81%D1%82%D1%8C/%D0%BE%D1%82%D1%87%D0%B5%D1%82_%D0%BE%D1%81%D1%82%D0%B0%D1%82%D0%BA%D0%B8' },
  { label: 'Отчёт «Обороты» — Служба поддержки МоегоСклада', href: 'https://support.moysklad.ru/hc/ru/%D1%82%D0%BE%D0%B2%D0%B0%D1%80%D1%8B%20%D0%B8%20%D1%81%D0%BA%D0%BB%D0%B0%D0%B4%D1%8B/%D0%BE%D1%81%D1%82%D0%B0%D1%82%D0%BA%D0%B8%20%D0%B8%20%D1%81%D0%B5%D0%B1%D0%B5%D1%81%D1%82%D0%BE%D0%B8%D0%BC%D0%BE%D1%81%D1%82%D1%8C/%D0%BE%D0%B1%D0%BE%D1%80%D0%BE%D1%82%D1%8B' },
];

const metricRows = [
  ['Оборачиваемость за период', 'Себестоимость проданных товаров за период', 'Средний запас по себестоимости за тот же период', 'Сколько раз запас обернулся в выбранном окне'],
  ['Дни оборачиваемости', 'Число календарных дней периода', 'Оборачиваемость за период', 'Какому числу дней соответствует рассчитанный темп'],
  ['«Дней на складе» в МойСклад', 'Возраст каждой партии остатка на дату отчёта', 'Количество текущего положительного остатка', 'Как давно в среднем поступили единицы, которые остаются сейчас'],
];

const faqItems = [
  {
    question: 'Какая формула оборачиваемости запасов?',
    answer: 'Для расчёта в стоимостном выражении разделите себестоимость проданных товаров за период на среднюю стоимость запаса за тот же период. Средний запас можно оценить по началу и концу периода, а при заметных колебаниях — по регулярным срезам внутри него.',
  },
  {
    question: 'Как перевести оборачиваемость в дни?',
    answer: 'Разделите число дней в выбранном периоде на коэффициент оборачиваемости за этот период. Например, 90 дней / 3 оборота = 30 дней. Это расчётный показатель по среднему запасу, а не точный возраст каждой единицы товара.',
  },
  {
    question: 'Нужно умножать результат на 365?',
    answer: 'Только если вы считаете годовую оборачиваемость и переводите её в годовой показатель дней. Если коэффициент рассчитан за квартал, используйте календарные дни этого квартала; не смешивайте годовую себестоимость с квартальным запасом.',
  },
  {
    question: 'Чем оборачиваемость отличается от «дней на складе» в МойСклад?',
    answer: 'Оборачиваемость сопоставляет себестоимость продаж со средним запасом за период. «Дней на складе» в отчёте МойСклад оценивает возраст текущего остатка по партиям поступления. Формулы отвечают на разные вопросы, поэтому результаты могут отличаться.',
  },
  {
    question: 'Какое значение оборачиваемости считать хорошим?',
    answer: 'Универсального порога нет: показатель зависит от категории, сезона, срока поставки, размера партии и риска дефицита. Сравнивайте одинаковые товары и периоды, затем проверяйте показатель вместе с наличием, маржой и потерянными продажами.',
  },
];
const calculationSteps = [
  { title: 'Выберите завершённый период и одинаковые границы анализа: склады, группы и товары.' },
  { title: 'Получите себестоимость проданных товаров за эти даты и проверьте возвраты и списания.' },
  { title: 'Рассчитайте средний запас по регулярным срезам на сопоставимой основе оценки.' },
  { title: 'Разделите себестоимость продаж на средний запас, затем дни периода — на коэффициент.' },
  { title: 'Сверьте результат с остатками, доступностью и маржой, после чего сравните его с прошлым сопоставимым периодом.' },
];

const relatedArticles = getRelatedArticles(article.hrefPath);
const structuredData = createArticleStructuredData({
  title,
  description,
  articleUrl,
  publisherUrl: siteRoot.toString(),
  image: ogImage,
  author: authorName,
  articleSection: article.topic,
  breadcrumbs: [{ name: 'Главная', item: siteRoot.toString() }, { name: 'Блог', item: new URL('blog/', siteRoot).toString() }, { name: title, item: articleUrl }],
  faqItems,
});
---

<ArticleLayout
  title={title}
  titleParts={titleParts}
  description={description}
  canonicalPath={canonicalPath}
  category={article.category}
  intro="Себестоимость продаж за период делят на средний запас по себестоимости. Так получают коэффициент оборачиваемости и переводят его в дни. В МойСклад отдельно рассчитывается показатель «Дней на складе» для возраста текущих остатков по партиям."
  structuredData={structuredData}
  ogTitle={article.seoTitle}
  ogDescription={description}
  ogImage={ogImage}
  ogImageAlt={imageAlt}
  author={authorName}
>
  <Fragment slot="quick-answer">
    <p>Разделите себестоимость продаж за период на средний запас по себестоимости. В учебном примере 900&nbsp;000&nbsp;₽ ÷ 300&nbsp;000&nbsp;₽ = 3 оборота за квартал.</p>
    <p>Чтобы перевести коэффициент в дни, разделите календарные дни периода на число оборотов: 90 ÷ 3 = 30 дней. Это средний расчётный темп, а не возраст каждой партии на складе.</p>
  </Fragment>

  <p data-article-lead>Коэффициент помогает сопоставлять движение запасов между периодами и товарными группами. Для сравнения берите одинаковые товары и склады, а также сохраняйте способ усреднения. Поле «Дней на складе» в МойСклад отвечает на отдельный вопрос: каков средний возраст партий, оставшихся в наличии.</p>

  <section aria-labelledby="formula">
    <h2 id="formula">Формула оборачиваемости <span data-heading-accent>запасов</span></h2>
    <p><strong>Оборачиваемость за период = себестоимость проданных товаров за период ÷ средний запас по себестоимости за этот же период.</strong> Сопоставляйте одинаковый ассортимент и одинаковую стоимость: выручка включает торговую наценку, поэтому при расчёте по выручке коэффициент может измениться из-за цены, даже если скорость движения товара та же.</p>
    <ArticleFigure src={calculationImage} fullSize eager alt={imageAlt} caption="Учебный пример на условных данных: средний запас рассчитан по трём месячным срезам. Сумма себестоимости продаж и остатки приведены к одной валюте." />
    <p>С января по март 2026 года себестоимость продаж составила 900&nbsp;000&nbsp;₽. Остаток по себестоимости на конец каждого месяца равнялся 280&nbsp;000, 300&nbsp;000 и 320&nbsp;000&nbsp;₽. Средний запас: (280&nbsp;000 + 300&nbsp;000 + 320&nbsp;000) ÷ 3 = 300&nbsp;000&nbsp;₽. Коэффициент: 900&nbsp;000 ÷ 300&nbsp;000 = 3 оборота за квартал.</p>
    <p>Чтобы перевести результат в дни, разделите число календарных дней периода на коэффициент оборачиваемости. В I квартале 2026 года 90 календарных дней, поэтому 90 ÷ 3 = 30 дней. Это средняя расчётная длительность оборота. Она не показывает срок хранения конкретной партии и не означает, что каждый товар продаётся за месяц.</p>
  </section>

  <section aria-labelledby="average">
    <h2 id="average">Как рассчитать <span data-heading-accent>средний запас</span></h2>
    <p>Для предварительной оценки можно усреднить остаток на начало и конец периода. Такой расчёт подходит, если запас менялся без резких скачков. При крупной закупке или распродаже в конце квартала две даты не покажут, что происходило между ними.</p>
    <p>Чтобы учесть колебания внутри периода, берите одинаковые контрольные срезы, например стоимость остатка на конец каждого месяца. Для сезонного или быстро меняющегося ассортимента снимайте показатели чаще. При сравнении фиксируйте метод усреднения, состав товаров, склад и даты.</p>
    <p>В знаменателе используйте стоимость запасов на той же основе, что и себестоимость продаж. Не делите денежную себестоимость на количество единиц. Для расчёта в штуках применяйте отдельный вариант: количество проданных единиц ÷ средний количественный запас по конкретному товару. Не складывайте штуки разных товаров в один показатель, если это не предусмотрено задачей.</p>
    <DataTable label="Показатели движения и возраста товара" columns={['Показатель', 'Что берём в расчёт', 'Какой вопрос он решает']} rows={metricRows.map(([name, numerator, denominator, question]) => [name, numerator + '; ' + denominator, question])} rowHeaders compact />
  </section>

  <section aria-labelledby="interpret">
    <h2 id="interpret">Как читать коэффициент и <span data-heading-accent>избежать неверных выводов</span></h2>
    <p>Рост оборачиваемости может означать, что запас продаётся быстрее относительно вложенной в него стоимости. Но слишком высокий результат бывает и следствием нехватки товара: позиции заканчиваются, а часть спроса уходит к конкурентам. Низкое значение может указывать на излишек, однако само по себе не доказывает неликвидность.</p>
    <p>Сравнивайте товары внутри сопоставимых категорий и сезонов. Учитывайте срок поставки, минимальную партию, доступность замен, маржу и случаи отсутствия товара. Для решения о закупке или распродаже одной формулы недостаточно.</p>
    <p>При сравнении фиксируйте границы периода, список складов, состав ассортимента и способ усреднения. Отдельно проверьте возвраты, списания и разовые закупки: они меняют числитель или знаменатель.</p>
  </section>

  <section aria-labelledby="days-on-stock">
    <h2 id="days-on-stock">Оборачиваемость в днях и <span data-heading-accent>«дней на складе»</span></h2>
    <p>Показатель оборачиваемости за период и поле «Количество дней на складе» в отчёте МойСклад похожи по названию, но устроены по-разному. Первый сопоставляет поток себестоимости продаж со средним запасом за выбранное окно. Второй оценивает возраст единиц, которые остались в наличии на дату отчёта, с учётом партий поступления.</p>
    <ArticleFigure src={comparisonImage} fullSize alt="Сравнение расчётных 30 дней оборачиваемости за квартал и 12,6 дня возраста остатка по партиям в примере из справки МойСклад" caption="Левый блок показывает условный расчёт за I квартал 2026 года. Правый блок приводит пример из справки МойСклад с остатками двух партий на дату отчёта. Показатели отвечают на разные вопросы и не сравниваются напрямую." />
    <p>В справке МойСклад для поля «Дней на складе» приведён пример с двумя партиями яблок. От первой осталось 6 штук возрастом 18 дней. От второй осталось 9 штук возрастом 9 дней. Средневзвешенный возраст текущего остатка: (18 × 6 + 9 × 9) ÷ 15 = 12,6 дня. В расчёте учитываются даты поступления и остатки партий, а не себестоимость продаж за квартал.</p>
    <p>В МойСклад отчёт <a href="https://support.moysklad.ru/hc/ru/%D1%82%D0%BE%D0%B2%D0%B0%D1%80%D1%8B%20%D0%B8%20%D1%81%D0%BA%D0%BB%D0%B0%D0%B4%D1%8B/%D0%BE%D1%81%D1%82%D0%B0%D1%82%D0%BA%D0%B8%20%D0%B8%20%D1%81%D0%B5%D0%B1%D0%B5%D1%81%D1%82%D0%BE%D0%B8%D0%BC%D0%BE%D1%81%D1%82%D1%8C/%D0%BE%D1%82%D1%87%D0%B5%D1%82_%D0%BE%D1%81%D1%82%D0%B0%D1%82%D0%BA%D0%B8" target="_blank" rel="noopener noreferrer">«Остатки»</a> помогает увидеть текущий остаток, себестоимость и дни на складе по товарам. Отчёт <a href="https://support.moysklad.ru/hc/ru/%D1%82%D0%BE%D0%B2%D0%B0%D1%80%D1%8B%20%D0%B8%20%D1%81%D0%BA%D0%BB%D0%B0%D0%B4%D1%8B/%D0%BE%D1%81%D1%82%D0%B0%D1%82%D0%BA%D0%B8%20%D0%B8%20%D1%81%D0%B5%D0%B1%D0%B5%D1%81%D1%82%D0%BE%D0%B8%D0%BC%D0%BE%D1%81%D1%82%D1%8C/%D0%BE%D0%B1%D0%BE%D1%80%D0%BE%D1%82%D1%8B" target="_blank" rel="noopener noreferrer">«Обороты»</a> показывает приход и расход за период и помогает проверить документы движения. Для коэффициента по собственной методике отдельно подготовьте себестоимость продаж и сопоставимые значения среднего запаса.</p>
    <p>Подробнее о срезе запасов, резервах и поиске товаров для проверки читайте в статье <a href={base + 'ostatki-moysklad/'}>«Остатки в МойСклад: контроль запасов и поиск неликвида»</a>. Как выбрать отчёты по продажам, себестоимости и прибыли, разбираем в материале <a href={base + 'otchety-moysklad/'}>«Отчёты в МойСклад»</a>.</p>
  </section>

  <section aria-labelledby="routine">
    <h2 id="routine">Короткий порядок расчёта <span data-heading-accent>для своей компании</span></h2>
    <Checklist items={calculationSteps} label="Порядок расчёта оборачиваемости запасов" />
    <p>Для регулярного сопоставления товаров, продаж и стоимости запасов по нескольким магазинам посмотрите <a href={base + 'bi-analitika/'}>пример BI-аналитики TrueTell для торговли</a>. Состав показателей и формулы для отчёта нужно согласовать с данными компании.</p>
    <InlineConsultation variant="product" title="Нужно сравнить продажи и запас по точкам?" description="Обсудим источники данных и правила расчёта, чтобы сравнивать товары и склады на одинаковых условиях." href={base + 'bi-analitika/'} actionLabel="Посмотреть BI-аналитику" />
  </section>

  <FaqSection items={faqItems} id="faq" variant="article" />
  <ArticleSources sources={sourceLinks} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Продажи и запасы в ' }, { text: 'одном анализе', accent: true }]} description="Посмотрите, как BI-аналитика TrueTell объединяет данные о продажах, остатках и торговых точках. Набор метрик и правила расчёта согласуются под задачу компании." href={base + 'bi-analitika/'} actionLabel="Посмотреть BI-аналитику" />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <Fragment slot="after-article"><ConsultationCtaSection /></Fragment>
</ArticleLayout>
