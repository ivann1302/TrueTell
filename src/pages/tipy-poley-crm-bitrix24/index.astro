---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import { fieldDirectoryProduct } from '../../config/products';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import Checklist from '../../components/editorial/checklist.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import typesImage from '../../images/articles/bitrix24-money-field-type-official.jpg';
import multipleImage from '../../images/articles/truetell-field-directory-multiple-live.jpg';
const article = getArticle('tipy-poley-crm-bitrix24/');
const { title, description } = article;
const canonicalPath = `/${article.hrefPath}`;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const ogImage = new URL(typesImage.src, siteRoot).toString();
const imageAlt = 'Официальный экран создания пользовательского поля Битрикс24: открыт список типов, среди них Строка, Число, Деньги и Список';
const titleParts = [{ text: 'Поля CRM Битрикс24: ' }, { text: 'типы и свойства', accent: true }];
const sourceLinks = [
  { label: 'Пользовательские поля в CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/22048980/' },
  { label: 'Системные поля в CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/18478840/' },
  { label: 'Обязательность поля и стадии CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/27744544/' },
  { label: 'Свойства полей crm.item.fields — REST API Битрикс24', href: 'https://apidocs.bitrix24.ru/api-reference/crm/universal/crm-item-fields.html' },
  { label: 'Типы данных и структура объектов CRM — REST API Битрикс24', href: 'https://apidocs.bitrix24.ru/api-reference/crm/data-types.html' },
];
const fieldTypes = [
  ['Строка', 'Артикул, внешний код или текстовая пометка', 'Для кода с ведущими нулями важнее сохранить запись, чем выполнять арифметику'],
  ['Целое число / Число', 'Количество без дробей / дробная величина', 'Выберите допустимую точность и единицу измерения'],
  ['Деньги', 'Сумма с указанием валюты', 'Согласуйте валюту и правила пересчёта, если данные объединяются'],
  ['Дата / Дата и время', 'Календарный день / момент события', 'Уточните, требуется ли время и как его трактуют участники обмена'],
  ['Да/Нет', 'Ответ на один однозначный вопрос', 'Это тип значения, а не признак «поле множественное»'],
  ['Список', 'Выбор из согласованных вариантов', 'Разрешение выбирать несколько значений проверяют отдельно'],
  ['Привязка', 'Ссылка на сотрудника или элемент CRM', 'Объект связи и его идентификатор нельзя заменять похожей текстовой подписью'],
];
const faqItems = [
  { question: 'Чем системное поле отличается от пользовательского?', answer: 'Системные поля предусмотрены Битрикс24, а пользовательские добавляют для своих данных. Категория описывает происхождение поля, а тип — вид значения. Системное поле не обязательно доступно только для чтения: возможность записи проверяют отдельно.' },
  { question: 'Что означает «Множественное: Да»?', answer: 'Поле допускает несколько значений. Это не означает, что в конкретной карточке уже введены два значения или что поле заполнено. Для интеграции дополнительно проверьте формат передачи нескольких значений в используемом методе.' },
  { question: '«Обязательное: Нет» в справочнике означает, что поле можно не заполнять на любой стадии?', answer: 'Нет. Справочник показывает технический isRequired из API. Настройки карточки и обязательность на стадии CRM нужно проверять отдельно для нужной сущности и воронки.' },
  { question: 'Можно ли изменить тип или множественность существующего пользовательского поля?', answer: 'В штатных настройках, описанных Поддержкой24, тип и множественность после создания изменить нельзя. Если модель данных нужна другая, сначала согласуйте новое поле и перенос значений, затем проверьте связанные отчёты, роботов и интеграции.' },
  { question: 'Почему в справочнике бывает «Не передано API»?', answer: 'Это означает, что соответствующего свойства нет в полученном описании. Такое состояние нельзя читать как «Нет». При null отображается «Не указано», а при неподходящем формате свойства — «Неверный формат».' },
  { question: 'Показывает ли справочник, какие поля не используются?', answer: 'Нет. Он показывает описания полей, а не значения карточек, обращения роботов или зависимости интеграций. Для решения об удалении или замене нужен отдельный разбор использования.' },
];
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const structuredData = createArticleStructuredData({
  articleType: 'Article', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  articleSection: article.category,
  breadcrumbs: [{ name: 'Главная', item: siteRoot.toString() }, { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() }, { name: title, item: articleUrl }], faqItems,
});
---
<ArticleLayout {title} {titleParts} {description} {canonicalPath} category={article.category}
  intro="Как отличать системные поля от пользовательских, выбирать тип значения и читать признаки обязательности и множественности перед настройкой CRM или интеграции."
  {structuredData} ogTitle={article.seoTitle ?? title} ogDescription={description} {ogImage} ogImageAlt={imageAlt} author={authorName}>
  <Fragment slot="quick-answer">
    <p>У поля отдельно проверяют <strong>происхождение, тип и свойства</strong>. Системное или пользовательское — откуда оно появилось; тип — какие данные хранит; множественность — допускается ли несколько значений.</p>
    <p>Колонка «Обязательное» в справочнике показывает <strong>технический признак API</strong>. Она не заменяет проверку обязательности на стадиях, видимости и фактической заполненности карточек.</p>
  </Fragment>
  <p data-article-lead>Название «Срок оплаты» ещё не говорит, что перед вами: текст, дата, один срок или несколько значений. Перед настройкой обмена полезно прочитать описание поля по нескольким независимым признакам. Тогда понятная подпись не скроет несовместимый формат данных.</p>
  <section aria-labelledby="field-origin">
    <h2 id="field-origin">Системные и пользовательские: <span data-heading-accent>это происхождение поля</span></h2>
    <p><a href={sourceLinks[1].href} target="_blank" rel="noopener noreferrer">Системные поля</a> входят в стандартную CRM: например, название, ответственный или дата создания. Их набор зависит от типа элемента. Пользовательские поля добавляют под собственные сведения, которых нет в подходящем стандартном поле.</p>
    <p>Категория не определяет доступность записи. Например, в описании API системное <code>title</code> не помечено как поле только для чтения, а <code>id</code> помечено. Из этого не следует безусловное право изменить название любой сделки: учитываются метод, доступ сотрудника и контекст операции.</p>
    <p>Не создавайте дубль стандартного поля только ради более удобной подписи. Сначала проверьте его назначение, тип и место хранения. Поле сделки и похожее поле контакта — разные источники, даже если их названия совпадают.</p>
  </section>
  <section aria-labelledby="choose-type">
    <h2 id="choose-type">Тип поля: <span data-heading-accent>какие значения нужны</span></h2>
    <p>Начните с задачи: что сотрудник вводит, что система проверяет и что будет делать интеграция. Ниже — учебные примеры выбора, а не перечень полей конкретного портала. Названия типов интерфейса и технические обозначения API сверяйте с описанием своего поля.</p>
    <ArticleFigure src={typesImage} fullSize alt={imageAlt}
      caption="Подлинный скриншот Поддержки24: список типов при создании пользовательского поля. В оригинале выбрана «Строка»; «Деньги» и другие варианты видны в раскрытом меню. Это иллюстрация выбора типа, а не настройка, выполненная на вашем портале." />
    <DataTable label="Учебные примеры выбора типа поля CRM" columns={['Тип', 'Пример задачи', 'Что согласовать']} rows={fieldTypes} rowHeaders />
    <p>Не используйте строку для любой информации по умолчанию. Если значение участвует в расчётах, договоритесь о числовой модели; если это идентификатор, сначала проверьте, допустимо ли терять ведущие нули. При обмене <a href={sourceLinks[4].href} target="_blank" rel="noopener noreferrer">тип и структура данных API</a> должны совпадать с требованиями конкретного метода, а не только с тем, как значение выглядит на экране.</p>
    <p>В справочнике типы могут отображаться как <code>string</code>, <code>double</code>, <code>user</code> или другое обозначение из API. Незнакомое обозначение не доказывает ошибку поля: уточните, кто его добавил и какой формат поддерживает инструмент, который будет с ним работать.</p>
  </section>
  <section aria-labelledby="multiple-values">
    <h2 id="multiple-values">Множественность: <span data-heading-accent>одно значение или несколько</span></h2>
    <p>Тип «Список» задаёт набор вариантов, а множественность — возможность выбрать несколько из них. Например, учебное поле «Интересующие направления» может предлагать «Опт» и «Розница»: вопрос о допустимости обоих вариантов сразу решается отдельно от их названий.</p>
    <p>В метаданных API за множественность отвечает <code>isMultiple</code>. На реальном экране ниже у «Наблюдателей» указано «Да». Это свойство описания поля, а не сведения о том, сколько сотрудников назначено в определённой сделке.</p>
    <ArticleFigure src={multipleImage} fullSize
      alt="Справочник полей сделки: у Наблюдателей код observers, тип user, Обязательное Нет и Множественное Да"
      caption="Реальный тестовый портал, 14.10.2026, справочник 1.0.2: поиск «Наблюдатели» показывает описание observers с типом user и признаком множественности «Да». Значения карточек и список назначенных сотрудников здесь не читаются." />
    <p>Для интеграции уточните, как конкретный метод передаёт несколько значений и что делает при обновлении. Не заменяйте несколько элементов строкой с запятыми без подтверждённого формата. Колонка «Множественное» сама по себе не задаёт правила добавления, замены или удаления значений.</p>
  </section>
  <section aria-labelledby="required-field">
    <h2 id="required-field">Обязательность API <span data-heading-accent>и требования стадии</span></h2>
    <p>Справочник показывает <code>isRequired</code> из <a href={sourceLinks[3].href} target="_blank" rel="noopener noreferrer">описания полей API</a>. Значение «Нет» не доказывает, что менеджер сможет сохранить карточку без заполнения поля на любой стадии. Для этого проверяют отдельные настройки CRM.</p>
    <p>В карточке нужного типа откройте настройки поля и проверьте «Обязательное» либо «Обязательное на стадии». Для элементов со стадиями посмотрите конкретную стадию и воронку. В сделках и смарт-процессах настройки обязательности проверяют по воронкам; стадийная опция доступна не на всех тарифах. Полный порядок описан в <a href={sourceLinks[2].href} target="_blank" rel="noopener noreferrer">официальной инструкции</a>.</p>
    <p>Четыре вопроса требуют разных проверок: вернул ли API технический флаг; требует ли карточка ввод на нужной стадии; видит ли сотрудник поле; заполнено ли оно в конкретной записи. Ответ на один из них не заменяет остальные. Наш каталог описаний не проверяет стадии, настройки видимости и заполненность сделок.</p>
    <InlineConsultation title="Нужно согласовать модель полей перед интеграцией?" description="Поможем определить сущность, назначение, тип и правила заполнения. Сначала разберём требования, затем выберем подходящий способ обмена." href={companyInfo.contacts.consultationUrl} actionLabel="Обсудить поля CRM" />
  </section>
  <section aria-labelledby="read-directory">
    <h2 id="read-directory">Как проверить свойства <span data-heading-accent>в справочнике</span></h2>
    <p>Если справочник {companyInfo.brandName} уже подключён, выберите сделки, лиды, контакты или компании и найдите поле. Поиск, тип и категория работают одновременно. Для первоначальной проверки оставьте «Все поля» и «Все типы», чтобы не скрыть строку лишним ограничением.</p>
    <p>Сравните полное имя, тип, «Обязательное» и «Множественное». Название помогает ориентироваться, но интеграция должна обращаться к правильному техническому коду. Его поиск разобран в <a href={`${base}kod-polya-bitrix24/`}>отдельной инструкции</a>. Для передачи нескольких описаний используйте <a href={`${base}spisok-poley-bitrix24/`}>выгрузку каталога в CSV</a>.</p>
    <p>Категория справочника определяется по признакам API и исходному коду. Если их недостаточно или они противоречат друг другу, она может остаться неопределённой. Такие строки ищите в «Все поля»; не считайте их автоматически системными или пользовательскими.</p>
    <p>«Не передано API», «Не указано» и «Неверный формат» — отдельные состояния свойства. Они не равны «Нет». Обновите каталог и уточните причину, если это свойство нужно для настройки обмена. Справочник не создаёт и не изменяет поля; счета и смарт-процессы текущей версией не охвачены.</p>
  </section>
  <section aria-labelledby="before-changes">
    <h2 id="before-changes">Что проверить <span data-heading-accent>до изменения модели данных</span></h2>
    <p>В штатных настройках, описанных <a href={sourceLinks[0].href} target="_blank" rel="noopener noreferrer">Поддержкой24</a>, тип и множественность пользовательского поля после создания менять нельзя. Если требуется другая модель, сначала спланируйте новое поле и перенос значений. Удаление старого поля удаляет и его данные, поэтому это не способ безопасно переключить тип.</p>
    <Checklist label="Проверка требований к полю перед изменением CRM" items={[
      { title: 'Назначение и место хранения.', description: 'Указаны портал, сущность и смысл значения; проверено, подходит ли существующее стандартное поле.' },
      { title: 'Тип и количество значений.', description: 'Согласованы допустимые варианты, точность, единицы и необходимость нескольких значений; примеры проверены на выбранном формате.' },
      { title: 'Правила ввода и доступа.', description: 'Отдельно проверены технические свойства API, нужные стадии и воронки, видимость и права сотрудника.' },
      { title: 'Зависимости и переход.', description: 'Известны использующие поле роботы, формы, отчёты и интеграции. Порядок переноса и проверки новых значений согласован до удаления старых данных.' },
    ]} />
    <p>Если поле идёт в аналитику, отдельно проверьте тип и преобразования колонки BI: метаданные CRM не гарантируют готовность к расчёту. Подробнее — в материале <a href={`${base}nazvanie-polya-uf-crm-bitrix24/`}>о сопоставлении пользовательского поля и колонки BI</a>.</p>
  </section>
  <p>Чтобы решить, какие поля оставить или изменить, одних технических свойств недостаточно. В <a href={`${base}audit-poley-crm-bitrix24/`}>разборе аудита полей CRM</a> показано, как дополнить их назначением, историческими значениями и зависимостями.</p>

  <FaqSection variant="article" items={faqItems} />
  <ArticleSources sources={sourceLinks} publishedIso={article.publishedAt} modifiedIso={article.updatedAt} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Проверьте ' }, { text: 'описания полей CRM', accent: true }]}
      description={`Справочник полей CRM от ${companyInfo.brandName} помогает сравнить названия, коды, типы и технические свойства четырёх основных сущностей. Приложение доступно в Маркете Битрикс24; настройки стадий и использование полей проверяются отдельно.`}
      href={fieldDirectoryProduct.marketplaceUrl} actionLabel={fieldDirectoryProduct.connectionActionLabel} />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <ConsultationCtaSection slot="after-article" />
</ArticleLayout>
