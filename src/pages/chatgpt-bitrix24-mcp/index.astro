---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import DataTable from '../../components/editorial/data-table.astro';
import Checklist from '../../components/editorial/checklist.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { mcpProduct } from '../../config/products';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import dealIdImage from '../../images/articles/truetell-mcp-deal-id-163.png';
import stageCheckImage from '../../images/articles/truetell-mcp-stage-check-163.png';

const article = getArticle('chatgpt-bitrix24-mcp/');
const { title, description } = article;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const canonicalPath = `/${article.hrefPath}`;
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({
  ...item,
  description: item.summaryDescription ?? item.description,
  href: `${base}${item.hrefPath}`,
}));
const sourceLinks = [
  { label: 'Тестирование собственного MCP в ChatGPT — OpenAI', href: 'https://developers.openai.com/plugins/deploy/connect-chatgpt' },
  { label: 'Получить элемент CRM по ID — REST API Битрикс24', href: 'https://apidocs.bitrix24.ru/api-reference/crm/universal/crm-item-get.html' },
  { label: 'Поля сделки и стадии по воронкам — REST API Битрикс24', href: 'https://apidocs.bitrix24.ru/api-reference/crm/deals/' },
  { label: 'Официальное решение Битрикс24 для внешних ИИ-систем — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/26952788/' },
];
const imageAlt = 'Учебная сверка сделки 518. ID совпал, код стадии в CRM C1:NEW, в ответе C1:WON';
const ogImage = new URL(stageCheckImage.src, siteRoot).toString();
const titleParts = [{ text: 'ChatGPT и Битрикс24 через MCP TrueTell: ' }, { text: 'как сверить первую сделку', accent: true }];
const checkRows = [
  ['ChatGPT ответил общими словами', 'Уточните, был ли вызван инструмент чтения. Если в чате это не видно, попросите команду пилота проверить результат вызова.'],
  ['Сделка не найдена', 'Откройте выбранную карточку под тем же сотрудником. Сверьте портал, ID и права на просмотр.'],
  ['Вернулась одноимённая сделка с другим ID', 'Сверьте ID в аргументах вызова. Если инструмент получил верный ID, запишите ожидаемый и полученный идентификаторы для разбора.'],
  ['ID совпал, но стадия отличается', 'Откройте карточку заново и проверьте, менялась ли стадия после первой сверки. Затем сравните код стадии по справочнику этой воронки.'],
  ['Пришёл ID ответственного без имени', 'Сверьте ID с карточкой сотрудника. Если справочник недоступен, зафиксируйте поле как непроверенное.'],
];
const faqItems = [
  { question: 'Можно ли сейчас подключить MCP TrueTell к ChatGPT?', answer: 'Публичной инструкции TrueTell для ChatGPT пока нет. По состоянию на 19 ноября 2026 года подтверждено пробное чтение сделок в Codex. Вход и первое чтение в ChatGPT требуют отдельной проверки.' },
  { question: 'Почему для первой проверки нужен ID сделки?', answer: 'В Битрикс24 могут быть сделки с одинаковыми названиями. По ID можно сверить, что инструмент вернул именно карточку, которую вы открыли в CRM.' },
  { question: 'Что делать, если ChatGPT показал только код стадии?', answer: 'Проверьте код по справочнику нужной воронки. Если у вас есть только название в карточке, попросите администратора подтвердить соответствие. До сверки оставьте название стадии непроверенным.' },
  { question: 'Доказывает ли успешное чтение, что можно менять сделки?', answer: 'Пробный запрос проверяет только чтение выбранной карточки. Изменение сделок требует отдельной проверки инструментов и прав.' },
];
const structuredData = createArticleStructuredData({
  articleType: 'Article', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  articleSection: 'Подключение ИИ к CRM',
  breadcrumbs: [{ name: 'Главная', item: siteRoot.toString() }, { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() }, { name: title, item: articleUrl }],
  faqItems,
});
---
<ArticleLayout {title} {titleParts} {description} {canonicalPath} {structuredData}
  ogTitle={article.seoTitle} ogDescription={description} {ogImage} ogImageAlt={imageAlt}
  category={article.category} author={authorName}
  intro="Выберите тестовую сделку в Битрикс24, запишите её ID и поля. Так вы сможете проверить первый ответ ChatGPT, когда подключение MCP TrueTell будет доступно для пилота.">
  <Fragment slot="quick-answer">
    <p>Для пробного чтения попросите ChatGPT найти сделку по точному ID. Сверьте ID, название, стадию и ответственного с CRM под тем же сотрудником. Чтение через MCP TrueTell подтверждено в Codex. Для ChatGPT пока готовим сценарий проверки.</p>
  </Fragment>

  <p data-article-lead>В учебном примере в CRM две сделки «Тестовая поставка». У одной ID 583, у другой 518. Для проверки выберем 518 и будем сравнивать ответ только с этой карточкой.</p>

  <section aria-labelledby="status">
    <h2 id="status">Что уже проверено <span data-heading-accent>в MCP TrueTell</span></h2>
    <p>В Codex команда TrueTell проверила личный вход и чтение сделок из Битрикс24. Для ChatGPT пока нет подтверждённого результата от входа до чтения карточки. До пилота уточните у администратора, доступно ли подключение собственного MCP в вашем рабочем пространстве ChatGPT.</p>
  </section>

  <section aria-labelledby="pilot-brief">
    <h2 id="pilot-brief">Выберите <span data-heading-accent>тестовую сделку по ID</span></h2>
    <p>Откройте карточку в Битрикс24 под сотрудником, который будет проверять подключение. Запишите портал, ID сделки, её название, воронку, стадию, ответственного и время сверки. Для пробы подойдёт заранее согласованная карточка с учебными данными.</p>
    <ArticleFigure src={dealIdImage} fullSize alt="Две учебные сделки с одинаковым названием и ID 583 и 518. Для запроса выбран ID 518" caption="Учебная схема с вымышленными записями. В запрос подставляем 518, чтобы исключить совпадение только по названию." />
    <p>Если у вас есть только названия стадии и ответственного, заранее уточните их код и ID у администратора CRM. Стадии сверяйте по нужной воронке. Подробнее о структуре полей в <a href={`${base}kod-polya-bitrix24/`}>разборе кодов Битрикс24</a>.</p>
  </section>

  <section aria-labelledby="permissions">
    <h2 id="permissions">Согласуйте <span data-heading-accent>доступ на чтение</span></h2>
    <p>Попросите команду пилота подтвердить, что сотруднику доступен инструмент чтения сделки. Фраза «только чтение» в чате описывает задачу. Действия ограничивают разрешения подключения. Перед пилотом пригодится <a href={`${base}bezopasnyy-dostup-ii-k-crm/`}>проверка прав доступа ИИ к CRM</a>.</p>
    <InlineConsultation variant="product" title="Обсудим пробное чтение вашей CRM" description="Расскажите, какую задачу хотите проверить в ChatGPT и какие поля понадобятся. Для обсуждения достаточно описания без выгрузки CRM." href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
  </section>

  <section aria-labelledby="verify-answer">
    <h2 id="verify-answer">Отправьте <span data-heading-accent>первый запрос</span></h2>
    <p>Когда подключение будет согласовано и доступно для проверки, подставьте ID выбранной сделки в шаблон.</p>
    <blockquote><p>Найди в подключённом Битрикс24 сделку с ID [ID тестовой сделки]. Покажи ID, название, код стадии и ID ответственного, если инструмент вернёт эти поля. Используй только чтение. Если сделка или поле недоступны, укажи это в ответе.</p></blockquote>
    <Checklist label="Сверка первого ответа ChatGPT" items={[
      { title: 'Убедитесь, что инструмент чтения вернул результат', description: 'Проверьте сведения о вызове, если они доступны в ChatGPT. При необходимости попросите команду пилота подтвердить вызов.' },
      { title: 'Сравните ID сделки и название', description: 'Если открыт другой ID, остановите сверку и повторите запрос по ID выбранной карточки.' },
      { title: 'Сверьте стадию и ответственного', description: 'Подтвердите коды по данным CRM. Отметьте отдельно каждое поле, которого нет в ответе или которое проверить не удалось.' },
    ]} />
  </section>

  <section aria-labelledby="diagnostics">
    <h2 id="diagnostics">Что проверить, <span data-heading-accent>если поля расходятся</span></h2>
    <p>В примере вернулась нужная сделка 518, а проверка стадии ещё открыта. Откройте карточку заново, чтобы учесть изменения после первой сверки. Сравните код из результата вызова со справочником воронки. Если коды совпадают, а название стадии в чате отличается, проверьте расшифровку в ответе.</p>
    <ArticleFigure src={stageCheckImage} fullSize alt={imageAlt}
      caption="Вымышленные данные. Код стадии CRM взят из учебного справочника воронки. ID сделки и ответственного совпали, коды стадии разошлись." />
    <DataTable label="Что проверить при расхождении ответа ChatGPT с Битрикс24" columns={['Результат', 'Что сделать']} rows={checkRows} rowHeaders />
    <p>Для разбора запишите время, шаг проверки и обезличенное расхождение. Если следующей задачей будет <a href={`${base}ii-analiz-sdelok-bitrix24/`}>анализ списка сделок</a>, отдельно проверьте период отбора и полноту выдачи.</p>
  </section>

  <section aria-labelledby="next">
    <h2 id="next">Что отправить <span data-heading-accent>для обсуждения с TrueTell</span></h2>
    <p>Укажите, что хотите проверить в ChatGPT, какие поля нужны и кто сможет сверить их в CRM. В форму достаточно передать описание. Тестовую карточку и доступ согласуем отдельно.</p>
  </section>

  <FaqSection title="Вопросы о ChatGPT и MCP TrueTell" items={faqItems} variant="article" />
  <p>Статус продукта и документация проверены 19 ноября 2026 года.</p>
  <ArticleSources publishedIso={article.publishedAt} modifiedIso={article.updatedAt} sources={sourceLinks} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Обсудим ' }, { text: 'MCP TrueTell для вашей CRM', accent: true }]}
      description="Опишите вопрос к CRM и поля, которые хотите сверить в ChatGPT. Обсудим подготовку пробного чтения." href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <ConsultationCtaSection slot="after-article" />
</ArticleLayout>
