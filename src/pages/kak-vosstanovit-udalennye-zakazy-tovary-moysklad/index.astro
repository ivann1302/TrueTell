---
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import Checklist from '../../components/editorial/checklist.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import { backupRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { cleanerProductPath } from '../../config/products';
import backupRecoveryImage from '../../images/articles/moysklad-backup-recovery.png';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';

const title = 'Как восстановить удаленные заказы и товары в МоемСкладе';
const description =
  'Как восстановить заказ или товар в МоемСкладе, где найти архив товаров, сколько хранятся удаленные документы и когда данные уже не вернуть.';
const ogTitle = 'Как восстановить удаленные данные в МоемСкладе';
const ogDescription =
  'Чем архив отличается от удаления, как вернуть заказ из Корзины и почему Excel-выгрузка не заменяет полноценный backup.';
const canonicalPath = '/kak-vosstanovit-udalennye-zakazy-tovary-moysklad/';
const publishedDate = '2026-09-08T00:00:00+03:00';
const modifiedDate = '2026-09-22T00:00:00+03:00';
const authorName = companyInfo.editorial.defaultAuthor;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const cleanerHref = `${base}${cleanerProductPath.slice(1)}`;
const siteRoot = new URL(base, import.meta.env.SITE);
const homeUrl = siteRoot.toString();
const blogUrl = new URL('blog/', siteRoot).toString();
const articleUrl = new URL('kak-vosstanovit-udalennye-zakazy-tovary-moysklad/', siteRoot).toString();
const productUrl = `${base}backup-moysklad/`;
const imageAlt =
  'Схема резервного копирования заказов и товаров МоегоСклада с историей версий и двумя сценариями восстановления';
const ogImage = new URL(backupRecoveryImage.src, siteRoot).toString();

const titleParts = [
  { text: 'Как восстановить ' },
  { text: 'удаленные заказы и товары', accent: true },
  { text: ' в МоемСкладе' },
];

const breadcrumbs = [
  { label: 'Главная', href: base },
  { label: 'Блог', href: `${base}blog/` },
  { label: 'Восстановление данных в МоемСкладе' },
];

const sourceLinks = [
  {
    label: 'Корзина — Служба поддержки МоегоСклада',
    href: 'https://support.moysklad.ru/hc/ru/%D0%B7%D0%BD%D0%B0%D0%BA%D0%BE%D0%BC%D1%81%D1%82%D0%B2%D0%BE%20%D1%81%20%D1%81%D0%B5%D1%80%D0%B2%D0%B8%D1%81%D0%BE%D0%BC/%D0%B8%D0%BD%D1%82%D0%B5%D1%80%D1%84%D0%B5%D0%B9%D1%81/%D0%BA%D0%BE%D1%80%D0%B7%D0%B8%D0%BD%D0%B0',
  },
  {
    label: 'Удаление и восстановление документов — Служба поддержки МоегоСклада',
    href: 'https://support.moysklad.ru/hc/ru/articles/203055266',
  },
  {
    label: 'Архив — Служба поддержки МоегоСклада',
    href: 'https://support.moysklad.ru/hc/ru/%D0%B7%D0%BD%D0%B0%D0%BA%D0%BE%D0%BC%D1%81%D1%82%D0%B2%D0%BE%20%D1%81%20%D1%81%D0%B5%D1%80%D0%B2%D0%B8%D1%81%D0%BE%D0%BC/%D0%B8%D0%BD%D1%81%D1%82%D1%80%D1%83%D0%BC%D0%B5%D0%BD%D1%82%D1%8B/%D0%B0%D1%80%D1%85%D0%B8%D0%B2',
  },
  {
    label: 'Аудит — Служба поддержки МоегоСклада',
    href: 'https://support.moysklad.ru/hc/ru/%D0%B7%D0%BD%D0%B0%D0%BA%D0%BE%D0%BC%D1%81%D1%82%D0%B2%D0%BE%20%D1%81%20%D1%81%D0%B5%D1%80%D0%B2%D0%B8%D1%81%D0%BE%D0%BC/%D0%B8%D0%BD%D1%81%D1%82%D1%80%D1%83%D0%BC%D0%B5%D0%BD%D1%82%D1%8B/%D0%B0%D1%83%D0%B4%D0%B8%D1%82',
  },
  {
    label: 'Экспорт товаров в Excel — Служба поддержки МоегоСклада',
    href: 'https://support.moysklad.ru/hc/ru/%D1%82%D0%BE%D0%B2%D0%B0%D1%80%D1%8B%20%D0%B8%20%D1%81%D0%BA%D0%BB%D0%B0%D0%B4%D1%8B/%D0%B8%D0%BC%D0%BF%D0%BE%D1%80%D1%82%20%D0%B8%20%D1%8D%D0%BA%D1%81%D0%BF%D0%BE%D1%80%D1%82/%D1%8D%D0%BA%D1%81%D0%BF%D0%BE%D1%80%D1%82_%D1%82%D0%BE%D0%B2%D0%B0%D1%80%D0%BE%D0%B2_%D0%B2_excel',
  },
  {
    label: 'JSON API МоегоСклада',
    href: 'https://dev.moysklad.ru/doc/api/remap/1.2/',
  },
];

const recoveryRows = [
  ['Товар перенесен в архив', 'Да', 'Найти через фильтр и извлечь из архива'],
  ['Заказ удален менее 7 дней назад', 'Да, если Корзина была включена', 'Восстановить документ из Корзины'],
  ['Заказ удален более 7 дней назад', 'Не через Корзину', 'Искать данные во внешних системах или копиях'],
  ['Товар действительно удален', 'Штатно — нет', 'Воссоздать новый объект по сохраненным данным'],
  ['Есть только Excel-выгрузка', 'Частично', 'Вернуть поля, но не исходную системную сущность'],
];

const backupRows = [
  ['Основная задача', 'Сохранить табличный состав выгрузки', 'Сохранять выбранные сущности и их состояния'],
  ['Периодичность', 'Зависит от ручного регламента', 'Запускается автоматически по расписанию'],
  ['История изменений', 'Только отдельные сохраненные файлы', 'Можно хранить последовательность версий'],
  ['Связи', 'Обычно требуют ручной реконструкции', 'Можно сохранять вместе с идентификаторами и контекстом'],
  ['Восстановление', 'Импорт или ручное создание', 'Контролируемое создание и сверка по правилам API'],
];

const firstActions = [
  {
    title: 'Проверить архив и Корзину',
    description: 'Не создавайте новый объект, пока не исключили штатное восстановление существующего.',
  },
  {
    title: 'Установить время и масштаб удаления',
    description: 'Для документов важны семидневное окно Корзины и количество затронутых записей.',
  },
  {
    title: 'Посмотреть Аудит',
    description: 'Найдите пользователя, импорт, синхронизацию или массовую операцию, после которой исчезли данные.',
  },
  {
    title: 'Остановить источник повторных изменений',
    description: 'При необходимости временно приостановите интеграцию или ограничьте права на удаление.',
  },
  {
    title: 'Собрать внешние копии',
    description: 'Проверьте сайт, CRM, маркетплейсы, выгрузки, письма и резервные снимки.',
  },
  {
    title: 'Составить план восстановления и сверки',
    description: 'Отдельно определите, что можно вернуть, что придется создать заново и какие расчеты проверить.',
  },
];

const relatedArticles = backupRelatedArticles.map((article) => ({
  ...article,
  href: `${base}${article.hrefPath}`,
}));

const faqItems = [
  {
    question: 'Где находится архив товаров в МоемСкладе?',
    answer:
      'Откройте «Товары → Товары и услуги», затем в фильтре выберите «Только архивные» или «Все». Архив — это состояние объекта, а не отдельная папка: такие позиции отмечены серым цветом и буквой «А».',
  },
  {
    question: 'Как восстановить товар из архива?',
    answer:
      'Отобразите архивные товары, отметьте нужную позицию и выберите «Изменить → Извлечь из архива». Это же действие доступно в карточке товара.',
  },
  {
    question: 'Как восстановить удаленный заказ в МоемСкладе?',
    answer:
      'Если Корзина была включена и семь дней еще не прошли, откройте «Моя компания → Корзина», выберите заказ и нажмите «Восстановить». После этого проверьте проведение документа и связанные расчеты.',
  },
  {
    question: 'Можно ли восстановить заказ через месяц после удаления?',
    answer:
      'Из встроенной Корзины — нет: документы хранятся в ней семь дней. Состав заказа можно искать в интернет-магазине, CRM, маркетплейсе, отправленных документах, Excel-выгрузке или внешней резервной копии, а затем аккуратно реконструировать.',
  },
  {
    question: 'Можно ли восстановить полностью удаленный товар?',
    answer:
      'Штатного восстановления удаленной карточки товара МойСклад не предусматривает. При наличии экспорта или другой копии можно создать новый товар с теми же реквизитами, но для системы это будет новый объект.',
  },
  {
    question: 'Почему Excel-экспорт не считается полноценным бэкапом?',
    answer:
      'Excel хорошо сохраняет поля одной выгрузки, но обычно не содержит всю систему связей, историю версий и состояние разных сущностей на один момент. Он помогает реконструировать данные, но не всегда позволяет восстановить процесс целиком.',
  },
  {
    question: 'Как узнать, кто удалил заказ?',
    answer:
      'Проверьте раздел «Моя компания → Аудит». В нем фиксируются создание, изменение и удаление документов, а фильтры позволяют найти действия конкретного пользователя или определенный тип операции.',
  },
  {
    question: 'Старые товары лучше удалять или архивировать?',
    answer:
      'Если позиция просто вышла из ассортимента, безопаснее архивировать ее. Карточка и старые документы сохранятся, а товар можно будет вернуть в работу без создания новой сущности.',
  },
];

const structuredData = createArticleStructuredData({
  title,
  description,
  articleUrl,
  publishedDate,
  modifiedDate,
  publisherUrl: homeUrl,
  author: authorName,
  breadcrumbs: [
    { name: companyInfo.brandName, item: homeUrl },
    { name: 'Блог', item: blogUrl },
    { name: title, item: articleUrl },
  ],
  faqItems,
});
---

<ArticleLayout
  {title}
  {titleParts}
  {description}
  {canonicalPath}
  {structuredData}
  {ogTitle}
  {ogDescription}
  {ogImage}
  ogImageAlt={imageAlt}
  category="МойСклад"
  intro="Разбираемся, чем архив отличается от удаления, как вернуть документ из Корзины и в каких случаях данные придется восстанавливать из внешней копии."
  {breadcrumbs}
  author={authorName}
  publishedTime={publishedDate}
  modifiedTime={modifiedDate}
>
  <Fragment slot="quick-answer">
    <p>
      Удаленный заказ можно вернуть из <strong>Корзины</strong>, если она была включена и с
      момента удаления прошло не более семи дней. После восстановления документ нужно снова
      провести, если он должен влиять на остатки.
    </p>
    <p>
      Архивный товар возвращается через <strong>Товары → Товары и услуги → Фильтр</strong> и
      команду <strong>Извлечь из архива</strong>. Для полностью удаленной карточки такого
      штатного пути нет.
    </p>
    <p>
      Если встроенного окна уже недостаточно, данные ищут во внешних системах, выгрузках или
      резервных копиях и составляют контролируемый план реконструкции.
    </p>
  </Fragment>

  <p data-article-lead>
    Когда из МоегоСклада пропадает заказ или товар, первая реакция обычно одна: срочно создать
    всё заново. Но одинаково выглядящие потери могут означать три разных состояния — архив,
    Корзину документов или окончательное удаление. От правильной диагностики зависит, вернется
    ли прежний объект со своей историей или в системе появится только похожая новая карточка.
  </p>

  <aside data-article-note>
    <strong>Архив, Корзина и бэкап решают разные задачи</strong>
    <p>
      Архив временно выводит объект из работы, Корзина дает семь дней на отмену удаления
      документа, а внешний бэкап хранит данные и версии дольше. Ни один из этих механизмов не
      заменяет остальные полностью.
    </p>
  </aside>

  <section aria-labelledby="what-can-be-recovered">
    <h2 id="what-can-be-recovered">
      Что в МоемСкладе <span data-heading-accent>реально можно восстановить</span>
    </h2>
    <p>
      Начните не с поиска универсальной кнопки, а с определения типа объекта и произошедшего
      действия. Товары и заказы живут в разных частях системы: товар можно архивировать, а
      удаленный заказ некоторое время хранится как документ в Корзине. Поэтому и пути возврата
      у них разные.
    </p>
    <DataTable
      label="Варианты восстановления данных в МоемСкладе"
      columns={['Что произошло', 'Можно вернуть', 'Что делать']}
      rows={recoveryRows}
      rowHeaders
    />
    <p>
      <strong>Условная ситуация:</strong> после чистки каталога менеджер не находит товар
      и собирается импортировать его из старого Excel. Если карточка лишь в архиве, импорт
      может создать дубль. Сначала проверьте архив: вернуть прежнюю карточку и создать
      похожую новую — разные результаты для учёта и интеграций.
    </p>
  </section>

  <section aria-labelledby="first-actions">
    <h2 id="first-actions">
      Что делать <span data-heading-accent>сразу после обнаружения удаления</span>
    </h2>
    <p>
      Хаотичное создание новых карточек затрудняет сверку и может добавить дубли. Сначала
      сохраните текущее состояние и пройдите короткую последовательность диагностики.
    </p>
    <Checklist items={firstActions} label="Первые действия после удаления данных в МоемСкладе" />
    <p>
      Только после этого стоит запускать импорт или массовое создание через API. Чем яснее
      известны точка потери и зависимые системы, тем меньше риск, что восстановление породит
      вторую ошибку.
    </p>
  </section>

  <section aria-labelledby="archive-vs-delete">
    <h2 id="archive-vs-delete">
      <span data-heading-accent>Архив и удаление</span> — не одно и то же
    </h2>
    <p>
      Архив сохраняет товар в системе, но скрывает его из обычной работы. Архивную позицию
      нельзя добавить в новую закупку или продажу, она не показывается в складских остатках, а
      в старых документах отмечается как архивная. Сами существующие документы при этом не
      исчезают.
    </p>
    <p>
      Такая логика подходит товарам, которые сняты с продажи, временно не закупаются или
      мешают в разросшемся справочнике. Если позиция вернется в ассортимент, достаточно извлечь
      прежнюю карточку из архива — вместе с ней сохранится контекст прошлой работы.
    </p>
    <p>
      При настоящем удалении рабочая сущность пропадает. Даже если позже создать товар с тем же
      названием, артикулом и штрихкодом, это будет новая карточка. Интеграции и старые связи не
      обязаны автоматически распознать в ней прежний объект.
    </p>
  </section>

  <section aria-labelledby="find-archived-product">
    <h2 id="find-archived-product">
      Где найти и как вернуть <span data-heading-accent>архивный товар</span>
    </h2>
    <p>
      Отдельной папки «Архив товаров» в интерфейсе нет. Откройте
      <strong> Товары → Товары и услуги</strong>, затем фильтр и в параметре отображения выберите
      <strong> Только архивные</strong> либо <strong>Все</strong>. После поиска архивные позиции
      будут выделены серым цветом и буквой «А».
    </p>
    <p>
      Отметьте нужный товар, нажмите <strong>Изменить → Извлечь из архива</strong>. То же действие
      доступно внутри карточки. В этом сценарии восстанавливать данные не приходится: система
      просто возвращает существующий объект в обычную работу.
    </p>

    <ArticleFigure
      src={backupRecoveryImage}
      alt={imageAlt}
      caption="Резервная копия сохраняет версии данных, а восстановление разделяет простой возврат документа и контролируемое воссоздание удаленной сущности."
    />
  </section>

  <section aria-labelledby="restore-order">
    <h2 id="restore-order">
      Как восстановить <span data-heading-accent>удаленный заказ</span>
    </h2>
    <p>
      Заказ покупателя относится к документам, поэтому его нужно искать не в архиве товаров, а
      в Корзине. Если функция была заранее включена, перейдите в
      <strong> Моя компания → Корзина</strong>, отметьте заказ и выберите
      <strong> Изменить → Восстановить</strong>. Документ также можно открыть и восстановить из
      его карточки.
    </p>
    <p>
      Корзина хранит удаленные документы семь дней, после чего они удаляются автоматически.
      Ее можно очистить и раньше вручную. Поэтому дата события здесь принципиальна: заказ,
      удаленный час назад, и заказ, пропавший месяц назад, требуют совершенно разных действий.
    </p>
    <p>
      Если документ только что удалили, интерфейс может сразу предложить отменить операцию.
      Если момент уже упущен, но семь дней еще не прошли, Корзина остается самым надежным путем:
      она возвращает именно прежний документ, а не его приблизительную копию.
    </p>
  </section>

  <section aria-labelledby="older-than-seven-days">
    <h2 id="older-than-seven-days">
      Что делать, если прошло <span data-heading-accent>больше семи дней</span>
    </h2>
    <p>
      После истечения срока Корзины встроенное восстановление недоступно. Однако сведения о
      заказе могли остаться в интернет-магазине, CRM, личном кабинете маркетплейса, службе
      доставки, базе интеграции, отправленной клиенту печатной форме или старой выгрузке.
    </p>
    <p>
      Внешний источник помогает узнать состав, дату, покупателя, цены и комментарий, но не
      превращает новый документ в исходный. При создании заново нужно проверить организацию,
      склад, позиции, статус и связанные документы, а затем убедиться, что новый заказ не
      задвоит резерв, оплату или отгрузку.
    </p>

    <InlineConsultation
      variant="product"
      title="После восстановления — порядок в CRM"
      description="После восстановления данных и проверки обмена можно спланировать очистку ненужных лидов и сделок в Битрикс24. Посмотрите возможности и демо CRM Cleaner. Приложение не восстанавливает данные МоегоСклада; удаление пока доступно только на демонстрационных данных."
      href={cleanerHref}
      actionLabel="Посмотреть CRM Cleaner"
    />
  </section>

  <section aria-labelledby="deleted-product">
    <h2 id="deleted-product">
      Можно ли вернуть <span data-heading-accent>полностью удаленный товар</span>
    </h2>
    <p>
      Сначала еще раз проверьте фильтр архивных позиций. Если карточки там нет и Аудит
      подтверждает удаление, штатного способа восстановить ее документация МоегоСклада не
      предусматривает. В официальной инструкции по ошибкам Кассы для такого случая прямо
      рекомендуется архивировать товары вместо удаления.
    </p>
    <p>
      Оставшийся путь — воссоздание. Реквизиты можно взять из Excel, интернет-магазина,
      учетного отчета или API-копии. Наименование и артикул будут прежними, но созданная карточка
      получит собственную системную идентичность. Это особенно важно для касс, сайта и других
      интеграций, которые связывают данные не по видимому названию, а по идентификаторам.
    </p>
  </section>

  <section aria-labelledby="excel-backup">
    <h2 id="excel-backup">
      Почему Excel-выгрузка — <span data-heading-accent>еще не полноценный бэкап</span>
    </h2>
    <p>
      Экспорт товаров в Excel полезен: он сохраняет поля справочника, включая архивные
      позиции, и позволяет значительно быстрее воссоздать каталог после ошибки. Для небольшой
      базы регулярная выгрузка уже лучше, чем единственная копия данных внутри сервиса.
    </p>
    <p>
      Но файл обычно отвечает на вопрос «что было в этой таблице», а не «как выглядела вся
      система в конкретный момент». В нем может не хватать документов, позиций, служебных
      идентификаторов, взаимных связей и истории версий. Поэтому импорт возвращает набор полей,
      но не гарантирует восстановление прежнего бизнес-процесса.
    </p>
    <DataTable
      label="Сравнение Excel-выгрузки и резервного копирования через API"
      columns={['Критерий', 'Excel-выгрузка', 'Внешний бэкап через API']}
      rows={backupRows}
      rowHeaders
    />
  </section>

  <section aria-labelledby="audit">
    <h2 id="audit">
      <span data-heading-accent>Аудит показывает причину</span>, но не возвращает данные
    </h2>
    <p>
      В разделе <strong>Моя компания → Аудит</strong> фиксируются создание, изменение и
      удаление документов, входы, синхронизации, импорт и экспорт. Фильтры помогают восстановить
      хронологию: кто выполнил действие, когда оно произошло и не было ли оно частью массовой
      операции.
    </p>
    <p>
      Это важная часть расследования, но не резервная копия. Аудит отвечает на вопрос «что
      произошло», а бэкап — «какие данные были до события». Для надежной защиты нужны обе
      возможности: без истории сложно устранить причину, а без копии нечем восстанавливать
      результат.
    </p>
  </section>

  <section aria-labelledby="after-restoration">
    <h2 id="after-restoration">
      Что проверить <span data-heading-accent>после восстановления документа</span>
    </h2>
    <p>
      Возвращение заказа или приемки в список еще не означает, что учет полностью пришел в
      прежнее состояние. Официальная инструкция обращает внимание: восстановленный документ,
      который должен влиять на остатки, нужно снова провести. Иначе карточка уже видна, а
      складской расчет остается другим.
    </p>
    <p>
      Затем проверьте связанные документы, остатки, резервы и взаиморасчеты. Если часть цепочки
      пришлось создавать заново, отдельно исключите дубли. Для интегрированного контура полезна
      контрольная сверка в интернет-магазине, CRM или кассе: восстановление внутри одной системы
      не всегда автоматически исправляет состояние остальных.
    </p>
    <p>
      В этой точке помогает и наша статья о том, <a href={`${base}kak-snyat-rezervy-moysklad/`}>
      как найти и безопасно снять зависшие резервы в МоемСкладе</a> после изменений в заказах.
    </p>
  </section>

  <section aria-labelledby="backup-design">
    <h2 id="backup-design">
      Как устроить <span data-heading-accent>резервное копирование МоегоСклада</span>
    </h2>
    <p>
      Внешний контур через API может регулярно получать выбранные справочники и документы,
      сохранять их снимки и строить историю версий. Для товара важны реквизиты, цены,
      характеристики, дополнительные поля и идентификаторы; для заказа — контрагент,
      организация, склад, позиции, суммы, статус и связи.
    </p>
    <p>
      Ценность дает не объем выгрузки сам по себе, а версионность. Если вчера в базе было 14 820
      товаров, а сегодня осталось 12 400, система может заметить аномалию и показать состояние
      до массового изменения. Тогда поиск начинается не через несколько недель, когда товара не
      хватает в старом заказе, а сразу после события.
    </p>
    <p>
      При этом честный механизм восстановления должен учитывать ограничения API. Одни данные
      можно вернуть автоматически, другие — только подготовить для контролируемого воссоздания
      и ручной сверки. Поэтому до запуска фиксируют состав копии, срок хранения, частоту снимков,
      доступные версии и проверяемый результат восстановления.
    </p>
  </section>

  <section aria-labelledby="protection-strategy">
    <h2 id="protection-strategy">
      Практичная <span data-heading-accent>стратегия защиты данных</span>
    </h2>
    <p>
      Небольшому аккаунту стоит начать со встроенных возможностей: включить Корзину, ограничить
      права на удаление, архивировать неактуальные товары и регулярно выгружать критичные
      справочники. Аудит поможет быстро разбирать подозрительные изменения и проверять работу
      сотрудников и интеграций.
    </p>
    <p>
      Когда через МойСклад проходят тысячи заказов и несколько внешних систем, семидневного
      окна и ручного Excel уже мало. Тогда внешний бэкап становится вторым уровнем защиты:
      автоматические снимки, история версий, уведомления об аномалиях, выбор точки восстановления
      и контролируемый возврат данных.
    </p>
  </section>

  <section aria-labelledby="summary">
    <h2 id="summary">
      Когда восстановление <span data-heading-accent>можно считать завершённым</span>
    </h2>
    <p>
      Проверьте один восстановленный заказ от начала до конца: покупателя, позиции, суммы,
      связанные документы и резерв. Затем сравните его с данными сайта или CRM, если они
      участвуют в процессе. Появление заказа в списке — только первая проверка.
    </p>
    <p>
      Зафиксируйте, какие данные удалось вернуть, какие пришлось создать заново и какие связи
      проверить вручную. После этого устраните причину удаления и проверьте восстановление
      из резервной копии на тестовых данных. Так следующий инцидент начнётся с известной
      процедуры, а не с поиска случайно сохранившегося файла.
    </p>
  </section>

