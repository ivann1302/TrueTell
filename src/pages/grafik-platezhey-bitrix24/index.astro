---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import Checklist from '../../components/editorial/checklist.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import planImage from '../../images/articles/payment-schedule-three-stages.png';
import templateImage from '../../images/articles/payment-schedule-template-076.png';
import fieldImage from '../../images/articles/bitrix24-money-field-type-official.jpg';
import reminderImage from '../../images/articles/bitrix24-activity-deadline-official.jpg';

const article = getArticle('grafik-platezhey-bitrix24/');
const { title, description } = article;
const canonicalPath = `/${article.hrefPath}`;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const templatePath = `${base}downloads/TrueTell_Payment_Schedule_Template_076_2026-10-22.xlsx`;
const imageAlt = 'Учебный график на 120 тысяч рублей: аванс 36 тысяч 14 октября, второй этап 48 тысяч 21 октября и завершение 36 тысяч 28 октября';
const ogImage = new URL(planImage.src, siteRoot).toString();
const titleParts = [{ text: 'Как составить ' }, { text: 'график платежей клиента', accent: true }, { text: ' в Битрикс24' }];
const sourceLinks = [
  { label: 'Пользовательские поля в CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/22048980/' },
  { label: 'Карточка CRM: возможности и настройки — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/22804914/' },
  { label: 'Таймлайн в CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/23960160/' },
  { label: 'Универсальное дело в CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/21064046/' },
  { label: 'Персональные напоминания о делах — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/18942844/' },
];
const planRows = [
  ['Э1 — аванс', '14.10.2026', '30 %', '36 000 ₽'],
  ['Э2 — промежуточный этап', '21.10.2026', '40 %', '48 000 ₽'],
  ['Э3 — завершение', '28.10.2026', '30 %', '36 000 ₽'],
  ['Итого', 'Три отдельных срока', '100 %', '120 000 ₽'],
];
const fieldRows = [
  ['Контролируемый этап', 'Строка', 'Э1 — аванс'],
  ['Дата этапа', 'Дата', '14.10.2026'],
  ['Плановая сумма этапа', 'Деньги', '36 000 ₽; RUB'],
  ['Версия графика', 'Строка', 'v1'],
];
const changes = [
  ['Э1 — аванс', '14.10.2026', '14.10.2026', '36 000 ₽'],
  ['Э2 — промежуточный этап', '21.10.2026', '23.10.2026', '48 000 ₽'],
  ['Э3 — завершение', '28.10.2026', '28.10.2026', '36 000 ₽'],
];
const checks = [
  { title: 'Одна сделка и одна валюта', description: 'У графика есть ID сделки, основание и версия. Валюта этапов совпадает с валютой согласованных условий.' },
  { title: 'Сумма этапов сходится', description: 'В учебном примере 36 000 + 48 000 + 36 000 = 120 000 ₽. Округления и изменения стоимости объяснены отдельно.' },
  { title: 'Каждый этап можно найти', description: 'Для него указаны идентификатор, сумма и согласованная дата либо условие, после которого дату определяют.' },
  { title: 'План, факт и поручения разделены', description: 'Подтверждённое поступление не заменяется закрытым делом; плановая сумма не выдаётся за остаток к оплате.' },
  { title: 'Изменения можно сверить', description: 'Сохранены исходный план и текущая версия, причина переноса, согласование и обновлённое дело сотруднику.' },
];
const faqItems = [
  { question: 'Есть ли готовый шаблон графика платежей в Excel?', answer: 'Да. В разделе «Скачайте шаблон графика платежей» доступен файл .xlsx для одной сделки: до 20 этапов и 50 строк журнала в RUB. Он содержит условный пример и формулы остатка и просрочки на выбранную дату. Замените учебные данные своими; автоматической связи с CRM или банком в файле нет.' },
  { question: 'Как учесть одно поступление, которое покрывает несколько этапов?', answer: 'Распределите его сумму по отдельным строкам журнала с разными ID записей и нужными ID этапов. В основании укажите один и тот же источник. Сумма распределённых частей должна совпадать с подтверждённым поступлением; полную сумму платежа в каждой строке повторять нельзя.' },
  { question: 'Можно ли записать весь график одной датой оплаты?', answer: 'Одна дата подходит для одного срока. Если клиент платит по нескольким этапам, храните полный план с отдельными суммами и датами. В карточке можно дополнительно показать один контролируемый этап, но эта краткая запись не заменяет остальные обязательства.' },
  { question: 'Почему нельзя вести два отдельных списка: даты и суммы?', answer: 'После добавления или удаления значения списки могут перестать соответствовать друг другу. У каждого этапа нужна устойчивая связь между идентификатором, датой и суммой. Две независимые последовательности эту связь сами по себе не обеспечивают.' },
  { question: 'Что делать, если платёж назначен после приёмки работ, а дата ещё неизвестна?', answer: 'Запишите условие и сумму этапа, отметьте дату как неопределённую. Назначьте ответственному действие по проверке условия. Когда основание наступит и срок будет определён по согласованным условиям, внесите дату; произвольную дату в денежный план не подставляйте.' },
  { question: 'Нужно ли переносить все платежи, если клиент задержал один этап?', answer: 'Проверьте согласованные условия. В нашем учебном примере перенесли только второй этап, остальные даты сохранили. Если сроки других этапов зависят от него, изменения надо согласовать и отдельно отразить в новой версии графика.' },
  { question: 'Доказывает ли завершённое дело, что деньги поступили?', answer: 'Нет. Дело описывает действие сотрудника: связаться с клиентом, проверить оплату или получить документ. Подтверждённые поступления учитывайте отдельно по принятому в компании источнику.' },
  { question: 'Можно ли сейчас создать график через приложение TrueTell?', answer: 'На 25 октября 2026 года на двух тестовых порталах проверено сохранение графиков. На одном из них проверены ручное поступление, исправление и отмена, отчёт, календарь поступлений и выгрузка двух CSV; на другом — разграничение доступа. Приложение ещё не выпущено в Маркете для самостоятельной установки. Excel-шаблон в статье работает отдельно от приложения и CRM.' },
];
const relatedArticles = getRelatedArticles(article.hrefPath).map((item) => ({
  ...item,
  description: item.summaryDescription ?? item.description,
  href: `${base}${item.hrefPath}`,
}));
const structuredData = createArticleStructuredData({
  articleType: 'Article', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  articleSection: article.category,
  breadcrumbs: [
    { name: 'Главная', item: siteRoot.toString() },
    { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() },
    { name: title, item: articleUrl },
  ], faqItems,
});
---

<ArticleLayout {title} {titleParts} {description} {canonicalPath}
  category={article.category}
  intro="Согласуйте этапы оплаты по одной сделке, сохраните даты и суммы, назначьте проверку менеджеру и учтите перенос срока без потери исходного плана."
  {structuredData} ogTitle={article.seoTitle ?? title} ogDescription={description}
  {ogImage} ogImageAlt={imageAlt} author={authorName}>
  <Fragment slot="quick-answer">
    <p><strong>Для каждого этапа оплаты запишите сумму, валюту и согласованный срок либо условие его определения. Проверьте итог и сохраните полный план с ID сделки и версией.</strong></p>
    <p><a href={templatePath} download>Скачать шаблон графика платежей в Excel (.xlsx)</a>: этапы, журнал поступлений и расчёт остатка на выбранную дату. Внутри — учебный пример одной сделки.</p>
    <p>В CRM можно вручную показать контролируемый этап в пользовательских полях и назначить дело сотруднику. При переносе срока сохраняйте исходный план. Эти записи не подтверждают поступление денег и сами не рассчитывают оплаты.</p>
  </Fragment>

  <p data-article-lead>Клиент платит аванс, затем переводит деньги за промежуточный этап и закрывает остаток после завершения работ. Одна дата в сделке покажет лишь часть договорённостей. Три платежа удобно собрать в один план, а в карточку CRM вынести ближайший этап и историю изменений.</p>

  <section aria-labelledby="agree-payment-stages">
    <h2 id="agree-payment-stages">Начните с <span data-heading-accent>условий оплаты</span></h2>
    <p>Откройте нужную сделку и сверьте её ID, клиента, сумму и валюту с действующими договорённостями. Для каждого платежа определите, за что он вносится и когда его ожидают. Это могут быть конкретные даты или условия: например, после согласованной приёмки этапа. Пока условие не выполнено и дата не определена, так и отметьте её в плане.</p>
    <p>Назовите этапы так, чтобы их можно было различить после переноса срока: «Э1 — аванс», «Э2 — промежуточный этап», «Э3 — завершение». Не связывайте идентификатор только с датой. Если 21 октября заменится на 23-е, это останется тот же Э2.</p>
    <p>Процентную долю сначала переведите в сумму в валюте графика. Затем проверьте итог всех этапов. Для неделимой на выбранные доли суммы заранее определите округление: итог графика должен соответствовать согласованной стоимости, а не отличаться от неё на несколько копеек.</p>
  </section>

  <section aria-labelledby="payment-plan-example">
    <h2 id="payment-plan-example">Пример: <span data-heading-accent>120 000 ₽ в три этапа</span></h2>
    <p>Возьмём учебную сделку на 120 000 ₽ в RUB с долями 30 %, 40 % и 30 %. Для примера считаем, что все три даты уже согласованы. Ниже планируемые обязательства клиента; фактические поступления здесь не учитываются. На телефоне таблица прокручивается вправо.</p>
    <DataTable label="Учебный график платежей одной сделки, все суммы в RUB" columns={['Этап', 'Плановая дата', 'Доля', 'Плановая сумма']} rows={planRows} rowHeaders />
    <ArticleFigure src={planImage} eager fullSize alt={imageAlt}
      caption="Учебная инфографика TrueTell: три самостоятельных срока, общая сумма 120 000 ₽. Даты 2026 года и значения условные. Это пример плана, а не экран приложения и не результат клиента." />
    <p>Такой график отвечает, сколько и когда клиент должен оплатить по согласованному плану. Если нужно сверить уже полученные суммы, переходите к <a href={`${base}chastichnaya-oplata-bitrix24/`}>учёту частичной оплаты по сделке</a>. Плановые этапы и подтверждённые поступления храните отдельно, связывая их по сделке и этапу, где это возможно.</p>
  </section>

  <section aria-labelledby="download-payment-template">
    <h2 id="download-payment-template">Скачайте <span data-heading-accent>шаблон графика платежей</span></h2>
    <p><a href={templatePath} download>Скачать график платежей и журнал поступлений (.xlsx)</a>. Файл рассчитан на одну сделку в RUB: до 20 этапов и 50 строк журнала, суммы с точностью до копейки. Он не подключается к CRM или банку и не отправляет напоминания.</p>
    <p>На листе «График» укажите ID сделки, согласованную сумму, дату среза и версию плана. Затем заполните синие ячейки этапов. На листе «Журнал» замените учебные записи подтверждёнными поступлениями: дата, этап, распределённая сумма, тип и основание. Формулы не заменяйте; строки ниже указанного лимита в расчёт не входят.</p>
    <ArticleFigure src={templateImage} fullSize
      alt="Лист скачиваемого Excel-шаблона: план 120 тысяч рублей, распределено 48 тысяч, остаток 72 тысячи и просрочка 36 тысяч на 22 октября 2026 года"
      caption="Снимок листа «График» из приложенного файла TrueTell, а не интерфейс приложения Битрикс24. Все данные учебные. Даты этапов совпадают с примером выше; факты для расчёта добавлены в журнал." />
    <p>В учебном журнале платёж 42 000 ₽ от 14 октября разделён на две строки: 36 000 ₽ на Э1 и 6 000 ₽ на Э2. Ещё 6 000 ₽ от 20 октября относятся к Э2. На дату среза 22 октября распределено 48 000 ₽, осталось 72 000 ₽. Из этого остатка 36 000 ₽ просрочены по Э2, а 36 000 ₽ по Э3 ожидаются 28 октября. Такое разбиение помогает не посчитать весь остаток просрочкой и не записать один платёж дважды.</p>
    <p>Срок на дату среза отмечается как «Сегодня»; просрочка начинается для более ранних сроков. Остаток без определённой даты показан отдельно. Записи журнала после среза не учитываются в его итогах. Если строка заполнена не полностью, указан неизвестный этап или суммы не сходятся, появится «ПРОВЕРИТЬ» — сначала устраните причину.</p>
    <p>Возврат и исправление вносите отдельными строками с основанием и ссылкой на исходную запись. Файл проверяет ID строк, но не определяет дубли банковских операций и не подтверждает правильность распределения вместо сотрудника. Перед изменением договорённостей сохраните отдельную копию: дата среза не восстанавливает старую версию плана. Подробный порядок сверки — в <a href={`${base}chastichnaya-oplata-bitrix24/`}>статье о частичной оплате</a>.</p>
  </section>

  <section aria-labelledby="save-full-payment-plan">
    <h2 id="save-full-payment-plan">Сохраните <span data-heading-accent>полный график в сделке</span></h2>
    <p>Для небольшого числа этапов можно начать с текстового плана в таймлайне. Откройте карточку сделки, выберите «Комментарий», укажите версию графика и перенесите строки с идентификаторами, датами, суммами и валютой. Добавьте ссылку или указание на основание: где зафиксированы условия и кто их согласовал. <a href={sourceLinks[2].href} target="_blank" rel="noopener noreferrer">Возможности таймлайна CRM</a>.</p>
    <p>Если план ведётся в отдельной таблице, сохраните файл или ссылку на него в сделке по принятому порядку компании. Выберите одно место для действующей версии. Несколько разных «актуальных» таблиц у менеджера, руководителя и в переписке делают проверку ненадёжной.</p>
    <p>Комментарий или вложение помогают сохранить договорённости, но не создают отчёт по всем срокам и не пересчитывают суммы. Также такая запись не гарантирует неизменность истории: порядок хранения версий и доступы нужно организовать отдельно.</p>
  </section>

  <section aria-labelledby="payment-stage-fields">
    <h2 id="payment-stage-fields">Вынесите <span data-heading-accent>контролируемый этап в поля CRM</span></h2>
    <p>Чтобы сотруднику не искать нужную строку каждый раз, можно добавить краткую запись об одном этапе. Названия ниже предложены для этого процесса; это не готовые системные поля Битрикс24. В начале примера контролируем Э1 — аванс.</p>
    <DataTable label="Предлагаемые ручные поля для одного контролируемого этапа" columns={['Поле', 'Тип', 'Пример значения']} rows={fieldRows} rowHeaders />
    <p>Пользовательские поля создаёт администратор или сотрудник с правом изменять настройки CRM. В карточке выберите «Создать поле», задайте название и нужный тип, сохраните. После создания тип поля и признак множественности изменить нельзя — определите их заранее. <a href={sourceLinks[0].href} target="_blank" rel="noopener noreferrer">Официальная инструкция по полям</a>.</p>
    <ArticleFigure src={fieldImage} fullSize
      alt="Официальный экран создания пользовательского поля CRM: в списке типов доступны Дата и Деньги"
      caption="Неизменённый скриншот Поддержки24: в оригинале выбран тип «Строка», а в списке видны «Дата» и «Деньги». Наших полей графика на этом экране нет. Для срока выбираем «Дата», для суммы этапа — «Деньги»." />
    <p>Поля можно собрать в отдельный раздел карточки: внизу выберите «Создать раздел», назовите его и добавьте нужные поля. <a href={sourceLinks[1].href} target="_blank" rel="noopener noreferrer">Настройка разделов карточки CRM</a>.</p>
    <p>Эта краткая запись содержит только выбранный этап. «Плановая сумма этапа» — его исходное обязательство, а не автоматически рассчитанный остаток к получению. После проверки этапа сотрудник вручную выбирает следующий и обновляет поля по полному графику. Не удаляйте из исходного плана уже выполненные этапы.</p>
    <p>Если созданное поле понадобится передать в интеграцию, найдите его техническое имя по <a href="/kod-polya-bitrix24/">инструкции о кодах пользовательских полей Битрикс24</a>. Подпись в карточке и код для API — разные обозначения.</p>
  </section>

  <section aria-labelledby="payment-check-activity">
    <h2 id="payment-check-activity">Назначьте менеджеру <span data-heading-accent>проверку до срока</span></h2>
    <p>В таймлайне сделки выберите «Дело», заполните название и описание, задайте крайний срок, выберите сотрудника и сохраните. Например: «Э2 — проверить готовность оплаты 48 000 ₽» с проверкой 20 октября перед сроком 21 октября. Добавьте контекст: этап, плановую дату и где смотреть подтверждение. Это предложенное поручение, не название штатного сценария оплаты. <a href={sourceLinks[3].href} target="_blank" rel="noopener noreferrer">Как работает универсальное дело</a>.</p>
    <p>Установите срок явно: значение, предложенное CRM по умолчанию, может не соответствовать вашему графику. Колокольчик в незакрытом деле позволяет выбрать интервалы, за которые сработают счётчики. Это персональные напоминания сотруднику; сами по себе они не отправляют клиенту сообщение об оплате. <a href={sourceLinks[4].href} target="_blank" rel="noopener noreferrer">Настройка напоминаний о делах</a>.</p>
    <ArticleFigure src={reminderImage} fullSize
      alt="Подлинный экран Битрикс24: колокольчик в карточке дела и список интервалов персонального напоминания"
      caption="Оригинальный пример Поддержки24. Имена, номер сделки и даты относятся к документации, а не к нашему учебному графику. Колокольчик настраивает напоминание о деле; он не подтверждает получение денег." />
    <p>После звонка или проверки завершите выполненное действие. Если оплата ещё ожидается, оставьте соответствующее обязательство в графике и назначьте следующее действие. Для факта оплаты нужен отдельный согласованный источник; закрытая задача и сообщение «перевели» его не заменяют.</p>
  </section>

  <section aria-labelledby="reschedule-one-payment">
    <h2 id="reschedule-one-payment">При переносе срока <span data-heading-accent>сохраните исходный план</span></h2>
    <p>Предположим, согласовано изменение второго этапа: вместо 21 октября — 23 октября. Стоимость и остальные сроки не меняются. Сохраните v1 и создайте текущую версию v2; запишите дату изменения, причину, сотрудника и основание согласования. Если у других этапов есть зависимость от Э2, проверьте её отдельно.</p>
    <DataTable label="Учебное сравнение исходной и текущей версии графика: изменён только Э2" columns={['Этап', 'v1 — исходная дата', 'v2 — текущая дата', 'Сумма без изменения']} rows={changes} rowHeaders />
    <p>В карточке замените дату контролируемого этапа, если это Э2, и укажите v2. Снова выберите, какой этап требует ближайшего действия: порядок зависит от текущих сроков и подтверждённого состояния обязательств. Затем проверьте связанные дела — прежняя проверка могла быть назначена на 20 октября. Перенос одного срока не является основанием автоматически сдвигать весь график или считать деньги полученными.</p>
    <p>При поступлении части суммы не уменьшайте первоначальную сумму этапа так, будто такой была договорённость. Свяжите поступление с обязательством и отдельно определите непогашенную часть. Порядок сверки разобран в <a href={`${base}chastichnaya-oplata-bitrix24/`}>инструкции о частичных оплатах</a>; контроль уже наступивших сроков — в <a href={`${base}debitorskaya-zadolzhennost-bitrix24/`}>статье о дебиторской задолженности</a>.</p>
  </section>

  <section aria-labelledby="payment-schedule-verification">
    <h2 id="payment-schedule-verification">Проверьте график <span data-heading-accent>перед передачей в работу</span></h2>
    <Checklist items={checks} />
    <p>Если сумма сделки изменилась, сравните новую стоимость с текущим планом. Решите, какие будущие этапы пересчитываются по согласованным условиям, и сохраните отдельную версию. Уже подтверждённые поступления не меняются автоматически вместе с планом.</p>
    <InlineConsultation title="Нужен единый порядок работы с этапами оплаты?"
      description="Разберём, где хранить план, как связать его с CRM и подтверждёнными поступлениями и какие изменения требуется отслеживать."
      href={companyInfo.contacts.consultationUrl} actionLabel="Обсудить задачу" />
  </section>

  <section aria-labelledby="payment-schedule-product">
    <h2 id="payment-schedule-product">Когда нужна <span data-heading-accent>отдельная реализация</span></h2>
    <p>Ручной процесс подходит, пока сотрудник успевает поддерживать планы и проверять изменения. Если этапов много, сроки регулярно меняются или нужен общий список ожидаемых оплат, оцените инструмент, который сохраняет связь «сделка — этап — сумма — дата», версии и отдельно подтверждённый факт. Проверяйте эти возможности на своей рабочей поставке.</p>
    <p>TrueTell разрабатывает «График платежей» для Битрикс24. На 25 октября 2026 года в тестовых установках на двух порталах проверено сохранение графика. На первом портале также проверены ручное поступление с исправлением и отменой, общий отчёт, календарь поступлений и обе CSV; на втором — права доступа к сделкам и отчёту. <strong>Приложение ещё не опубликовано в Маркете</strong>, поэтому эти проверки не означают готовность к тиражному внедрению. Поступление в приложении не подтверждает движение денег в банке.</p>
    <p>Excel-шаблон выше — самостоятельный ручной инструмент. Данные из файла не синхронизируются с приложением или CRM автоматически.</p>
    <p>График одной сделки помогает работать с обязательствами клиента. Для оценки всех поступлений компании и будущих выплат нужен другой состав данных — подробнее в <a href={`${base}platezhnyy-kalendar-bitrix24/`}>сравнении календаря поступлений и финансового календаря</a>.</p>
  </section>

