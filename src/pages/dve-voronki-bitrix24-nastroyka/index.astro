---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { mcpProduct } from '../../config/products';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import boundaryImage from '../../images/articles/bitrix24-two-pipelines-boundary-134.png';
import handoffImage from '../../images/articles/bitrix24-two-pipelines-handoff-134.png';

const article = getArticle('dve-voronki-bitrix24-nastroyka/');
const { title, description } = article;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const relatedArticles = getRelatedArticles(article.hrefPath).map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const ogImage = new URL(boundaryImage.src, siteRoot).toString();
const imageAlt = 'Учебная схема: продажи заканчиваются договором, исполнение начинается с передачи заказа; у каждого процесса свои стадии и ответственный';
const faqItems = [
  { question: 'Когда в Битрикс24 нужны две воронки сделок?', answer: 'Когда у процессов разные ответственные, этапы и правила доступа, а передача между командами имеет чёткий момент. Если меняется только исполнитель одной стадии, сначала проверьте, достаточно ли одной воронки. Для работы, которая вообще не является продажей, стоит отдельно рассмотреть задачи или смарт-процесс.' },
  { question: 'Чем копирование сделки отличается от перемещения между воронками?', answer: 'При копировании туннель создаёт вторую сделку в целевой воронке, исходная остаётся в первой. При перемещении исходная сделка уходит из первой воронки в целевую. Перед выбором решите, нужна ли отдельная запись о продаже и как считать сделки в отчётах.' },
  { question: 'Где создать вторую воронку Битрикс24?', answer: 'Откройте CRM → Сделки → меню «Воронки» → «Воронки и туннели продаж» и добавьте направление. После создания задайте стадии, проверьте карточку сделки и права каждой команды. Количество доступных воронок зависит от тарифа.' },
  { question: 'Почему сотрудник не видит новую воронку?', answer: 'Администратору нужно проверить назначенные роли CRM: сотруднику требуется как минимум право просмотра сделок в этом направлении. Затем проверьте более узкие ограничения на стадии и карточки. Не расширяйте права на все воронки только ради одного отдела.' },
  { question: 'Что проверить после настройки туннеля продаж?', answer: 'На одной контрольной сделке зафиксируйте исходный и целевой ID, стадию, ответственного, нужные поля и результат в обеих воронках. Если выбрали копирование, убедитесь, что не получили лишнюю повторную передачу и что отчёты считают исходную и новую сделки так, как вы задумали.' },
  { question: 'MCP TrueTell уже настраивает воронки автоматически?', answer: 'Такую функцию мы пока не заявляем. MCP TrueTell для настройки и диагностики CRM находится в разработке. Можно обсудить схему стадий, права и ожидаемую передачу без отправки данных клиентов.' },
];
const sourceLinks = [
  { label: 'Битрикс24: воронки продаж и разделение работы по отделам', href: 'https://helpdesk.bitrix24.ru/open/20732764/' },
  { label: 'Битрикс24: туннели продаж, копирование и перемещение', href: 'https://helpdesk.bitrix24.ru/open/20820936/' },
  { label: 'Битрикс24: как правильно формировать и разделять воронки', href: 'https://helpdesk.bitrix24.ru/open/25552638/' },
  { label: 'Битрикс24: ролевая модель прав в CRM', href: 'https://helpdesk.bitrix24.ru/open/23240636/' },
  { label: 'Битрикс24: робот «Сменить воронку»', href: 'https://helpdesk.bitrix24.ru/open/22381314/' },
  { label: 'Битрикс24: робот «Копировать сделку» и настройка таймлайна', href: 'https://helpdesk.bitrix24.ru/open/22494682/' },
];
const designRows = [
  ['Продажи', 'Новая → Выяснена потребность → Договор', 'Менеджер продаж', 'Подписанный договор и согласованный состав работ'],
  ['Исполнение', 'Принято → В работе → Результат передан', 'Руководитель исполнения', 'Принятое клиентом исполнение'],
];
const structuredData = createArticleStructuredData({
  articleType: 'Article', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  breadcrumbs: [{ name: 'Главная', item: siteRoot.toString() }, { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() }, { name: title, item: articleUrl }],
  faqItems,
});
---
<ArticleLayout {title} titleParts={[{ text: 'Две воронки Битрикс24: ' }, { text: 'как разделить процессы', accent: true }]} {description}
  canonicalPath={`/${article.hrefPath}`} {structuredData} ogTitle={article.seoTitle} ogDescription={description}
  {ogImage} ogImageAlt={imageAlt} category={article.category} author={authorName}
  intro="Продажи договорились с клиентом, дальше заказ ведёт другая команда. Чтобы не смешивать этапы переговоров и исполнения, сначала определите момент передачи и судьбу исходной сделки. Затем создавайте вторую воронку.">
  <Fragment slot="quick-answer">
    <p><strong>Разделите процессы там, где заканчивается ответственность продаж и начинается работа второй команды.</strong> Запишите для каждой воронки её стадии, ответственного и критерий завершения. В туннеле выберите копирование, если нужна отдельная сделка для исполнения и сохранение исходной в продажах. Выберите перемещение, если одна сделка должна сменить направление.</p>
    <p>Перед автоматизацией проверьте права обеих команд и проведите одну контрольную сделку через выбранную границу. Сверьте ID, стадии, ответственных и то, в какой воронке осталась исходная запись.</p>
  </Fragment>

  <p data-article-lead>Допустим, отдел продаж заключает договор на внедрение, а команда исполнения запускает проект. В общей воронке часто появляются стадии «Согласование цены», «Договор», «Настройка», «Обучение». Для менеджера продаж последние две уже не описывают продажу. Для исполнителя первые две не показывают его очередь. Здесь полезно разобрать два процесса отдельно.</p>

  <section aria-labelledby="boundary">
    <h2 id="boundary">Сначала обозначьте <span data-heading-accent>границу процессов</span></h2>
    <p>У второй воронки должен быть собственный маршрут работы, а не только другое название отдела. Сформулируйте, какой результат закрывает первый процесс, какие сведения нужны следующей команде и кто принимает передачу. Если после договора остаётся одно действие менеджера, отдельная воронка может усложнить учёт. Если задача второй команды не связана с продажей, сравните воронку сделок с задачами или смарт-процессом.</p>
    <ArticleFigure src={boundaryImage} fullSize alt={imageAlt} caption="Учебный пример разделения продаж и исполнения. Это редакционная схема, а не снимок интерфейса или схема клиентского портала." />
    <DataTable label="Пример двух процессов для внедрения" columns={['Процесс', 'Пример стадий', 'Кто отвечает', 'Граница']} rows={designRows} rowHeaders />
    <p>Стадии в таблице — пример, а не готовый шаблон Битрикс24. У вас границей может быть оплаченный счёт, подтверждённый заказ или переданный комплект документов. Запишите её так, чтобы два сотрудника одинаково определяли момент передачи.</p>
  </section>

  <section aria-labelledby="setup">
    <h2 id="setup">Создайте направление <span data-heading-accent>и настройте доступ</span></h2>
    <p>В Битрикс24 направление сделок — это набор стадий. Откройте CRM → Сделки → меню «Воронки» → «Воронки и туннели продаж» и добавьте новую воронку. Назовите её по процессу, например «Исполнение внедрений». Количество направлений зависит от тарифа; проверьте доступность на своём портале до переноса процесса.</p>
    <p>Настройте стадии под фактические действия команды. В отдельном направлении Битрикс24 позволяет настраивать карточку сделки и права доступа. Проверьте, какие поля необходимы исполнителям и кто может просматривать и менять сделки. Сотрудник не увидит направление, если назначенные ему роли не дают права просмотра сделок в нём. Условие передачи не должно требовать доступа к данным, которые второй команде показывать нельзя.</p>
    <p>Если сотрудник не видит нужную карточку, используйте <a href={`${base}ne-vidno-sdelku-bitrix24-prava/`}>проверку прав CRM</a>. Если сделка видна, но не переходит на стадию, отдельно проверьте <a href={`${base}sdelka-ne-perehodit-stadiyu-bitrix24/`}>обязательные поля и право перемещения</a>.</p>
  </section>

  <section aria-labelledby="handoff">
    <h2 id="handoff">Выберите, <span data-heading-accent>что происходит со сделкой</span></h2>
    <p>В туннеле продаж Битрикс24 связывают исходную и целевую стадии. Дальше выбирают одно из двух действий. «Копировать» создаёт сделку в целевой воронке и оставляет исходную. «Переместить» переводит исходную сделку в новую воронку. Это влияет на то, какую запись увидит менеджер продаж и какие сделки попадут в выборку отчёта. Два ID при копировании нельзя автоматически считать двумя независимыми продажами.</p>
    <ArticleFigure src={handoffImage} fullSize alt="Два варианта передачи между воронками: копирование создаёт вторую сделку с новым ID, перемещение сохраняет одну сделку и убирает её из исходного направления" caption="Редакционная схема на условных ID. Копирование и перемещение показывают разную модель учёта, а не состояние конкретного портала Битрикс24." />
    <p>Соедините исходную стадию с целевой, затем в настройках туннеля проверьте условие, время, начальную стадию и ответственного. Если планируете копировать историю, проверьте настройки и итоговую карточку: у отдельного робота «Копировать сделку» параметр таймлайна задаётся отдельно. Не считайте, что все дела и сообщения всегда переносятся одинаково.</p>
    <p>Когда нужен только перенос существующей сделки, в Битрикс24 есть робот «Сменить воронку». По официальной справке после его работы запущенные роботы и незавершённые бизнес-процессы этой сделки останавливаются. Поэтому сначала проверьте действующую автоматизацию на границе. Если интерфейс туннеля сообщает, что на стадии уже настроен бизнес-процесс и робота добавить нельзя, настройка передачи выполняется в дизайнере бизнес-процессов.</p>
  </section>

  <section aria-labelledby="verify">
    <h2 id="verify">Проверьте передачу <span data-heading-accent>на одной сделке</span></h2>
    <p>Создайте контрольную сделку без данных клиента и проведите её до граничной стадии. Запишите её ID, воронку, ответственного и поля, которые нужны принимающей команде. После срабатывания туннеля откройте обе воронки и проверьте результат под ролями менеджера и исполнителя.</p>
    <p>При копировании должны быть видны две записи там, где вы их ожидаете: исходная в продажах и новая в исполнении. Сравните значения полей, ответственного и историю целевой карточки с тем, что задано в настройках. При перемещении проследите одну запись в целевой воронке и проверьте, что она исчезла из очереди исходной. Затем убедитесь, что передача не повторяется при следующем изменении стадии и отчёт считает результат продажи по выбранному вами правилу.</p>
    <p>Когда схема работает на контрольной сделке, зафиксируйте в рабочем регламенте: кто закрывает продажу, кто принимает исполнение, какой способ передачи настроен и какая карточка считается источником для отчёта. Отдельно проверьте <a href={`${base}voronka-prodazh-bitrix24/`}>показатели воронки продаж</a> после изменения процесса.</p>
    <p>MCP TrueTell для настройки и диагностики CRM находится в разработке. Автоматическую настройку туннелей или проверку ваших воронок мы пока не заявляем. Можно обсудить схему стадий, роли и то, как должен выглядеть результат передачи.</p>
    <InlineConsultation variant="product" title="Нужно разделить работу двух команд в CRM?" description="Опишите процессы и границу передачи без клиентских данных. Поможем сформулировать схему стадий и критерии проверки; обсудим будущие сценарии диагностики CRM." href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
  </section>

  <FaqSection title="Частые вопросы о двух воронках Битрикс24" items={faqItems} variant="article" />
  <p>Официальная справка Битрикс24 проверена 31 октября 2026 года. Конкретный клиентский портал не проверялся; доступность функций зависит от тарифа, прав и действующей автоматизации.</p>
  <ArticleSources publishedIso={article.publishedAt} modifiedIso={article.updatedAt} sources={sourceLinks} />
  <Fragment slot="article-end">
    <ArticleProductCta titleParts={[{ text: 'Обсудим ' }, { text: 'настройку CRM с MCP TrueTell', accent: true }]} description={mcpProduct.articleDescription} href={mcpProduct.articleHref} actionLabel={mcpProduct.articleActionLabel} />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <ConsultationCtaSection slot="after-article" />
</ArticleLayout>
