---
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import Checklist from '../../components/editorial/checklist.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import { getArticle, getRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';
import filterImage from '../../images/articles/bitrix24-contacts-filter-official.jpg';
import linksImage from '../../images/articles/bitrix24-contact-links-official.jpg';
import restoreImage from '../../images/articles/bitrix24-contact-restore-official.jpg';

const article = getArticle('udalenie-kontaktov-bitrix24/');
const { title, description } = article;
const canonicalPath = `/${article.hrefPath}`;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteRoot = new URL(base, import.meta.env.SITE);
const articleUrl = new URL(article.hrefPath, siteRoot).toString();
const authorName = companyInfo.editorial.defaultAuthor;
const imageAlt = 'Официальный экран контактов Битрикс24: фильтр по типу контакта и ответственному сотруднику перед отбором записей';
const ogImage = new URL(filterImage.src, siteRoot).toString();
const titleParts = [{ text: 'Как ' }, { text: 'удалить контакты', accent: true }, { text: ' в Битрикс24: по одному или списком' }];
const sourceLinks = [
  { label: 'Удаление одного или нескольких элементов CRM — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/23238660/' },
  { label: 'Контакты: фильтр, связи, экспорт и права — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/25042958/' },
  { label: 'Групповые действия в CRM и выбор на всех страницах — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/21064250/' },
  { label: 'Корзина CRM: настройки, восстановление и срок хранения — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/24668648/' },
  { label: 'Связи контактов и компаний: ограничение вкладки — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/27912504/' },
  { label: 'Как объединить дубликаты контактов — Поддержка24', href: 'https://helpdesk.bitrix24.ru/open/25343258/' },
];
const actions = [
  ['Появился повтор одного клиента', 'Проверить дубликаты и объединить нужные данные', 'Сначала сопоставить карточки и выбрать, какие сведения сохранить'],
  ['В карточке устарел телефон или e-mail', 'Исправить соответствующее поле', 'Оставить карточку клиента и её рабочую историю'],
  ['Клиентом будет заниматься другой менеджер', 'Сменить ответственного', 'Согласовать передачу клиента и открытых задач'],
  ['Ненужную карточку действительно нужно убрать', 'Удалить выбранный контакт', 'Проверить связи, права, сохранение данных и корзину'],
];
const bulkSteps = [
  { title: 'Откройте список контактов.', description: 'Перейдите в CRM → Клиенты → Контакты. Проверьте, что вы работаете именно с контактами, а не с лидами или компаниями.' },
  { title: 'Задайте фильтр и проверьте результат.', description: 'Укажите доступные условия отбора, например тип контакта и ответственного. Откройте несколько найденных карточек и убедитесь, что критерий подходит всей выборке.' },
  { title: 'Отметьте нужные строки.', description: 'Выбирайте только карточки, которые действительно решили удалить. Для операции на текущей странице не расширяйте выборку на остальные страницы.' },
  { title: 'При необходимости включите «Для всех».', description: 'Эта опция распространяет выбор на все страницы текущего списка с заданным фильтром. Перепроверьте условия перед её включением.' },
  { title: 'Выполните удаление и проверьте результат.', description: 'Выберите действие «Удалить», прочитайте подтверждение, если оно появилось, и завершите операцию. Обновите список и проверьте, что нужные карточки сохранены.' },
];
const faqItems = [
  { question: 'Как удалить один контакт в Битрикс24?', answer: 'Откройте CRM → Клиенты → Контакты, найдите запись и выберите в меню строки «Удалить». Для операции нужны права на удаление контакта. Удаление доступно и из настроек карточки CRM.' },
  { question: 'Как массово удалить контакты, включая другие страницы списка?', answer: 'Отфильтруйте контакты, проверьте результат и отметьте нужные строки. Для выбора всех результатов на остальных страницах включите «Для всех», затем выберите «Удалить». Опция действует в текущем списке с его фильтром и доступными вам записями.' },
  { question: 'Можно ли восстановить удалённый контакт?', answer: 'Проверьте CRM → Ещё → Корзина. Контакты могут попадать в корзину, если она включена для этого типа элемента. Восстановление зависит от тарифа и доступности записи; после окончательного удаления вернуть её через корзину нельзя. У восстановленного элемента меняется ID.' },
  { question: 'Почему в корзине нет удалённого контакта?', answer: 'Проверьте фильтр по типу «Контакт», времени удаления и пользователю. Обычный сотрудник видит только удалённые им элементы, администратор Битрикс24 — все. Возможны и другие причины: корзина для контактов отключена либо запись уже удалена окончательно.' },
  { question: 'Удалятся ли вместе с контактом его сделки и компания?', answer: 'Перед удалением откройте «Связи» в карточке контакта и проверьте связанные элементы. Нельзя считать удаление контакта способом удалить все его сделки или компанию. Область каждого действия нужно проверять отдельно, включая свои интеграции и автоматизацию.' },
  { question: 'Почему нет кнопки удаления контактов?', answer: 'Попросите администратора проверить права именно на удаление контактов и область доступных записей. Возможность просматривать карточку не подтверждает право её удалить. Для группового действия также проверьте, выделены ли нужные строки.' },
  { question: 'Можно ли удалить контакты через TrueTell Cleaner?', answer: 'Приложение TrueTell «Массовое удаление лидов и сделок» предназначено для лидов и сделок. В этой инструкции контакты удаляются штатными средствами Битрикс24; возможность удалять контакты через Cleaner не заявляется.' },
];
const relatedArticles = getRelatedArticles(article.hrefPath)
  .map(item => ({ ...item, description: item.summaryDescription ?? item.description, href: `${base}${item.hrefPath}` }));
const structuredData = createArticleStructuredData({
  articleType: 'Article', title, description, articleUrl,
  publishedDate: article.publishedAt, modifiedDate: article.updatedAt,
  publisherUrl: siteRoot.toString(), author: authorName, image: ogImage,
  articleSection: 'Контакты и клиентская база Битрикс24',
  breadcrumbs: [
    { name: 'Главная', item: siteRoot.toString() },
    { name: 'База знаний', item: new URL('knowledge-base/', siteRoot).toString() },
    { name: title, item: articleUrl },
  ], faqItems,
});
---

<ArticleLayout {title} {titleParts} {description} {canonicalPath} {structuredData}
  ogTitle={article.seoTitle} ogDescription={description} {ogImage} ogImageAlt={imageAlt}
  category={article.category} author={authorName}
  intro="Как выбрать нужные карточки клиентов, удалить один контакт или всю проверенную выборку и найти случайно удалённую запись в корзине CRM.">
  <Fragment slot="quick-answer">
    <p>Откройте <strong>CRM → Клиенты → Контакты</strong>, найдите запись и выберите «Удалить» в меню строки. Для массового удаления сначала задайте фильтр и отметьте контакты. Опция <strong>«Для всех»</strong> включает результаты на других страницах списка.</p>
    <p>Нужны права на удаление контактов. Перед операцией проверьте связанные сделки, сохраните необходимые данные и уточните настройки корзины: возможность восстановления зависит от тарифа и состояния записи.</p>
  </Fragment>

  <p data-article-lead>Контакт может использоваться в нескольких рабочих процессах: менеджер ведёт по нему сделки, коллеги готовят документы, интеграция сопоставляет клиента по ID. Поэтому очистку списка стоит начинать с проверки конкретных карточек. Так проще отделить ненужные записи от клиентов, по которым работа продолжается.</p>

  <section aria-labelledby="contact-action">
    <h2 id="contact-action">Когда контакт <span data-heading-accent>действительно нужно удалить</span></h2>
    <p>Сначала определите, что мешает работе с клиентской базой. Повторная карточка, неправильный номер и смена менеджера требуют разных действий. Удаление всей карточки ради исправления одного поля может убрать из рабочего списка полезные сведения о клиенте.</p>
    <DataTable label="Как выбрать действие с карточкой контакта" columns={['Ситуация', 'Подходящее действие', 'Что проверить']} rows={actions} rowHeaders />
    <p>Если у одного клиента несколько карточек, изучите штатное <a href={sourceLinks[5].href} target="_blank" rel="noopener noreferrer">объединение дубликатов</a>. Сопоставьте их содержимое до выбора основной записи. Один и тот же телефон сам по себе ещё не объясняет, какие сведения можно убрать.</p>
  </section>

  <p>Если нужно навести порядок во всей базе, используйте <a href={`${base}ochistka-crm-bitrix24/`}>план очистки CRM Битрикс24</a>: сначала разделите исправление данных, объединение дублей и удаление ненужных карточек.</p>

  <section aria-labelledby="contact-before">
    <h2 id="contact-before">Что проверить <span data-heading-accent>перед очисткой</span></h2>
    <p>Откройте карточку контакта и вкладку <strong>«Связи»</strong>. Посмотрите, какие сделки и другие элементы относятся к этому клиенту. Если есть незавершённая работа, согласуйте решение с ответственным сотрудником. Для повторяющихся импортов заранее выясните, использует ли обмен ID этого контакта.</p>
    <p>Если к контакту привязано несколько компаний, вкладка <strong>«Связи»</strong> показывает только последнюю добавленную. Остальные проверьте в поле <strong>«Компания»</strong> и на вкладке <strong>«История»</strong>. Это ограничение описано в <a href={sourceLinks[4].href} target="_blank" rel="noopener noreferrer">официальной инструкции по связям CRM</a>: одного просмотра вкладки недостаточно для полного списка компаний.</p>
    <ArticleFigure src={linksImage} fullSize
      alt="Официальный экран карточки контакта Битрикс24: вкладка Связи показывает связанные с клиентом элементы CRM"
      caption="Подлинный скриншот Поддержки24: просмотр связей контакта перед изменениями. Имена и значения относятся к демонстрационному примеру справки. Экран помогает проверить связанные элементы; он не показывает результат удаления." />
    <p>Сохраните сведения, которые понадобятся после очистки: ID контактов, данные для связи и согласованный список записей. Для экспорта контактов проверьте тариф, соответствующее право и настройку <strong>«Участвует в экспорте контактов»</strong>. Экспорт доступен не всем пользователям и не на всех тарифах. Откройте полученный файл и сравните его содержимое с нужной выборкой.</p>
    <p>Файл со значениями полей пригодится для сверки, но возможность вернуть из него все связи, дела и историю не следует предполагать. Отдельно проверьте, включено ли помещение контактов в корзину и доступно ли восстановление на вашем тарифе.</p>
    <p>Для удаления сотруднику требуется соответствующее право на контакты. Администратор может проверить его через настройки прав CRM. Если карточка открывается для просмотра, это ещё не означает, что её разрешено удалить.</p>
  </section>

  <section aria-labelledby="contact-single">
    <h2 id="contact-single">Как удалить <span data-heading-accent>один контакт</span></h2>
    <p>Перейдите в <strong>CRM → Клиенты → Контакты</strong>, найдите нужную запись и снимите ненужные условия фильтра, если они мешают поиску. Сверьте ФИО, телефон или e-mail: однофамильцы и похожие названия могут относиться к разным людям.</p>
    <p>В меню строки рядом с контактом выберите <strong>«Удалить»</strong>. Прочитайте запрос подтверждения, если он появится. В общей инструкции Битрикс24 также описано удаление из открытой карточки через <strong>Настройки → Удалить</strong>. Расположение значков может отличаться в зависимости от интерфейса портала.</p>
    <p>После операции обновите список и проверьте результат по той же записи. Если удаление было ошибочным, сразу перейдите к проверке корзины, пока запись ещё доступна для восстановления.</p>
  </section>

  <section aria-labelledby="contact-bulk">
    <h2 id="contact-bulk">Как удалить <span data-heading-accent>несколько контактов или весь список</span></h2>
    <p>Для групповой операции используйте список контактов. Фильтр задаёт границы отбора, а отметки строк — выбор внутри этих границ. Условие «Ответственный» помогает собрать записи сотрудника, но перед удалением полезно уточнить, не нужно ли просто передать их другому менеджеру.</p>
    <ArticleFigure src={filterImage} fullSize alt={imageAlt}
      caption="Официальный пример Поддержки24: контакты отбирают по типу и ответственному. Это демонстрация фильтра, а не готовая рекомендация удалить такие карточки. Условия и состав выборки проверяют на своём портале." />
    <Checklist label="Массовое удаление выбранных контактов" items={bulkSteps} />
    <p><strong>«Для всех» расширяет действие за пределы текущей страницы.</strong> Если установлен фильтр, перепроверьте именно его результаты. Снятый фильтр и включённая опция могут существенно расширить выборку. Удалять все доступные контакты без условий имеет смысл только после согласования полного списка и сохранения нужных сведений.</p>
    <p>Число строк на экране не следует использовать как единственный контроль. Запишите ID предназначенных для удаления карточек и перечень исключений, затем сравните фактический результат с этим списком. Если операция завершилась не полностью, проверьте оставшиеся записи, прежде чем повторять массовое действие.</p>
  </section>

  <section aria-labelledby="contact-dependencies">
    <h2 id="contact-dependencies">Как проверить <span data-heading-accent>связанные сделки и компанию</span></h2>
    <p>Организации-контрагенты очищаются отдельно. Если задача касается их карточек, прочитайте <a href={`${base}udalenie-kompaniy-bitrix24/`}>как удалить компанию и проверить её связи</a>.</p>
    <p>Удаление контакта не стоит использовать как способ очистить всю связанную с ним CRM. Сначала определите, с каким типом записей работаете. Если цель — убрать ненужные лиды, воспользуйтесь <a href={`${base}massovoe-udalenie-lidov-bitrix24/`}>инструкцией по массовому удалению лидов</a>. Для сделок с отказами есть отдельный <a href={`${base}udalenie-proigrannyh-sdelok-bitrix24/`}>разбор отбора проигранных сделок</a>.</p>
    <p>У контакта проверьте вкладку «Связи», открытые обязательства перед клиентом и правила обмена с другими системами. Если вашу CRM меняют роботы или интеграции, отдельно выясните, что они делают при удалении. По одному экрану контакта нельзя гарантировать последствия всей настроенной автоматизации.</p>
    <p>После пробной операции с одной согласованной ненужной карточкой проверьте сохранившиеся рабочие элементы. При неожиданном результате остановите массовую очистку и разберите причину. Условия отбора и фактические изменения важнее самого факта нажатия кнопки.</p>
    <InlineConsultation title="Нужно согласовать очистку клиентской базы?" description="Поможем разобрать выборку, связанные записи и ограничения вашего сценария перед массовыми изменениями." />
  </section>

  <section aria-labelledby="contact-recovery">
    <h2 id="contact-recovery">Как найти и <span data-heading-accent>восстановить удалённый контакт</span></h2>
    <p>Откройте <strong>CRM → Ещё → Корзина</strong>. Отберите тип <strong>«Контакт»</strong>, при необходимости уточните время удаления, пользователя и ID. Администратор Битрикс24 видит все удалённые элементы, сотрудник — только те, которые удалил сам.</p>
    <p>Если нужная запись доступна и тариф позволяет восстановление, выберите в её меню <strong>«Восстановить»</strong>. После этого проверьте контакт в CRM и необходимые рабочие связи. У восстановленного элемента меняется ID, поэтому прежняя ссылка на карточку не подходит; внешние сопоставления также следует проверить.</p>
    <ArticleFigure src={restoreImage} fullSize
      alt="Официальный экран корзины CRM: в меню удалённого контакта выделена команда Восстановить"
      caption="Подлинный скриншот Поддержки24: восстановление контакта из корзины через меню строки. В примере фильтр включает контакты и компании; для поиска только контактов выберите соответствующий тип. Доступность восстановления зависит от тарифа и состояния записи." />
    <p>В актуальной справке указан срок хранения до 30 дней с последующим автоматическим удалением по 100 элементов в день. При большой очереди фактическое хранение может продлиться. Рассчитывать на это продление как на гарантию восстановления не стоит.</p>
    <p>Проверьте настройки корзины через CRM → Ещё → Настройки → Настройки CRM → Другое → Прочие настройки → Корзина. Для некоторых типов элементов помещение в корзину можно отключить. Если контакт не находится, проверьте фильтр, права и настройки хранения. Окончательное удаление из корзины доступно администратору Битрикс24; после него восстановление через этот инструмент невозможно.</p>
  </section>

  <section aria-labelledby="contact-errors">
    <h2 id="contact-errors">Что делать, если <span data-heading-accent>удаление недоступно</span></h2>
    <p>При отсутствии нужного пункта меню попросите администратора проверить права на удаление контактов и область записей, с которыми сотрудник может работать. Для группового действия сначала убедитесь, что строки выделены. При ошибке операции сохраните её текст и перечень затронутых ID, затем проверьте результат в списке.</p>
    <p>Если после очистки контакт появился снова, проверьте, откуда создаются новые записи: импорт, CRM-форма или интеграция. Найдите источник повторного создания до следующего удаления. Повторение операции само по себе не исправляет причину появления карточки.</p>
    <p>Приложение <a href={`${base}bitrix24-cleaner/`}>TrueTell «Массовое удаление лидов и сделок»</a> работает с лидами и сделками. Контакты удаляйте штатными средствами CRM.</p>
  </section>

  <FaqSection variant="article" items={faqItems} />
