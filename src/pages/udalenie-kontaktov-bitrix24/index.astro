    <ArticleProductCta titleParts={[{ text: 'Подготовьте ' }, { text: 'очистку CRM', accent: true }]}
      description="Обсудим, какие контакты можно удалить, какие связи нужно проверить и что сохранить перед групповой операцией."
      href={companyInfo.contacts.consultationUrl} actionLabel="Обсудить задачу" />
    <RelatedArticles items={relatedArticles} />
  </Fragment>
  <ConsultationCtaSection slot="after-article" />
</ArticleLayout>
