---
import AppHeader from '../../components/header/header.astro';
import SiteFooter from '../../components/footer/site-footer.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogSection from '../../sections/blog-section/blog-section.astro';

const title = 'Блог TrueTell — данные, интеграции и автоматизация';
const description =
  'Разборы TrueTell о BI-аналитике и работе с данными: как понимать показатели и находить причины проблем в учёте.';
---

<BaseLayout contentCategory="Блог" {title} {description} canonicalPath="/blog/">
  <AppHeader />
  <main class="site-content">
    <BlogSection page />
  </main>
  <SiteFooter />
</BaseLayout>
