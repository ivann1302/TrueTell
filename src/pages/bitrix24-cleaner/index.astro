---
import LineWave from '../../components/ui/line-wave.astro';
import closingStyles from '../../styles/product-closing.module.scss';
import ActionIcon from '../../components/product-scenario/action-icon.astro';
import layout from '../../styles/product-panels.module.scss';
import ProductScenario from '../../components/product-scenario/product-scenario.astro';
import ProductSummary from '../../components/product-summary/product-summary.astro';
import ArticleFigure from '../../components/editorial/article-figure.astro';
import AppHeader from '../../components/header/header.astro';
import SiteFooter from '../../components/footer/site-footer.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { companyInfo } from '../../config/company';
import { cleanerProduct, cleanerProductPath } from '../../config/products';
import selection from '../../images/products/cleaner-selection.png';
import confirmation from '../../images/products/cleaner-confirmation.png';
import result from '../../images/products/cleaner-result.png';
import heroStyles from '../../styles/product-hero.module.scss';
import styles from './page.module.scss';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const title = `${cleanerProduct.name} — ${companyInfo.brandName}`;
const description = cleanerProduct.description;
const ogTitle = `${cleanerProduct.name} — ${companyInfo.brandName}`;
const ogDescription = 'Найдите ненужные записи по фильтрам, проверьте список и удалите выбранное. Приложение для Битрикс24 с отчётом по каждому ID.';
const siteRoot = new URL(base, Astro.site ?? 'https://truetell-retail.ru');
const pageUrl = new URL(cleanerProductPath.slice(1), siteRoot).href;
const screenshots = [
  {
    src: selection,
    title: 'Поиск и выбор записей',
    caption: 'Исключите из списка карточки, которые нужно сохранить',
    alt: 'Демонстрационная выборка в Битрикс24: 120 сделок найдено, одна исключена, 119 выбраны',
  },
  {
    src: confirmation,
    title: 'Подтверждение',
    caption: 'Перед удалением проверьте портал и количество выбранных записей',
    alt: 'Подтверждение удаления трёх демонстрационных сделок с указанием портала и предупреждением об отсчёте',
  },
  {
    src: result,
    title: 'Результат',
    caption: 'Посмотрите результат по каждому ID и скачайте отчёт в CSV',
    alt: 'Результат тестовой операции: две сделки удалены без ошибок, доступен итоговый CSV',
  },
];
const useCases = [
  ['Старые обращения', 'Лиды, с которыми больше не работаете.'],
  ['Тестовые карточки', 'Записи после настройки CRM и обучения.'],
  ['Ненужные сделки', 'Сделки, не нужные для работы и отчётности.'],
];
const features = [
  ['Точный отбор', 'Даты, стадии, ответственный и другие фильтры.', 'filter'],
  ['Контроль списка', 'Исключайте нужные карточки и сохраняйте выборку в CSV.', 'review'],
  ['Пауза и остановка', 'Приостанавливайте отправку новых запросов.', 'run'],
  ['Отчёт по каждой записи', 'Удалённые, пропущенные и ошибки — в итоговом CSV.', 'report'],
] as const;
const steps = [
  { icon: 'filter', title: 'Отберите', text: 'Найдите записи и оставьте нужные.' },
  { icon: 'remove', title: 'Подтвердите', text: 'Сверьте портал и количество записей.' },
  { icon: 'report', title: 'Проверьте итог', text: 'Скачайте отчёт по каждому ID.' },
] as const;
const faqItems = [
  { question: 'Где обрабатываются данные и хранятся отчёты?', answer: 'Карточки обрабатываются в вашем браузере через API Битрикс24 и не отправляются на серверы разработчика. Отчёт хранится локально и может потеряться при очистке данных браузера — скачайте нужные результаты в CSV.' },
  { question: 'Что проверить перед удалением?', answer: 'Убедитесь, что записи не нужны для отчётности, связанных данных и автоматизаций. Проверка карточки и удаление — отдельные запросы: изменение записи между ними не исключено.' },
  { question: 'Кто может запускать удаление?', answer: 'Администратор портала с необходимыми правами Битрикс24.' },
  { question: 'Сколько записей можно удалить за один раз?', answer: 'До 3 000 лидов или сделок за одну операцию. Если найдено больше, приложение предложит сузить фильтры.' },
  { question: 'Можно оставить отдельные карточки из найденного списка?', answer: 'Да. Снимите с них выделение перед подтверждением. Они не войдут в выбранный список удаления.' },
  { question: 'Можно остановить обработку?', answer: 'Да. Пауза и остановка прекращают отправку новых запросов. Уже отправленные запросы могут завершиться; автоматического отката нет.' },
  { question: 'Будет ли приложение работать после закрытия вкладки?', answer: 'Автоматического продолжения после закрытия нет. Оставляйте вкладку открытой до завершения обработки.' },
  { question: 'Можно восстановить карточки из CSV?', answer: 'Нет. CSV содержит отдельные поля или результаты обработки и не является полной резервной копией CRM. Восстановление карточек из CSV не предусмотрено.' },
  { question: 'Почему запись пропущена или результат неизвестен?', answer: 'Запись может быть пропущена, если при повторной проверке обнаружены изменения контрольных полей. Неизвестный результат означает, что приложение не получило достоверного ответа. Проверьте такую карточку в CRM перед новой операцией.' },
  { question: 'Удаляет ли приложение контакты, компании или дубли?', answer: 'Нет. Приложение работает с выбранными лидами и сделками. Отдельного поиска дублей нет.' },
];
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage', '@id': `${pageUrl}#webpage`, url: pageUrl,
      name: title, description, inLanguage: 'ru-RU',
      mainEntity: { '@id': `${pageUrl}#application` },
      breadcrumb: { '@id': `${pageUrl}#breadcrumbs` },
    },
    {
      '@type': 'SoftwareApplication', '@id': `${pageUrl}#application`,
      name: cleanerProduct.name, url: pageUrl, description,
      applicationCategory: 'BusinessApplication', operatingSystem: 'Web browser', inLanguage: 'ru-RU',
      screenshot: screenshots.map(({ src }) => new URL(src.src, siteRoot).href),
      publisher: { '@type': 'Organization', name: companyInfo.brandName, url: siteRoot.href },
      featureList: features.map(([heading, text]) => `${heading}. ${text}`),
    },
    {
      '@type': 'BreadcrumbList', '@id': `${pageUrl}#breadcrumbs`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: siteRoot.href },
        { '@type': 'ListItem', position: 2, name: 'Продукты', item: new URL('products/', siteRoot).href },
        { '@type': 'ListItem', position: 3, name: cleanerProduct.name, item: pageUrl },
      ],
    },
    {
      '@type': 'FAQPage', '@id': `${pageUrl}#faq`,
      mainEntity: faqItems.map(({ question, answer }) => ({
        '@type': 'Question', name: question,
        acceptedAnswer: { '@type': 'Answer', text: answer },
      })),
    },
  ],
};
---

<BaseLayout {title} {description} {structuredData} canonicalPath={cleanerProductPath}
  {ogTitle} {ogDescription} ogImage={new URL(confirmation.src, siteRoot).href} ogImageAlt={screenshots[1].alt}>
  <AppHeader />
  <main class:list={['site-content', styles.page, heroStyles.productPage, closingStyles.flushFooter]}>
    <div class={styles.container}>
      <header class:list={[styles.intro, heroStyles.hero, heroStyles.heroWave]}>
        <LineWave centerOnMobile />
        <div class={heroStyles.heroCopy}>
          <h1>{cleanerProduct.name}</h1>
          <p class={heroStyles.heroDescription}>Удаляйте ненужные записи одной операцией. Отбирайте по фильтрам и сохраняйте важные.</p>

        </div>
          <div class={heroStyles.heroActions}>
            <a class={styles.button} href={companyInfo.contacts.consultationUrl}>{cleanerProduct.connectionActionLabel}</a>
          </div>
      </header>

      <ProductSummary
        description="Приложение удаляет старые и тестовые записи из Битрикс24. Вы находите их по фильтрам, снимаете галочки с нужных карточек и подтверждаете удаление остальных.">
        <span slot="title">Чтобы убрать <strong>ненужные лиды и сделки</strong></span>
      </ProductSummary>

      <ProductScenario id="selection-scenario-title"
        title="Удалить ненужные сделки, сохранив важные"
        description="Уберите тестовые сделки после настройки CRM, исключив из списка те, которые нужно оставить."
        steps={[
          { icon: 'filter', title: 'Отберите сделки', text: 'Выберите воронку, стадии и период.' },
          { icon: 'review', title: 'Оставьте нужные карточки', text: 'Снимите выделение с записей, которые нужно сохранить.' },
          { icon: 'remove', title: 'Подтвердите выбор', text: 'Сверьте портал и количество записей.' },
        ]}>
        <ArticleFigure src={selection} fullSize alt={screenshots[0].alt} />
      </ProductScenario>

      <section class:list={[styles.useCases, layout.textPanel]} aria-labelledby="use-cases-title">
        <h2 id="use-cases-title">Когда нужна очистка CRM</h2>
        <dl class={styles.descriptionList}>
          {useCases.map(([heading, text]) => <div><dt>{heading}</dt><dd>{text}</dd></div>)}
        </dl>
      </section>

      <section class:list={[styles.features, layout.features, layout.textPanel]} aria-labelledby="features-title">
        <h2 id="features-title">Возможности приложения</h2>
        <dl class={layout.featureGrid}>
          {features.map(([heading, text, icon]) => <div><dt><ActionIcon name={icon} />{heading}</dt><dd>{text}</dd></div>)}
        </dl>
      </section>

      <section class={styles.interface} aria-labelledby="interface-title">
        <div class={styles.sectionHeading}>
          <h2 id="interface-title">Приложение в работе</h2>
        </div>
        <div class:list={[styles.screenshots, layout.screenshots]}>
          {screenshots.slice(1).map((shot) => (
            <ArticleFigure src={shot.src} fullSize alt={shot.alt} />
          ))}
        </div>
      </section>

      <section id="how-it-works" class:list={[styles.darkWorkflow, layout.workflow]} aria-labelledby="workflow-title">
        <h2 id="workflow-title">Как проходит удаление</h2>
        <ol>{steps.map(({ icon, title, text }) => <li><ActionIcon name={icon} /><h3>{title}</h3><p>{text}</p></li>)}</ol>
        <p class={layout.workflowNote}>После подтверждения — <strong>5 секунд на отмену</strong>. Затем держите вкладку открытой до завершения. <strong>Общего отката нет.</strong></p>
      </section>

      <div class={styles.faq}>
        <FaqSection items={faqItems} title="Что нужно знать перед началом" id="cleaner-faq" variant="article" />
      </div>

    </div>
  </main>
  <div class={closingStyles.closingSurface}>
    <LineWave />
    <div class={styles.container}>
      <section class:list={[styles.connection, closingStyles.connectionDark]} aria-labelledby="connection-title">
        <h2 id="connection-title">Подключение приложения</h2>
        <div>
          <p>Поможем подключить приложение к вашему Битрикс24.</p>
          <p><a class={styles.licenseLink} href={`${base}bitrix24-cleaner-license/`}>Лицензионное соглашение</a><br /><a class={styles.licenseLink} href={`${base}bitrix24-cleaner-privacy/`}>Политика конфиденциальности</a></p>
          <a class={styles.button} href={companyInfo.contacts.consultationUrl}>{cleanerProduct.connectionActionLabel}</a>
        </div>
      </section>
    </div>
    <SiteFooter transparent hideDivider />
  </div>
</BaseLayout>
