---
import ScenarioPage from '../../components/moysklad-scenario-page/moysklad-scenario-page.astro';
import Screenshot from '../../components/moysklad-scenario-page/scenario-screenshot.astro';
import ProductScenario from '../../components/product-scenario/product-scenario.astro';
import Checklist from '../../components/editorial/checklist.astro';
import { companyInfo } from '../../config/company';
import styles from '../bitrix24-cleaner/page.module.scss';
import productStyles from '../moysklad-mass-operations/page.module.scss';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const title = `Массовое архивирование товаров в МойСклад — ${companyInfo.brandName}`;
const description = 'Переводите выбранные товары и контрагентов МойСклад в архив одной операцией. Проверяйте состав выборки до запуска и изучайте отчёт по обработанным карточкам.';
const faqItems = [
  { question: 'Приложение архивирует только товары?', answer: 'Архивирование предусмотрено для товаров и контрагентов. Для других типов объектов не следует предполагать наличие такого же режима без проверки.' },
  { question: 'Найдёт ли приложение все товары, которые пора архивировать?', answer: 'Решение о составе выборки остаётся за вами. Автоматическое определение неактуальности по продажам или другим бизнес-признакам здесь не заявляется.' },
  { question: 'Архивирование удаляет карточку?', answer: 'В приложении архивирование и удаление представлены разными действиями. Для задачи перевода в архив выбирайте именно архивирование и проверяйте указанный в плане тип операции.' },
  { question: 'Можно ли отменить всю операцию?', answer: 'Общего отката у приложения нет. Возможность последующей работы с отдельными архивными карточками проверяйте в МойСклад; она не равнозначна отмене всей массовой операции.' },
];
const steps = [
  { title: 'Выберите товары или контрагентов', description: 'Укажите архивирование как действие для выбранного типа объектов.' },
  { title: 'Подготовьте выборку карточек', description: 'Определите, какие объекты стали неактуальными для вашей работы.' },
  { title: 'Проверьте состав и план обработки', description: 'Сопоставьте выборку с рабочим списком. Исключите актуальные позиции и действующих партнёров.' },
  { title: 'Подтвердите операцию и сверьте результат', description: 'Изучите отчёт и проверьте состояние карточек в МойСклад.' },
];
---

<ScenarioPage slug="arhivirovanie" label="Архивирование" draft {title} {description} {faqItems}
  heroTitle="Массовое архивирование товаров и контрагентов в МойСклад"
  heroDescription="Переводите выбранные товары или контрагентов в архив одной операцией. Подготовьте выборку, проверьте план и изучите результаты обработки в отчёте."
  summaryDescription="Приложение помогает перевести в архив товары и контрагентов, с которыми вы больше не работаете. Вы определяете состав выборки, проверяете план и подтверждаете архивирование."
  mentions={['Архив товаров', 'Контрагенты', 'Выборка карточек']}
  connectionTitle="Подготовьте архивирование вашего каталога"
  connectionDescription="Расскажите, какие карточки нужно перевести в архив. Поможем уточнить возможности приложения и условия подключения для вашей задачи.">
  <Fragment slot="summary-title">Отделите неактуальные карточки <strong>от текущей работы</strong></Fragment>

  <ProductScenario id="archive-example-title" title="Перевести в архив снятый с продажи ассортимент"
    description="Например, в каталоге осталась группа товаров, с которыми вы больше не работаете. Если задача состоит именно в переводе этих карточек в архив, выберите архивирование."
    steps={[
      { icon: 'filter', title: 'Состав выборки определяете вы', text: 'Приложение не принимает решение, что товар больше не нужен.' },
      { icon: 'review', title: 'Проверьте актуальные позиции', text: 'В группе не должны оказаться товары, с которыми вы продолжаете работать.' },
      { icon: 'report', title: 'Сверьте итог обработки', text: 'Проверьте отчёт и состояние карточек после выполнения.' },
    ]}>
    <Screenshot filename="archive-selection.png" title="Выбор архивирования" alt="Форма архивирования товаров: выбранное действие и условия отбора демонстрационных карточек"
      caption="Архивирование выбранных карточек. Основание для отбора определяет пользователь." />
  </ProductScenario>

  <section class={productStyles.darkPanel} aria-labelledby="archive-result-title">
    <div class={productStyles.copy}>
      <h2 id="archive-result-title">Одна операция для подготовленной группы</h2>
      <p>Выберите тип объектов — товары или контрагенты — и проверьте, какие карточки будут обработаны.</p>
      <h3>Сопоставьте план с рабочим списком</h3>
      <p>Перед подтверждением исключите актуальные позиции и действующих партнёров.</p>
      <h3>Проверьте связанные процессы</h3>
      <p>Архивирование не означает автоматическое отключение товара во всех внешних каналах. Отдельно проверьте, как работа с архивом устроена в ваших интеграциях.</p>
      <h3>Учтите частичное выполнение</h3>
      <p>Итоговый отчёт показывает, какие объекты обработаны, а какие требуют проверки.</p>
    </div>
    <Screenshot filename="archive-result.png" title="Результат архивирования" dark alt="Отчёт массового архивирования с результатами по демонстрационным карточкам"
      caption="Проверьте результат по каждому объекту: массовая обработка может завершиться частично." />
  </section>

  <Fragment slot="editorial">
    <section aria-labelledby="archive-workflow-title">
      <h2 id="archive-workflow-title">Как проходит архивирование</h2>
      <Checklist items={steps} label="Порядок массового архивирования" />
      <aside data-article-note><p>Архивирование и удаление — разные действия. Перед запуском проверьте тип операции в плане: он должен соответствовать вашей задаче.</p></aside>
      <p class={styles.support}><a href={`${base}moysklad-mass-operations/`}>Все возможности приложения →</a></p>
    </section>
  </Fragment>
</ScenarioPage>
