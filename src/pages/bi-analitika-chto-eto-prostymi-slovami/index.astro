---
import ArticleFigure from '../../components/editorial/article-figure.astro';
import ArticleLayout from '../../components/editorial/article-layout.astro';
import ArticleProductCta from '../../components/editorial/article-product-cta.astro';
import ArticleSources from '../../components/editorial/article-sources.astro';
import Checklist from '../../components/editorial/checklist.astro';
import DataTable from '../../components/editorial/data-table.astro';
import InlineConsultation from '../../components/editorial/inline-consultation.astro';
import RelatedArticles from '../../components/editorial/related-articles.astro';
import { biRelatedArticles } from '../../config/articles';
import { companyInfo } from '../../config/company';
import { cleanerProductPath } from '../../config/products';
import biFlowImage from '../../images/articles/bi-data-to-dashboard.png';
import ConsultationCtaSection from '../../sections/consultation-cta-section/consultation-cta-section.astro';
import FaqSection from '../../sections/faq-section/faq-section.astro';
import { createArticleStructuredData } from '../../utils/functions/createArticleStructuredData';

const title = 'BI-аналитика: что это простыми словами и зачем бизнесу';
const description =
  'BI-аналитика простыми словами: как данные из CRM, продаж, склада и рекламы превращаются в понятные дашборды и помогают принимать решения.';
const ogTitle = 'BI-аналитика простыми словами: как работают бизнес-дашборды';
const ogDescription =
  'Понятно объясняем, что такое BI, откуда берутся данные на дашбордах и в каких случаях бизнесу действительно нужна BI-аналитика.';
const canonicalPath = '/bi-analitika-chto-eto-prostymi-slovami/';
const publishedDate = '2026-09-08T00:00:00+03:00';
const modifiedDate = '2026-09-22T00:00:00+03:00';
const authorName = companyInfo.editorial.defaultAuthor;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const cleanerHref = `${base}${cleanerProductPath.slice(1)}`;
const siteRoot = new URL(base, import.meta.env.SITE);
const homeUrl = siteRoot.toString();
const blogUrl = new URL('blog/', siteRoot).toString();
const articleUrl = new URL('bi-analitika-chto-eto-prostymi-slovami/', siteRoot).toString();
const productUrl = `${base}bi-analitika/`;
const imageAlt =
  'Схема, в которой данные CRM, склада, заказов и рекламы объединяются в модель данных и поступают на BI-дашборд';
const ogImage = new URL(biFlowImage.src, siteRoot).toString();

const titleParts = [
  { text: 'BI-аналитика: ', accent: true },
  { text: 'что это простыми словами и зачем она бизнесу' },
];

const breadcrumbs = [
  { label: 'Главная', href: base },
  { label: 'Блог', href: `${base}blog/` },
  { label: 'BI-аналитика простыми словами' },
];

const sourceLinks = [
  {
    label: 'Что такое Business Intelligence — Microsoft Power BI',
    href: 'https://www.microsoft.com/en/power-platform/products/power-bi/topics/business-intelligence/what-is-business-intelligence',
  },
  {
    label: 'Что такое Business Intelligence — IBM',
    href: 'https://www.ibm.com/think/topics/business-intelligence',
  },
  {
    label: 'Как устроены дашборды Power BI — Microsoft Learn',
    href: 'https://learn.microsoft.com/en-us/power-bi/explore-reports/end-user-dashboards',
  },
  {
    label: 'BI-дашборды — Tableau',
    href: 'https://www.tableau.com/en-gb/learn/articles/business-intelligence/bi-dashboards',
  },
];

const reportRows = [
  ['Вопрос', 'Показывает заранее определённый срез', 'Позволяет менять срез и искать причину'],
  ['Подготовка', 'Часто требует ручной сборки', 'Может обновляться автоматически'],
  ['Источники', 'Обычно один файл или система', 'Связывает несколько систем'],
  ['Детализация', 'Новый вопрос требует новой выгрузки', 'Можно перейти от итога к деталям'],
  ['Роль', 'Фиксирует результат', 'Помогает исследовать изменение'],
];

const marginExampleRows = [
  ['Выручка', '3 000', '1 500'],
  ['Себестоимость', '1 800', '750'],
  ['Реклама', '450', '150'],
  ['Комиссии и логистика', '600', '225'],
  ['После этих затрат', '150', '375'],
];

const sourceRows = [
  ['CRM', 'Лиды, сделки, менеджеры и этапы воронки'],
  ['МойСклад или ERP', 'Продажи, товары, закупки и остатки'],
  ['Интернет-магазин', 'Заказы, товары и клиенты'],
  ['Маркетплейсы', 'Продажи, комиссии и возвраты'],
  ['Рекламные системы', 'Расходы, показы и клики'],
  ['Веб-аналитика', 'Источники трафика и конверсии'],
  ['Excel и Google Таблицы', 'Планы, бюджеты и дополнительные справочники'],
];

const implementationSteps = [
  {
    title: 'Сформулировать управленческий вопрос',
    description: 'Например: какой канал продаж приносит реальную прибыль с учётом всех расходов?',
  },
  {
    title: 'Определить показатели',
    description: 'Зафиксировать формулы выручки, маржи, расходов, возвратов и других необходимых метрик.',
  },
  {
    title: 'Найти источники данных',
    description: 'Понять, в каких системах находятся заказы, себестоимость, реклама, комиссии и планы.',
  },
  {
    title: 'Собрать модель данных',
    description: 'Связать товары, клиентов, заказы, каналы и периоды по единым правилам.',
  },
  {
    title: 'Спроектировать дашборд',
    description: 'Показать только те показатели и переходы, которые помогают ответить на исходный вопрос.',
  },
  {
    title: 'Сверить результат с учётом',
    description: 'Проверить цифры на реальных документах до того, как дашборд станет основой для решений.',
  },
];

const relatedArticles = biRelatedArticles.map((article) => ({
  ...article,
  href: `${base}${article.hrefPath}`,
}));

const faqItems = [
  {
    question: 'Что такое BI простыми словами?',
    answer:
      'BI — это технология и процесс, которые собирают данные бизнеса, приводят их к общим правилам и показывают в понятной форме. Например, BI может соединить продажи из CRM, остатки из МоегоСклада и расходы на рекламу на одном дашборде.',
  },
  {
    question: 'BI-аналитика и бизнес-аналитика — одно и то же?',
    answer:
      'В повседневной речи эти понятия часто используют как близкие. Под BI обычно понимают систему сбора, объединения, анализа и визуализации бизнес-данных; точные границы термина зависят от контекста и методологии компании.',
  },
  {
    question: 'Что такое BI-дашборд?',
    answer:
      'BI-дашборд — это экран с ключевыми показателями и визуализациями, который помогает быстро оценить состояние бизнеса. Из общего показателя пользователь может перейти к отчёту и более подробным данным.',
  },
  {
    question: 'Чем BI отличается от Excel?',
    answer:
      'Excel удобен для вычислений, небольших таблиц и разового анализа. BI полезнее, когда данные приходят из нескольких источников, должны регулярно обновляться и использоваться разными сотрудниками по единым правилам.',
  },
  {
    question: 'BI нужен только крупным компаниям?',
    answer:
      'Нет. Важнее не размер компании, а сложность её данных. Даже небольшой бизнес может получить пользу от BI, если использует CRM, складскую систему, сайт, рекламу и маркетплейсы одновременно.',
  },
  {
    question: 'Можно ли подключить BI к CRM или МоемСкладу?',
    answer:
      'Да, если система предоставляет API, коннектор или подходящую выгрузку. Затем данные CRM или МоегоСклада можно связать с рекламой, сайтом, маркетплейсами и финансовыми источниками.',
  },
  {
    question: 'BI сам принимает решения?',
    answer:
      'Нет. BI помогает увидеть показатели, отклонения и взаимосвязи, но управленческое решение принимает человек. Дашборд улучшает основу для решения, а не заменяет понимание бизнеса.',
  },
];

const structuredData = createArticleStructuredData({
  title,
  description,
  articleUrl,
  publishedDate,
  modifiedDate,
  publisherUrl: homeUrl,
  author: authorName,
  breadcrumbs: [
    { name: companyInfo.brandName, item: homeUrl },
    { name: 'Блог', item: blogUrl },
    { name: title, item: articleUrl },
  ],
  faqItems,
});
---

<ArticleLayout
  {title}
  {titleParts}
  {description}
  {canonicalPath}
  {structuredData}
  {ogTitle}
  {ogDescription}
  {ogImage}
  ogImageAlt={imageAlt}
  category="BI-аналитика"
  intro="Разбираемся, как разрозненные данные превращаются в единую систему показателей, чем BI отличается от обычного отчёта и в какой момент он действительно нужен компании."
  {breadcrumbs}
  author={authorName}
  publishedTime={publishedDate}
  modifiedTime={modifiedDate}
>
  <Fragment slot="quick-answer">
    <p>
      <strong>BI-аналитика</strong> собирает данные из CRM, склада, продаж, рекламы и других
      систем, связывает их по единым правилам и показывает в виде показателей, таблиц, графиков
      и дашбордов.
    </p>
    <p>
      Вместо ручного сведения нескольких Excel-файлов руководитель получает общую картину и
      может перейти от изменения показателя к его возможной причине.
    </p>
    <p>
      Начните с одного вопроса — например, какой канал продаж оставляет больше денег после
      затрат. Если ответ уже есть в надёжном отчёте, отдельный BI-проект может быть не нужен.
    </p>
  </Fragment>

  <p data-article-lead>
    Представьте планёрку интернет-магазина: продажи выросли, а денег на следующую закупку
    не хватает. Менеджер показывает выручку из CRM, маркетолог — расходы из рекламного
    кабинета, бухгалтер — комиссии и возвраты. Каждый видит свой участок. Чтобы решить,
    что закупать и где продавать, эти цифры нужно свести по одним товарам и за один период.
    На таком примере разберём, чем помогает BI.
  </p>

  <aside data-article-note>
    <strong>Главное различие</strong>
    <p>
      Дашборд — видимая часть BI. Под ним находятся получение данных, их очистка, единые
      справочники, формулы показателей и связи между системами. Без этого даже аккуратная
      визуализация остаётся обычной картинкой.
    </p>
  </aside>

  <section aria-labelledby="what-is-bi">
    <h2 id="what-is-bi">
      Что означает <span data-heading-accent>BI</span> и как он работает
    </h2>
    <p>
      BI расшифровывается как Business Intelligence. В русском языке рядом используются
      выражения «BI-аналитика», «бизнес-аналитика», «BI-система» и «BI-дашборд». За разными
      названиями обычно стоит одна логика: превратить текущие и исторические данные компании в
      информацию, которая помогает понимать ситуацию и принимать решения.
    </p>
    <p>
      Процесс начинается с источников. Система получает данные, приводит одинаковые сущности к
      общему виду, рассчитывает показатели и только затем передаёт результат в отчёт или
      дашборд. Поэтому путь выглядит не как «таблица → график», а как
      <strong> источники → подготовка → модель данных → показатели → визуализация → решение</strong>.
    </p>

    <ArticleFigure
      src={biFlowImage}
      alt={imageAlt}
      caption="BI связывает разрозненные источники через единую модель данных, а дашборд становится интерфейсом для анализа и решения."
    />

    <p>
      Допустим, директор видит, что прибыль за месяц снизилась, хотя выручка выросла. В
      статичном отчёте эти две цифры останутся рядом. В BI можно пройти глубже: сравнить
      направления, товары и каналы продаж, увидеть рост рекламных расходов или себестоимости и
      дойти до конкретных заказов, которые изменили результат.
    </p>
  </section>

  <section aria-labelledby="simple-example">
    <h2 id="simple-example">
      Почему товар с выручкой 3 млн может <span data-heading-accent>приносить меньше денег</span>
    </h2>
    <p>
      Представим интернет-магазин, который продаёт на собственном сайте и маркетплейсах.
      Информация о заказах, закупочной стоимости, рекламе, комиссиях и логистике хранится в
      разных системах. Отчёт по продажам легко покажет лидера по выручке, но не ответит, какой
      товар действительно приносит больше денег.
    </p>
    <p>
      Сравним два товара за один месяц. <strong>Цифры условные, это учебный расчёт.</strong>{' '}
      Для простоты считаем, что возвратов не было, а выручка и расходы приведены на
      сопоставимой основе. Постоянные расходы и налоги здесь не учитываем.
    </p>
    <DataTable
      label="Учебный расчёт: выручка и затраты по двум товарам за месяц"
      columns={['Тысячи рублей', 'Товар А', 'Товар Б']}
      rows={marginExampleRows}
      rowHeaders
      compact
    />
    <p>
      У товара А выручка вдвое больше, но после перечисленных затрат остаётся 150 тысяч рублей.
      У товара Б — 375 тысяч. Это ещё не чистая прибыль бизнеса, но уже повод проверить
      рекламные расходы и условия продажи товара А, прежде чем увеличивать его закупку.
    </p>
    <p>
      BI помогает регулярно собирать такой расчёт и переходить от суммы к заказам и расходам.
      Решение о закупке всё равно требует проверки спроса, сроков поставки и доступных денег.
    </p>
  </section>

  <section aria-labelledby="report-difference">
    <h2 id="report-difference">
      Чем BI отличается от <span data-heading-accent>обычного отчёта</span>
    </h2>
    <p>
      Обычный отчёт отвечает на заранее сформулированный вопрос. BI создаёт среду, в которой
      исходный ответ можно сравнить с планом и прошлым периодом, разложить по менеджерам,
      регионам, товарам или каналам, а затем перейти к деталям.
    </p>
    <DataTable
      label="Сравнение обычного отчёта и BI-аналитики"
      columns={['Критерий', 'Обычный отчёт', 'BI-аналитика']}
      rows={reportRows}
      rowHeaders
    />
    <p>
      Например, фраза «продажи за август — 8,4 млн рублей» почти ничего не говорит сама по
      себе. Значение появляется, когда показатель можно сразу сопоставить с июлем, прошлым
      августом, планом и маржой, а затем понять, какая группа товаров или команда создала
      изменение.
    </p>
  </section>

  <section aria-labelledby="dashboard">
    <h2 id="dashboard">
      Что такое <span data-heading-accent>BI-дашборд</span>
    </h2>
    <p>
      BI-дашборд — это экран с ключевыми показателями и визуализациями, который помогает быстро
      оценить состояние бизнеса. Для отдела продаж на нём могут находиться выручка, маржа,
      выполнение плана, количество сделок, средний чек, конверсия и динамика по периодам.
    </p>
    <p>
      Хороший дашборд не пытается показать всё, что есть в базе. Его строят вокруг конкретного
      набора решений: успеваем ли выполнить план, какое направление просело, где снизилась
      маржа. Подробности остаются в связанных отчётах и открываются тогда, когда пользователь
      выбирает интересующий показатель.
    </p>
    <p>
      Поэтому визуализация — лишь один компонент BI. Диаграмму можно построить и в Excel, но
      полноценная система также получает и обновляет данные, связывает справочники, рассчитывает
      показатели и сохраняет единые правила для всех пользователей.
    </p>
  </section>

  <section aria-labelledby="sources">
    <h2 id="sources">
      Какие данные можно <span data-heading-accent>объединить в BI</span>
    </h2>
    <p>
      Практическая ценность BI особенно заметна, когда один управленческий вопрос затрагивает
      несколько систем. Их связывают вокруг общих сущностей: товара, клиента, заказа,
      менеджера, рекламной кампании или периода.
    </p>
    <DataTable
      label="Источники данных для BI-аналитики"
      columns={['Источник', 'Какие данные он даёт']}
      rows={sourceRows}
      rowHeaders
    />
    <p>
      Именно здесь находится основная техническая сложность проекта. Нарисовать график проще,
      чем добиться одинаковых кодов товаров, корректно сопоставить клиентов, учесть возвраты и
      договориться, что именно компания называет выручкой или маржой.
    </p>
  </section>

  <section aria-labelledby="business-tasks">
    <h2 id="business-tasks">
      Какие задачи решает <span data-heading-accent>BI-аналитика</span>
    </h2>
    <p>
      BI имеет смысл внедрять не ради самого дашборда, а ради повторяющихся вопросов, для
      которых сейчас приходится собирать данные вручную. В продажах это динамика выручки,
      выполнение плана, средний чек и результат отдельных сотрудников или направлений.
    </p>
    <h3>Реклама приводит заявки — какие из них превращаются в продажи?</h3>
    <p>
      Рекламные расходы можно связать не только с заявками, но и с фактическими сделками,
      выручкой и маржой. Тогда цепочка «реклама → лид → сделка → продажа» показывает качество
      клиентов и реальный результат канала, а не только количество обращений.
    </p>
    <h3>Какие товары продаются, а какие занимают склад?</h3>
    <p>
      Для товарного бизнеса BI соединяет остатки с продажами и закупками. Это помогает видеть
      оборачиваемость, дефицит, товары без движения и эффективность категорий. Сам по себе
      большой остаток ничего не говорит: важно понимать скорость его продажи и ожидаемый спрос.
    </p>
    <h3>Почему выручка растёт, а прибыль — нет?</h3>
    <p>
      На одном контуре можно сопоставить выручку, себестоимость, расходы и прибыльность
      направлений. Но BI не решает методологические разногласия автоматически: сначала компания
      договаривается о смысле показателей, затем эти правила закрепляются в модели данных.
    </p>

    <InlineConsultation
      variant="product"
      title="Битрикс24 — один из источников вашей аналитики?"
      description="После согласования данных для отчётности можно спланировать очистку ненужных лидов и сделок. На странице CRM Cleaner — фильтры, проверка списка и демо. Сначала сохраните нужную для анализа историю; удаление в приложении пока доступно только на демонстрационных данных."
      href={cleanerHref}
      actionLabel="Посмотреть CRM Cleaner"
    />
  </section>

  <section aria-labelledby="excel">
    <h2 id="excel">
      <span data-heading-accent>BI или Excel</span>: что выбрать
    </h2>
    <p>
      Эти инструменты не исключают друг друга. Если данные помещаются в один небольшой файл,
      анализ нужен разово, а отчёт собирает один человек раз в месяц, Excel может полностью
      закрывать задачу.
    </p>
    <p>
      BI становится рациональнее, когда появляются несколько источников, регулярное ручное
      копирование, разные версии одного показателя и необходимость быстро переходить от итога к
      деталям. В этот момент вопрос звучит уже не «какая программа лучше», а «сколько бизнесу
      стоит постоянная ручная сборка отчётности».
    </p>
  </section>

  <section aria-labelledby="limitations">
    <h2 id="limitations">
      Что <span data-heading-accent>BI не делает</span>
    </h2>
    <p>
      BI не управляет компанией вместо человека. Он может показать снижение продаж, выделить
      категорию, в которой оно произошло, и помочь заметить связь с изменением цены. Но решение
      — вернуть цену, скорректировать ассортимент, усилить продвижение или сохранить текущий
      курс — принимает руководитель.
    </p>
    <p>
      Система также не исправляет плохие исходные данные. Если сотрудники по-разному ведут CRM,
      у товаров нет единой номенклатуры, а подразделения используют разные формулы прибыли,
      дашборд лишь сделает расхождения заметнее. Качество аналитики начинается с качества данных
      и договорённостей внутри бизнеса.
    </p>
  </section>

  <section aria-labelledby="when-needed">
    <h2 id="when-needed">
      Когда бизнесу уже <span data-heading-accent>нужна BI-аналитика</span>
    </h2>
    <p>
      Размер компании — не главный критерий. Небольшой интернет-магазин с CRM, складской
      системой, сайтом, рекламой и несколькими маркетплейсами может сильнее нуждаться в BI, чем
      крупная компания, где все данные аккуратно живут в одной ERP.
    </p>
    <p>
      Характерные признаки повторяются: для одной цифры приходится обращаться к нескольким
      сотрудникам, показатели в отчётах не совпадают, данные регулярно копируют между файлами,
      а руководство получает картину с опозданием. Особенно показателен момент, когда на вопрос
      «почему изменился результат» нельзя ответить без новой ручной выгрузки.
    </p>
    <p>
      Если узнаются сразу несколько таких ситуаций, проблема обычно находится не в отсутствии
      ещё одного отчёта, а в организации аналитики и общих правилах работы с данными.
    </p>
  </section>

  <section aria-labelledby="implementation">
    <h2 id="implementation">
      С чего начинается <span data-heading-accent>внедрение BI</span>
    </h2>
    <p>
      Начинать с выбора платформы или цвета графиков — неверная последовательность. Сначала
      формулируют вопрос, ради которого создаётся аналитика. Например: «Какой канал продаж
      приносит реальную прибыль с учётом себестоимости, рекламы, комиссий и возвратов?»
    </p>
    <Checklist items={implementationSteps} label="Последовательность внедрения BI-аналитики" />
    <p>
      Такой порядок надёжнее подхода «подключим Power BI, а затем придумаем, что показывать».
      Часто первый полезный результат — не большая система из десятков отчётов, а один дашборд,
      проверенный на реальных данных и отвечающий на один важный вопрос.
    </p>
  </section>

  <section aria-labelledby="good-dashboard">
    <h2 id="good-dashboard">
      Как выглядит <span data-heading-accent>хороший дашборд</span>
    </h2>
    <p>
      Главный экран руководителя может быть довольно коротким: выручка, валовая прибыль,
      количество заказов, средний чек, выполнение плана, продажи по каналам и динамика к
      предыдущему периоду. Ценность появляется не от количества графиков, а от продуманного пути
      к деталям.
    </p>
    <p>
      Если выручка снизилась, пользователь должен последовательно понять, какой канал, категория,
      товар, регион или период сформировал изменение. BI силён именно этим переходом от симптома
      к возможной причине.
    </p>
    <p>
      Частые ошибки устроены наоборот: на одном экране пытаются показать всё, автоматизируют
      данные до их очистки или выбирают платформу раньше задачи. Полезность каждого показателя
      можно проверить простым вопросом: какое решение изменится, если он вырос или снизился? Если
      ответа нет, элемент, вероятно, не нужен на дашборде.
    </p>
  </section>

  <section aria-labelledby="summary">
    <h2 id="summary">
      Как проверить, <span data-heading-accent>нужен ли вам первый BI-проект</span>
    </h2>
    <p>
      Выберите один вопрос, на который сейчас трудно ответить: например, какой товар оставляет
      больше денег после рекламы и комиссий. Запишите, кто принимает решение, как часто нужен
      ответ и где находятся исходные данные.
    </p>
    <p>
      Соберите расчёт за один период и сверьте несколько строк с документами. Если он полезен,
      но каждый раз требует ручного сведения файлов, у вас есть конкретная задача для BI.
      Если расчёт пока вызывает споры, сначала согласуйте формулы — автоматизировать его рано.
    </p>
  </section>

