---
import { companyInfo } from '../../config/company';
import styles from './contact-request.module.scss';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<dialog class={styles.dialog} data-contact-dialog aria-labelledby="contact-request-title">
  <button class={styles.close} type="button" data-contact-close aria-label="Закрыть форму">×</button>
  <h2 id="contact-request-title">Обсудить задачу</h2>
  <form data-contact-form>
    <div class={styles.field}>
      <label for="request-name">Имя <span aria-hidden="true">*</span></label>
      <input id="request-name" name="name" autocomplete="name" maxlength="120" required autofocus aria-describedby="request-name-error" />
      <span class={styles.error} id="request-name-error" data-field-error="name"></span>
    </div>
    <div class={styles.field}>
      <label id="request-method-label" for="request-method-button">Способ связи</label>
      <div class={styles.method} data-method-picker>
        <select id="request-method" name="contact_method" hidden tabindex="-1" aria-hidden="true"><option value="phone">Телефон</option><option value="email">Email</option><option value="telegram">Telegram</option><option value="max">MAX</option></select>
        <button id="request-method-button" class={styles.methodButton} type="button" data-method-toggle aria-haspopup="listbox" aria-expanded="false" aria-controls="request-method-options" aria-labelledby="request-method-label request-method-value">
          <span id="request-method-value" data-method-value>Телефон</span>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <div id="request-method-options" class={styles.methodOptions} role="listbox" aria-labelledby="request-method-label" data-method-options hidden>
          {['Телефон', 'Email', 'Telegram', 'MAX'].map((label, index) => <button type="button" role="option" aria-selected={index === 0 ? 'true' : 'false'} tabindex="-1" data-method-option={['phone', 'email', 'telegram', 'max'][index]}>{label}<span aria-hidden="true">✓</span></button>)}
        </div>
      </div>
      <span class={styles.error} id="request-contact_method-error" data-field-error="contact_method"></span>
    </div>
    <div class={styles.field}>
      <label for="request-contact"><span data-contact-label>Телефон</span> <span aria-hidden="true">*</span></label>
      <div class={styles.contactInput} data-contact-input>
        <span class={styles.prefix} data-contact-prefix aria-hidden="true" hidden>@</span>
        <input id="request-contact" name="contact" type="tel" inputmode="tel" autocomplete="tel" maxlength="255" required aria-describedby="request-contact-error" placeholder="+7 (999) 999-99-99" />
      </div>
      <span class={styles.error} id="request-contact-error" data-field-error="contact"></span>
    </div>
    <div class={styles.field}>
      <label for="request-message">Комментарий</label>
      <textarea id="request-message" name="message" rows="3" maxlength="5000"></textarea>
      <span class={styles.error} id="request-message-error" data-field-error="message"></span>
    </div>
    <div class={styles.trap} aria-hidden="true"><label>Ваш сайт<input name="website" tabindex="-1" autocomplete="off" /></label></div>
    <div>
      <label class={styles.consent}><input name="consent" type="checkbox" required aria-describedby="request-consent-error" /><span>Согласен на <a href={`${base}request-consent/`} target="_blank" rel="noopener noreferrer">обработку персональных данных</a>.</span></label>
      <span class={styles.error} id="request-consent-error" data-field-error="consent"></span>
    </div>
    <p class={styles.error} data-contact-status role="alert" hidden></p>
    <button class={styles.submit} type="submit">Отправить заявку</button>
  </form>
  <div class={styles.success} data-contact-success hidden tabindex="-1" role="status">
    <svg width="56" height="56" viewBox="0 0 56 56" fill="none" aria-hidden="true"><circle cx="28" cy="28" r="24" stroke="currentColor" stroke-width="2" /><path d="m17 28 7 7 15-15" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
    <h2 id="contact-success-title">Заявка отправлена</h2>
    <button class={styles.submit} type="button" data-contact-close>Закрыть</button>
  </div>
</dialog>
<noscript><section id="contact-request" class={styles.fallback}><h2>Связаться с нами</h2><p>Напишите на <a href={`mailto:${companyInfo.contacts.email}`}>{companyInfo.contacts.email}</a> или <a href={companyInfo.contacts.telegram.url}>в Telegram</a>.</p></section></noscript>
<script>
  import { initContactRequest } from './contact-request-controller';
  initContactRequest(document);
</script>
