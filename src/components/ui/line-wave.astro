---
interface Props {
  variant?: 'hero' | 'bi';
}

const { variant = 'hero' } = Astro.props;
---

<div class="line-wave" data-wave-variant={variant} aria-hidden="true">
  <canvas data-line-wave data-wave-variant={variant}></canvas>
</div>

<script>
  (() => {
    const heroWaves = [
      { offset: 0, amplitude: 62, frequency: 0.003, speed: 0.00042, color: 'rgba(75, 156, 255, 0.82)', opacity: 0.52 },
      { offset: Math.PI * 0.5, amplitude: 82, frequency: 0.0026, speed: 0.00036, color: 'rgba(247, 248, 250, 0.72)', opacity: 0.36 },
      { offset: Math.PI, amplitude: 54, frequency: 0.0034, speed: 0.00048, color: 'rgba(146, 152, 163, 0.72)', opacity: 0.34 },
      { offset: Math.PI * 1.5, amplitude: 72, frequency: 0.0022, speed: 0.00032, color: 'rgba(220, 234, 255, 0.7)', opacity: 0.28 },
      { offset: Math.PI * 2, amplitude: 48, frequency: 0.004, speed: 0.00054, color: 'rgba(23, 101, 218, 0.68)', opacity: 0.28 },
    ];

    const biWaves = [
      { offset: 0, amplitude: 24, frequency: 0.0056, speed: 0.0007, color: 'rgba(23, 101, 218, 0.92)', opacity: 0.68 },
      { offset: Math.PI * 0.82, amplitude: 30, frequency: 0.0048, speed: 0.00058, color: 'rgba(24, 33, 49, 0.62)', opacity: 0.35 },
    ];

    const initializeWave = (canvas) => {
      if (canvas.dataset.waveReady === 'true') return;

      const context = canvas.getContext('2d', { alpha: true });
      if (!context) return;

      canvas.dataset.waveReady = 'true';

      const isBi = canvas.dataset.waveVariant === 'bi';
      const waves = isBi ? biWaves : heroWaves;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const hoverCapable = window.matchMedia('(hover: hover) and (pointer: fine)');
      const mobileViewport = window.matchMedia('(max-width: 599px)');
      const pointer = { x: 0, y: 0 };
      const targetPointer = { x: 0, y: 0 };
      const interactionTarget = isBi ? canvas.closest('article') : window;
      let frameId = 0;
      let lastFrame = 0;
      let pointerActivity = isBi ? 0 : 1;
      let targetPointerActivity = isBi ? 0 : 1;
      let width = 1;
      let height = 1;
      const initialBounds = canvas.getBoundingClientRect();
      let visible = initialBounds.bottom > 0 && initialBounds.top < window.innerHeight;

      const centerPointer = () => {
        pointer.x = width * 0.5;
        pointer.y = height * 0.56;
        targetPointer.x = pointer.x;
        targetPointer.y = pointer.y;
      };

      const handlePointerMove = (event) => {
        const bounds = canvas.getBoundingClientRect();
        const localX = event.clientX - bounds.left;

        targetPointer.x = isBi ? Math.min(width, Math.max(0, localX)) : localX;
        targetPointer.y = isBi ? height * 0.54 : event.clientY - bounds.top;

        if (isBi) targetPointerActivity = 1;
      };

      const handlePointerEnter = () => {
        targetPointerActivity = 1;
      };

      const handlePointerLeave = () => {
        targetPointerActivity = 0;
        centerPointer();
      };

      const drawWave = (wave, time) => {
        const mobile = width < 600;
        const pointStep = mobile ? 6 : 4;
        const amplitude = wave.amplitude * (mobile ? (isBi ? 0.76 : 0.58) : 1);
        const centerY = height * (isBi ? 0.54 : mobile ? 0.58 : 0.6);
        const influenceRadius = isBi ? Math.min(width * 0.42, mobile ? 180 : 260) : mobile ? 170 : 300;
        const pointerStrength = reducedMotion.matches ? 0 : isBi ? (mobile ? 18 : 30) : mobile ? 28 : 56;

        context.save();
        context.beginPath();
        const points = [];

        for (let x = 0; x <= width + pointStep; x += pointStep) {
          const distanceX = x - pointer.x;
          const distanceY = centerY - pointer.y;
          const distance = Math.hypot(distanceX, distanceY);
          const rawInfluence = Math.max(0, 1 - distance / influenceRadius);
          const influence = rawInfluence * rawInfluence * (3 - 2 * rawInfluence);
          const pointerEffect =
            influence *
            pointerStrength *
            pointerActivity *
            Math.sin(time * 0.0011 + x * 0.01 + wave.offset);
          const y =
            centerY +
            Math.sin(x * wave.frequency + time * wave.speed + wave.offset) * amplitude +
            Math.sin(x * wave.frequency * 0.4 + time * wave.speed * 1.55) *
              amplitude *
              0.4 +
            pointerEffect;

          points.push({ x, y });
        }

        if (points.length > 1) {
          context.moveTo(points[0].x, points[0].y);

          for (let index = 1; index < points.length - 1; index += 1) {
            const point = points[index];
            const nextPoint = points[index + 1];
            const midpointX = (point.x + nextPoint.x) * 0.5;
            const midpointY = (point.y + nextPoint.y) * 0.5;

            context.quadraticCurveTo(point.x, point.y, midpointX, midpointY);
          }

          const lastPoint = points[points.length - 1];
          context.lineTo(lastPoint.x, lastPoint.y);
        }

        context.globalAlpha = wave.opacity;
        context.lineCap = 'round';
        context.lineJoin = 'round';
        context.lineWidth = isBi ? (mobile ? 1.3 : 1.55) : mobile ? 1.35 : 1.65;
        context.shadowBlur = isBi ? (mobile ? 3 : 5) : mobile ? 10 : 16;
        context.shadowColor = wave.color;
        context.strokeStyle = wave.color;
        context.stroke();
        context.restore();
      };

      const draw = (time) => {
        context.clearRect(0, 0, width, height);

        pointer.x += (targetPointer.x - pointer.x) * 0.08;
        pointer.y += (targetPointer.y - pointer.y) * 0.08;
        pointerActivity += (targetPointerActivity - pointerActivity) * 0.1;

        waves.forEach((wave) => drawWave(wave, time));
      };

      const resize = () => {
        const bounds = canvas.getBoundingClientRect();
        const pixelRatio = Math.min(window.devicePixelRatio || 1, 1.5);
        width = Math.max(1, bounds.width);
        height = Math.max(1, bounds.height);
        canvas.width = Math.round(width * pixelRatio);
        canvas.height = Math.round(height * pixelRatio);
        context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
        centerPointer();
        if (visible) draw(reducedMotion.matches ? 0 : performance.now());
      };

      const animate = (time) => {
        if (!visible || document.hidden || reducedMotion.matches) return;

        const maxFrameRate = width < 600 ? 24 : 30;
        if (time - lastFrame >= 1000 / maxFrameRate) {
          draw(time);
          lastFrame = time;
        }

        frameId = window.requestAnimationFrame(animate);
      };

      const start = () => {
        window.cancelAnimationFrame(frameId);
        if (!reducedMotion.matches && visible && !document.hidden) {
          frameId = window.requestAnimationFrame(animate);
        } else if (visible) {
          draw(reducedMotion.matches ? 0 : performance.now());
        }
      };

      const startWhenReady = () => {
        if (!mobileViewport.matches || document.readyState === 'complete') {
          start();
          return;
        }

        window.addEventListener('load', start, { once: true });
      };

      const resizeObserver = new ResizeObserver(resize);
      const visibilityObserver = new IntersectionObserver(([entry]) => {
        visible = entry?.isIntersecting ?? false;
        start();
      });

      resizeObserver.observe(canvas);
      visibilityObserver.observe(canvas);

      if (isBi && hoverCapable.matches) {
        interactionTarget?.addEventListener('pointermove', handlePointerMove, { passive: true });
        interactionTarget?.addEventListener('pointerenter', handlePointerEnter, { passive: true });
        interactionTarget?.addEventListener('pointerleave', handlePointerLeave, { passive: true });
      } else if (!isBi) {
        window.addEventListener('pointermove', handlePointerMove, { passive: true });
        window.addEventListener('blur', centerPointer);
      }

      reducedMotion.addEventListener('change', start);
      document.addEventListener('visibilitychange', start);
      resize();
      startWhenReady();
    };

    document.querySelectorAll('[data-line-wave]').forEach(initializeWave);
  })();
</script>

<style lang="scss">
  .line-wave {
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    position: absolute;
    z-index: 0;
  }

  .line-wave[data-wave-variant='bi'] {
    height: 100%;
    inset: auto;
    position: relative;
    width: 100%;
  }

  canvas {
    display: block;
    height: 100%;
    opacity: 0.88;
    width: 100%;
  }

  .line-wave[data-wave-variant='bi'] canvas {
    opacity: 1;
  }

  @media (max-width: 768px) {
    canvas {
      opacity: 0.78;
    }

    .line-wave[data-wave-variant='bi'] canvas {
      opacity: 1;
    }
  }
</style>
