<!--
  Archived TrueTell hero light rays.
  This component is intentionally not imported anywhere. It preserves the exact
  three-ray canvas effect that was replaced by the line wave.
-->

<div class="archived-light-rays" aria-hidden="true">
  <canvas data-archived-light-rays></canvas>
</div>

<script is:inline>
  (() => {
    const beams = [
      { offset: -0.18, spread: 0.07, opacity: 0.15, speed: 0.00018, shimmerSpeed: 0.00042, phase: 0.3, length: 1.44, sway: 0.045 },
      { offset: 0, spread: 0.06, opacity: 0.18, speed: 0.00022, shimmerSpeed: 0.0005, phase: 2.1, length: 1.36, sway: 0.052 },
      { offset: 0.18, spread: 0.075, opacity: 0.13, speed: 0.00016, shimmerSpeed: 0.00037, phase: 4.4, length: 1.42, sway: 0.04 },
    ];

    const initializeLight = (canvas) => {
      if (canvas.dataset.lightReady === 'true') return;

      const context = canvas.getContext('2d', { alpha: true });
      if (!context) return;

      canvas.dataset.lightReady = 'true';

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const maxFrameRate = 24;
      let frameId = 0;
      let lastFrame = 0;
      let width = 1;
      let height = 1;
      let visible = true;

      const rgba = (red, green, blue, alpha) =>
        `rgba(${red}, ${green}, ${blue}, ${alpha})`;

      const drawBeam = (sourceX, sourceY, angle, spread, length, opacity, shimmer) => {
        const slices = width < 600 ? 30 : 40;
        const sliceWidth = (spread * 2) / slices;
        const shimmerStart = 0.12 + shimmer * 0.22;
        const shimmerPeak = shimmerStart + 0.12;
        const shimmerTail = shimmerPeak + 0.24;

        for (let index = 0; index < slices; index += 1) {
          const normalized = ((index + 0.5) / slices) * 2 - 1;
          const feather = Math.exp(-normalized * normalized * 3.6);
          const sliceAngle = angle + normalized * spread;
          const edgeA = sliceAngle - sliceWidth * 0.58;
          const edgeB = sliceAngle + sliceWidth * 0.58;
          const endX = sourceX + Math.cos(sliceAngle) * length;
          const endY = sourceY + Math.sin(sliceAngle) * length;
          const gradient = context.createLinearGradient(sourceX, sourceY, endX, endY);

          gradient.addColorStop(0, rgba(205, 231, 255, opacity * 1.18 * feather));
          gradient.addColorStop(shimmerStart, rgba(112, 176, 255, opacity * 0.7 * feather));
          gradient.addColorStop(shimmerPeak, rgba(226, 241, 255, opacity * 1.3 * feather));
          gradient.addColorStop(shimmerTail, rgba(75, 156, 255, opacity * 0.42 * feather));
          gradient.addColorStop(1, rgba(23, 101, 218, 0));

          context.beginPath();
          context.moveTo(sourceX, sourceY);
          context.lineTo(
            sourceX + Math.cos(edgeA) * length,
            sourceY + Math.sin(edgeA) * length,
          );
          context.lineTo(
            sourceX + Math.cos(edgeB) * length,
            sourceY + Math.sin(edgeB) * length,
          );
          context.closePath();
          context.fillStyle = gradient;
          context.fill();
        }
      };

      const draw = (time) => {
        context.clearRect(0, 0, width, height);
        context.save();
        context.globalCompositeOperation = 'lighter';

        const motion = reducedMotion.matches ? 0 : 1;
        const sourceX = -width * 0.055 + Math.sin(time * 0.00016) * 26 * motion;
        const sourceY = -height * 0.1 + Math.cos(time * 0.00014) * 18 * motion;
        const targetX = width * (width < 600 ? 0.62 : 0.54);
        const targetY = height * (width < 600 ? 0.5 : 0.53);
        const baseAngle = Math.atan2(targetY - sourceY, targetX - sourceX);
        const diagonal = Math.hypot(width, height);

        const ambient = context.createRadialGradient(
          sourceX,
          sourceY,
          0,
          sourceX,
          sourceY,
          Math.max(width, height),
        );
        ambient.addColorStop(0, rgba(178, 219, 255, 0.32));
        ambient.addColorStop(0.34, rgba(75, 156, 255, 0.15));
        ambient.addColorStop(0.7, rgba(23, 101, 218, 0.04));
        ambient.addColorStop(1, rgba(4, 22, 52, 0));
        context.fillStyle = ambient;
        context.fillRect(0, 0, width, height);

        beams.forEach((beam) => {
          const primaryWave = Math.sin(time * beam.speed + beam.phase);
          const secondaryWave = Math.sin(time * beam.speed * 0.37 + beam.phase * 1.7);
          const organicMotion = primaryWave * 0.68 + secondaryWave * 0.32;
          const sway = organicMotion * beam.sway * motion;
          const breathing = 0.9 + Math.cos(time * beam.speed * 0.71 + beam.phase) * 0.1 * motion;
          const spread = beam.spread + secondaryWave * 0.018 * motion;
          const reach = 1 + primaryWave * 0.03 * motion;
          const shimmer = motion
            ? (Math.sin(time * beam.shimmerSpeed + beam.phase * 1.3) + 1) * 0.5
            : 0.42;

          drawBeam(
            sourceX,
            sourceY,
            baseAngle + beam.offset + sway,
            spread,
            diagonal * beam.length * reach,
            beam.opacity * breathing,
            shimmer,
          );
        });

        context.restore();
      };

      const resize = () => {
        const bounds = canvas.getBoundingClientRect();
        const pixelRatio = Math.min(window.devicePixelRatio || 1, 1.5);
        width = Math.max(1, bounds.width);
        height = Math.max(1, bounds.height);
        canvas.width = Math.round(width * pixelRatio);
        canvas.height = Math.round(height * pixelRatio);
        context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
        draw(performance.now());
      };

      const animate = (time) => {
        if (!visible || reducedMotion.matches) return;

        if (time - lastFrame >= 1000 / maxFrameRate) {
          draw(time);
          lastFrame = time;
        }

        frameId = window.requestAnimationFrame(animate);
      };

      const start = () => {
        window.cancelAnimationFrame(frameId);
        if (!reducedMotion.matches && visible) frameId = window.requestAnimationFrame(animate);
        else draw(performance.now());
      };

      const resizeObserver = new ResizeObserver(resize);
      const visibilityObserver = new IntersectionObserver(([entry]) => {
        visible = entry?.isIntersecting ?? false;
        start();
      });

      resizeObserver.observe(canvas);
      visibilityObserver.observe(canvas);
      reducedMotion.addEventListener('change', start);
      resize();
      start();
    };

    document.querySelectorAll('[data-archived-light-rays]').forEach(initializeLight);
  })();
</script>

<style lang="scss">
  .archived-light-rays {
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    position: absolute;
  }

  canvas {
    filter: blur(18px) saturate(1.05);
    height: 110%;
    left: -5%;
    mix-blend-mode: screen;
    opacity: 1;
    position: absolute;
    top: -5%;
    width: 110%;
  }

  @media (max-width: 768px) {
    canvas {
      filter: blur(16px) saturate(1.04);
    }
  }
</style>
