---
import styles from './privacy-controls.module.scss';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<div data-privacy-root data-production={import.meta.env.PROD && import.meta.env.BASE_URL === '/'}>
  <aside class={styles.banner} data-cookie-banner aria-label="Cookie на сайте" hidden>
    <p>Используем cookie, чтобы понимать, что полезно на сайте. Вы можете отказаться. <a href={`${base}cookies/`}>Подробнее</a></p>
    <div class={styles.actions}>
      <button type="button" data-cookie-reject>Отклонить</button>
      <button type="button" class={styles.primary} data-cookie-accept>Принять</button>
    </div>
  </aside>
  <dialog class={styles.dialog} data-cookie-dialog aria-labelledby="cookie-title">
    <div class={styles.heading}>
      <h2 id="cookie-title">Настройки cookie</h2>
      <button type="button" class={styles.close} data-cookie-close aria-label="Закрыть настройки">×</button>
    </div>
    <p class={styles.intro}>Выберите, что разрешить.</p>
    <div class={styles.row}>
      <div><strong>Ваш выбор</strong><p>Запоминаем настройки.</p></div>
      <span class={styles.always}>Всегда</span>
    </div>
    <label class={styles.row}>
      <span><strong>Статистика</strong><span class={styles.description}>Помогает улучшать сайт.</span></span>
      <input class={styles.toggle} type="checkbox" data-cookie-toggle aria-label="Разрешить cookie для статистики" />
    </label>
    <details class={styles.details}>
      <summary>Подробнее о cookie</summary>
      <p>Для статистики используем Яндекс Метрику. Вебвизор отключён. Без вашего согласия счётчик не загружается.</p>
      <p>Нажимая «Принять» или сохраняя включённую статистику, вы даёте <a href={`${base}analytics-consent/`}>согласие на обработку данных</a>.</p>
      <a href={`${base}cookies/`}>Какие данные используются</a>
    </details>
    <button type="button" class={`${styles.primary} ${styles.save}`} data-cookie-save>Сохранить</button>
  </dialog>
  <p class={styles.status} data-cookie-status role="status" aria-live="polite"></p>
  <div class={styles.spacer} data-cookie-spacer aria-hidden="true"></div>
</div>
<script>
  import { initializePrivacy } from './privacy-controller';
  initializePrivacy();
</script>
