---
import styles from './action-icon.module.scss';

interface Props {
  name: 'filter' | 'price' | 'review' | 'report' | 'remove' | 'run';
}

const { name } = Astro.props;
const paths = {
  run: ['m8 4 12 8-12 8Z'],
  filter: ['M4 6h16M7 12h10M10 18h4', 'M8 4v4M16 10v4M12 16v4'],
  price: ['M4 4h8l8 8-8 8-8-8Z', 'M8 8h.01M11 15l4-4'],
  review: ['M13 4H5v16h14v-8', 'm10 10 3 3 7-8', 'M8 16h7'],
  report: ['M5 3h10l4 4v14H5Z', 'M14 3v5h5M9 12h6M9 16h6'],
  remove: ['M4 6h16M9 6V3h6v3M6 6l1 15h10l1-15', 'M10 10v7M14 10v7'],
};
---

<svg class={styles.icon} viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false" data-product-icon={name}>
  {paths[name].map((d) => <path {d} />)}
</svg>
