---
import AppHeader from '../header/header.astro';
import heroStyles from '../../styles/product-hero.module.scss';
import SiteFooter from '../footer/site-footer.astro';
import { companyInfo } from '../../config/company';
import BaseLayout from '../../layouts/BaseLayout.astro';
import styles from './product-development-page.module.scss';

interface HeadingSegment {
  text: string;
  accent?: boolean;
}

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  heading: HeadingSegment[];
  articleHref?: string;
  articleLabel?: string;
  statusLabel?: string;
  releaseText?: string;
  contactText?: string;
  actionLabel?: string;
}

const {
  title,
  description,
  canonicalPath,
  heading,
  articleHref,
  articleLabel = 'Вернуться к статье',
  statusLabel = 'Продукт в разработке',
  releaseText = 'Продукт находится в разработке и в ближайшее время выйдет в свет.',
  contactText =
    'Если продукт вас заинтересовал, оставьте заявку — мы свяжемся с вами и проконсультируем в удобном формате.',
  actionLabel = 'Оставить заявку',
} = Astro.props;

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const toSitePath = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
---

<BaseLayout {title} {description} {canonicalPath} robots="noindex, follow">
  <AppHeader />

  <main class="site-content">
    <section class={styles.page} aria-labelledby="product-development-title">
      <div class={styles.container}>
        <header class={heroStyles.hero}>
          <div class={heroStyles.heroCopy}>
            <h1 id="product-development-title">
              {heading.map((segment) => segment.accent ? <span class={styles.headingAccent}>{segment.text}</span> : segment.text)}
            </h1>
            <p class={heroStyles.heroDescription}>{releaseText}</p>
          </div>
          <div class={heroStyles.heroActions}>
            <a class={styles.primaryAction} href={companyInfo.contacts.consultationUrl} target="_blank" rel="noopener noreferrer">{actionLabel}</a>
          </div>
        </header>
        <div class={styles.afterHero}>
          <p class={styles.status}>{statusLabel}</p>
          <p>{contactText}</p>
          {articleHref && <a class={styles.articleLink} href={toSitePath(articleHref)}>{articleLabel}</a>}
        </div>
      </div>
    </section>
  </main>

  <SiteFooter hideDivider />
</BaseLayout>
