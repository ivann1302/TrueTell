---
import styles from './article-sources.module.scss';

interface SourceLink {
  label: string;
  href: string;
}

interface Props {
  publishedIso: string;
  publishedLabel: string;
  sources: SourceLink[];
}

const { publishedIso, publishedLabel, sources } = Astro.props;
---

<footer class={styles.sources}>
  <p class={styles.publishedDate}>
    Опубликовано <time datetime={publishedIso}>{publishedLabel}</time>
  </p>
  <p>Официальные материалы</p>
  <ul>
    {sources.map((source) => (
      <li>
        <a href={source.href} target="_blank" rel="noopener noreferrer">{source.label}</a>
      </li>
    ))}
  </ul>
</footer>
