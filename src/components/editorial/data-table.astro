---
import styles from './data-table.module.scss';

interface Props {
  label: string;
  columns: string[];
  rows: Array<Array<string | number>>;
  rowHeaders?: boolean;
  compact?: boolean;
}

const { label, columns, rows, rowHeaders = false, compact = false } = Astro.props;
---

<div class:list={[styles.scrollRegion, { [styles.compact]: compact }]} tabindex="0" role="region" aria-label={label}>
  <table>
    <thead>
      <tr>
        {columns.map((column) => <th scope="col">{column}</th>)}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          {row.map((cell, index) =>
            rowHeaders && index === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>,
          )}
        </tr>
      ))}
    </tbody>
  </table>
</div>
