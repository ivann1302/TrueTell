---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import styles from './article-figure.module.scss';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  eager?: boolean;
  fullSize?: boolean;
  dark?: boolean;
  compact?: boolean;
}

const { src, alt, caption, eager = false, fullSize = false, dark = false, compact = false } = Astro.props;
---

<figure class:list={[styles.figure, { [styles.dark]: dark, [styles.expandable]: fullSize, [styles.compact]: compact }]}>
  {fullSize ? (
    <a class={styles.preview} href={src.src} target="_blank" rel="noopener noreferrer" aria-label={`${alt}: открыть в полном размере — новая вкладка`}>
      <Image src={src} alt={alt} widths={[480, 800, 1280]} sizes="(max-width: 768px) calc(100vw - 32px), (max-width: 1304px) 55vw, 700px" format="webp" loading={eager ? 'eager' : 'lazy'} />
    </a>
  ) : <Image src={src} alt={alt} width={compact ? 640 : undefined} widths={compact ? [320, 640] : undefined} sizes={compact ? '(max-width: 352px) calc(100vw - 32px), 320px' : undefined} format={compact ? 'webp' : undefined} loading={eager ? 'eager' : 'lazy'} />}
  {caption && <figcaption>{caption}</figcaption>}
</figure>
