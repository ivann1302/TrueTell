---
import AppHeader from '../header/header.astro';
import SiteFooter from '../footer/site-footer.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleContent from './article-content.astro';
import ArticleHero from './article-hero.astro';
import styles from './article-layout.module.scss';
import { getArticle } from '../../config/articles';

interface Breadcrumb {
  label: string;
  href?: string;
}

interface TitlePart {
  text: string;
  accent?: boolean;
}

interface Props {
  title: string;
  titleParts: TitlePart[];
  description: string;
  canonicalPath: string;
  category: string;
  intro: string;
  breadcrumbs: Breadcrumb[];
  structuredData?: Record<string, unknown>;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  author?: string;
  publishedTime?: string;
  modifiedTime?: string;
  quickAnswerLabel?: string;
  heroVariant?: 'default' | 'dark';
  heroAction?: { href: string; label: string; description: string };
}

const {
  title,
  titleParts,
  description,
  canonicalPath,
  category,
  intro,
  breadcrumbs,
  structuredData,
  ogTitle,
  ogDescription,
  ogImage,
  ogImageAlt,
  author,
  quickAnswerLabel = 'Быстрый ответ',
  heroVariant = 'default',
  heroAction,
} = Astro.props;
const metadata = getArticle(canonicalPath);
const robots = metadata.status === 'draft' || !metadata.indexable ? 'noindex, nofollow' : 'index, follow';
---

<BaseLayout
  title={metadata.seoTitle ?? title}
  {description}
  canonicalPath={metadata.canonical ?? canonicalPath}
  {robots}
  contentType={metadata.type}
  contentCategory={`${metadata.category} / ${metadata.topic}`}
  contentStatus={metadata.status}
  relatedProduct={metadata.relatedProduct}
  {structuredData}
  ogType="article"
  {ogTitle}
  {ogDescription}
  {ogImage}
  {ogImageAlt}
  {author}
  publishedTime={metadata.publishedAt}
  modifiedTime={metadata.updatedAt}
>
  <AppHeader />

  <main class="site-content">
    <article class={styles.page}>
      <ArticleHero {titleParts} {category} {intro} {breadcrumbs} {quickAnswerLabel} variant={heroVariant} action={heroAction}>
        <Fragment slot="background"><slot name="hero-background" /></Fragment>
        <slot name="quick-answer" />
      </ArticleHero>

      <ArticleContent>
        <slot />
      </ArticleContent>

      <slot name="article-end" />
    </article>

    <slot name="after-article" />
  </main>

  <SiteFooter />
</BaseLayout>
