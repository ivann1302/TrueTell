---
import styles from './related-articles.module.scss';
import CarouselControls from '../article-carousel/carousel-controls.astro';

interface RelatedArticle {
  title: string;
  description: string;
  href: string;
  category?: string;
}

interface Props {
  items: RelatedArticle[];
  title?: string;
}

const { items, title = 'Материалы по теме' } = Astro.props;
---

<section class={styles.section} aria-labelledby="related-articles-title" data-article-carousel>
  <div class={styles.container}>
    <header class={styles.header}>
      <h2 id="related-articles-title">{title}</h2>
      <CarouselControls trackId="related-articles-track" />
    </header>

    <div id="related-articles-track" class={styles.track} data-carousel-track role="region" tabindex="0" aria-label="Связанные материалы">
      {items.map((item) => (
        <article class={styles.slide}>
          <a href={item.href}>
            <span class={styles.category}>{item.category ?? 'Статья'}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <span class={styles.more}>Читать <span aria-hidden="true">→</span></span>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
