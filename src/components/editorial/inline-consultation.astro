---
import { companyInfo } from '../../config/company';
import styles from './inline-consultation.module.scss';

interface Props {
  title: string;
  description: string;
  href?: string;
  actionLabel?: string;
  variant?: 'consultation' | 'product';
}

const {
  title,
  description,
  href = companyInfo.contacts.consultationUrl,
  actionLabel = 'Задать вопрос',
  variant = 'consultation',
} = Astro.props;
const external = href.startsWith('http');
---

<aside
  class:list={[styles.consultation, variant === 'product' && styles.product]}
  aria-label={variant === 'product' ? 'Приложение для вашей задачи' : 'Консультация'}
  data-inline-product={variant === 'product' || undefined}
>
  <div>
    <strong>{title}</strong>
    <p>{description}</p>
  </div>
  <a
    href={href}
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener noreferrer' : undefined}
  >
    {actionLabel} <span aria-hidden="true">→</span>
  </a>
</aside>
